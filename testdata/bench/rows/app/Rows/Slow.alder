module Rows.Slow

import Table.Row

page "/slow" { }

type Model = { rows: List (Maybe Row) }

-- The N+1 the rule must catch: the rows, then each one again by id (one SELECT per row).
load : Params -> Session -> Query Model
load params session = {
  let rows <- Db.from Row |> Db.all
  let again <- Query.all (List.map (\r -> Db.get Row r.id) rows)
  Query.succeed { rows: again }
}

view : Model -> Session -> Html Msg
view model session =
  <html>
    <body>
      <h1>Slow</h1>
      <p id="count">{Text.fromInt (List.length model.rows)}</p>
    </body>
  </html>
