module Secret

route Secret = GET "/secret" { } requires user

type Model = { }

Secret.load : Secret.Params -> Session -> Query Model
Secret.load params session = Query.succeed {}

greeting : Secret.Session -> Text
greeting session = "hello " ++ session.user

Secret.view : Model -> Session -> Html
Secret.view model session = <p>{greeting session} ({Text.fromInt session.visits})</p>
