(module App)
(record App.Session)
(union App.Msg)
(value App.error : Error -> Html Never (err)
  (elem h1 (htext "Something went wrong")))
(value App.notFound : Html Never () (elem h1 (htext "Not found")))
(session App.Session)
(deploy
  (env local script (script "./scripts/deploy-local.sh"))
  (env preview ssh
    (host "deploy@box.example.com")
    (domain "*.preview.example.com")
    (path "/srv/blog-preview"))
  (env production ssh
    (host "deploy@box.example.com")
    (domain "blog.example.com")
    (path "/srv/blog")
    (user "deploy")
    (port "2222"))
  (env staging fly (region "ord") (app "blog-staging"))
  (floor 0.95)
  (checks "./scripts/lint-content" "go vet ./...")
  (requires "SMTP_URL" "STRIPE_KEY")
  (backup s3 "s3://blog-backups/production")
  (keep 5)
  (proxy None))
