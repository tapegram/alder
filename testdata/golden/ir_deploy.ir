(module App)
(record App.Session)
(union App.Msg)
(value App.error : Error -> Html Never (err)
  (elem h1 (htext "Something went wrong")))
(value App.notFound : Html Never () (elem h1 (htext "Not found")))
(session App.Session)
(deploy
  (env cloud render
    (region "oregon")
    (service "blog")
    (plan "starter")
    (instances 2)
    (database turso "my-org" (group "default") (app "blog")))
  (env cloudpreview render
    (region "oregon")
    (service "blog-preview")
    (database turso "my-org" (group "default") (app "blog-preview")))
  (env local script (script "./scripts/deploy-local.sh"))
  (env long fly
    (region "ord")
    (app "a-very-long-hyphenated-application-name-for-staging"))
  (env preview ssh
    (host "deploy@box.example.com")
    (domain "*.preview.example.com")
    (path "/srv/blog-preview"))
  (env production ssh
    (host "deploy@box.example.com")
    (domain "blog.example.com")
    (path "/srv/blog")
    (user "deploy")
    (port "2222"))
  (env staging fly (region "ord") (app "blog-staging"))
  (image "ghcr.io/tavish/blog")
  (floor 0.95)
  (checks
    "./scripts/lint-content"
    "go vet ./..."
    "scripts/checks/verify/content/links/internal")
  (requires "SMTP_URL" "STRIPE_KEY")
  (backup s3 "s3://blog-backups/production")
  (keep 5)
  (proxy None))
