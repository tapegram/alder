module App

import Theme
import User

session { user: Maybe User.UserId, theme: Theme = Light }

login = Todos.Index.Index

route Logout = DELETE "/session" { }

Logout.update : Logout.Params -> Session -> Task Response
Logout.update params session = Task.succeed Response.refresh

error : Error -> Html
error err = <h1>err</h1>

notFound : Html
notFound = <h1>nf</h1>
