module Todo

import User

type TodoId = brand Text

table Todo {
  id: TodoId @id,
  title: Text.NonEmpty,
  done: Bool = False,
  owner: User.UserId @ref User,
  bad: Text @ref User,
  created: Time @created,
  nested: List Int,
  boxed: Payload,
}

table Broken {
  id: Int @id,
  name: Text,
}

type Payload = Boxed Int
