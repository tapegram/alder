module Todos.Index

import Todo

route Index  = GET  "/"         { filter: Int = 0, todos: List Todo } requires missing
route Submit = POST "/_/Submit" { } form NewTodo                      requires missing
route Toggle = POST "/_/Toggle" { id: Todo.TodoId }                   requires missing

type Model = { todos: List Todo }

Index.load : Index.Params -> Session -> Query Model
Index.load params session = Query.succeed { todos: [] }

form NewTodo = { title: Text.NonEmpty, items: List Int }

Index.view : Model -> Session -> Html
Index.view model session = <ul></ul>

noSig = 1
