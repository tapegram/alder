module Index

route Index = GET "/" { }

type Model = { todos: List Todo, titles: List Text }

Index.load : Index.Params -> Session -> Query Model
Index.load params session = {
  let todos <-
    Db.from Todo
      |> Db.orderBy Todo.title.asc
      |> Db.all
  Query.succeed { todos: todos, titles: List.map (\t -> t.title) todos }
}

form Filter = { priority: Todo.Priority }

Index.view : Model -> Session -> Html
Index.view model session =
  <ul>
    {for t in model.todos -> <li>{t.title}</li>}
  </ul>
