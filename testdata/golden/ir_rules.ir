            (record App.Session
              (user (ctor Prelude.Maybe.Just (record (value (var bob)))))
              (role (ctor User.Role.Reader))))
          (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
            (test-open (route Todos.Show.Show)
              (record Show.Params (id (var id))))
            (pure task
              (test-eq (field answer (var r)) (ctor Prelude.Answer.PageMissing)))))))))
(test "a visitor is sent to log in from a todo" task
  (bind task me : Text
    (db-insert User.User (record (name "Me") (role (ctor User.Role.Reader))))
    (bind task id : Text
      (db-insert Todo.Todo
        (record (title "Milk") (done False) (owner (var me))))
      (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
        (test-open (route Todos.Show.Show) (record Show.Params (id (var id))))
        (pure task
          (test-eq
            (field answer (var r))
            (ctor Prelude.Answer.Redirected
              (record
                (value (route-ref Login.Login (record Login.Login.Params)))))))))))
(table User.User (id id) (insert name role))
(table Todo.Todo
  (id id)
  (created created)
  (partition user owner)
  (ref owner User.User cascade)
  (insert title done owner))
(form Todos.Index.NewTodo)
(route Admin.Index.Index GET "/admin"
  (params Index.Params)
  (requires user)
  (roles Author Admin)
  (session Index.Session)
  (model Model)
  (load Admin.Index.Index.load)
  (view Admin.Index.Index.view))
(route Admin.Users.Users GET "/admin/users"
  (params Users.Params)
  (requires user)
  (roles Admin)
  (session Users.Session)
  (model Model)
  (load Admin.Users.Users.load)
  (view Admin.Users.Users.view))
(route Login.Login GET "/login"
  (params Login.Params)
  (model Model)
  (load Login.Login.load)
  (view Login.Login.view))
(route Todos.Index.Index GET "/"
  (params Index.Params)
  (requires user)
  (session Index.Session)
  (model Model)
  (load Todos.Index.Index.load)
  (view Todos.Index.Index.view))
(route Todos.Index.Add POST "/"
  (params Add.Params)
  (form NewTodo)
  (requires user)
  (session Index.Session)
  (update Todos.Index.Add.update)
  (needs-shown))
(route Todos.Index.Toggle PUT "/todos/{id}/done"
  (params Toggle.Params)
  (requires user)
  (session Index.Session)
  (update Todos.Index.Toggle.update)
  (needs-shown))
(route Todos.Index.Rename PATCH "/todos/{id}"
  (params Rename.Params)
  (requires user)
  (session Index.Session)
  (update Todos.Index.Rename.update)
  (needs-shown))
(route Todos.Index.Remove DELETE "/todos/{id}"
  (params Remove.Params)
  (requires user)
  (session Index.Session)
  (update Todos.Index.Remove.update)
  (needs-shown))
(route Todos.Index.Duplicate POST "/todos/copy"
  (params Duplicate.Params)
  (requires user)
  (session Index.Session)
  (update Todos.Index.Duplicate.update)
  (needs-shown))
(route Todos.Show.Show GET "/todos/{id}"
  (params Show.Params)
  (requires user)
  (session Show.Session)
  (model Model)
  (load Todos.Show.Show.load)
  (view Todos.Show.Show.view))
(session App.Session)
