                      (record
                        (answer (ctor Prelude.Answer.PageMissing))
                        (title "Milk")))))))))))))
(test "a stranger's duplicate on a stale page is not found and undone" task
  (bind task me : Text
    (db-insert User.User (record (name "Me") (role (ctor User.Role.Reader))))
    (bind task bob : Text
      (db-insert User.User (record (name "Bob") (role (ctor User.Role.Reader))))
      (bind task id : Text
        (db-insert Todo.Todo
          (record (title "Milk") (done False) (owner (var me))))
        (bind task _
          (test-login
            (record App.Session
              (user (ctor Prelude.Maybe.Just (record (value (var me)))))
              (role (ctor User.Role.Reader))))
          (bind task _
            (test-get Todos.Index (record Params))
            (bind task _
              (test-login
                (record App.Session
                  (user (ctor Prelude.Maybe.Just (record (value (var bob)))))
                  (role (ctor User.Role.Reader))))
              (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
                (test-click Todos.Index.Duplicate
                  (record DuplicateParams (id (var id))))
                (bind task after : Maybe Todo
                  (db-get Todo.Todo (var id))
                  (bind task n : Int
                    (db-select Todo.Todo count)
                    (pure task
                      (test-eq
                        (record
                          (answer (field answer (var r)))
                          (done
                            (call (std Maybe.map)
                              (lambda (t : Todo) (field done (var t)))
                              (var after)))
                          (n (var n)))
                        (record
                          (answer (ctor Prelude.Answer.PageMissing))
                          (done
                            (ctor Prelude.Maybe.Just (record (value False))))
                          (n 1))))))))))))))
(test "a scoped update of another's row fails the whole task" task
  (bind task me : Text
    (db-insert User.User (record (name "Me") (role (ctor User.Role.Reader))))
    (bind task bob : Text
      (db-insert User.User (record (name "Bob") (role (ctor User.Role.Reader))))
      (bind task id : Text
        (db-insert Todo.Todo
          (record (title "Milk") (done False) (owner (var me))))
        (bind task _
          (test-login
            (record App.Session
              (user (ctor Prelude.Maybe.Just (record (value (var bob)))))
              (role (ctor User.Role.Reader))))
          (bind task r : { value: Result Text Nav, trace: List Text }
            (test-run
              (call (global Todos.Index.update)
                (ctor Todos.Index.Msg.Duplicate
                  (record DuplicateParams (id (var id))))
                (record Model (todos (list)) (open 0))
                (record Session (user (var bob)) (role (ctor User.Role.Reader)))))
            (bind task n : Int
              (db-select Todo.Todo count)
              (pure task
                (test-eq
                  (record
                    (value (field value (var r)))
                    (trace (field trace (var r)))
                    (n (var n)))
                  (record
                    (value
                      (ctor Prelude.Result.Err (record (value "not found"))))
                    (trace (list "Db.insertMine Todo" "Db.updateMine Todo"))
                    (n 1)))))))))))
(test "updateMine never gives a todo away" task
  (bind task me : Text
    (db-insert User.User (record (name "Me") (role (ctor User.Role.Reader))))
    (bind task bob : Text
      (db-insert User.User (record (name "Bob") (role (ctor User.Role.Reader))))
      (bind task id : Text
        (db-insert Todo.Todo
          (record (title "Milk") (done False) (owner (var me))))
        (bind task _
          (test-login
            (record App.Session
              (user (ctor Prelude.Maybe.Just (record (value (var me)))))
              (role (ctor User.Role.Reader))))
          (bind task r : { value: Result Text Unit, trace: List Text }
            (test-run
              (db-update-scoped Db.updateMine user Todo.Todo
                (var id)
                (lambda (t : Todo)
                  (update (var t) (title "given") (owner (var bob))))))
            (bind task after : Maybe Todo
              (db-get Todo.Todo (var id))
              (pure task
                (test-eq
                  (record
                    (value (field value (var r)))
                    (owner
                      (call (std Maybe.map)
                        (lambda (t : Todo) (field owner (var t)))
                        (var after)))
                    (title (call (global Todos.Index.titleOf) (var after))))
                  (record
                    (value (ctor Prelude.Result.Ok (record (value ()))))
                    (owner (ctor Prelude.Maybe.Just (record (value (var me)))))
                    (title "given")))))))))))
(module Todos.Show)
(record Todos.Show.Model (todo Todo))
(record Todos.Show.Params (id Text))
(union Todos.Show.Msg)
(record Todos.Show.Session (user Text) (role User.Role))
(value Todos.Show.load : Params -> Session -> Query Model (params session)
  (bind query todo : Todo
    (db-get-scoped Db.getMine user Todo.Todo (field id (var params)))
    (pure query (record Model (todo (var todo))))))
(value Todos.Show.view : Model -> Session -> Html Msg (model session)
  (elem html
    (elem body (elem h1 (hexpr text (field title (field todo (var model))))))))
(test "the owner sees their todo" task
  (bind task me : Text
    (db-insert User.User (record (name "Me") (role (ctor User.Role.Reader))))
    (bind task id : Text
      (db-insert Todo.Todo
        (record (title "Milk") (done False) (owner (var me))))
      (bind task _
        (test-login
          (record App.Session
            (user (ctor Prelude.Maybe.Just (record (value (var me)))))
            (role (ctor User.Role.Reader))))
        (bind task page : { model: Model, session: App.Session, doc: Doc, notices: List Text }
          (test-get Todos.Show (record Params (id (var id))))
          (pure task
            (test-eq (field title (field todo (field model (var page)))) "Milk")))))))
(test "a stranger's open of my todo is not found" task
  (bind task me : Text
    (db-insert User.User (record (name "Me") (role (ctor User.Role.Reader))))
    (bind task bob : Text
      (db-insert User.User (record (name "Bob") (role (ctor User.Role.Reader))))
      (bind task id : Text
        (db-insert Todo.Todo
          (record (title "Milk") (done False) (owner (var me))))
        (bind task _
          (test-login
            (record App.Session
              (user (ctor Prelude.Maybe.Just (record (value (var bob)))))
              (role (ctor User.Role.Reader))))
          (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
            (test-open Todos.Show (record Params (id (var id))))
            (pure task
              (test-eq (field answer (var r)) (ctor Prelude.Answer.PageMissing)))))))))
(test "a visitor is sent to log in from a todo" task
  (bind task me : Text
    (db-insert User.User (record (name "Me") (role (ctor User.Role.Reader))))
    (bind task id : Text
      (db-insert Todo.Todo
        (record (title "Milk") (done False) (owner (var me))))
      (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
        (test-open Todos.Show (record Params (id (var id))))
        (pure task
          (test-eq
            (field answer (var r))
            (ctor Prelude.Answer.Redirected
              (record (value (page-ref Login (record Login.Params)))))))))))
(table User.User (id id) (insert name role))
(table Todo.Todo
  (id id)
  (created created)
  (partition user owner)
  (ref owner User.User cascade)
  (insert title done owner))
(form Todos.Index.NewTodo)
(page Admin.Index "/admin"
  (params Params)
  (requires user)
  (roles Author Admin)
  (session Session)
  (model Model)
  (view Admin.Index.view)
  (load Admin.Index.load))
(page Admin.Users "/admin/users"
  (params Params)
  (requires user)
  (roles Admin)
  (session Session)
  (model Model)
  (view Admin.Users.view)
  (load Admin.Users.load))
(page Login "/login"
  (params Params)
  (model Model)
  (view Login.view)
  (load Login.load))
(page Todos.Index "/"
  (params Params)
  (requires user)
  (session Session)
  (model Model)
  (msg Add (params AddParams) (form NewTodo))
  (msg Toggle (params ToggleParams))
  (msg Rename (params RenameParams))
  (msg Remove (params RemoveParams))
  (msg Duplicate (params DuplicateParams))
  (view Todos.Index.view)
  (load Todos.Index.load)
  (update Todos.Index.update))
(page Todos.Show "/todos/{id}"
  (params Params)
  (requires user)
  (session Session)
  (model Model)
  (view Todos.Show.view)
  (load Todos.Show.load))
(session App.Session)
