(module User)
(union User.Role (Reader) (Author) (Admin))
(record User.User (id Text) (name Text) (role Role = (ctor User.Role.Reader)))
(value User.roleName : Role -> Text (role)
  (match union (var role)
    (case Reader "reader")
    (case Author "author")
    (case Admin "admin")))
(test "every role has its name" pure
  (test-eq
    (call (std List.map)
      (global User.roleName)
      (list
        (ctor User.Role.Reader)
        (ctor User.Role.Author)
        (ctor User.Role.Admin)))
    (list "reader" "author" "admin")))
(module Admin.Index)
(record Admin.Index.Model)
(record Admin.Index.Index.Params)
(record Admin.Index.Index.Session (user Text) (role User.Role))
(value Admin.Index.Index.load : Index.Params -> Index.Session -> Query Model (params session)
  (pure query (record Model)))
(value Admin.Index.roleOf : Index.Session -> User.Role (session)
  (field role (var session)))
(value Admin.Index.Index.view : Model -> Index.Session -> Html (model session)
  (elem html
    (elem body
      (elem p (attr id text "role")
        (hexpr text
          (call (global User.roleName)
            (call (global Admin.Index.roleOf) (var session))))))))
(test "an author is served" task
  (bind task me : Text
    (db-insert User.User (record (name "Me") (role (ctor User.Role.Author))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor User.Role.Author))))
      (bind task page : { model: Model, session: App.Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
        (test-get (route Admin.Index.Index) (record Index.Params))
        (pure task
          (test-eq
            (call (std Test.text) "#role" (field doc (var page)))
            (ctor Prelude.Maybe.Just (record (value "author")))))))))
(test "a reader on an author page is not found" task
  (bind task me : Text
    (db-insert User.User (record (name "Me") (role (ctor User.Role.Reader))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor User.Role.Reader))))
      (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
        (test-open (route Admin.Index.Index) (record Index.Params))
        (pure task
          (test-eq (field answer (var r)) (ctor Prelude.Answer.PageMissing)))))))
(test "a visitor is sent to log in from the admin page" task
  (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
    (test-open (route Admin.Index.Index) (record Index.Params))
    (pure task
      (test-eq
        (field answer (var r))
        (ctor Prelude.Answer.Redirected
          (record (value (route-ref Login.Login (record Login.Login.Params)))))))))
(test "a demoted admin still passes the cookie check" task
  (bind task me : Text
    (db-insert User.User (record (name "Me") (role (ctor User.Role.Admin))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor User.Role.Admin))))
      (bind task _
        (db-update User.User
          (var me)
          (lambda (u : User) (update (var u) (role (ctor User.Role.Reader)))))
        (bind task index : { answer: Answer, session: App.Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
          (test-open (route Admin.Index.Index) (record Index.Params))
          (bind task users : { answer: Answer, session: App.Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
            (test-open (route Admin.Users.Users)
              (record Admin.Users.Users.Params))
            (pure task
              (test-eq
                (record
                  (index (field answer (var index)))
                  (users (field answer (var users))))
                (record
                  (index (ctor Prelude.Answer.Shown))
                  (users (ctor Prelude.Answer.PageMissing)))))))))))
(module Admin.Users)
(record Admin.Users.Model)
(record Admin.Users.Users.Params)
(record Admin.Users.Users.Session (user Text) (role User.Role))
(value Admin.Users.Users.load : Users.Params -> Users.Session -> Query Model (params session)
  (bind query me : Maybe User
    (db-get User.User (field user (var session)))
    (match union (var me)
      (case Just (bind _m1 value : User)
        (let u : User
          (var _m1)
          (if (== : User.Role (field role (var u)) (ctor User.Role.Admin))
            (pure query (record Model))
            (not-found))))
      (case Nothing (not-found)))))
(value Admin.Users.Users.view : Model -> Users.Session -> Html (model session)
  (elem html (elem body (elem h1 (htext "users")))))
(test "an admin is served" task
  (bind task me : Text
    (db-insert User.User (record (name "Me") (role (ctor User.Role.Admin))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor User.Role.Admin))))
      (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
        (test-open (route Admin.Users.Users) (record Users.Params))
        (pure task (test-eq (field answer (var r)) (ctor Prelude.Answer.Shown)))))))
(test "a promoted reader needs to log in again" task
  (bind task me : Text
    (db-insert User.User (record (name "Me") (role (ctor User.Role.Admin))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor User.Role.Reader))))
      (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
        (test-open (route Admin.Users.Users) (record Users.Params))
        (pure task
          (test-eq (field answer (var r)) (ctor Prelude.Answer.PageMissing)))))))
(test "a visitor is sent to log in from the users page" task
  (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
    (test-open (route Admin.Users.Users) (record Users.Params))
    (pure task
      (test-eq
        (field answer (var r))
        (ctor Prelude.Answer.Redirected
          (record (value (route-ref Login.Login (record Login.Login.Params)))))))))
(module App)
(record App.Session
  (user Maybe Text)
  (role User.Role = (ctor User.Role.Reader)))
(value App.error : Error -> Html (err)
  (elem html (elem body (elem h1 (htext "error")))))
(value App.notFound : Html ()
  (elem html (elem body (elem h1 (htext "not found")))))
(module Login)
(record Login.Model)
(record Login.Login.Params)
(value Login.Login.load : Login.Params -> App.Session -> Query Model (params session)
  (pure query (record Model)))
(value Login.Login.view : Model -> App.Session -> Html (model session)
  (elem html (elem body (elem h1 (htext "log in")))))
(module Todo)
(record Todo.Todo
  (id Text)
  (title Text)
  (done Bool = False)
  (owner Text)
  (created Time))
(test "deleting a user deletes their todos" task
  (bind task me : Text
    (db-insert User.User (record (name "Me") (role (ctor User.Role.Reader))))
    (bind task _
      (db-insert Todo.Todo (record (title "a") (done False) (owner (var me))))
      (bind task _
        (db-delete User.User (var me))
        (bind task n : Int
          (db-select Todo.Todo count)
          (pure task (test-eq (var n) 0)))))))
(module Todos.Index)
(record Todos.Index.Model (todos List Todo) (open Int))
(record Todos.Index.NewTodo (title Text))
(record Todos.Index.Index.Params)
(record Todos.Index.Add.Params (form NewTodo))
(record Todos.Index.Toggle.Params (id Text))
(record Todos.Index.Rename.Params (id Text))
(record Todos.Index.Remove.Params (id Text))
(record Todos.Index.Duplicate.Params (id Text))
(record Todos.Index.Index.Session (user Text) (role User.Role))
(value Todos.Index.recent : Select Todo ()
  (db-select Todo.Todo
    (base (db-scoped Db.mine user Todo.Todo))
    (order (ord (col Todo.Todo created) desc))
    (limit 2)
    select))
(value Todos.Index.Index.load : Index.Params -> Index.Session -> Query Model (params session)
  (bind query todos : List Todo
    (db-run all (global Todos.Index.recent))
    (bind query open : Int
      (db-select Todo.Todo
        (base (db-scoped Db.mine user Todo.Todo))
        (where (cond eq (col Todo.Todo done) False))
        count)
      (pure query (record Model (todos (var todos)) (open (var open)))))))
(value Todos.Index.Add.update : Add.Params -> Index.Session -> Task Response (p session)
  (bind task _
    (db-insert-scoped Db.insertMine user Todo.Todo
      (record (title (field title (field form (var p)))) (done False)))
    (pure task (std Response.refresh))))
(value Todos.Index.Toggle.update : Toggle.Params -> Index.Session -> Task Response (p session)
  (bind task _
    (db-update-scoped Db.updateMine user Todo.Todo
      (field id (var p))
      (lambda (t : Todo)
        (update (var t) (done (call (std Prelude.not) (field done (var t)))))))
    (pure task (std Response.refresh))))
(value Todos.Index.Rename.update : Rename.Params -> Index.Session -> Task Response (p session)
  (bind task t : Todo
    (db-get-scoped Db.getMine user Todo.Todo (field id (var p)))
    (bind task _
      (db-update Todo.Todo
        (field id (var t))
        (lambda (x : Todo) (update (var x) (title "renamed"))))
      (pure task (std Response.refresh)))))
(value Todos.Index.Remove.update : Remove.Params -> Index.Session -> Task Response (p session)
  (bind task _
    (db-delete-scoped Db.deleteMine user Todo.Todo (field id (var p)))
    (pure task (std Response.refresh))))
(value Todos.Index.Duplicate.update : Duplicate.Params -> Index.Session -> Task Response (p session)
  (bind task _
    (db-insert-scoped Db.insertMine user Todo.Todo
      (record (title "copy") (done False)))
    (bind task _
      (db-update-scoped Db.updateMine user Todo.Todo
        (field id (var p))
        (lambda (t : Todo) (update (var t) (done True))))
      (pure task (std Response.refresh)))))
(value Todos.Index.Index.view : Model -> Index.Session -> Html (model session)
  (elem html
    (elem body
      (form-el (route Todos.Index.Add)
        (attr submit submit (route-ref Todos.Index.Add))
        (input Input NewTodo field=title label="Title")
        (input Errors NewTodo form)
        (elem button (htext "Add")))
      (elem p (attr id text "open")
        (hexpr text (call (std Text.fromInt) (field open (var model)))))
      (elem ul
        (hfor t : Todo
          (field todos (var model))
          (elem li
            (elem span (hexpr text (field title (var t))))
            (elem button
              (attr click click
                (route-ref Todos.Index.Toggle
                  (record Toggle.Params (id (field id (var t))))))
              (htext "toggle"))
            (elem button
              (attr click click
                (route-ref Todos.Index.Rename
                  (record Rename.Params (id (field id (var t))))))
              (htext "rename"))
            (elem button
              (attr click click
                (route-ref Todos.Index.Remove
                  (record Remove.Params (id (field id (var t))))))
              (htext "remove"))
            (elem button
              (attr click click
                (route-ref Todos.Index.Duplicate
                  (record Duplicate.Params (id (field id (var t))))))
              (htext "duplicate"))))))))
(value Todos.Index.titleOf : Maybe Todo -> Text (found)
  (match union (var found)
    (case Just (bind _m1 value : Todo)
      (let t : Todo (var _m1) (field title (var t))))
    (case Nothing "(gone)")))
(test "recent lists my two newest todos" task
  (bind task me : Text
    (db-insert User.User (record (name "Me") (role (ctor User.Role.Reader))))
    (bind task bob : Text
      (db-insert User.User (record (name "Bob") (role (ctor User.Role.Reader))))
      (bind task _
        (db-insert Todo.Todo (record (title "a") (done False) (owner (var me))))
        (bind task _
          (db-insert Todo.Todo
            (record (title "b") (done False) (owner (var me))))
          (bind task _
            (db-insert Todo.Todo
              (record (title "c") (done False) (owner (var me))))
            (bind task _
              (db-insert Todo.Todo
                (record (title "bob's") (done False) (owner (var bob))))
              (bind task _
                (test-login
                  (record App.Session
                    (user (ctor Prelude.Maybe.Just (record (value (var me)))))
                    (role (ctor User.Role.Reader))))
                (bind task r : { value: Result Text (List Text), trace: List Text }
                  (test-run
                    (bind task ts : List Todo
                      (db-run all (global Todos.Index.recent))
                      (pure task
                        (call (std List.map)
                          (lambda (t : Todo) (field title (var t)))
                          (var ts)))))
                  (pure task
                    (test-eq
                      (field value (var r))
                      (ctor Prelude.Result.Ok (record (value (list "c" "b")))))))))))))))
(test "a scoped helper needs a signed-in user" task
  (bind task r : { value: Result Text Int, trace: List Text }
    (test-run
      (bind task ts : List Todo
        (db-run all (global Todos.Index.recent))
        (pure task (call (std List.length) (var ts)))))
    (pure task
      (test-eq
        (record (value (field value (var r))) (trace (field trace (var r))))
        (record
          (value
            (ctor Prelude.Result.Err
              (record (value "Db.mine Todo: no signed-in user"))))
          (trace (list "Db.mine Todo" "Db.all Todo")))))))
(test "the open count is of my open todos" task
  (bind task me : Text
    (db-insert User.User (record (name "Me") (role (ctor User.Role.Reader))))
    (bind task bob : Text
      (db-insert User.User (record (name "Bob") (role (ctor User.Role.Reader))))
      (bind task _
        (db-insert Todo.Todo (record (title "a") (done False) (owner (var me))))
        (bind task _
          (db-insert Todo.Todo
            (record (title "b") (done False) (owner (var me))))
          (bind task _
            (db-insert Todo.Todo
              (record (title "c") (done True) (owner (var me))))
            (bind task _
              (db-insert Todo.Todo
                (record (title "d") (done False) (owner (var bob))))
              (bind task _
                (test-login
                  (record App.Session
                    (user (ctor Prelude.Maybe.Just (record (value (var me)))))
                    (role (ctor User.Role.Reader))))
                (bind task page : { model: Model, session: App.Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
                  (test-get (route Todos.Index.Index) (record Index.Params))
                  (pure task (test-eq (field open (field model (var page))) 2)))))))))))
(test "a visitor is sent to log in" task
  (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
    (test-open (route Todos.Index.Index) (record Index.Params))
    (pure task
      (test-eq
        (field answer (var r))
        (ctor Prelude.Answer.Redirected
          (record (value (route-ref Login.Login (record Login.Login.Params)))))))))
(test "adding a todo stores an open todo of mine" task
  (bind task me : Text
    (db-insert User.User (record (name "Me") (role (ctor User.Role.Reader))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor User.Role.Reader))))
      (bind task _
        (test-get (route Todos.Index.Index) (record Index.Params))
        (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
          (test-submit Todos.Index.NewTodo (route Todos.Index.Add)
            (record NewTodo (title "Milk")))
          (bind task mine : List Todo
            (db-select Todo.Todo
              (where (cond eq (col Todo.Todo owner) (var me)))
              all)
            (pure task
              (test-eq
                (record
                  (answer (field answer (var r)))
                  (todos
                    (call (std List.map)
                      (lambda (t : Todo)
                        (record
                          (title (field title (var t)))
                          (done (field done (var t)))))
                      (var mine))))
                (record
                  (answer (ctor Prelude.Answer.Refreshed))
                  (todos (list (record (title "Milk") (done False)))))))))))))
(test "a visitor is sent to log in from every write" task
  (bind task me : Text
    (db-insert User.User (record (name "Me") (role (ctor User.Role.Reader))))
    (bind task id : Text
      (db-insert Todo.Todo
        (record (title "Milk") (done False) (owner (var me))))
      (bind task _
        (test-login
          (record App.Session
            (user (ctor Prelude.Maybe.Just (record (value (var me)))))
            (role (ctor User.Role.Reader))))
        (bind task _
          (test-get (route Todos.Index.Index) (record Index.Params))
          (bind task _
            (test-login
              (record App.Session
                (user (ctor Prelude.Maybe.Nothing))
                (role (ctor User.Role.Reader))))
            (bind task added : { answer: Answer, session: App.Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
              (test-submit Todos.Index.NewTodo (route Todos.Index.Add)
                (record NewTodo (title "Eggs")))
              (bind task _
                (test-login
                  (record App.Session
                    (user (ctor Prelude.Maybe.Just (record (value (var me)))))
                    (role (ctor User.Role.Reader))))
                (bind task _
                  (test-get (route Todos.Index.Index) (record Index.Params))
                  (bind task _
                    (test-login
                      (record App.Session
                        (user (ctor Prelude.Maybe.Nothing))
                        (role (ctor User.Role.Reader))))
                    (bind task toggled : { answer: Answer, session: App.Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
                      (test-click (route Todos.Index.Toggle)
                        (record Toggle.Params (id (var id))))
                      (bind task _
                        (test-login
                          (record App.Session
                            (user
                              (ctor Prelude.Maybe.Just
                                (record (value (var me)))))
                            (role (ctor User.Role.Reader))))
                        (bind task _
                          (test-get (route Todos.Index.Index)
                            (record Index.Params))
                          (bind task _
                            (test-login
                              (record App.Session
                                (user (ctor Prelude.Maybe.Nothing))
                                (role (ctor User.Role.Reader))))
                            (bind task renamed : { answer: Answer, session: App.Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
                              (test-click (route Todos.Index.Rename)
                                (record Rename.Params (id (var id))))
                              (bind task _
                                (test-login
                                  (record App.Session
                                    (user
                                      (ctor Prelude.Maybe.Just
                                        (record (value (var me)))))
                                    (role (ctor User.Role.Reader))))
                                (bind task _
                                  (test-get (route Todos.Index.Index)
                                    (record Index.Params))
                                  (bind task _
                                    (test-login
                                      (record App.Session
                                        (user (ctor Prelude.Maybe.Nothing))
                                        (role (ctor User.Role.Reader))))
                                    (bind task removed : { answer: Answer, session: App.Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
                                      (test-click (route Todos.Index.Remove)
                                        (record Remove.Params (id (var id))))
                                      (bind task _
                                        (test-login
                                          (record App.Session
                                            (user
                                              (ctor Prelude.Maybe.Just
                                                (record (value (var me)))))
                                            (role (ctor User.Role.Reader))))
                                        (bind task _
                                          (test-get (route Todos.Index.Index)
                                            (record Index.Params))
                                          (bind task _
                                            (test-login
                                              (record App.Session
                                                (user
                                                  (ctor Prelude.Maybe.Nothing))
                                                (role (ctor User.Role.Reader))))
                                            (bind task copied : { answer: Answer, session: App.Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
                                              (test-click (route Todos.Index.Duplicate)
                                                (record Duplicate.Params
                                                  (id (var id))))
                                              (bind task todos : List Todo
                                                (db-select Todo.Todo all)
                                                (let login : Answer
                                                  (ctor Prelude.Answer.Redirected
                                                    (record
                                                      (value
                                                        (route-ref Login.Login
                                                          (record Login.Login.Params)))))
                                                  (pure task
                                                    (&&
                                                      (== : List Answer (list (field answer (var added)) (field answer (var toggled)) (field answer (var renamed)) (field answer (var removed)) (field answer (var copied)))
                                                        (list
                                                          (var login)
                                                          (var login)
                                                          (var login)
                                                          (var login)
                                                          (var login)))
                                                      (== : List { title: Text, done: Bool } (call (std List.map) (lambda (t : Todo) (record (title (field title (var t))) (done (field done (var t))))) (var todos))
                                                        (list
                                                          (record
                                                            (title "Milk")
                                                            (done False)))))))))))))))))))))))))))))))
(test "toggling my todo" task
  (bind task me : Text
    (db-insert User.User (record (name "Me") (role (ctor User.Role.Reader))))
    (bind task id : Text
      (db-insert Todo.Todo
        (record (title "Milk") (done False) (owner (var me))))
      (bind task _
        (test-login
          (record App.Session
            (user (ctor Prelude.Maybe.Just (record (value (var me)))))
            (role (ctor User.Role.Reader))))
        (bind task _
          (test-get (route Todos.Index.Index) (record Index.Params))
          (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
            (test-click (route Todos.Index.Toggle)
              (record Toggle.Params (id (var id))))
            (bind task after : Maybe Todo
              (db-get Todo.Todo (var id))
              (pure task
                (test-eq
                  (record
                    (answer (field answer (var r)))
                    (done
                      (call (std Maybe.map)
                        (lambda (t : Todo) (field done (var t)))
                        (var after))))
                  (record
                    (answer (ctor Prelude.Answer.Refreshed))
                    (done (ctor Prelude.Maybe.Just (record (value True))))))))))))))
(test "renaming my todo" task
  (bind task me : Text
    (db-insert User.User (record (name "Me") (role (ctor User.Role.Reader))))
    (bind task id : Text
      (db-insert Todo.Todo
        (record (title "Milk") (done False) (owner (var me))))
      (bind task _
        (test-login
          (record App.Session
            (user (ctor Prelude.Maybe.Just (record (value (var me)))))
            (role (ctor User.Role.Reader))))
        (bind task _
          (test-get (route Todos.Index.Index) (record Index.Params))
          (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
            (test-click (route Todos.Index.Rename)
              (record Rename.Params (id (var id))))
            (bind task after : Maybe Todo
              (db-get Todo.Todo (var id))
              (pure task
                (test-eq
                  (record
                    (answer (field answer (var r)))
                    (title (call (global Todos.Index.titleOf) (var after))))
                  (record
                    (answer (ctor Prelude.Answer.Refreshed))
                    (title "renamed")))))))))))
(test "removing my todo" task
  (bind task me : Text
    (db-insert User.User (record (name "Me") (role (ctor User.Role.Reader))))
    (bind task id : Text
      (db-insert Todo.Todo
        (record (title "Milk") (done False) (owner (var me))))
      (bind task _
        (test-login
          (record App.Session
            (user (ctor Prelude.Maybe.Just (record (value (var me)))))
            (role (ctor User.Role.Reader))))
        (bind task _
          (test-get (route Todos.Index.Index) (record Index.Params))
          (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
            (test-click (route Todos.Index.Remove)
              (record Remove.Params (id (var id))))
            (bind task after : Maybe Todo
              (db-get Todo.Todo (var id))
              (pure task
                (test-eq
                  (record
                    (answer (field answer (var r)))
                    (title (call (global Todos.Index.titleOf) (var after))))
                  (record
                    (answer (ctor Prelude.Answer.Refreshed))
                    (title "(gone)")))))))))))
(test "duplicating my todo" task
  (bind task me : Text
    (db-insert User.User (record (name "Me") (role (ctor User.Role.Reader))))
    (bind task id : Text
      (db-insert Todo.Todo
        (record (title "Milk") (done False) (owner (var me))))
      (bind task _
        (test-login
          (record App.Session
            (user (ctor Prelude.Maybe.Just (record (value (var me)))))
            (role (ctor User.Role.Reader))))
        (bind task _
          (test-get (route Todos.Index.Index) (record Index.Params))
          (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
            (test-click (route Todos.Index.Duplicate)
              (record Duplicate.Params (id (var id))))
            (bind task after : Maybe Todo
              (db-get Todo.Todo (var id))
              (bind task n : Int
                (db-select Todo.Todo
                  (where (cond eq (col Todo.Todo owner) (var me)))
                  count)
                (pure task
                  (test-eq
                    (record
                      (answer (field answer (var r)))
                      (done
                        (call (std Maybe.map)
                          (lambda (t : Todo) (field done (var t)))
                          (var after)))
                      (n (var n)))
                    (record
                      (answer (ctor Prelude.Answer.Refreshed))
                      (done (ctor Prelude.Maybe.Just (record (value True))))
                      (n 2))))))))))))
