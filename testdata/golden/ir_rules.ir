(module User)
(union User.Role (Reader) (Author) (Admin))
(record User.User (id Text) (name Text) (role Role = (ctor User.Role.Reader)))
(value User.roleName : Role -> Text (role)
  (match union (var role)
    (case Reader "reader")
    (case Author "author")
    (case Admin "admin")))
(module Admin.Index)
(record Admin.Index.Model)
(record Admin.Index.Params)
(union Admin.Index.Msg)
(record Admin.Index.Session (user Text) (role User.Role))
(value Admin.Index.load : Params -> Session -> Query Model (params session)
  (pure query (record Model)))
(value Admin.Index.roleOf : Session -> User.Role (session)
  (field role (var session)))
(value Admin.Index.view : Model -> Session -> Html Msg (model session)
  (elem p
    (hexpr text
      (call (global User.roleName)
        (call (global Admin.Index.roleOf) (var session))))))
(module Admin.Users)
(record Admin.Users.Model)
(record Admin.Users.Params)
(union Admin.Users.Msg)
(record Admin.Users.Session (user Text) (role User.Role))
(value Admin.Users.load : Params -> Session -> Query Model (params session)
  (pure query (record Model)))
(value Admin.Users.view : Model -> Session -> Html Msg (model session)
  (elem p (htext "users")))
(module App)
(record App.Session
  (user Maybe Text)
  (role User.Role = (ctor User.Role.Reader)))
(union App.Msg)
(value App.error : Error -> Html Never (err) (elem p (htext "error")))
(value App.notFound : Html Never () (elem p (htext "not found")))
(module Login)
(record Login.Model)
(record Login.Params)
(union Login.Msg)
(value Login.load : Params -> App.Session -> Query Model (params session)
  (pure query (record Model)))
(value Login.view : Model -> App.Session -> Html Msg (model session)
  (elem p (htext "log in")))
(module Todo)
(record Todo.Todo
  (id Text)
  (title Text)
  (done Bool = False)
  (owner Text)
  (created Time))
(module Todos.Index)
(record Todos.Index.Model (todos List Todo) (open Int))
(record Todos.Index.NewTodo (title Text))
(record Todos.Index.Params)
(record Todos.Index.AddParams (form NewTodo))
(record Todos.Index.ToggleParams (id Text))
(record Todos.Index.RenameParams (id Text))
(record Todos.Index.RemoveParams (id Text))
(union Todos.Index.Msg
  (Add AddParams)
  (Toggle ToggleParams)
  (Rename RenameParams)
  (Remove RemoveParams))
(record Todos.Index.Session (user Text) (role User.Role))
(value Todos.Index.recent : Select Todo ()
  (db-select Todo.Todo
    (base (db-mine Todo.Todo))
    (order (ord (col Todo.Todo created) desc))
    (limit 10)
    select))
(value Todos.Index.load : Params -> Session -> Query Model (params session)
  (bind query todos : List Todo
    (db-run all (global Todos.Index.recent))
    (bind query open : Int
      (db-select Todo.Todo
        (base (db-mine Todo.Todo))
        (where (cond eq (col Todo.Todo done) False))
        count)
      (pure query (record Model (todos (var todos)) (open (var open)))))))
(value Todos.Index.update : Msg -> Model -> Session -> Task Nav (msg model session)
  (match union (var msg)
    (case Add (bind _m1 : AddParams)
      (let p : AddParams
        (var _m1)
        (bind task _
          (db-insert-mine Todo.Todo
            (record (title (field title (field form (var p)))) (done False)))
          (pure task (ctor Prelude.Nav.Rerender)))))
    (case Toggle (bind _m2 : ToggleParams)
      (let p : ToggleParams
        (var _m2)
        (bind task _
          (db-update-mine Todo.Todo
            (field id (var p))
            (lambda (t : Todo)
              (update (var t)
                (done (call (std Prelude.not) (field done (var t)))))))
          (pure task (ctor Prelude.Nav.Rerender)))))
    (case Rename (bind _m3 : RenameParams)
      (let p : RenameParams
        (var _m3)
        (bind task t : Todo
          (db-get-mine Todo.Todo (field id (var p)))
          (bind task _
            (db-update Todo.Todo
              (field id (var t))
              (lambda (x : Todo)
                (update (var x) (title (++ : Text (field title (var x)) "!")))))
            (pure task (ctor Prelude.Nav.Rerender))))))
    (case Remove (bind _m4 : RemoveParams)
      (let p : RemoveParams
        (var _m4)
        (bind task _
          (db-delete-mine Todo.Todo (field id (var p)))
          (pure task (ctor Prelude.Nav.Rerender)))))))
(value Todos.Index.view : Model -> Session -> Html Msg (model session)
  (elem ul
    (hfor t : Todo
      (field todos (var model))
      (elem li
        (elem button
          (attr click click
            (ctor Todos.Index.Msg.Toggle
              (record ToggleParams (id (field id (var t))))))
          (hexpr text (field title (var t))))))))
(module Todos.Show)
(record Todos.Show.Model (todo Todo))
(record Todos.Show.Params (id Text))
(union Todos.Show.Msg)
(record Todos.Show.Session (user Text) (role User.Role))
(value Todos.Show.load : Params -> Session -> Query Model (params session)
  (bind query todo : Todo
    (db-get-mine Todo.Todo (field id (var params)))
    (pure query (record Model (todo (var todo))))))
(value Todos.Show.view : Model -> Session -> Html Msg (model session)
  (elem h1 (hexpr text (field title (field todo (var model))))))
(table User.User (id id) (insert name role))
(table Todo.Todo
  (id id)
  (created created)
  (owner owner)
  (ref owner User.User cascade)
  (insert title done owner))
(form Todos.Index.NewTodo)
(page Admin.Index "/admin"
  (params Params)
  (requires user)
  (roles Author Admin)
  (session Session)
  (model Model)
  (view Admin.Index.view)
  (load Admin.Index.load))
(page Admin.Users "/admin/users"
  (params Params)
  (requires user)
  (roles Admin)
  (session Session)
  (model Model)
  (view Admin.Users.view)
  (load Admin.Users.load))
(page Login "/login"
  (params Params)
  (model Model)
  (view Login.view)
  (load Login.load))
(page Todos.Index "/"
  (params Params)
  (requires user)
  (session Session)
  (model Model)
  (msg Add (params AddParams) (form NewTodo))
  (msg Toggle (params ToggleParams))
  (msg Rename (params RenameParams))
  (msg Remove (params RemoveParams))
  (view Todos.Index.view)
  (load Todos.Index.load)
  (update Todos.Index.update))
(page Todos.Show "/todos/{id}"
  (params Params)
  (requires user)
  (session Session)
  (model Model)
  (view Todos.Show.view)
  (load Todos.Show.load))
(session App.Session)
