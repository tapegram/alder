module P

import T

route P   = GET  "/p/{id}"       { id: T.TId } requires user
route Inc = POST "/p/{id}/_/Inc" { id: T.TId } requires user
route Dec = POST "/p/{id}/_/Dec" { id: T.TId } requires user

type Model = { t: T }

P.load : P.Params -> Session -> Query Model
P.load params session = {
  let _ <- Db.delete T params.id
  let found <- Db.get T params.id
  match found {
    Just t -> Query.succeed { t: t },
    Nothing -> Query.notFound,
  }
}

Inc.update : Inc.Params -> Session -> Task Response
Inc.update p session = {
  let _ <- Db.update T p.id (\t -> { t | n: t.n + 1 })
  Task.succeed Response.refresh
}

P.view : Model -> Session -> Html Never
P.view model session = <p>{Text.fromInt model.t.n}</p>
