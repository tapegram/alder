module Todo

type TodoId = brand Text
type Cents = brand Int
type Filter = All | Active | Completed

table Todo {
  id: TodoId @id,
  title: Text.NonEmpty,
  done: Bool = False,
  due: Maybe Date,
  price: Cents,
}

matches : Filter -> Todo -> Bool
matches filter todo = match filter {
  All -> True,
  Active -> not todo.done,
}

label : Filter -> Text
label f = match f {
  All -> "all",
  Active -> "active",
  Completed -> "done",
  _ -> "never",
}

total : List Todo -> Cents
total todos = List.foldl (\t acc -> t.price + acc) (Cents 0) todos

bad1 : Int
bad1 = "x" + 1

bad2 : Text
bad2 = "n = {List.length []}"

bad3 : Text
bad3 = Text.trim (TodoId "a") ++ (TodoId "b")

bad4 : Bool
bad4 = (TodoId "a") == "a"

bad5 : Todo -> Text
bad5 t = t.due.year

bad6 : Query (Maybe Todo)
bad6 = {
  let found <- Db.get Todo "not-an-id"
  Query.succeed found
}

bad7 : Query Unit
bad7 = {
  let _ <- Db.delete Todo (TodoId "a")
  Query.succeed ()
}

bad8 : Int
bad8 = {
  let x <- Query.succeed 1
  x
}

bad9 : Maybe Int -> Int
bad9 m = match m {
  Just x -> x,
}

bad10 : List Int -> Int
bad10 xs = match xs {
  [] -> 0,
}

ok1 : Maybe Int -> Int
ok1 m = m ?? 0

ok2 : Todo -> Text
ok2 t = t.title

ok3 : Filter -> Bool
ok3 f = f < Completed

ok4 : List Int -> List Int
ok4 xs = xs |> List.map (\x -> x + 1) |> List.filter (\x -> x > 2)

ok5 : { w: Float, h: Float } -> Float
ok5 r = r.w * r.h

ok6 : Todo -> Todo
ok6 t = { t | done: True }

bad11 : Todo -> Todo
bad11 t = { t | nope: True }

test "label all" = label All == "all"

bad12 : Filter -> Int
bad12 f = match f { All -> 1, All -> 2, _ -> 3 }

bad13 : Todo -> Task Todo.TodoId
bad13 t = Db.insert Todo { id: TodoId "x", title: t.title, due: Nothing, price: Cents 1 }

bad14 : Int
bad14 = (\m -> match m { Just x -> x, Nothing -> 0 }) (Just 1)

bad15 : Filter -> Int
bad15 f = match f { All -> 1 }

ok7 : Maybe Int
ok7 = Just 1

type Msgish = Wrap Int

ok8 : Msgish
ok8 = Wrap 1

-- nested patterns (#2)
nest1 : List (Maybe Int) -> Int
nest1 xs = match xs {
  [Just m, Just s, Just p] -> m + s + p,
}

nest2 : List (Maybe Int) -> Int
nest2 xs = match xs {
  [Just x] -> x,
  [Just 1] -> 1,
  _ -> 0,
}

type Link = { v: Int, next: Maybe { v: Int, done: Bool } }

nest3 : Link -> Int
nest3 l = match l {
  { next: Nothing } -> 0,
  { next: Just { done: True } } -> 1,
}

nest4 : Maybe (Maybe Int) -> Int
nest4 m = match m { Just (Just x) -> x, Just Nothing -> 0, Nothing -> 1, Just _ -> 2 }

ok9 : Maybe (List Int) -> Int
ok9 m = match m { Just [a, ..r] -> a, Just [] -> 0, Nothing -> 1 }

nest5 : { a: Bool, b: Bool } -> Int
nest5 r = match r { { a: True } -> 0, { a: True } -> 1, _ -> 2 }

nest6 : Maybe { a: Int } -> Int
nest6 m = match m { Just { a: 1 } -> 0, Just { a: 1 } -> 1, _ -> 2 }

nest7 : List (Maybe Int) -> Int
nest7 xs = match xs { [Just a, Just b, Just c, Just d, Just e] -> a }
