module Orgs

import Membership
import Org
import User
import Project

-- `choose org`'s page: it requires the user, not the org, and sets the org.
page "/orgs" { } requires user

type Model = { mine: List Membership }

load : Params -> Session -> Query Model
load params session = {
  let mine <- Db.from Membership |> Db.where (Membership.user.eq session.user) |> Db.all
  Query.succeed { mine: mine }
}

form SwitchOrg = {
  org: Org.OrgId,
}

msg Pick { org: Org.OrgId }
msg Switch form SwitchOrg

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  -- `via Membership`: the runtime refuses an org the user is not a member of
  Pick p -> {
    let _ <- Session.put (\s -> { s | org: Just p.org })
    Task.succeed (Redirect (Projects.Index {}))
  },
  -- the same from a form: a non-member's switch is the form's error (the route's Reject)
  Switch p -> {
    let _ <- Session.put (\s -> { s | org: Just p.form.org })
    Task.succeed (Redirect (Projects.Index {}))
  },
}

view : Model -> Session -> Html Msg
view model session =
  <html><body>
    <ul>{for m in model.mine -> <li><button click={Pick { org: m.org }}>{"pick"}</button></li>}</ul>
    <form submit={Switch}>
      <Input field="org" label="Org" />
      <Errors form />
      <button>switch</button>
    </form>
    <button click={App.Leave}>leave</button>
  </body></html>

test "a member picks an org" = {
  let me <- Db.insert User { name: "Me" }
  let a <- Db.insert Org { name: "A" }
  let _ <- Test.member me a
  let _ <- Test.login { user: Just me, org: Nothing }
  let _ <- Test.get (Orgs {})
  let r <- Test.click (Pick { org: a })
  Task.succeed (r.answer == Redirected (Projects.Index {}) && r.session.org == Just a)
}

test "a non-member's switch is refused" = {
  let me <- Db.insert User { name: "Me" }
  let a <- Db.insert Org { name: "A" }
  let b <- Db.insert Org { name: "B" }
  let _ <- Test.member me a
  let _ <- Test.login { user: Just me, org: Just a }
  -- a crafted request: the page offers no such button, the update is run as it would be
  let r <- Test.run (update (Pick { org: b }) { mine: [] } { user: me, org: Just a, role: Reader })
  let put <- Test.run (Session.put (\s -> { s | org: Just b }))
  Task.succeed ({ r: r.value, put: put.value } == { r: Err "Session.put org: no Membership for this user and org", put: Err "Session.put org: no Membership for this user and org" })
}

test "a non-member's switch from the form is the form's error" = {
  let me <- Db.insert User { name: "Me" }
  let a <- Db.insert Org { name: "A" }
  let b <- Db.insert Org { name: "B" }
  let _ <- Test.member me a
  let _ <- Test.login { user: Just me, org: Just a }
  let _ <- Test.get (Orgs {})
  let r <- Test.submit SwitchOrg { org: b }
  let ok <- Test.submit SwitchOrg { org: a }
  Task.succeed ({ answer: r.answer, org: r.session.org, ok: ok.answer } == { answer: FormRejected [{ field: "", message: "You are not a member of that workspace." }], org: Just a, ok: Redirected (Projects.Index {}) })
}

test "a membership deleted earlier in the same Task counts as gone" = {
  let me <- Db.insert User { name: "Me" }
  let a <- Db.insert Org { name: "A" }
  let m <- Db.insert Membership { user: me, org: a }
  let _ <- Test.login { user: Just me, org: Nothing }
  let r <- Test.run {
    let _ <- Db.delete Membership m
    Session.put (\s -> { s | org: Just a })
  }
  Task.succeed (r.value == Err "Session.put org: no Membership for this user and org")
}

test "leaving the org clears it" = {
  let me <- Db.insert User { name: "Me" }
  let a <- Db.insert Org { name: "A" }
  let _ <- Test.member me a
  let _ <- Test.login { user: Just me, org: Just a }
  let _ <- Test.get (Orgs {})
  let r <- Test.click App.Leave
  Task.succeed (r.answer == Redirected (Orgs {}) && r.session.org == Nothing)
}

test "the picker lists the user's own memberships" = {
  let me <- Db.insert User { name: "Me" }
  let them <- Db.insert User { name: "Them" }
  let a <- Db.insert Org { name: "A" }
  let b <- Db.insert Org { name: "B" }
  let _ <- Test.member me a
  let _ <- Test.member them b
  let _ <- Test.login { user: Just me, org: Nothing }
  let page <- Test.get (Orgs {})
  Task.succeed (List.map (\m -> m.org) page.model.mine == [a])
}

test "a visitor is sent to log in" = {
  let r <- Test.open (Orgs {})
  Task.succeed (r.answer == Redirected (Login {}))
}

test "logging out clears the org" = {
  let me <- Db.insert User { name: "Me" }
  let a <- Db.insert Org { name: "A" }
  let _ <- Test.member me a
  let _ <- Test.login { user: Just me, org: Just a }
  let r <- Test.run (Session.put (\s -> { s | user: Nothing }))
  let back <- Test.run (Session.put (\s -> { s | user: Just me }))
  let insert <- Test.run (Db.insertScoped Project.Project { name: "x" })
  Task.succeed ({ out: r.value, back: back.value, insert: Result.map (\x -> ()) insert.value } == { out: Ok (), back: Ok (), insert: Err "Db.insertScoped Project: the session has no org" })
}
