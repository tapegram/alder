(module P)
(union P.Tree a (Leaf) (Node { value: a, size: Int }))
(record P.Opts (name Text) (loud Bool = False))
(union P.Shape (Circle { value: Float }) (Rect { w: Int, h: Int }))
(value P.zero : Int () 0)
(value P.describe : Maybe Int -> Text (m)
  (match union (var m)
    (case Just (bind _m1 value : Int)
      (match lit (var _m1)
        (case 0 "zero")
        (default
          (let n : Int (var _m1) (str "n = " (call (std Text.fromInt) (var n)))))))
    (case Nothing "none")))
(value P.firstTwo : List Int -> Int (xs)
  (match list (var xs)
    (case nil 0)
    (case cons (bind _m1 head : Int) (bind _m2 rest : List Int)
      (match list (var _m2)
        (case nil (let x : Int (var _m1) (var x)))
        (default
          (match list (var _m2)
            (case cons (bind _m3 head : Int) (bind _m4 rest : List Int)
              (let a : Int
                (var _m1)
                (let b : Int
                  (var _m3)
                  (let rest : List Int
                    (var _m4)
                    (+ (+ (var a) (var b)) (call (std List.length) (var rest)))))))))))))
(value P.word : Int -> Text (n)
  (match lit (var n) (case 1 "one") (case 2 "two") (default "many")))
(value P.greet : Text -> Text (name)
  (match lit (var name)
    (case "" "nobody")
    (default (let other : Text (var name) (++ : Text "hi " (var other))))))
(value P.flag : Bool -> Int (b)
  (match bool (var b) (case True 1) (case False 0)))
(value P.clamp : Int -> Int (n)
  (let _m1 : Int
    (+ (var n) 1)
    (match lit (var _m1)
      (case 0 0)
      (default (let k : Int (var _m1) (* (var k) 2))))))
(value P.width : Shape -> Int (s)
  (match union (var s)
    (case Rect (bind _m1 w : Int) (bind _m2 h : Int)
      (match lit (var _m1)
        (case 0 (let h : Int (var _m2) (var h)))
        (default (let w : Int (var _m1) (var w)))))
    (case Circle 1)))
(value P.point : { x: Int, y: Int } -> Int (p)
  (let x : Int
    (field x (var p))
    (let y : Int (field y (var p)) (+ (var x) (var y)))))
(value P.size : Tree Text -> Int (t)
  (match union (var t)
    (case Node (bind _m1 : { value: Text, size: Int })
      (let n : { value: Text, size: Int } (var _m1) (field size (var n))))
    (case Leaf 0)))
(value P.circles : List Float -> List Shape (rs)
  (call (std List.map)
    (lambda (_m1 : Float) (ctor P.Shape.Circle (record (value (var _m1)))))
    (var rs)))
(value P.adder : Int -> Int -> Int (a b) (+ (var a) (var b)))
(value P.addAll : List Int -> List Int (xs)
  (call (std List.append)
    (list 0)
    (call (std List.map) (partial (global P.adder) 1 (missing 1)) (var xs))))
(value P.joiner : List Text -> Text ()
  (partial (std Text.join) ", " (missing 1)))
(value P.opts : Opts () (record Opts (name "x") (loud False)))
(value P.compute : Int -> Int (n)
  (let a : Int
    (* (var n) 2)
    (let b : Int
      (+ (var a) 1)
      (if (&& (< : Int (var a) (var b)) (call (std Prelude.not) (== : Int (var a) 0)))
        (var a)
        (var b)))))
(value P.shout : Opts -> Opts (o) (update (var o) (loud True)))
(value P.both : List Text -> List Text -> List Text (a b)
  (++ : List Text (var a) (var b)))
(value P.later : Int -> Int (n) (hole todo))
(value P.nodeOf : Text -> Tree Text (v)
  (ctor P.Tree.Node (record (value (var v)) (size 1))))
(value P.capture : Int -> Shape -> Int (w s)
  (match union (var s)
    (case Rect (bind _m1 w : Int) (bind _m2 h : Int)
      (match lit (var _m2)
        (case 0 (let w : Int (var _m1) (var w)))
        (default (var w))))
    (default (var w))))
(value P.captureList : Int -> List Int -> Int (x xs)
  (match list (var xs)
    (case cons (bind _m1 head : Int) (bind _m2 rest : List Int)
      (match list (var _m2)
        (case nil (let x : Int (var _m1) (var x)))
        (default (var x))))
    (default (var x))))
(value P.boxed : Shape () (ctor P.Shape.Rect (record (w 1) (h 2))))
(value P.capRec : Int -> { a: Maybe Int, b: Int } -> Int (x r)
  (match union (field a (var r))
    (case Just (bind _m1 value : Int)
      (match lit (field b (var r))
        (case 0 (let x : Int (var _m1) (var x)))
        (default (var x))))
    (default (var x))))
(value P.capList : Int -> List (Maybe Int) -> Int (x xs)
  (match list (var xs)
    (case cons (bind _m1 head : Maybe Int) (bind _m2 rest : List (Maybe Int))
      (match union (var _m1)
        (case Just (bind _m3 value : Int)
          (match list (var _m2)
            (case cons (bind _m4 head : Maybe Int) (bind _m5 rest : List (Maybe Int))
              (match union (var _m4)
                (case Nothing
                  (match list (var _m5)
                    (case nil (let x : Int (var _m3) (var x)))
                    (default (var x))))
                (default (var x))))
            (default (var x))))
        (default (var x))))
    (default (var x))))
(component P.View : { items: List (Maybe Int) } -> Html a (props)
  (elem ul
    (hfor item : Maybe Int
      (field items (var props))
      (elem li
        (hmatch union (var item)
          (case Just (bind _m1 value : Int)
            (hmatch lit (var _m1)
              (case 0 (elem b (htext "zero")))
              (default
                (let n : Int
                  (var _m1)
                  (hexpr text (call (std Text.fromInt) (var n)))))))
          (case Nothing (hexpr html (std Html.none))))))))
