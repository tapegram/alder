module Blocks

load : Task Int
load = {
  let a = 1
  let b <- Db.get Todo id


  let c : Int = a + b
  let todos <- Db.mine Todo |> Db.orderBy Todo.created.desc |> Db.all

  c
}

tight : Task Int
tight = {

  let a = 1
  let b = 2
  a + b

}

resultOnly : Int
resultOnly = { x }

lam : Task Int
lam = Task.andThen (\x -> { let y = x + 1
  Task.succeed y }) start

viaLambda : List Int
viaLambda = List.map (\x -> { let y = x + 1
  y * 2 }) xs

ifBlocks : Task Int
ifBlocks = if admin then { let a <- load
  Task.succeed a } else if guest then { Task.succeed 0 } else { let b = 2
  Task.succeed b }

ifMixed : Task Int
ifMixed = if admin then { let a <- load
  Task.succeed a } else Task.fail "no access to this page for anyone who is not an administrator"
