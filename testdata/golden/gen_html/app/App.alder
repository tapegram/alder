module App

import Layout

session { visits: Int = 0 }

route Logout = POST "/_/Logout" { }

Logout.update : Logout.Params -> Session -> Task Response
Logout.update params session = Task.succeed Response.refresh

error : Error -> Html
error err = <p>error</p>

notFound : Html
notFound = <Layout.Page title="Not found"><h1>Not found</h1></Layout.Page>
