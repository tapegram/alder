recordOperand = someLongFunctionName aaaaaaaaaaaaaaaaaaa bbbbbbbbbbbbbbb ccccccccccc == { alpha: 1, beta: 2, gamma: 3 }

hugHeadTooLong = someVeryLongFunctionNameThatIsReally aaaaaaaaaaaaaaaaaaaaaaaa bbbbbbbbbbbbbbbbbbbbbbbb (\q -> q + 1)

