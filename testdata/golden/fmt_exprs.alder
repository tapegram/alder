module Exprs

redundant : Int
redundant = ((1 + 2))

nested : Int
nested = f (g x)

pipes : List Int
pipes = xs |> List.filter isEven |> List.map double |> List.sum

onePipe : List Int
onePipe = xs |> List.map double

longAnd : Bool
longAnd = isAdmin session && isMember session.user org && canEdit session.user post && post.published && not post.archived

rec3 : R
