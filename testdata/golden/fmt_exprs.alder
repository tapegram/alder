ifFits : Int
ifFits = if a then 1 else 2

ifBreaks : Text
ifBreaks = if someCondition model && anotherCondition model then "the first branch text" else "the other branch text"

ifChain : Text
ifChain = if n < 0 then "negative number here" else if n == 0 then "exactly zero here" else "positive number"

lambdaBreak : Int -> Int
lambdaBreak = \someArgument -> someFunction someArgument + anotherFunction someArgument + yetAnotherFunction someArgument

interp : Text
interp = "hello {user.name}, you have {Text.fromInt (List.length model.notifications)} unread notifications today"

negArg : Int
negArg = abs (-1) + -2

access : Text
access = (f x).name ++ model.user.name

nonLastBreaks : List Card
nonLastBreaks = [
  { key: "activity", rows: List.map (\row -> { label: row.summary, href: Admin.Activity.Show { id: row.id } }) activities },
]

emptyRecord : R
emptyRecord = f { } {}

