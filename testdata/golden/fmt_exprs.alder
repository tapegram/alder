rec2 : R
rec2 = {a: 1,b: 2}

update3 : R
update3 = { r | a: 1, b: 2, c: 3 }

update1 : R
update1 = { r | a: 1 }

longList : List Text
longList = ["alpha", "beta", "gamma", "delta", "epsilon", "zeta", "eta", "theta", "iota", "kappa", "lambda"]

shortList : List Int
shortList = [1,2,3]

lambdaNotLast : List Int
lambdaNotLast = List.map (\item -> computeTheValueOf item + adjustmentFor item * scalingFactor item) itemsToProcess

hugMap : List Int
hugMap = List.map someList (\item -> computeTheValueOf item + adjustmentFor item * scalingFactor item)

hugRecord : Task Int
hugRecord = Db.insert Todo { title: Text.NonEmpty "Milk", due: Nothing, owner: me }

hugLast : List Int
