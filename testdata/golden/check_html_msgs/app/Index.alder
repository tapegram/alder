module Index

import Todo

route Index  = GET  "/"         { }
route Toggle = POST "/" { id: Todo.TodoId }

type Model = { todos: List Todo }

Index.load : Index.Params -> Session -> Query Model
Index.load params session = {
  let todos <- Db.from Todo |> Db.all
  Query.succeed { todos: todos }
}

Toggle.update : Toggle.Params -> Session -> Task Response
Toggle.update p session = Task.succeed Response.refresh

Index.view : Model -> Session -> Html
Index.view model session =
  <ul>
    {for todo in model.todos ->
      <li>
        <form submit={Toggle { id: todo.id }}><Input field="title" /></form>
        <a href={"/todos/" ++ todo.title}>open</a>
        <a href={todo.slug}>slug</a>
        <a href={Index}>home</a>
      </li>}
  </ul>
