module Types

type Big = { a: Int, b: Text, c: Bool, d: Float, e: List Int, f: Maybe Text, g: Dict Text Int, h: Int, i: Text }

type Pair = {   x: Int,
  y: Int }

type Tag = A | B

type Long = Alpha Int | Beta Text | Gamma (List Int) | Delta { name: Text } | Epsilon (Maybe (List Text)) | Zeta

type Wrap a = Wrap (List a) | Fn (a -> Int) | Nested (Maybe (Maybe a)) | Rec { f: a -> b }

type Email = brand Text where Text.contains "@"

type Count = brand Int where (\n -> n >= 0)

type Plain = brand Text

type Empty = {}

f : { name: Text, email: Text } -> (Int -> Int) -> List (Maybe Int) -> Dict Text (List Int) -> Task (Maybe Int)
f a b c d = Task.succeed Nothing

g : Int->Int
g n = (n)

h : a -> (b -> c)
h x = h x

u : () -> Int
u x = 1

r3 : { a: Int, b: Int, c: Int } -> Int
r3 r = 1

rLong : { address: Text, subject: Text, body: Html Never, replyTo: Maybe Text.Email, cc: List Text } -> Task Unit
rLong r = Task.succeed {}

fLong : Dict Text (List Int) -> (Int -> Int) -> List (Maybe Int) -> Dict Text (List Int) -> Task (Maybe Int)
fLong a b c d = Task.succeed Nothing

fetchMany : Text -> Text -> { alpha: Int, beta: Text, gamma: Bool, delta: List Int, epsilon: Text } -> Task Unit
fetchMany a b r = Task.succeed ()

fetchNested : Text -> Task { alpha: Int, beta: Text, gamma: Bool, delta: List Int, epsilon: Text, zeta: Int } -> Task Unit
fetchNested a b = Task.succeed ()

fetchLongTail : Text -> { alpha: Int } -> Task Unit -> Task Unit -> Task Unit -> Task Unit -> Task Unit -> Task Unit -> Task Unit -> Task Unit
fetchLongTail a b = Task.succeed ()

fetchRecordTail : Text -> { alpha: Int, beta: Int } -> Task Unit -> Task Unit -> Task Unit -> Task Unit -> Task Unit -> Task Unit -> Task Unit -> Task Unit
fetchRecordTail a b = Task.succeed ()

fetchBoth : Text -> { to: Text, subject: Text, body: Text, cc: List Text, bcc: List Text, replyTo: Text, sender: Text } -> Task Unit -> Task Unit -> Task Unit -> Task Unit -> Task Unit -> Task Unit -> Task Unit -> Task Unit
fetchBoth a b = Task.succeed ()

capability Mail {
  send : Text -> { to: Text, subject: Text, body: Text, cc: List Text, bcc: List Text, replyTo: Text } -> Task Unit
}
