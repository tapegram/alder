module Sites.MnSos

route MnSos = GET "/mnsos" { cfg: Text }

type Model = { cfg: Text }

MnSos.load : MnSos.Params -> Session -> Query Model
MnSos.load params session = Query.succeed { cfg: params.cfg }

MnSos.view : Model -> Session -> File
MnSos.view model session = File.text { contentType: "text/plain", body: label model.cfg }

label : Text -> Text
label cfg = if cfg == "" then "draft" else cfg
