(module App)
(record App.Session (user Maybe Text) (visits Int = 0))
(union App.Msg)
(value App.error : Error -> Html (err) (elem p (htext "error")))
(value App.notFound : Html () (elem p (htext "not found")))
(module Edit)
(union Edit.Color (Red) (Green))
(record Edit.Model (n Int) (busy Bool))
(record Edit.Note (body Text) (color Color))
(record Edit.Edit.Params (n Int))
(record Edit.Save.Params (n Int) (form Note))
(record Edit.Ping.Params (n Int))
(value Edit.Edit.load : Edit.Params -> App.Session -> Query Model (params session)
  (pure query (record Model (n (field n (var params))) (busy False))))
(value Edit.Save.update : Save.Params -> App.Session -> Task Response (params session)
  (pure task (std Response.refresh)))
(value Edit.Ping.update : Ping.Params -> App.Session -> Task Response (params session)
  (pure task (std Response.refresh)))
(value Edit.Edit.view : Model -> App.Session -> Html (model session)
  (elem div
    (elem a (attr href href (route-ref Other.Other)) (htext "other"))
    (elem button
      (attr click click
        (route-ref Edit.Ping (record Ping.Params (n (field n (var model))))))
      (attr disabled bool (field busy (var model)))
      (htext "ping"))
    (form-el (route Edit.Save)
      (attr submit submit
        (route-ref Edit.Save (record Save.Params (n (field n (var model))))))
      (input Textarea Note field=body
        (label
          (++ : Text "Body of " (call (std Text.fromInt) (field n (var model))))))
      (input Select Note field=color label="Color"
        (value (ctor Edit.Color.Red))))
    (elem details (attr open bool True) (elem summary (htext "more")))))
(module Other)
(record Other.Model)
(record Other.Other.Params)
(value Other.Other.load : Other.Params -> App.Session -> Query Model (params session)
  (pure query (record Model)))
(value Other.Other.view : Model -> App.Session -> Html (model session)
  (elem a
    (attr href href (route-ref Edit.Edit (record Edit.Edit.Params (n 1))))
    (htext "edit")))
(module Secret)
(record Secret.Model)
(record Secret.Secret.Params)
(record Secret.Secret.Session (user Text) (visits Int))
(value Secret.Secret.load : Secret.Params -> Secret.Session -> Query Model (params session)
  (pure query (record Model)))
(value Secret.greeting : Secret.Session -> Text (session)
  (++ : Text "hello " (field user (var session))))
(value Secret.Secret.view : Model -> Secret.Session -> Html (model session)
  (elem p
    (hexpr text (call (global Secret.greeting) (var session)))
    (htext " (")
    (hexpr text (call (std Text.fromInt) (field visits (var session))))
    (htext ")")))
(form Edit.Note)
(route Edit.Edit GET "/edit/{n}"
  (params Edit.Params)
  (model Model)
  (load Edit.Edit.load)
  (view Edit.Edit.view))
(route Edit.Save POST "/edit/{n}/_/Save"
  (params Save.Params)
  (form Note)
  (update Edit.Save.update)
  (needs-shown))
(route Edit.Ping POST "/edit/{n}/_/Ping"
  (params Ping.Params)
  (update Edit.Ping.update)
  (needs-shown))
(route Other.Other GET "/other"
  (params Other.Params)
  (model Model)
  (load Other.Other.load)
  (view Other.Other.view))
(route Secret.Secret GET "/secret"
  (params Secret.Params)
  (requires user)
  (session Secret.Session)
  (model Model)
  (load Secret.Secret.load)
  (view Secret.Secret.view))
(session App.Session)
