module Notes.Index

import Note
import User

page "/" { filter: Note.Filter = All } requires user

type Model = {
  filter: Note.Filter,
  notes: List Note,
  now: Time,
}

load : Params -> Session -> Query Model
load params session = {
  let notes <- Db.from Note |> Db.where (Note.owner.eq session.user) |> Db.all
  let now <- Time.now
  Query.succeed { filter: params.filter, notes: List.filter (Note.matches params.filter) notes, now: now }
}

-- A form with a field of every kind a form can carry.
form NewNote = {
  title: Text.NonEmpty,
  due: Maybe Date,
  urgent: Bool,
  priority: Int = 1,
  weight: Float = 1.5,
  kind: Note.Kind = Plain,
  remark: Text = "",
  contact: Maybe Text.Email,
}

-- A form each row renders, and a form no view renders, with a field of the remaining kinds.
form Title = {
  title: Text.NonEmpty,
}

form Prefs = {
  site: Text.Url,
  pin: Text.Secret,
  tag: Note.Tag,
  count: Note.Count,
  reminder: Maybe Int = Just 3,
}

msg Submit form NewNote
msg Toggle { id: Note.NoteId }
msg Boom
msg Rename { id: Note.NoteId } form Title
msg SavePrefs form Prefs
msg Visit

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  Submit p -> {
    let _ <- Db.insert Note { title: p.form.title, owner: session.user }
    Task.succeed (Redirect (Notes.Index { filter: model.filter }))
  },
  Toggle p -> {
    let found <- Db.get Note p.id
    match found {
      Just n -> if n.owner == session.user then {
        let _ <- Db.update Note n.id (\x -> { x | done: not x.done })
        Task.succeed Rerender
      } else Task.notFound,
      Nothing -> Task.notFound,
    }
  },
  Boom p -> {
    let _ <- Task.all (List.map (\n -> Db.update Note n.id (\x -> { x | done: True })) model.notes)
    let zero = List.length model.notes - List.length model.notes
    Task.succeed (if 1 / zero == 0 then Rerender else Rerender)
  },
  Rename p -> {
    let _ <- Db.update Note p.id (\x -> { x | title: p.form.title })
    Task.succeed Rerender
  },
  SavePrefs p -> Task.succeed Rerender,
  Visit p -> {
    let _ <- Session.put (\s -> { s | visits: s.visits + 1 })
    Task.succeed Rerender
  },
}

view : Model -> Session -> Html Msg
view model session =
  <html>
    <body>
      <h1>Notes</h1>
      <form submit={Submit}>
        <Errors form />
        <Input field="title" label="Title" />
        <Errors field="title" />
        <Input field="due" label="Due" />
        <Errors field="due" />
        <Input field="urgent" label="Urgent" />
        <Input field="priority" label="Priority" />
        <Errors field="priority" />
        <Input field="weight" label="Weight" />
        <Errors field="weight" />
        <Select field="kind" label="Kind" />
        <Errors field="kind" />
        <Input field="remark" label="Remark" />
        <Input field="contact" label="Contact" />
        <Errors field="contact" />
        <button>Add</button>
      </form>
      <nav>
        {for f in [All, Open, Done] -> <a href={Notes.Index { filter: f }}>{Note.filterLabel f}</a>}
      </nav>
      <ul id="notes">
        {for n in model.notes ->
          <li class={if n.done then "done" else "open"}>
            <button class="toggle" click={Toggle { id: n.id }}>{n.title}</button>
            <form submit={Rename { id: n.id }}>
              <Input field="title" label="New title" />
              <Errors field="title" />
              <button>Rename</button>
            </form>
          </li>}
      </ul>
      <p id="summary">{Text.fromInt (List.length model.notes)} shown</p>
      <p id="filter">{Note.filterLabel model.filter}</p>
      <p id="now">{Time.format "15:04:05" model.now}</p>
      <form submit={App.Send}>
        <Input field="text" label="Feedback" />
        <Errors field="text" />
        <button>Send</button>
      </form>
      <button click={Boom}>Boom</button>
      <button click={Visit}>Visit</button>
      <p id="visits">{Text.fromInt session.visits}</p>
      <button click={App.Logout}>Log out</button>
    </body>
  </html>

test "adding a note through the form" = {
  let me <- Db.insert User { email: Text.Email "me@example.com", name: "Me" }
  let _ <- Test.login { user: Just me }
  let page <- Test.get (Notes.Index {})
  let after <- Test.submit NewNote { title: Text.NonEmpty "Milk", due: Nothing, urgent: False, contact: Nothing }
  Task.succeed ({ before: page.model.notes, answer: after.answer, summary: Test.text "#summary" after.doc, items: Test.texts "#notes .toggle" after.doc, done: Test.has "li.done" after.doc } == { before: [], answer: Redirected (Notes.Index {}), summary: Just "1 shown", items: ["Milk"], done: False })
}

-- RF3: a click on a page opened with a parameter keeps the parameter.
test "a click keeps the page's parameter" = {
  let me <- Db.insert User { email: Text.Email "me@example.com", name: "Me" }
  let id <- Db.insert Note { title: Text.NonEmpty "Milk", owner: me }
  let _ <- Test.login { user: Just me }
  let page <- Test.get (Notes.Index { filter: Open })
  let r <- Test.click (Toggle { id: id })
  Task.succeed ({ filter: page.model.filter, before: Test.count "li" page.doc, answer: r.answer, shown: Test.text "#filter" r.doc, after: Test.count "li" r.doc } == { filter: Open, before: 1, answer: Rerendered, shown: Just "Open", after: 0 })
}

test "a form with an empty title is rejected" = {
  let me <- Db.insert User { email: Text.Email "me@example.com", name: "Me" }
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Notes.Index {})
  let r <- Test.submitRaw NewNote [{ name: "title", value: "" }, { name: "priority", value: "x" }]
  let rows <- Db.from Note |> Db.count
  Task.succeed ({ answer: r.answer, rows: rows, priority: Test.attr "value" "input[name=priority]" r.doc } == { answer: Rejected [{ field: "title", message: "must not be empty" }, { field: "priority", message: "must be a whole number" }], rows: 0, priority: Just "x" })
}

-- RF5: a step inside Test.run.
test "a step inside Test.run" = {
  let me <- Db.insert User { email: Text.Email "me@example.com", name: "Me" }
  let _ <- Test.login { user: Just me }
  let r <- Test.run {
    let page <- Test.get (Notes.Index {})
    Task.succeed (Test.count "li" page.doc)
  }
  Task.succeed (r.value == Ok 0)
}

-- RF5: an update that panics is Failed; its write is undone and the test's rows stay.
test "a panicking update is Failed" = {
  let me <- Db.insert User { email: Text.Email "me@example.com", name: "Me" }
  let id <- Db.insert Note { title: Text.NonEmpty "Milk", owner: me }
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Notes.Index {})
  let r <- Test.click Boom
  let rows <- Db.from Note |> Db.where (Note.done.eq False) |> Db.count
  let failed = match r.answer {
    Failed _ -> True,
    _ -> False,
  }
  Task.succeed ({ failed: failed, rows: rows, title: Test.text "h1" r.doc } == { failed: True, rows: 1, title: Just "Something went wrong" })
}

test "the document and the view agree" = {
  let me <- Db.insert User { email: Text.Email "me@example.com", name: "Me" }
  let _ <- Db.insert Note { title: Text.NonEmpty "Milk", owner: me }
  let _ <- Test.login { user: Just me }
  let page <- Test.get (Notes.Index { filter: Open })
  let sel = "nav a"
  let bad = "nav >"
  Task.succeed ({ same: page.doc == Test.doc (view page.model { user: me, visits: 0 }), links: Test.texts sel page.doc, bad: Test.count bad page.doc, href: Test.attr "href" "nav a" page.doc, none: Test.text "#nothing" page.doc } == { same: True, links: ["All", "Open", "Done"], bad: 0, href: Just "/", none: Nothing })
}

test "a stranger's note is missing" = {
  let me <- Db.insert User { email: Text.Email "me@example.com", name: "Me" }
  let id <- Db.insert Note { title: Text.NonEmpty "Milk", owner: me }
  let _ <- Test.login { user: Just (User.UserId "stranger") }
  let r <- Test.open (Notes.Show { id: id })
  Task.succeed (r.answer == Missing)
}

-- The model Test.get gives is the one the page rendered: `load` ran once (its clock read is in
-- the trace once), so the rendered time is the model's.
test "the model is the one the page rendered" = {
  let me <- Db.insert User { email: Text.Email "me@example.com", name: "Me" }
  let _ <- Test.login { user: Just me }
  let page <- Test.get (Notes.Index {})
  let trace <- Test.trace
  Task.succeed ({ shown: Test.text "#now" page.doc, same: page.doc == Test.doc (view page.model { user: me, visits: 0 }), trace: trace } == { shown: Just (Time.format "15:04:05" page.model.now), same: True, trace: ["Db.insert User", "Test.login", "Test.get Notes.Index", "Db.all Note", "Time.now"] })
}

-- A form each row renders: the message with its parameters names the row's.
test "renaming one row's note" = {
  let me <- Db.insert User { email: Text.Email "me@example.com", name: "Me" }
  let a <- Db.insert Note { title: Text.NonEmpty "A", owner: me }
  let b <- Db.insert Note { title: Text.NonEmpty "B", owner: me }
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Notes.Index {})
  let r <- Test.submit (Rename { id: b }) { title: Text.NonEmpty "B2" }
  let na <- Db.get Note a
  let nb <- Db.get Note b
  Task.succeed ({ answer: r.answer, a: Maybe.map (\n -> n.title) na, b: Maybe.map (\n -> n.title) nb } == { answer: Rerendered, a: Just (Text.NonEmpty "A"), b: Just (Text.NonEmpty "B2") })
}

-- An App message's form, posted from the page: App's Rerender goes back to the page.
test "an App form" = {
  let me <- Db.insert User { email: Text.Email "me@example.com", name: "Me" }
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Notes.Index {})
  let r <- Test.submit App.Feedback { text: "nice" }
  Task.succeed (r.answer == Redirected (Notes.Index {}))
}

-- A Rerender after Session.put: the cookie the answer sets is the step's session, and the page
-- re-rendered with it shows it. Test.login left `visits` out: the session's default applies.
test "a Rerender after Session.put updates the session" = {
  let me <- Db.insert User { email: Text.Email "me@example.com", name: "Me" }
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Notes.Index {})
  let once <- Test.click Visit
  let twice <- Test.click Visit
  Task.succeed ({ answer: twice.answer, first: once.session.visits, visits: twice.session.visits, shown: Test.text "#visits" twice.doc } == { answer: Rerendered, first: 1, visits: 2, shown: Just "2" })
}

-- A failing Test.run undoes the writes its browser steps made; the browser itself is not rolled
-- back: it still holds the page the step left it on.
test "a browser write inside a failing Test.run is undone" = {
  let me <- Db.insert User { email: Text.Email "me@example.com", name: "Me" }
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Notes.Index {})
  let r <- Test.run {
    let added <- Test.submit NewNote { title: Text.NonEmpty "Milk", due: Nothing, urgent: False, contact: Nothing }
    let _ <- Task.fail "stop"
    Task.succeed (Test.text "#summary" added.doc)
  }
  let rows <- Db.from Note |> Db.count
  let page <- Test.get (Notes.Index {})
  Task.succeed ({ value: r.value, rows: rows, shown: Test.text "#summary" page.doc } == { value: Err "stop", rows: 0, shown: Just "0 shown" })
}
