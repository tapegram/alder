module App

import Table.User

-- GET routes (#160 PR 3): the app of the route handlers' golden. Its write routes are generated
-- by Task 3.3.
session { user: Maybe User.UserId, theme: Text = "light", role: User.Role = Reader }

login = Auth.Login

error : Error -> Html Never
error err = <html><body><h1>Something went wrong</h1></body></html>

notFound : Html Never
notFound = <html><body><h1>Not found</h1></body></html>
