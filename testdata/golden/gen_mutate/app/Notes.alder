module Notes

import Note
import User

page "/notes" { } requires user

type Model = { notes: List Note }

load : Params -> Session -> Query Model
load params session = {
  let notes <- Db.from Note |> Db.where (Note.owner.eq session.user) |> Db.all
  Query.succeed { notes: notes }
}

form NewNote = {
  title: Text,
}

msg Add form NewNote

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  Add p -> {
    let _ <- Db.insert Note { title: p.form.title, owner: session.user }
    Task.succeed (Redirect (Notes {}))
  },
}

view : Model -> Session -> Html Msg
view model session =
  <html><body>
    <h1>Notes</h1>
    <form submit={Add}>
      <Input field="title" label="Title" />
      <Errors form />
      <button>Add</button>
    </form>
    <ul>{for n in model.notes -> <li>{n.title}</li>}</ul>
  </body></html>

test "a visitor is sent to log in" = {
  let r <- Test.open (Notes {})
  Task.succeed (r.answer == Redirected (Login {}))
}

test "I see only my notes" = {
  let me <- Db.insert User { name: "Me" }
  let other <- Db.insert User { name: "Other" }
  let _ <- Db.insert Note { title: "mine", owner: me }
  let _ <- Db.insert Note { title: "theirs", owner: other }
  let _ <- Test.login { user: Just me }
  let page <- Test.get (Notes {})
  Task.succeed (List.map (\n -> n.title) page.model.notes == ["mine"])
}

test "adding a note stores it" = {
  let me <- Db.insert User { name: "Me" }
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Notes {})
  let _ <- Test.submit NewNote { title: "Milk" }
  let page <- Test.get (Notes {})
  Task.succeed (List.map (\n -> n.title) page.model.notes == ["Milk"])
}

test "adding a note goes back to the list" = {
  let me <- Db.insert User { name: "Me" }
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Notes {})
  let added <- Test.submit NewNote { title: "Milk" }
  Task.succeed (added.answer == Redirected (Notes {}))
}

test "a new note is not pinned" = {
  let me <- Db.insert User { name: "Me" }
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Notes {})
  let _ <- Test.submit NewNote { title: "Milk" }
  let page <- Test.get (Notes {})
  Task.succeed (List.map (\n -> n.pinned) page.model.notes == [False])
}
