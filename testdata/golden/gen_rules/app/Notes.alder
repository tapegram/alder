module Notes

import Note

route Notes  = GET  "/notes"          { }                 requires user
route Add    = POST "/notes/_/Add"    { } form NewNote    requires user
route Pin    = POST "/notes/_/Pin"    { id: Note.NoteId } requires user
route Remove = POST "/notes/_/Remove" { id: Note.NoteId } requires user

type Model = { notes: List Note, pinned: Int }

mine : Select Note
mine = Db.mine Note |> Db.limit 5

Notes.load : Notes.Params -> Session -> Query Model
Notes.load params session = {
  let notes <- mine |> Db.all
  let pinned <-
    Db.mine Note
      |> Db.where (Note.pinned.eq True)
      |> Db.count
  Query.succeed { notes: notes, pinned: pinned }
}

form NewNote = { title: Text }

Add.update : Add.Params -> Session -> Task Response
Add.update p session = {
  let _ <- Db.insertMine Note { title: p.form.title }
  Task.succeed Response.refresh
}

Pin.update : Pin.Params -> Session -> Task Response
Pin.update p session = {
  let n <- Db.getMine Note p.id
  let _ <- Db.updateMine Note n.id (\x -> { x | pinned: True })
  Task.succeed Response.refresh
}

Remove.update : Remove.Params -> Session -> Task Response
Remove.update p session = {
  let _ <- wipe p.id
  Task.succeed Response.refresh
}

-- a scoped operation as a function value
wipe : Note.NoteId -> Task Unit
wipe = Db.deleteMine Note

Notes.view : Model -> Session -> Html
Notes.view model session =
  <html>
    <body>
      <form submit={Add}>
        <Input field="title" label="Title" />
        <Errors form />
        <button>Add</button>
      </form>
      <ul>
        {for n in model.notes ->
          <li>
            <button click={Pin { id: n.id }}>{n.title}</button>
            <button click={Remove { id: n.id }}>x</button>
          </li>}
      </ul>
    </body>
  </html>
