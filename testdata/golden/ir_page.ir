(module App)
(record App.Session (user Maybe Text) (visits Int = 0))
(union App.Msg)
(value App.error : Error -> Html Never (err) (elem p (htext "error")))
(value App.notFound : Html Never () (elem p (htext "not found")))
(module Edit)
(union Edit.Color (Red) (Green))
(record Edit.Model (n Int) (busy Bool))
(record Edit.Note (body Text) (color Color))
(record Edit.Params (n Int))
(record Edit.SaveParams (n Int) (form Note))
(union Edit.Msg (Save SaveParams) (Ping))
(value Edit.load : Params -> App.Session -> Query Model (params session)
  (pure query (record Model (n (field n (var params))) (busy False))))
(value Edit.update : Msg -> Model -> App.Session -> Task Nav (msg model session)
  (pure task (ctor Prelude.Nav.Rerender)))
(value Edit.view : Model -> App.Session -> Html Msg (model session)
  (elem div
    (elem a (attr href href (page-ref Other)) (htext "other"))
    (elem button
      (attr click click (ctor Edit.Msg.Ping))
      (attr disabled bool (field busy (var model)))
      (htext "ping"))
    (form-el Edit.Save
      (attr submit submit
        (ctor Edit.Msg.Save (record SaveParams (n (field n (var model))))))
      (input Textarea Note field=body
        (label
          (++ : Text "Body of " (call (std Text.fromInt) (field n (var model))))))
      (input Select Note field=color label="Color"
        (value (ctor Edit.Color.Red))))
    (elem details (attr open bool True) (elem summary (htext "more")))))
(module Other)
(record Other.Model)
(record Other.Params)
(union Other.Msg)
(value Other.load : Params -> App.Session -> Query Model (params session)
  (pure query (record Model)))
(value Other.view : Model -> App.Session -> Html Msg (model session)
  (elem a (attr href href (page-ref Edit (record Edit.Params (n 1))))
    (htext "edit")))
(module Secret)
(record Secret.Model)
(record Secret.Params)
(union Secret.Msg)
(record Secret.Session (user Text) (visits Int))
(value Secret.load : Params -> Session -> Query Model (params session)
  (pure query (record Model)))
(value Secret.greeting : Session -> Text (session)
  (++ : Text "hello " (field user (var session))))
(value Secret.view : Model -> Session -> Html Msg (model session)
  (elem p
    (hexpr text (call (global Secret.greeting) (var session)))
    (htext " (")
    (hexpr text (call (std Text.fromInt) (field visits (var session))))
    (htext ")")))
(form Edit.Note)
(page Edit "/edit/{n}"
  (params Params)
  (model Model)
  (msg Save (params SaveParams) (form Note))
  (msg Ping)
  (view Edit.view)
  (load Edit.load)
  (update Edit.update))
(page Other "/other"
  (params Params)
  (model Model)
  (view Other.view)
  (load Other.load))
(page Secret "/secret"
  (params Params)
  (requires user)
  (session Session)
  (model Model)
  (view Secret.view)
  (load Secret.load))
(session App.Session)
