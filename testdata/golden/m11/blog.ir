(module Write.Edit)
(record Write.Edit.Model (post Table.Post.Post))
(record Write.Edit.EditPost (title Text) (body Text))
(record Write.Edit.Params (id Text))
(record Write.Edit.SaveParams (form EditPost))
(union Write.Edit.Msg (Save SaveParams) (Publish) (Unpublish) (Delete))
(record Write.Edit.Session (user Text) (role Table.User.Role))
(value Write.Edit.load : Params -> Session -> Query Model (params session)
  (bind query author : Bool
    (call (global Table.User.isAuthor) (field user (var session)))
    (if (var author)
      (bind query post : Table.Post.Post
        (db-get-mine Table.Post.Post (field id (var params)))
        (pure query (record Model (post (var post)))))
      (not-found))))
(value Write.Edit.update : Msg -> Model -> Session -> Task Nav (msg model session)
  (match union (var msg)
    (case Save (bind _m1 : SaveParams)
      (let p : SaveParams
        (var _m1)
        (bind task _
          (db-update-mine Table.Post.Post
            (field id (field post (var model)))
            (lambda (post : Table.Post.Post)
              (update (var post)
                (title (field title (field form (var p))))
                (body (field body (field form (var p)))))))
          (pure task
            (call (std Notice.with) "Saved" (ctor Prelude.Nav.Rerender))))))
    (case Publish
      (bind task _
        (db-update-mine Table.Post.Post
          (field id (field post (var model)))
          (lambda (post : Table.Post.Post) (update (var post) (published True))))
        (pure task (ctor Prelude.Nav.Rerender))))
    (case Unpublish
      (bind task _
        (db-update-mine Table.Post.Post
          (field id (field post (var model)))
          (lambda (post : Table.Post.Post)
            (update (var post) (published False))))
        (pure task (ctor Prelude.Nav.Rerender))))
    (case Delete
      (bind task _
        (db-delete-mine Table.Post.Post
          (field id (field post (var model))))
        (pure task
          (ctor Prelude.Nav.Redirect
            (record (value (page-ref Write (record Write.Params))))))))))
(value Write.Edit.view : Model -> Session -> Html Msg (model session)
  (comp Layout.Page
    (record (title (++ : Text "Edit: " (field title (field post (var model))))))
    (elem h1 (hexpr text (field title (field post (var model)))))
    (elem p
      (hif (field published (field post (var model)))
        (elem al-badge (htext "Published"))
        (elem al-badge (attr variant text "secondary") (htext "Draft")))
      (htext " · ")
      (elem a
        (attr href href
          (page-ref Posts.Show
            (record Posts.Show.Params
              (slug (field slug (field post (var model)))))))
        (htext "View")))
    (elem al-card
      (form-el Write.Edit.Save
        (attr submit submit (ctor Write.Edit.Msg.Save (record SaveParams)))
        (elem al-alert
          (attr variant text "destructive")
          (attr role text "alert")
          (input Errors EditPost form))
        (input Input EditPost field=title label="Title"
          (value (field title (field post (var model))))
          (wrap al-input))
        (input Textarea EditPost field=body label="Body (Markdown)"
          (value (field body (field post (var model))))
          (wrap al-textarea))
        (elem al-button (attr type text "submit")
          (elem button (attr type text "submit") (htext "Save"))))
      (elem div (attr slot text "actions")
        (hif (field published (field post (var model)))
          (elem al-button (attr variant text "secondary")
            (elem button
              (attr type text "button")
              (attr click click (ctor Write.Edit.Msg.Unpublish))
              (htext "Unpublish")))
          (elem al-button (attr variant text "secondary")
            (elem button
              (attr type text "button")
              (attr click click (ctor Write.Edit.Msg.Publish))
              (htext "Publish"))))
        (elem al-button (attr variant text "destructive")
          (elem button
            (attr type text "button")
            (attr click click (ctor Write.Edit.Msg.Delete))
            (htext "Delete")))))
    (elem a (attr href href (page-ref Write (record Write.Params)))
      (htext "All your posts"))))
(test "deleting a post deletes its comments" task
  (bind task author : Text
    (db-insert Table.User.User
      (record
        (email "author@example.com")
        (name "Author")
        (passwordHash "")
        (role (ctor Table.User.Role.Author))))
    (bind task id : Text
      (db-insert Table.Post.Post
        (record
          (slug "hello")
          (title "Hello")
          (body "")
          (published True)
          (author (var author))))
      (bind task _
        (db-insert Table.Comment.Comment
          (record (post (var id)) (author "Ann") (body "First!")))
        (bind task _
          (db-insert Table.Comment.Comment
            (record (post (var id)) (author "Bob") (body "Second.")))
          (bind task _
            (test-login
              (record App.Session
                (user (ctor Prelude.Maybe.Just (record (value (var author)))))
                (role (ctor Table.User.Role.Author))))
            (bind task model : Model
              (call (global Write.Edit.load)
                (record Params (id (var id)))
                (record Session
                  (user (var author))
                  (role (ctor Table.User.Role.Author))))
              (bind task r : { value: Result Text Nav, trace: List Text }
                (test-run
                  (call (global Write.Edit.update)
                    (ctor Write.Edit.Msg.Delete)
                    (var model)
                    (record Session
                      (user (var author))
                      (role (ctor Table.User.Role.Author)))))
                (bind task posts : Int
                  (db-select Table.Post.Post count)
                  (bind task comments : Int
                    (db-select Table.Comment.Comment count)
                    (pure task
                      (test-eq
                        (record
                          (value (field value (var r)))
                          (trace (field trace (var r)))
                          (posts (var posts))
                          (comments (var comments)))
                        (record
                          (value
                            (ctor Prelude.Result.Ok
                              (record
                                (value
                                  (ctor Prelude.Nav.Redirect
                                    (record
                                      (value
                                        (page-ref Write (record Write.Params)))))))))
                          (trace (list "Db.deleteMine Post"))
                          (posts 0)
                          (comments 0))))))))))))))
