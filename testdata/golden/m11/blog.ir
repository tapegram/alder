(module Admin.Users.New)
(record Admin.Users.New.Model)
(record Admin.Users.New.UserForm
  (email Text)
  (name Text)
  (role Table.User.Role))
(record Admin.Users.New.Params)
(record Admin.Users.New.CreateParams (form UserForm))
(union Admin.Users.New.Msg (Create CreateParams))
(record Admin.Users.New.Session (user Text) (role Table.User.Role))
(value Admin.Users.New.load : Params -> Session -> Query Model (params session)
  (bind query admin : Bool
    (call (global Admin.Layout.isAdmin) (field user (var session)))
    (if (var admin) (pure query (record Model)) (not-found))))
(value Admin.Users.New.update : Msg -> Model -> Session -> Task Nav (msg model session)
  (match union (var msg)
    (case Create (bind _m1 : CreateParams)
      (let p : CreateParams
        (var _m1)
        (bind task emailTaken : Int
          (db-select Table.User.User
            (where
              (cond eq
                (col Table.User.User email)
                (field email (field form (var p)))))
            count)
          (if (> : Int (var emailTaken) 0)
            (pure task
              (ctor Prelude.Nav.Reject
                (record (value "A user with this email exists."))))
            (bind task id : Text
              (db-insert Table.User.User
                (record
                  (email (field email (field form (var p))))
                  (name (field name (field form (var p))))
                  (passwordHash "")
                  (role (field role (field form (var p))))))
              (pure task
                (ctor Prelude.Nav.Redirect
                  (record
                    (value
                      (page-ref Admin.Users.Show
                        (record Admin.Users.Show.Params (id (var id)))))))))))))))
(value Admin.Users.New.view : Model -> Session -> Html Msg (model session)
  (comp Admin.Layout.Page
    (record (title "New user"))
    (elem h1 (htext "New user"))
    (elem al-card
      (form-el Admin.Users.New.Create
        (attr submit submit
          (ctor Admin.Users.New.Msg.Create (record CreateParams)))
        (input Input UserForm field=email label="Email" (wrap al-input))
        (input Input UserForm field=name label="Name" (wrap al-input))
        (input Select UserForm field=role label="Role"
          (value (ctor Table.User.Role.Reader))
          (wrap al-select))
        (elem al-alert
          (attr variant text "destructive")
          (attr role text "alert")
          (input Errors UserForm form))
        (elem al-button (attr type text "submit")
          (elem button (attr type text "submit") (htext "Create")))))))
(test "creating a user adds it, with the values submitted" task
  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "email-1@example.com")
        (name "name-1")
        (passwordHash "passwordhash-1")
        (role (ctor Table.User.Role.Admin))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor Table.User.Role.Admin))))
      (bind task page : { model: Model, session: App.Session, doc: Doc, notices: List Text }
        (test-get Admin.Users.New (record Params))
        (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
          (test-submit Admin.Users.New.UserForm Create
            (record UserForm
              (email "email-2@example.com")
              (name "name-2")
              (role (ctor Table.User.Role.Admin))))
          (bind task rows : List Table.User.User
            (db-select Table.User.User
              (where
                (cond eq (col Table.User.User email) "email-2@example.com"))
              all)
            (pure task
              (test-eq
                (record
                  (answers
                    (call (std List.map)
                      (lambda (row : Table.User.User)
                        (ctor Prelude.Answer.Redirected
                          (record
                            (value
                              (page-ref Admin.Users.Show
                                (record Admin.Users.Show.Params
                                  (id (field id (var row)))))))))
                      (var rows)))
                  (rows
                    (call (std List.map)
                      (lambda (row : Table.User.User)
                        (record
                          (email (field email (var row)))
                          (name (field name (var row)))
                          (role (field role (var row)))
                          (passwordHash (field passwordHash (var row)))))
                      (var rows))))
                (record
                  (answers (list (field answer (var r))))
                  (rows
                    (list
                      (record
                        (email "email-2@example.com")
                        (name "name-2")
                        (role (ctor Table.User.Role.Admin))
                        (passwordHash "")))))))))))))
