(module Layout)
(component Layout.Page : { title: Text, children: List (Html a) } -> Html a (props)
  (elem html
    (elem head
      (elem meta (attr charset text "utf-8"))
      (elem script
        (hrawtext "try{document.documentElement.classList.toggle(\"dark\",localStorage.theme===\"dark\"||(!(\"theme\" in localStorage)&&matchMedia(\"(prefers-color-scheme: dark)\").matches))}catch(e){}"))
      (elem title (hexpr text (field title (var props))))
      (elem link
        (attr rel text "stylesheet")
        (attr href href (call (std Url.external) "/static/al/al.css")))
      (elem script (attr type text "module") (attr src text "/static/al/al.js"))
      (elem link
        (attr rel text "stylesheet")
        (attr href href (call (std Url.external) "/static/app.css"))))
    (elem body
      (elem al-page
        (elem header
          (elem a
            (attr href href
              (page-ref Posts.Index (record Posts.Index.Params (page 1) (q ""))))
            (htext "Blog")))
        (elem main (hexpr list (field children (var props))))))))
(module Table.User)
(union Table.User.Role (Reader) (Author) (Admin))
(record Table.User.User
  (id Text)
  (email Text)
  (name Text)
  (passwordHash Text)
  (role Role = (ctor Table.User.Role.Reader))
  (created Time))
(value Table.User.isAuthor : Text -> Query Bool (id)
  (bind query me : Maybe User
    (db-get Table.User.User (var id))
    (pure query
      (== : Maybe Role (call (std Maybe.map) (lambda (u : User) (field role (var u))) (var me))
        (ctor Prelude.Maybe.Just (record (value (ctor Table.User.Role.Author))))))))
(module Admin.Layout)
(value Admin.Layout.isAdmin : Text -> Query Bool (id)
  (bind query me : Maybe Table.User.User
    (db-get Table.User.User (var id))
    (pure query
      (== : Maybe Table.User.Role (call (std Maybe.map) (lambda (u : Table.User.User) (field role (var u))) (var me))
        (ctor Prelude.Maybe.Just (record (value (ctor Table.User.Role.Admin))))))))
(component Admin.Layout.Page : { title: Text, children: List (Html a) } -> Html a (props)
  (comp Layout.Page
    (record (title (++ : Text (field title (var props)) " · Admin")))
    (elem nav (attr aria-label text "Admin")
      (elem al-stack (attr direction text "row") (attr gap text "sm")
        (elem a
          (attr href href (page-ref Admin.Index (record Admin.Index.Params)))
          (htext "Dashboard"))
        (elem a
          (attr href href
            (page-ref Admin.Comments.Index
              (record Admin.Comments.Index.Params
                (q "")
                (sort "created")
                (dir "desc")
                (page 1))))
          (htext "Comments"))
        (elem a
          (attr href href
            (page-ref Admin.Posts.Index
              (record Admin.Posts.Index.Params
                (q "")
                (published "")
                (sort "created")
                (dir "desc")
                (page 1))))
          (htext "Posts"))
        (elem a
          (attr href href
            (page-ref Admin.Users.Index
              (record Admin.Users.Index.Params
                (q "")
                (role "")
                (sort "created")
                (dir "desc")
                (page 1))))
          (htext "Users"))))
    (hexpr list (field children (var props)))))
(module Table.Post)
(record Table.Post.Post
  (id Text)
  (slug Text)
  (title Text)
  (body Text)
  (published Bool = False)
  (author Text)
  (created Time))
(value Table.Post.bySlug : Text -> Query (Maybe Post) (slug)
  (db-select Table.Post.Post
    (where (cond eq (col Table.Post.Post slug) (var slug)))
    first))
(value Table.Post.isSlug : Text -> Bool (s)
  (call (std Text.matches) "^[a-z0-9-]+$" (var s)))
(value Table.Post.visible : Maybe Text -> Post -> Bool (viewer post)
  (||
    (field published (var post))
    (== : Maybe Text (var viewer)
      (ctor Prelude.Maybe.Just (record (value (field author (var post))))))))
(test "a slug is lowercase letters, digits and hyphens" pure
  (test-eq
    (call (std List.map)
      (global Table.Post.isSlug)
      (list "hello-world" "post-2" "Hello" "a b" "" "x/y"))
    (list True True False False False False)))
(test "a draft is not visible" task
  (let draft : Post
    (record Post
      (id "p")
      (slug "draft")
      (title "Draft")
      (body "")
      (published False)
      (author "author")
      (created (std Time.epoch)))
    (let seen : List Bool
      (list
        (call (global Table.Post.visible)
          (ctor Prelude.Maybe.Nothing)
          (var draft))
        (call (global Table.Post.visible)
          (ctor Prelude.Maybe.Just (record (value "reader")))
          (var draft))
        (call (global Table.Post.visible)
          (ctor Prelude.Maybe.Just (record (value "author")))
          (var draft))
        (call (global Table.Post.visible)
          (ctor Prelude.Maybe.Nothing)
          (update (var draft) (published True))))
      (pure task (test-eq (var seen) (list False False True True))))))
(test "bySlug finds the post with that slug" task
  (bind task author : Text
    (db-insert Table.User.User
      (record
        (email "author@example.com")
        (name "Author")
        (passwordHash "")
        (role (ctor Table.User.Role.Author))))
    (bind task _
      (db-insert Table.Post.Post
        (record
          (slug "first")
          (title "First")
          (body "")
          (published False)
          (author (var author))))
      (bind task _
        (db-insert Table.Post.Post
          (record
            (slug "second")
            (title "Second")
            (body "")
            (published False)
            (author (var author))))
        (bind task found : Maybe Post
          (call (global Table.Post.bySlug) "second")
          (pure task
            (test-eq
              (call (std Maybe.map)
                (lambda (p : Post) (field title (var p)))
                (var found))
              (ctor Prelude.Maybe.Just (record (value "Second"))))))))))
(test "an author with posts cannot be deleted" task
  (bind task author : Text
    (db-insert Table.User.User
      (record
        (email "author@example.com")
        (name "Author")
        (passwordHash "")
        (role (ctor Table.User.Role.Author))))
    (bind task _
      (db-insert Table.Post.Post
        (record
          (slug "hello")
          (title "Hello")
          (body "")
          (published False)
          (author (var author))))
      (bind task r : { value: Result Text Unit, trace: List Text }
        (test-run (db-delete Table.User.User (var author)))
        (bind task posts : Int
          (db-select Table.Post.Post count)
          (pure task
            (test-eq
              (record
                (deleted (call (std Result.toMaybe) (field value (var r))))
                (posts (var posts)))
              (record (deleted (ctor Prelude.Maybe.Nothing)) (posts 1)))))))))
(module Table.Comment)
(record Table.Comment.Comment
  (id Text)
  (post Text)
  (author Text)
  (body Text)
  (created Time))
(value Table.Comment.fits : Int -> Text -> Bool (n s)
  (&&
    (call (std Prelude.not)
      (call (std Text.isEmpty) (call (std Text.trim) (var s))))
    (<= : Int (call (std Text.length) (var s)) (var n))))
(test "a name or comment has text and a bound" task
  (let long : Text
    (call (std Text.join)
      ""
      (call (std List.map) (lambda (n : Int) "a") (call (std List.range) 1 81)))
    (pure task
      (test-eq
        (call (std List.map)
          (partial (global Table.Comment.fits) 80 (missing 1))
          (list
            "Ann"
            ""
            "   "
            (call (std Text.slice) 0 80 (var long))
            (var long)))
        (list True False False True False)))))
(module Admin.Comments.Bulk)
(record Admin.Comments.Bulk.Model
  (rows List Table.Comment.Comment)
  (held List Text)
  (chosen Int))
(record Admin.Comments.Bulk.Confirm)
(record Admin.Comments.Bulk.Params (ids List Text))
(record Admin.Comments.Bulk.BulkDeleteParams (form Confirm))
(union Admin.Comments.Bulk.Msg (BulkDelete BulkDeleteParams))
(record Admin.Comments.Bulk.Session (user Text) (role Table.User.Role))
(value Admin.Comments.Bulk.maxRows : Int () 25)
(value Admin.Comments.Bulk.load : Params -> Session -> Query Model (params session)
  (bind query admin : Bool
    (call (global Admin.Layout.isAdmin) (field user (var session)))
    (if (var admin)
      (let ids : List Text
        (call (std List.take)
          (global Admin.Comments.Bulk.maxRows)
          (field ids (var params)))
        (bind query rows : List Table.Comment.Comment
          (db-select Table.Comment.Comment
            (where (cond in (col Table.Comment.Comment id) (var ids)))
            all)
          (pure query
            (record Model
              (rows (var rows))
              (held (list))
              (chosen (call (std List.length) (field ids (var params))))))))
      (not-found))))
(value Admin.Comments.Bulk.refused : Model -> Session -> Table.Comment.Comment -> Bool (model session row)
  (call (std List.member) (field id (var row)) (field held (var model))))
(value Admin.Comments.Bulk.update : Msg -> Model -> Session -> Task Nav (msg model session)
  (if (> : Int (field chosen (var model)) (global Admin.Comments.Bulk.maxRows))
    (pure task
      (ctor Prelude.Nav.Reject
        (record
          (value
            (++ : Text (++ : Text "Choose at most " (call (std Text.fromInt) (global Admin.Comments.Bulk.maxRows)))
              " rows at a time.")))))
    (match union (var msg)
      (case BulkDelete (bind _m1 : BulkDeleteParams)
        (let p : BulkDeleteParams
          (var _m1)
          (let allowed : List Table.Comment.Comment
            (call (std List.filter)
              (lambda (row : Table.Comment.Comment)
                (== : Bool (call (global Admin.Comments.Bulk.refused) (var model) (var session) (var row))
                  False))
              (field rows (var model)))
            (bind task _
              (all task
                (call (std List.map)
                  (lambda (row : Table.Comment.Comment)
                    (db-delete Table.Comment.Comment (field id (var row))))
                  (var allowed)))
              (pure task
                (call (std Notice.with)
                  (++ : Text (++ : Text (++ : Text "Deleted " (call (std Text.fromInt) (call (std List.length) (var allowed)))) " of ")
                    (call (std Text.fromInt)
                      (call (std List.length) (field rows (var model)))))
                  (ctor Prelude.Nav.Redirect
                    (record
                      (value
                        (page-ref Admin.Comments.Index
                          (record Admin.Comments.Index.Params
                            (q "")
                            (sort "created")
                            (dir "desc")
                            (page 1)))))))))))))))
(value Admin.Comments.Bulk.view : Model -> Session -> Html Msg (model session)
  (comp Admin.Layout.Page
    (record (title "Selected comments"))
    (elem h1
      (hexpr text
        (call (std Text.fromInt)
          (call (std List.length) (field rows (var model)))))
      (htext " selected"))
    (elem al-card
      (hif (> : Int (field chosen (var model)) (global Admin.Comments.Bulk.maxRows))
        (elem al-alert
          (attr id text "too-many")
          (attr variant text "warning")
          (attr role text "alert")
          (hexpr text
            (++ : Text (++ : Text "Choose at most " (call (std Text.fromInt) (global Admin.Comments.Bulk.maxRows)))
              " rows at a time.")))
        (elem span))
      (elem ul (attr id text "selected")
        (hfor row : Table.Comment.Comment
          (field rows (var model))
          (elem li
            (hexpr text (field author (var row)))
            (hif (call (global Admin.Comments.Bulk.refused) (var model) (var session) (var row))
              (elem small (htext " (kept: other rows refer to it)"))
              (elem span)))))
      (form-el Admin.Comments.Bulk.BulkDelete
        (attr id text "bulk-delete")
        (attr submit submit
          (ctor Admin.Comments.Bulk.Msg.BulkDelete (record BulkDeleteParams)))
        (elem al-alert
          (attr variant text "destructive")
          (attr role text "alert")
          (input Errors Confirm form))
        (elem al-button
          (attr variant text "destructive")
          (attr type text "submit")
          (elem button (attr type text "submit")
            (htext "Delete the rows that can be deleted")))))
    (elem a
      (attr href href
        (page-ref Admin.Comments.Index
          (record Admin.Comments.Index.Params
            (q "")
            (sort "created")
            (dir "desc")
            (page 1))))
      (htext "Back to the list"))))
(test "deleting the chosen rows" task
  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "email-1@example.com")
        (name "name-1")
        (passwordHash "passwordhash-1")
        (role (ctor Table.User.Role.Admin))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor Table.User.Role.Admin))))
      (bind task post1 : Text
        (db-insert Table.Post.Post
          (record
            (slug "slug-1")
            (title "title-1")
            (body "body-1")
            (published False)
            (author (var me))))
        (bind task comment1 : Text
          (db-insert Table.Comment.Comment
            (record (post (var post1)) (author "author-1") (body "body-1")))
          (bind task comment2 : Text
            (db-insert Table.Comment.Comment
              (record (post (var post1)) (author "author-2") (body "body-2")))
            (bind task _
              (test-get Admin.Comments.Bulk
                (record Params (ids (list (var comment1)))))
              (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
                (test-submit Admin.Comments.Bulk.Confirm BulkDelete
                  (record Confirm))
                (bind task gone : Maybe Table.Comment.Comment
                  (db-get Table.Comment.Comment (var comment1))
                  (bind task left : Maybe Table.Comment.Comment
                    (db-get Table.Comment.Comment (var comment2))
                    (pure task
                      (test-eq
                        (record
                          (answer (field answer (var r)))
                          (gone
                            (call (std Maybe.map)
                              (lambda (row : Table.Comment.Comment)
                                (field id (var row)))
                              (var gone)))
                          (left
                            (call (std Maybe.map)
                              (lambda (row : Table.Comment.Comment)
                                (field id (var row)))
                              (var left))))
                        (record
                          (answer
                            (ctor Prelude.Answer.Redirected
                              (record
                                (value
                                  (page-ref Admin.Comments.Index
                                    (record Admin.Comments.Index.Params
                                      (q "")
                                      (sort "created")
                                      (dir "desc")
                                      (page 1)))))))
                          (gone (ctor Prelude.Maybe.Nothing))
                          (left
                            (ctor Prelude.Maybe.Just
                              (record (value (var comment2))))))))))))))))))
(test "25 chosen ids are taken" task
  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "email-1@example.com")
        (name "name-1")
        (passwordHash "passwordhash-1")
        (role (ctor Table.User.Role.Admin))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor Table.User.Role.Admin))))
      (bind task post1 : Text
        (db-insert Table.Post.Post
          (record
            (slug "slug-1")
            (title "title-1")
            (body "body-1")
            (published False)
            (author (var me))))
        (bind task comment1 : Text
          (db-insert Table.Comment.Comment
            (record (post (var post1)) (author "author-1") (body "body-1")))
          (bind task page : { model: Model, session: App.Session, doc: Doc, notices: List Text }
            (test-get Admin.Comments.Bulk
              (record Params
                (ids
                  (++ : List Text (list (var comment1))
                    (call (std List.map)
                      (lambda (n : Int)
                        (++ : Text "none-" (call (std Text.fromInt) (var n))))
                      (call (std List.range) 1 24))))))
            (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
              (test-submit Admin.Comments.Bulk.Confirm BulkDelete
                (record Confirm))
              (bind task after : Maybe Table.Comment.Comment
                (db-get Table.Comment.Comment (var comment1))
                (pure task
                  (test-eq
                    (record
                      (answer (field answer (var r)))
                      (kept
                        (call (std Maybe.map)
                          (lambda (row : Table.Comment.Comment)
                            (field id (var row)))
                          (var after)))
                      (warned
                        (call (std Test.count)
                          "#too-many"
                          (field doc (var page)))))
                    (record
                      (answer
                        (ctor Prelude.Answer.Redirected
                          (record
                            (value
                              (page-ref Admin.Comments.Index
                                (record Admin.Comments.Index.Params
                                  (q "")
                                  (sort "created")
                                  (dir "desc")
                                  (page 1)))))))
                      (kept (ctor Prelude.Maybe.Nothing))
                      (warned 0))))))))))))
(test "26 chosen ids are refused" task
  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "email-1@example.com")
        (name "name-1")
        (passwordHash "passwordhash-1")
        (role (ctor Table.User.Role.Admin))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor Table.User.Role.Admin))))
      (bind task post1 : Text
        (db-insert Table.Post.Post
          (record
            (slug "slug-1")
            (title "title-1")
            (body "body-1")
            (published False)
            (author (var me))))
        (bind task comment1 : Text
          (db-insert Table.Comment.Comment
            (record (post (var post1)) (author "author-1") (body "body-1")))
          (bind task page : { model: Model, session: App.Session, doc: Doc, notices: List Text }
            (test-get Admin.Comments.Bulk
              (record Params
                (ids
                  (++ : List Text (list (var comment1))
                    (call (std List.map)
                      (lambda (n : Int)
                        (++ : Text "none-" (call (std Text.fromInt) (var n))))
                      (call (std List.range) 1 25))))))
            (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
              (test-submit Admin.Comments.Bulk.Confirm BulkDelete
                (record Confirm))
              (bind task after : Maybe Table.Comment.Comment
                (db-get Table.Comment.Comment (var comment1))
                (pure task
                  (test-eq
                    (record
                      (answer (field answer (var r)))
                      (kept
                        (call (std Maybe.map)
                          (lambda (row : Table.Comment.Comment)
                            (field id (var row)))
                          (var after)))
                      (warned
                        (call (std Test.count)
                          "#too-many"
                          (field doc (var page)))))
                    (record
                      (answer
                        (ctor Prelude.Answer.FormRejected
                          (record
                            (value
                              (list
                                (record
                                  (field "")
                                  (message "Choose at most 25 rows at a time.")))))))
                      (kept
                        (ctor Prelude.Maybe.Just
                          (record (value (var comment1)))))
                      (warned 1))))))))))))
