                  (status (ctor Prelude.Maybe.Just (record (value "Draft"))))
                  (notices (list "Saved")))))))))))
(table Table.User.User
  (id id)
  (created created)
  (unique email)
  (insert email name passwordHash role))
(table Table.Post.Post
  (id id)
  (created created)
  (unique slug)
  (owner author)
  (ref author Table.User.User)
  (insert slug title body published author))
(table Table.Comment.Comment
  (id id)
  (created created)
  (ref post Table.Post.Post cascade)
  (insert post author body))
