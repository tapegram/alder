(module Admin.Posts.Show)
(record Admin.Posts.Show.Model
  (row Table.Post.Post)
  (labels Labels)
  (comments Int))
(record Admin.Posts.Show.Labels (authors List Table.User.User))
(record Admin.Posts.Show.Confirm)
(record Admin.Posts.Show.Params (id Text))
(record Admin.Posts.Show.RemoveParams (form Confirm))
(union Admin.Posts.Show.Msg (Remove RemoveParams))
(record Admin.Posts.Show.Session (user Text) (role Table.User.Role))
(value Admin.Posts.Show.load : Params -> Session -> Query Model (params session)
  (bind query admin : Bool
    (call (global Admin.Layout.isAdmin) (field user (var session)))
    (if (var admin)
      (bind query found : Maybe Table.Post.Post
        (db-get Table.Post.Post (field id (var params)))
        (bind query comments : Int
          (db-select Table.Comment.Comment
            (where
              (cond eq (col Table.Comment.Comment post) (field id (var params))))
            count)
          (match union (var found)
            (case Just (bind _m1 value : Table.Post.Post)
              (let row : Table.Post.Post
                (var _m1)
                (bind query labels : Labels
                  (call (global Admin.Posts.Show.labelsOf) (list (var row)))
                  (pure query
                    (record Model
                      (row (var row))
                      (labels (var labels))
                      (comments (var comments)))))))
            (case Nothing (not-found)))))
      (not-found))))
(value Admin.Posts.Show.labelsOf : List Table.Post.Post -> Query Labels (rows)
  (bind query authors : List Table.User.User
    (db-select Table.User.User
      (where
        (cond in
          (col Table.User.User id)
          (call (std List.map)
            (lambda (row : Table.Post.Post) (field author (var row)))
            (var rows))))
      all)
    (pure query (record Labels (authors (var authors))))))
(value Admin.Posts.Show.authorLabel : Labels -> Text -> Text (labels id)
  (match union (call (std List.find) (lambda (r : Table.User.User) (== : Text (field id (var r)) (var id))) (field authors (var labels)))
    (case Just (bind _m1 value : Table.User.User)
      (let r : Table.User.User (var _m1) (field email (var r))))
    (case Nothing (var id))))
(value Admin.Posts.Show.blockers : Model -> Int (model) 0)
(value Admin.Posts.Show.update : Msg -> Model -> Session -> Task Nav (msg model session)
  (match union (var msg)
    (case Remove (bind _m1 : RemoveParams)
      (let p : RemoveParams
        (var _m1)
        (bind task _
          (db-delete Table.Post.Post (field id (field row (var model))))
          (pure task
            (ctor Prelude.Nav.Redirect
              (record
                (value
                  (page-ref Admin.Posts.Index
                    (record Admin.Posts.Index.Params
                      (q "")
                      (published "")
                      (sort "created")
                      (dir "desc")
                      (page 1))))))))))))
(value Admin.Posts.Show.view : Model -> Session -> Html Msg (model session)
  (comp Admin.Layout.Page
    (record (title "Post"))
    (elem h1 (htext "Post"))
    (elem al-card
      (elem dl (attr id text "fields")
        (elem dt (htext "Id"))
        (elem dd (hexpr text (field id (field row (var model)))))
        (elem dt (htext "Slug"))
        (elem dd (hexpr text (field slug (field row (var model)))))
        (elem dt (htext "Title"))
        (elem dd (hexpr text (field title (field row (var model)))))
        (elem dt (htext "Body"))
        (elem dd (hexpr text (field body (field row (var model)))))
        (elem dt (htext "Published"))
        (elem dd
          (hif (field published (field row (var model)))
            (elem al-badge (htext "Yes"))
            (elem al-badge (attr variant text "secondary") (htext "No"))))
        (elem dt (htext "Author"))
        (elem dd
          (elem a
            (attr href href
              (page-ref Admin.Users.Show
                (record Admin.Users.Show.Params
                  (id (field author (field row (var model)))))))
            (hexpr text
              (call (global Admin.Posts.Show.authorLabel)
                (field labels (var model))
                (field author (field row (var model)))))))
        (elem dt (htext "Created"))
        (elem dd
          (hexpr text
            (call (std Time.format)
              "Jan 2, 2006"
              (field created (field row (var model)))))))
      (elem div (attr slot text "actions")
        (elem al-button
          (elem a
            (attr href href
              (page-ref Admin.Posts.Edit
                (record Admin.Posts.Edit.Params
                  (id (field id (field row (var model))))
                  (findAuthor ""))))
            (htext "Edit")))
        (elem al-button (attr variant text "destructive")
          (elem button
            (attr type text "button")
            (attr commandfor text "delete-dialog")
            (attr command text "show-modal")
            (htext "Delete")))))
    (elem al-dialog
      (attr heading text "Delete this post?")
      (attr dismissible bool True)
      (elem dialog
        (attr id text "delete-dialog")
        (attr aria-labelledby text "delete-dialog-heading")
        (attr data-preserve-attr text "open")
        (attr closedby text "any")
        (elem form (attr method text "dialog")
          (elem button
            (attr type text "submit")
            (attr aria-label text "Close Delete this post?")
            (htext "×")))
        (elem h2
          (attr slot text "header")
          (attr id text "delete-dialog-heading")
          (hexpr text "Delete this post?"))
        (elem dl
          (elem dt (htext "Comments deleted with it"))
          (elem dd (attr id text "comments")
            (hexpr text (call (std Text.fromInt) (field comments (var model))))))
        (form-el Admin.Posts.Show.Remove
          (attr id text "delete")
          (attr submit submit
            (ctor Admin.Posts.Show.Msg.Remove (record RemoveParams)))
          (elem al-alert
            (attr variant text "destructive")
            (attr role text "alert")
            (input Errors Confirm form))
          (hif (> : Int (call (global Admin.Posts.Show.blockers) (var model)) 0)
            (elem p
              (htext "It cannot be deleted while other rows refer to it."))
            (elem al-button
              (attr variant text "destructive")
              (attr type text "submit")
              (elem button (attr type text "submit") (htext "Delete")))))
        (elem div (attr slot text "actions")
          (elem a
            (attr href href
              (page-ref Admin.Posts.Delete
                (record Admin.Posts.Delete.Params
                  (id (field id (field row (var model)))))))
            (htext "See the details")))))
    (elem a
      (attr href href
        (page-ref Admin.Posts.Index
          (record Admin.Posts.Index.Params
            (q "")
            (published "")
            (sort "created")
            (dir "desc")
            (page 1))))
      (htext "All posts"))))
(test "the page shows the row" task
  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "email-1@example.com")
        (name "name-1")
        (passwordHash "passwordhash-1")
        (role (ctor Table.User.Role.Admin))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor Table.User.Role.Admin))))
      (bind task post1 : Text
        (db-insert Table.Post.Post
          (record
            (slug "slug-1")
            (title "title-1")
            (body "body-1")
            (published False)
            (author (var me))))
        (bind task user2 : Text
          (db-insert Table.User.User
            (record
              (email "email-2@example.com")
              (name "name-2")
              (passwordHash "passwordhash-2")
              (role (ctor Table.User.Role.Reader))))
          (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
            (test-open Admin.Posts.Show (record Params (id (var post1))))
            (bind task page : { model: Model, session: App.Session, doc: Doc, notices: List Text }
              (test-get Admin.Posts.Show (record Params (id (var post1))))
              (pure task
                (test-eq
                  (record
                    (answer (field answer (var r)))
                    (slug
                      (call (std List.member)
                        "slug-1"
                        (call (std Test.texts) "#fields dd" (field doc (var r)))))
                    (authors
                      (call (std List.length)
                        (field authors (field labels (field model (var page))))))
                    (authorLabel
                      (call (global Admin.Posts.Show.authorLabel)
                        (field labels (field model (var page)))
                        (var me))))
                  (record
                    (answer (ctor Prelude.Answer.Shown))
                    (slug True)
                    (authors 1)
                    (authorLabel "email-1@example.com")))))))))))
(test "deleting a post nothing refers to" task
  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "email-1@example.com")
        (name "name-1")
        (passwordHash "passwordhash-1")
        (role (ctor Table.User.Role.Admin))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor Table.User.Role.Admin))))
      (bind task post1 : Text
        (db-insert Table.Post.Post
          (record
            (slug "slug-1")
            (title "title-1")
            (body "body-1")
            (published False)
            (author (var me))))
        (bind task post2 : Text
          (db-insert Table.Post.Post
            (record
              (slug "slug-2")
              (title "title-2")
              (body "body-2")
              (published False)
              (author (var me))))
          (bind task _
            (db-insert Table.Comment.Comment
              (record (post (var post2)) (author "author-1") (body "body-1")))
            (bind task _
              (test-get Admin.Posts.Show (record Params (id (var post1))))
              (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
                (test-submit Admin.Posts.Show.Confirm Remove (record Confirm))
                (bind task gone : Maybe Table.Post.Post
                  (db-get Table.Post.Post (var post1))
                  (bind task kept : Maybe Table.Post.Post
                    (db-get Table.Post.Post (var post2))
                    (pure task
                      (test-eq
                        (record
                          (answer (field answer (var r)))
                          (gone
                            (call (std Maybe.map)
                              (lambda (row : Table.Post.Post)
                                (field id (var row)))
                              (var gone)))
                          (kept
                            (call (std Maybe.map)
                              (lambda (row : Table.Post.Post)
                                (field id (var row)))
                              (var kept))))
                        (record
                          (answer
                            (ctor Prelude.Answer.Redirected
                              (record
                                (value
                                  (page-ref Admin.Posts.Index
                                    (record Admin.Posts.Index.Params
                                      (q "")
                                      (published "")
                                      (sort "created")
                                      (dir "desc")
                                      (page 1)))))))
                          (gone (ctor Prelude.Maybe.Nothing))
                          (kept
                            (ctor Prelude.Maybe.Just
                              (record (value (var post2))))))))))))))))))
