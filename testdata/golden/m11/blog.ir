(module Write)
(record Write.Model (posts List Table.Post.Post))
(record Write.NewPost (slug Text) (title Text) (body Text))
(record Write.Params)
(record Write.CreateParams (form NewPost))
(union Write.Msg (Create CreateParams))
(record Write.Session (user Text) (role Table.User.Role))
(value Write.load : Params -> Session -> Query Model (params session)
  (bind query author : Bool
    (call (global Table.User.isAuthor) (field user (var session)))
    (if (var author)
      (bind query posts : List Table.Post.Post
        (db-select Table.Post.Post
          (base (db-mine Table.Post.Post))
          (order (ord (col Table.Post.Post created) desc))
          all)
        (pure query (record Model (posts (var posts)))))
      (not-found))))
(value Write.update : Msg -> Model -> Session -> Task Nav (msg model session)
  (match union (var msg)
    (case Create (bind _m1 : CreateParams)
      (let p : CreateParams
        (var _m1)
        (bind task taken : Maybe Table.Post.Post
          (call (global Table.Post.bySlug) (field slug (field form (var p))))
          (match union (var taken)
            (case Just
              (pure task
                (ctor Prelude.Nav.Reject
                  (record (value "Another post has that slug.")))))
            (case Nothing
              (bind task id : Text
                (db-insert-mine Table.Post.Post
                  (record
                    (slug (field slug (field form (var p))))
                    (title (field title (field form (var p))))
                    (body (field body (field form (var p))))
                    (published False)))
                (pure task
                  (ctor Prelude.Nav.Redirect
                    (record
                      (value
                        (page-ref Write.Edit
                          (record Write.Edit.Params (id (var id))))))))))))))))
(value Write.view : Model -> Session -> Html Msg (model session)
  (comp Layout.Page
    (record (title "Your posts"))
    (elem h1 (htext "Your posts"))
    (elem al-table
      (elem table
        (elem thead
          (elem tr (elem th (htext "Title")) (elem th (htext "Status"))))
        (elem tbody
          (hfor post : Table.Post.Post
            (field posts (var model))
            (elem tr
              (elem td
                (elem a
                  (attr href href
                    (page-ref Write.Edit
                      (record Write.Edit.Params (id (field id (var post))))))
                  (hexpr text (field title (var post)))))
              (elem td
                (hif (field published (var post))
                  (elem al-badge (htext "Published"))
                  (elem al-badge (attr variant text "secondary")
                    (htext "Draft")))))))))
    (elem al-card
      (elem h2 (attr slot text "header") (htext "New post"))
      (form-el Write.Create
        (attr submit submit (ctor Write.Msg.Create (record CreateParams)))
        (elem al-alert
          (attr variant text "destructive")
          (attr role text "alert")
          (input Errors NewPost form))
        (input Input NewPost field=slug label="Slug"
          (wrap al-input
            (attr help text "Lowercase letters, digits and hyphens")))
        (input Input NewPost field=title label="Title" (wrap al-input))
        (input Textarea NewPost field=body label="Body (Markdown)"
          (wrap al-textarea))
        (elem al-button (attr type text "submit")
          (elem button (attr type text "submit") (htext "Create draft")))))
    (elem al-button (attr variant text "outline")
      (elem button
        (attr type text "button")
        (attr click click (ctor App.Msg.Logout))
        (htext "Log out")))))
(test "a Reader cannot open the write page" task
  (bind task reader : Text
    (db-insert Table.User.User
      (record
        (email "reader@example.com")
        (name "Reader")
        (passwordHash "")
        (role (ctor Table.User.Role.Reader))))
    (bind task author : Text
      (db-insert Table.User.User
        (record
          (email "author@example.com")
          (name "Author")
          (passwordHash "")
          (role (ctor Table.User.Role.Author))))
      (bind task _
        (test-login
          (record App.Session
            (user (ctor Prelude.Maybe.Just (record (value (var reader)))))
            (role (ctor Table.User.Role.Reader))))
        (bind task asReader : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
          (test-open Write (record Params))
          (bind task _
            (test-login
              (record App.Session
                (user (ctor Prelude.Maybe.Just (record (value (var author)))))
                (role (ctor Table.User.Role.Author))))
            (bind task asAuthor : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
              (test-open Write (record Params))
              (pure task
                (test-eq
                  (record
                    (reader (field answer (var asReader)))
                    (author (field answer (var asAuthor))))
                  (record
                    (reader (ctor Prelude.Answer.PageMissing))
                    (author (ctor Prelude.Answer.Shown))))))))))))
(test "creating a post redirects to its edit page" task
  (bind task author : Text
    (db-insert Table.User.User
      (record
        (email "author@example.com")
        (name "Author")
        (passwordHash "")
        (role (ctor Table.User.Role.Author))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var author)))))
          (role (ctor Table.User.Role.Author))))
      (bind task model : Model
        (call (global Write.load)
          (record Params)
          (record Session
            (user (var author))
            (role (ctor Table.User.Role.Author))))
        (bind task r : { value: Result Text Nav, trace: List Text }
          (test-run
            (call (global Write.update)
              (ctor Write.Msg.Create
                (record CreateParams
                  (form
                    (record NewPost (slug "hello") (title "Hello") (body "Hi.")))))
              (var model)
              (record Session
                (user (var author))
                (role (ctor Table.User.Role.Author)))))
          (bind task created : Maybe Table.Post.Post
            (call (global Table.Post.bySlug) "hello")
            (match union (var created)
              (case Just (bind _m1 value : Table.Post.Post)
                (let post : Table.Post.Post
                  (var _m1)
                  (pure task
                    (== : { value: Result Text Nav, published: Bool } (record (value (field value (var r))) (published (field published (var post))))
                      (record
                        (value
                          (ctor Prelude.Result.Ok
                            (record
                              (value
                                (ctor Prelude.Nav.Redirect
                                  (record
                                    (value
                                      (page-ref Write.Edit
                                        (record Write.Edit.Params
                                          (id (field id (var post))))))))))))
                        (published False))))))
              (case Nothing (fail "no post has the slug hello")))))))))
