(capability Auth.Login.Password
  (verify { email: Text, password: Text } -> Task (Maybe Text)))
(capability Markdown.Markdown (render Text -> Query (Html Never)))
(fake Auth.Login.Password
  (tables)
  (entries
    (entry Auth.Login.verify : { email: Text, password: Text } -> Task (Maybe Text) (args)
      (bind task found : Maybe Table.User.User
        (db-select Table.User.User
          (where (cond eq (col Table.User.User email) (field email (var args))))
          first)
        (pure task
          (call (std Maybe.map)
            (lambda (u : Table.User.User) (field id (var u)))
            (var found)))))))
(fake Markdown.Markdown
  (tables)
  (entries
    (entry Markdown.render : Text -> Query (Html Never) (text)
      (pure query (call (std Html.text) (var text))))))
