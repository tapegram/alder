(module Admin.Posts.Bulk)
(record Admin.Posts.Bulk.Model
  (rows List Table.Post.Post)
  (held List Text)
  (chosen Int))
(record Admin.Posts.Bulk.Confirm)
(record Admin.Posts.Bulk.SetPublished (value Bool))
(record Admin.Posts.Bulk.Params (ids List Text))
(record Admin.Posts.Bulk.BulkDeleteParams (form Confirm))
(record Admin.Posts.Bulk.BulkSetPublishedParams (form SetPublished))
(union Admin.Posts.Bulk.Msg
  (BulkDelete BulkDeleteParams)
  (BulkSetPublished BulkSetPublishedParams))
(record Admin.Posts.Bulk.Session (user Text) (role Table.User.Role))
(value Admin.Posts.Bulk.maxRows : Int () 25)
(value Admin.Posts.Bulk.load : Params -> Session -> Query Model (params session)
  (bind query admin : Bool
    (call (global Admin.Layout.isAdmin) (field user (var session)))
    (if (var admin)
      (let ids : List Text
        (call (std List.take)
          (global Admin.Posts.Bulk.maxRows)
          (field ids (var params)))
        (bind query rows : List Table.Post.Post
          (db-select Table.Post.Post
            (where (cond in (col Table.Post.Post id) (var ids)))
            all)
          (pure query
            (record Model
              (rows (var rows))
              (held (list))
              (chosen (call (std List.length) (field ids (var params))))))))
      (not-found))))
(value Admin.Posts.Bulk.refused : Model -> Session -> Table.Post.Post -> Bool (model session row)
  (call (std List.member) (field id (var row)) (field held (var model))))
(value Admin.Posts.Bulk.update : Msg -> Model -> Session -> Task Nav (msg model session)
  (if (> : Int (field chosen (var model)) (global Admin.Posts.Bulk.maxRows))
    (pure task
      (ctor Prelude.Nav.Reject
        (record
          (value
            (++ : Text (++ : Text "Choose at most " (call (std Text.fromInt) (global Admin.Posts.Bulk.maxRows)))
              " rows at a time.")))))
    (match union (var msg)
      (case BulkDelete (bind _m1 : BulkDeleteParams)
        (let p : BulkDeleteParams
          (var _m1)
          (let allowed : List Table.Post.Post
            (call (std List.filter)
              (lambda (row : Table.Post.Post)
                (== : Bool (call (global Admin.Posts.Bulk.refused) (var model) (var session) (var row))
                  False))
              (field rows (var model)))
            (bind task _
              (all task
                (call (std List.map)
                  (lambda (row : Table.Post.Post)
                    (db-delete Table.Post.Post (field id (var row))))
                  (var allowed)))
              (pure task
                (call (std Notice.with)
                  (++ : Text (++ : Text (++ : Text "Deleted " (call (std Text.fromInt) (call (std List.length) (var allowed)))) " of ")
                    (call (std Text.fromInt)
                      (call (std List.length) (field rows (var model)))))
                  (ctor Prelude.Nav.Redirect
                    (record
                      (value
                        (page-ref Admin.Posts.Index
                          (record Admin.Posts.Index.Params
                            (q "")
                            (published "")
                            (sort "created")
                            (dir "desc")
                            (page 1))))))))))))
      (case BulkSetPublished (bind _m2 : BulkSetPublishedParams)
        (let p : BulkSetPublishedParams
          (var _m2)
          (bind task _
            (all task
              (call (std List.map)
                (lambda (row : Table.Post.Post)
                  (db-update Table.Post.Post
                    (field id (var row))
                    (lambda (r : Table.Post.Post)
                      (update (var r)
                        (published (field value (field form (var p))))))))
                (field rows (var model))))
            (pure task
              (call (std Notice.with)
                (++ : Text "Updated "
                  (call (std Text.fromInt)
                    (call (std List.length) (field rows (var model)))))
                (ctor Prelude.Nav.Redirect
                  (record
                    (value
                      (page-ref Admin.Posts.Index
                        (record Admin.Posts.Index.Params
                          (q "")
                          (published "")
                          (sort "created")
                          (dir "desc")
                          (page 1))))))))))))))
(value Admin.Posts.Bulk.view : Model -> Session -> Html Msg (model session)
  (comp Admin.Layout.Page
    (record (title "Selected posts"))
    (elem h1
      (hexpr text
        (call (std Text.fromInt)
          (call (std List.length) (field rows (var model)))))
      (htext " selected"))
    (elem al-card
      (hif (> : Int (field chosen (var model)) (global Admin.Posts.Bulk.maxRows))
        (elem al-alert
          (attr id text "too-many")
          (attr variant text "warning")
          (attr role text "alert")
          (hexpr text
            (++ : Text (++ : Text "Choose at most " (call (std Text.fromInt) (global Admin.Posts.Bulk.maxRows)))
              " rows at a time.")))
        (elem span))
      (elem ul (attr id text "selected")
        (hfor row : Table.Post.Post
          (field rows (var model))
          (elem li
            (hexpr text (field slug (var row)))
            (hif (call (global Admin.Posts.Bulk.refused) (var model) (var session) (var row))
              (elem small (htext " (kept: other rows refer to it)"))
              (elem span)))))
      (form-el Admin.Posts.Bulk.BulkDelete
        (attr id text "bulk-delete")
        (attr submit submit
          (ctor Admin.Posts.Bulk.Msg.BulkDelete (record BulkDeleteParams)))
        (elem al-alert
          (attr variant text "destructive")
          (attr role text "alert")
          (input Errors Confirm form))
        (elem al-button
          (attr variant text "destructive")
          (attr type text "submit")
          (elem button (attr type text "submit")
            (htext "Delete the rows that can be deleted"))))
      (form-el Admin.Posts.Bulk.BulkSetPublished
        (attr id text "set-published")
        (attr submit submit
          (ctor Admin.Posts.Bulk.Msg.BulkSetPublished
            (record BulkSetPublishedParams)))
        (elem al-alert
          (attr variant text "destructive")
          (attr role text "alert")
          (input Errors SetPublished form))
        (input Input SetPublished field=value label="Published"
          (wrap al-checkbox))
        (elem al-button (attr type text "submit")
          (elem button (attr type text "submit") (htext "Set published")))))
    (elem a
      (attr href href
        (page-ref Admin.Posts.Index
          (record Admin.Posts.Index.Params
            (q "")
            (published "")
            (sort "created")
            (dir "desc")
            (page 1))))
      (htext "Back to the list"))))
(test "deleting the chosen rows" task
  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "email-1@example.com")
        (name "name-1")
        (passwordHash "passwordhash-1")
        (role (ctor Table.User.Role.Admin))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor Table.User.Role.Admin))))
      (bind task post1 : Text
        (db-insert Table.Post.Post
          (record
            (slug "slug-1")
            (title "title-1")
            (body "body-1")
            (published False)
            (author (var me))))
        (bind task post2 : Text
          (db-insert Table.Post.Post
            (record
              (slug "slug-2")
              (title "title-2")
              (body "body-2")
              (published False)
              (author (var me))))
          (bind task _
            (test-get Admin.Posts.Bulk (record Params (ids (list (var post1)))))
            (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
              (test-submit Admin.Posts.Bulk.Confirm BulkDelete (record Confirm))
              (bind task gone : Maybe Table.Post.Post
                (db-get Table.Post.Post (var post1))
                (bind task left : Maybe Table.Post.Post
                  (db-get Table.Post.Post (var post2))
                  (pure task
                    (test-eq
                      (record
                        (answer (field answer (var r)))
                        (gone
                          (call (std Maybe.map)
                            (lambda (row : Table.Post.Post)
                              (field id (var row)))
                            (var gone)))
                        (left
                          (call (std Maybe.map)
                            (lambda (row : Table.Post.Post)
                              (field id (var row)))
                            (var left))))
                      (record
                        (answer
                          (ctor Prelude.Answer.Redirected
                            (record
                              (value
                                (page-ref Admin.Posts.Index
                                  (record Admin.Posts.Index.Params
                                    (q "")
                                    (published "")
                                    (sort "created")
                                    (dir "desc")
                                    (page 1)))))))
                        (gone (ctor Prelude.Maybe.Nothing))
                        (left
                          (ctor Prelude.Maybe.Just (record (value (var post2)))))))))))))))))
