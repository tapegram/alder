(module Admin.Posts.Edit)
(record Admin.Posts.Edit.Model
  (row Table.Post.Post)
  (authors List Table.User.User)
  (authorsTotal Int))
(record Admin.Posts.Edit.PostForm
  (slug Text)
  (title Text)
  (body Text)
  (published Bool)
  (author Text))
(record Admin.Posts.Edit.FindAuthor (q Text))
(record Admin.Posts.Edit.Params (id Text) (findAuthor Text = ""))
(record Admin.Posts.Edit.SearchAuthorParams (form FindAuthor))
(record Admin.Posts.Edit.SaveParams (form PostForm))
(union Admin.Posts.Edit.Msg (SearchAuthor SearchAuthorParams) (Save SaveParams))
(record Admin.Posts.Edit.Session (user Text) (role Table.User.Role))
(value Admin.Posts.Edit.load : Params -> Session -> Query Model (params session)
  (bind query admin : Bool
    (call (global Admin.Layout.isAdmin) (field user (var session)))
    (if (var admin)
      (bind query found : Maybe Table.Post.Post
        (db-get Table.Post.Post (field id (var params)))
        (match union (var found)
          (case Just (bind _m1 value : Table.Post.Post)
            (let row : Table.Post.Post
              (var _m1)
              (let findAuthor : Text
                (call (std Text.slice) 0 200 (field findAuthor (var params)))
                (bind query authorsTotal : Int
                  (db-select Table.User.User count)
                  (bind query authorsOwn : List Table.User.User
                    (if (> : Int (var authorsTotal) 200)
                      (db-select Table.User.User
                        (where
                          (cond eq
                            (col Table.User.User id)
                            (field author (var row))))
                        all)
                      (pure query (list)))
                    (bind query authorsFound : List Table.User.User
                      (db-select Table.User.User
                        (where
                          (if (> : Int (var authorsTotal) 200)
                            (cond and
                              (cond contains
                                (col Table.User.User email)
                                (var findAuthor))
                              (cond ne
                                (col Table.User.User id)
                                (field author (var row))))
                            (cond and)))
                        (order (ord (col Table.User.User email) asc))
                        (limit (if (> : Int (var authorsTotal) 200) 50 200))
                        all)
                      (let authors : List Table.User.User
                        (++ : List Table.User.User (var authorsOwn)
                          (var authorsFound))
                        (pure query
                          (record Model
                            (row (var row))
                            (authors (var authors))
                            (authorsTotal (var authorsTotal)))))))))))
          (case Nothing (not-found))))
      (not-found))))
(value Admin.Posts.Edit.update : Msg -> Model -> Session -> Task Nav (msg model session)
  (match union (var msg)
    (case SearchAuthor (bind _m1 : SearchAuthorParams)
      (let p : SearchAuthorParams
        (var _m1)
        (pure task
          (ctor Prelude.Nav.Redirect
            (record
              (value
                (page-ref Admin.Posts.Edit
                  (record Params
                    (id (field id (field row (var model))))
                    (findAuthor
                      (call (std Text.slice)
                        0
                        200
                        (field q (field form (var p)))))))))))))
    (case Save (bind _m2 : SaveParams)
      (let p : SaveParams
        (var _m2)
        (bind task slugTaken : Int
          (db-select Table.Post.Post
            (where
              (cond and
                (cond eq
                  (col Table.Post.Post slug)
                  (field slug (field form (var p))))
                (cond ne
                  (col Table.Post.Post id)
                  (field id (field row (var model))))))
            count)
          (if (> : Int (var slugTaken) 0)
            (pure task
              (ctor Prelude.Nav.Reject
                (record (value "A post with this slug exists."))))
            (bind task _
              (db-update Table.Post.Post
                (field id (field row (var model)))
                (lambda (row : Table.Post.Post)
                  (update (var row)
                    (slug (field slug (field form (var p))))
                    (title (field title (field form (var p))))
                    (body (field body (field form (var p))))
                    (published (field published (field form (var p))))
                    (author (field author (field form (var p)))))))
              (pure task
                (ctor Prelude.Nav.Redirect
                  (record
                    (value
                      (page-ref Admin.Posts.Show
                        (record Admin.Posts.Show.Params
                          (id (field id (field row (var model)))))))))))))))))
(value Admin.Posts.Edit.view : Model -> Session -> Html Msg (model session)
  (comp Admin.Layout.Page
    (record (title "Edit post"))
    (elem h1 (htext "Edit post"))
    (elem al-card
      (hif (> : Int (field authorsTotal (var model)) 200)
        (form-el Admin.Posts.Edit.SearchAuthor
          (attr submit submit
            (ctor Admin.Posts.Edit.Msg.SearchAuthor (record SearchAuthorParams)))
          (input Input FindAuthor field=q label="Find author" (wrap al-input))
          (elem al-button
            (attr type text "submit")
            (attr variant text "secondary")
            (elem button (attr type text "submit") (htext "Find"))))
        (elem span))
      (form-el Admin.Posts.Edit.Save
        (attr submit submit
          (ctor Admin.Posts.Edit.Msg.Save (record SaveParams)))
        (input Input PostForm field=slug label="Slug"
          (value (field slug (field row (var model))))
          (wrap al-input))
        (input Input PostForm field=title label="Title"
          (value (field title (field row (var model))))
          (wrap al-input))
        (input Textarea PostForm field=body label="Body"
          (value (field body (field row (var model))))
          (wrap al-textarea))
        (input Input PostForm field=published label="Published"
          (value (field published (field row (var model))))
          (wrap al-checkbox))
        (input Select PostForm field=author label="Author"
          (value (field author (field row (var model))))
          (options
            (call (std List.map)
              (lambda (r : Table.User.User)
                (record
                  (value (field id (var r)))
                  (label (field email (var r)))))
              (field authors (var model))))
          (wrap al-select))
        (elem al-alert
          (attr variant text "destructive")
          (attr role text "alert")
          (input Errors PostForm form))
        (elem al-button (attr type text "submit")
          (elem button (attr type text "submit") (htext "Save")))))
    (elem a
      (attr href href
        (page-ref Admin.Posts.Show
          (record Admin.Posts.Show.Params
            (id (field id (field row (var model)))))))
      (htext "Back"))))
(test "saving changes every field" task
  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "email-1@example.com")
        (name "name-1")
        (passwordHash "passwordhash-1")
        (role (ctor Table.User.Role.Admin))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor Table.User.Role.Admin))))
      (bind task post1 : Text
        (db-insert Table.Post.Post
          (record
            (slug "slug-1")
            (title "title-1")
            (body "body-1")
            (published False)
            (author (var me))))
        (bind task user2 : Text
          (db-insert Table.User.User
            (record
              (email "email-2@example.com")
              (name "name-2")
              (passwordHash "passwordhash-2")
              (role (ctor Table.User.Role.Reader))))
          (bind task page : { model: Model, session: App.Session, doc: Doc, notices: List Text }
            (test-get Admin.Posts.Edit
              (record Params (id (var post1)) (findAuthor "")))
            (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
              (test-submit Admin.Posts.Edit.PostForm Save
                (record PostForm
                  (slug "slug-2")
                  (title "title-2")
                  (body "body-2")
                  (published True)
                  (author (var user2))))
              (bind task after : Maybe Table.Post.Post
                (db-get Table.Post.Post (var post1))
                (pure task
                  (test-eq
                    (record
                      (answer (field answer (var r)))
                      (row
                        (call (std Maybe.map)
                          (lambda (row : Table.Post.Post)
                            (record
                              (slug (field slug (var row)))
                              (title (field title (var row)))
                              (body (field body (var row)))
                              (published (field published (var row)))
                              (author (field author (var row)))))
                          (var after)))
                      (authors
                        (call (std Test.texts)
                          "select[name=author] option"
                          (field doc (var page)))))
                    (record
                      (answer
                        (ctor Prelude.Answer.Redirected
                          (record
                            (value
                              (page-ref Admin.Posts.Show
                                (record Admin.Posts.Show.Params
                                  (id (var post1))))))))
                      (row
                        (ctor Prelude.Maybe.Just
                          (record
                            (value
                              (record
                                (slug "slug-2")
                                (title "title-2")
                                (body "body-2")
                                (published True)
                                (author (var user2)))))))
                      (authors
                        (list "email-1@example.com" "email-2@example.com")))))))))))))
