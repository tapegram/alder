(module Admin.Users.Delete)
(record Admin.Users.Delete.Model (row Table.User.User) (own Bool) (posts Int))
(record Admin.Users.Delete.Confirm)
(record Admin.Users.Delete.Params (id Text))
(record Admin.Users.Delete.RemoveParams (form Confirm))
(union Admin.Users.Delete.Msg (Remove RemoveParams))
(record Admin.Users.Delete.Session (user Text) (role Table.User.Role))
(value Admin.Users.Delete.load : Params -> Session -> Query Model (params session)
  (bind query admin : Bool
    (call (global Admin.Layout.isAdmin) (field user (var session)))
    (if (var admin)
      (bind query found : Maybe Table.User.User
        (db-get Table.User.User (field id (var params)))
        (bind query posts : Int
          (db-select Table.Post.Post
            (where
              (cond eq (col Table.Post.Post author) (field id (var params))))
            count)
          (match union (var found)
            (case Just (bind _m1 value : Table.User.User)
              (let row : Table.User.User
                (var _m1)
                (pure query
                  (record Model
                    (row (var row))
                    (own
                      (== : Text (field user (var session))
                        (field id (var row))))
                    (posts (var posts))))))
            (case Nothing (not-found)))))
      (not-found))))
(value Admin.Users.Delete.blockers : Model -> Int (model)
  (field posts (var model)))
(value Admin.Users.Delete.update : Msg -> Model -> Session -> Task Nav (msg model session)
  (match union (var msg)
    (case Remove (bind _m1 : RemoveParams)
      (let p : RemoveParams
        (var _m1)
        (if (field own (var model))
          (pure task
            (ctor Prelude.Nav.Reject
              (record (value "You cannot delete your own account."))))
          (if (> : Int (call (global Admin.Users.Delete.blockers) (var model)) 0)
            (pure task
              (ctor Prelude.Nav.Reject
                (record
                  (value
                    "This user cannot be deleted while other rows refer to it."))))
            (bind task _
              (db-delete Table.User.User (field id (field row (var model))))
              (pure task
                (ctor Prelude.Nav.Redirect
                  (record
                    (value
                      (page-ref Admin.Users.Index
                        (record Admin.Users.Index.Params
                          (q "")
                          (role "")
                          (sort "created")
                          (dir "desc")
                          (page 1))))))))))))))
(value Admin.Users.Delete.view : Model -> Session -> Html Msg (model session)
  (comp Admin.Layout.Page
    (record (title "Delete user"))
    (elem h1 (htext "Delete this user?"))
    (elem al-card
      (elem p (hexpr text (field email (field row (var model)))))
      (elem dl
        (elem dt (htext "Posts that keep it from being deleted"))
        (elem dd (attr id text "posts")
          (hexpr text (call (std Text.fromInt) (field posts (var model))))))
      (form-el Admin.Users.Delete.Remove
        (attr id text "delete")
        (attr submit submit
          (ctor Admin.Users.Delete.Msg.Remove (record RemoveParams)))
        (elem al-alert
          (attr variant text "destructive")
          (attr role text "alert")
          (input Errors Confirm form))
        (hif (field own (var model))
          (elem p (htext "You cannot delete your own account."))
          (hexpr html
            (if (> : Int (call (global Admin.Users.Delete.blockers) (var model)) 0)
              (elem p
                (htext "It cannot be deleted while other rows refer to it."))
              (elem al-button
                (attr variant text "destructive")
                (attr type text "submit")
                (elem button (attr type text "submit") (htext "Delete"))))))))
    (elem a
      (attr href href
        (page-ref Admin.Users.Show
          (record Admin.Users.Show.Params
            (id (field id (field row (var model)))))))
      (htext "Back"))))
(test "deleting a user nothing refers to" task
  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "email-1@example.com")
        (name "name-1")
        (passwordHash "passwordhash-1")
        (role (ctor Table.User.Role.Admin))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor Table.User.Role.Admin))))
      (bind task user2 : Text
        (db-insert Table.User.User
          (record
            (email "email-2@example.com")
            (name "name-2")
            (passwordHash "passwordhash-2")
            (role (ctor Table.User.Role.Reader))))
        (bind task user3 : Text
          (db-insert Table.User.User
            (record
              (email "email-3@example.com")
              (name "name-3")
              (passwordHash "passwordhash-3")
              (role (ctor Table.User.Role.Reader))))
          (bind task _
            (db-insert Table.Post.Post
              (record
                (slug "slug-1")
                (title "title-1")
                (body "body-1")
                (published False)
                (author (var user3))))
            (bind task _
              (test-get Admin.Users.Delete (record Params (id (var user2))))
              (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
                (test-submit Admin.Users.Delete.Confirm Remove (record Confirm))
                (bind task gone : Maybe Table.User.User
                  (db-get Table.User.User (var user2))
                  (bind task kept : Maybe Table.User.User
                    (db-get Table.User.User (var user3))
                    (pure task
                      (test-eq
                        (record
                          (answer (field answer (var r)))
                          (gone
                            (call (std Maybe.map)
                              (lambda (row : Table.User.User)
                                (field id (var row)))
                              (var gone)))
                          (kept
                            (call (std Maybe.map)
                              (lambda (row : Table.User.User)
                                (field id (var row)))
                              (var kept))))
                        (record
                          (answer
                            (ctor Prelude.Answer.Redirected
                              (record
                                (value
                                  (page-ref Admin.Users.Index
                                    (record Admin.Users.Index.Params
                                      (q "")
                                      (role "")
                                      (sort "created")
                                      (dir "desc")
                                      (page 1)))))))
                          (gone (ctor Prelude.Maybe.Nothing))
                          (kept
                            (ctor Prelude.Maybe.Just
                              (record (value (var user3))))))))))))))))))
(test "a user that posts refer to is not deleted" task
  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "email-1@example.com")
        (name "name-1")
        (passwordHash "passwordhash-1")
        (role (ctor Table.User.Role.Admin))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor Table.User.Role.Admin))))
      (bind task user2 : Text
        (db-insert Table.User.User
          (record
            (email "email-2@example.com")
            (name "name-2")
            (passwordHash "passwordhash-2")
            (role (ctor Table.User.Role.Reader))))
        (bind task _
          (db-insert Table.Post.Post
            (record
              (slug "slug-1")
              (title "title-1")
              (body "body-1")
              (published False)
              (author (var user2))))
          (bind task page : { model: Model, session: App.Session, doc: Doc, notices: List Text }
            (test-get Admin.Users.Delete (record Params (id (var user2))))
            (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
              (test-submit Admin.Users.Delete.Confirm Remove (record Confirm))
              (bind task kept : Maybe Table.User.User
                (db-get Table.User.User (var user2))
                (pure task
                  (test-eq
                    (record
                      (count
                        (call (std Test.text) "#posts" (field doc (var page))))
                      (buttons
                        (call (std Test.count)
                          "#delete button"
                          (field doc (var page))))
                      (answer (field answer (var r)))
                      (kept
                        (call (std Maybe.map)
                          (lambda (row : Table.User.User) (field id (var row)))
                          (var kept))))
                    (record
                      (count (ctor Prelude.Maybe.Just (record (value "1"))))
                      (buttons 0)
                      (answer
                        (ctor Prelude.Answer.FormRejected
                          (record
                            (value
                              (list
                                (record
                                  (field "")
                                  (message
                                    "This user cannot be deleted while other rows refer to it.")))))))
                      (kept
                        (ctor Prelude.Maybe.Just (record (value (var user2))))))))))))))))
(test "an Admin cannot delete their own account" task
  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "email-1@example.com")
        (name "name-1")
        (passwordHash "passwordhash-1")
        (role (ctor Table.User.Role.Admin))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor Table.User.Role.Admin))))
      (bind task page : { model: Model, session: App.Session, doc: Doc, notices: List Text }
        (test-get Admin.Users.Delete (record Params (id (var me))))
        (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
          (test-submit Admin.Users.Delete.Confirm Remove (record Confirm))
          (bind task kept : Maybe Table.User.User
            (db-get Table.User.User (var me))
            (pure task
              (test-eq
                (record
                  (says
                    (call (std Test.texts) "#delete p" (field doc (var page))))
                  (buttons
                    (call (std Test.count)
