(module Admin.Users.Bulk)
(record Admin.Users.Bulk.Model
  (rows List Table.User.User)
  (held List Text)
  (chosen Int))
(record Admin.Users.Bulk.Confirm)
(record Admin.Users.Bulk.Params (ids List Text))
(record Admin.Users.Bulk.BulkDeleteParams (form Confirm))
(union Admin.Users.Bulk.Msg (BulkDelete BulkDeleteParams))
(record Admin.Users.Bulk.Session (user Text) (role Table.User.Role))
(value Admin.Users.Bulk.maxRows : Int () 25)
(value Admin.Users.Bulk.load : Params -> Session -> Query Model (params session)
  (bind query admin : Bool
    (call (global Admin.Layout.isAdmin) (field user (var session)))
    (if (var admin)
      (let ids : List Text
        (call (std List.take)
          (global Admin.Users.Bulk.maxRows)
          (field ids (var params)))
        (bind query rows : List Table.User.User
          (db-select Table.User.User
            (where (cond in (col Table.User.User id) (var ids)))
            all)
          (bind query held1 : List Table.Post.Post
            (db-select Table.Post.Post
              (where (cond in (col Table.Post.Post author) (var ids)))
              all)
            (pure query
              (record Model
                (rows (var rows))
                (held
                  (call (std List.concat)
                    (list
                      (call (std List.map)
                        (lambda (r : Table.Post.Post) (field author (var r)))
                        (var held1)))))
                (chosen (call (std List.length) (field ids (var params)))))))))
      (not-found))))
(value Admin.Users.Bulk.refused : Model -> Session -> Table.User.User -> Bool (model session row)
  (||
    (call (std List.member) (field id (var row)) (field held (var model)))
    (== : Text (field user (var session)) (field id (var row)))))
(value Admin.Users.Bulk.update : Msg -> Model -> Session -> Task Nav (msg model session)
  (if (> : Int (field chosen (var model)) (global Admin.Users.Bulk.maxRows))
    (pure task
      (ctor Prelude.Nav.Reject
        (record
          (value
            (++ : Text (++ : Text "Choose at most " (call (std Text.fromInt) (global Admin.Users.Bulk.maxRows)))
              " rows at a time.")))))
    (match union (var msg)
      (case BulkDelete (bind _m1 : BulkDeleteParams)
        (let p : BulkDeleteParams
          (var _m1)
          (let allowed : List Table.User.User
            (call (std List.filter)
              (lambda (row : Table.User.User)
                (== : Bool (call (global Admin.Users.Bulk.refused) (var model) (var session) (var row))
                  False))
              (field rows (var model)))
            (bind task _
              (all task
                (call (std List.map)
                  (lambda (row : Table.User.User)
                    (db-delete Table.User.User (field id (var row))))
                  (var allowed)))
              (pure task
                (call (std Notice.with)
                  (++ : Text (++ : Text (++ : Text "Deleted " (call (std Text.fromInt) (call (std List.length) (var allowed)))) " of ")
                    (call (std Text.fromInt)
                      (call (std List.length) (field rows (var model)))))
                  (ctor Prelude.Nav.Redirect
                    (record
                      (value
                        (page-ref Admin.Users.Index
                          (record Admin.Users.Index.Params
                            (q "")
                            (role "")
                            (sort "created")
                            (dir "desc")
                            (page 1)))))))))))))))
(value Admin.Users.Bulk.view : Model -> Session -> Html Msg (model session)
  (comp Admin.Layout.Page
    (record (title "Selected users"))
    (elem h1
      (hexpr text
        (call (std Text.fromInt)
          (call (std List.length) (field rows (var model)))))
      (htext " selected"))
    (elem al-card
      (hif (> : Int (field chosen (var model)) (global Admin.Users.Bulk.maxRows))
        (elem al-alert
          (attr id text "too-many")
          (attr variant text "warning")
          (attr role text "alert")
          (hexpr text
            (++ : Text (++ : Text "Choose at most " (call (std Text.fromInt) (global Admin.Users.Bulk.maxRows)))
              " rows at a time.")))
        (elem span))
      (elem ul (attr id text "selected")
        (hfor row : Table.User.User
          (field rows (var model))
          (elem li
            (hexpr text (field email (var row)))
            (hif (== : Text (field user (var session)) (field id (var row)))
              (elem small (htext " (kept: your own account)"))
              (hexpr html
                (if (call (global Admin.Users.Bulk.refused) (var model) (var session) (var row))
                  (elem small (htext " (kept: other rows refer to it)"))
                  (elem span)))))))
      (form-el Admin.Users.Bulk.BulkDelete
        (attr id text "bulk-delete")
        (attr submit submit
          (ctor Admin.Users.Bulk.Msg.BulkDelete (record BulkDeleteParams)))
        (elem al-alert
          (attr variant text "destructive")
          (attr role text "alert")
          (input Errors Confirm form))
        (elem al-button
          (attr variant text "destructive")
          (attr type text "submit")
          (elem button (attr type text "submit")
            (htext "Delete the rows that can be deleted")))))
    (elem a
      (attr href href
        (page-ref Admin.Users.Index
          (record Admin.Users.Index.Params
            (q "")
            (role "")
            (sort "created")
            (dir "desc")
            (page 1))))
      (htext "Back to the list"))))
(test "deleting the chosen rows leaves the ones other rows refer to" task
  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "email-1@example.com")
        (name "name-1")
        (passwordHash "passwordhash-1")
        (role (ctor Table.User.Role.Admin))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor Table.User.Role.Admin))))
      (bind task user2 : Text
        (db-insert Table.User.User
          (record
            (email "email-2@example.com")
            (name "name-2")
            (passwordHash "passwordhash-2")
            (role (ctor Table.User.Role.Reader))))
        (bind task _
          (db-insert Table.Post.Post
            (record
              (slug "slug-1")
              (title "title-1")
              (body "body-1")
              (published False)
              (author (var user2))))
          (bind task user3 : Text
            (db-insert Table.User.User
              (record
                (email "email-3@example.com")
                (name "name-3")
                (passwordHash "passwordhash-3")
                (role (ctor Table.User.Role.Reader))))
            (bind task user4 : Text
              (db-insert Table.User.User
                (record
                  (email "email-4@example.com")
                  (name "name-4")
                  (passwordHash "passwordhash-4")
                  (role (ctor Table.User.Role.Reader))))
              (bind task _
                (test-get Admin.Users.Bulk
                  (record Params (ids (list (var user2) (var user3)))))
                (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
                  (test-submit Admin.Users.Bulk.Confirm BulkDelete
                    (record Confirm))
                  (bind task gone : Maybe Table.User.User
                    (db-get Table.User.User (var user3))
                    (bind task left : Maybe Table.User.User
                      (db-get Table.User.User (var user4))
                      (bind task kept : Maybe Table.User.User
                        (db-get Table.User.User (var user2))
                        (bind task page : { model: Model, session: App.Session, doc: Doc, notices: List Text }
                          (test-get Admin.Users.Bulk
                            (record Params (ids (list (var user2) (var user3)))))
                          (pure task
                            (test-eq
                              (record
                                (answer (field answer (var r)))
                                (gone
                                  (call (std Maybe.map)
                                    (lambda (row : Table.User.User)
                                      (field id (var row)))
                                    (var gone)))
                                (left
                                  (call (std Maybe.map)
                                    (lambda (row : Table.User.User)
                                      (field id (var row)))
                                    (var left)))
                                (kept
                                  (call (std Maybe.map)
                                    (lambda (row : Table.User.User)
                                      (field id (var row)))
                                    (var kept)))
                                (listed
                                  (call (std Test.count)
                                    "#selected li small"
                                    (field doc (var page)))))
                              (record
                                (answer
                                  (ctor Prelude.Answer.Redirected
                                    (record
                                      (value
                                        (page-ref Admin.Users.Index
                                          (record Admin.Users.Index.Params
                                            (q "")
                                            (role "")
                                            (sort "created")
                                            (dir "desc")
                                            (page 1)))))))
                                (gone (ctor Prelude.Maybe.Nothing))
                                (left
                                  (ctor Prelude.Maybe.Just
                                    (record (value (var user4)))))
                                (kept
                                  (ctor Prelude.Maybe.Just
                                    (record (value (var user2)))))
                                (listed 1)))))))))))))))))
