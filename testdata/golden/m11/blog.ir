(module Admin.Comments.Edit)
(record Admin.Comments.Edit.Model
  (row Table.Comment.Comment)
  (posts List Table.Post.Post)
  (postsTotal Int))
(record Admin.Comments.Edit.CommentForm (post Text) (author Text) (body Text))
(record Admin.Comments.Edit.FindPost (q Text))
(record Admin.Comments.Edit.Params (id Text) (findPost Text = ""))
(record Admin.Comments.Edit.SearchPostParams (form FindPost))
(record Admin.Comments.Edit.SaveParams (form CommentForm))
(union Admin.Comments.Edit.Msg (SearchPost SearchPostParams) (Save SaveParams))
(record Admin.Comments.Edit.Session (user Text) (role Table.User.Role))
(value Admin.Comments.Edit.load : Params -> Session -> Query Model (params session)
  (bind query admin : Bool
    (call (global Admin.Layout.isAdmin) (field user (var session)))
    (if (var admin)
      (bind query found : Maybe Table.Comment.Comment
        (db-get Table.Comment.Comment (field id (var params)))
        (match union (var found)
          (case Just (bind _m1 value : Table.Comment.Comment)
            (let row : Table.Comment.Comment
              (var _m1)
              (let findPost : Text
                (call (std Text.slice) 0 200 (field findPost (var params)))
                (bind query postsTotal : Int
                  (db-select Table.Post.Post count)
                  (bind query postsOwn : List Table.Post.Post
                    (if (> : Int (var postsTotal) 200)
                      (db-select Table.Post.Post
                        (where
                          (cond eq
                            (col Table.Post.Post id)
                            (field post (var row))))
                        all)
                      (pure query (list)))
                    (bind query postsFound : List Table.Post.Post
                      (db-select Table.Post.Post
                        (where
                          (if (> : Int (var postsTotal) 200)
                            (cond and
                              (cond contains
                                (col Table.Post.Post slug)
                                (var findPost))
                              (cond ne
                                (col Table.Post.Post id)
                                (field post (var row))))
                            (cond and)))
                        (order (ord (col Table.Post.Post slug) asc))
                        (limit (if (> : Int (var postsTotal) 200) 50 200))
                        all)
                      (let posts : List Table.Post.Post
                        (++ : List Table.Post.Post (var postsOwn)
                          (var postsFound))
                        (pure query
                          (record Model
                            (row (var row))
                            (posts (var posts))
                            (postsTotal (var postsTotal)))))))))))
          (case Nothing (not-found))))
      (not-found))))
(value Admin.Comments.Edit.update : Msg -> Model -> Session -> Task Nav (msg model session)
  (match union (var msg)
    (case SearchPost (bind _m1 : SearchPostParams)
      (let p : SearchPostParams
        (var _m1)
        (pure task
          (ctor Prelude.Nav.Redirect
            (record
              (value
                (page-ref Admin.Comments.Edit
                  (record Params
                    (id (field id (field row (var model))))
                    (findPost
                      (call (std Text.slice)
                        0
                        200
                        (field q (field form (var p)))))))))))))
    (case Save (bind _m2 : SaveParams)
      (let p : SaveParams
        (var _m2)
        (bind task _
          (db-update Table.Comment.Comment
            (field id (field row (var model)))
            (lambda (row : Table.Comment.Comment)
              (update (var row)
                (post (field post (field form (var p))))
                (author (field author (field form (var p))))
                (body (field body (field form (var p)))))))
          (pure task
            (ctor Prelude.Nav.Redirect
              (record
                (value
                  (page-ref Admin.Comments.Show
                    (record Admin.Comments.Show.Params
                      (id (field id (field row (var model)))))))))))))))
(value Admin.Comments.Edit.view : Model -> Session -> Html Msg (model session)
  (comp Admin.Layout.Page
    (record (title "Edit comment"))
    (elem h1 (htext "Edit comment"))
    (elem al-card
      (hif (> : Int (field postsTotal (var model)) 200)
        (form-el Admin.Comments.Edit.SearchPost
          (attr submit submit
            (ctor Admin.Comments.Edit.Msg.SearchPost (record SearchPostParams)))
          (input Input FindPost field=q label="Find post" (wrap al-input))
          (elem al-button
            (attr type text "submit")
            (attr variant text "secondary")
            (elem button (attr type text "submit") (htext "Find"))))
        (elem span))
      (form-el Admin.Comments.Edit.Save
        (attr submit submit
          (ctor Admin.Comments.Edit.Msg.Save (record SaveParams)))
        (input Select CommentForm field=post label="Post"
          (value (field post (field row (var model))))
          (options
            (call (std List.map)
              (lambda (r : Table.Post.Post)
                (record (value (field id (var r))) (label (field slug (var r)))))
              (field posts (var model))))
          (wrap al-select))
        (input Input CommentForm field=author label="Author"
          (value (field author (field row (var model))))
          (wrap al-input))
        (input Textarea CommentForm field=body label="Body"
          (value (field body (field row (var model))))
          (wrap al-textarea))
        (elem al-alert
          (attr variant text "destructive")
          (attr role text "alert")
          (input Errors CommentForm form))
        (elem al-button (attr type text "submit")
          (elem button (attr type text "submit") (htext "Save")))))
    (elem a
      (attr href href
        (page-ref Admin.Comments.Show
          (record Admin.Comments.Show.Params
            (id (field id (field row (var model)))))))
      (htext "Back"))))
(test "saving changes every field" task
  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "email-1@example.com")
        (name "name-1")
        (passwordHash "passwordhash-1")
        (role (ctor Table.User.Role.Admin))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor Table.User.Role.Admin))))
      (bind task post1 : Text
        (db-insert Table.Post.Post
          (record
            (slug "slug-1")
            (title "title-1")
            (body "body-1")
            (published False)
            (author (var me))))
        (bind task comment1 : Text
          (db-insert Table.Comment.Comment
            (record (post (var post1)) (author "author-1") (body "body-1")))
          (bind task post2 : Text
            (db-insert Table.Post.Post
              (record
                (slug "slug-2")
                (title "title-2")
                (body "body-2")
                (published False)
                (author (var me))))
            (bind task page : { model: Model, session: App.Session, doc: Doc, notices: List Text }
              (test-get Admin.Comments.Edit
                (record Params (id (var comment1)) (findPost "")))
              (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
                (test-submit Admin.Comments.Edit.CommentForm Save
                  (record CommentForm
                    (post (var post2))
                    (author "author-2")
                    (body "body-2")))
                (bind task after : Maybe Table.Comment.Comment
                  (db-get Table.Comment.Comment (var comment1))
                  (pure task
                    (test-eq
                      (record
                        (answer (field answer (var r)))
                        (row
                          (call (std Maybe.map)
                            (lambda (row : Table.Comment.Comment)
                              (record
                                (post (field post (var row)))
                                (author (field author (var row)))
                                (body (field body (var row)))))
                            (var after)))
                        (posts
                          (call (std Test.texts)
                            "select[name=post] option"
                            (field doc (var page)))))
                      (record
                        (answer
                          (ctor Prelude.Answer.Redirected
                            (record
                              (value
                                (page-ref Admin.Comments.Show
                                  (record Admin.Comments.Show.Params
                                    (id (var comment1))))))))
                        (row
                          (ctor Prelude.Maybe.Just
                            (record
                              (value
                                (record
                                  (post (var post2))
                                  (author "author-2")
                                  (body "body-2"))))))
                        (posts (list "slug-1" "slug-2"))))))))))))))
