(test "a long list of users offers 50, and the search narrows it" task
  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "email-1@example.com")
        (name "name-1")
        (passwordHash "passwordhash-1")
        (role (ctor Table.User.Role.Admin))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor Table.User.Role.Admin))))
      (bind task post1 : Text
        (db-insert Table.Post.Post
          (record
            (slug "slug-1")
            (title "title-1")
            (body "body-1")
            (published False)
            (author (var me))))
        (bind task user2 : Text
          (db-insert Table.User.User
            (record
              (email "email-2@example.com")
              (name "name-2")
              (passwordHash "passwordhash-2")
              (role (ctor Table.User.Role.Reader))))
          (bind task _
            (all task
              (call (std List.map)
                (lambda (n : Int)
                  (db-insert Table.User.User
                    (record
                      (email
                        (++ : Text (++ : Text "email-" (call (std Text.fromInt) (var n)))
                          "@example.com"))
                      (name
                        (++ : Text "name-" (call (std Text.fromInt) (var n))))
                      (passwordHash
                        (++ : Text "passwordhash-"
                          (call (std Text.fromInt) (var n))))
                      (role (ctor Table.User.Role.Reader)))))
                (call (std List.range) 3 203)))
            (bind task all : { model: Model, session: App.Session, doc: Doc, notices: List Text }
              (test-get Admin.Posts.Edit
                (record Params (id (var post1)) (findAuthor "")))
              (bind task found : { model: Model, session: App.Session, doc: Doc, notices: List Text }
                (test-get Admin.Posts.Edit
                  (record Params
                    (id (var post1))
                    (findAuthor "email-203@example.com")))
                (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
                  (test-submit Admin.Posts.Edit.FindAuthor SearchAuthor
                    (record FindAuthor (q "zz")))
                  (pure task
                    (test-eq
                      (record
                        (shown
                          (call (std List.length)
                            (field authors (field model (var all)))))
                        (total (field authorsTotal (field model (var all))))
                        (found
                          (<= : Int (call (std Test.count) "select[name=author] option" (field doc (var found)))
                            3))
                        (answer (field answer (var r))))
                      (record
                        (shown 51)
                        (total 203)
                        (found True)
                        (answer
                          (ctor Prelude.Answer.Redirected
                            (record
                              (value
                                (page-ref Admin.Posts.Edit
                                  (record Params
                                    (id (var post1))
                                    (findAuthor "zz")))))))))))))))))))
(test "the row's own author is offered first when it sorts past the 50" task
  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "email-1@example.com")
        (name "name-1")
        (passwordHash "passwordhash-1")
        (role (ctor Table.User.Role.Admin))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor Table.User.Role.Admin))))
      (bind task user2 : Text
        (db-insert Table.User.User
          (record
            (email "zz-1@example.com")
            (name "name-2")
            (passwordHash "passwordhash-2")
            (role (ctor Table.User.Role.Reader))))
        (bind task post1 : Text
          (db-insert Table.Post.Post
            (record
              (slug "slug-1")
              (title "title-1")
              (body "body-1")
              (published False)
              (author (var user2))))
          (bind task _
            (all task
              (call (std List.map)
                (lambda (n : Int)
                  (db-insert Table.User.User
                    (record
                      (email
                        (++ : Text (++ : Text "email-" (call (std Text.fromInt) (var n)))
                          "@example.com"))
                      (name
                        (++ : Text "name-" (call (std Text.fromInt) (var n))))
                      (passwordHash
                        (++ : Text "passwordhash-"
                          (call (std Text.fromInt) (var n))))
                      (role (ctor Table.User.Role.Reader)))))
                (call (std List.range) 3 203)))
            (bind task page : { model: Model, session: App.Session, doc: Doc, notices: List Text }
              (test-get Admin.Posts.Edit
                (record Params (id (var post1)) (findAuthor "")))
              (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
                (test-submit Admin.Posts.Edit.PostForm Save
                  (record PostForm
                    (slug (field slug (field row (field model (var page)))))
                    (title (field title (field row (field model (var page)))))
                    (body (field body (field row (field model (var page)))))
                    (published
                      (field published (field row (field model (var page)))))
                    (author (field author (field row (field model (var page)))))))
                (bind task after : Maybe Table.Post.Post
                  (db-get Table.Post.Post (var post1))
                  (pure task
                    (test-eq
                      (record
                        (answer (field answer (var r)))
                        (kept
                          (call (std Maybe.map)
                            (lambda (row : Table.Post.Post)
                              (field author (var row)))
                            (var after)))
                        (first
                          (call (std Maybe.map)
                            (lambda (o : Table.User.User) (field id (var o)))
                            (call (std List.head)
                              (field authors (field model (var page))))))
                        (once
                          (call (std List.length)
                            (call (std List.filter)
                              (lambda (o : Table.User.User)
                                (== : Text (field id (var o)) (var user2)))
                              (field authors (field model (var page))))))
                        (shown
                          (call (std List.length)
                            (field authors (field model (var page))))))
                      (record
                        (answer
                          (ctor Prelude.Answer.Redirected
                            (record
                              (value
                                (page-ref Admin.Posts.Show
                                  (record Admin.Posts.Show.Params
                                    (id (var post1))))))))
                        (kept
                          (ctor Prelude.Maybe.Just (record (value (var user2)))))
                        (first
                          (ctor Prelude.Maybe.Just (record (value (var user2)))))
                        (once 1)
                        (shown 51)))))))))))))
