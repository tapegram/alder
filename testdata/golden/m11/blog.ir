            (title "title-1")
            (body "body-1")
            (published False)
            (author (var me))))
        (bind task post2 : Text
          (db-insert Table.Post.Post
            (record
              (slug "slug-2")
              (title "title-2")
              (body "body-2")
              (published False)
              (author (var me))))
          (bind task _
