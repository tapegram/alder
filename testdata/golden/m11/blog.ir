(test "filtering by published lists the rows with that value" task
  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "email-1@example.com")
        (name "name-1")
        (passwordHash "passwordhash-1")
        (role (ctor Table.User.Role.Admin))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor Table.User.Role.Admin))))
      (bind task post1 : Text
        (db-insert Table.Post.Post
          (record
            (slug "slug-1")
            (title "title-1")
            (body "body-1")
            (published True)
            (author (var me))))
        (bind task post2 : Text
          (db-insert Table.Post.Post
            (record
              (slug "slug-2")
              (title "title-2")
              (body "body-2")
              (published False)
              (author (var me))))
          (bind task yes : { model: Model, session: App.Session, doc: Doc, notices: List Text }
            (test-get Admin.Posts.Index
              (record Params
                (q "")
                (published "yes")
                (sort "created")
                (dir "desc")
                (page 1)))
            (bind task no : { model: Model, session: App.Session, doc: Doc, notices: List Text }
              (test-get Admin.Posts.Index
                (record Params
                  (q "")
                  (published "no")
                  (sort "created")
                  (dir "desc")
                  (page 1)))
              (pure task
                (test-eq
                  (record
                    (yes
                      (call (std List.map)
                        (lambda (id : Text)
                          (call (std List.member)
                            (var id)
                            (call (std List.map)
                              (lambda (row : Table.Post.Post)
                                (field id (var row)))
                              (field rows (field model (var yes))))))
                        (list (var post1) (var post2))))
                    (no
                      (call (std List.map)
                        (lambda (id : Text)
                          (call (std List.member)
                            (var id)
                            (call (std List.map)
                              (lambda (row : Table.Post.Post)
                                (field id (var row)))
                              (field rows (field model (var no))))))
                        (list (var post1) (var post2))))
                    (count
                      (== : Int (field count (field model (var yes)))
                        (call (std List.length)
                          (field rows (field model (var yes))))))
                    (chosen
                      (call (std Test.texts)
                        "select[name=published] option[selected]"
                        (field doc (var yes)))))
                  (record
                    (yes (list True False))
                    (no (list False True))
                    (count True)
                    (chosen (list "yes"))))))))))))
(test "a search text of 20,000 characters is cut to 200" task
  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "email-1@example.com")
        (name "name-1")
        (passwordHash "passwordhash-1")
        (role (ctor Table.User.Role.Admin))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor Table.User.Role.Admin))))
      (let long : Text
        (call (std Text.join)
          ""
          (call (std List.map)
            (lambda (n : Int) "z")
            (call (std List.range) 1 20000)))
        (bind task page : { model: Model, session: App.Session, doc: Doc, notices: List Text }
          (test-get Admin.Posts.Index
            (record Params
              (q (var long))
              (published "")
              (sort "created")
              (dir "desc")
              (page 1)))
          (pure task
            (test-eq
              (record
                (q (call (std Text.length) (field q (field model (var page)))))
                (rows
                  (call (std List.length) (field rows (field model (var page))))))
              (record (q 200) (rows 0)))))))))
(test "the list has 25 rows a page, and a page past the last is the last" task
  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "email-1@example.com")
        (name "name-1")
        (passwordHash "passwordhash-1")
        (role (ctor Table.User.Role.Admin))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor Table.User.Role.Admin))))
      (bind task _
        (all task
          (call (std List.map)
            (lambda (n : Int)
              (db-insert Table.Post.Post
                (record
                  (slug (++ : Text "slug-" (call (std Text.fromInt) (var n))))
                  (title (++ : Text "title-" (call (std Text.fromInt) (var n))))
                  (body (++ : Text "body-" (call (std Text.fromInt) (var n))))
                  (published False)
                  (author (var me)))))
            (call (std List.range) 1 26)))
        (bind task first : { model: Model, session: App.Session, doc: Doc, notices: List Text }
          (test-get Admin.Posts.Index
            (record Params
              (q "")
              (published "")
              (sort "created")
              (dir "desc")
              (page 1)))
          (bind task second : { model: Model, session: App.Session, doc: Doc, notices: List Text }
            (test-get Admin.Posts.Index
              (record Params
                (q "")
                (published "")
                (sort "created")
                (dir "desc")
                (page 2)))
            (bind task past : { model: Model, session: App.Session, doc: Doc, notices: List Text }
              (test-get Admin.Posts.Index
                (record Params
                  (q "")
                  (published "")
                  (sort "created")
                  (dir "desc")
                  (page 9)))
              (pure task
                (test-eq
                  (record
                    (first
                      (call (std List.length)
                        (field rows (field model (var first)))))
                    (second
                      (call (std List.length)
                        (field rows (field model (var second)))))
                    (past
                      (record
                        (page (field page (field model (var past))))
                        (rows
                          (call (std List.length)
                            (field rows (field model (var past)))))))
                    (count
                      (call (std Test.text) "#count" (field doc (var first))))
                    (pages
                      (call (std Test.texts)
                        "al-pagination span"
                        (field doc (var first)))))
                  (record
                    (first 25)
                    (second 1)
                    (past (record (page 2) (rows 1)))
                    (count (ctor Prelude.Maybe.Just (record (value "26 rows"))))
                    (pages (list "Previous" "Page 1 of 2"))))))))))))
