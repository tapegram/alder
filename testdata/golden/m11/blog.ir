(module Admin.Users.Show)
(record Admin.Users.Show.Model
  (row Table.User.User)
  (labels Labels)
  (own Bool)
  (posts Int))
(record Admin.Users.Show.Labels)
(record Admin.Users.Show.Confirm)
(record Admin.Users.Show.Params (id Text))
(record Admin.Users.Show.RemoveParams (form Confirm))
(union Admin.Users.Show.Msg (Remove RemoveParams))
(record Admin.Users.Show.Session (user Text) (role Table.User.Role))
(value Admin.Users.Show.load : Params -> Session -> Query Model (params session)
  (bind query admin : Bool
    (call (global Admin.Layout.isAdmin) (field user (var session)))
    (if (var admin)
      (bind query found : Maybe Table.User.User
        (db-get Table.User.User (field id (var params)))
        (bind query posts : Int
          (db-select Table.Post.Post
            (where
              (cond eq (col Table.Post.Post author) (field id (var params))))
            count)
          (match union (var found)
            (case Just (bind _m1 value : Table.User.User)
              (let row : Table.User.User
                (var _m1)
                (bind query labels : Labels
                  (call (global Admin.Users.Show.labelsOf) (list (var row)))
                  (pure query
                    (record Model
                      (row (var row))
                      (labels (var labels))
                      (own
                        (== : Text (field user (var session))
                          (field id (var row))))
                      (posts (var posts)))))))
            (case Nothing (not-found)))))
      (not-found))))
(value Admin.Users.Show.labelsOf : List Table.User.User -> Query Labels (rows)
  (pure query (record Labels)))
(value Admin.Users.Show.blockers : Model -> Int (model)
  (field posts (var model)))
(value Admin.Users.Show.update : Msg -> Model -> Session -> Task Nav (msg model session)
  (match union (var msg)
    (case Remove (bind _m1 : RemoveParams)
      (let p : RemoveParams
        (var _m1)
        (if (field own (var model))
          (pure task
            (ctor Prelude.Nav.Reject
              (record (value "You cannot delete your own account."))))
          (if (> : Int (call (global Admin.Users.Show.blockers) (var model)) 0)
            (pure task
              (ctor Prelude.Nav.Reject
                (record
                  (value
                    "This user cannot be deleted while other rows refer to it."))))
            (bind task _
              (db-delete Table.User.User (field id (field row (var model))))
              (pure task
                (ctor Prelude.Nav.Redirect
                  (record
                    (value
                      (page-ref Admin.Users.Index
                        (record Admin.Users.Index.Params
                          (q "")
                          (role "")
                          (sort "created")
                          (dir "desc")
                          (page 1))))))))))))))
(value Admin.Users.Show.view : Model -> Session -> Html Msg (model session)
  (comp Admin.Layout.Page
    (record (title "User"))
    (elem h1 (htext "User"))
    (elem al-card
      (elem dl (attr id text "fields")
        (elem dt (htext "Id"))
        (elem dd (hexpr text (field id (field row (var model)))))
        (elem dt (htext "Email"))
        (elem dd (hexpr text (field email (field row (var model)))))
        (elem dt (htext "Name"))
        (elem dd (hexpr text (field name (field row (var model)))))
        (elem dt (htext "Role"))
        (elem dd
          (elem al-badge
            (hmatch union (field role (field row (var model)))
              (case Reader (hexpr text "Reader"))
              (case Author (hexpr text "Author"))
              (case Admin (hexpr text "Admin")))))
        (elem dt (htext "Created"))
        (elem dd
          (hexpr text
            (call (std Time.format)
              "Jan 2, 2006"
              (field created (field row (var model)))))))
      (elem div (attr slot text "actions")
        (elem al-button
          (elem a
            (attr href href
              (page-ref Admin.Users.Edit
                (record Admin.Users.Edit.Params
                  (id (field id (field row (var model)))))))
            (htext "Edit")))
        (elem al-button (attr variant text "destructive")
          (elem button
            (attr type text "button")
            (attr commandfor text "delete-dialog")
            (attr command text "show-modal")
            (htext "Delete")))))
    (elem al-dialog
      (attr heading text "Delete this user?")
      (attr dismissible bool True)
      (elem dialog
        (attr id text "delete-dialog")
        (attr aria-labelledby text "delete-dialog-heading")
        (attr data-preserve-attr text "open")
        (attr closedby text "any")
        (elem form (attr method text "dialog")
          (elem button
            (attr type text "submit")
            (attr aria-label text "Close Delete this user?")
            (htext "×")))
        (elem h2
          (attr slot text "header")
          (attr id text "delete-dialog-heading")
          (hexpr text "Delete this user?"))
        (elem dl
          (elem dt (htext "Posts that keep it from being deleted"))
          (elem dd (attr id text "posts")
            (hexpr text (call (std Text.fromInt) (field posts (var model))))))
        (form-el Admin.Users.Show.Remove
          (attr id text "delete")
          (attr submit submit
            (ctor Admin.Users.Show.Msg.Remove (record RemoveParams)))
          (elem al-alert
            (attr variant text "destructive")
            (attr role text "alert")
            (input Errors Confirm form))
          (hif (field own (var model))
            (elem p (htext "You cannot delete your own account."))
            (hexpr html
              (if (> : Int (call (global Admin.Users.Show.blockers) (var model)) 0)
                (elem p
                  (htext "It cannot be deleted while other rows refer to it."))
                (elem al-button
                  (attr variant text "destructive")
                  (attr type text "submit")
                  (elem button (attr type text "submit") (htext "Delete")))))))
        (elem div (attr slot text "actions")
          (elem a
            (attr href href
              (page-ref Admin.Users.Delete
                (record Admin.Users.Delete.Params
                  (id (field id (field row (var model)))))))
            (htext "See the details")))))
    (elem a
      (attr href href
        (page-ref Admin.Users.Index
          (record Admin.Users.Index.Params
            (q "")
            (role "")
            (sort "created")
            (dir "desc")
            (page 1))))
      (htext "All users"))))
(test "the page shows the row" task
  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "email-1@example.com")
        (name "name-1")
        (passwordHash "passwordhash-1")
        (role (ctor Table.User.Role.Admin))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor Table.User.Role.Admin))))
      (bind task user2 : Text
        (db-insert Table.User.User
          (record
            (email "email-2@example.com")
            (name "name-2")
            (passwordHash "passwordhash-2")
            (role (ctor Table.User.Role.Reader))))
        (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
          (test-open Admin.Users.Show (record Params (id (var user2))))
          (pure task
            (test-eq
              (record
                (answer (field answer (var r)))
                (email
                  (call (std List.member)
                    "email-2@example.com"
                    (call (std Test.texts) "#fields dd" (field doc (var r))))))
              (record (answer (ctor Prelude.Answer.Shown)) (email True)))))))))
(test "deleting a user nothing refers to" task
  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "email-1@example.com")
        (name "name-1")
        (passwordHash "passwordhash-1")
        (role (ctor Table.User.Role.Admin))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor Table.User.Role.Admin))))
      (bind task user2 : Text
        (db-insert Table.User.User
          (record
            (email "email-2@example.com")
            (name "name-2")
            (passwordHash "passwordhash-2")
            (role (ctor Table.User.Role.Reader))))
        (bind task user3 : Text
          (db-insert Table.User.User
            (record
              (email "email-3@example.com")
              (name "name-3")
              (passwordHash "passwordhash-3")
              (role (ctor Table.User.Role.Reader))))
          (bind task _
            (db-insert Table.Post.Post
              (record
                (slug "slug-1")
                (title "title-1")
                (body "body-1")
                (published False)
                (author (var user3))))
            (bind task _
              (test-get Admin.Users.Show (record Params (id (var user2))))
              (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
                (test-submit Admin.Users.Show.Confirm Remove (record Confirm))
                (bind task gone : Maybe Table.User.User
                  (db-get Table.User.User (var user2))
                  (bind task kept : Maybe Table.User.User
                    (db-get Table.User.User (var user3))
                    (pure task
                      (test-eq
                        (record
                          (answer (field answer (var r)))
                          (gone
                            (call (std Maybe.map)
                              (lambda (row : Table.User.User)
                                (field id (var row)))
                              (var gone)))
                          (kept
                            (call (std Maybe.map)
                              (lambda (row : Table.User.User)
                                (field id (var row)))
                              (var kept))))
                        (record
                          (answer
                            (ctor Prelude.Answer.Redirected
                              (record
                                (value
                                  (page-ref Admin.Users.Index
                                    (record Admin.Users.Index.Params
                                      (q "")
                                      (role "")
                                      (sort "created")
                                      (dir "desc")
                                      (page 1)))))))
                          (gone (ctor Prelude.Maybe.Nothing))
                          (kept
                            (ctor Prelude.Maybe.Just
                              (record (value (var user3))))))))))))))))))
(test "a user that posts refer to is not deleted" task
  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "email-1@example.com")
        (name "name-1")
        (passwordHash "passwordhash-1")
        (role (ctor Table.User.Role.Admin))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor Table.User.Role.Admin))))
      (bind task user2 : Text
        (db-insert Table.User.User
          (record
            (email "email-2@example.com")
            (name "name-2")
            (passwordHash "passwordhash-2")
            (role (ctor Table.User.Role.Reader))))
        (bind task _
          (db-insert Table.Post.Post
            (record
              (slug "slug-1")
              (title "title-1")
              (body "body-1")
              (published False)
              (author (var user2))))
          (bind task page : { model: Model, session: App.Session, doc: Doc, notices: List Text }
            (test-get Admin.Users.Show (record Params (id (var user2))))
            (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
              (test-submit Admin.Users.Show.Confirm Remove (record Confirm))
              (bind task kept : Maybe Table.User.User
                (db-get Table.User.User (var user2))
                (pure task
                  (test-eq
                    (record
                      (count
                        (call (std Test.text) "#posts" (field doc (var page))))
                      (buttons
                        (call (std Test.count)
                          "#delete button"
                          (field doc (var page))))
                      (answer (field answer (var r)))
                      (kept
                        (call (std Maybe.map)
                          (lambda (row : Table.User.User) (field id (var row)))
                          (var kept))))
                    (record
                      (count (ctor Prelude.Maybe.Just (record (value "1"))))
                      (buttons 0)
                      (answer
                        (ctor Prelude.Answer.FormRejected
                          (record
                            (value
                              (list
                                (record
                                  (field "")
                                  (message
                                    "This user cannot be deleted while other rows refer to it.")))))))
                      (kept
                        (ctor Prelude.Maybe.Just (record (value (var user2))))))))))))))))
(test "an Admin cannot delete their own account" task
  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "email-1@example.com")
        (name "name-1")
        (passwordHash "passwordhash-1")
        (role (ctor Table.User.Role.Admin))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor Table.User.Role.Admin))))
      (bind task page : { model: Model, session: App.Session, doc: Doc, notices: List Text }
        (test-get Admin.Users.Show (record Params (id (var me))))
        (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
          (test-submit Admin.Users.Show.Confirm Remove (record Confirm))
          (bind task kept : Maybe Table.User.User
            (db-get Table.User.User (var me))
            (pure task
              (test-eq
                (record
                  (says
                    (call (std Test.texts) "#delete p" (field doc (var page))))
                  (buttons
                    (call (std Test.count)
                      "#delete button"
                      (field doc (var page))))
