(module Admin.Comments.New)
(record Admin.Comments.New.Model (posts List Table.Post.Post) (postsTotal Int))
(record Admin.Comments.New.CommentForm (post Text) (author Text) (body Text))
(record Admin.Comments.New.FindPost (q Text))
(record Admin.Comments.New.Params (findPost Text = ""))
(record Admin.Comments.New.SearchPostParams (form FindPost))
(record Admin.Comments.New.CreateParams (form CommentForm))
(union Admin.Comments.New.Msg
  (SearchPost SearchPostParams)
  (Create CreateParams))
(record Admin.Comments.New.Session (user Text) (role Table.User.Role))
(value Admin.Comments.New.load : Params -> Session -> Query Model (params session)
  (bind query admin : Bool
    (call (global Admin.Layout.isAdmin) (field user (var session)))
    (if (var admin)
      (let findPost : Text
        (call (std Text.slice) 0 200 (field findPost (var params)))
        (bind query postsTotal : Int
          (db-select Table.Post.Post count)
          (bind query posts : List Table.Post.Post
            (db-select Table.Post.Post
              (where
                (if (> : Int (var postsTotal) 200)
                  (cond contains (col Table.Post.Post slug) (var findPost))
                  (cond and)))
              (order (ord (col Table.Post.Post slug) asc))
              (limit (if (> : Int (var postsTotal) 200) 50 200))
              all)
            (pure query
              (record Model (posts (var posts)) (postsTotal (var postsTotal)))))))
      (not-found))))
(value Admin.Comments.New.update : Msg -> Model -> Session -> Task Nav (msg model session)
  (match union (var msg)
    (case SearchPost (bind _m1 : SearchPostParams)
      (let p : SearchPostParams
        (var _m1)
        (pure task
          (ctor Prelude.Nav.Redirect
            (record
              (value
                (page-ref Admin.Comments.New
                  (record Params
                    (findPost
                      (call (std Text.slice)
                        0
                        200
                        (field q (field form (var p)))))))))))))
    (case Create (bind _m2 : CreateParams)
      (let p : CreateParams
        (var _m2)
        (bind task id : Text
          (db-insert Table.Comment.Comment
            (record
              (post (field post (field form (var p))))
              (author (field author (field form (var p))))
              (body (field body (field form (var p))))))
          (pure task
            (ctor Prelude.Nav.Redirect
              (record
                (value
                  (page-ref Admin.Comments.Show
                    (record Admin.Comments.Show.Params (id (var id)))))))))))))
(value Admin.Comments.New.view : Model -> Session -> Html Msg (model session)
  (comp Admin.Layout.Page
    (record (title "New comment"))
    (elem h1 (htext "New comment"))
    (elem al-card
      (hif (> : Int (field postsTotal (var model)) 200)
        (form-el Admin.Comments.New.SearchPost
          (attr submit submit
            (ctor Admin.Comments.New.Msg.SearchPost (record SearchPostParams)))
          (input Input FindPost field=q label="Find post" (wrap al-input))
          (elem al-button
            (attr type text "submit")
            (attr variant text "secondary")
            (elem button (attr type text "submit") (htext "Find"))))
        (elem span))
      (form-el Admin.Comments.New.Create
        (attr submit submit
          (ctor Admin.Comments.New.Msg.Create (record CreateParams)))
        (input Select CommentForm field=post label="Post"
          (options
            (call (std List.map)
              (lambda (r : Table.Post.Post)
                (record (value (field id (var r))) (label (field slug (var r)))))
              (field posts (var model))))
          (wrap al-select))
        (input Input CommentForm field=author label="Author" (wrap al-input))
        (input Textarea CommentForm field=body label="Body" (wrap al-textarea))
        (elem al-alert
          (attr variant text "destructive")
          (attr role text "alert")
          (input Errors CommentForm form))
        (elem al-button (attr type text "submit")
          (elem button (attr type text "submit") (htext "Create")))))))
(test "creating a comment adds it, with the values submitted" task
  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "email-1@example.com")
        (name "name-1")
        (passwordHash "passwordhash-1")
        (role (ctor Table.User.Role.Admin))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor Table.User.Role.Admin))))
      (bind task post1 : Text
        (db-insert Table.Post.Post
          (record
            (slug "slug-1")
            (title "title-1")
            (body "body-1")
            (published False)
            (author (var me))))
        (bind task post2 : Text
          (db-insert Table.Post.Post
            (record
              (slug "slug-2")
              (title "title-2")
              (body "body-2")
              (published False)
              (author (var me))))
          (bind task page : { model: Model, session: App.Session, doc: Doc, notices: List Text }
            (test-get Admin.Comments.New (record Params (findPost "")))
            (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
              (test-submit Admin.Comments.New.CommentForm Create
                (record CommentForm
                  (post (var post2))
                  (author "author-1")
                  (body "body-1")))
              (bind task rows : List Table.Comment.Comment
                (db-select Table.Comment.Comment all)
                (pure task
                  (test-eq
                    (record
                      (answers
                        (call (std List.map)
                          (lambda (row : Table.Comment.Comment)
                            (ctor Prelude.Answer.Redirected
                              (record
                                (value
                                  (page-ref Admin.Comments.Show
                                    (record Admin.Comments.Show.Params
                                      (id (field id (var row)))))))))
                          (var rows)))
                      (rows
                        (call (std List.map)
                          (lambda (row : Table.Comment.Comment)
                            (record
                              (post (field post (var row)))
                              (author (field author (var row)))
                              (body (field body (var row)))))
                          (var rows)))
                      (posts
                        (call (std Test.texts)
                          "select[name=post] option"
                          (field doc (var page)))))
                    (record
                      (answers (list (field answer (var r))))
                      (rows
                        (list
                          (record
                            (post (var post2))
                            (author "author-1")
                            (body "body-1"))))
                      (posts (list "slug-1" "slug-2")))))))))))))
(test "a post not offered is refused" task
  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "email-1@example.com")
        (name "name-1")
        (passwordHash "passwordhash-1")
        (role (ctor Table.User.Role.Admin))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor Table.User.Role.Admin))))
      (bind task post1 : Text
        (db-insert Table.Post.Post
          (record
            (slug "slug-1")
            (title "title-1")
            (body "body-1")
            (published False)
            (author (var me))))
        (bind task post2 : Text
          (db-insert Table.Post.Post
            (record
              (slug "slug-2")
              (title "title-2")
              (body "body-2")
              (published False)
              (author (var me))))
          (bind task page : { model: Model, session: App.Session, doc: Doc, notices: List Text }
            (test-get Admin.Comments.New (record Params (findPost "")))
            (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
              (test-submit-raw Admin.Comments.New.CommentForm Create
                (list
                  (record (name "post") (value "missing"))
                  (record (name "author") (value "x"))
                  (record (name "body") (value "x"))))
              (bind task rows : Int
                (db-select Table.Comment.Comment count)
                (pure task
                  (test-eq
                    (record (answer (field answer (var r))) (rows (var rows)))
                    (record
                      (answer
                        (ctor Prelude.Answer.FormRejected
                          (record
                            (value
                              (list
                                (record
                                  (field "post")
                                  (message "must be one of the options")))))))
                      (rows 0))))))))))))
(test "a list of 200 posts is offered whole" task
  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "email-1@example.com")
        (name "name-1")
        (passwordHash "passwordhash-1")
        (role (ctor Table.User.Role.Admin))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor Table.User.Role.Admin))))
      (bind task post1 : Text
        (db-insert Table.Post.Post
          (record
            (slug "slug-1")
            (title "title-1")
            (body "body-1")
            (published False)
            (author (var me))))
        (bind task post2 : Text
          (db-insert Table.Post.Post
            (record
              (slug "slug-2")
              (title "title-2")
              (body "body-2")
              (published False)
              (author (var me))))
          (bind task _
            (all task
              (call (std List.map)
                (lambda (n : Int)
                  (db-insert Table.Post.Post
                    (record
                      (slug
                        (++ : Text "slug-" (call (std Text.fromInt) (var n))))
                      (title
                        (++ : Text "title-" (call (std Text.fromInt) (var n))))
                      (body
                        (++ : Text "body-" (call (std Text.fromInt) (var n))))
                      (published False)
                      (author (var me)))))
                (call (std List.range) 3 200)))
            (bind task page : { model: Model, session: App.Session, doc: Doc, notices: List Text }
              (test-get Admin.Comments.New (record Params (findPost "")))
              (pure task
                (test-eq
                  (call (std List.length)
                    (field posts (field model (var page))))
                  200)))))))))
(test "a long list of posts offers 50, and the search narrows it" task
  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "email-1@example.com")
        (name "name-1")
        (passwordHash "passwordhash-1")
        (role (ctor Table.User.Role.Admin))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor Table.User.Role.Admin))))
      (bind task post1 : Text
        (db-insert Table.Post.Post
          (record
            (slug "slug-1")
            (title "title-1")
            (body "body-1")
            (published False)
            (author (var me))))
        (bind task post2 : Text
          (db-insert Table.Post.Post
            (record
              (slug "slug-2")
              (title "title-2")
              (body "body-2")
              (published False)
              (author (var me))))
          (bind task _
            (all task
              (call (std List.map)
                (lambda (n : Int)
                  (db-insert Table.Post.Post
                    (record
                      (slug
                        (++ : Text "slug-" (call (std Text.fromInt) (var n))))
                      (title
                        (++ : Text "title-" (call (std Text.fromInt) (var n))))
                      (body
                        (++ : Text "body-" (call (std Text.fromInt) (var n))))
                      (published False)
                      (author (var me)))))
                (call (std List.range) 3 203)))
            (bind task all : { model: Model, session: App.Session, doc: Doc, notices: List Text }
              (test-get Admin.Comments.New (record Params (findPost "")))
              (bind task found : { model: Model, session: App.Session, doc: Doc, notices: List Text }
                (test-get Admin.Comments.New
                  (record Params (findPost "slug-203")))
                (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
                  (test-submit Admin.Comments.New.FindPost SearchPost
                    (record FindPost (q "zz")))
                  (pure task
                    (test-eq
                      (record
                        (shown
                          (call (std List.length)
                            (field posts (field model (var all)))))
                        (total (field postsTotal (field model (var all))))
                        (found
                          (== : List Text (call (std Test.texts) "select[name=post] option" (field doc (var found)))
                            (list "slug-203")))
                        (answer (field answer (var r))))
                      (record
                        (shown 50)
                        (total 203)
                        (found True)
                        (answer
                          (ctor Prelude.Answer.Redirected
                            (record
                              (value
                                (page-ref Admin.Comments.New
                                  (record Params (findPost "zz")))))))))))))))))))
