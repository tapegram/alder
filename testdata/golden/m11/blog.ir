        (db-insert Table.Post.Post
          (record
            (slug "hello")
            (title "Hello")
            (body "")
            (published False)
            (author (var author))))
        (bind task _
          (test-get Auth.Login (record Auth.Login.Params))
          (bind task _
            (test-submit Auth.Login.Credentials Submit
              (record Auth.Login.Credentials
                (email "author@example.com")
                (password "secret")))
            (bind task before : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
              (test-open Write.Edit (record Params (id (var id))))
              (bind task _
                (db-update Table.User.User
                  (var author)
                  (lambda (u : Table.User.User)
                    (update (var u) (role (ctor Table.User.Role.Reader)))))
                (bind task stale : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
                  (test-open Write.Edit (record Params (id (var id))))
                  (bind task _
                    (test-get Auth.Login (record Auth.Login.Params))
                    (bind task _
                      (test-submit Auth.Login.Credentials Submit
                        (record Auth.Login.Credentials
                          (email "author@example.com")
                          (password "secret")))
                      (bind task fresh : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
                        (test-open Write.Edit (record Params (id (var id))))
                        (pure task
                          (test-eq
                            (record
                              (before (field answer (var before)))
                              (stale (field answer (var stale)))
                              (fresh (field answer (var fresh))))
                            (record
                              (before (ctor Prelude.Answer.Shown))
                              (stale (ctor Prelude.Answer.PageMissing))
                              (fresh (ctor Prelude.Answer.PageMissing)))))))))))))))))
