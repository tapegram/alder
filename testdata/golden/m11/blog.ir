      (record
        (email "email-1@example.com")
        (name "name-1")
        (passwordHash "passwordhash-1")
        (role (ctor Table.User.Role.Admin))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor Table.User.Role.Admin))))
      (bind task user2 : Text
        (db-insert Table.User.User
          (record
            (email "email-2@example.com")
            (name "name-2")
            (passwordHash "passwordhash-2")
            (role (ctor Table.User.Role.Admin))))
        (bind task user3 : Text
          (db-insert Table.User.User
            (record
              (email "email-3@example.com")
              (name "name-3")
              (passwordHash "passwordhash-3")
              (role (ctor Table.User.Role.Reader))))
          (bind task admin : { model: Model, session: App.Session, doc: Doc, notices: List Text }
            (test-get Admin.Users.Index
              (record Params
                (q "")
                (role "Admin")
                (sort "created")
                (dir "desc")
                (page 1)))
            (pure task
              (test-eq
                (record
                  (admin
                    (call (std List.map)
                      (lambda (id : Text)
                        (call (std List.member)
                          (var id)
                          (call (std List.map)
                            (lambda (row : Table.User.User)
                              (field id (var row)))
                            (field rows (field model (var admin))))))
                      (list (var user2) (var user3))))
                  (count
                    (== : Int (field count (field model (var admin)))
                      (call (std List.length)
                        (field rows (field model (var admin))))))
                  (chosen
                    (call (std Test.texts)
                      "select[name=role] option[selected]"
                      (field doc (var admin)))))
                (record
                  (admin (list True False))
                  (count True)
                  (chosen (list "Admin")))))))))))
(test "a search text of 20,000 characters is cut to 200" task
  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "email-1@example.com")
        (name "name-1")
        (passwordHash "passwordhash-1")
        (role (ctor Table.User.Role.Admin))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor Table.User.Role.Admin))))
      (let long : Text
        (call (std Text.join)
          ""
          (call (std List.map)
            (lambda (n : Int) "z")
            (call (std List.range) 1 20000)))
        (bind task page : { model: Model, session: App.Session, doc: Doc, notices: List Text }
          (test-get Admin.Users.Index
            (record Params
              (q (var long))
              (role "")
              (sort "created")
              (dir "desc")
              (page 1)))
          (pure task
            (test-eq
              (record
                (q (call (std Text.length) (field q (field model (var page)))))
                (rows
                  (call (std List.length) (field rows (field model (var page))))))
              (record (q 200) (rows 0)))))))))
(test "the list has 25 rows a page, and a page past the last is the last" task
  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "email-1@example.com")
        (name "name-1")
        (passwordHash "passwordhash-1")
        (role (ctor Table.User.Role.Admin))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor Table.User.Role.Admin))))
      (bind task _
        (all task
          (call (std List.map)
            (lambda (n : Int)
              (db-insert Table.User.User
                (record
                  (email
                    (++ : Text (++ : Text "email-" (call (std Text.fromInt) (var n)))
                      "@example.com"))
                  (name (++ : Text "name-" (call (std Text.fromInt) (var n))))
                  (passwordHash
                    (++ : Text "passwordhash-"
                      (call (std Text.fromInt) (var n))))
                  (role (ctor Table.User.Role.Reader)))))
            (call (std List.range) 2 27)))
        (bind task first : { model: Model, session: App.Session, doc: Doc, notices: List Text }
          (test-get Admin.Users.Index
            (record Params
              (q "")
              (role "")
              (sort "created")
              (dir "desc")
              (page 1)))
          (bind task second : { model: Model, session: App.Session, doc: Doc, notices: List Text }
            (test-get Admin.Users.Index
              (record Params
                (q "")
                (role "")
                (sort "created")
                (dir "desc")
                (page 2)))
            (bind task past : { model: Model, session: App.Session, doc: Doc, notices: List Text }
              (test-get Admin.Users.Index
                (record Params
                  (q "")
                  (role "")
                  (sort "created")
                  (dir "desc")
                  (page 9)))
              (pure task
                (test-eq
                  (record
                    (first
                      (call (std List.length)
                        (field rows (field model (var first)))))
                    (second
                      (call (std List.length)
                        (field rows (field model (var second)))))
                    (past
                      (record
                        (page (field page (field model (var past))))
                        (rows
                          (call (std List.length)
                            (field rows (field model (var past)))))))
                    (count
                      (call (std Test.text) "#count" (field doc (var first))))
                    (pages
                      (call (std Test.texts)
                        "al-pagination span"
                        (field doc (var first)))))
                  (record
                    (first 25)
                    (second 2)
                    (past (record (page 2) (rows 2)))
                    (count (ctor Prelude.Maybe.Just (record (value "27 rows"))))
                    (pages (list "Previous" "Page 1 of 2"))))))))))))
