                (title "title-2")
                (body "body-2")
                (published False)
                (author (var me))))
            (bind task _
              (all task
                (call (std List.map)
                  (lambda (n : Int)
                    (db-insert Table.Post.Post
                      (record
                        (slug
                          (++ : Text "slug-" (call (std Text.fromInt) (var n))))
                        (title
                          (++ : Text "title-" (call (std Text.fromInt) (var n))))
                        (body
                          (++ : Text "body-" (call (std Text.fromInt) (var n))))
                        (published False)
                        (author (var me)))))
                  (call (std List.range) 3 203)))
              (bind task all : { model: Model, session: App.Session, doc: Doc, notices: List Text }
                (test-get Admin.Comments.Edit
                  (record Params (id (var comment1)) (findPost "")))
                (bind task found : { model: Model, session: App.Session, doc: Doc, notices: List Text }
                  (test-get Admin.Comments.Edit
