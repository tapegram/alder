    (db-insert Table.User.User
      (record
        (email "email-1@example.com")
        (name "name-1")
        (passwordHash "passwordhash-1")
        (role (ctor Table.User.Role.Admin))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor Table.User.Role.Admin))))
      (bind task _
        (test-get Admin.Users.Edit (record Params (id (var me))))
        (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
          (test-submit Admin.Users.Edit.UserForm Save
            (record UserForm
              (email "email-2@example.com")
              (name "name-2")
              (role (ctor Table.User.Role.Admin))))
          (bind task after : Maybe Table.User.User
            (db-get Table.User.User (var me))
            (pure task
              (test-eq
                (record
                  (answer (field answer (var r)))
                  (row
                    (call (std Maybe.map)
                      (lambda (row : Table.User.User)
                        (record
                          (email (field email (var row)))
                          (name (field name (var row)))
                          (role (field role (var row)))))
                      (var after))))
                (record
                  (answer
                    (ctor Prelude.Answer.Redirected
                      (record
                        (value
                          (page-ref Admin.Users.Show
                            (record Admin.Users.Show.Params (id (var me))))))))
                  (row
                    (ctor Prelude.Maybe.Just
                      (record
                        (value
                          (record
                            (email "email-2@example.com")
                            (name "name-2")
                            (role (ctor Table.User.Role.Admin))))))))))))))))
