(module Admin.Posts.Delete)
(record Admin.Posts.Delete.Model (row Table.Post.Post) (comments Int))
(record Admin.Posts.Delete.Confirm)
(record Admin.Posts.Delete.Params (id Text))
(record Admin.Posts.Delete.RemoveParams (form Confirm))
(union Admin.Posts.Delete.Msg (Remove RemoveParams))
(record Admin.Posts.Delete.Session (user Text) (role Table.User.Role))
(value Admin.Posts.Delete.load : Params -> Session -> Query Model (params session)
  (bind query admin : Bool
    (call (global Admin.Layout.isAdmin) (field user (var session)))
    (if (var admin)
      (bind query found : Maybe Table.Post.Post
        (db-get Table.Post.Post (field id (var params)))
        (bind query comments : Int
          (db-select Table.Comment.Comment
            (where
              (cond eq (col Table.Comment.Comment post) (field id (var params))))
            count)
          (match union (var found)
            (case Just (bind _m1 value : Table.Post.Post)
              (let row : Table.Post.Post
                (var _m1)
                (pure query
                  (record Model (row (var row)) (comments (var comments))))))
            (case Nothing (not-found)))))
      (not-found))))
(value Admin.Posts.Delete.blockers : Model -> Int (model) 0)
(value Admin.Posts.Delete.update : Msg -> Model -> Session -> Task Nav (msg model session)
  (match union (var msg)
    (case Remove (bind _m1 : RemoveParams)
      (let p : RemoveParams
        (var _m1)
        (bind task _
          (db-delete Table.Post.Post (field id (field row (var model))))
          (pure task
            (ctor Prelude.Nav.Redirect
              (record
                (value
                  (page-ref Admin.Posts.Index
                    (record Admin.Posts.Index.Params
                      (q "")
                      (published "")
                      (sort "created")
                      (dir "desc")
                      (page 1))))))))))))
(value Admin.Posts.Delete.view : Model -> Session -> Html Msg (model session)
  (comp Admin.Layout.Page
    (record (title "Delete post"))
    (elem h1 (htext "Delete this post?"))
    (elem al-card
      (elem p (hexpr text (field slug (field row (var model)))))
      (elem dl
        (elem dt (htext "Comments deleted with it"))
        (elem dd (attr id text "comments")
          (hexpr text (call (std Text.fromInt) (field comments (var model))))))
      (form-el Admin.Posts.Delete.Remove
        (attr id text "delete")
        (attr submit submit
          (ctor Admin.Posts.Delete.Msg.Remove (record RemoveParams)))
        (elem al-alert
          (attr variant text "destructive")
          (attr role text "alert")
          (input Errors Confirm form))
        (hif (> : Int (call (global Admin.Posts.Delete.blockers) (var model)) 0)
          (elem p (htext "It cannot be deleted while other rows refer to it."))
          (elem al-button
            (attr variant text "destructive")
            (attr type text "submit")
            (elem button (attr type text "submit") (htext "Delete"))))))
    (elem a
      (attr href href
        (page-ref Admin.Posts.Show
          (record Admin.Posts.Show.Params
            (id (field id (field row (var model)))))))
      (htext "Back"))))
