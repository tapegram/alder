(module Admin.Comments.Index)
(record Admin.Comments.Index.Model
  (rows List Table.Comment.Comment)
  (labels Labels)
  (q Text)
  (filters Filters)
  (sort Text)
  (dir Text)
  (page Int)
  (pages Int)
  (count Int))
(record Admin.Comments.Index.Filter
  (name Text)
  (label Text)
  (value Text)
  (options List { value: Text, label: Text, rows: Condition Table.Comment.Comment }))
(record Admin.Comments.Index.Filters)
(record Admin.Comments.Index.Labels (posts List Table.Post.Post))
(record Admin.Comments.Index.Params
  (q Text = "")
  (sort Text = "created")
  (dir Text = "desc")
  (page Int = 1))
(union Admin.Comments.Index.Msg)
(record Admin.Comments.Index.Session (user Text) (role Table.User.Role))
(value Admin.Comments.Index.perPage : Int () 25)
(value Admin.Comments.Index.search : Text -> Condition Table.Comment.Comment (q)
  (cond or
    (cond contains (col Table.Comment.Comment author) (var q))
    (cond contains (col Table.Comment.Comment body) (var q))))
(value Admin.Comments.Index.chosen : Params -> Filters (params)
  (record Filters))
(value Admin.Comments.Index.filters : Filters -> List Filter (f) (list))
(value Admin.Comments.Index.filtered : List Filter -> Condition Table.Comment.Comment (fs)
  (cond and))
(value Admin.Comments.Index.listAt : Model -> Text -> Text -> Int -> Page (model sort dir n)
  (page-ref Admin.Comments.Index
    (record Params
      (q (field q (var model)))
      (sort (var sort))
      (dir (var dir))
      (page (var n)))))
(value Admin.Comments.Index.sorts : List { name: Text, asc: Order Table.Comment.Comment, desc: Order Table.Comment.Comment } ()
  (list
    (record
      (name "post")
      (asc (ord (col Table.Comment.Comment post) asc))
      (desc (ord (col Table.Comment.Comment post) desc)))
    (record
      (name "author")
      (asc (ord (col Table.Comment.Comment author) asc))
      (desc (ord (col Table.Comment.Comment author) desc)))
    (record
      (name "body")
      (asc (ord (col Table.Comment.Comment body) asc))
      (desc (ord (col Table.Comment.Comment body) desc)))
    (record
      (name "created")
      (asc (ord (col Table.Comment.Comment created) asc))
      (desc (ord (col Table.Comment.Comment created) desc)))))
(value Admin.Comments.Index.order : Text -> Text -> Order Table.Comment.Comment (sort dir)
  (match union (call (std List.find) (lambda (s : { name: Text, asc: Order Table.Comment.Comment, desc: Order Table.Comment.Comment }) (== : Text (field name (var s)) (var sort))) (global Admin.Comments.Index.sorts))
    (case Just (bind _m1 value : { name: Text, asc: Order Table.Comment.Comment, desc: Order Table.Comment.Comment })
      (let s : { name: Text, asc: Order Table.Comment.Comment, desc: Order Table.Comment.Comment }
        (var _m1)
        (if (== : Text (var dir) "asc")
          (field asc (var s))
          (field desc (var s)))))
    (case Nothing (ord (col Table.Comment.Comment created) desc))))
(value Admin.Comments.Index.toggle : Model -> Text -> Text (model sort)
  (if (&& (== : Text (field sort (var model)) (var sort)) (== : Text (field dir (var model)) "asc"))
    "desc"
    "asc"))
(value Admin.Comments.Index.load : Params -> Session -> Query Model (params session)
  (bind query admin : Bool
    (call (global Admin.Layout.isAdmin) (field user (var session)))
    (if (var admin)
      (let q : Text
        (call (std Text.slice) 0 200 (field q (var params)))
        (let f : Filters
          (call (global Admin.Comments.Index.chosen) (var params))
          (bind query count : Int
            (db-select Table.Comment.Comment
              (where
                (cond and
                  (call (global Admin.Comments.Index.search) (var q))
                  (call (global Admin.Comments.Index.filtered)
                    (call (global Admin.Comments.Index.filters) (var f)))))
              count)
            (let pages : Int
              (call (std Int.max)
                1
                (/
                  (- (+ (var count) (global Admin.Comments.Index.perPage)) 1)
                  (global Admin.Comments.Index.perPage)))
              (let page : Int
                (call (std Int.clamp)
                  (record (min 1) (max (var pages)))
                  (field page (var params)))
                (bind query rows : List Table.Comment.Comment
                  (db-select Table.Comment.Comment
                    (where
                      (cond and
                        (call (global Admin.Comments.Index.search) (var q))
                        (call (global Admin.Comments.Index.filtered)
                          (call (global Admin.Comments.Index.filters) (var f)))))
                    (order
                      (call (global Admin.Comments.Index.order)
                        (field sort (var params))
                        (field dir (var params))))
                    (limit (global Admin.Comments.Index.perPage))
                    (offset
                      (* (- (var page) 1) (global Admin.Comments.Index.perPage)))
                    all)
                  (bind query labels : Labels
                    (call (global Admin.Comments.Index.labelsOf) (var rows))
                    (pure query
                      (record Model
                        (rows (var rows))
                        (labels (var labels))
                        (q (var q))
                        (filters (var f))
                        (sort (field sort (var params)))
                        (dir (field dir (var params)))
                        (page (var page))
                        (pages (var pages))
                        (count (var count)))))))))))
      (not-found))))
(value Admin.Comments.Index.labelsOf : List Table.Comment.Comment -> Query Labels (rows)
  (bind query posts : List Table.Post.Post
    (db-select Table.Post.Post
      (where
        (cond in
          (col Table.Post.Post id)
          (call (std List.map)
            (lambda (row : Table.Comment.Comment) (field post (var row)))
            (var rows))))
      all)
    (pure query (record Labels (posts (var posts))))))
(value Admin.Comments.Index.postLabel : Labels -> Text -> Text (labels id)
  (match union (call (std List.find) (lambda (r : Table.Post.Post) (== : Text (field id (var r)) (var id))) (field posts (var labels)))
    (case Just (bind _m1 value : Table.Post.Post)
      (let r : Table.Post.Post (var _m1) (field slug (var r))))
    (case Nothing (var id))))
(value Admin.Comments.Index.view : Model -> Session -> Html Msg (model session)
  (comp Admin.Layout.Page
    (record (title "Comments"))
    (elem h1 (htext "Comments"))
    (elem al-stack (attr direction text "row") (attr gap text "sm")
      (elem form (attr method text "get") (attr action text "/admin/comment")
        (elem input
          (attr type text "search")
          (attr name text "q")
          (attr value text (field q (var model)))
          (attr aria-label text "Search"))
        (hfor f : Filter
          (call (global Admin.Comments.Index.filters)
            (field filters (var model)))
          (elem al-select (attr label text (field label (var f)))
            (elem label
              (hexpr text (field label (var f)))
              (elem select (attr name text (field name (var f)))
                (elem option
                  (attr value text "")
                  (attr selected bool (== : Text (field value (var f)) ""))
                  (htext "any"))
                (hfor o : { value: Text, label: Text, rows: Condition Table.Comment.Comment }
                  (field options (var f))
                  (elem option
                    (attr value text (field value (var o)))
                    (attr selected bool
                      (== : Text (field value (var o)) (field value (var f))))
                    (hexpr text (field label (var o)))))))))
        (elem input
          (attr type text "hidden")
          (attr name text "sort")
          (attr value text (field sort (var model))))
        (elem input
          (attr type text "hidden")
          (attr name text "dir")
          (attr value text (field dir (var model))))
        (elem al-button
          (attr type text "submit")
          (attr variant text "secondary")
          (elem button (attr type text "submit") (htext "Search"))))
      (elem al-button
        (elem a
          (attr href href
            (page-ref Admin.Comments.New
              (record Admin.Comments.New.Params (findPost ""))))
          (htext "New comment"))))
    (elem p (attr id text "count")
      (hif (== : Int (field count (var model)) 1)
        (hexpr text "1 row")
        (hexpr text
          (++ : Text (call (std Text.fromInt) (field count (var model)))
            " rows"))))
    (elem al-table
      (elem table
        (elem thead
          (elem tr
            (elem th (elem span (attr class text "sr-only") (htext "Choose")))
            (elem th
              (elem a
                (attr href href
                  (call (global Admin.Comments.Index.listAt)
                    (var model)
                    "post"
                    (call (global Admin.Comments.Index.toggle)
                      (var model)
                      "post")
                    1))
                (htext "Post")))
            (elem th
              (elem a
                (attr href href
                  (call (global Admin.Comments.Index.listAt)
                    (var model)
                    "author"
                    (call (global Admin.Comments.Index.toggle)
                      (var model)
                      "author")
                    1))
                (htext "Author")))
            (elem th
              (elem a
                (attr href href
                  (call (global Admin.Comments.Index.listAt)
                    (var model)
                    "body"
                    (call (global Admin.Comments.Index.toggle)
                      (var model)
                      "body")
                    1))
                (htext "Body")))
            (elem th
              (elem a
                (attr href href
                  (call (global Admin.Comments.Index.listAt)
                    (var model)
                    "created"
                    (call (global Admin.Comments.Index.toggle)
                      (var model)
                      "created")
                    1))
                (htext "Created")))))
        (elem tbody
          (hfor row : Table.Comment.Comment
            (field rows (var model))
            (elem tr
              (elem td
                (elem input
                  (attr type text "checkbox")
                  (attr name text "ids")
                  (attr form text "bulk")
                  (attr value text (field id (var row)))
                  (attr aria-label text
                    (++ : Text "Choose " (field author (var row))))))
              (elem td
                (elem a
                  (attr href href
                    (page-ref Admin.Posts.Show
                      (record Admin.Posts.Show.Params
                        (id (field post (var row))))))
                  (hexpr text
                    (call (global Admin.Comments.Index.postLabel)
                      (field labels (var model))
                      (field post (var row))))))
              (elem td
                (elem a
                  (attr href href
                    (page-ref Admin.Comments.Show
                      (record Admin.Comments.Show.Params
                        (id (field id (var row))))))
                  (hexpr text (field author (var row)))))
              (elem td (hexpr text (field body (var row))))
              (elem td
                (hexpr text
                  (call (std Time.format)
                    "Jan 2, 2006"
                    (field created (var row))))))))))
    (elem al-stack (attr direction text "row") (attr gap text "sm")
      (elem form
        (attr id text "bulk")
        (attr method text "get")
        (attr action text "/admin/comment/bulk")
        (elem al-button
          (attr type text "submit")
          (attr variant text "secondary")
          (elem button (attr type text "submit")
            (htext "Act on the chosen rows"))))
      (elem form
        (attr id text "bulk-page")
        (attr method text "get")
        (attr action text "/admin/comment/bulk")
        (hfor row : Table.Comment.Comment
          (field rows (var model))
          (elem input
            (attr type text "hidden")
            (attr name text "ids")
            (attr value text (field id (var row)))))
        (elem al-button
          (attr type text "submit")
          (attr variant text "secondary")
          (elem button (attr type text "submit")
            (htext "Act on all rows on this page")))))
    (elem al-pagination
      (attr role text "navigation")
      (attr aria-label text "Pages")
      (hif (> : Int (field page (var model)) 1)
        (elem a
          (attr slot text "prev")
          (attr href href
            (call (global Admin.Comments.Index.listAt)
              (var model)
              (field sort (var model))
              (field dir (var model))
              (- (field page (var model)) 1)))
          (attr rel text "prev")
          (htext "Previous"))
        (elem span (attr slot text "prev") (attr aria-disabled text "true")
          (htext "Previous")))
      (elem span
        (htext "Page ")
        (hexpr text (call (std Text.fromInt) (field page (var model))))
        (htext " of ")
        (hexpr text (call (std Text.fromInt) (field pages (var model)))))
      (hif (< : Int (field page (var model)) (field pages (var model)))
        (elem a
          (attr slot text "next")
          (attr href href
            (call (global Admin.Comments.Index.listAt)
              (var model)
              (field sort (var model))
              (field dir (var model))
              (+ (field page (var model)) 1)))
          (attr rel text "next")
          (htext "Next"))
        (elem span (attr slot text "next") (attr aria-disabled text "true")
          (htext "Next"))))))
(test "the list shows every row, newest first, and the labels of the rows they refer to" task
  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "email-1@example.com")
        (name "name-1")
        (passwordHash "passwordhash-1")
        (role (ctor Table.User.Role.Admin))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor Table.User.Role.Admin))))
      (bind task post1 : Text
        (db-insert Table.Post.Post
          (record
            (slug "slug-1")
            (title "title-1")
            (body "body-1")
            (published False)
            (author (var me))))
        (bind task comment1 : Text
          (db-insert Table.Comment.Comment
            (record (post (var post1)) (author "author-1") (body "body-1")))
          (bind task comment2 : Text
            (db-insert Table.Comment.Comment
              (record (post (var post1)) (author "author-2") (body "body-2")))
            (bind task post2 : Text
              (db-insert Table.Post.Post
                (record
                  (slug "slug-2")
                  (title "title-2")
                  (body "body-2")
                  (published False)
                  (author (var me))))
              (bind task page : { model: Model, session: App.Session, doc: Doc, notices: List Text }
                (test-get Admin.Comments.Index
                  (record Params (q "") (sort "created") (dir "desc") (page 1)))
                (pure task
                  (test-eq
                    (record
                      (rows
                        (call (std List.map)
                          (lambda (row : Table.Comment.Comment)
                            (field id (var row)))
                          (field rows (field model (var page)))))
                      (posts
                        (call (std List.length)
                          (field posts (field labels (field model (var page))))))
                      (postLabel
                        (call (global Admin.Comments.Index.postLabel)
                          (field labels (field model (var page)))
                          (var post1))))
                    (record
                      (rows (list (var comment2) (var comment1)))
                      (posts 1)
                      (postLabel "slug-1"))))))))))))
(test "sorting by author goes both ways" task
  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "email-1@example.com")
        (name "name-1")
        (passwordHash "passwordhash-1")
        (role (ctor Table.User.Role.Admin))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor Table.User.Role.Admin))))
      (bind task post1 : Text
        (db-insert Table.Post.Post
          (record
            (slug "slug-1")
            (title "title-1")
            (body "body-1")
            (published False)
            (author (var me))))
        (bind task comment1 : Text
          (db-insert Table.Comment.Comment
            (record (post (var post1)) (author "author-2") (body "body-1")))
          (bind task comment2 : Text
            (db-insert Table.Comment.Comment
              (record (post (var post1)) (author "author-1") (body "body-2")))
            (bind task up : { model: Model, session: App.Session, doc: Doc, notices: List Text }
              (test-get Admin.Comments.Index
                (record Params (q "") (sort "author") (dir "asc") (page 1)))
              (bind task down : { model: Model, session: App.Session, doc: Doc, notices: List Text }
                (test-get Admin.Comments.Index
                  (record Params (q "") (sort "author") (dir "desc") (page 1)))
                (pure task
                  (test-eq
                    (record
                      (up
                        (call (std List.map)
                          (lambda (row : Table.Comment.Comment)
                            (field id (var row)))
                          (field rows (field model (var up)))))
                      (down
                        (call (std List.map)
                          (lambda (row : Table.Comment.Comment)
                            (field id (var row)))
                          (field rows (field model (var down)))))
                      (toggles
                        (list
                          (call (global Admin.Comments.Index.toggle)
                            (field model (var up))
                            "author")
                          (call (global Admin.Comments.Index.toggle)
                            (field model (var down))
                            "author")
                          (call (global Admin.Comments.Index.toggle)
                            (field model (var up))
                            "post"))))
                    (record
                      (up (list (var comment2) (var comment1)))
                      (down (list (var comment1) (var comment2)))
                      (toggles (list "desc" "asc" "asc")))))))))))))
