        (passwordHash "passwordhash-1")
        (role (ctor Table.User.Role.Admin))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor Table.User.Role.Admin))))
      (bind task post1 : Text
        (db-insert Table.Post.Post
          (record
            (slug "slug-1")
            (title "title-1")
            (body "body-1")
            (published False)
            (author (var me))))
        (bind task post2 : Text
          (db-insert Table.Post.Post
            (record
              (slug "slug-2")
              (title "title-2")
              (body "body-2")
              (published False)
              (author (var me))))
          (bind task _
            (db-insert Table.Comment.Comment
              (record (post (var post2)) (author "author-1") (body "body-1")))
            (bind task _
              (test-get Admin.Posts.Delete (record Params (id (var post1))))
              (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
                (test-submit Admin.Posts.Delete.Confirm Remove (record Confirm))
                (bind task gone : Maybe Table.Post.Post
                  (db-get Table.Post.Post (var post1))
                  (bind task kept : Maybe Table.Post.Post
                    (db-get Table.Post.Post (var post2))
