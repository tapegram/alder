(module Posts.Show)
(record Posts.Show.Model
  (post Table.Post.Post)
  (body Html Never)
  (comments List Table.Comment.Comment))
(record Posts.Show.NewComment (author Text) (body Text))
(record Posts.Show.Params (slug Text))
(record Posts.Show.AddCommentParams (form NewComment))
(union Posts.Show.Msg (AddComment AddCommentParams))
(value Posts.Show.load : Params -> App.Session -> Query Model (params session)
  (bind query found : Maybe Table.Post.Post
    (call (global Table.Post.bySlug) (field slug (var params)))
    (match union (var found)
      (case Just (bind _m1 value : Table.Post.Post)
        (let post : Table.Post.Post
          (var _m1)
          (if (call (global Table.Post.visible) (field user (var session)) (var post))
            (bind query body : Html Never
              (cap Markdown.Markdown render (field body (var post)))
              (bind query comments : List Table.Comment.Comment
                (db-select Table.Comment.Comment
                  (where
                    (cond eq
                      (col Table.Comment.Comment post)
                      (field id (var post))))
                  (order (ord (col Table.Comment.Comment created) asc))
                  all)
                (pure query
                  (record Model
                    (post (var post))
                    (body (var body))
                    (comments (var comments))))))
            (not-found))))
      (case Nothing (not-found)))))
(value Posts.Show.update : Msg -> Model -> App.Session -> Task Nav (msg model session)
  (match union (var msg)
    (case AddComment (bind _m1 : AddCommentParams)
      (let p : AddCommentParams
        (var _m1)
        (if (field published (field post (var model)))
          (bind task _
            (db-insert Table.Comment.Comment
              (record
                (post (field id (field post (var model))))
                (author (field author (field form (var p))))
                (body (field body (field form (var p))))))
            (pure task
              (ctor Prelude.Nav.Redirect
                (record
                  (value
                    (page-ref Posts.Show
                      (record Params
                        (slug (field slug (field post (var model)))))))))))
          (not-found))))))
(value Posts.Show.view : Model -> App.Session -> Html Msg (model session)
  (comp Layout.Page
    (record (title (field title (field post (var model)))))
    (elem article
      (elem h1 (hexpr text (field title (field post (var model)))))
      (hif (field published (field post (var model)))
        (hexpr html (std Html.none))
        (elem al-alert (attr heading text "Draft") (attr role text "status")
          (htext "Only you can see this post.")))
      (elem div (attr class text "body") (hexpr html (field body (var model)))))
    (elem section (attr class text "comments")
      (elem h2 (htext "Comments"))
      (elem ul
        (hfor c : Table.Comment.Comment
          (field comments (var model))
          (elem li
            (elem p (attr class text "who") (hexpr text (field author (var c))))
            (elem p (hexpr text (field body (var c)))))))
      (hif (field published (field post (var model)))
        (elem al-card
          (form-el Posts.Show.AddComment
            (attr submit submit
              (ctor Posts.Show.Msg.AddComment (record AddCommentParams)))
            (elem al-alert
              (attr variant text "destructive")
              (attr role text "alert")
              (input Errors NewComment form))
            (input Input NewComment field=author label="Name" (wrap al-input))
            (input Textarea NewComment field=body label="Comment"
              (wrap al-textarea))
            (elem al-button (attr type text "submit")
              (elem button (attr type text "submit") (htext "Comment")))))
        (hexpr html (std Html.none))))
    (elem a
      (attr href href
        (page-ref Posts.Index (record Posts.Index.Params (page 1) (q ""))))
      (htext "All posts"))))
(test "a draft is not found for a reader" task
  (bind task author : Text
    (db-insert Table.User.User
      (record
        (email "author@example.com")
        (name "Author")
        (passwordHash "")
        (role (ctor Table.User.Role.Author))))
    (bind task reader : Text
      (db-insert Table.User.User
        (record
          (email "reader@example.com")
          (name "Reader")
          (passwordHash "")
          (role (ctor Table.User.Role.Reader))))
      (bind task _
        (db-insert Table.Post.Post
          (record
            (slug "draft")
            (title "Draft")
            (body "")
            (published False)
            (author (var author))))
        (bind task asReader : { value: Result Text Text, trace: List Text }
          (test-run
            (bind task m : Model
              (call (global Posts.Show.load)
                (record Params (slug "draft"))
                (record App.Session
                  (user (ctor Prelude.Maybe.Just (record (value (var reader)))))
                  (role (ctor Table.User.Role.Reader))))
              (pure task (field title (field post (var m))))))
          (bind task asNobody : { value: Result Text Text, trace: List Text }
            (test-run
              (bind task m : Model
                (call (global Posts.Show.load)
                  (record Params (slug "draft"))
                  (record App.Session
                    (user (ctor Prelude.Maybe.Nothing))
                    (role (ctor Table.User.Role.Reader))))
                (pure task (field title (field post (var m))))))
            (pure task
              (test-eq
                (record
                  (reader (field value (var asReader)))
                  (nobody (field value (var asNobody))))
                (record
                  (reader
                    (ctor Prelude.Result.Err (record (value "not found"))))
                  (nobody
                    (ctor Prelude.Result.Err (record (value "not found")))))))))))))
