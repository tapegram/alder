(module Admin.Users.Edit)
(record Admin.Users.Edit.Model (row Table.User.User))
(record Admin.Users.Edit.UserForm
  (email Text)
  (name Text)
  (role Table.User.Role))
(record Admin.Users.Edit.Params (id Text))
(record Admin.Users.Edit.SaveParams (form UserForm))
(union Admin.Users.Edit.Msg (Save SaveParams))
(record Admin.Users.Edit.Session (user Text) (role Table.User.Role))
(value Admin.Users.Edit.load : Params -> Session -> Query Model (params session)
  (bind query admin : Bool
    (call (global Admin.Layout.isAdmin) (field user (var session)))
    (if (var admin)
      (bind query found : Maybe Table.User.User
        (db-get Table.User.User (field id (var params)))
        (match union (var found)
          (case Just (bind _m1 value : Table.User.User)
            (let row : Table.User.User
              (var _m1)
              (pure query (record Model (row (var row))))))
          (case Nothing (not-found))))
      (not-found))))
(value Admin.Users.Edit.update : Msg -> Model -> Session -> Task Nav (msg model session)
  (match union (var msg)
    (case Save (bind _m1 : SaveParams)
      (let p : SaveParams
        (var _m1)
        (if (&& (== : Text (field user (var session)) (field id (field row (var model)))) (!= : Table.User.Role (field role (field form (var p))) (field role (field row (var model)))))
          (pure task
            (ctor Prelude.Nav.Reject
              (record (value "You cannot change your own role."))))
          (bind task emailTaken : Int
            (db-select Table.User.User
              (where
                (cond and
                  (cond eq
                    (col Table.User.User email)
                    (field email (field form (var p))))
                  (cond ne
                    (col Table.User.User id)
                    (field id (field row (var model))))))
              count)
            (if (> : Int (var emailTaken) 0)
              (pure task
                (ctor Prelude.Nav.Reject
                  (record (value "A user with this email exists."))))
              (bind task _
                (db-update Table.User.User
                  (field id (field row (var model)))
                  (lambda (row : Table.User.User)
                    (update (var row)
                      (email (field email (field form (var p))))
                      (name (field name (field form (var p))))
                      (role (field role (field form (var p)))))))
                (pure task
                  (ctor Prelude.Nav.Redirect
                    (record
                      (value
                        (page-ref Admin.Users.Show
                          (record Admin.Users.Show.Params
                            (id (field id (field row (var model))))))))))))))))))
(value Admin.Users.Edit.view : Model -> Session -> Html Msg (model session)
  (comp Admin.Layout.Page
    (record (title "Edit user"))
    (elem h1 (htext "Edit user"))
    (elem al-card
      (form-el Admin.Users.Edit.Save
        (attr submit submit
          (ctor Admin.Users.Edit.Msg.Save (record SaveParams)))
        (input Input UserForm field=email label="Email"
          (value (field email (field row (var model))))
          (wrap al-input))
        (input Input UserForm field=name label="Name"
          (value (field name (field row (var model))))
          (wrap al-input))
        (input Select UserForm field=role label="Role"
          (value (field role (field row (var model))))
          (wrap al-select))
        (elem al-alert
          (attr variant text "destructive")
          (attr role text "alert")
          (input Errors UserForm form))
        (elem al-button (attr type text "submit")
          (elem button (attr type text "submit") (htext "Save")))))
    (elem a
      (attr href href
        (page-ref Admin.Users.Show
          (record Admin.Users.Show.Params
            (id (field id (field row (var model)))))))
      (htext "Back"))))
