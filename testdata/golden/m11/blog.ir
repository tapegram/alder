(test "the row's own post is offered first when it sorts past the 50" task
  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "email-1@example.com")
        (name "name-1")
        (passwordHash "passwordhash-1")
        (role (ctor Table.User.Role.Admin))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor Table.User.Role.Admin))))
      (bind task post1 : Text
        (db-insert Table.Post.Post
          (record
            (slug "zz-1")
            (title "title-1")
            (body "body-1")
            (published False)
            (author (var me))))
        (bind task comment1 : Text
          (db-insert Table.Comment.Comment
            (record (post (var post1)) (author "author-1") (body "body-1")))
          (bind task _
            (all task
              (call (std List.map)
                (lambda (n : Int)
                  (db-insert Table.Post.Post
                    (record
                      (slug
                        (++ : Text "slug-" (call (std Text.fromInt) (var n))))
                      (title
                        (++ : Text "title-" (call (std Text.fromInt) (var n))))
                      (body
                        (++ : Text "body-" (call (std Text.fromInt) (var n))))
                      (published False)
                      (author (var me)))))
                (call (std List.range) 2 202)))
            (bind task page : { model: Model, session: App.Session, doc: Doc, notices: List Text }
              (test-get Admin.Comments.Edit
                (record Params (id (var comment1)) (findPost "")))
              (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
                (test-submit Admin.Comments.Edit.CommentForm Save
                  (record CommentForm
                    (post (field post (field row (field model (var page)))))
                    (author (field author (field row (field model (var page)))))
                    (body (field body (field row (field model (var page)))))))
                (bind task after : Maybe Table.Comment.Comment
                  (db-get Table.Comment.Comment (var comment1))
                  (pure task
                    (test-eq
                      (record
                        (answer (field answer (var r)))
                        (kept
                          (call (std Maybe.map)
                            (lambda (row : Table.Comment.Comment)
                              (field post (var row)))
                            (var after)))
                        (first
                          (call (std Maybe.map)
                            (lambda (o : Table.Post.Post) (field id (var o)))
                            (call (std List.head)
                              (field posts (field model (var page))))))
                        (once
                          (call (std List.length)
                            (call (std List.filter)
                              (lambda (o : Table.Post.Post)
                                (== : Text (field id (var o)) (var post1)))
                              (field posts (field model (var page))))))
                        (shown
                          (call (std List.length)
                            (field posts (field model (var page))))))
                      (record
                        (answer
                          (ctor Prelude.Answer.Redirected
                            (record
                              (value
                                (page-ref Admin.Comments.Show
                                  (record Admin.Comments.Show.Params
                                    (id (var comment1))))))))
                        (kept
                          (ctor Prelude.Maybe.Just (record (value (var post1)))))
                        (first
                          (ctor Prelude.Maybe.Just (record (value (var post1)))))
                        (once 1)
                        (shown 51)))))))))))))
