        (role (ctor Table.User.Role.Author))))
    (bind task _
      (db-insert Table.Post.Post
        (record
          (slug "first")
          (title "First")
          (body "")
          (published True)
          (author (var author))))
      (bind task _
        (db-insert Table.Post.Post
          (record
            (slug "draft")
            (title "Draft")
            (body "")
            (published False)
            (author (var author))))
        (bind task _
          (db-insert Table.Post.Post
            (record
              (slug "second")
              (title "Second")
              (body "")
              (published True)
              (author (var author))))
