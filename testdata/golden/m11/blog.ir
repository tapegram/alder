                                (rows (var rows)))
                              (record
                                (answer
                                  (ctor Prelude.Answer.FormRejected
                                    (record
                                      (value
                                        (list
                                          (record
                                            (field "post")
                                            (message
                                              "must be one of the options")))))))
                                (rows 0)))))))))))))))))
