(module Admin.Comments.Show)
(record Admin.Comments.Show.Model (row Table.Comment.Comment) (labels Labels))
(record Admin.Comments.Show.Labels (posts List Table.Post.Post))
(record Admin.Comments.Show.Confirm)
(record Admin.Comments.Show.Params (id Text))
(record Admin.Comments.Show.RemoveParams (form Confirm))
(union Admin.Comments.Show.Msg (Remove RemoveParams))
(record Admin.Comments.Show.Session (user Text) (role Table.User.Role))
(value Admin.Comments.Show.load : Params -> Session -> Query Model (params session)
  (bind query admin : Bool
    (call (global Admin.Layout.isAdmin) (field user (var session)))
    (if (var admin)
      (bind query found : Maybe Table.Comment.Comment
        (db-get Table.Comment.Comment (field id (var params)))
        (match union (var found)
          (case Just (bind _m1 value : Table.Comment.Comment)
            (let row : Table.Comment.Comment
              (var _m1)
              (bind query labels : Labels
                (call (global Admin.Comments.Show.labelsOf) (list (var row)))
                (pure query
                  (record Model (row (var row)) (labels (var labels)))))))
          (case Nothing (not-found))))
      (not-found))))
(value Admin.Comments.Show.labelsOf : List Table.Comment.Comment -> Query Labels (rows)
  (bind query posts : List Table.Post.Post
    (db-select Table.Post.Post
      (where
        (cond in
          (col Table.Post.Post id)
          (call (std List.map)
            (lambda (row : Table.Comment.Comment) (field post (var row)))
            (var rows))))
      all)
    (pure query (record Labels (posts (var posts))))))
(value Admin.Comments.Show.postLabel : Labels -> Text -> Text (labels id)
  (match union (call (std List.find) (lambda (r : Table.Post.Post) (== : Text (field id (var r)) (var id))) (field posts (var labels)))
    (case Just (bind _m1 value : Table.Post.Post)
      (let r : Table.Post.Post (var _m1) (field slug (var r))))
    (case Nothing (var id))))
(value Admin.Comments.Show.blockers : Model -> Int (model) 0)
(value Admin.Comments.Show.update : Msg -> Model -> Session -> Task Nav (msg model session)
  (match union (var msg)
    (case Remove (bind _m1 : RemoveParams)
      (let p : RemoveParams
        (var _m1)
        (bind task _
          (db-delete Table.Comment.Comment (field id (field row (var model))))
          (pure task
            (ctor Prelude.Nav.Redirect
              (record
                (value
                  (page-ref Admin.Comments.Index
                    (record Admin.Comments.Index.Params
                      (q "")
                      (sort "created")
                      (dir "desc")
                      (page 1))))))))))))
(value Admin.Comments.Show.view : Model -> Session -> Html Msg (model session)
  (comp Admin.Layout.Page
    (record (title "Comment"))
    (elem h1 (htext "Comment"))
    (elem al-card
      (elem dl (attr id text "fields")
        (elem dt (htext "Id"))
        (elem dd (hexpr text (field id (field row (var model)))))
        (elem dt (htext "Post"))
        (elem dd
          (elem a
            (attr href href
              (page-ref Admin.Posts.Show
                (record Admin.Posts.Show.Params
                  (id (field post (field row (var model)))))))
            (hexpr text
              (call (global Admin.Comments.Show.postLabel)
                (field labels (var model))
                (field post (field row (var model)))))))
        (elem dt (htext "Author"))
        (elem dd (hexpr text (field author (field row (var model)))))
        (elem dt (htext "Body"))
        (elem dd (hexpr text (field body (field row (var model)))))
        (elem dt (htext "Created"))
        (elem dd
          (hexpr text
            (call (std Time.format)
              "Jan 2, 2006"
              (field created (field row (var model)))))))
      (elem div (attr slot text "actions")
        (elem al-button
          (elem a
            (attr href href
              (page-ref Admin.Comments.Edit
                (record Admin.Comments.Edit.Params
                  (id (field id (field row (var model))))
                  (findPost ""))))
            (htext "Edit")))
        (elem al-button (attr variant text "destructive")
          (elem button
            (attr type text "button")
            (attr commandfor text "delete-dialog")
            (attr command text "show-modal")
            (htext "Delete")))))
    (elem al-dialog
      (attr heading text "Delete this comment?")
      (attr dismissible bool True)
      (elem dialog
        (attr id text "delete-dialog")
        (attr aria-labelledby text "delete-dialog-heading")
        (attr data-preserve-attr text "open")
        (attr closedby text "any")
        (elem form (attr method text "dialog")
          (elem button
            (attr type text "submit")
            (attr aria-label text "Close Delete this comment?")
            (htext "×")))
        (elem h2
          (attr slot text "header")
          (attr id text "delete-dialog-heading")
          (hexpr text "Delete this comment?"))
        (elem dl)
        (form-el Admin.Comments.Show.Remove
          (attr id text "delete")
          (attr submit submit
            (ctor Admin.Comments.Show.Msg.Remove (record RemoveParams)))
          (elem al-alert
            (attr variant text "destructive")
            (attr role text "alert")
            (input Errors Confirm form))
          (hif (> : Int (call (global Admin.Comments.Show.blockers) (var model)) 0)
            (elem p
              (htext "It cannot be deleted while other rows refer to it."))
            (elem al-button
              (attr variant text "destructive")
              (attr type text "submit")
              (elem button (attr type text "submit") (htext "Delete")))))
        (elem div (attr slot text "actions")
          (elem a
            (attr href href
              (page-ref Admin.Comments.Delete
                (record Admin.Comments.Delete.Params
                  (id (field id (field row (var model)))))))
            (htext "See the details")))))
    (elem a
      (attr href href
        (page-ref Admin.Comments.Index
          (record Admin.Comments.Index.Params
            (q "")
            (sort "created")
            (dir "desc")
            (page 1))))
      (htext "All comments"))))
