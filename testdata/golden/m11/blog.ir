(module Admin.Index)
(record Admin.Index.Card
  (key Text)
  (title Text)
  (href Page)
  (count Int)
  (rows List { label: Text, href: Page }))
(record Admin.Index.Model (cards List Card))
(record Admin.Index.Params)
(union Admin.Index.Msg)
(record Admin.Index.Session (user Text) (role Table.User.Role))
(value Admin.Index.recent : Int () 5)
(value Admin.Index.load : Params -> Session -> Query Model (params session)
  (bind query admin : Bool
    (call (global Admin.Layout.isAdmin) (field user (var session)))
    (if (var admin)
      (bind query comments : List Table.Comment.Comment
        (db-select Table.Comment.Comment
          (order (ord (col Table.Comment.Comment created) desc))
          (limit (global Admin.Index.recent))
          all)
        (bind query commentCount : Int
          (db-select Table.Comment.Comment count)
          (bind query posts : List Table.Post.Post
            (db-select Table.Post.Post
              (order (ord (col Table.Post.Post created) desc))
              (limit (global Admin.Index.recent))
              all)
            (bind query postCount : Int
              (db-select Table.Post.Post count)
              (bind query users : List Table.User.User
                (db-select Table.User.User
                  (order (ord (col Table.User.User created) desc))
                  (limit (global Admin.Index.recent))
                  all)
                (bind query userCount : Int
                  (db-select Table.User.User count)
                  (pure query
                    (record Model
                      (cards
                        (list
                          (record Card
                            (key "comments")
                            (title "Comments")
                            (href
                              (page-ref Admin.Comments.Index
                                (record Admin.Comments.Index.Params
                                  (q "")
                                  (sort "created")
                                  (dir "desc")
                                  (page 1))))
                            (count (var commentCount))
                            (rows
                              (call (std List.map)
                                (lambda (row : Table.Comment.Comment)
                                  (record
                                    (label (field author (var row)))
                                    (href
                                      (page-ref Admin.Comments.Show
                                        (record Admin.Comments.Show.Params
                                          (id (field id (var row))))))))
                                (var comments))))
                          (record Card
                            (key "posts")
                            (title "Posts")
                            (href
                              (page-ref Admin.Posts.Index
                                (record Admin.Posts.Index.Params
                                  (q "")
                                  (published "")
                                  (sort "created")
                                  (dir "desc")
                                  (page 1))))
                            (count (var postCount))
                            (rows
                              (call (std List.map)
                                (lambda (row : Table.Post.Post)
                                  (record
                                    (label (field slug (var row)))
                                    (href
                                      (page-ref Admin.Posts.Show
                                        (record Admin.Posts.Show.Params
                                          (id (field id (var row))))))))
                                (var posts))))
                          (record Card
                            (key "users")
                            (title "Users")
                            (href
                              (page-ref Admin.Users.Index
                                (record Admin.Users.Index.Params
                                  (q "")
                                  (role "")
                                  (sort "created")
                                  (dir "desc")
                                  (page 1))))
                            (count (var userCount))
                            (rows
                              (call (std List.map)
                                (lambda (row : Table.User.User)
                                  (record
                                    (label (field email (var row)))
                                    (href
                                      (page-ref Admin.Users.Show
                                        (record Admin.Users.Show.Params
                                          (id (field id (var row))))))))
                                (var users))))))))))))))
      (not-found))))
(value Admin.Index.view : Model -> Session -> Html Msg (model session)
  (comp Admin.Layout.Page
    (record (title "Dashboard"))
    (elem h1 (htext "Admin"))
    (elem al-stack (attr gap text "md")
      (hfor card : Card
        (field cards (var model))
        (elem al-card (attr id text (field key (var card)))
          (elem h2 (attr slot text "header")
            (elem a (attr href href (field href (var card)))
              (hexpr text (field title (var card))))
            (htext " ")
            (elem al-badge (attr variant text "secondary")
              (hexpr text (call (std Text.fromInt) (field count (var card))))))
          (elem ul
            (hfor row : { label: Text, href: Page }
              (field rows (var card))
              (elem li
                (elem a (attr href href (field href (var row)))
                  (hexpr text (field label (var row))))))))))))
