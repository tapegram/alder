              (record
                (answer
                  (ctor Prelude.Answer.Redirected
                    (record
                      (value
                        (page-ref Posts.Index
                          (record Posts.Index.Params (page 1) (q "")))))))
                (user (ctor Prelude.Maybe.Just (record (value (var me)))))
                (role (ctor Table.User.Role.Author))
                (title (ctor Prelude.Maybe.Just (record (value "Blog"))))))))))))
(module Markdown)
(module Posts.Index)
(record Posts.Index.Model
  (page Int)
  (q Text)
  (posts List Table.Post.Post)
  (hasMore Bool)
  (canWrite Bool))
(record Posts.Index.SearchForm (q Text))
(record Posts.Index.Params (page Int = 1) (q Text = ""))
(record Posts.Index.SearchParams (form SearchForm))
(union Posts.Index.Msg (Search SearchParams))
(value Posts.Index.perPage : Int () 10)
(value Posts.Index.lastPage : Int () 1000000)
(value Posts.Index.load : Params -> App.Session -> Query Model (params session)
  (let page : Int
    (if (< : Int (field page (var params)) 1)
      1
      (if (> : Int (field page (var params)) (global Posts.Index.lastPage))
        (global Posts.Index.lastPage)
        (field page (var params))))
    (let q : Text
      (call (std Text.slice)
        0
        100
        (call (std Text.trim) (field q (var params))))
      (let matching : Condition Table.Post.Post
        (if (call (std Text.isEmpty) (var q))
          (cond and)
          (cond or
            (cond contains (col Table.Post.Post title) (var q))
            (cond contains (col Table.Post.Post body) (var q))))
        (bind query found : List Table.Post.Post
          (db-select Table.Post.Post
            (where (cond eq (col Table.Post.Post published) True))
            (where (var matching))
            (order (ord (col Table.Post.Post created) desc))
            (limit (+ (global Posts.Index.perPage) 1))
            (offset (* (- (var page) 1) (global Posts.Index.perPage)))
            all)
          (let canWrite : Bool
            (== : Table.User.Role (field role (var session))
              (ctor Table.User.Role.Author))
            (pure query
              (record Model
                (page (var page))
                (q (var q))
                (posts
                  (call (std List.take)
                    (global Posts.Index.perPage)
                    (var found)))
                (hasMore
                  (> : Int (call (std List.length) (var found))
                    (global Posts.Index.perPage)))
                (canWrite (var canWrite))))))))))
(value Posts.Index.update : Msg -> Model -> App.Session -> Task Nav (msg model session)
  (match union (var msg)
    (case Search (bind _m1 : SearchParams)
      (let p : SearchParams
        (var _m1)
        (pure task
          (ctor Prelude.Nav.Redirect
            (record
              (value
                (page-ref Posts.Index
                  (record Params (page 1) (q (field q (field form (var p))))))))))))))
(value Posts.Index.view : Model -> App.Session -> Html Msg (model session)
  (comp Layout.Page
    (record (title "Blog"))
    (elem h1 (htext "Blog"))
    (form-el Posts.Index.Search
      (attr submit submit (ctor Posts.Index.Msg.Search (record SearchParams)))
      (attr class text "search")
      (input Input SearchForm field=q label="Search"
        (value (field q (var model)))
        (wrap al-input))
      (elem al-alert (attr variant text "destructive") (attr role text "alert")
        (input Errors SearchForm form))
      (elem al-button (attr type text "submit") (attr variant text "secondary")
        (elem button (attr type text "submit") (htext "Search"))))
    (hif (call (std List.isEmpty) (field posts (var model)))
      (elem p (attr class text "empty")
        (htext "No posts")
        (hif (call (std Text.isEmpty) (field q (var model)))
          (hexpr text "")
          (hexpr text
            (++ : Text (++ : Text " match “" (field q (var model))) "”")))
        (htext "."))
      (elem ul (attr class text "posts")
        (hfor post : Table.Post.Post
          (field posts (var model))
          (elem li
            (elem a
              (attr href href
                (page-ref Posts.Show
                  (record Posts.Show.Params (slug (field slug (var post))))))
              (hexpr text (field title (var post))))
            (elem span (attr class text "date")
              (hexpr text
                (call (std Time.format)
                  "Jan 2, 2006"
                  (field created (var post)))))))))
    (elem al-pagination
      (attr role text "navigation")
      (attr aria-label text "Pages")
      (hif (> : Int (field page (var model)) 1)
        (elem a
          (attr slot text "prev")
          (attr href href
            (page-ref Posts.Index
              (record Params
                (page (- (field page (var model)) 1))
                (q (field q (var model))))))
          (attr rel text "prev")
          (htext "Newer"))
        (elem span (attr slot text "prev") (attr aria-disabled text "true")
          (htext "Newer")))
      (elem span
        (htext "Page ")
        (hexpr text (call (std Text.fromInt) (field page (var model)))))
      (hif (field hasMore (var model))
        (elem a
          (attr slot text "next")
          (attr href href
            (page-ref Posts.Index
              (record Params
                (page (+ (field page (var model)) 1))
                (q (field q (var model))))))
          (attr rel text "next")
          (htext "Older"))
        (elem span (attr slot text "next") (attr aria-disabled text "true")
          (htext "Older"))))
    (hmatch union (field user (var session))
      (case Just
        (elem div (attr class text "account")
          (hif (field canWrite (var model))
            (elem a (attr href href (page-ref Write (record Write.Params)))
              (htext "Write"))
            (hexpr html (std Html.none)))
          (htext " ")
          (elem al-button (attr variant text "outline") (attr size text "sm")
            (elem button
              (attr type text "button")
              (attr click click (ctor App.Msg.Logout))
              (htext "Log out")))))
      (case Nothing
        (elem p
          (elem a
            (attr href href (page-ref Auth.Login (record Auth.Login.Params)))
            (htext "Log in")))))))
(test "the front page lists only published posts, newest first" task
  (bind task author : Text
    (db-insert Table.User.User
      (record
        (email "author@example.com")
        (name "Author")
