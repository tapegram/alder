(module Admin.Posts.Index)
(record Admin.Posts.Index.Model
  (rows List Table.Post.Post)
  (labels Labels)
  (q Text)
  (filters Filters)
  (sort Text)
  (dir Text)
  (page Int)
  (pages Int)
  (count Int))
(record Admin.Posts.Index.Filter
  (name Text)
  (label Text)
  (value Text)
  (options List { value: Text, label: Text, rows: Condition Table.Post.Post }))
(record Admin.Posts.Index.Filters (published Text))
(record Admin.Posts.Index.Labels (authors List Table.User.User))
(record Admin.Posts.Index.Params
  (q Text = "")
  (published Text = "")
  (sort Text = "created")
  (dir Text = "desc")
  (page Int = 1))
(union Admin.Posts.Index.Msg)
(record Admin.Posts.Index.Session (user Text) (role Table.User.Role))
(value Admin.Posts.Index.perPage : Int () 25)
(value Admin.Posts.Index.search : Text -> Condition Table.Post.Post (q)
  (cond or
    (cond contains (col Table.Post.Post slug) (var q))
    (cond contains (col Table.Post.Post title) (var q))
    (cond contains (col Table.Post.Post body) (var q))))
(value Admin.Posts.Index.chosen : Params -> Filters (params)
  (record Filters (published (field published (var params)))))
(value Admin.Posts.Index.filters : Filters -> List Filter (f)
  (list
    (record Filter
      (name "published")
      (label "Published")
      (value (field published (var f)))
      (options
        (list
          (record
            (value "yes")
            (label "yes")
            (rows (cond eq (col Table.Post.Post published) True)))
          (record
            (value "no")
            (label "no")
            (rows (cond eq (col Table.Post.Post published) False))))))))
(value Admin.Posts.Index.filtered : List Filter -> Condition Table.Post.Post (fs)
  (cond and
    (value
      (call (std List.map)
        (lambda (f : Filter)
          (match union (call (std List.find) (lambda (o : { value: Text, label: Text, rows: Condition Table.Post.Post }) (== : Text (field value (var o)) (field value (var f)))) (field options (var f)))
            (case Just (bind _m1 value : { value: Text, label: Text, rows: Condition Table.Post.Post })
              (let o : { value: Text, label: Text, rows: Condition Table.Post.Post }
                (var _m1)
                (field rows (var o))))
            (case Nothing (cond and))))
        (var fs)))))
(value Admin.Posts.Index.listAt : Model -> Text -> Text -> Int -> Page (model sort dir n)
  (page-ref Admin.Posts.Index
    (record Params
      (q (field q (var model)))
      (published (field published (field filters (var model))))
      (sort (var sort))
      (dir (var dir))
      (page (var n)))))
(value Admin.Posts.Index.sorts : List { name: Text, asc: Order Table.Post.Post, desc: Order Table.Post.Post } ()
  (list
    (record
      (name "slug")
      (asc (ord (col Table.Post.Post slug) asc))
      (desc (ord (col Table.Post.Post slug) desc)))
    (record
      (name "title")
      (asc (ord (col Table.Post.Post title) asc))
      (desc (ord (col Table.Post.Post title) desc)))
    (record
      (name "body")
      (asc (ord (col Table.Post.Post body) asc))
      (desc (ord (col Table.Post.Post body) desc)))
    (record
      (name "published")
      (asc (ord (col Table.Post.Post published) asc))
      (desc (ord (col Table.Post.Post published) desc)))
    (record
      (name "author")
      (asc (ord (col Table.Post.Post author) asc))
      (desc (ord (col Table.Post.Post author) desc)))
    (record
      (name "created")
      (asc (ord (col Table.Post.Post created) asc))
      (desc (ord (col Table.Post.Post created) desc)))))
(value Admin.Posts.Index.order : Text -> Text -> Order Table.Post.Post (sort dir)
  (match union (call (std List.find) (lambda (s : { name: Text, asc: Order Table.Post.Post, desc: Order Table.Post.Post }) (== : Text (field name (var s)) (var sort))) (global Admin.Posts.Index.sorts))
    (case Just (bind _m1 value : { name: Text, asc: Order Table.Post.Post, desc: Order Table.Post.Post })
      (let s : { name: Text, asc: Order Table.Post.Post, desc: Order Table.Post.Post }
        (var _m1)
        (if (== : Text (var dir) "asc")
          (field asc (var s))
          (field desc (var s)))))
    (case Nothing (ord (col Table.Post.Post created) desc))))
(value Admin.Posts.Index.toggle : Model -> Text -> Text (model sort)
  (if (&& (== : Text (field sort (var model)) (var sort)) (== : Text (field dir (var model)) "asc"))
    "desc"
    "asc"))
(value Admin.Posts.Index.load : Params -> Session -> Query Model (params session)
  (bind query admin : Bool
    (call (global Admin.Layout.isAdmin) (field user (var session)))
    (if (var admin)
      (let q : Text
        (call (std Text.slice) 0 200 (field q (var params)))
        (let f : Filters
          (call (global Admin.Posts.Index.chosen) (var params))
          (bind query count : Int
            (db-select Table.Post.Post
              (where
                (cond and
                  (call (global Admin.Posts.Index.search) (var q))
                  (call (global Admin.Posts.Index.filtered)
                    (call (global Admin.Posts.Index.filters) (var f)))))
              count)
            (let pages : Int
              (call (std Int.max)
                1
                (/
                  (- (+ (var count) (global Admin.Posts.Index.perPage)) 1)
                  (global Admin.Posts.Index.perPage)))
              (let page : Int
                (call (std Int.clamp)
                  (record (min 1) (max (var pages)))
                  (field page (var params)))
                (bind query rows : List Table.Post.Post
                  (db-select Table.Post.Post
                    (where
                      (cond and
                        (call (global Admin.Posts.Index.search) (var q))
                        (call (global Admin.Posts.Index.filtered)
                          (call (global Admin.Posts.Index.filters) (var f)))))
                    (order
                      (call (global Admin.Posts.Index.order)
                        (field sort (var params))
                        (field dir (var params))))
                    (limit (global Admin.Posts.Index.perPage))
                    (offset
                      (* (- (var page) 1) (global Admin.Posts.Index.perPage)))
                    all)
                  (bind query labels : Labels
                    (call (global Admin.Posts.Index.labelsOf) (var rows))
                    (pure query
                      (record Model
                        (rows (var rows))
                        (labels (var labels))
                        (q (var q))
                        (filters (var f))
                        (sort (field sort (var params)))
                        (dir (field dir (var params)))
                        (page (var page))
                        (pages (var pages))
                        (count (var count)))))))))))
      (not-found))))
(value Admin.Posts.Index.labelsOf : List Table.Post.Post -> Query Labels (rows)
  (bind query authors : List Table.User.User
    (db-select Table.User.User
      (where
        (cond in
          (col Table.User.User id)
          (call (std List.map)
            (lambda (row : Table.Post.Post) (field author (var row)))
            (var rows))))
      all)
    (pure query (record Labels (authors (var authors))))))
(value Admin.Posts.Index.authorLabel : Labels -> Text -> Text (labels id)
  (match union (call (std List.find) (lambda (r : Table.User.User) (== : Text (field id (var r)) (var id))) (field authors (var labels)))
    (case Just (bind _m1 value : Table.User.User)
      (let r : Table.User.User (var _m1) (field email (var r))))
    (case Nothing (var id))))
(value Admin.Posts.Index.view : Model -> Session -> Html Msg (model session)
  (comp Admin.Layout.Page
    (record (title "Posts"))
    (elem h1 (htext "Posts"))
    (elem al-stack (attr direction text "row") (attr gap text "sm")
      (elem form (attr method text "get") (attr action text "/admin/post")
        (elem input
          (attr type text "search")
          (attr name text "q")
          (attr value text (field q (var model)))
          (attr aria-label text "Search"))
        (hfor f : Filter
          (call (global Admin.Posts.Index.filters) (field filters (var model)))
          (elem al-select (attr label text (field label (var f)))
            (elem label
              (hexpr text (field label (var f)))
              (elem select (attr name text (field name (var f)))
                (elem option
                  (attr value text "")
                  (attr selected bool (== : Text (field value (var f)) ""))
                  (htext "any"))
                (hfor o : { value: Text, label: Text, rows: Condition Table.Post.Post }
                  (field options (var f))
                  (elem option
                    (attr value text (field value (var o)))
                    (attr selected bool
                      (== : Text (field value (var o)) (field value (var f))))
                    (hexpr text (field label (var o)))))))))
        (elem input
          (attr type text "hidden")
          (attr name text "sort")
          (attr value text (field sort (var model))))
        (elem input
          (attr type text "hidden")
          (attr name text "dir")
          (attr value text (field dir (var model))))
        (elem al-button
          (attr type text "submit")
          (attr variant text "secondary")
          (elem button (attr type text "submit") (htext "Search"))))
      (elem al-button
        (elem a
          (attr href href
            (page-ref Admin.Posts.New
              (record Admin.Posts.New.Params (findAuthor ""))))
          (htext "New post"))))
    (elem p (attr id text "count")
      (hif (== : Int (field count (var model)) 1)
        (hexpr text "1 row")
        (hexpr text
          (++ : Text (call (std Text.fromInt) (field count (var model)))
            " rows"))))
    (elem al-table
      (elem table
        (elem thead
          (elem tr
            (elem th (elem span (attr class text "sr-only") (htext "Choose")))
            (elem th
              (elem a
                (attr href href
                  (call (global Admin.Posts.Index.listAt)
                    (var model)
                    "slug"
                    (call (global Admin.Posts.Index.toggle) (var model) "slug")
                    1))
                (htext "Slug")))
            (elem th
              (elem a
                (attr href href
                  (call (global Admin.Posts.Index.listAt)
                    (var model)
                    "title"
                    (call (global Admin.Posts.Index.toggle) (var model) "title")
                    1))
                (htext "Title")))
            (elem th
              (elem a
                (attr href href
                  (call (global Admin.Posts.Index.listAt)
                    (var model)
                    "body"
                    (call (global Admin.Posts.Index.toggle) (var model) "body")
                    1))
                (htext "Body")))
            (elem th
              (elem a
                (attr href href
                  (call (global Admin.Posts.Index.listAt)
                    (var model)
                    "published"
                    (call (global Admin.Posts.Index.toggle)
                      (var model)
                      "published")
                    1))
                (htext "Published")))
            (elem th
              (elem a
                (attr href href
                  (call (global Admin.Posts.Index.listAt)
                    (var model)
                    "author"
                    (call (global Admin.Posts.Index.toggle)
                      (var model)
                      "author")
                    1))
                (htext "Author")))
            (elem th
              (elem a
                (attr href href
                  (call (global Admin.Posts.Index.listAt)
                    (var model)
                    "created"
                    (call (global Admin.Posts.Index.toggle)
                      (var model)
                      "created")
                    1))
                (htext "Created")))))
        (elem tbody
          (hfor row : Table.Post.Post
            (field rows (var model))
            (elem tr
              (elem td
                (elem input
                  (attr type text "checkbox")
                  (attr name text "ids")
                  (attr form text "bulk")
                  (attr value text (field id (var row)))
                  (attr aria-label text
                    (++ : Text "Choose " (field slug (var row))))))
              (elem td
                (elem a
                  (attr href href
                    (page-ref Admin.Posts.Show
                      (record Admin.Posts.Show.Params (id (field id (var row))))))
                  (hexpr text (field slug (var row)))))
              (elem td (hexpr text (field title (var row))))
              (elem td (hexpr text (field body (var row))))
              (elem td
                (hif (field published (var row))
                  (elem al-badge (htext "Yes"))
                  (elem al-badge (attr variant text "secondary") (htext "No"))))
              (elem td
                (elem a
                  (attr href href
                    (page-ref Admin.Users.Show
                      (record Admin.Users.Show.Params
                        (id (field author (var row))))))
                  (hexpr text
                    (call (global Admin.Posts.Index.authorLabel)
                      (field labels (var model))
                      (field author (var row))))))
              (elem td
                (hexpr text
                  (call (std Time.format)
                    "Jan 2, 2006"
                    (field created (var row))))))))))
    (elem al-stack (attr direction text "row") (attr gap text "sm")
      (elem form
        (attr id text "bulk")
        (attr method text "get")
        (attr action text "/admin/post/bulk")
        (elem al-button
          (attr type text "submit")
          (attr variant text "secondary")
          (elem button (attr type text "submit")
            (htext "Act on the chosen rows"))))
      (elem form
        (attr id text "bulk-page")
        (attr method text "get")
        (attr action text "/admin/post/bulk")
        (hfor row : Table.Post.Post
          (field rows (var model))
          (elem input
            (attr type text "hidden")
            (attr name text "ids")
            (attr value text (field id (var row)))))
        (elem al-button
          (attr type text "submit")
          (attr variant text "secondary")
          (elem button (attr type text "submit")
            (htext "Act on all rows on this page")))))
    (elem al-pagination
      (attr role text "navigation")
      (attr aria-label text "Pages")
      (hif (> : Int (field page (var model)) 1)
        (elem a
          (attr slot text "prev")
          (attr href href
            (call (global Admin.Posts.Index.listAt)
              (var model)
              (field sort (var model))
              (field dir (var model))
              (- (field page (var model)) 1)))
          (attr rel text "prev")
          (htext "Previous"))
        (elem span (attr slot text "prev") (attr aria-disabled text "true")
          (htext "Previous")))
      (elem span
        (htext "Page ")
        (hexpr text (call (std Text.fromInt) (field page (var model))))
        (htext " of ")
        (hexpr text (call (std Text.fromInt) (field pages (var model)))))
      (hif (< : Int (field page (var model)) (field pages (var model)))
        (elem a
          (attr slot text "next")
          (attr href href
            (call (global Admin.Posts.Index.listAt)
              (var model)
              (field sort (var model))
              (field dir (var model))
              (+ (field page (var model)) 1)))
          (attr rel text "next")
          (htext "Next"))
        (elem span (attr slot text "next") (attr aria-disabled text "true")
          (htext "Next"))))))
(test "the list shows every row, newest first, and the labels of the rows they refer to" task
  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "email-1@example.com")
        (name "name-1")
        (passwordHash "passwordhash-1")
        (role (ctor Table.User.Role.Admin))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor Table.User.Role.Admin))))
      (bind task post1 : Text
        (db-insert Table.Post.Post
          (record
            (slug "slug-1")
            (title "title-1")
            (body "body-1")
            (published False)
            (author (var me))))
        (bind task post2 : Text
          (db-insert Table.Post.Post
            (record
              (slug "slug-2")
              (title "title-2")
              (body "body-2")
              (published False)
              (author (var me))))
          (bind task user2 : Text
            (db-insert Table.User.User
              (record
                (email "email-2@example.com")
                (name "name-2")
                (passwordHash "passwordhash-2")
                (role (ctor Table.User.Role.Reader))))
            (bind task page : { model: Model, session: App.Session, doc: Doc, notices: List Text }
              (test-get Admin.Posts.Index
                (record Params
                  (q "")
                  (published "")
                  (sort "created")
                  (dir "desc")
                  (page 1)))
              (pure task
                (test-eq
                  (record
                    (rows
                      (call (std List.map)
                        (lambda (row : Table.Post.Post) (field id (var row)))
                        (field rows (field model (var page)))))
                    (authors
                      (call (std List.length)
                        (field authors (field labels (field model (var page))))))
                    (authorLabel
                      (call (global Admin.Posts.Index.authorLabel)
                        (field labels (field model (var page)))
                        (var me))))
                  (record
                    (rows (list (var post2) (var post1)))
                    (authors 1)
                    (authorLabel "email-1@example.com")))))))))))
(test "sorting by slug goes both ways" task
  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "email-1@example.com")
        (name "name-1")
        (passwordHash "passwordhash-1")
        (role (ctor Table.User.Role.Admin))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor Table.User.Role.Admin))))
      (bind task post1 : Text
        (db-insert Table.Post.Post
          (record
            (slug "slug-2")
            (title "title-1")
            (body "body-1")
            (published False)
            (author (var me))))
        (bind task post2 : Text
          (db-insert Table.Post.Post
            (record
              (slug "slug-1")
              (title "title-2")
              (body "body-2")
              (published False)
              (author (var me))))
          (bind task up : { model: Model, session: App.Session, doc: Doc, notices: List Text }
            (test-get Admin.Posts.Index
              (record Params
                (q "")
                (published "")
                (sort "slug")
                (dir "asc")
                (page 1)))
            (bind task down : { model: Model, session: App.Session, doc: Doc, notices: List Text }
              (test-get Admin.Posts.Index
                (record Params
                  (q "")
                  (published "")
                  (sort "slug")
                  (dir "desc")
                  (page 1)))
              (pure task
                (test-eq
                  (record
                    (up
                      (call (std List.map)
                        (lambda (row : Table.Post.Post) (field id (var row)))
                        (field rows (field model (var up)))))
                    (down
                      (call (std List.map)
                        (lambda (row : Table.Post.Post) (field id (var row)))
                        (field rows (field model (var down)))))
                    (toggles
                      (list
                        (call (global Admin.Posts.Index.toggle)
                          (field model (var up))
                          "slug")
                        (call (global Admin.Posts.Index.toggle)
                          (field model (var down))
                          "slug")
                        (call (global Admin.Posts.Index.toggle)
                          (field model (var up))
                          "title"))))
                  (record
                    (up (list (var post2) (var post1)))
                    (down (list (var post1) (var post2)))
                    (toggles (list "desc" "asc" "asc"))))))))))))
