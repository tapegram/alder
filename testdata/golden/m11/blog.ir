(test "the second page links back to the first" task
  (bind task author : Text
    (db-insert Table.User.User
      (record
        (email "author@example.com")
        (name "Author")
        (passwordHash "")
        (role (ctor Table.User.Role.Author))))
    (bind task _
      (all task
        (call (std List.map)
          (lambda (n : Int)
            (db-insert Table.Post.Post
              (record
                (slug (++ : Text "post-" (call (std Text.fromInt) (var n))))
                (title "A post")
                (body "")
                (published True)
                (author (var author)))))
          (call (std List.range) 1 11)))
      (bind task first : { model: Model, session: App.Session, doc: Doc, notices: List Text }
        (test-get Posts.Index (record Params (page 1) (q "")))
        (bind task second : { model: Model, session: App.Session, doc: Doc, notices: List Text }
          (test-get Posts.Index (record Params (page 2) (q "")))
          (pure task
            (test-eq
              (record
                (firstPosts
                  (call (std Test.count) "ul.posts li" (field doc (var first))))
                (next
                  (call (std Test.attr)
                    "href"
                    "a[rel=next]"
                    (field doc (var first))))
                (secondPosts
                  (call (std Test.count) "ul.posts li" (field doc (var second))))
                (prev
                  (call (std Test.attr)
                    "href"
                    "a[rel=prev]"
                    (field doc (var second))))
                (more
                  (call (std Test.has) "a[rel=next]" (field doc (var second)))))
              (record
                (firstPosts 10)
                (next (ctor Prelude.Maybe.Just (record (value "/?page=2"))))
                (secondPosts 1)
                (prev (ctor Prelude.Maybe.Just (record (value "/"))))
                (more False)))))))))
