(module Admin.Comments.Delete)
(record Admin.Comments.Delete.Model (row Table.Comment.Comment))
(record Admin.Comments.Delete.Confirm)
(record Admin.Comments.Delete.Params (id Text))
(record Admin.Comments.Delete.RemoveParams (form Confirm))
(union Admin.Comments.Delete.Msg (Remove RemoveParams))
(record Admin.Comments.Delete.Session (user Text) (role Table.User.Role))
(value Admin.Comments.Delete.load : Params -> Session -> Query Model (params session)
  (bind query admin : Bool
    (call (global Admin.Layout.isAdmin) (field user (var session)))
    (if (var admin)
      (bind query found : Maybe Table.Comment.Comment
        (db-get Table.Comment.Comment (field id (var params)))
        (match union (var found)
          (case Just (bind _m1 value : Table.Comment.Comment)
            (let row : Table.Comment.Comment
              (var _m1)
              (pure query (record Model (row (var row))))))
          (case Nothing (not-found))))
      (not-found))))
(value Admin.Comments.Delete.blockers : Model -> Int (model) 0)
(value Admin.Comments.Delete.update : Msg -> Model -> Session -> Task Nav (msg model session)
  (match union (var msg)
    (case Remove (bind _m1 : RemoveParams)
      (let p : RemoveParams
        (var _m1)
        (bind task _
          (db-delete Table.Comment.Comment (field id (field row (var model))))
          (pure task
            (ctor Prelude.Nav.Redirect
              (record
                (value
                  (page-ref Admin.Comments.Index
                    (record Admin.Comments.Index.Params
                      (q "")
                      (sort "created")
                      (dir "desc")
                      (page 1))))))))))))
(value Admin.Comments.Delete.view : Model -> Session -> Html Msg (model session)
  (comp Admin.Layout.Page
    (record (title "Delete comment"))
    (elem h1 (htext "Delete this comment?"))
    (elem al-card
      (elem p (hexpr text (field author (field row (var model)))))
      (elem dl)
      (form-el Admin.Comments.Delete.Remove
        (attr id text "delete")
        (attr submit submit
          (ctor Admin.Comments.Delete.Msg.Remove (record RemoveParams)))
        (elem al-alert
          (attr variant text "destructive")
          (attr role text "alert")
          (input Errors Confirm form))
        (hif (> : Int (call (global Admin.Comments.Delete.blockers) (var model)) 0)
          (elem p (htext "It cannot be deleted while other rows refer to it."))
          (elem al-button
            (attr variant text "destructive")
            (attr type text "submit")
            (elem button (attr type text "submit") (htext "Delete"))))))
    (elem a
      (attr href href
        (page-ref Admin.Comments.Show
