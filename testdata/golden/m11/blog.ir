(test "page 99 is empty" task
  (bind task author : Text
    (db-insert Table.User.User
      (record
        (email "author@example.com")
        (name "Author")
        (passwordHash "")
        (role (ctor Table.User.Role.Author))))
    (bind task _
      (all task
        (call (std List.map)
          (lambda (n : Int)
            (db-insert Table.Post.Post
              (record
                (slug (++ : Text "post-" (call (std Text.fromInt) (var n))))
                (title "A post")
                (body "")
                (published True)
                (author (var author)))))
          (call (std List.range) 1 11)))
      (bind task pages : List Model
        (all query
          (call (std List.map)
            (lambda (n : Int)
              (call (global Posts.Index.load)
                (record Params (page (var n)) (q ""))
                (record App.Session
                  (user (ctor Prelude.Maybe.Nothing))
                  (role (ctor Table.User.Role.Reader)))))
            (list 1 2 99 0)))
        (let seen : List { page: Int, posts: Int, hasMore: Bool }
          (call (std List.map)
            (lambda (m : Model)
              (record
                (page (field page (var m)))
                (posts (call (std List.length) (field posts (var m))))
                (hasMore (field hasMore (var m)))))
            (var pages))
          (pure task
            (test-eq
              (var seen)
              (list
                (record (page 1) (posts 10) (hasMore True))
                (record (page 2) (posts 1) (hasMore False))
                (record (page 99) (posts 0) (hasMore False))
                (record (page 1) (posts 10) (hasMore True))))))))))
