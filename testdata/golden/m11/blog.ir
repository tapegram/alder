(module Admin.Users.Index)
(record Admin.Users.Index.Model
  (rows List Table.User.User)
  (labels Labels)
  (q Text)
  (filters Filters)
  (sort Text)
  (dir Text)
  (page Int)
  (pages Int)
  (count Int))
(record Admin.Users.Index.Filter
  (name Text)
  (label Text)
  (value Text)
  (options List { value: Text, label: Text, rows: Condition Table.User.User }))
(record Admin.Users.Index.Filters (role Text))
(record Admin.Users.Index.Labels)
(record Admin.Users.Index.Params
  (q Text = "")
  (role Text = "")
  (sort Text = "created")
  (dir Text = "desc")
  (page Int = 1))
(union Admin.Users.Index.Msg)
(record Admin.Users.Index.Session (user Text) (role Table.User.Role))
(value Admin.Users.Index.perPage : Int () 25)
(value Admin.Users.Index.search : Text -> Condition Table.User.User (q)
  (cond or
    (cond contains (col Table.User.User email) (var q))
    (cond contains (col Table.User.User name) (var q))))
(value Admin.Users.Index.chosen : Params -> Filters (params)
  (record Filters (role (field role (var params)))))
(value Admin.Users.Index.filters : Filters -> List Filter (f)
  (list
    (record Filter
      (name "role")
      (label "Role")
      (value (field role (var f)))
      (options
        (list
          (record
            (value "Reader")
            (label "Reader")
            (rows
              (cond eq (col Table.User.User role) (ctor Table.User.Role.Reader))))
          (record
            (value "Author")
            (label "Author")
            (rows
              (cond eq (col Table.User.User role) (ctor Table.User.Role.Author))))
          (record
            (value "Admin")
            (label "Admin")
            (rows
              (cond eq (col Table.User.User role) (ctor Table.User.Role.Admin)))))))))
(value Admin.Users.Index.filtered : List Filter -> Condition Table.User.User (fs)
  (cond and
    (value
      (call (std List.map)
        (lambda (f : Filter)
          (match union (call (std List.find) (lambda (o : { value: Text, label: Text, rows: Condition Table.User.User }) (== : Text (field value (var o)) (field value (var f)))) (field options (var f)))
            (case Just (bind _m1 value : { value: Text, label: Text, rows: Condition Table.User.User })
              (let o : { value: Text, label: Text, rows: Condition Table.User.User }
                (var _m1)
                (field rows (var o))))
            (case Nothing (cond and))))
        (var fs)))))
(value Admin.Users.Index.listAt : Model -> Text -> Text -> Int -> Page (model sort dir n)
  (page-ref Admin.Users.Index
    (record Params
      (q (field q (var model)))
      (role (field role (field filters (var model))))
      (sort (var sort))
      (dir (var dir))
      (page (var n)))))
(value Admin.Users.Index.sorts : List { name: Text, asc: Order Table.User.User, desc: Order Table.User.User } ()
  (list
    (record
      (name "email")
      (asc (ord (col Table.User.User email) asc))
      (desc (ord (col Table.User.User email) desc)))
    (record
      (name "name")
      (asc (ord (col Table.User.User name) asc))
      (desc (ord (col Table.User.User name) desc)))
    (record
      (name "role")
      (asc (ord (col Table.User.User role) asc))
      (desc (ord (col Table.User.User role) desc)))
    (record
      (name "created")
      (asc (ord (col Table.User.User created) asc))
      (desc (ord (col Table.User.User created) desc)))))
(value Admin.Users.Index.order : Text -> Text -> Order Table.User.User (sort dir)
  (match union (call (std List.find) (lambda (s : { name: Text, asc: Order Table.User.User, desc: Order Table.User.User }) (== : Text (field name (var s)) (var sort))) (global Admin.Users.Index.sorts))
    (case Just (bind _m1 value : { name: Text, asc: Order Table.User.User, desc: Order Table.User.User })
      (let s : { name: Text, asc: Order Table.User.User, desc: Order Table.User.User }
        (var _m1)
        (if (== : Text (var dir) "asc")
          (field asc (var s))
          (field desc (var s)))))
    (case Nothing (ord (col Table.User.User created) desc))))
(value Admin.Users.Index.toggle : Model -> Text -> Text (model sort)
  (if (&& (== : Text (field sort (var model)) (var sort)) (== : Text (field dir (var model)) "asc"))
    "desc"
    "asc"))
(value Admin.Users.Index.load : Params -> Session -> Query Model (params session)
  (bind query admin : Bool
    (call (global Admin.Layout.isAdmin) (field user (var session)))
    (if (var admin)
      (let q : Text
        (call (std Text.slice) 0 200 (field q (var params)))
        (let f : Filters
          (call (global Admin.Users.Index.chosen) (var params))
          (bind query count : Int
            (db-select Table.User.User
              (where
                (cond and
                  (call (global Admin.Users.Index.search) (var q))
                  (call (global Admin.Users.Index.filtered)
                    (call (global Admin.Users.Index.filters) (var f)))))
              count)
            (let pages : Int
              (call (std Int.max)
                1
                (/
                  (- (+ (var count) (global Admin.Users.Index.perPage)) 1)
                  (global Admin.Users.Index.perPage)))
              (let page : Int
                (call (std Int.clamp)
                  (record (min 1) (max (var pages)))
                  (field page (var params)))
                (bind query rows : List Table.User.User
                  (db-select Table.User.User
                    (where
                      (cond and
                        (call (global Admin.Users.Index.search) (var q))
                        (call (global Admin.Users.Index.filtered)
                          (call (global Admin.Users.Index.filters) (var f)))))
                    (order
                      (call (global Admin.Users.Index.order)
                        (field sort (var params))
                        (field dir (var params))))
                    (limit (global Admin.Users.Index.perPage))
                    (offset
                      (* (- (var page) 1) (global Admin.Users.Index.perPage)))
                    all)
                  (bind query labels : Labels
                    (call (global Admin.Users.Index.labelsOf) (var rows))
                    (pure query
                      (record Model
                        (rows (var rows))
                        (labels (var labels))
                        (q (var q))
                        (filters (var f))
                        (sort (field sort (var params)))
                        (dir (field dir (var params)))
                        (page (var page))
                        (pages (var pages))
                        (count (var count)))))))))))
      (not-found))))
(value Admin.Users.Index.labelsOf : List Table.User.User -> Query Labels (rows)
  (pure query (record Labels)))
(value Admin.Users.Index.view : Model -> Session -> Html Msg (model session)
  (comp Admin.Layout.Page
    (record (title "Users"))
    (elem h1 (htext "Users"))
    (elem al-stack (attr direction text "row") (attr gap text "sm")
      (elem form (attr method text "get") (attr action text "/admin/user")
        (elem input
          (attr type text "search")
          (attr name text "q")
          (attr value text (field q (var model)))
          (attr aria-label text "Search"))
        (hfor f : Filter
          (call (global Admin.Users.Index.filters) (field filters (var model)))
          (elem al-select (attr label text (field label (var f)))
            (elem label
              (hexpr text (field label (var f)))
              (elem select (attr name text (field name (var f)))
                (elem option
                  (attr value text "")
                  (attr selected bool (== : Text (field value (var f)) ""))
                  (htext "any"))
                (hfor o : { value: Text, label: Text, rows: Condition Table.User.User }
                  (field options (var f))
                  (elem option
                    (attr value text (field value (var o)))
                    (attr selected bool
                      (== : Text (field value (var o)) (field value (var f))))
                    (hexpr text (field label (var o)))))))))
        (elem input
          (attr type text "hidden")
          (attr name text "sort")
          (attr value text (field sort (var model))))
        (elem input
          (attr type text "hidden")
          (attr name text "dir")
          (attr value text (field dir (var model))))
        (elem al-button
          (attr type text "submit")
          (attr variant text "secondary")
          (elem button (attr type text "submit") (htext "Search"))))
      (elem al-button
        (elem a
          (attr href href
            (page-ref Admin.Users.New (record Admin.Users.New.Params)))
          (htext "New user"))))
    (elem p (attr id text "count")
      (hif (== : Int (field count (var model)) 1)
        (hexpr text "1 row")
        (hexpr text
          (++ : Text (call (std Text.fromInt) (field count (var model)))
            " rows"))))
    (elem al-table
      (elem table
        (elem thead
          (elem tr
            (elem th (elem span (attr class text "sr-only") (htext "Choose")))
            (elem th
              (elem a
                (attr href href
                  (call (global Admin.Users.Index.listAt)
                    (var model)
                    "email"
                    (call (global Admin.Users.Index.toggle) (var model) "email")
                    1))
                (htext "Email")))
            (elem th
              (elem a
                (attr href href
                  (call (global Admin.Users.Index.listAt)
                    (var model)
                    "name"
                    (call (global Admin.Users.Index.toggle) (var model) "name")
                    1))
                (htext "Name")))
            (elem th
              (elem a
                (attr href href
                  (call (global Admin.Users.Index.listAt)
                    (var model)
                    "role"
                    (call (global Admin.Users.Index.toggle) (var model) "role")
                    1))
                (htext "Role")))
            (elem th
              (elem a
                (attr href href
                  (call (global Admin.Users.Index.listAt)
                    (var model)
                    "created"
                    (call (global Admin.Users.Index.toggle)
                      (var model)
                      "created")
                    1))
                (htext "Created")))))
        (elem tbody
          (hfor row : Table.User.User
            (field rows (var model))
            (elem tr
              (elem td
                (elem input
                  (attr type text "checkbox")
                  (attr name text "ids")
                  (attr form text "bulk")
                  (attr value text (field id (var row)))
                  (attr aria-label text
                    (++ : Text "Choose " (field email (var row))))))
              (elem td
                (elem a
                  (attr href href
                    (page-ref Admin.Users.Show
                      (record Admin.Users.Show.Params (id (field id (var row))))))
                  (hexpr text (field email (var row)))))
              (elem td (hexpr text (field name (var row))))
              (elem td
                (elem al-badge
                  (hmatch union (field role (var row))
                    (case Reader (hexpr text "Reader"))
                    (case Author (hexpr text "Author"))
                    (case Admin (hexpr text "Admin")))))
              (elem td
                (hexpr text
                  (call (std Time.format)
                    "Jan 2, 2006"
                    (field created (var row))))))))))
    (elem al-stack (attr direction text "row") (attr gap text "sm")
      (elem form
        (attr id text "bulk")
        (attr method text "get")
        (attr action text "/admin/user/bulk")
        (elem al-button
          (attr type text "submit")
          (attr variant text "secondary")
          (elem button (attr type text "submit")
            (htext "Act on the chosen rows"))))
      (elem form
        (attr id text "bulk-page")
        (attr method text "get")
        (attr action text "/admin/user/bulk")
        (hfor row : Table.User.User
          (field rows (var model))
          (elem input
            (attr type text "hidden")
            (attr name text "ids")
            (attr value text (field id (var row)))))
        (elem al-button
          (attr type text "submit")
          (attr variant text "secondary")
          (elem button (attr type text "submit")
            (htext "Act on all rows on this page")))))
    (elem al-pagination
      (attr role text "navigation")
      (attr aria-label text "Pages")
      (hif (> : Int (field page (var model)) 1)
        (elem a
          (attr slot text "prev")
          (attr href href
            (call (global Admin.Users.Index.listAt)
              (var model)
              (field sort (var model))
              (field dir (var model))
              (- (field page (var model)) 1)))
          (attr rel text "prev")
          (htext "Previous"))
        (elem span (attr slot text "prev") (attr aria-disabled text "true")
          (htext "Previous")))
      (elem span
        (htext "Page ")
        (hexpr text (call (std Text.fromInt) (field page (var model))))
        (htext " of ")
        (hexpr text (call (std Text.fromInt) (field pages (var model)))))
      (hif (< : Int (field page (var model)) (field pages (var model)))
        (elem a
          (attr slot text "next")
          (attr href href
            (call (global Admin.Users.Index.listAt)
              (var model)
              (field sort (var model))
              (field dir (var model))
              (+ (field page (var model)) 1)))
          (attr rel text "next")
          (htext "Next"))
        (elem span (attr slot text "next") (attr aria-disabled text "true")
          (htext "Next"))))))
(test "the list shows every row, newest first" task
  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "email-1@example.com")
        (name "name-1")
        (passwordHash "passwordhash-1")
        (role (ctor Table.User.Role.Admin))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor Table.User.Role.Admin))))
      (bind task user2 : Text
        (db-insert Table.User.User
          (record
            (email "email-2@example.com")
            (name "name-2")
            (passwordHash "passwordhash-2")
            (role (ctor Table.User.Role.Reader))))
        (bind task user3 : Text
          (db-insert Table.User.User
            (record
              (email "email-3@example.com")
              (name "name-3")
              (passwordHash "passwordhash-3")
              (role (ctor Table.User.Role.Reader))))
          (bind task page : { model: Model, session: App.Session, doc: Doc, notices: List Text }
            (test-get Admin.Users.Index
              (record Params
                (q "")
                (role "")
                (sort "created")
                (dir "desc")
                (page 1)))
            (pure task
              (test-eq
                (record
                  (rows
                    (call (std List.map)
                      (lambda (row : Table.User.User) (field id (var row)))
                      (field rows (field model (var page))))))
                (record (rows (list (var user3) (var user2) (var me))))))))))))
(test "sorting by email goes both ways" task
  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "email-1@example.com")
        (name "name-1")
        (passwordHash "passwordhash-1")
        (role (ctor Table.User.Role.Admin))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor Table.User.Role.Admin))))
      (bind task user2 : Text
        (db-insert Table.User.User
          (record
            (email "email-3@example.com")
            (name "name-2")
            (passwordHash "passwordhash-2")
            (role (ctor Table.User.Role.Reader))))
        (bind task user3 : Text
          (db-insert Table.User.User
            (record
              (email "email-2@example.com")
              (name "name-3")
              (passwordHash "passwordhash-3")
              (role (ctor Table.User.Role.Reader))))
          (bind task up : { model: Model, session: App.Session, doc: Doc, notices: List Text }
            (test-get Admin.Users.Index
              (record Params
                (q "")
                (role "")
                (sort "email")
                (dir "asc")
                (page 1)))
            (bind task down : { model: Model, session: App.Session, doc: Doc, notices: List Text }
              (test-get Admin.Users.Index
                (record Params
                  (q "")
                  (role "")
                  (sort "email")
                  (dir "desc")
                  (page 1)))
              (pure task
                (test-eq
                  (record
                    (up
                      (call (std List.map)
                        (lambda (row : Table.User.User) (field id (var row)))
                        (field rows (field model (var up)))))
                    (down
                      (call (std List.map)
                        (lambda (row : Table.User.User) (field id (var row)))
                        (field rows (field model (var down)))))
                    (toggles
                      (list
                        (call (global Admin.Users.Index.toggle)
                          (field model (var up))
                          "email")
                        (call (global Admin.Users.Index.toggle)
                          (field model (var down))
                          "email")
                        (call (global Admin.Users.Index.toggle)
                          (field model (var up))
                          "name"))))
                  (record
                    (up (list (var me) (var user3) (var user2)))
                    (down (list (var user2) (var user3) (var me)))
                    (toggles (list "desc" "asc" "asc"))))))))))))
