  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "email-1@example.com")
        (name "name-1")
        (passwordHash "passwordhash-1")
        (role (ctor Table.User.Role.Admin))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor Table.User.Role.Admin))))
      (bind task post1 : Text
        (db-insert Table.Post.Post
          (record
            (slug "slug-1")
            (title "title-1")
            (body "body-1")
            (published False)
            (author (var me))))
        (bind task _
          (all task
            (call (std List.map)
              (lambda (n : Int)
                (db-insert Table.Comment.Comment
                  (record
                    (post (var post1))
                    (author
                      (++ : Text "author-" (call (std Text.fromInt) (var n))))
                    (body (++ : Text "body-" (call (std Text.fromInt) (var n)))))))
