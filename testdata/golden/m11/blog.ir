(test "a demoted Admin is refused at once" task
  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "email-1@example.com")
        (name "name-1")
        (passwordHash "passwordhash-1")
        (role (ctor Table.User.Role.Reader))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor Table.User.Role.Admin))))
      (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
        (test-open Admin.Posts.Index
          (record Params
            (q "")
            (published "")
            (sort "created")
            (dir "desc")
            (page 1)))
        (pure task
          (test-eq (field answer (var r)) (ctor Prelude.Answer.PageMissing)))))))
(module Admin.Posts.New)
(record Admin.Posts.New.Model (authors List Table.User.User) (authorsTotal Int))
(record Admin.Posts.New.PostForm
  (slug Text)
  (title Text)
  (body Text)
  (published Bool)
  (author Text))
(record Admin.Posts.New.FindAuthor (q Text))
(record Admin.Posts.New.Params (findAuthor Text = ""))
(record Admin.Posts.New.SearchAuthorParams (form FindAuthor))
(record Admin.Posts.New.CreateParams (form PostForm))
(union Admin.Posts.New.Msg
  (SearchAuthor SearchAuthorParams)
  (Create CreateParams))
(record Admin.Posts.New.Session (user Text) (role Table.User.Role))
(value Admin.Posts.New.load : Params -> Session -> Query Model (params session)
  (bind query admin : Bool
    (call (global Admin.Layout.isAdmin) (field user (var session)))
    (if (var admin)
      (let findAuthor : Text
        (call (std Text.slice) 0 200 (field findAuthor (var params)))
        (bind query authorsTotal : Int
          (db-select Table.User.User count)
          (bind query authors : List Table.User.User
            (db-select Table.User.User
              (where
                (if (> : Int (var authorsTotal) 200)
                  (cond contains (col Table.User.User email) (var findAuthor))
                  (cond and)))
              (order (ord (col Table.User.User email) asc))
              (limit (if (> : Int (var authorsTotal) 200) 50 200))
              all)
            (pure query
              (record Model
                (authors (var authors))
                (authorsTotal (var authorsTotal)))))))
      (not-found))))
(value Admin.Posts.New.update : Msg -> Model -> Session -> Task Nav (msg model session)
  (match union (var msg)
    (case SearchAuthor (bind _m1 : SearchAuthorParams)
      (let p : SearchAuthorParams
        (var _m1)
        (pure task
          (ctor Prelude.Nav.Redirect
            (record
              (value
                (page-ref Admin.Posts.New
                  (record Params
                    (findAuthor
                      (call (std Text.slice)
                        0
                        200
                        (field q (field form (var p)))))))))))))
    (case Create (bind _m2 : CreateParams)
      (let p : CreateParams
        (var _m2)
        (bind task slugTaken : Int
          (db-select Table.Post.Post
            (where
              (cond eq
                (col Table.Post.Post slug)
                (field slug (field form (var p)))))
            count)
          (if (> : Int (var slugTaken) 0)
            (pure task
              (ctor Prelude.Nav.Reject
                (record (value "A post with this slug exists."))))
            (bind task id : Text
              (db-insert Table.Post.Post
                (record
                  (slug (field slug (field form (var p))))
                  (title (field title (field form (var p))))
                  (body (field body (field form (var p))))
                  (published (field published (field form (var p))))
                  (author (field author (field form (var p))))))
              (pure task
                (ctor Prelude.Nav.Redirect
                  (record
                    (value
                      (page-ref Admin.Posts.Show
                        (record Admin.Posts.Show.Params (id (var id)))))))))))))))
(value Admin.Posts.New.view : Model -> Session -> Html Msg (model session)
  (comp Admin.Layout.Page
    (record (title "New post"))
    (elem h1 (htext "New post"))
    (elem al-card
      (hif (> : Int (field authorsTotal (var model)) 200)
        (form-el Admin.Posts.New.SearchAuthor
          (attr submit submit
            (ctor Admin.Posts.New.Msg.SearchAuthor (record SearchAuthorParams)))
          (input Input FindAuthor field=q label="Find author" (wrap al-input))
          (elem al-button
            (attr type text "submit")
            (attr variant text "secondary")
            (elem button (attr type text "submit") (htext "Find"))))
        (elem span))
      (form-el Admin.Posts.New.Create
        (attr submit submit
          (ctor Admin.Posts.New.Msg.Create (record CreateParams)))
        (input Input PostForm field=slug label="Slug" (wrap al-input))
        (input Input PostForm field=title label="Title" (wrap al-input))
        (input Textarea PostForm field=body label="Body" (wrap al-textarea))
        (input Input PostForm field=published label="Published"
          (value False)
          (wrap al-checkbox))
        (input Select PostForm field=author label="Author"
          (options
            (call (std List.map)
              (lambda (r : Table.User.User)
                (record
                  (value (field id (var r)))
                  (label (field email (var r)))))
              (field authors (var model))))
          (wrap al-select))
        (elem al-alert
          (attr variant text "destructive")
          (attr role text "alert")
          (input Errors PostForm form))
        (elem al-button (attr type text "submit")
          (elem button (attr type text "submit") (htext "Create")))))))
(test "creating a post adds it, with the values submitted" task
  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "email-1@example.com")
        (name "name-1")
        (passwordHash "passwordhash-1")
        (role (ctor Table.User.Role.Admin))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor Table.User.Role.Admin))))
      (bind task user2 : Text
        (db-insert Table.User.User
          (record
            (email "email-2@example.com")
            (name "name-2")
            (passwordHash "passwordhash-2")
            (role (ctor Table.User.Role.Reader))))
        (bind task _
          (db-insert Table.Post.Post
            (record
              (slug "slug-1")
              (title "title-1")
              (body "body-1")
              (published False)
              (author (var me))))
          (bind task page : { model: Model, session: App.Session, doc: Doc, notices: List Text }
            (test-get Admin.Posts.New (record Params (findAuthor "")))
            (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
              (test-submit Admin.Posts.New.PostForm Create
                (record PostForm
                  (slug "slug-2")
                  (title "title-2")
                  (body "body-2")
                  (published True)
                  (author (var user2))))
              (bind task rows : List Table.Post.Post
                (db-select Table.Post.Post
                  (where (cond eq (col Table.Post.Post slug) "slug-2"))
                  all)
                (pure task
                  (test-eq
                    (record
                      (answers
                        (call (std List.map)
                          (lambda (row : Table.Post.Post)
                            (ctor Prelude.Answer.Redirected
                              (record
                                (value
                                  (page-ref Admin.Posts.Show
                                    (record Admin.Posts.Show.Params
                                      (id (field id (var row)))))))))
                          (var rows)))
                      (rows
                        (call (std List.map)
                          (lambda (row : Table.Post.Post)
                            (record
                              (slug (field slug (var row)))
                              (title (field title (var row)))
                              (body (field body (var row)))
                              (published (field published (var row)))
                              (author (field author (var row)))))
                          (var rows)))
                      (authors
                        (call (std Test.texts)
                          "select[name=author] option"
                          (field doc (var page)))))
                    (record
                      (answers (list (field answer (var r))))
                      (rows
                        (list
                          (record
                            (slug "slug-2")
                            (title "title-2")
                            (body "body-2")
                            (published True)
                            (author (var user2)))))
                      (authors
                        (list "email-1@example.com" "email-2@example.com")))))))))))))
(test "a post with a slug that exists is refused" task
  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "email-1@example.com")
        (name "name-1")
        (passwordHash "passwordhash-1")
        (role (ctor Table.User.Role.Admin))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor Table.User.Role.Admin))))
      (bind task user2 : Text
        (db-insert Table.User.User
          (record
            (email "email-2@example.com")
            (name "name-2")
            (passwordHash "passwordhash-2")
            (role (ctor Table.User.Role.Reader))))
        (bind task _
          (db-insert Table.Post.Post
            (record
              (slug "slug-1")
              (title "title-1")
              (body "body-1")
              (published False)
              (author (var me))))
          (bind task _
            (test-get Admin.Posts.New (record Params (findAuthor "")))
            (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
              (test-submit Admin.Posts.New.PostForm Create
                (record PostForm
                  (slug "slug-1")
                  (title "title-2")
                  (body "body-2")
                  (published True)
                  (author (var user2))))
              (bind task rows : Int
                (db-select Table.Post.Post count)
                (pure task
                  (test-eq
                    (record (answer (field answer (var r))) (rows (var rows)))
                    (record
                      (answer
                        (ctor Prelude.Answer.FormRejected
                          (record
                            (value
                              (list
                                (record
                                  (field "")
                                  (message "A post with this slug exists.")))))))
                      (rows 1))))))))))))
(test "an author not offered is refused" task
  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "email-1@example.com")
        (name "name-1")
        (passwordHash "passwordhash-1")
        (role (ctor Table.User.Role.Admin))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor Table.User.Role.Admin))))
      (bind task user2 : Text
        (db-insert Table.User.User
          (record
            (email "email-2@example.com")
            (name "name-2")
            (passwordHash "passwordhash-2")
            (role (ctor Table.User.Role.Reader))))
        (bind task page : { model: Model, session: App.Session, doc: Doc, notices: List Text }
          (test-get Admin.Posts.New (record Params (findAuthor "")))
          (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
            (test-submit-raw Admin.Posts.New.PostForm Create
              (list
                (record (name "slug") (value "x"))
                (record (name "title") (value "x"))
                (record (name "body") (value "x"))
                (record (name "published") (value "True"))
                (record (name "author") (value "missing"))))
            (bind task rows : Int
              (db-select Table.Post.Post count)
              (pure task
                (test-eq
                  (record (answer (field answer (var r))) (rows (var rows)))
                  (record
                    (answer
                      (ctor Prelude.Answer.FormRejected
                        (record
                          (value
                            (list
                              (record
                                (field "author")
                                (message "must be one of the options")))))))
                    (rows 0)))))))))))
(test "a list of 200 users is offered whole" task
  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "email-1@example.com")
        (name "name-1")
        (passwordHash "passwordhash-1")
        (role (ctor Table.User.Role.Admin))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor Table.User.Role.Admin))))
      (bind task user2 : Text
        (db-insert Table.User.User
          (record
            (email "email-2@example.com")
            (name "name-2")
            (passwordHash "passwordhash-2")
            (role (ctor Table.User.Role.Reader))))
        (bind task _
          (all task
            (call (std List.map)
              (lambda (n : Int)
                (db-insert Table.User.User
                  (record
                    (email
                      (++ : Text (++ : Text "email-" (call (std Text.fromInt) (var n)))
                        "@example.com"))
                    (name (++ : Text "name-" (call (std Text.fromInt) (var n))))
                    (passwordHash
                      (++ : Text "passwordhash-"
                        (call (std Text.fromInt) (var n))))
                    (role (ctor Table.User.Role.Reader)))))
              (call (std List.range) 3 200)))
          (bind task page : { model: Model, session: App.Session, doc: Doc, notices: List Text }
            (test-get Admin.Posts.New (record Params (findAuthor "")))
            (pure task
              (test-eq
                (call (std List.length)
                  (field authors (field model (var page))))
                200))))))))
(test "a long list of users offers 50, and the search narrows it" task
  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "email-1@example.com")
        (name "name-1")
        (passwordHash "passwordhash-1")
        (role (ctor Table.User.Role.Admin))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor Table.User.Role.Admin))))
      (bind task user2 : Text
        (db-insert Table.User.User
          (record
            (email "email-2@example.com")
            (name "name-2")
            (passwordHash "passwordhash-2")
            (role (ctor Table.User.Role.Reader))))
        (bind task _
          (all task
            (call (std List.map)
              (lambda (n : Int)
                (db-insert Table.User.User
                  (record
                    (email
                      (++ : Text (++ : Text "email-" (call (std Text.fromInt) (var n)))
                        "@example.com"))
                    (name (++ : Text "name-" (call (std Text.fromInt) (var n))))
                    (passwordHash
                      (++ : Text "passwordhash-"
                        (call (std Text.fromInt) (var n))))
                    (role (ctor Table.User.Role.Reader)))))
              (call (std List.range) 3 203)))
          (bind task all : { model: Model, session: App.Session, doc: Doc, notices: List Text }
            (test-get Admin.Posts.New (record Params (findAuthor "")))
            (bind task found : { model: Model, session: App.Session, doc: Doc, notices: List Text }
              (test-get Admin.Posts.New
                (record Params (findAuthor "email-203@example.com")))
              (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
                (test-submit Admin.Posts.New.FindAuthor SearchAuthor
                  (record FindAuthor (q "zz")))
                (pure task
                  (test-eq
                    (record
                      (shown
                        (call (std List.length)
                          (field authors (field model (var all)))))
                      (total (field authorsTotal (field model (var all))))
                      (found
                        (== : List Text (call (std Test.texts) "select[name=author] option" (field doc (var found)))
                          (list "email-203@example.com")))
                      (answer (field answer (var r))))
                    (record
                      (shown 50)
                      (total 203)
                      (found True)
                      (answer
                        (ctor Prelude.Answer.Redirected
                          (record
                            (value
                              (page-ref Admin.Posts.New
                                (record Params (findAuthor "zz"))))))))))))))))))
(test "an author outside the narrowed list is refused" task
  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "email-1@example.com")
        (name "name-1")
        (passwordHash "passwordhash-1")
        (role (ctor Table.User.Role.Admin))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor Table.User.Role.Admin))))
      (bind task user2 : Text
        (db-insert Table.User.User
          (record
            (email "email-2@example.com")
            (name "name-2")
            (passwordHash "passwordhash-2")
            (role (ctor Table.User.Role.Reader))))
        (bind task _
          (all task
            (call (std List.map)
              (lambda (n : Int)
                (db-insert Table.User.User
                  (record
                    (email
                      (++ : Text (++ : Text "email-" (call (std Text.fromInt) (var n)))
                        "@example.com"))
                    (name (++ : Text "name-" (call (std Text.fromInt) (var n))))
                    (passwordHash
                      (++ : Text "passwordhash-"
                        (call (std Text.fromInt) (var n))))
                    (role (ctor Table.User.Role.Reader)))))
              (call (std List.range) 3 203)))
          (bind task all : { model: Model, session: App.Session, doc: Doc, notices: List Text }
            (test-get Admin.Posts.New (record Params (findAuthor "")))
            (bind task found : { model: Model, session: App.Session, doc: Doc, notices: List Text }
              (test-get Admin.Posts.New
                (record Params (findAuthor "email-203@example.com")))
              (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
                (test-submit Admin.Posts.New.FindAuthor SearchAuthor
                  (record FindAuthor (q "zz")))
                (let pick : Text
                  (call (std Maybe.withDefault)
                    ""
                    (call (std Test.attr)
                      "value"
                      "select[name=author] option"
                      (field doc (var found))))
                  (bind task page : { model: Model, session: App.Session, doc: Doc, notices: List Text }
                    (test-get Admin.Posts.New (record Params (findAuthor "")))
                    (bind task sent : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
                      (test-submit-raw Admin.Posts.New.PostForm Create
                        (list
                          (record (name "slug") (value "x"))
                          (record (name "title") (value "x"))
                          (record (name "body") (value "x"))
                          (record (name "published") (value "True"))
                          (record (name "author") (value (var pick)))))
                      (bind task rows : Int
                        (db-select Table.Post.Post count)
                        (pure task
                          (test-eq
                            (record
                              (answer (field answer (var sent)))
                              (rows (var rows)))
                            (record
                              (answer
                                (ctor Prelude.Answer.FormRejected
                                  (record
                                    (value
                                      (list
                                        (record
                                          (field "author")
                                          (message "must be one of the options")))))))
                              (rows 0))))))))))))))))
