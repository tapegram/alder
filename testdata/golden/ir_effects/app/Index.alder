module Index

import Todo

route Index  = GET  "/pair/{a}/{b}"          { a: Todo.TodoId, b: Todo.TodoId }                  requires user
route Add    = POST "/pair/{a}/{b}"    { a: Todo.TodoId, b: Todo.TodoId, title: Text }     requires user
route Toggle = PUT "/pair/{a}/{b}/done" { a: Todo.TodoId, b: Todo.TodoId, id: Todo.TodoId } requires user
route Remove = DELETE "/pair/{a}/{b}" { a: Todo.TodoId, b: Todo.TodoId, id: Todo.TodoId } requires user
route Notify = POST "/pair/{a}/{b}/notification" { a: Todo.TodoId, b: Todo.TodoId }                  requires user

capability Mailer {
  send : { to: Text, body: Text } -> Task Bool,
}

type Model = {
  todos: List Todo,
  pair: List (Maybe Todo),
  now: Time,
  count: Int,
  first: Maybe Todo,
}

Index.load : Index.Params -> Session -> Query Model
Index.load params session = {
  let todos <-
    Db.from Todo
      |> Db.where (Todo.owner.eq session.user)
      |> Db.orderBy Todo.created.desc
      |> Db.limit 10
      |> Db.all
  let pair <- Query.all [Db.get Todo params.a, Db.get Todo params.b]
  let now <- Time.now
  let q =
    Db.from Todo
      |> Db.where (Db.or [Todo.title.contains "x", Todo.done.eq True])
      |> Db.offset 5
  let count <- Query.map (\n -> n + 1) (Db.count q)
  let first <- Db.first Todo.pending
  Query.succeed {
    todos: todos,
    pair: pair,
    now: now,
    count: count,
    first: first,
  }
}

Add.update : Add.Params -> Session -> Task Response
Add.update p session = {
  let id <- Db.insert Todo {
    title: p.title,
    due: Nothing,
    owner: session.user,
  }
  let _ <- Log.info "added {id}"
  Task.succeed (Response.redirect (Index { a: id, b: id }))
}

Toggle.update : Toggle.Params -> Session -> Task Response
Toggle.update p session = {
  let _ <- Db.update Todo p.id (\t -> { t | done: not t.done })
  Task.succeed Response.refresh
}

Remove.update : Remove.Params -> Session -> Task Response
Remove.update p session = {
  let found <- Db.get Todo p.id
  match found {
    Just t -> {
      let _ <- Db.delete Todo t.id
      Task.succeed Response.refresh
    },
    Nothing -> Task.fail "no such todo",
  }
}

Notify.update : Notify.Params -> Session -> Task Response
Notify.update p session = {
  let token : Text <- Random.id
  let sent <- Task.all [Mailer.send { to: "a@b.c", body: token }]
  let n <- Task.map List.length (Task.succeed sent)
  let _ <- Session.put (\s -> { s | theme: "dark" })
  Task.succeed (if n > 0 then Response.refresh else Response.invalid "not sent")
}

Index.view : Model -> Session -> Html
Index.view model session = <p>{Text.fromInt model.count}</p>
