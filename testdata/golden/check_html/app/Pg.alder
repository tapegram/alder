module Pg

import Layout

route Pg     = GET  "/"         { }
route Submit = POST "/" { } form F
route Toggle = POST "/toggles" { id: Int }

type Model = {
  n: Int,
  name: Text,
  saving: Bool,
  items: List Text,
}

Pg.load : Pg.Params -> Session -> Query Model
Pg.load params session = Query.succeed {
  n: 1,
  name: "x",
  saving: False,
  items: [],
}

form F = { title: Text.NonEmpty, kind: Kind }

type Kind = A | B

Submit.update : Submit.Params -> Session -> Task Response
Submit.update p session = Task.succeed Response.refresh

Toggle.update : Toggle.Params -> Session -> Task Response
Toggle.update p session = Task.succeed Response.refresh

Pg.view : Model -> Session -> Html
Pg.view model session =
  <Layout.Page title="T">
    <p>{model.n}</p>
    <a href="/somewhere">x</a>
    <button onclick={Toggle { id: 1 }}>x</button>
    <button click={Toggle}>x</button>
    <button click={Toggle { id: 1 }} disabled={model.saving}>ok</button>
    <blink>x</blink>
    <span data-x={model.n}>x</span>
    <Layout.Never1 />
    <Input field="title" label="T" />
    <form submit={Submit}>
      <Input field="nope" label="N" />
      <Input field="kind" label="K" />
      <Select field="kind" label="K" value={A} />
      <input name="raw" />
      <Input field="title" label />
      <Select field="title" label="T" />
      <Input field="title" label="T" value={model.n} />
      <Errors form />
      <Errors field="title" />
      <button>Go</button>
    </form>
    <ul>
      {for it in model.items -> <li>{it}</li>}
    </ul>
    {if model.saving then <p>s</p> else Html.none}
    {match session.user {
      Just u -> <span>{u}</span>,
      Nothing -> <a href={Pg {}}>in</a>,
    }}
    <Layout.Page title={model.n}>x</Layout.Page>
  </Layout.Page>
