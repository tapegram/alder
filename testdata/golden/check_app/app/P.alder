module P

route P  = GET  "/p"      { }
route Go = POST "/p/_/Go" { }

type Model = { }

P.load : P.Params -> Session -> Query Model
P.load params session = Query.succeed {}

Go.update : Go.Params -> Session -> Task Response
Go.update p session = {
  let _ <- Session.put (\s -> s)
  Task.succeed Response.refresh
}

P.view : Model -> Session -> Html
P.view model session = <p>p</p>
