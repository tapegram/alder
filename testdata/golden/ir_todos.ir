                      (record App.Session
                        (user
                          (ctor Prelude.Maybe.Just
                            (record (value "someone-else"))))
                        (role (ctor Table.User.Role.Member))))
                    (bind task deleted : { answer: Answer, session: App.Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
                      (test-click (route Todos.Show.Delete)
                        (record Delete.Params (id (var id))))
                      (bind task after : Maybe Table.Todo.Todo
                        (db-get Table.Todo.Todo (var id))
                        (pure task
                          (test-eq
                            (record
                              (saved (field answer (var saved)))
                              (deleted (field answer (var deleted)))
                              (todo
                                (call (std Maybe.map)
                                  (lambda (t : Table.Todo.Todo)
                                    (field title (var t)))
                                  (var after))))
                            (record
                              (saved (ctor Prelude.Answer.PageMissing))
                              (deleted (ctor Prelude.Answer.PageMissing))
                              (todo
                                (ctor Prelude.Maybe.Just
                                  (record (value "Milk")))))))))))))))))))
(table Table.User.User
  (id id)
  (created created)
  (unique email)
  (insert email name passwordHash role))
(table Table.Todo.Todo
  (id id)
  (created created)
  (partition user owner)
  (ref owner Table.User.User)
  (insert title done due owner))
(form Auth.Login.Credentials)
(form Todos.Index.NewTodo)
(form Todos.Show.EditTodo)
(route App.Logout POST "/_/Logout"
  (params Logout.Params)
  (update App.Logout.update))
(route Auth.Login.Login GET "/login"
  (params Login.Params)
  (model Model)
  (load Auth.Login.Login.load)
  (view Auth.Login.Login.view))
(route Auth.Login.Submit POST "/login/_/Submit"
  (params Submit.Params)
  (form Credentials)
  (update Auth.Login.Submit.update)
  (needs-shown))
(route Todos.Index.Index GET "/"
  (params Index.Params)
  (requires user)
  (session Index.Session)
  (model Model)
  (load Todos.Index.Index.load)
  (view Todos.Index.Index.view))
(route Todos.Index.Submit POST "/_/Submit"
  (params Submit.Params)
  (form NewTodo)
  (requires user)
  (session Index.Session)
  (update Todos.Index.Submit.update))
(route Todos.Index.Toggle POST "/_/Toggle"
  (params Toggle.Params)
  (requires user)
  (session Index.Session)
  (update Todos.Index.Toggle.update)
  (needs-shown))
(route Todos.Index.Delete POST "/_/Delete"
  (params Delete.Params)
  (requires user)
  (session Index.Session)
  (update Todos.Index.Delete.update)
  (needs-shown))
(route Todos.Show.Show GET "/todos/{id}"
  (params Show.Params)
  (requires user)
  (session Show.Session)
  (model Model)
  (load Todos.Show.Show.load)
  (view Todos.Show.Show.view))
(route Todos.Show.Save POST "/todos/{id}/_/Save"
  (params Save.Params)
  (form EditTodo)
  (requires user)
  (session Show.Session)
  (update Todos.Show.Save.update))
(route Todos.Show.Delete POST "/todos/{id}/_/Delete"
  (params Delete.Params)
  (requires user)
  (session Show.Session)
  (update Todos.Show.Delete.update))
(app-update App.Logout.update)
(session App.Session)
(deploy (env local script (script "./scripts/deploy-local.sh")) (proxy Caddy))
(capability Auth.Login.Password
  (verify { email: Text, password: Text } -> Task (Maybe Text)))
(fake Auth.Login.Password
  (tables)
  (entries
    (entry Auth.Login.verify : { email: Text, password: Text } -> Task (Maybe Text) (args)
      (bind task found : Maybe Table.User.User
        (db-select Table.User.User
          (where (cond eq (col Table.User.User email) (field email (var args))))
          first)
        (pure task
          (call (std Maybe.map)
            (lambda (u : Table.User.User) (field id (var u)))
            (var found)))))))
