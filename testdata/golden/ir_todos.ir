(test "saving changes the title and the due date" task
  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "me@example.com")
        (name "Me")
        (passwordHash "")
        (role (ctor Table.User.Role.Member))))
    (bind task id : Text
      (db-insert Table.Todo.Todo
        (record
          (title "Milk")
          (done False)
          (due (ctor Prelude.Maybe.Nothing))
          (owner (var me))))
      (bind task _
        (test-login
          (record App.Session
            (user (ctor Prelude.Maybe.Just (record (value (var me)))))
            (role (ctor Table.User.Role.Member))))
        (bind task _
          (test-get (route Todos.Show.Show) (record Show.Params (id (var id))))
          (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
            (test-submit Todos.Show.EditTodo (route Todos.Show.Save)
              (params (record Save.Params (id (var id))))
              (record EditTodo
                (title "Bread")
                (due (call (std Date.fromText) "2026-10-12"))))
