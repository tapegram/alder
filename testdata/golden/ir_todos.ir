                    (answer
                      (ctor Prelude.Answer.Redirected
                        (record
                          (value
                            (page-ref Todos.Index
                              (record Todos.Index.Params
                                (filter (ctor Todo.Filter.All))))))))
                    (todo (ctor Prelude.Maybe.Nothing))))))))))))
(table User.User
  (id id)
  (created created)
  (unique email)
  (insert email name passwordHash role))
(table Todo.Todo
  (id id)
  (created created)
  (partition user owner)
  (ref owner User.User)
  (insert title done due owner))
(form Auth.Login.Credentials)
(form Todos.Index.NewTodo)
(form Todos.Show.EditTodo)
(page Auth.Login "/login"
  (params Params)
  (model Model)
  (msg Submit (params SubmitParams) (form Credentials))
  (view Auth.Login.view)
  (load Auth.Login.load)
  (update Auth.Login.update))
(page Todos.Index "/"
  (params Params)
  (requires user)
  (session Session)
  (model Model)
  (msg Submit (params SubmitParams) (form NewTodo))
  (msg Toggle (params ToggleParams))
  (msg Delete (params DeleteParams))
  (view Todos.Index.view)
  (load Todos.Index.load)
  (update Todos.Index.update))
(page Todos.Show "/todos/{id}"
  (params Params)
  (requires user)
  (session Session)
  (model Model)
  (msg Save (params SaveParams) (form EditTodo))
  (msg Delete)
  (view Todos.Show.view)
  (load Todos.Show.load)
  (update Todos.Show.update))
(app-msg Logout)
(app-update App.update)
(session App.Session)
(deploy (env local script (script "./scripts/deploy-local.sh")) (proxy Caddy))
(capability Auth.Login.Password
  (verify { email: Text, password: Text } -> Task (Maybe Text)))
(fake Auth.Login.Password
  (tables)
  (entries
    (entry Auth.Login.verify : { email: Text, password: Text } -> Task (Maybe Text) (args)
      (bind task found : Maybe User
        (db-select User.User
          (where (cond eq (col User.User email) (field email (var args))))
          first)
        (pure task
          (call (std Maybe.map)
            (lambda (u : User) (field id (var u)))
            (var found)))))))
