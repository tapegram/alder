(test "adding a todo through the page" task
  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "me@example.com")
        (name "Me")
        (passwordHash "")
        (role (ctor Table.User.Role.Member))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor Table.User.Role.Member))))
      (bind task _
        (test-get (route Todos.Index.Index)
          (record Index.Params (filter (ctor Table.Todo.Filter.All))))
        (bind task added : { answer: Answer, session: App.Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
          (test-submit Todos.Index.NewTodo (route Todos.Index.Submit)
            (params
              (record Submit.Params (filter (ctor Table.Todo.Filter.All))))
            (record NewTodo (title "Milk") (due (ctor Prelude.Maybe.Nothing))))
          (bind task page : { model: Model, session: App.Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
            (test-get (route Todos.Index.Index)
              (record Index.Params (filter (ctor Table.Todo.Filter.All))))
            (pure task
              (test-eq
                (record
                  (answer (field answer (var added)))
                  (todos
                    (call (std List.map)
                      (lambda (t : Table.Todo.Todo) (field title (var t)))
                      (field todos (field model (var page)))))
                  (summary
                    (call (std Test.text) "#summary" (field doc (var page)))))
                (record
                  (answer
                    (ctor Prelude.Answer.Redirected
                      (record
                        (value
                          (route-ref Todos.Index.Index
                            (record Index.Params
                              (filter (ctor Table.Todo.Filter.All))))))))
                  (todos (list "Milk"))
                  (summary (ctor Prelude.Maybe.Just (record (value "1 open")))))))))))))
