(test "Delete removes the todo" task
  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "me@example.com")
        (name "Me")
        (passwordHash "")
        (role (ctor Table.User.Role.Member))))
    (bind task id : Text
      (db-insert Table.Todo.Todo
        (record
          (title "Milk")
          (done False)
          (due (ctor Prelude.Maybe.Nothing))
          (owner (var me))))
      (bind task _
        (test-login
          (record App.Session
            (user (ctor Prelude.Maybe.Just (record (value (var me)))))
            (role (ctor Table.User.Role.Member))))
        (bind task r : { value: Result Text Response, trace: List Text }
          (test-run
            (call (global Todos.Index.Delete.update)
              (record Delete.Params (id (var id)))
              (record Index.Session
                (user (var me))
                (role (ctor Table.User.Role.Member)))))
