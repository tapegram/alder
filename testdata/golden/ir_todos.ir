(module User)
(union User.Role (Member) (Admin))
(record User.User
  (id Text)
  (email Text)
  (name Text)
  (passwordHash Text)
  (created Time)
  (role Role = (ctor User.Role.Member)))
(module Layout)
(component Layout.Page : { title: Text, children: List (Html a) } -> Html a (props)
  (elem html
    (elem head
      (elem meta (attr charset text "utf-8"))
      (elem title (hexpr text (field title (var props))))
      (elem link
        (attr rel text "stylesheet")
        (attr href href (call (std Url.external) "/static/al/al.css")))
      (elem script (attr type text "module") (attr src text "/static/al/al.js"))
      (elem link
        (attr rel text "stylesheet")
        (attr href href (call (std Url.external) "/static/app.css"))))
    (elem body
      (elem al-page (attr width text "narrow")
        (elem main (hexpr list (field children (var props))))))))
(module App)
(record App.Session
  (user Maybe Text)
  (role User.Role = (ctor User.Role.Member)))
(union App.Msg (Logout))
(value App.update : Msg -> Session -> Task Nav (msg session)
  (match union (var msg)
    (case Logout
      (bind task _
        (call (std Session.put)
          (lambda (s : Session)
            (update (var s)
              (user (ctor Prelude.Maybe.Nothing))
              (role (ctor User.Role.Member)))))
        (pure task
          (ctor Prelude.Nav.Redirect
            (record (value (page-ref Auth.Login (record Auth.Login.Params))))))))))
(value App.error : Error -> Html Never (err)
  (comp Layout.Page
    (record (title "Error"))
    (elem h1 (htext "Something went wrong"))
    (elem p (htext "Please try again."))))
(value App.notFound : Html Never ()
  (comp Layout.Page (record (title "Not found")) (elem h1 (htext "Not found"))))
(test "Logout clears the user and goes to log in" task
  (bind task r : { value: Result Text Nav, trace: List Text }
    (test-run
      (call (global App.update)
        (ctor App.Msg.Logout)
        (record Session
          (user (ctor Prelude.Maybe.Just (record (value "me"))))
          (role (ctor User.Role.Admin)))))
    (pure task
      (test-eq
        (record (value (field value (var r))) (trace (field trace (var r))))
        (record
          (value
            (ctor Prelude.Result.Ok
              (record
                (value
                  (ctor Prelude.Nav.Redirect
                    (record
                      (value (page-ref Auth.Login (record Auth.Login.Params)))))))))
          (trace (list "Session.put")))))))
(test "Logout makes the role Member" task
  (bind task me : Text
    (db-insert User.User
      (record
        (email "me@example.com")
        (name "Me")
        (passwordHash "")
        (role (ctor User.Role.Admin))))
    (bind task _
      (test-login
        (record Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor User.Role.Admin))))
      (bind task _
        (test-get Todos.Index
          (record Todos.Index.Params (filter (ctor Todo.Filter.All))))
        (bind task out : { answer: Answer, session: Session, doc: Doc, notices: List Text }
          (test-click App.Logout)
          (pure task
            (test-eq
              (record
                (out (field answer (var out)))
                (role (field role (field session (var out)))))
              (record
                (out
                  (ctor Prelude.Answer.Redirected
                    (record
                      (value (page-ref Auth.Login (record Auth.Login.Params))))))
                (role (ctor User.Role.Member))))))))))
(module Auth.Login)
(record Auth.Login.Model)
(record Auth.Login.Credentials (email Text) (password Text))
(record Auth.Login.Params)
(record Auth.Login.SubmitParams (form Credentials))
(union Auth.Login.Msg (Submit SubmitParams))
(value Auth.Login.load : Params -> App.Session -> Query Model (params session)
  (pure query (record Model)))
(value Auth.Login.update : Msg -> Model -> App.Session -> Task Nav (msg model session)
  (match union (var msg)
    (case Submit (bind _m2 : SubmitParams)
      (let p : SubmitParams
        (var _m2)
        (bind task found : Maybe Text
          (cap Auth.Login.Password verify
            (record
              (email (field email (field form (var p))))
              (password (field password (field form (var p))))))
          (match union (var found)
            (case Just (bind _m1 value : Text)
              (let id : Text
                (var _m1)
                (bind task found : Maybe User
                  (db-get User.User (var id))
                  (let role : User.Role
                    (call (std Maybe.withDefault)
                      (ctor User.Role.Member)
                      (call (std Maybe.map)
                        (lambda (u : User) (field role (var u)))
                        (var found)))
                    (bind task _
                      (call (std Session.put)
                        (lambda (s : App.Session)
                          (update (var s)
                            (user
                              (ctor Prelude.Maybe.Just
                                (record (value (var id)))))
                            (role (var role)))))
                      (pure task
                        (ctor Prelude.Nav.Redirect
                          (record
                            (value
                              (page-ref Todos.Index
                                (record Todos.Index.Params
                                  (filter (ctor Todo.Filter.All)))))))))))))
            (case Nothing
              (pure task
                (ctor Prelude.Nav.Reject
                  (record (value "Email or password is incorrect.")))))))))))
(value Auth.Login.view : Model -> App.Session -> Html Msg (model session)
  (comp Layout.Page
    (record (title "Log in"))
    (elem h1 (htext "Log in"))
    (elem al-card
      (form-el Auth.Login.Submit
        (attr submit submit (ctor Auth.Login.Msg.Submit (record SubmitParams)))
        (input Errors Credentials form)
        (input Input Credentials field=email label="Email" (wrap al-input))
        (input Input Credentials field=password label="Password"
          (wrap al-input))
        (elem al-button (attr type text "submit")
          (elem button (attr type text "submit") (htext "Log in")))))))
(test "an unknown email is rejected" task
  (bind task _
    (test-fake Auth.Login.Password)
    (bind task _
      (test-get Auth.Login (record Params))
      (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
        (test-submit Auth.Login.Credentials Submit
          (record Credentials (email "nobody@example.com") (password "secret")))
        (pure task
          (test-eq
            (record
              (answer (field answer (var r)))
              (user (field user (field session (var r)))))
            (record
              (answer
                (ctor Prelude.Answer.FormRejected
                  (record
                    (value
                      (list
                        (record
                          (field "")
                          (message "Email or password is incorrect.")))))))
              (user (ctor Prelude.Maybe.Nothing)))))))))
(test "logging in through the form" task
  (bind task _
    (test-fake Auth.Login.Password)
    (bind task me : Text
      (db-insert User.User
        (record
          (email "me@example.com")
          (name "Me")
          (passwordHash "")
          (role (ctor User.Role.Member))))
      (bind task _
        (test-get Auth.Login (record Params))
        (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
          (test-submit Auth.Login.Credentials Submit
            (record Credentials (email "me@example.com") (password "secret")))
          (pure task
            (test-eq
              (record
                (answer (field answer (var r)))
                (user (field user (field session (var r))))
                (title (call (std Test.text) "h1" (field doc (var r)))))
              (record
                (answer
                  (ctor Prelude.Answer.Redirected
                    (record
                      (value
                        (page-ref Todos.Index
                          (record Todos.Index.Params
                            (filter (ctor Todo.Filter.All))))))))
                (user (ctor Prelude.Maybe.Just (record (value (var me)))))
                (title (ctor Prelude.Maybe.Just (record (value "Todos"))))))))))))
(test "logging in copies the role from the user's row" task
  (bind task _
    (test-fake Auth.Login.Password)
    (bind task _
      (db-insert User.User
        (record
          (email "admin@example.com")
          (name "Admin")
          (passwordHash "")
          (role (ctor User.Role.Admin))))
      (bind task _
        (test-get Auth.Login (record Params))
        (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
          (test-submit Auth.Login.Credentials Submit
            (record Credentials (email "admin@example.com") (password "secret")))
          (pure task
            (test-eq
              (field role (field session (var r)))
              (ctor User.Role.Admin))))))))
(test "a visitor is sent to log in, and can log out" task
  (bind task me : Text
    (db-insert User.User
      (record
        (email "me@example.com")
        (name "Me")
        (passwordHash "")
        (role (ctor User.Role.Member))))
    (bind task visitor : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
      (test-open Todos.Index
        (record Todos.Index.Params (filter (ctor Todo.Filter.All))))
      (bind task _
        (test-login
          (record App.Session
            (user (ctor Prelude.Maybe.Just (record (value (var me)))))
            (role (ctor User.Role.Member))))
        (bind task _
          (test-get Todos.Index
            (record Todos.Index.Params (filter (ctor Todo.Filter.All))))
          (bind task out : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
            (test-click App.Logout)
            (pure task
              (test-eq
                (record
                  (visitor (field answer (var visitor)))
                  (out (field answer (var out)))
                  (user (field user (field session (var out)))))
                (record
                  (visitor
                    (ctor Prelude.Answer.Redirected
                      (record (value (page-ref Auth.Login (record Params))))))
                  (out
                    (ctor Prelude.Answer.Redirected
                      (record (value (page-ref Auth.Login (record Params))))))
                  (user (ctor Prelude.Maybe.Nothing)))))))))))
(module Todo)
(union Todo.Filter (All) (Active) (Completed))
(record Todo.Todo
  (id Text)
  (title Text)
  (done Bool = False)
  (due Maybe Date)
  (owner Text)
  (created Time))
(value Todo.matches : Filter -> Todo -> Bool (filter todo)
  (match union (var filter)
    (case All True)
    (case Active (call (std Prelude.not) (field done (var todo))))
    (case Completed (field done (var todo)))))
(value Todo.filterLabel : Filter -> Text (filter)
  (match union (var filter)
    (case All "All")
    (case Active "Active")
    (case Completed "Completed")))
(value Todo.countOpen : List Todo -> Int (todos)
  (call (std List.length)
    (call (std List.filter)
      (lambda (t : Todo) (call (std Prelude.not) (field done (var t))))
      (var todos))))
(test "countOpen ignores done todos" pure
  (test-eq
    (call (global Todo.countOpen)
      (list
        (record Todo
          (id "a")
          (title "x")
          (done False)
          (due (ctor Prelude.Maybe.Nothing))
          (owner "u")
          (created (std Time.epoch)))
        (record Todo
          (id "b")
          (title "y")
          (done True)
          (due (ctor Prelude.Maybe.Nothing))
          (owner "u")
          (created (std Time.epoch)))
        (record Todo
          (id "c")
          (title "z")
          (done False)
          (due (ctor Prelude.Maybe.Nothing))
          (owner "u")
          (created (std Time.epoch)))))
    2))
(test "Active keeps only open todos" pure
  (test-eq
    (call (std List.map)
      (lambda (t : Todo) (field title (var t)))
      (call (std List.filter)
        (partial (global Todo.matches) (ctor Todo.Filter.Active) (missing 1))
        (list
          (record Todo
            (id "a")
            (title "x")
            (done False)
            (due (ctor Prelude.Maybe.Nothing))
            (owner "u")
            (created (std Time.epoch)))
          (record Todo
            (id "b")
            (title "y")
            (done True)
            (due (ctor Prelude.Maybe.Nothing))
            (owner "u")
            (created (std Time.epoch))))))
    (list "x")))
(test "each filter has its label" pure
  (test-eq
    (call (std List.map)
      (global Todo.filterLabel)
      (list
        (ctor Todo.Filter.All)
        (ctor Todo.Filter.Active)
        (ctor Todo.Filter.Completed)))
    (list "All" "Active" "Completed")))
(test "a user with todos cannot be deleted" task
  (bind task me : Text
    (db-insert User.User
      (record
        (email "me@example.com")
        (name "Me")
        (passwordHash "")
        (role (ctor User.Role.Member))))
    (bind task id : Text
      (db-insert Todo.Todo
        (record
          (title "Milk")
          (done False)
          (due (ctor Prelude.Maybe.Nothing))
          (owner (var me))))
      (bind task r : { value: Result Text Unit, trace: List Text }
        (test-run (db-delete User.User (var me)))
        (bind task after : Maybe Todo
          (db-get Todo.Todo (var id))
          (pure task
            (test-eq
              (record
                (deleted (call (std Result.toMaybe) (field value (var r))))
                (todo
                  (call (std Maybe.map)
                    (lambda (t : Todo) (field title (var t)))
                    (var after))))
              (record
                (deleted (ctor Prelude.Maybe.Nothing))
                (todo (ctor Prelude.Maybe.Just (record (value "Milk"))))))))))))
(module Todos.Index)
(record Todos.Index.Model (filter Todo.Filter) (todos List Todo))
(record Todos.Index.NewTodo (title Text) (due Maybe Date))
(record Todos.Index.Params (filter Todo.Filter = (ctor Todo.Filter.All)))
(record Todos.Index.SubmitParams (form NewTodo))
(record Todos.Index.ToggleParams (id Text))
(record Todos.Index.DeleteParams (id Text))
(union Todos.Index.Msg
  (Submit SubmitParams)
  (Toggle ToggleParams)
  (Delete DeleteParams))
(record Todos.Index.Session (user Text) (role User.Role))
(value Todos.Index.load : Params -> Session -> Query Model (params session)
  (bind query todos : List Todo
    (db-select Todo.Todo
      (base (db-scoped Db.mine user Todo.Todo))
      (order (ord (col Todo.Todo created) desc))
      all)
    (pure query
      (record Model
        (filter (field filter (var params)))
        (todos
          (call (std List.filter)
            (partial (global Todo.matches)
              (field filter (var params))
              (missing 1))
            (var todos)))))))
(value Todos.Index.update : Msg -> Model -> Session -> Task Nav (msg model session)
  (match union (var msg)
    (case Submit (bind _m1 : SubmitParams)
      (let p : SubmitParams
        (var _m1)
        (bind task _
          (db-insert-scoped Db.insertMine user Todo.Todo
            (record
              (title (field title (field form (var p))))
              (done False)
              (due (field due (field form (var p))))))
          (pure task
            (ctor Prelude.Nav.Redirect
              (record
                (value
                  (page-ref Todos.Index
                    (record Params (filter (field filter (var model))))))))))))
    (case Toggle (bind _m2 : ToggleParams)
      (let p : ToggleParams
        (var _m2)
        (bind task _
          (db-update-scoped Db.updateMine user Todo.Todo
            (field id (var p))
            (lambda (t : Todo)
              (update (var t)
                (done (call (std Prelude.not) (field done (var t)))))))
          (pure task (ctor Prelude.Nav.Rerender)))))
    (case Delete (bind _m3 : DeleteParams)
      (let p : DeleteParams
        (var _m3)
        (bind task _
          (db-delete-scoped Db.deleteMine user Todo.Todo (field id (var p)))
          (pure task (ctor Prelude.Nav.Rerender)))))))
(value Todos.Index.view : Model -> Session -> Html Msg (model session)
  (comp Layout.Page
    (record (title "Todos"))
    (elem h1 (htext "Todos"))
    (elem al-card
      (form-el Todos.Index.Submit
        (attr submit submit (ctor Todos.Index.Msg.Submit (record SubmitParams)))
        (input Input NewTodo field=title label="What needs doing?"
          (wrap al-input))
        (input Input NewTodo field=due label="Due" (wrap al-input))
        (elem al-button (attr type text "submit")
          (elem button (attr type text "submit") (htext "Add")))))
    (elem nav
      (hfor f : Todo.Filter
        (list
          (ctor Todo.Filter.All)
          (ctor Todo.Filter.Active)
          (ctor Todo.Filter.Completed))
        (elem a
          (attr href href
            (page-ref Todos.Index (record Params (filter (var f)))))
          (attr aria-current maybe
            (if (== : Todo.Filter (field filter (var model)) (var f))
              (ctor Prelude.Maybe.Just (record (value "page")))
              (ctor Prelude.Maybe.Nothing)))
          (hexpr text (call (global Todo.filterLabel) (var f))))))
    (elem ul (attr id text "todos")
      (hfor todo : Todo
        (field todos (var model))
        (comp Todos.Index.Item (record (todo (var todo))))))
    (elem p (attr id text "summary")
      (hexpr text
        (call (std Text.fromInt)
          (call (global Todo.countOpen) (field todos (var model)))))
      (htext " open"))
    (elem al-button (attr variant text "outline")
      (elem button
        (attr type text "button")
        (attr click click (ctor App.Msg.Logout))
        (htext "Log out")))))
(component Todos.Index.Item : { todo: Todo } -> Html Msg (props)
  (elem li
    (attr class text (if (field done (field todo (var props))) "done" ""))
    (elem al-button (attr variant text "secondary") (attr size text "sm")
      (elem button
        (attr type text "button")
        (attr click click
          (ctor Todos.Index.Msg.Toggle
            (record ToggleParams (id (field id (field todo (var props)))))))
        (hif (field done (field todo (var props)))
          (hexpr text "Undo")
          (hexpr text "Done"))))
    (elem a
      (attr href href
        (page-ref Todos.Show
          (record Todos.Show.Params (id (field id (field todo (var props)))))))
      (hexpr text (field title (field todo (var props)))))
    (hmatch union (field due (field todo (var props)))
      (case Just (bind _m1 value : Date)
        (let d : Date
          (var _m1)
          (elem al-badge (attr variant text "outline") (attr class text "due")
            (hexpr text (call (std Date.format) "Jan 2" (var d))))))
      (case Nothing (hexpr html (std Html.none))))
    (elem al-button (attr variant text "ghost") (attr size text "sm")
      (elem button
        (attr type text "button")
        (attr click click
          (ctor Todos.Index.Msg.Delete
            (record DeleteParams (id (field id (field todo (var props)))))))
        (htext "Delete")))))
(test "Toggle flips done" task
  (bind task me : Text
    (db-insert User.User
      (record
        (email "me@example.com")
        (name "Me")
        (passwordHash "")
        (role (ctor User.Role.Member))))
    (bind task id : Text
      (db-insert Todo.Todo
        (record
          (title "Milk")
          (done False)
          (due (ctor Prelude.Maybe.Nothing))
          (owner (var me))))
      (bind task _
        (test-login
          (record App.Session
            (user (ctor Prelude.Maybe.Just (record (value (var me)))))
            (role (ctor User.Role.Member))))
        (bind task r : { value: Result Text Nav, trace: List Text }
          (test-run
            (call (global Todos.Index.update)
              (ctor Todos.Index.Msg.Toggle (record ToggleParams (id (var id))))
              (record Model (filter (ctor Todo.Filter.All)) (todos (list)))
              (record Session (user (var me)) (role (ctor User.Role.Member)))))
          (bind task after : Maybe Todo
            (db-get Todo.Todo (var id))
            (let done : Maybe Bool
              (call (std Maybe.map)
                (lambda (t : Todo) (field done (var t)))
                (var after))
              (pure task
                (test-eq
                  (record (trace (field trace (var r))) (done (var done)))
                  (record
                    (trace (list "Db.updateMine Todo"))
                    (done (ctor Prelude.Maybe.Just (record (value True))))))))))))))
(test "Toggle by another user is not found" task
  (bind task me : Text
    (db-insert User.User
      (record
        (email "me@example.com")
        (name "Me")
        (passwordHash "")
        (role (ctor User.Role.Member))))
    (bind task id : Text
      (db-insert Todo.Todo
        (record
          (title "Milk")
          (done False)
          (due (ctor Prelude.Maybe.Nothing))
          (owner (var me))))
      (bind task _
        (test-login
          (record App.Session
            (user (ctor Prelude.Maybe.Just (record (value (var me)))))
            (role (ctor User.Role.Member))))
        (bind task _
          (test-get Todos.Index (record Params (filter (ctor Todo.Filter.All))))
          (bind task _
            (test-login
              (record App.Session
                (user (ctor Prelude.Maybe.Just (record (value "someone-else"))))
                (role (ctor User.Role.Member))))
            (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
              (test-click Todos.Index.Toggle
                (record ToggleParams (id (var id))))
              (bind task after : Maybe Todo
                (db-get Todo.Todo (var id))
                (pure task
                  (test-eq
                    (record
                      (answer (field answer (var r)))
                      (done
                        (call (std Maybe.map)
                          (lambda (t : Todo) (field done (var t)))
                          (var after))))
                    (record
                      (answer (ctor Prelude.Answer.PageMissing))
                      (done (ctor Prelude.Maybe.Just (record (value False)))))))))))))))
(test "Delete by another user is not found" task
  (bind task me : Text
    (db-insert User.User
      (record
        (email "me@example.com")
        (name "Me")
        (passwordHash "")
        (role (ctor User.Role.Member))))
    (bind task id : Text
      (db-insert Todo.Todo
        (record
          (title "Milk")
          (done False)
          (due (ctor Prelude.Maybe.Nothing))
          (owner (var me))))
      (bind task _
        (test-login
          (record App.Session
            (user (ctor Prelude.Maybe.Just (record (value (var me)))))
            (role (ctor User.Role.Member))))
        (bind task _
          (test-get Todos.Index (record Params (filter (ctor Todo.Filter.All))))
          (bind task _
            (test-login
              (record App.Session
                (user (ctor Prelude.Maybe.Just (record (value "someone-else"))))
                (role (ctor User.Role.Member))))
            (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
              (test-click Todos.Index.Delete
                (record DeleteParams (id (var id))))
              (bind task after : Maybe Todo
                (db-get Todo.Todo (var id))
                (pure task
                  (test-eq
                    (record
                      (answer (field answer (var r)))
                      (todo
                        (call (std Maybe.map)
                          (lambda (t : Todo) (field title (var t)))
                          (var after))))
                    (record
                      (answer (ctor Prelude.Answer.PageMissing))
                      (todo (ctor Prelude.Maybe.Just (record (value "Milk")))))))))))))))
(test "adding a todo through the page" task
  (bind task me : Text
    (db-insert User.User
      (record
        (email "me@example.com")
        (name "Me")
        (passwordHash "")
        (role (ctor User.Role.Member))))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor User.Role.Member))))
      (bind task _
        (test-get Todos.Index (record Params (filter (ctor Todo.Filter.All))))
        (bind task added : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
          (test-submit Todos.Index.NewTodo Submit
            (record NewTodo (title "Milk") (due (ctor Prelude.Maybe.Nothing))))
          (bind task page : { model: Model, session: App.Session, doc: Doc, notices: List Text }
            (test-get Todos.Index
              (record Params (filter (ctor Todo.Filter.All))))
            (pure task
              (test-eq
                (record
                  (answer (field answer (var added)))
                  (todos
                    (call (std List.map)
                      (lambda (t : Todo) (field title (var t)))
                      (field todos (field model (var page)))))
                  (summary
                    (call (std Test.text) "#summary" (field doc (var page)))))
                (record
                  (answer
                    (ctor Prelude.Answer.Redirected
                      (record
                        (value
                          (page-ref Todos.Index
                            (record Params (filter (ctor Todo.Filter.All))))))))
                  (todos (list "Milk"))
                  (summary (ctor Prelude.Maybe.Just (record (value "1 open")))))))))))))
(test "toggling a todo through the page" task
  (bind task me : Text
    (db-insert User.User
      (record
        (email "me@example.com")
        (name "Me")
        (passwordHash "")
        (role (ctor User.Role.Member))))
    (bind task id : Text
      (db-insert Todo.Todo
        (record
          (title "Milk")
          (done False)
          (due (ctor Prelude.Maybe.Nothing))
          (owner (var me))))
      (bind task _
        (test-login
          (record App.Session
            (user (ctor Prelude.Maybe.Just (record (value (var me)))))
            (role (ctor User.Role.Member))))
        (bind task _
          (test-get Todos.Index (record Params (filter (ctor Todo.Filter.All))))
          (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
            (test-click Todos.Index.Toggle (record ToggleParams (id (var id))))
            (pure task
              (test-eq
                (record
                  (answer (field answer (var r)))
                  (done (call (std Test.has) "li.done" (field doc (var r))))
                  (summary
                    (call (std Test.text) "#summary" (field doc (var r)))))
                (record
                  (answer (ctor Prelude.Answer.Rerendered))
                  (done True)
                  (summary (ctor Prelude.Maybe.Just (record (value "0 open")))))))))))))
(test "a stranger cannot see my todo" task
  (bind task me : Text
    (db-insert User.User
      (record
        (email "me@example.com")
        (name "Me")
        (passwordHash "")
        (role (ctor User.Role.Member))))
    (bind task id : Text
      (db-insert Todo.Todo
        (record
          (title "Milk")
          (done False)
          (due (ctor Prelude.Maybe.Nothing))
          (owner (var me))))
      (bind task _
        (test-login
          (record App.Session
            (user (ctor Prelude.Maybe.Just (record (value "someone-else"))))
            (role (ctor User.Role.Member))))
        (bind task page : { model: Model, session: App.Session, doc: Doc, notices: List Text }
          (test-get Todos.Index (record Params (filter (ctor Todo.Filter.All))))
          (bind task show : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
            (test-open Todos.Show (record Todos.Show.Params (id (var id))))
            (pure task
              (test-eq
                (record
                  (items (call (std Test.count) "li" (field doc (var page))))
                  (show (field answer (var show))))
                (record (items 0) (show (ctor Prelude.Answer.PageMissing)))))))))))
(test "Delete removes the todo" task
  (bind task me : Text
    (db-insert User.User
      (record
        (email "me@example.com")
        (name "Me")
        (passwordHash "")
        (role (ctor User.Role.Member))))
    (bind task id : Text
      (db-insert Todo.Todo
        (record
          (title "Milk")
          (done False)
          (due (ctor Prelude.Maybe.Nothing))
          (owner (var me))))
      (bind task _
        (test-login
          (record App.Session
            (user (ctor Prelude.Maybe.Just (record (value (var me)))))
            (role (ctor User.Role.Member))))
        (bind task r : { value: Result Text Nav, trace: List Text }
          (test-run
            (call (global Todos.Index.update)
              (ctor Todos.Index.Msg.Delete (record DeleteParams (id (var id))))
              (record Model (filter (ctor Todo.Filter.All)) (todos (list)))
              (record Session (user (var me)) (role (ctor User.Role.Member)))))
          (bind task after : Maybe Todo
            (db-get Todo.Todo (var id))
            (pure task
              (test-eq
                (record
                  (value (field value (var r)))
                  (todo
                    (call (std Maybe.map)
                      (lambda (t : Todo) (field title (var t)))
                      (var after))))
                (record
                  (value
                    (ctor Prelude.Result.Ok
                      (record (value (ctor Prelude.Nav.Rerender)))))
                  (todo (ctor Prelude.Maybe.Nothing)))))))))))
