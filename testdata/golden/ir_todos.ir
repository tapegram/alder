(module User)
(record User.User
  (id Text)
  (email Text)
  (name Text)
  (passwordHash Text)
  (created Time))
(module Layout)
(component Layout.Page : { title: Text, children: List (Html a) } -> Html a (props)
  (elem html
    (elem head
      (elem meta (attr charset text "utf-8"))
      (elem title (hexpr text (field title (var props))))
      (elem link
        (attr rel text "stylesheet")
        (attr href href (call (std Url.external) "/static/app.css"))))
    (elem body (elem main (hexpr list (field children (var props)))))))
(module App)
(record App.Session (user Maybe Text))
(union App.Msg (Logout))
(value App.update : Msg -> Session -> Task Nav (msg session)
  (match union (var msg)
    (case Logout
      (bind task _
        (call (std Session.put)
          (lambda (s : Session)
            (update (var s) (user (ctor Prelude.Maybe.Nothing)))))
        (pure task
          (ctor Prelude.Nav.Redirect
            (record (value (page-ref Auth.Login (record Auth.Login.Params))))))))))
(value App.error : Error -> Html Never (err)
  (comp Layout.Page
    (record (title "Error"))
    (elem h1 (htext "Something went wrong"))
    (elem p (htext "Please try again."))))
(value App.notFound : Html Never ()
  (comp Layout.Page (record (title "Not found")) (elem h1 (htext "Not found"))))
(module Auth.Login)
(record Auth.Login.Model)
(record Auth.Login.Credentials (email Text) (password Text))
(record Auth.Login.Params)
(record Auth.Login.SubmitParams (form Credentials))
(union Auth.Login.Msg (Submit SubmitParams))
(value Auth.Login.load : Params -> App.Session -> Query Model (params session)
  (pure query (record Model)))
(value Auth.Login.update : Msg -> Model -> App.Session -> Task Nav (msg model session)
  (match union (var msg)
    (case Submit (bind _m2 : SubmitParams)
      (let p : SubmitParams
        (var _m2)
        (bind task found : Maybe Text
          (cap Auth.Login.Password verify
            (record
              (email (field email (field form (var p))))
              (password (field password (field form (var p))))))
          (match union (var found)
            (case Just (bind _m1 value : Text)
              (let id : Text
                (var _m1)
                (bind task _
                  (call (std Session.put)
                    (lambda (s : App.Session)
                      (update (var s)
                        (user
                          (ctor Prelude.Maybe.Just (record (value (var id))))))))
                  (pure task
                    (ctor Prelude.Nav.Redirect
                      (record
                        (value
                          (page-ref Todos.Index
                            (record Todos.Index.Params
                              (filter (ctor Todo.Filter.All)))))))))))
            (case Nothing
              (pure task
                (ctor Prelude.Nav.Reject
                  (record (value "Email or password is incorrect.")))))))))))
(value Auth.Login.view : Model -> App.Session -> Html Msg (model session)
  (comp Layout.Page
    (record (title "Log in"))
    (elem h1 (htext "Log in"))
    (form-el Auth.Login.Submit
      (attr submit submit (ctor Auth.Login.Msg.Submit (record SubmitParams)))
      (input Errors Credentials form)
      (input Input Credentials field=email label="Email")
      (input Errors Credentials field=email)
      (input Input Credentials field=password label="Password")
      (input Errors Credentials field=password)
      (elem button (htext "Log in")))))
(test "an unknown email is rejected" task
  (bind task _
    (test-fake Auth.Login.Password)
    (bind task _
      (test-get Auth.Login (record Params))
      (bind task r : { answer: Answer, session: App.Session, doc: Doc }
        (test-submit Auth.Login.Credentials Submit
          (record Credentials (email "nobody@example.com") (password "secret")))
        (pure task
          (test-eq
            (record
              (answer (field answer (var r)))
              (user (field user (field session (var r)))))
            (record
              (answer
                (ctor Prelude.Answer.FormRejected
                  (record
                    (value
                      (list
                        (record
                          (field "")
                          (message "Email or password is incorrect.")))))))
              (user (ctor Prelude.Maybe.Nothing)))))))))
(test "logging in through the form" task
  (bind task _
    (test-fake Auth.Login.Password)
    (bind task me : Text
      (db-insert User.User
        (record (email "me@example.com") (name "Me") (passwordHash "")))
      (bind task _
        (test-get Auth.Login (record Params))
        (bind task r : { answer: Answer, session: App.Session, doc: Doc }
          (test-submit Auth.Login.Credentials Submit
            (record Credentials (email "me@example.com") (password "secret")))
          (pure task
            (test-eq
              (record
                (answer (field answer (var r)))
                (user (field user (field session (var r))))
                (title (call (std Test.text) "h1" (field doc (var r)))))
              (record
                (answer
                  (ctor Prelude.Answer.Redirected
                    (record
                      (value
                        (page-ref Todos.Index
                          (record Todos.Index.Params
                            (filter (ctor Todo.Filter.All))))))))
                (user (ctor Prelude.Maybe.Just (record (value (var me)))))
                (title (ctor Prelude.Maybe.Just (record (value "Todos"))))))))))))
(test "a visitor is sent to log in, and can log out" task
  (bind task me : Text
    (db-insert User.User
      (record (email "me@example.com") (name "Me") (passwordHash "")))
    (bind task visitor : { answer: Answer, session: App.Session, doc: Doc }
      (test-open Todos.Index
        (record Todos.Index.Params (filter (ctor Todo.Filter.All))))
      (bind task _
        (test-login
          (record App.Session
            (user (ctor Prelude.Maybe.Just (record (value (var me)))))))
        (bind task _
          (test-get Todos.Index
            (record Todos.Index.Params (filter (ctor Todo.Filter.All))))
          (bind task out : { answer: Answer, session: App.Session, doc: Doc }
            (test-click App.Logout)
            (pure task
              (test-eq
                (record
                  (visitor (field answer (var visitor)))
                  (out (field answer (var out)))
                  (user (field user (field session (var out)))))
                (record
                  (visitor
                    (ctor Prelude.Answer.Redirected
                      (record (value (page-ref Auth.Login (record Params))))))
                  (out
                    (ctor Prelude.Answer.Redirected
                      (record (value (page-ref Auth.Login (record Params))))))
                  (user (ctor Prelude.Maybe.Nothing)))))))))))
(module Todo)
(union Todo.Filter (All) (Active) (Completed))
(record Todo.Todo
  (id Text)
  (title Text)
  (done Bool = False)
  (due Maybe Date)
  (owner Text)
  (created Time))
(value Todo.matches : Filter -> Todo -> Bool (filter todo)
  (match union (var filter)
    (case All True)
    (case Active (call (std Prelude.not) (field done (var todo))))
    (case Completed (field done (var todo)))))
(value Todo.filterLabel : Filter -> Text (filter)
  (match union (var filter)
    (case All "All")
    (case Active "Active")
    (case Completed "Completed")))
(value Todo.countOpen : List Todo -> Int (todos)
  (call (std List.length)
    (call (std List.filter)
      (lambda (t : Todo) (call (std Prelude.not) (field done (var t))))
      (var todos))))
(test "countOpen ignores done todos" pure
  (test-eq
    (call (global Todo.countOpen)
      (list
        (record Todo
          (id "a")
          (title "x")
          (done False)
          (due (ctor Prelude.Maybe.Nothing))
          (owner "u")
          (created (std Time.epoch)))
        (record Todo
          (id "b")
          (title "y")
          (done True)
          (due (ctor Prelude.Maybe.Nothing))
          (owner "u")
          (created (std Time.epoch)))))
    1))
(module Todos.Index)
(record Todos.Index.Model (filter Todo.Filter) (todos List Todo))
(record Todos.Index.NewTodo (title Text) (due Maybe Date))
(record Todos.Index.Params (filter Todo.Filter = (ctor Todo.Filter.All)))
(record Todos.Index.SubmitParams (form NewTodo))
(record Todos.Index.ToggleParams (id Text))
(record Todos.Index.DeleteParams (id Text))
(union Todos.Index.Msg
  (Submit SubmitParams)
  (Toggle ToggleParams)
  (Delete DeleteParams))
(record Todos.Index.Session (user Text))
(value Todos.Index.load : Params -> Session -> Query Model (params session)
  (bind query todos : List Todo
    (db-select Todo.Todo
      (where (cond eq (col Todo.Todo owner) (field user (var session))))
      (order (ord (col Todo.Todo created) desc))
      all)
    (pure query
      (record Model
        (filter (field filter (var params)))
        (todos
          (call (std List.filter)
            (partial (global Todo.matches)
              (field filter (var params))
              (missing 1))
            (var todos)))))))
(value Todos.Index.update : Msg -> Model -> Session -> Task Nav (msg model session)
  (match union (var msg)
    (case Submit (bind _m1 : SubmitParams)
      (let p : SubmitParams
        (var _m1)
        (bind task _
          (db-insert Todo.Todo
            (record
              (title (field title (field form (var p))))
              (done False)
              (due (field due (field form (var p))))
              (owner (field user (var session)))))
          (pure task
            (ctor Prelude.Nav.Redirect
              (record
                (value
                  (page-ref Todos.Index
                    (record Params (filter (field filter (var model))))))))))))
    (case Toggle (bind _m2 : ToggleParams)
      (let p : ToggleParams
        (var _m2)
        (bind task todo : Todo
          (call (global Todos.Index.owned) (field id (var p)) (var session))
          (bind task _
            (db-update Todo.Todo
              (field id (var todo))
              (lambda (t : Todo)
                (update (var t)
                  (done (call (std Prelude.not) (field done (var t)))))))
            (pure task (ctor Prelude.Nav.Rerender))))))
    (case Delete (bind _m3 : DeleteParams)
      (let p : DeleteParams
        (var _m3)
        (bind task todo : Todo
          (call (global Todos.Index.owned) (field id (var p)) (var session))
          (bind task _
            (db-delete Todo.Todo (field id (var todo)))
            (pure task (ctor Prelude.Nav.Rerender))))))))
(value Todos.Index.owned : Text -> Session -> Task Todo (id session)
  (bind task found : Maybe Todo
    (db-get Todo.Todo (var id))
    (match union (var found)
      (case Just (bind _m1 value : Todo)
        (let todo : Todo
          (var _m1)
          (if (== : Text (field owner (var todo)) (field user (var session)))
            (pure task (var todo))
            (not-found))))
      (case Nothing (not-found)))))
(value Todos.Index.view : Model -> Session -> Html Msg (model session)
  (comp Layout.Page
    (record (title "Todos"))
    (elem h1 (htext "Todos"))
    (form-el Todos.Index.Submit
      (attr submit submit (ctor Todos.Index.Msg.Submit (record SubmitParams)))
      (input Input NewTodo field=title label="What needs doing?")
      (input Errors NewTodo field=title)
      (input Input NewTodo field=due label="Due")
      (input Errors NewTodo field=due)
      (elem button (htext "Add")))
    (elem nav
      (hfor f : Todo.Filter
        (list
          (ctor Todo.Filter.All)
          (ctor Todo.Filter.Active)
          (ctor Todo.Filter.Completed))
        (elem a
          (attr href href
            (page-ref Todos.Index (record Params (filter (var f)))))
          (attr aria-current maybe
            (if (== : Todo.Filter (field filter (var model)) (var f))
              (ctor Prelude.Maybe.Just (record (value "page")))
              (ctor Prelude.Maybe.Nothing)))
          (hexpr text (call (global Todo.filterLabel) (var f))))))
    (elem ul (attr id text "todos")
      (hfor todo : Todo
        (field todos (var model))
        (comp Todos.Index.Item (record (todo (var todo))))))
    (elem p (attr id text "summary")
      (hexpr text
        (call (std Text.fromInt)
          (call (global Todo.countOpen) (field todos (var model)))))
      (htext " open"))
    (elem button (attr click click (ctor App.Msg.Logout)) (htext "Log out"))))
(component Todos.Index.Item : { todo: Todo } -> Html Msg (props)
  (elem li
    (attr class text (if (field done (field todo (var props))) "done" ""))
    (elem button
      (attr click click
        (ctor Todos.Index.Msg.Toggle
          (record ToggleParams (id (field id (field todo (var props)))))))
      (hif (field done (field todo (var props)))
        (hexpr text "Undo")
        (hexpr text "Done")))
    (elem a
      (attr href href
        (page-ref Todos.Show
          (record Todos.Show.Params (id (field id (field todo (var props)))))))
      (hexpr text (field title (field todo (var props)))))
    (hmatch union (field due (field todo (var props)))
      (case Just (bind _m1 value : Date)
        (let d : Date
          (var _m1)
          (elem span (attr class text "due")
            (hexpr text (call (std Date.format) "Jan 2" (var d))))))
      (case Nothing (hexpr html (std Html.none))))
    (elem button
      (attr click click
        (ctor Todos.Index.Msg.Delete
          (record DeleteParams (id (field id (field todo (var props)))))))
      (htext "Delete"))))
(test "Toggle flips done" task
  (bind task me : Text
    (db-insert User.User
      (record (email "me@example.com") (name "Me") (passwordHash "")))
    (bind task id : Text
      (db-insert Todo.Todo
        (record
          (title "Milk")
          (done False)
          (due (ctor Prelude.Maybe.Nothing))
          (owner (var me))))
      (bind task r : { value: Result Text Nav, trace: List Text }
        (test-run
          (call (global Todos.Index.update)
            (ctor Todos.Index.Msg.Toggle (record ToggleParams (id (var id))))
            (record Model (filter (ctor Todo.Filter.All)) (todos (list)))
            (record Session (user (var me)))))
        (bind task after : Maybe Todo
          (db-get Todo.Todo (var id))
          (let done : Maybe Bool
            (call (std Maybe.map)
              (lambda (t : Todo) (field done (var t)))
              (var after))
            (pure task
              (test-eq
                (record (trace (field trace (var r))) (done (var done)))
                (record
                  (trace (list "Db.get Todo" "Db.update Todo"))
                  (done (ctor Prelude.Maybe.Just (record (value True)))))))))))))
(test "Toggle by another user is not found" task
  (bind task me : Text
    (db-insert User.User
      (record (email "me@example.com") (name "Me") (passwordHash "")))
    (bind task id : Text
      (db-insert Todo.Todo
        (record
          (title "Milk")
          (done False)
          (due (ctor Prelude.Maybe.Nothing))
          (owner (var me))))
      (let stranger : Text
        "someone-else"
        (bind task r : { value: Result Text Nav, trace: List Text }
          (test-run
            (call (global Todos.Index.update)
              (ctor Todos.Index.Msg.Toggle (record ToggleParams (id (var id))))
              (record Model (filter (ctor Todo.Filter.All)) (todos (list)))
              (record Session (user (var stranger)))))
          (bind task after : Maybe Todo
            (db-get Todo.Todo (var id))
            (let done : Maybe Bool
              (call (std Maybe.map)
                (lambda (t : Todo) (field done (var t)))
                (var after))
              (pure task
                (test-eq
                  (record
                    (value (field value (var r)))
                    (trace (field trace (var r)))
                    (done (var done)))
                  (record
                    (value
                      (ctor Prelude.Result.Err (record (value "not found"))))
                    (trace (list "Db.get Todo"))
                    (done (ctor Prelude.Maybe.Just (record (value False))))))))))))))
(test "adding a todo through the page" task
  (bind task me : Text
    (db-insert User.User
      (record (email "me@example.com") (name "Me") (passwordHash "")))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))))
      (bind task _
        (test-get Todos.Index (record Params (filter (ctor Todo.Filter.All))))
        (bind task added : { answer: Answer, session: App.Session, doc: Doc }
          (test-submit Todos.Index.NewTodo Submit
            (record NewTodo (title "Milk") (due (ctor Prelude.Maybe.Nothing))))
          (bind task page : { model: Model, session: App.Session, doc: Doc }
            (test-get Todos.Index
              (record Params (filter (ctor Todo.Filter.All))))
            (pure task
              (test-eq
                (record
                  (answer (field answer (var added)))
                  (todos
                    (call (std List.map)
                      (lambda (t : Todo) (field title (var t)))
                      (field todos (field model (var page)))))
                  (summary
                    (call (std Test.text) "#summary" (field doc (var page)))))
                (record
                  (answer
                    (ctor Prelude.Answer.Redirected
                      (record
                        (value
                          (page-ref Todos.Index
                            (record Params (filter (ctor Todo.Filter.All))))))))
                  (todos (list "Milk"))
                  (summary (ctor Prelude.Maybe.Just (record (value "1 open")))))))))))))
(test "toggling a todo through the page" task
  (bind task me : Text
    (db-insert User.User
      (record (email "me@example.com") (name "Me") (passwordHash "")))
    (bind task id : Text
      (db-insert Todo.Todo
        (record
          (title "Milk")
          (done False)
          (due (ctor Prelude.Maybe.Nothing))
          (owner (var me))))
      (bind task _
        (test-login
          (record App.Session
            (user (ctor Prelude.Maybe.Just (record (value (var me)))))))
        (bind task _
          (test-get Todos.Index (record Params (filter (ctor Todo.Filter.All))))
          (bind task r : { answer: Answer, session: App.Session, doc: Doc }
            (test-click Todos.Index.Toggle (record ToggleParams (id (var id))))
            (pure task
              (test-eq
                (record
                  (answer (field answer (var r)))
                  (done (call (std Test.has) "li.done" (field doc (var r))))
                  (summary
                    (call (std Test.text) "#summary" (field doc (var r)))))
                (record
                  (answer (ctor Prelude.Answer.Rerendered))
                  (done True)
                  (summary (ctor Prelude.Maybe.Just (record (value "0 open")))))))))))))
(test "a stranger cannot see my todo" task
  (bind task me : Text
    (db-insert User.User
      (record (email "me@example.com") (name "Me") (passwordHash "")))
    (bind task id : Text
      (db-insert Todo.Todo
        (record
          (title "Milk")
          (done False)
          (due (ctor Prelude.Maybe.Nothing))
          (owner (var me))))
      (bind task _
        (test-login
          (record App.Session
            (user (ctor Prelude.Maybe.Just (record (value "someone-else"))))))
        (bind task page : { model: Model, session: App.Session, doc: Doc }
          (test-get Todos.Index (record Params (filter (ctor Todo.Filter.All))))
          (bind task show : { answer: Answer, session: App.Session, doc: Doc }
            (test-open Todos.Show (record Todos.Show.Params (id (var id))))
            (pure task
              (test-eq
                (record
                  (items (call (std Test.count) "li" (field doc (var page))))
                  (show (field answer (var show))))
                (record (items 0) (show (ctor Prelude.Answer.PageMissing)))))))))))
(module Todos.Show)
(record Todos.Show.Model (todo Todo))
(record Todos.Show.EditTodo (title Text) (due Maybe Date))
(record Todos.Show.Params (id Text))
(record Todos.Show.SaveParams (form EditTodo))
(union Todos.Show.Msg (Save SaveParams) (Delete))
(record Todos.Show.Session (user Text))
(value Todos.Show.load : Params -> Session -> Query Model (params session)
  (bind query found : Maybe Todo
    (db-get Todo.Todo (field id (var params)))
    (match union (var found)
      (case Just (bind _m1 value : Todo)
        (let todo : Todo
          (var _m1)
          (if (== : Text (field owner (var todo)) (field user (var session)))
            (pure query (record Model (todo (var todo))))
            (not-found))))
      (case Nothing (not-found)))))
(value Todos.Show.update : Msg -> Model -> Session -> Task Nav (msg model session)
  (match union (var msg)
    (case Save (bind _m1 : SaveParams)
      (let p : SaveParams
        (var _m1)
        (bind task _
          (db-update Todo.Todo
            (field id (field todo (var model)))
            (lambda (t : Todo)
              (update (var t)
                (title (field title (field form (var p))))
                (due (field due (field form (var p)))))))
          (pure task
            (ctor Prelude.Nav.Redirect
              (record
                (value
                  (page-ref Todos.Index
                    (record Todos.Index.Params (filter (ctor Todo.Filter.All)))))))))))
    (case Delete
      (bind task _
        (db-delete Todo.Todo (field id (field todo (var model))))
        (pure task
          (ctor Prelude.Nav.Redirect
            (record
              (value
                (page-ref Todos.Index
                  (record Todos.Index.Params (filter (ctor Todo.Filter.All))))))))))))
(value Todos.Show.view : Model -> Session -> Html Msg (model session)
  (comp Layout.Page
    (record (title (field title (field todo (var model)))))
    (elem h1 (hexpr text (field title (field todo (var model)))))
    (form-el Todos.Show.Save
      (attr submit submit (ctor Todos.Show.Msg.Save (record SaveParams)))
      (input Input EditTodo field=title label="Title"
        (value (field title (field todo (var model)))))
      (input Errors EditTodo field=title)
      (input Input EditTodo field=due label="Due"
        (value (field due (field todo (var model)))))
      (input Errors EditTodo field=due)
      (elem button (htext "Save")))
    (elem button (attr click click (ctor Todos.Show.Msg.Delete))
      (htext "Delete"))
    (elem a
      (attr href href
        (page-ref Todos.Index
          (record Todos.Index.Params (filter (ctor Todo.Filter.All)))))
      (htext "Back"))))
(table User.User
  (id id)
  (created created)
  (unique email)
  (insert email name passwordHash))
(table Todo.Todo
  (id id)
  (created created)
  (ref owner User.User)
  (insert title done due owner))
(form Auth.Login.Credentials)
(form Todos.Index.NewTodo)
(form Todos.Show.EditTodo)
(page Auth.Login "/login"
  (params Params)
  (model Model)
  (msg Submit (params SubmitParams) (form Credentials))
  (view Auth.Login.view)
  (load Auth.Login.load)
  (update Auth.Login.update))
(page Todos.Index "/"
  (params Params)
  (requires user)
  (session Session)
  (model Model)
  (msg Submit (params SubmitParams) (form NewTodo))
  (msg Toggle (params ToggleParams))
  (msg Delete (params DeleteParams))
  (view Todos.Index.view)
  (load Todos.Index.load)
  (update Todos.Index.update))
(page Todos.Show "/todos/{id}"
  (params Params)
  (requires user)
  (session Session)
  (model Model)
  (msg Save (params SaveParams) (form EditTodo))
  (msg Delete)
  (view Todos.Show.view)
  (load Todos.Show.load)
  (update Todos.Show.update))
(app-msg Logout)
(app-update App.update)
(session App.Session)
(capability Auth.Login.Password
  (verify { email: Text, password: Text } -> Task (Maybe Text)))
(fake Auth.Login.Password
  (tables)
  (entries
    (entry Auth.Login.verify : { email: Text, password: Text } -> Task (Maybe Text) (args)
      (bind task found : Maybe User
        (db-select User.User
          (where (cond eq (col User.User email) (field email (var args))))
          first)
        (pure task
          (call (std Maybe.map)
            (lambda (u : User) (field id (var u)))
            (var found)))))))
