  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "me@example.com")
        (name "Me")
        (passwordHash "")
        (role (ctor Table.User.Role.Member))))
    (bind task other : Text
      (db-insert Table.User.User
        (record
          (email "other@example.com")
          (name "Other")
          (passwordHash "")
          (role (ctor Table.User.Role.Member))))
      (bind task _
        (db-insert Table.Todo.Todo
          (record
            (title "Milk")
            (done False)
            (due (ctor Prelude.Maybe.Nothing))
            (owner (var me))))
        (bind task _
          (db-insert Table.Todo.Todo
            (record
              (title "Bread")
              (done False)
              (due (ctor Prelude.Maybe.Nothing))
              (owner (var me))))
          (bind task _
            (db-insert Table.Todo.Todo
              (record
                (title "Eggs")
                (done False)
                (due (ctor Prelude.Maybe.Nothing))
                (owner (var other))))
            (bind task _
              (test-login
                (record App.Session
                  (user (ctor Prelude.Maybe.Just (record (value (var me)))))
                  (role (ctor Table.User.Role.Member))))
              (bind task r : { value: Result Text Int, trace: List Text }
                (test-run
                  (bind task n : Int
                    (db-run count (db-scoped Db.mine user Table.Todo.Todo))
                    (pure task (var n))))
                (pure task
                  (test-eq
                    (record
                      (value (field value (var r)))
                      (trace (field trace (var r))))
                    (record
                      (value (ctor Prelude.Result.Ok (record (value 2))))
                      (trace (list "Db.mine Todo" "Db.count Todo")))))))))))))
(module Todos.Show)
(record Todos.Show.Model (todo Table.Todo.Todo))
(record Todos.Show.EditTodo (title Text) (due Maybe Date))
(record Todos.Show.Show.Params (id Text))
(record Todos.Show.Save.Params (id Text) (form EditTodo))
(record Todos.Show.Delete.Params (id Text))
(record Todos.Show.Show.Session (user Text) (role Table.User.Role))
(value Todos.Show.Show.load : Show.Params -> Show.Session -> Query Model (params session)
  (bind query todo : Table.Todo.Todo
    (db-get-scoped Db.getMine user Table.Todo.Todo (field id (var params)))
    (pure query (record Model (todo (var todo))))))
(value Todos.Show.Save.update : Save.Params -> Show.Session -> Task Response (p session)
  (bind task _
    (db-update-scoped Db.updateMine user Table.Todo.Todo
      (field id (var p))
      (lambda (t : Table.Todo.Todo)
        (update (var t)
          (title (field title (field form (var p))))
          (due (field due (field form (var p)))))))
    (pure task
      (call (std Response.redirect)
        (route-ref Todos.Index.Index
          (record Todos.Index.Index.Params
            (filter (ctor Table.Todo.Filter.All))))))))
(value Todos.Show.Delete.update : Delete.Params -> Show.Session -> Task Response (p session)
  (bind task _
    (db-delete-scoped Db.deleteMine user Table.Todo.Todo (field id (var p)))
    (pure task
      (call (std Response.redirect)
        (route-ref Todos.Index.Index
          (record Todos.Index.Index.Params
            (filter (ctor Table.Todo.Filter.All))))))))
(value Todos.Show.Show.view : Model -> Show.Session -> Html Route (model session)
  (comp Layout.Page
    (record (title (field title (field todo (var model)))))
    (elem h1 (hexpr text (field title (field todo (var model)))))
    (elem al-card
      (form-el (route Todos.Show.Save)
        (attr submit submit
          (route-ref Todos.Show.Save
            (record Save.Params (id (field id (field todo (var model)))))))
        (input Input EditTodo field=title label="Title"
          (value (field title (field todo (var model))))
          (wrap al-input))
        (input Input EditTodo field=due label="Due"
          (value (field due (field todo (var model))))
          (wrap al-input))
        (elem al-button (attr type text "submit")
          (elem button (attr type text "submit") (htext "Save"))))
      (elem div (attr slot text "actions")
        (elem al-button (attr variant text "ghost")
          (elem a
            (attr href href
              (route-ref Todos.Index.Index
                (record Todos.Index.Index.Params
                  (filter (ctor Table.Todo.Filter.All)))))
            (htext "Back")))
        (elem al-button (attr variant text "destructive")
          (elem button
            (attr type text "button")
            (attr click click
              (route-ref Todos.Show.Delete
                (record Delete.Params (id (field id (field todo (var model)))))))
            (htext "Delete")))))))
