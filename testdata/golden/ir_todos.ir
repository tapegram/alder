                        (lambda (t : Table.Todo.Todo) (field due (var t)))
                        (var after))))
                  (record
                    (answer
                      (ctor Prelude.Answer.Redirected
                        (record
                          (value
                            (route-ref Todos.Index.Index
                              (record Todos.Index.Index.Params
                                (filter (ctor Table.Todo.Filter.All))))))))
                    (title (ctor Prelude.Maybe.Just (record (value "Bread"))))
                    (due (call (std Date.fromText) "2026-10-12"))))))))))))
