(test "Db.mine is what Me sees" task
  (bind task me : Text
    (db-insert User.User
      (record
        (email "me@example.com")
        (name "Me")
        (passwordHash "")
        (role (ctor User.Role.Member))))
    (bind task other : Text
      (db-insert User.User
        (record
          (email "other@example.com")
          (name "Other")
          (passwordHash "")
          (role (ctor User.Role.Member))))
      (bind task _
        (db-insert Todo.Todo
          (record
            (title "Milk")
            (done False)
            (due (ctor Prelude.Maybe.Nothing))
            (owner (var me))))
        (bind task _
          (db-insert Todo.Todo
            (record
              (title "Bread")
              (done False)
              (due (ctor Prelude.Maybe.Nothing))
              (owner (var me))))
          (bind task _
            (db-insert Todo.Todo
              (record
                (title "Eggs")
                (done False)
                (due (ctor Prelude.Maybe.Nothing))
                (owner (var other))))
            (bind task _
              (test-login
                (record App.Session
                  (user (ctor Prelude.Maybe.Just (record (value (var me)))))
                  (role (ctor User.Role.Member))))
              (bind task r : { value: Result Text Int, trace: List Text }
                (test-run
                  (bind task n : Int
                    (db-run count (db-scoped Db.mine user Todo.Todo))
                    (pure task (var n))))
                (pure task
                  (test-eq
                    (record
                      (value (field value (var r)))
                      (trace (field trace (var r))))
                    (record
                      (value (ctor Prelude.Result.Ok (record (value 2))))
                      (trace (list "Db.mine Todo" "Db.count Todo")))))))))))))
(module Todos.Show)
(record Todos.Show.Model (todo Todo))
(record Todos.Show.EditTodo (title Text) (due Maybe Date))
(record Todos.Show.Params (id Text))
(record Todos.Show.SaveParams (form EditTodo))
(union Todos.Show.Msg (Save SaveParams) (Delete))
(record Todos.Show.Session (user Text) (role User.Role))
(value Todos.Show.load : Params -> Session -> Query Model (params session)
  (bind query todo : Todo
    (db-get-scoped Db.getMine user Todo.Todo (field id (var params)))
    (pure query (record Model (todo (var todo))))))
(value Todos.Show.update : Msg -> Model -> Session -> Task Nav (msg model session)
  (match union (var msg)
    (case Save (bind _m1 : SaveParams)
      (let p : SaveParams
        (var _m1)
        (bind task _
          (db-update-scoped Db.updateMine user Todo.Todo
            (field id (field todo (var model)))
            (lambda (t : Todo)
              (update (var t)
                (title (field title (field form (var p))))
                (due (field due (field form (var p)))))))
          (pure task
            (ctor Prelude.Nav.Redirect
              (record
                (value
                  (page-ref Todos.Index
                    (record Todos.Index.Params (filter (ctor Todo.Filter.All)))))))))))
    (case Delete
      (bind task _
        (db-delete-scoped Db.deleteMine user Todo.Todo
          (field id (field todo (var model))))
        (pure task
          (ctor Prelude.Nav.Redirect
            (record
              (value
                (page-ref Todos.Index
                  (record Todos.Index.Params (filter (ctor Todo.Filter.All))))))))))))
(value Todos.Show.view : Model -> Session -> Html Msg (model session)
  (comp Layout.Page
    (record (title (field title (field todo (var model)))))
    (elem h1 (hexpr text (field title (field todo (var model)))))
    (elem al-card
      (form-el Todos.Show.Save
        (attr submit submit (ctor Todos.Show.Msg.Save (record SaveParams)))
        (input Input EditTodo field=title label="Title"
          (value (field title (field todo (var model))))
          (wrap al-input))
        (input Input EditTodo field=due label="Due"
          (value (field due (field todo (var model))))
          (wrap al-input))
        (elem al-button (attr type text "submit")
          (elem button (attr type text "submit") (htext "Save"))))
      (elem div (attr slot text "actions")
        (elem al-button (attr variant text "ghost")
          (elem a
            (attr href href
              (page-ref Todos.Index
                (record Todos.Index.Params (filter (ctor Todo.Filter.All)))))
            (htext "Back")))
        (elem al-button (attr variant text "destructive")
          (elem button
            (attr type text "button")
            (attr click click (ctor Todos.Show.Msg.Delete))
            (htext "Delete")))))))
(test "a visitor is sent to log in from a todo" task
  (bind task me : Text
    (db-insert User.User
      (record
        (email "me@example.com")
        (name "Me")
        (passwordHash "")
        (role (ctor User.Role.Member))))
    (bind task id : Text
      (db-insert Todo.Todo
        (record
          (title "Milk")
          (done False)
          (due (ctor Prelude.Maybe.Nothing))
          (owner (var me))))
      (bind task visitor : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
        (test-open Todos.Show (record Params (id (var id))))
        (pure task
          (test-eq
            (field answer (var visitor))
            (ctor Prelude.Answer.Redirected
              (record (value (page-ref Auth.Login (record Auth.Login.Params)))))))))))
(test "saving changes the title and the due date" task
  (bind task me : Text
    (db-insert User.User
      (record
        (email "me@example.com")
        (name "Me")
        (passwordHash "")
        (role (ctor User.Role.Member))))
    (bind task id : Text
      (db-insert Todo.Todo
        (record
          (title "Milk")
          (done False)
          (due (ctor Prelude.Maybe.Nothing))
          (owner (var me))))
      (bind task _
        (test-login
          (record App.Session
            (user (ctor Prelude.Maybe.Just (record (value (var me)))))
            (role (ctor User.Role.Member))))
        (bind task _
          (test-get Todos.Show (record Params (id (var id))))
          (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
            (test-submit Todos.Show.EditTodo Save
              (record EditTodo
                (title "Bread")
                (due (call (std Date.fromText) "2026-10-12"))))
            (bind task after : Maybe Todo
              (db-get Todo.Todo (var id))
              (pure task
                (test-eq
                  (record
                    (answer (field answer (var r)))
                    (title
                      (call (std Maybe.map)
                        (lambda (t : Todo) (field title (var t)))
                        (var after)))
                    (due
                      (call (std Maybe.andThen)
                        (lambda (t : Todo) (field due (var t)))
                        (var after))))
                  (record
                    (answer
                      (ctor Prelude.Answer.Redirected
                        (record
                          (value
                            (page-ref Todos.Index
                              (record Todos.Index.Params
                                (filter (ctor Todo.Filter.All))))))))
                    (title (ctor Prelude.Maybe.Just (record (value "Bread"))))
                    (due (call (std Date.fromText) "2026-10-12"))))))))))))
(test "deleting from the todo's page" task
  (bind task me : Text
    (db-insert User.User
      (record
        (email "me@example.com")
        (name "Me")
        (passwordHash "")
        (role (ctor User.Role.Member))))
    (bind task id : Text
      (db-insert Todo.Todo
        (record
          (title "Milk")
          (done False)
          (due (ctor Prelude.Maybe.Nothing))
          (owner (var me))))
      (bind task _
        (test-login
          (record App.Session
            (user (ctor Prelude.Maybe.Just (record (value (var me)))))
            (role (ctor User.Role.Member))))
        (bind task _
          (test-get Todos.Show (record Params (id (var id))))
          (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text }
            (test-click Todos.Show.Delete)
