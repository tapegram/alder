(module Layout)
(component Layout.Page : { title: Text, children: List (Html a) } -> Html a (props)
  (elem html
    (elem head
      (elem meta (attr charset text "utf-8"))
      (elem script
        (hrawtext "try{document.documentElement.classList.toggle(\"dark\",localStorage.theme===\"dark\"||(!(\"theme\" in localStorage)&&matchMedia(\"(prefers-color-scheme: dark)\").matches))}catch(e){}"))
      (elem title (hexpr text (field title (var props))))
      (elem link
        (attr rel text "stylesheet")
        (attr href href (call (std Url.external) "/static/al/al.css")))
      (elem script (attr type text "module") (attr src text "/static/al/al.js"))
      (elem link
        (attr rel text "stylesheet")
        (attr href href (call (std Url.external) "/static/app.css"))))
    (elem body
      (elem al-page (attr width text "narrow")
        (elem main
          (elem al-stack (attr gap text "lg")
            (hexpr list (field children (var props)))))))))
(module Table.User)
(union Table.User.Role (Member) (Admin))
(record Table.User.User
  (id Text)
  (email Text)
  (name Text)
  (passwordHash Text)
  (created Time)
  (role Role = (ctor Table.User.Role.Member)))
(module App)
(record App.Session
  (user Maybe Text)
  (role Table.User.Role = (ctor Table.User.Role.Member)))
(union App.Msg)
(record App.Logout.Params)
(value App.Logout.update : Logout.Params -> Session -> Task Response (p session)
  (bind task _
    (call (std Session.put)
      (lambda (s : Session)
        (update (var s)
          (user (ctor Prelude.Maybe.Nothing))
          (role (ctor Table.User.Role.Member)))))
    (pure task
      (call (std Response.redirect)
        (route-ref Auth.Login.Login (record Auth.Login.Login.Params))))))
(value App.error : Error -> Html Never (err)
  (comp Layout.Page
    (record (title "Error"))
    (elem h1 (htext "Something went wrong"))
    (elem p (htext "Please try again."))))
(value App.notFound : Html Never ()
  (comp Layout.Page (record (title "Not found")) (elem h1 (htext "Not found"))))
(test "Logout clears the user and goes to log in" task
  (bind task r : { value: Result Text Response, trace: List Text }
    (test-run
      (call (global App.Logout.update)
        (record Logout.Params)
        (record Session
          (user (ctor Prelude.Maybe.Just (record (value "me"))))
          (role (ctor Table.User.Role.Admin)))))
    (pure task
      (test-eq
        (record (value (field value (var r))) (trace (field trace (var r))))
        (record
          (value
            (ctor Prelude.Result.Ok
              (record
                (value
                  (call (std Response.redirect)
                    (route-ref Auth.Login.Login
                      (record Auth.Login.Login.Params)))))))
          (trace (list "Session.put")))))))
(test "Logout makes the role Member" task
  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "me@example.com")
        (name "Me")
        (passwordHash "")
        (role (ctor Table.User.Role.Admin))))
    (bind task _
      (test-login
        (record Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))
          (role (ctor Table.User.Role.Admin))))
      (bind task _
        (test-get (route Todos.Index.Index)
          (record Todos.Index.Index.Params
            (filter (ctor Table.Todo.Filter.All))))
        (bind task out : { answer: Answer, session: Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
          (test-click (route App.Logout))
          (pure task
            (test-eq
              (record
                (out (field answer (var out)))
                (role (field role (field session (var out)))))
              (record
                (out
                  (ctor Prelude.Answer.Redirected
                    (record
                      (value
                        (route-ref Auth.Login.Login
                          (record Auth.Login.Login.Params))))))
                (role (ctor Table.User.Role.Member))))))))))
(module Auth.Login)
(record Auth.Login.Model)
(record Auth.Login.Credentials (email Text) (password Text))
(record Auth.Login.Login.Params)
(record Auth.Login.Submit.Params (form Credentials))
(value Auth.Login.Login.load : Login.Params -> App.Session -> Query Model (params session)
  (pure query (record Model)))
(value Auth.Login.Submit.update : Submit.Params -> App.Session -> Task Response (p session)
  (bind task found : Maybe Text
    (cap Auth.Login.Password verify
      (record
        (email (field email (field form (var p))))
        (password (field password (field form (var p))))))
    (match union (var found)
      (case Just (bind _m1 value : Text)
        (let id : Text
          (var _m1)
          (bind task found : Maybe Table.User.User
            (db-get Table.User.User (var id))
            (let role : Table.User.Role
              (call (std Maybe.withDefault)
                (ctor Table.User.Role.Member)
                (call (std Maybe.map)
                  (lambda (u : Table.User.User) (field role (var u)))
                  (var found)))
              (bind task _
                (call (std Session.put)
                  (lambda (s : App.Session)
                    (update (var s)
                      (user (ctor Prelude.Maybe.Just (record (value (var id)))))
                      (role (var role)))))
                (pure task
                  (call (std Response.redirect)
                    (route-ref Todos.Index.Index
                      (record Todos.Index.Index.Params
                        (filter (ctor Table.Todo.Filter.All)))))))))))
      (case Nothing
        (pure task
          (call (std Response.invalid) "Email or password is incorrect."))))))
(value Auth.Login.Login.view : Model -> App.Session -> Html Route (model session)
  (comp Layout.Page
    (record (title "Log in"))
    (elem h1 (htext "Log in"))
    (elem al-card
      (form-el (route Auth.Login.Submit)
        (attr submit submit (route-ref Auth.Login.Submit))
        (input Errors Credentials form)
        (input Input Credentials field=email label="Email" (wrap al-input))
        (input Input Credentials field=password label="Password"
          (wrap al-input))
        (elem al-button (attr type text "submit")
          (elem button (attr type text "submit") (htext "Log in")))))))
(test "an unknown email is rejected" task
  (bind task _
    (test-fake Auth.Login.Password)
    (bind task _
      (test-get (route Auth.Login.Login) (record Login.Params))
      (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
        (test-submit Auth.Login.Credentials (route Auth.Login.Submit)
          (record Credentials (email "nobody@example.com") (password "secret")))
        (pure task
          (test-eq
            (record
              (answer (field answer (var r)))
              (user (field user (field session (var r)))))
            (record
              (answer
                (ctor Prelude.Answer.FormRejected
                  (record
                    (value
                      (list
                        (record
                          (field "")
                          (message "Email or password is incorrect.")))))))
              (user (ctor Prelude.Maybe.Nothing)))))))))
(test "logging in through the form" task
  (bind task _
    (test-fake Auth.Login.Password)
    (bind task me : Text
      (db-insert Table.User.User
        (record
          (email "me@example.com")
          (name "Me")
          (passwordHash "")
          (role (ctor Table.User.Role.Member))))
      (bind task _
        (test-get (route Auth.Login.Login) (record Login.Params))
        (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
          (test-submit Auth.Login.Credentials (route Auth.Login.Submit)
            (record Credentials (email "me@example.com") (password "secret")))
          (pure task
            (test-eq
              (record
                (answer (field answer (var r)))
                (user (field user (field session (var r))))
                (title (call (std Test.text) "h1" (field doc (var r)))))
              (record
                (answer
                  (ctor Prelude.Answer.Redirected
                    (record
                      (value
                        (route-ref Todos.Index.Index
                          (record Todos.Index.Index.Params
                            (filter (ctor Table.Todo.Filter.All))))))))
                (user (ctor Prelude.Maybe.Just (record (value (var me)))))
                (title (ctor Prelude.Maybe.Just (record (value "Todos"))))))))))))
(test "logging in copies the role from the user's row" task
  (bind task _
    (test-fake Auth.Login.Password)
    (bind task _
      (db-insert Table.User.User
        (record
          (email "admin@example.com")
          (name "Admin")
          (passwordHash "")
          (role (ctor Table.User.Role.Admin))))
      (bind task _
        (test-get (route Auth.Login.Login) (record Login.Params))
        (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
          (test-submit Auth.Login.Credentials (route Auth.Login.Submit)
            (record Credentials (email "admin@example.com") (password "secret")))
          (pure task
            (test-eq
              (field role (field session (var r)))
              (ctor Table.User.Role.Admin))))))))
(test "a visitor is sent to log in, and can log out" task
  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "me@example.com")
        (name "Me")
        (passwordHash "")
        (role (ctor Table.User.Role.Member))))
    (bind task visitor : { answer: Answer, session: App.Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
      (test-open (route Todos.Index.Index)
        (record Todos.Index.Index.Params (filter (ctor Table.Todo.Filter.All))))
      (bind task _
        (test-login
          (record App.Session
            (user (ctor Prelude.Maybe.Just (record (value (var me)))))
            (role (ctor Table.User.Role.Member))))
        (bind task _
          (test-get (route Todos.Index.Index)
            (record Todos.Index.Index.Params
              (filter (ctor Table.Todo.Filter.All))))
          (bind task out : { answer: Answer, session: App.Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
            (test-click (route App.Logout))
            (pure task
              (test-eq
                (record
                  (visitor (field answer (var visitor)))
                  (out (field answer (var out)))
                  (user (field user (field session (var out)))))
                (record
                  (visitor
                    (ctor Prelude.Answer.Redirected
                      (record
                        (value
                          (route-ref Auth.Login.Login (record Login.Params))))))
                  (out
                    (ctor Prelude.Answer.Redirected
                      (record
                        (value
                          (route-ref Auth.Login.Login (record Login.Params))))))
                  (user (ctor Prelude.Maybe.Nothing)))))))))))
(module Table.Todo)
(union Table.Todo.Filter (All) (Active) (Completed))
(record Table.Todo.Todo
  (id Text)
  (title Text)
  (done Bool = False)
  (due Maybe Date)
  (owner Text)
  (created Time))
(value Table.Todo.matches : Filter -> Todo -> Bool (filter todo)
  (match union (var filter)
    (case All True)
    (case Active (call (std Prelude.not) (field done (var todo))))
    (case Completed (field done (var todo)))))
(value Table.Todo.filterLabel : Filter -> Text (filter)
  (match union (var filter)
    (case All "All")
    (case Active "Active")
    (case Completed "Completed")))
(value Table.Todo.countOpen : List Todo -> Int (todos)
  (call (std List.length)
    (call (std List.filter)
      (lambda (t : Todo) (call (std Prelude.not) (field done (var t))))
      (var todos))))
(test "countOpen ignores done todos" pure
  (test-eq
    (call (global Table.Todo.countOpen)
      (list
        (record Todo
          (id "a")
          (title "x")
          (done False)
          (due (ctor Prelude.Maybe.Nothing))
          (owner "u")
          (created (std Time.epoch)))
        (record Todo
          (id "b")
          (title "y")
          (done True)
          (due (ctor Prelude.Maybe.Nothing))
          (owner "u")
          (created (std Time.epoch)))
        (record Todo
          (id "c")
          (title "z")
          (done False)
          (due (ctor Prelude.Maybe.Nothing))
          (owner "u")
          (created (std Time.epoch)))))
    2))
(test "Active keeps only open todos" pure
  (test-eq
    (call (std List.map)
      (lambda (t : Todo) (field title (var t)))
      (call (std List.filter)
        (partial (global Table.Todo.matches)
          (ctor Table.Todo.Filter.Active)
          (missing 1))
        (list
          (record Todo
            (id "a")
            (title "x")
            (done False)
            (due (ctor Prelude.Maybe.Nothing))
            (owner "u")
            (created (std Time.epoch)))
          (record Todo
            (id "b")
            (title "y")
            (done True)
            (due (ctor Prelude.Maybe.Nothing))
            (owner "u")
            (created (std Time.epoch))))))
    (list "x")))
(test "each filter has its label" pure
  (test-eq
    (call (std List.map)
      (global Table.Todo.filterLabel)
      (list
        (ctor Table.Todo.Filter.All)
        (ctor Table.Todo.Filter.Active)
        (ctor Table.Todo.Filter.Completed)))
    (list "All" "Active" "Completed")))
(test "a user with todos cannot be deleted" task
  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "me@example.com")
        (name "Me")
        (passwordHash "")
        (role (ctor Table.User.Role.Member))))
    (bind task id : Text
      (db-insert Table.Todo.Todo
        (record
          (title "Milk")
          (done False)
          (due (ctor Prelude.Maybe.Nothing))
          (owner (var me))))
      (bind task r : { value: Result Text Unit, trace: List Text }
        (test-run (db-delete Table.User.User (var me)))
        (bind task after : Maybe Todo
          (db-get Table.Todo.Todo (var id))
          (pure task
            (test-eq
              (record
                (deleted (call (std Result.toMaybe) (field value (var r))))
                (todo
                  (call (std Maybe.map)
                    (lambda (t : Todo) (field title (var t)))
                    (var after))))
              (record
                (deleted (ctor Prelude.Maybe.Nothing))
                (todo (ctor Prelude.Maybe.Just (record (value "Milk"))))))))))))
(module Todos.Index)
(record Todos.Index.Model
  (filter Table.Todo.Filter)
  (todos List Table.Todo.Todo))
(record Todos.Index.NewTodo (title Text) (due Maybe Date))
(record Todos.Index.Index.Params
  (filter Table.Todo.Filter = (ctor Table.Todo.Filter.All)))
(record Todos.Index.Submit.Params
  (filter Table.Todo.Filter = (ctor Table.Todo.Filter.All))
  (form NewTodo))
(record Todos.Index.Toggle.Params (id Text))
(record Todos.Index.Delete.Params (id Text))
(record Todos.Index.Index.Session (user Text) (role Table.User.Role))
(value Todos.Index.Index.load : Index.Params -> Index.Session -> Query Model (params session)
  (bind query todos : List Table.Todo.Todo
    (db-select Table.Todo.Todo
      (base (db-scoped Db.mine user Table.Todo.Todo))
      (order (ord (col Table.Todo.Todo created) desc))
      all)
    (pure query
      (record Model
        (filter (field filter (var params)))
        (todos
          (call (std List.filter)
            (partial (global Table.Todo.matches)
              (field filter (var params))
              (missing 1))
            (var todos)))))))
(value Todos.Index.Submit.update : Submit.Params -> Index.Session -> Task Response (p session)
  (bind task _
    (db-insert-scoped Db.insertMine user Table.Todo.Todo
      (record
        (title (field title (field form (var p))))
        (done False)
        (due (field due (field form (var p))))))
    (pure task
      (call (std Response.redirect)
        (route-ref Todos.Index.Index
          (record Index.Params (filter (field filter (var p)))))))))
(value Todos.Index.Toggle.update : Toggle.Params -> Index.Session -> Task Response (p session)
  (bind task _
    (db-update-scoped Db.updateMine user Table.Todo.Todo
      (field id (var p))
      (lambda (t : Table.Todo.Todo)
        (update (var t) (done (call (std Prelude.not) (field done (var t)))))))
    (pure task (std Response.refresh))))
(value Todos.Index.Delete.update : Delete.Params -> Index.Session -> Task Response (p session)
  (bind task _
    (db-delete-scoped Db.deleteMine user Table.Todo.Todo (field id (var p)))
    (pure task (std Response.refresh))))
(value Todos.Index.Index.view : Model -> Index.Session -> Html Route (model session)
  (comp Layout.Page
    (record (title "Todos"))
    (elem h1 (htext "Todos"))
    (elem al-card
      (form-el (route Todos.Index.Submit)
        (attr submit submit
          (route-ref Todos.Index.Submit
            (record Submit.Params (filter (field filter (var model))))))
        (input Input NewTodo field=title label="What needs doing?"
          (wrap al-input))
        (input Input NewTodo field=due label="Due" (wrap al-input))
        (elem al-button (attr type text "submit")
          (elem button (attr type text "submit") (htext "Add")))))
    (elem nav
      (hfor f : Table.Todo.Filter
        (list
          (ctor Table.Todo.Filter.All)
          (ctor Table.Todo.Filter.Active)
          (ctor Table.Todo.Filter.Completed))
        (elem a
          (attr href href
            (route-ref Todos.Index.Index (record Index.Params (filter (var f)))))
          (attr aria-current maybe
            (if (== : Table.Todo.Filter (field filter (var model)) (var f))
              (ctor Prelude.Maybe.Just (record (value "page")))
              (ctor Prelude.Maybe.Nothing)))
          (hexpr text (call (global Table.Todo.filterLabel) (var f))))))
    (elem ul (attr id text "todos")
      (hfor todo : Table.Todo.Todo
        (field todos (var model))
        (comp Todos.Index.Item (record (todo (var todo))))))
    (elem p (attr id text "summary")
      (hexpr text
        (call (std Text.fromInt)
          (call (global Table.Todo.countOpen) (field todos (var model)))))
      (htext " open"))
    (elem al-button (attr variant text "outline")
      (elem button
        (attr type text "button")
        (attr click click (route-ref App.Logout))
        (htext "Log out")))))
(component Todos.Index.Item : { todo: Table.Todo.Todo } -> Html Route (props)
  (elem li
    (attr class text (if (field done (field todo (var props))) "done" ""))
    (elem al-button (attr variant text "secondary") (attr size text "sm")
      (elem button
        (attr type text "button")
        (attr click click
          (route-ref Todos.Index.Toggle
            (record Toggle.Params (id (field id (field todo (var props)))))))
        (hif (field done (field todo (var props)))
          (hexpr text "Undo")
          (hexpr text "Done"))))
    (elem a
      (attr href href
        (route-ref Todos.Show.Show
          (record Todos.Show.Show.Params
            (id (field id (field todo (var props)))))))
      (hexpr text (field title (field todo (var props)))))
    (hmatch union (field due (field todo (var props)))
      (case Just (bind _m1 value : Date)
        (let d : Date
          (var _m1)
          (elem al-badge (attr variant text "outline") (attr class text "due")
            (hexpr text (call (std Date.format) "Jan 2" (var d))))))
      (case Nothing (hexpr html (std Html.none))))
    (elem al-button (attr variant text "ghost") (attr size text "sm")
      (elem button
        (attr type text "button")
        (attr click click
          (route-ref Todos.Index.Delete
            (record Delete.Params (id (field id (field todo (var props)))))))
        (htext "Delete")))))
(test "Toggle flips done" task
  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "me@example.com")
        (name "Me")
        (passwordHash "")
        (role (ctor Table.User.Role.Member))))
    (bind task id : Text
      (db-insert Table.Todo.Todo
        (record
          (title "Milk")
          (done False)
          (due (ctor Prelude.Maybe.Nothing))
          (owner (var me))))
      (bind task _
        (test-login
          (record App.Session
            (user (ctor Prelude.Maybe.Just (record (value (var me)))))
            (role (ctor Table.User.Role.Member))))
        (bind task r : { value: Result Text Response, trace: List Text }
          (test-run
            (call (global Todos.Index.Toggle.update)
              (record Toggle.Params (id (var id)))
              (record Index.Session
                (user (var me))
                (role (ctor Table.User.Role.Member)))))
          (bind task after : Maybe Table.Todo.Todo
            (db-get Table.Todo.Todo (var id))
            (let done : Maybe Bool
              (call (std Maybe.map)
                (lambda (t : Table.Todo.Todo) (field done (var t)))
                (var after))
              (pure task
                (test-eq
                  (record (trace (field trace (var r))) (done (var done)))
                  (record
                    (trace (list "Db.updateMine Todo"))
                    (done (ctor Prelude.Maybe.Just (record (value True))))))))))))))
(test "Toggle by another user is not found" task
  (bind task me : Text
    (db-insert Table.User.User
      (record
        (email "me@example.com")
        (name "Me")
        (passwordHash "")
        (role (ctor Table.User.Role.Member))))
    (bind task id : Text
      (db-insert Table.Todo.Todo
        (record
          (title "Milk")
          (done False)
          (due (ctor Prelude.Maybe.Nothing))
          (owner (var me))))
      (bind task _
        (test-login
          (record App.Session
            (user (ctor Prelude.Maybe.Just (record (value (var me)))))
            (role (ctor Table.User.Role.Member))))
        (bind task _
          (test-get (route Todos.Index.Index)
            (record Index.Params (filter (ctor Table.Todo.Filter.All))))
          (bind task _
            (test-login
              (record App.Session
                (user (ctor Prelude.Maybe.Just (record (value "someone-else"))))
                (role (ctor Table.User.Role.Member))))
            (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
              (test-click (route Todos.Index.Toggle)
                (record Toggle.Params (id (var id))))
              (bind task after : Maybe Table.Todo.Todo
                (db-get Table.Todo.Todo (var id))
                (pure task
                  (test-eq
                    (record
                      (answer (field answer (var r)))
                      (done
                        (call (std Maybe.map)
                          (lambda (t : Table.Todo.Todo) (field done (var t)))
                          (var after))))
                    (record
                      (answer (ctor Prelude.Answer.PageMissing))
                      (done (ctor Prelude.Maybe.Just (record (value False)))))))))))))))
