module B

import User

route B = GET "/users/{id}" { id: User.UserId }

type Model = { name: Text }

B.load : B.Params -> Session -> Query Model
B.load params session = {
  let user <- Db.get User params.id
  Query.succeed { name: (user
  ).name }
}

B.view : Model -> Session -> Html
B.view model session = <h1>{model.name}</h1>
