module B

import User

page "/users/{id}" { id: User.UserId }

type Model = { name: Text }

load : Params -> Session -> Query Model
load params session = {
  let user <- Db.get User params.id
  Query.succeed { name: (user
  ).name }
}

view : Model -> Session -> Html Msg
view model session = <h1>{model.name}</h1>
