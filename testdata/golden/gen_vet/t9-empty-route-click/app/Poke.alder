module Poke

route Show = GET  "/poke"        { }
route Poke = POST "/poke" { }

type Model = { n: Int }

Show.load : Show.Params -> Session -> Query Model
Show.load params session = Query.succeed { n: 1 }

Poke.update : Poke.Params -> Session -> Task Response
Poke.update p session = Task.succeed Response.refresh

-- `route Poke` takes no parameters: `click={Poke}` and `click={Poke {}}` both send it.
Show.view : Model -> Session -> Html
Show.view model session =
  <div>
    <button click={Poke}>Poke</button>
    <button click={Poke {}}>Poke again</button>
  </div>
