module M

-- A match binding used only by a `let` whose own name is never used: the let is not emitted, so
-- neither may the binding be (Go rejects a declared and unused variable).

type Shape = Circle Float | Rect { w: Float, h: Float }

route Pick  = POST "/m/_/Pick"  { id: Text, n: Int }
route Clear = POST "/m/_/Clear" { }
route M     = GET  "/m"         { }

type Model = { n: Int }

M.load : M.Params -> Session -> Query Model
M.load params session = Query.succeed { n: 1 }

Pick.update : Pick.Params -> Session -> Task Response
Pick.update p session = {
  let unused = p.id
  Task.succeed Response.refresh
}

Clear.update : Clear.Params -> Session -> Task Response
Clear.update params session = Task.succeed Response.refresh

label : Maybe Int -> Text
label m = match m {
  Just n -> {
    let a = n + 1
    let b = a
    "some"
  },
  Nothing -> "none",
}

area : Shape -> Float
area s = match s {
  Circle r -> {
    let q = r
    1.0
  },
  Rect r -> {
    let w = r.w
    let r = 2.0
    r
  },
}

M.view : Model -> Session -> Html
M.view model session = <button click={Clear}>{label (Just model.n)}</button>
