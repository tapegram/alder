module App

import Customer
import Shop

session { user: Maybe Customer.UserId, cart: Int = 0 }

login = Login.Login

route Clear = POST "/" { }

Clear.update : Clear.Params -> Session -> Task Response
Clear.update p session = {
  let _ <- Session.put (\s -> { s | cart: 0 })
  Task.succeed (Shop.after Response.refresh)
}

error : Error -> Html
error err = <p>error</p>

notFound : Html
notFound = <p>nf</p>
