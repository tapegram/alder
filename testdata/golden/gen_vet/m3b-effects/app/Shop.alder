module Shop

import Customer
import Purchase

-- M3b emission corpus: every column kind in conditions, @unique/@ref/@updated, a table passed
-- as a value, an effect in a record field, Nav built and matched in pure code, capabilities with
-- zero, one and two parameters, and the effectful stdlib. The tables are in their own modules
-- (`Purchase`, `Customer`), and this module queries them through their imports.

capability Pay {
  charge : { amount: Float, card: Text } -> Task (Maybe Text),
  balance : Query Float,
  limit : Customer.UserId -> Int -> Query Int,
}

type Job = { run: Task Int, label: Text }

job : Job
job = { run: Task.succeed 1, label: "one" }

runJob : Job -> Task Int
runJob j = j.run

after : Nav -> Nav
after n = match n {
  Redirect p -> Redirect p,
  Reject t -> Reject "{t}!",
  Rerender -> Rerender,
}

isRedirect : Nav -> Bool
isRedirect n = match n {
  Redirect p -> True,
  _ -> False,
}

countIn : Table Purchase.Purchase -> Query Int
countIn t = Db.count (Db.from t)

allOrders : Query Int
allOrders = countIn Purchase

search : Purchase.Status -> Date -> Time -> List Purchase.Status -> Select Purchase.Purchase
search s d t ss =
  Db.from Purchase
    |> Db.where (Db.and [
      Purchase.status.eq s,
      Purchase.status.lt Shipped,
      Purchase.late.eq (Just s),
      Purchase.late.isJust,
      Purchase.total.gt 1.5,
      Purchase.qty.le 3,
      Purchase.gift.ne True,
      Purchase.day.ge d,
      Purchase.shipDay.eq Nothing,
      Purchase.code.contains "x",
      Purchase.note.eq (Just "n"),
      Purchase.created.lt t,
      Purchase.status.in ss,
      Purchase.day.in [d],
      Purchase.late.in [Just s, Nothing],
    ])
    |> Db.orderBy Purchase.status.asc
    |> Db.orderBy Purchase.updated.desc
    |> Db.offset 0

conds : List (Condition Purchase.Purchase) -> Condition Purchase.Purchase
conds cs = Db.or [Db.and cs, Db.not (Db.or cs)]

either : List (Condition Purchase.Purchase) -> Select Purchase.Purchase
either cs = Db.from Purchase |> Db.where (Db.or cs) |> Db.where (Db.not (Db.and []))

seenBefore : Time -> Query (List Customer.Customer)
seenBefore t = Db.all (Db.from Customer |> Db.where (Customer.seen.eq (Just t)))

buy : Customer.UserId -> Text -> Task Purchase.OrderId
buy u code = {
  let today <- Date.today
  let n <- Random.int { min: 1, max: 9 }
  let _ <- Log.warn "buying {code}"
  let paid <- Pay.charge { amount: 2.5, card: "c" }
  let bal <- Pay.balance
  let lim <- Pay.limit u n
  let r <- Http.post { url: "http://x", body: "b" }
  let id <- Db.insert Purchase { buyer: u, late: Nothing, total: bal, qty: lim, gift: False, day: today, shipDay: Nothing, code: code, note: paid }
  let _ <- Db.update Purchase id (\o -> { o | status: Paid })
  let found <- Db.get Purchase id
  match found {
    Just o -> Task.succeed o.id,
    Nothing -> Task.fail "lost",
  }
}

register : Text -> Task Customer.UserId
register email = Db.insert Customer { email: email, seen: Nothing }

charges : List (Task (Maybe Text))
charges = [Pay.charge { amount: 1.0, card: "a" }]

limits : Customer.UserId -> List (Query Int)
limits u = List.map (Pay.limit u) [1, 2]

allLimits : Customer.UserId -> Query (List Int)
allLimits u = Query.all (limits u)

firstQ : Query (Maybe Purchase.Purchase)
firstQ = Db.first (search Open (Date.fromText "2026-01-01" |> Maybe.withDefault (Time.toDate Time.epoch)) Time.epoch [])

remove : Purchase.OrderId -> Task Unit
remove id = Db.delete Purchase id

fetch : Text -> Task Text
fetch url = {
  let r <- Http.get { url: url }
  let i <- Random.id
  let n <- Time.now
  match r {
    Ok body -> Task.succeed body,
    Err e -> Task.fail i,
  }
}

createdBefore : Time -> Select Purchase.Purchase
createdBefore t = Db.from Purchase |> Db.where (Purchase.created.lt t) |> Db.orderBy Purchase.created.desc

newestFirst : Select Purchase.Purchase
newestFirst = Db.from Purchase |> Db.orderBy Purchase.created.desc

-- conditions on Maybe columns are two-valued: `Nothing` rows are matched by `in [.., Nothing]`
-- and by the negation of a condition they do not satisfy
lateIn : Purchase.Status -> Select Purchase.Purchase
lateIn s = Db.from Purchase |> Db.where (Purchase.late.in [Just s, Nothing]) |> Db.orderBy Purchase.code.asc

lateNothing : Select Purchase.Purchase
lateNothing = Db.from Purchase |> Db.where (Purchase.late.in [Nothing])

notLateIn : List (Maybe Purchase.Status) -> Select Purchase.Purchase
notLateIn ss = Db.from Purchase |> Db.where (Db.not (Purchase.late.in ss)) |> Db.orderBy Purchase.code.asc

notNote : Text -> Select Purchase.Purchase
notNote t = Db.from Purchase |> Db.where (Db.not (Purchase.note.eq (Just t)))
