module Shop

import Customer
import Order

-- M3b emission corpus: every column kind in conditions, @unique/@ref/@updated, a table passed
-- as a value, an effect in a record field, Nav built and matched in pure code, capabilities with
-- zero, one and two parameters, and the effectful stdlib. The tables are in their own modules
-- (`Order`, `Customer`), and this module queries them through their imports.

capability Pay {
  charge : { amount: Float, card: Text } -> Task (Maybe Text),
  balance : Query Float,
  limit : Customer.UserId -> Int -> Query Int,
}

type Job = { run: Task Int, label: Text }

job : Job
job = { run: Task.succeed 1, label: "one" }

runJob : Job -> Task Int
runJob j = j.run

after : Nav -> Nav
after n = match n {
  Redirect p -> Redirect p,
  Reject t -> Reject "{t}!",
  Rerender -> Rerender,
}

isRedirect : Nav -> Bool
isRedirect n = match n {
  Redirect p -> True,
  _ -> False,
}

countIn : Table Order.Order -> Query Int
countIn t = Db.count (Db.from t)

allOrders : Query Int
allOrders = countIn Order

search : Order.Status -> Date -> Time -> List Order.Status -> Select Order.Order
search s d t ss =
  Db.from Order
    |> Db.where (Db.and [
      Order.status.eq s,
      Order.status.lt Shipped,
      Order.late.eq (Just s),
      Order.late.isJust,
      Order.total.gt 1.5,
      Order.qty.le 3,
      Order.gift.ne True,
      Order.day.ge d,
      Order.shipDay.eq Nothing,
      Order.code.contains "x",
      Order.note.eq (Just "n"),
      Order.created.lt t,
      Order.status.in ss,
      Order.day.in [d],
      Order.late.in [Just s, Nothing],
    ])
    |> Db.orderBy Order.status.asc
    |> Db.orderBy Order.updated.desc
    |> Db.offset 0

conds : List (Condition Order.Order) -> Condition Order.Order
conds cs = Db.or [Db.and cs, Db.not (Db.or cs)]

either : List (Condition Order.Order) -> Select Order.Order
either cs = Db.from Order |> Db.where (Db.or cs) |> Db.where (Db.not (Db.and []))

seenBefore : Time -> Query (List Customer.Customer)
seenBefore t = Db.all (Db.from Customer |> Db.where (Customer.seen.eq (Just t)))

buy : Customer.UserId -> Text -> Task Order.OrderId
buy u code = {
  let today <- Date.today
  let n <- Random.int { min: 1, max: 9 }
  let _ <- Log.warn "buying {code}"
  let paid <- Pay.charge { amount: 2.5, card: "c" }
  let bal <- Pay.balance
  let lim <- Pay.limit u n
  let r <- Http.post { url: "http://x", body: "b" }
  let id <- Db.insert Order { buyer: u, late: Nothing, total: bal, qty: lim, gift: False, day: today, shipDay: Nothing, code: code, note: paid }
  let _ <- Db.update Order id (\o -> { o | status: Paid })
  let found <- Db.get Order id
  match found {
    Just o -> Task.succeed o.id,
    Nothing -> Task.fail "lost",
  }
}

register : Text -> Task Customer.UserId
register email = Db.insert Customer { email: email, seen: Nothing }

charges : List (Task (Maybe Text))
charges = [Pay.charge { amount: 1.0, card: "a" }]

limits : Customer.UserId -> List (Query Int)
limits u = List.map (Pay.limit u) [1, 2]

allLimits : Customer.UserId -> Query (List Int)
allLimits u = Query.all (limits u)

firstQ : Query (Maybe Order.Order)
firstQ = Db.first (search Open (Date.fromText "2026-01-01" |> Maybe.withDefault (Time.toDate Time.epoch)) Time.epoch [])

remove : Order.OrderId -> Task Unit
remove id = Db.delete Order id

fetch : Text -> Task Text
fetch url = {
  let r <- Http.get { url: url }
  let i <- Random.id
  let n <- Time.now
  match r {
    Ok body -> Task.succeed body,
    Err e -> Task.fail i,
  }
}

createdBefore : Time -> Select Order.Order
createdBefore t = Db.from Order |> Db.where (Order.created.lt t) |> Db.orderBy Order.created.desc

newestFirst : Select Order.Order
newestFirst = Db.from Order |> Db.orderBy Order.created.desc

-- conditions on Maybe columns are two-valued: `Nothing` rows are matched by `in [.., Nothing]`
-- and by the negation of a condition they do not satisfy
lateIn : Order.Status -> Select Order.Order
lateIn s = Db.from Order |> Db.where (Order.late.in [Just s, Nothing]) |> Db.orderBy Order.code.asc

lateNothing : Select Order.Order
lateNothing = Db.from Order |> Db.where (Order.late.in [Nothing])

notLateIn : List (Maybe Order.Status) -> Select Order.Order
notLateIn ss = Db.from Order |> Db.where (Db.not (Order.late.in ss)) |> Db.orderBy Order.code.asc

notNote : Text -> Select Order.Order
notNote t = Db.from Order |> Db.where (Db.not (Order.note.eq (Just t)))
