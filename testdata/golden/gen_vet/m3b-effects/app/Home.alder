module Home

import Order
import Shop

route Home = GET  "/home"       { }            requires user
route Buy  = POST "/home" { code: Text } requires user

type Model = { n: Int, orders: List Order.Order }

Home.load : Home.Params -> Session -> Query Model
Home.load params session = {
  let n <- Shop.allOrders
  let os <- Db.all (Shop.search Open (Time.toDate Time.epoch) Time.epoch [Paid])
  Query.succeed { n: n, orders: os }
}

Buy.update : Buy.Params -> Session -> Task Response
Buy.update p session = {
  let id <- Shop.buy session.user p.code
  let k <- Shop.runJob Shop.job
  Task.succeed (if k > 0 then Response.redirect (Home {}) else Response.invalid "no")
}

Home.view : Model -> Session -> Html
Home.view model session = <p>{Text.fromInt model.n}</p>
