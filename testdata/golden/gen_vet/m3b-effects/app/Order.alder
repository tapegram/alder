module Order

import Customer

type OrderId = brand Text

type Status = Open | Paid | Shipped

table Order {
  id: OrderId @id,
  buyer: Customer.UserId @ref Customer,
  status: Status = Open,
  late: Maybe Status,
  total: Float,
  qty: Int,
  gift: Bool,
  day: Date,
  shipDay: Maybe Date,
  code: Text @unique,
  note: Maybe Text,
  created: Time @created,
  updated: Time @updated,
}
