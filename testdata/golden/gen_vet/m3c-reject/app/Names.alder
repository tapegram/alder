module Names

import Name

route Names = GET  "/"      { }
route Add   = POST "/names" { } form NewName

type Model = { names: List Name.Name }

Names.load : Names.Params -> Session -> Query Model
Names.load params session = {
  let names <-
    Db.from Name
      |> Db.orderBy Name.created.asc
      |> Db.all
  Query.succeed { names: names }
}

form NewName = { name: Text.NonEmpty }

Add.update : Add.Params -> Session -> Task Response
Add.update p session = {
  let _ <- Db.insert Name { name: p.form.name }
  let _ <- Session.put (\s -> { s | n: s.n + 1 })
  Task.succeed (Response.invalid "taken")
}

Names.view : Model -> Session -> Html
Names.view model session =
  <html>
    <head><title>Names</title></head>
    <body>
      <form submit={Add}>
        <Errors form />
        <Input field="name" label="Name" />
        <Errors field="name" />
        <button>Add</button>
        <button click={App.Reset}>Reset</button>
      </form>
      <ul id="names">
        {for n in model.names -> <li>{n.name}</li>}
      </ul>
      <p id="adds">{Text.fromInt session.n}</p>
    </body>
  </html>
