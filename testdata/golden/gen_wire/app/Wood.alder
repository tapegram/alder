module Wood

-- #55: a results app whose real URLs carry capitalised query keys
-- (/Results?ElectionId=17&ContestId=5); the fields stay lowercase.
route Wood = GET  "/r/{cfg}/wood/Results"        { cfg: Text, electionId: Text = "" as "ElectionId", contestId: Maybe Int as "ContestId" }
route Bump = POST "/r/{cfg}/wood/Results" { cfg: Text, electionId: Text = "" as "ElectionId" }

type Model = {
  cfg: Text,
  election: Text,
  contest: Maybe Int,
}

Wood.load : Wood.Params -> Session -> Query Model
Wood.load params session = Query.succeed {
  cfg: params.cfg,
  election: params.electionId,
  contest: params.contestId,
}

Bump.update : Bump.Params -> Session -> Task Response
Bump.update p session =
  Task.succeed (
    Response.redirect (Wood {
      cfg: p.cfg,
      electionId: p.electionId,
      contestId: Just 9,
    })
  )

Wood.view : Model -> Session -> Html
Wood.view model session =
  <html>
    <body>
      <p id="election">{model.election}</p>
      <a
        id="next"
        href={Wood {
          cfg: model.cfg,
          electionId: "18",
          contestId: Just 5,
        }}>
        next
      </a>
      <button click={Bump { cfg: model.cfg, electionId: model.election }}>bump</button>
    </body>
  </html>

test "a visit and a click use the wire keys" = {
  let page <-
    Test.get (Wood {
      cfg: "c",
      electionId: "17",
      contestId: Just 5,
    })
  let r <- Test.click (Bump { cfg: "c", electionId: "17" })
  Task.succeed (
    {
      election: page.model.election,
      contest: page.model.contest,
      shown: Test.text "#election" page.doc,
      next: Test.attr "href" "#next" page.doc,
      answer: r.answer,
    } == {
      election: "17",
      contest: Just 5,
      shown: Just "17",
      next: Just "/r/c/wood/Results?ElectionId=18&ContestId=5",
      answer: Redirected (Wood {
        cfg: "c",
        electionId: "17",
        contestId: Just 9,
      }),
    }
  )
}
