module App

import User

session { user: Maybe User.UserId }

login = Auth.Login.Login

route Logout = DELETE "/session" { }
route Send   = POST "/"   { } form Feedback

form Feedback = { text: Text }

Logout.update : Logout.Params -> Session -> Task Response
Logout.update p session = {
  let _ <- Session.put (\s -> { s | user: Nothing })
  Task.succeed (Response.redirect (Auth.Login.Login {}))
}

Send.update : Send.Params -> Session -> Task Response
Send.update p session = Task.succeed Response.refresh

error : Error -> Html
error err = <html><body><h1>Something went wrong</h1></body></html>

notFound : Html
notFound = <html><body><h1>Not found</h1></body></html>
