module R

-- Each value here is rendered by internal/gen's TestRenderGolden to want/<value>.html.

looping : Bool
looping = True

media : Html Never
media =
  <div>
    <video src="/static/intro.mp4" controls autoplay={False} muted loop={looping}>
      <track src="/static/intro.vtt" kind="captions" default />
    </video>
    <iframe src="/static/embed.html" title="Embed" allowfullscreen={False}></iframe>
    <script src="/static/app.js" async defer></script>
    <ol reversed><li>b</li><li>a</li></ol>
    <details open={False}><summary>More</summary></details>
  </div>

-- The bodies are raw text, byte for byte: `{`, `<`, `&&`, quotes and `--` are not Alder.
clip : Text
clip = "a\"</script><b>&"

inline : Html Never
inline =
  <div data-clip={clip}>
    <style>
      .player > video { width: 100%; } a[href^="/"]::after { content: "<→>"; }
    </style>
    <script>
      if (1 < 2 && true) { console.log("hi {there}"); }
      -- JavaScript's decrement, not an Alder comment
      const s = "{clip}" + `${s}` + '<b>&amp;</b>';
    </script>
    <script type="application/json">{"a": 1}</script>
  </div>

-- `src` takes a page value too: Url.external renders as its URL (a refused one as "#").
external : Html Never
external =
  <div>
    <script type="module" src={Url.external "https://cdn.example.com/x.js?v=1&b=2"}></script>
    <img src={Url.external "javascript:alert(1)"} alt="no" />
    <img src="/static/a.png" alt="a" />
  </div>
