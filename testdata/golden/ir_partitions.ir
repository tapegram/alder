(module Org)
(record Org.Org (id Text) (name Text))
(module Project)
(record Project.Project (id Text) (name Text) (org Text))
(module Admin.Projects)
(record Admin.Projects.Model (projects List Project) (n Int))
(record Admin.Projects.Projects.Params (org Text))
(record Admin.Projects.Remove.Params (org Text) (id Text))
(record Admin.Projects.Projects.Session (user Text) (org Text) (role User.Role))
(value Admin.Projects.Projects.load : Projects.Params -> Projects.Session -> Query Model (params session)
  (bind query projects : List Project
    (db-select Project.Project all)
    (bind query n : Int
      (db-run count (db-scoped Db.scoped org Project.Project))
      (pure query (record Model (projects (var projects)) (n (var n)))))))
(value Admin.Projects.Remove.update : Remove.Params -> Projects.Session -> Task Response (p session)
  (bind task _
    (db-delete Project.Project (field id (var p)))
    (pure task (std Response.refresh))))
(value Admin.Projects.Projects.view : Model -> Projects.Session -> Html (model session)
  (elem html
    (elem body
      (elem p (hexpr text (call (std Text.fromInt) (field n (var model))))))))
(module User)
(union User.Role (Reader) (Admin))
(record User.User (id Text) (name Text) (role Role = (ctor User.Role.Reader)))
(module App)
(record App.Session
  (user Maybe Text)
  (org Maybe Text)
  (role User.Role = (ctor User.Role.Reader)))
(record App.Leave.Params)
(value App.Leave.update : Leave.Params -> Session -> Task Response (params session)
  (bind task _
    (call (std Session.put)
      (lambda (s : Session) (update (var s) (org (ctor Prelude.Maybe.Nothing)))))
    (pure task
      (call (std Response.redirect)
        (route-ref Orgs.Index.Index (record Orgs.Index.Index.Params))))))
(value App.error : Error -> Html (err)
  (elem html (elem body (elem h1 (htext "error")))))
(value App.notFound : Html ()
  (elem html (elem body (elem h1 (htext "not found")))))
(value App.maintenance : Html ()
  (elem html (elem body (elem h1 (htext "down for maintenance")))))
(module Issue)
(record Issue.Issue (id Text) (title Text) (project Text) (org Text))
(module Label)
(record Label.Label (id Text) (name Text) (org Text))
(module Login)
(record Login.Model)
(record Login.Login.Params)
(value Login.Login.load : Login.Params -> App.Session -> Query Model (params session)
  (pure query (record Model)))
(value Login.Login.view : Model -> App.Session -> Html (model session)
  (elem html (elem body (elem h1 (htext "log in")))))
(module Membership)
(record Membership.Membership (id Text) (user Text) (org Text))
(module Note)
(record Note.Note (id Text) (text Text) (owner Text))
(module Notes.Index)
(record Notes.Index.Model (notes List Note) (n Int))
(record Notes.Index.Index.Params)
(record Notes.Index.Add.Params)
(record Notes.Index.Index.Session (user Text) (org Maybe Text) (role User.Role))
(value Notes.Index.Index.load : Index.Params -> Index.Session -> Query Model (params session)
  (bind query notes : List Note
    (db-run all (db-scoped Db.mine user Note.Note))
    (bind query n : Int
      (db-run count (db-scoped Db.scoped user Note.Note))
      (pure query (record Model (notes (var notes)) (n (var n)))))))
(value Notes.Index.Add.update : Add.Params -> Index.Session -> Task Response (params session)
  (bind task _
    (db-insert-scoped Db.insertMine user Note.Note (record (text "a")))
    (bind task _
      (db-insert-scoped Db.insertScoped user Note.Note (record (text "b")))
      (bind task _
        (call (std Session.put)
          (lambda (s : App.Session)
            (update (var s) (org (ctor Prelude.Maybe.Nothing)))))
        (pure task (std Response.refresh))))))
(value Notes.Index.Index.view : Model -> Index.Session -> Html (model session)
  (elem html
    (elem body
      (elem button (attr click click (route-ref Notes.Index.Add)) (htext "add")))))
(module Orgs.Index)
(record Orgs.Index.Model (mine List Membership))
(record Orgs.Index.Index.Params)
(record Orgs.Index.Pick.Params (org Text))
(record Orgs.Index.Index.Session (user Text) (org Maybe Text) (role User.Role))
(value Orgs.Index.Index.load : Index.Params -> Index.Session -> Query Model (params session)
  (bind query mine : List Membership
    (db-select Membership.Membership
      (where
        (cond eq (col Membership.Membership user) (field user (var session))))
      all)
    (pure query (record Model (mine (var mine))))))
(value Orgs.Index.Pick.update : Pick.Params -> Index.Session -> Task Response (p session)
  (bind task _
    (call (std Session.put)
      (lambda (s : App.Session)
        (update (var s)
          (org (ctor Prelude.Maybe.Just (record (value (field org (var p)))))))))
    (pure task
      (call (std Response.redirect)
        (route-ref Projects.Index.Index (record Projects.Index.Index.Params))))))
(value Orgs.Index.Index.view : Model -> Index.Session -> Html (model session)
  (elem html
    (elem body
      (elem ul
        (hfor m : Membership
          (field mine (var model))
          (elem li
            (elem button
              (attr click click
                (route-ref Orgs.Index.Pick
                  (record Pick.Params (org (field org (var m))))))
              (htext "pick"))))))))
(module Projects.Index)
(record Projects.Index.Model (org Text) (projects List Project) (labels Int))
(record Projects.Index.NewProject (name Text))
(record Projects.Index.Index.Params)
(record Projects.Index.Add.Params (form NewProject))
(record Projects.Index.Rename.Params (id Text))
(record Projects.Index.Remove.Params (id Text))
(record Projects.Index.Seed.Params)
(record Projects.Index.Both.Params (id Text))
(record Projects.Index.Tag.Params)
(record Projects.Index.Index.Session (user Text) (org Text) (role User.Role))
(value Projects.Index.recent : Select Project ()
  (db-select Project.Project
    (base (db-scoped Db.scoped org Project.Project))
    (limit 10)
    select))
(value Projects.Index.seed : Text -> Task Unit (name)
  (bind task id : Text
    (db-insert-scoped Db.insertScoped org Project.Project
      (record (name (var name))))
    (bind task _
      (db-insert-scoped Db.insertScoped org Issue.Issue
        (record (title "first") (project (var id))))
      (pure task ()))))
(value Projects.Index.Index.load : Index.Params -> Index.Session -> Query Model (params session)
  (bind query org : Maybe Org
    (db-get Org.Org (field org (var session)))
    (bind query projects : List Project
      (db-run all (global Projects.Index.recent))
      (bind query labels : Int
        (db-run count (db-scoped Db.scoped org Label.Label))
        (pure query
          (record Model
            (org
              (call (std Maybe.withDefault)
                ""
                (call (std Maybe.map)
                  (lambda (o : Org) (field name (var o)))
                  (var org))))
            (projects (var projects))
            (labels (var labels))))))))
(value Projects.Index.Add.update : Add.Params -> Index.Session -> Task Response (p session)
  (bind task _
    (db-insert-scoped Db.insertScoped org Project.Project
      (record (name (field name (field form (var p))))))
    (pure task (std Response.refresh))))
(value Projects.Index.Rename.update : Rename.Params -> Index.Session -> Task Response (p session)
  (bind task pr : Project
    (db-get-scoped Db.getScoped org Project.Project (field id (var p)))
    (bind task _
      (db-update-scoped Db.updateScoped org Project.Project
        (field id (var pr))
        (lambda (x : Project) (update (var x) (name "renamed"))))
      (pure task (std Response.refresh)))))
(value Projects.Index.Remove.update : Remove.Params -> Index.Session -> Task Response (p session)
  (bind task _
    (db-delete-scoped Db.deleteScoped org Project.Project (field id (var p)))
    (pure task (std Response.refresh))))
(value Projects.Index.Seed.update : Seed.Params -> Index.Session -> Task Response (params session)
  (bind task _
    (all task (call (std List.map) (global Projects.Index.seed) (list "a" "b")))
    (pure task (std Response.refresh))))
(value Projects.Index.Both.update : Both.Params -> Index.Session -> Task Response (p session)
  (bind task _
    (db-get Org.Org (field org (var session)))
    (bind task n : Int
      (db-select Membership.Membership count)
      (bind task _
        (db-update-scoped Db.updateScoped org Project.Project
          (field id (var p))
          (lambda (x : Project)
            (update (var x) (name (call (std Text.fromInt) (var n))))))
        (pure task (std Response.refresh))))))
(value Projects.Index.Tag.update : Tag.Params -> Index.Session -> Task Response (params session)
  (bind task _
    (db-insert-scoped Db.insertScoped org Label.Label (record (name "new")))
    (pure task (std Response.refresh))))
(value Projects.Index.Index.view : Model -> Index.Session -> Html (model session)
  (elem html
    (elem body
      (elem h1 (hexpr text (field org (var model))))
      (form-el (route Projects.Index.Add)
        (attr submit submit (route-ref Projects.Index.Add))
        (input Input NewProject field=name label="Name")
        (input Errors NewProject form)
        (elem button (htext "Add")))
      (elem ul
        (hfor p : Project
          (field projects (var model))
          (elem li
            (elem span (hexpr text (field name (var p))))
            (elem button
              (attr click click
                (route-ref Projects.Index.Rename
                  (record Rename.Params (id (field id (var p))))))
              (htext "rename"))
            (elem button
              (attr click click
                (route-ref Projects.Index.Remove
                  (record Remove.Params (id (field id (var p))))))
              (htext "remove"))
            (elem button
              (attr click click
                (route-ref Projects.Index.Both
                  (record Both.Params (id (field id (var p))))))
              (htext "both")))))
      (elem button (attr click click (route-ref Projects.Index.Seed))
        (htext "seed"))
      (elem button (attr click click (route-ref Projects.Index.Tag))
        (htext "tag")))))
(test "an org's member sees its projects" task
  (bind task me : Text
    (db-insert User.User (record (name "Me") (role (ctor User.Role.Reader))))
    (bind task o : Text
      (db-insert Org.Org (record (name "Acme")))
      (bind task _
        (db-insert Membership.Membership (record (user (var me)) (org (var o))))
        (bind task _
          (db-insert Project.Project (record (name "p") (org (var o))))
          (bind task _
            (test-login
              (record App.Session
                (user (ctor Prelude.Maybe.Just (record (value (var me)))))
                (org (ctor Prelude.Maybe.Just (record (value (var o)))))
                (role (ctor User.Role.Reader))))
            (bind task page : { model: Model, session: App.Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
              (test-get (route Projects.Index.Index) (record Index.Params))
              (pure task
                (test-eq
                  (call (std List.length)
                    (field projects (field model (var page))))
                  1)))))))))
(module Projects.Show)
(record Projects.Show.Model (project Project) (others List Project))
(record Projects.Show.Show.Params (id Text))
(record Projects.Show.Show.Session (user Text) (org Text) (role User.Role))
(value Projects.Show.Show.load : Show.Params -> Show.Session -> Query Model (params session)
  (bind query project : Project
    (db-get-scoped Db.getScoped org Project.Project (field id (var params)))
    (bind query others : List Project
      (db-run all (global Projects.Index.recent))
      (pure query (record Model (project (var project)) (others (var others)))))))
(value Projects.Show.Show.view : Model -> Show.Session -> Html (model session)
  (elem html
    (elem body (elem h1 (hexpr text (field name (field project (var model))))))))
(table Org.Org (id id) (insert name))
(table Project.Project
  (id id)
  (partition org org)
  (ref org Org.Org)
  (insert name org))
(table User.User (id id) (insert name role))
(table Issue.Issue
  (id id)
  (partition org org)
  (ref project Project.Project cascade)
  (ref org Org.Org)
  (insert title project org))
(table Label.Label
  (id id)
  (partition org org)
  (ref org Org.Org)
  (insert name org))
(table Membership.Membership
  (id id)
  (ref user User.User cascade)
  (ref org Org.Org cascade)
  (insert user org))
(table Note.Note
  (id id)
  (partition user owner)
  (ref owner User.User)
  (insert text owner))
(form Projects.Index.NewProject)
(route Admin.Projects.Projects GET "/admin/orgs/{org}/projects"
  (params Projects.Params)
  (requires user)
  (roles Admin)
  (silo org)
  (session Projects.Session)
  (model Model)
  (load Admin.Projects.Projects.load)
  (view Admin.Projects.Projects.view))
(route Admin.Projects.Remove POST "/admin/orgs/{org}/projects"
  (params Remove.Params)
  (requires user)
  (roles Admin)
  (silo org)
  (session Projects.Session)
  (update Admin.Projects.Remove.update)
  (store silo org)
  (needs-shown))
(route App.Leave POST "/"
  (params Leave.Params)
  (update App.Leave.update)
  (store shared))
(route Login.Login GET "/login"
  (params Login.Params)
  (model Model)
  (load Login.Login.load)
  (view Login.Login.view))
(route Notes.Index.Index GET "/notes"
  (params Index.Params)
  (requires user)
  (session Index.Session)
  (model Model)
  (load Notes.Index.Index.load)
  (view Notes.Index.Index.view))
(route Notes.Index.Add POST "/notes"
  (params Add.Params)
  (requires user)
  (session Index.Session)
  (update Notes.Index.Add.update)
  (store shared)
  (needs-shown))
(route Orgs.Index.Index GET "/orgs"
  (params Index.Params)
  (requires user)
  (session Index.Session)
  (model Model)
  (load Orgs.Index.Index.load)
  (view Orgs.Index.Index.view))
(route Orgs.Index.Pick POST "/orgs"
  (params Pick.Params)
  (requires user)
  (session Index.Session)
  (update Orgs.Index.Pick.update)
  (store shared))
(route Projects.Index.Index GET "/projects"
  (params Index.Params)
  (requires user org)
  (session Index.Session)
  (model Model)
  (load Projects.Index.Index.load)
  (view Projects.Index.Index.view))
(route Projects.Index.Add POST "/projects"
  (params Add.Params)
  (form NewProject)
  (requires user org)
  (session Index.Session)
  (update Projects.Index.Add.update)
  (store silo org)
  (needs-shown))
(route Projects.Index.Rename POST "/projects/renames"
  (params Rename.Params)
  (requires user org)
  (session Index.Session)
  (update Projects.Index.Rename.update)
  (store silo org)
  (needs-shown))
(route Projects.Index.Remove POST "/projects/removes"
  (params Remove.Params)
  (requires user org)
  (session Index.Session)
  (update Projects.Index.Remove.update)
  (store silo org)
  (needs-shown))
(route Projects.Index.Seed POST "/projects/seeds"
  (params Seed.Params)
  (requires user org)
  (session Index.Session)
  (update Projects.Index.Seed.update)
  (store silo org)
  (needs-shown))
(route Projects.Index.Both POST "/projects/boths"
  (params Both.Params)
  (requires user org)
  (session Index.Session)
  (update Projects.Index.Both.update)
  (store silo org)
  (needs-shown))
(route Projects.Index.Tag POST "/projects/tags"
  (params Tag.Params)
  (requires user org)
  (session Index.Session)
  (update Projects.Index.Tag.update)
  (store shared)
  (needs-shown))
(route Projects.Show.Show GET "/projects/{id}"
  (params Show.Params)
  (requires user org)
  (session Show.Session)
  (model Model)
  (load Projects.Show.Show.load)
  (view Projects.Show.Show.view))
(session App.Session)
(via org Membership.Membership)
(silo org Project.Project Issue.Issue)
(choose org Orgs.Index.Index)
