(module User)
(record User.User (id Text) (email Text) (name Text))
(module App)
(record App.Session (user Maybe Text))
(record App.Feedback (text Text))
(record App.Logout.Params)
(record App.Send.Params (form Feedback))
(value App.Logout.update : Logout.Params -> Session -> Task Response (p session)
  (bind task _
    (call (std Session.put)
      (lambda (s : Session)
        (update (var s) (user (ctor Prelude.Maybe.Nothing)))))
    (pure task
      (call (std Response.redirect)
        (route-ref Auth.Login.Login (record Auth.Login.Login.Params))))))
(value App.Send.update : Send.Params -> Session -> Task Response (p session)
  (pure task (std Response.refresh)))
(value App.error : Error -> Html (err)
  (elem html (elem body (elem h1 (htext "Something went wrong")))))
(value App.notFound : Html ()
  (elem html (elem body (elem h1 (htext "Not found")))))
(module Auth.Login)
(record Auth.Login.Model)
(record Auth.Login.Credentials (email Text) (password Text))
(record Auth.Login.Login.Params)
(record Auth.Login.Submit.Params (form Credentials))
(value Auth.Login.Login.load : Login.Params -> App.Session -> Query Model (params session)
  (pure query (record Model)))
(value Auth.Login.Submit.update : Submit.Params -> App.Session -> Task Response (p session)
  (bind task found : Maybe Text
    (cap Auth.Login.Password verify
      (record
        (email (field email (field form (var p))))
        (password (field password (field form (var p))))))
    (match union (var found)
      (case Just (bind _m1 value : Text)
        (let id : Text
          (var _m1)
          (bind task _
            (call (std Session.put)
              (lambda (s : App.Session)
                (update (var s)
                  (user (ctor Prelude.Maybe.Just (record (value (var id))))))))
            (pure task
              (call (std Response.redirect)
                (route-ref Notes.Index.Index
                  (record Notes.Index.Index.Params
                    (filter (ctor Note.Filter.All)))))))))
      (case Nothing
        (pure task
          (call (std Response.invalid) "Email or password is incorrect."))))))
(value Auth.Login.Login.view : Model -> App.Session -> Html (model session)
  (elem html
    (elem body
      (elem h1 (htext "Log in"))
      (form-el (route Auth.Login.Submit)
        (attr submit submit (route-ref Auth.Login.Submit))
        (input Errors Credentials form)
        (input Input Credentials field=email label="Email")
        (input Errors Credentials field=email)
        (input Input Credentials field=password label="Password")
        (input Errors Credentials field=password)
        (elem button (htext "Log in"))))))
(test "a page that requires a user redirects to the login page" task
  (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
    (test-open (route Notes.Index.Index)
      (record Notes.Index.Index.Params (filter (ctor Note.Filter.All))))
    (pure task
      (test-eq
        (record
          (answer (field answer (var r)))
          (title (call (std Test.text) "h1" (field doc (var r))))
          (user (field user (field session (var r)))))
        (record
          (answer
            (ctor Prelude.Answer.Redirected
              (record
                (value (route-ref Auth.Login.Login (record Login.Params))))))
          (title (ctor Prelude.Maybe.Just (record (value "Log in"))))
          (user (ctor Prelude.Maybe.Nothing)))))))
(test "logging in through the form" task
  (bind task _
    (test-fake Auth.Login.Password)
    (bind task me : Text
      (db-insert User.User (record (email "me@example.com") (name "Me")))
      (bind task _
        (test-get (route Auth.Login.Login) (record Login.Params))
        (bind task wrong : { answer: Answer, session: App.Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
          (test-submit Auth.Login.Credentials (route Auth.Login.Submit)
            (record Credentials (email "me@example.com") (password "nope")))
          (bind task right : { answer: Answer, session: App.Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
            (test-submit Auth.Login.Credentials (route Auth.Login.Submit)
              (record Credentials (email "me@example.com") (password "secret")))
            (pure task
              (test-eq
                (record
                  (wrong (field answer (var wrong)))
                  (wrongUser (field user (field session (var wrong))))
                  (right (field answer (var right)))
                  (user (field user (field session (var right))))
                  (title (call (std Test.text) "h1" (field doc (var right)))))
                (record
                  (wrong
                    (ctor Prelude.Answer.FormRejected
                      (record
                        (value
                          (list
                            (record
                              (field "")
                              (message "Email or password is incorrect.")))))))
                  (wrongUser (ctor Prelude.Maybe.Nothing))
                  (right
                    (ctor Prelude.Answer.Redirected
                      (record
                        (value
                          (route-ref Notes.Index.Index
                            (record Notes.Index.Index.Params
                              (filter (ctor Note.Filter.All))))))))
                  (user (ctor Prelude.Maybe.Just (record (value (var me)))))
                  (title (ctor Prelude.Maybe.Just (record (value "Notes")))))))))))))
(test "Test.login, then log out through the button" task
  (bind task me : Text
    (db-insert User.User (record (email "me@example.com") (name "Me")))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))))
      (bind task shown : { answer: Answer, session: App.Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
        (test-open (route Notes.Index.Index)
          (record Notes.Index.Index.Params (filter (ctor Note.Filter.All))))
        (bind task out : { answer: Answer, session: App.Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
          (test-click (route App.Logout))
          (pure task
            (test-eq
              (record
                (shown (field answer (var shown)))
                (out (field answer (var out)))
                (user (field user (field session (var out)))))
              (record
                (shown (ctor Prelude.Answer.Shown))
                (out
                  (ctor Prelude.Answer.Redirected
                    (record
                      (value (route-ref Auth.Login.Login (record Login.Params))))))
                (user (ctor Prelude.Maybe.Nothing))))))))))
(module Note)
(union Note.Filter (All) (Open) (Done))
(union Note.Kind (Plain) (Idea) (Chore))
(record Note.Note (id Text) (title Text) (done Bool = False) (owner Text))
(value Note.matches : Filter -> Note -> Bool (filter note)
  (match union (var filter)
    (case All True)
    (case Open (call (std Prelude.not) (field done (var note))))
    (case Done (field done (var note)))))
(value Note.filterLabel : Filter -> Text (filter)
  (match union (var filter)
    (case All "All")
    (case Open "Open")
    (case Done "Done")))
(module Notes.Index)
(record Notes.Index.Model (filter Note.Filter) (notes List Note) (now Time))
(record Notes.Index.NewNote
  (title Text)
  (due Maybe Date)
  (urgent Bool)
  (priority Int = 1)
  (weight Float = 1.5)
  (kind Note.Kind = (ctor Note.Kind.Plain))
  (remark Text = "")
  (contact Maybe Text))
(record Notes.Index.Title (title Text))
(record Notes.Index.Prefs
  (site Text)
  (pin Text)
  (tag Text)
  (count Int)
  (reminder Maybe Int = (ctor Prelude.Maybe.Just (record (value 3)))))
(record Notes.Index.Index.Params (filter Note.Filter = (ctor Note.Filter.All)))
(record Notes.Index.Submit.Params
  (filter Note.Filter = (ctor Note.Filter.All))
  (form NewNote))
(record Notes.Index.Toggle.Params (id Text))
(record Notes.Index.Boom.Params)
(record Notes.Index.Rename.Params (id Text) (form Title))
(record Notes.Index.SavePrefs.Params (form Prefs))
(record Notes.Index.Index.Session (user Text))
(value Notes.Index.Index.load : Index.Params -> Index.Session -> Query Model (params session)
  (bind query notes : List Note
    (db-select Note.Note
      (where (cond eq (col Note.Note owner) (field user (var session))))
      all)
    (bind query now : Time
      (std Time.now)
      (pure query
        (record Model
          (filter (field filter (var params)))
          (notes
            (call (std List.filter)
              (partial (global Note.matches)
                (field filter (var params))
                (missing 1))
              (var notes)))
          (now (var now)))))))
(value Notes.Index.Submit.update : Submit.Params -> Index.Session -> Task Response (p session)
  (bind task _
    (db-insert Note.Note
      (record
        (title (field title (field form (var p))))
        (done False)
        (owner (field user (var session)))))
    (pure task
      (call (std Response.redirect)
        (route-ref Notes.Index.Index
          (record Index.Params (filter (field filter (var p)))))))))
(value Notes.Index.Toggle.update : Toggle.Params -> Index.Session -> Task Response (p session)
  (bind task found : Maybe Note
    (db-get Note.Note (field id (var p)))
    (match union (var found)
      (case Just (bind _m1 value : Note)
        (let n : Note
          (var _m1)
          (if (== : Text (field owner (var n)) (field user (var session)))
            (bind task _
              (db-update Note.Note
                (field id (var n))
                (lambda (x : Note)
                  (update (var x)
                    (done (call (std Prelude.not) (field done (var x)))))))
              (pure task (std Response.refresh)))
            (not-found))))
      (case Nothing (not-found)))))
(value Notes.Index.Boom.update : Boom.Params -> Index.Session -> Task Response (p session)
  (bind task notes : List Note
    (db-select Note.Note
      (where (cond eq (col Note.Note owner) (field user (var session))))
      all)
    (bind task _
      (all task
        (call (std List.map)
          (lambda (n : Note)
            (db-update Note.Note
              (field id (var n))
              (lambda (x : Note) (update (var x) (done True)))))
          (var notes)))
      (let zero : Int
        (-
          (call (std List.length) (var notes))
          (call (std List.length) (var notes)))
        (pure task
          (if (== : Int (/ 1 (var zero)) 0)
            (std Response.refresh)
            (std Response.refresh)))))))
(value Notes.Index.Rename.update : Rename.Params -> Index.Session -> Task Response (p session)
  (bind task _
    (db-update Note.Note
      (field id (var p))
      (lambda (x : Note)
        (update (var x) (title (field title (field form (var p)))))))
    (pure task (std Response.refresh))))
(value Notes.Index.SavePrefs.update : SavePrefs.Params -> Index.Session -> Task Response (p session)
  (pure task (std Response.refresh)))
(value Notes.Index.Index.view : Model -> Index.Session -> Html (model session)
  (elem html
    (elem body
      (elem h1 (htext "Notes"))
      (form-el (route Notes.Index.Submit)
        (attr submit submit
          (route-ref Notes.Index.Submit
            (record Submit.Params (filter (field filter (var model))))))
        (input Errors NewNote form)
        (input Input NewNote field=title label="Title")
        (input Errors NewNote field=title)
        (input Input NewNote field=due label="Due")
        (input Errors NewNote field=due)
        (input Input NewNote field=urgent label="Urgent")
        (input Input NewNote field=priority label="Priority")
        (input Errors NewNote field=priority)
        (input Input NewNote field=weight label="Weight")
        (input Errors NewNote field=weight)
        (input Select NewNote field=kind label="Kind")
        (input Errors NewNote field=kind)
        (input Input NewNote field=remark label="Remark")
        (input Input NewNote field=contact label="Contact")
        (input Errors NewNote field=contact)
        (elem button (htext "Add")))
      (elem nav
        (hfor f : Note.Filter
          (list
            (ctor Note.Filter.All)
            (ctor Note.Filter.Open)
            (ctor Note.Filter.Done))
          (elem a
            (attr href href
              (route-ref Notes.Index.Index
                (record Index.Params (filter (var f)))))
            (hexpr text (call (global Note.filterLabel) (var f))))))
      (elem ul (attr id text "notes")
        (hfor n : Note
          (field notes (var model))
          (elem li (attr class text (if (field done (var n)) "done" "open"))
            (elem button
              (attr class text "toggle")
              (attr click click
                (route-ref Notes.Index.Toggle
                  (record Toggle.Params (id (field id (var n))))))
              (hexpr text (field title (var n))))
            (form-el (route Notes.Index.Rename)
              (attr submit submit
                (route-ref Notes.Index.Rename
                  (record Rename.Params (id (field id (var n))))))
              (input Input Title field=title label="New title")
              (input Errors Title field=title)
              (elem button (htext "Rename"))))))
      (elem p (attr id text "summary")
        (hexpr text
          (call (std Text.fromInt)
            (call (std List.length) (field notes (var model)))))
        (htext " shown"))
      (elem p (attr id text "filter")
        (hexpr text (call (global Note.filterLabel) (field filter (var model)))))
      (elem p (attr id text "now")
        (hexpr text (call (std Time.format) "15:04:05" (field now (var model)))))
      (form-el (route App.Send) (attr submit submit (route-ref App.Send))
        (input Input App.Feedback field=text label="Feedback")
        (input Errors App.Feedback field=text)
        (elem button (htext "Send")))
      (elem button (attr click click (route-ref Notes.Index.Boom))
        (htext "Boom"))
      (elem button (attr click click (route-ref App.Logout)) (htext "Log out")))))
(test "adding a note through the form" task
  (bind task me : Text
    (db-insert User.User (record (email "me@example.com") (name "Me")))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))))
      (bind task page : { model: Model, session: App.Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
        (test-get (route Notes.Index.Index)
          (record Index.Params (filter (ctor Note.Filter.All))))
        (bind task after : { answer: Answer, session: App.Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
          (test-submit Notes.Index.NewNote (route Notes.Index.Submit)
            (params (record Submit.Params (filter (ctor Note.Filter.All))))
            (record NewNote
              (title "Milk")
              (due (ctor Prelude.Maybe.Nothing))
              (urgent False)
              (priority 1)
              (weight 1.5)
              (kind (ctor Note.Kind.Plain))
              (remark "")
              (contact (ctor Prelude.Maybe.Nothing))))
          (pure task
            (test-eq
              (record
                (before (field notes (field model (var page))))
                (answer (field answer (var after)))
                (summary
                  (call (std Test.text) "#summary" (field doc (var after))))
                (items
                  (call (std Test.texts)
                    "#notes .toggle"
                    (field doc (var after))))
                (done (call (std Test.has) "li.done" (field doc (var after)))))
              (record
                (before (list))
                (answer
                  (ctor Prelude.Answer.Redirected
                    (record
                      (value
                        (route-ref Notes.Index.Index
                          (record Index.Params (filter (ctor Note.Filter.All))))))))
                (summary (ctor Prelude.Maybe.Just (record (value "1 shown"))))
                (items (list "Milk"))
                (done False)))))))))
(test "a click keeps the page's parameter" task
  (bind task me : Text
    (db-insert User.User (record (email "me@example.com") (name "Me")))
    (bind task id : Text
      (db-insert Note.Note
        (record (title "Milk") (done False) (owner (var me))))
      (bind task _
        (test-login
          (record App.Session
            (user (ctor Prelude.Maybe.Just (record (value (var me)))))))
        (bind task page : { model: Model, session: App.Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
          (test-get (route Notes.Index.Index)
            (record Index.Params (filter (ctor Note.Filter.Open))))
          (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
            (test-click (route Notes.Index.Toggle)
              (record Toggle.Params (id (var id))))
            (pure task
              (test-eq
                (record
                  (filter (field filter (field model (var page))))
                  (before (call (std Test.count) "li" (field doc (var page))))
                  (answer (field answer (var r)))
                  (shown (call (std Test.text) "#filter" (field doc (var r))))
                  (after (call (std Test.count) "li" (field doc (var r)))))
                (record
                  (filter (ctor Note.Filter.Open))
                  (before 1)
                  (answer (ctor Prelude.Answer.Refreshed))
                  (shown (ctor Prelude.Maybe.Just (record (value "Open"))))
                  (after 0))))))))))
(test "a form with an empty title is rejected" task
  (bind task me : Text
    (db-insert User.User (record (email "me@example.com") (name "Me")))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))))
      (bind task _
        (test-get (route Notes.Index.Index)
          (record Index.Params (filter (ctor Note.Filter.All))))
        (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
          (test-submit-raw Notes.Index.NewNote (route Notes.Index.Submit)
            (params (record Submit.Params (filter (ctor Note.Filter.All))))
            (list
              (record (name "title") (value ""))
              (record (name "priority") (value "x"))))
          (bind task rows : Int
            (db-select Note.Note count)
            (pure task
              (test-eq
                (record
                  (answer (field answer (var r)))
                  (rows (var rows))
                  (priority
                    (call (std Test.attr)
                      "value"
                      "input[name=priority]"
                      (field doc (var r)))))
                (record
                  (answer
                    (ctor Prelude.Answer.FormRejected
                      (record
                        (value
                          (list
                            (record
                              (field "title")
                              (message "must not be empty"))
                            (record
                              (field "priority")
                              (message "must be a whole number")))))))
                  (rows 0)
                  (priority (ctor Prelude.Maybe.Just (record (value "x")))))))))))))
(test "a step inside Test.run" task
  (bind task me : Text
    (db-insert User.User (record (email "me@example.com") (name "Me")))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))))
      (bind task r : { value: Result Text Int, trace: List Text }
        (test-run
          (bind task page : { model: Model, session: App.Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
            (test-get (route Notes.Index.Index)
              (record Index.Params (filter (ctor Note.Filter.All))))
            (pure task (call (std Test.count) "li" (field doc (var page))))))
        (pure task
          (test-eq
            (field value (var r))
            (ctor Prelude.Result.Ok (record (value 0)))))))))
(test "a panicking update is RequestFailed" task
  (bind task me : Text
    (db-insert User.User (record (email "me@example.com") (name "Me")))
    (bind task id : Text
      (db-insert Note.Note
        (record (title "Milk") (done False) (owner (var me))))
      (bind task _
        (test-login
          (record App.Session
            (user (ctor Prelude.Maybe.Just (record (value (var me)))))))
        (bind task _
          (test-get (route Notes.Index.Index)
            (record Index.Params (filter (ctor Note.Filter.All))))
          (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
            (test-click (route Notes.Index.Boom))
            (bind task rows : Int
              (db-select Note.Note
                (where (cond eq (col Note.Note done) False))
                count)
              (let failed : Bool
                (match union (field answer (var r))
                  (case RequestFailed True)
                  (default False))
                (pure task
                  (test-eq
                    (record
                      (failed (var failed))
                      (rows (var rows))
                      (title (call (std Test.text) "h1" (field doc (var r)))))
                    (record
                      (failed True)
                      (rows 1)
                      (title
                        (ctor Prelude.Maybe.Just
                          (record (value "Something went wrong")))))))))))))))
(test "the document and the view agree" task
  (bind task me : Text
    (db-insert User.User (record (email "me@example.com") (name "Me")))
    (bind task _
      (db-insert Note.Note
        (record (title "Milk") (done False) (owner (var me))))
      (bind task _
        (test-login
          (record App.Session
            (user (ctor Prelude.Maybe.Just (record (value (var me)))))))
        (bind task page : { model: Model, session: App.Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
          (test-get (route Notes.Index.Index)
            (record Index.Params (filter (ctor Note.Filter.Open))))
          (let sel : Text
            "nav a"
            (let bad : Text
              "nav >"
              (pure task
                (test-eq
                  (record
                    (same
                      (== : Doc (field doc (var page))
                        (call (std Test.doc)
                          (call (global Notes.Index.Index.view)
                            (field model (var page))
                            (record Index.Session (user (var me)))))))
                    (links
                      (call (std Test.texts) (var sel) (field doc (var page))))
                    (bad
                      (call (std Test.count) (var bad) (field doc (var page))))
                    (href
                      (call (std Test.attr)
                        "href"
                        "nav a"
                        (field doc (var page))))
                    (none
                      (call (std Test.text) "#nothing" (field doc (var page)))))
                  (record
                    (same True)
                    (links (list "All" "Open" "Done"))
                    (bad 0)
                    (href (ctor Prelude.Maybe.Just (record (value "/"))))
                    (none (ctor Prelude.Maybe.Nothing))))))))))))
(test "a stranger's note is missing" task
  (bind task me : Text
    (db-insert User.User (record (email "me@example.com") (name "Me")))
    (bind task id : Text
      (db-insert Note.Note
        (record (title "Milk") (done False) (owner (var me))))
      (bind task _
        (test-login
          (record App.Session
            (user (ctor Prelude.Maybe.Just (record (value "stranger"))))))
        (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
          (test-open (route Notes.Show.Show)
            (record Notes.Show.Show.Params (id (var id))))
          (pure task
            (test-eq (field answer (var r)) (ctor Prelude.Answer.PageMissing))))))))
(test "the model is the one the page rendered" task
  (bind task me : Text
    (db-insert User.User (record (email "me@example.com") (name "Me")))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))))
      (bind task page : { model: Model, session: App.Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
        (test-get (route Notes.Index.Index)
          (record Index.Params (filter (ctor Note.Filter.All))))
        (bind task trace : List Text
          (test-trace)
          (pure task
            (test-eq
              (record
                (shown (call (std Test.text) "#now" (field doc (var page))))
                (same
                  (== : Doc (field doc (var page))
                    (call (std Test.doc)
                      (call (global Notes.Index.Index.view)
                        (field model (var page))
                        (record Index.Session (user (var me)))))))
                (trace (var trace)))
              (record
                (shown
                  (ctor Prelude.Maybe.Just
                    (record
                      (value
                        (call (std Time.format)
                          "15:04:05"
                          (field now (field model (var page))))))))
                (same True)
                (trace
                  (list
                    "Db.insert User"
                    "Test.login"
                    "Test.get Notes.Index.Index"
                    "Db.all Note"
                    "Time.now"))))))))))
(test "renaming one row's note" task
  (bind task me : Text
    (db-insert User.User (record (email "me@example.com") (name "Me")))
    (bind task a : Text
      (db-insert Note.Note (record (title "A") (done False) (owner (var me))))
      (bind task b : Text
        (db-insert Note.Note (record (title "B") (done False) (owner (var me))))
        (bind task _
          (test-login
            (record App.Session
              (user (ctor Prelude.Maybe.Just (record (value (var me)))))))
          (bind task _
            (test-get (route Notes.Index.Index)
              (record Index.Params (filter (ctor Note.Filter.All))))
            (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
              (test-submit Notes.Index.Title (route Notes.Index.Rename)
                (params (record Rename.Params (id (var b))))
                (record Title (title "B2")))
              (bind task na : Maybe Note
                (db-get Note.Note (var a))
                (bind task nb : Maybe Note
                  (db-get Note.Note (var b))
                  (pure task
                    (test-eq
                      (record
                        (answer (field answer (var r)))
                        (a
                          (call (std Maybe.map)
                            (lambda (n : Note) (field title (var n)))
                            (var na)))
                        (b
                          (call (std Maybe.map)
                            (lambda (n : Note) (field title (var n)))
                            (var nb))))
                      (record
                        (answer (ctor Prelude.Answer.Refreshed))
                        (a (ctor Prelude.Maybe.Just (record (value "A"))))
                        (b (ctor Prelude.Maybe.Just (record (value "B2"))))))))))))))))
(test "an App form" task
  (bind task me : Text
    (db-insert User.User (record (email "me@example.com") (name "Me")))
    (bind task _
      (test-login
        (record App.Session
          (user (ctor Prelude.Maybe.Just (record (value (var me)))))))
      (bind task _
        (test-get (route Notes.Index.Index)
          (record Index.Params (filter (ctor Note.Filter.All))))
        (bind task r : { answer: Answer, session: App.Session, doc: Doc, notices: List Text, toasts: List { kind: Text, text: Text }, url: Text, status: Int }
          (test-submit App.Feedback (route App.Send)
            (record App.Feedback (text "nice")))
          (pure task
            (test-eq (field answer (var r)) (ctor Prelude.Answer.Refreshed))))))))
(module Notes.Show)
(record Notes.Show.Model (note Note))
(record Notes.Show.Show.Params (id Text))
(record Notes.Show.Show.Session (user Text))
(value Notes.Show.Show.load : Show.Params -> Show.Session -> Query Model (params session)
  (bind query found : Maybe Note
    (db-get Note.Note (field id (var params)))
    (match union (var found)
      (case Just (bind _m1 value : Note)
        (let note : Note
          (var _m1)
          (if (== : Text (field owner (var note)) (field user (var session)))
            (pure query (record Model (note (var note))))
            (not-found))))
      (case Nothing (not-found)))))
(value Notes.Show.Show.view : Model -> Show.Session -> Html (model session)
  (elem html
    (elem body (elem h1 (hexpr text (field title (field note (var model))))))))
(table User.User (id id) (unique email) (insert email name))
(table Note.Note (id id) (ref owner User.User) (insert title done owner))
(form App.Feedback)
(form Auth.Login.Credentials)
(form Notes.Index.NewNote)
(form Notes.Index.Title)
(form Notes.Index.Prefs)
(route App.Logout DELETE "/session"
  (params Logout.Params)
  (update App.Logout.update))
(route App.Send POST "/"
  (params Send.Params)
  (form Feedback)
  (update App.Send.update)
  (needs-shown))
(route Auth.Login.Login GET "/login"
  (params Login.Params)
  (model Model)
  (load Auth.Login.Login.load)
  (view Auth.Login.Login.view))
(route Auth.Login.Submit POST "/login"
  (params Submit.Params)
  (form Credentials)
  (update Auth.Login.Submit.update)
  (needs-shown))
(route Notes.Index.Index GET "/"
  (params Index.Params)
  (requires user)
  (session Index.Session)
  (model Model)
  (load Notes.Index.Index.load)
  (view Notes.Index.Index.view))
(route Notes.Index.Submit POST "/submits"
  (params Submit.Params)
  (form NewNote)
  (requires user)
  (session Index.Session)
  (update Notes.Index.Submit.update))
(route Notes.Index.Toggle POST "/toggles"
  (params Toggle.Params)
  (requires user)
  (session Index.Session)
  (update Notes.Index.Toggle.update)
  (needs-shown))
(route Notes.Index.Boom POST "/booms"
  (params Boom.Params)
  (requires user)
  (session Index.Session)
  (update Notes.Index.Boom.update)
  (needs-shown))
(route Notes.Index.Rename POST "/renames"
  (params Rename.Params)
  (form Title)
  (requires user)
  (session Index.Session)
  (update Notes.Index.Rename.update)
  (needs-shown))
(route Notes.Index.SavePrefs POST "/save-prefses"
  (params SavePrefs.Params)
  (form Prefs)
  (requires user)
  (session Index.Session)
  (update Notes.Index.SavePrefs.update)
  (needs-shown))
(route Notes.Show.Show GET "/notes/{id}"
  (params Show.Params)
  (requires user)
  (session Show.Session)
  (model Model)
  (load Notes.Show.Show.load)
  (view Notes.Show.Show.view))
(session App.Session)
(capability Auth.Login.Password
  (verify { email: Text, password: Text } -> Task (Maybe Text)))
(fake Auth.Login.Password
  (tables)
  (entries
    (entry Auth.Login.verify : { email: Text, password: Text } -> Task (Maybe Text) (args)
      (bind task found : Maybe User
        (db-select User.User
          (where (cond eq (col User.User email) (field email (var args))))
          first)
        (if (== : Text (field password (var args)) "secret")
          (pure task
            (call (std Maybe.map)
              (lambda (u : User) (field id (var u)))
              (var found)))
          (pure task (ctor Prelude.Maybe.Nothing)))))))
