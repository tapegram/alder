(module Todo)
(record Todo.Todo
  (id Text)
  (title Text)
  (done Bool = False)
  (due Maybe Date)
  (owner Text)
  (created Time))
(value Todo.pending : Select Todo ()
  (db-select Todo.Todo
    (where
      (cond and
        (cond eq (col Todo.Todo done) False)
        (cond not (cond isNothing (col Todo.Todo due)))))
    (order (ord (col Todo.Todo title) asc))
    select))
(value Todo.byOwners : List Text -> Select Todo (owners)
  (db-select Todo.Todo
    (where (cond in (col Todo.Todo owner) (var owners)))
    select))
(value Todo.getAll : List Text -> Query (List (Maybe Todo)) (ids)
  (all query
    (call (std List.map)
      (lambda (_m1 : Text) (db-get Todo.Todo (var _m1)))
      (var ids))))
(value Todo.anyOwner : List Text -> Condition Todo (owners)
  (cond or
    (value
      (call (std List.map)
        (lambda (_m1 : Text) (cond eq (col Todo.Todo owner) (var _m1)))
        (var owners)))))
(value Todo.recent : Select Todo -> Select Todo (q)
  (db-select Todo.Todo
    (base (var q))
    (where (cond isJust (col Todo.Todo due)))
    (order (ord (col Todo.Todo created) desc))
    (limit 3)
    select))
(value Todo.countOf : Select Todo -> Query Int (q)
  (db-run count (call (global Todo.recent) (var q))))
(value Todo.totals : Text -> Query (List Int) (u)
  (all query
    (list
      (cap Todo.Stats total)
      (cap Todo.Stats forOwner (var u) True)
      (map query (lambda (n : Int) (* (var n) 2)) (not-found)))))
(value Todo.counters : List (Text -> Query Int) ()
  (list (lambda (u : Text) (cap Todo.Stats forOwner (var u) False))))
(value Todo.byOwner : Text -> Bool -> Query Int ()
  (lambda (_m1 : Text, _m2 : Bool)
    (cap Todo.Stats forOwner (var _m1) (var _m2))))
(value Todo.eqs : List Text -> List (Condition Todo) (owners)
  (call (std List.map)
    (lambda (_m1 : Text) (cond eq (col Todo.Todo owner) (var _m1)))
    (var owners)))
(module App)
(record App.Session (user Maybe Text) (theme Text = "light"))
(union App.Msg)
(record App.Logout.Params)
(value App.Logout.update : Logout.Params -> Session -> Task Response (p session)
  (bind task _
    (call (std Session.put)
      (lambda (s : Session)
        (update (var s) (user (ctor Prelude.Maybe.Nothing)))))
    (pure task (std Response.refresh))))
(value App.error : Error -> Html Never (err) (elem p (htext "error")))
(value App.notFound : Html Never () (elem p (htext "not found")))
(module Index)
(record Index.Model
  (todos List Todo)
  (pair List (Maybe Todo))
  (now Time)
  (count Int)
  (first Maybe Todo))
(record Index.Index.Params (a Text) (b Text))
(record Index.Add.Params (a Text) (b Text) (title Text))
(record Index.Toggle.Params (a Text) (b Text) (id Text))
(record Index.Remove.Params (a Text) (b Text) (id Text))
(record Index.Notify.Params (a Text) (b Text))
(record Index.Index.Session (user Text) (theme Text))
(value Index.Index.load : Index.Params -> Index.Session -> Query Model (params session)
  (bind query todos : List Todo
    (db-select Todo.Todo
      (where (cond eq (col Todo.Todo owner) (field user (var session))))
      (order (ord (col Todo.Todo created) desc))
      (limit 10)
      all)
    (bind query pair : List (Maybe Todo)
      (all query
        (list
          (db-get Todo.Todo (field a (var params)))
          (db-get Todo.Todo (field b (var params)))))
      (bind query now : Time
        (std Time.now)
        (let q : Select Todo
          (db-select Todo.Todo
            (where
              (cond or
                (cond contains (col Todo.Todo title) "x")
                (cond eq (col Todo.Todo done) True)))
            (offset 5)
            select)
          (bind query count : Int
            (map query (lambda (n : Int) (+ (var n) 1)) (db-run count (var q)))
            (bind query first : Maybe Todo
              (db-run first (global Todo.pending))
              (pure query
                (record Model
                  (todos (var todos))
                  (pair (var pair))
                  (now (var now))
                  (count (var count))
                  (first (var first)))))))))))
(value Index.Add.update : Add.Params -> Index.Session -> Task Response (p session)
  (bind task id : Text
    (db-insert Todo.Todo
      (record
        (title (field title (var p)))
        (done False)
        (due (ctor Prelude.Maybe.Nothing))
        (owner (field user (var session)))))
    (bind task _
      (call (std Log.info) (str "added " (var id)))
      (pure task
        (call (std Response.redirect)
          (route-ref Index.Index
            (record Index.Params (a (var id)) (b (var id)))))))))
(value Index.Toggle.update : Toggle.Params -> Index.Session -> Task Response (p session)
  (bind task _
    (db-update Todo.Todo
      (field id (var p))
      (lambda (t : Todo)
        (update (var t) (done (call (std Prelude.not) (field done (var t)))))))
    (pure task (std Response.refresh))))
(value Index.Remove.update : Remove.Params -> Index.Session -> Task Response (p session)
  (bind task found : Maybe Todo
    (db-get Todo.Todo (field id (var p)))
    (match union (var found)
      (case Just (bind _m1 value : Todo)
        (let t : Todo
          (var _m1)
          (bind task _
            (db-delete Todo.Todo (field id (var t)))
            (pure task (std Response.refresh)))))
      (case Nothing (fail "no such todo")))))
(value Index.Notify.update : Notify.Params -> Index.Session -> Task Response (p session)
  (bind task token : Text
    (std Random.id)
    (bind task sent : List Bool
      (all task
        (list (cap Index.Mailer send (record (to "a@b.c") (body (var token))))))
      (bind task n : Int
        (map task (std List.length) (pure task (var sent)))
        (bind task _
          (call (std Session.put)
            (lambda (s : App.Session) (update (var s) (theme "dark"))))
          (pure task
            (if (> : Int (var n) 0)
              (std Response.refresh)
              (call (std Response.invalid) "not sent"))))))))
(value Index.Index.view : Model -> Index.Session -> Html Route (model session)
  (elem p (hexpr text (call (std Text.fromInt) (field count (var model))))))
(module Login)
(record Login.Model)
(record Login.Login.Params)
(value Login.Login.load : Login.Params -> App.Session -> Query Model (params session)
  (pure query (record Model)))
(value Login.Login.view : Model -> App.Session -> Html Route (model session)
  (elem p (htext "Log in")))
(table Todo.Todo (id id) (created created) (insert title done due owner))
(route App.Logout POST "/_/Logout"
  (params Logout.Params)
  (update App.Logout.update)
  (needs-shown))
(route Index.Index GET "/pair/{a}/{b}"
  (params Index.Params)
  (requires user)
  (session Index.Session)
  (model Model)
  (load Index.Index.load)
  (view Index.Index.view))
(route Index.Add POST "/pair/{a}/{b}/_/Add"
  (params Add.Params)
  (requires user)
  (session Index.Session)
  (update Index.Add.update))
(route Index.Toggle POST "/pair/{a}/{b}/_/Toggle"
  (params Toggle.Params)
  (requires user)
  (session Index.Session)
  (update Index.Toggle.update)
  (needs-shown))
(route Index.Remove POST "/pair/{a}/{b}/_/Remove"
  (params Remove.Params)
  (requires user)
  (session Index.Session)
  (update Index.Remove.update)
  (needs-shown))
(route Index.Notify POST "/pair/{a}/{b}/_/Notify"
  (params Notify.Params)
  (requires user)
  (session Index.Session)
  (update Index.Notify.update)
  (needs-shown))
(route Login.Login GET "/login"
  (params Login.Params)
  (model Model)
  (load Login.Login.load)
  (view Login.Login.view))
(app-update App.Logout.update)
(session App.Session)
(capability Todo.Stats (total Query Int) (forOwner Text -> Bool -> Query Int))
(capability Index.Mailer (send { to: Text, body: Text } -> Task Bool))
