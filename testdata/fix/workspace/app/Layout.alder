module Layout

Page : { title: Text, children: List (Html a) } -> Html a
Page props =
  <html>
    <head>
      <meta charset="utf-8" />
      <script>try{document.documentElement.classList.toggle("dark",localStorage.theme==="dark"||(!("theme" in localStorage)&&matchMedia("(prefers-color-scheme: dark)").matches))}catch(e){}</script>
      <title>{props.title}</title>
      <link rel="stylesheet" href={Url.external "/static/al/al.css"} />
      <script type="module" src="/static/al/al.js"></script>
      <link rel="stylesheet" href={Url.external "/static/app.css"} />
    </head>
    <body>
      <al-page>
        <header>
          <nav>
            <a href={Projects.Index {}}>Projects</a>
            <a href={Members.Index {}}>Members</a>
            <a href={Orgs.Index {}}>Orgs</a>
          </nav>
        </header>
        <main><al-stack gap="lg">{props.children}</al-stack></main>
      </al-page>
    </body>
  </html>
