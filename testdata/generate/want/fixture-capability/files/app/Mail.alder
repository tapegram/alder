module Mail

-- `send` is implemented in Go, by `adapters/mail/` (`func Mail`), which
-- `alder new capability` wrote to return an error until you write it (book chapter 7).
capability Mail {
  send : { to: Text.Email, subject: Text } -> Task Unit,
}

-- In a test, `let _ <- Test.fake Mail` replaces the adapter with this fake (book chapter 10).
fake Mail {
  send args = ?send
}

-- It proves the fake compiles and installs; tests of what the capability does use it.
test "the Mail fake installs" = {
  let _ <- Test.fake Mail
  Task.succeed True
}
