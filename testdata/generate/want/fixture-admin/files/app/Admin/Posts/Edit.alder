-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Posts.Edit

-- @admin begin imports
import Admin.Layout
import Table.Post
import Table.User
-- @admin end

-- @admin begin routes
route Edit         = GET  "/admin/post/{id}/edit"                { id: Post.PostId, findAuthor: Text = "" } requires user, role Admin
route Save         = PUT  "/admin/post/{id}/edit/_/Save"         { id: Post.PostId } form PostForm          requires user, role Admin
route SearchAuthor = POST "/admin/post/{id}/edit/_/SearchAuthor" { id: Post.PostId } form FindAuthor        requires user, role Admin
-- @admin end

type Model = {
  row: Post,
  -- @admin begin model
  authors: List User,
  authorsTotal: Int,
  -- @admin end
}

Edit.load : Edit.Params -> Session -> Query Model
Edit.load params session = {
  let _ <- Layout.adminOnly session.user
  -- @admin begin load
  let found <- Db.get Post params.id
  match found {
    Just row -> {
      let findAuthor = Text.slice 0 200 params.findAuthor
      let authorsTotal <- Db.from User |> Db.count
      let authorsOwn <-
        if authorsTotal > 200 then
          Db.from User
            |> Db.where (User.id.eq row.author)
            |> Db.all
        else
          Query.succeed []
      let authorsFound <-
        Db.from User
          |> Db.orderBy User.email.asc
          |> Db.where (
            if authorsTotal > 200 then
              Db.and [User.email.contains findAuthor, User.id.ne row.author]
            else
              Db.and []
          )
          |> Db.limit (if authorsTotal > 200 then 50 else 200)
          |> Db.all
      let authors = authorsOwn ++ authorsFound
      Query.succeed {
        row: row,
        authors: authors,
        authorsTotal: authorsTotal,
      }
    },
    Nothing -> Query.notFound,
  }
  -- @admin end
}

-- @admin begin form
form PostForm = {
  title: Text.NonEmpty,
  body: Text,
  status: Post.Status,
  featured: Bool,
  author: User.UserId,
}
-- @admin end

-- @admin begin search
form FindAuthor = { q: Text }

-- SearchAuthor answers the page again at the text.
SearchAuthor.update : SearchAuthor.Params -> Session -> Task Response
SearchAuthor.update params session =
  Task.succeed (
    Response.redirect (Edit { id: params.id, findAuthor: Text.slice 0 200 params.form.q })
  )

-- @admin end

-- Save writes the form over the row (a row deleted since is not found) and goes to its page.
Save.update : Save.Params -> Session -> Task Response
Save.update params session = {
  let _ <- Layout.adminOnly session.user
  let found <- Db.get Post params.id
  match found {
    Just row -> {
      -- @admin begin update
      let _ <- Db.update Post row.id (\r -> { r |
        title: params.form.title,
        body: params.form.body,
        status: params.form.status,
        featured: params.form.featured,
        author: params.form.author
      })
      Task.succeed (Response.redirect (Admin.Posts.Show.Show { id: row.id }))
      -- @admin end
    },
    Nothing -> Task.notFound,
  }
}

Edit.view : Model -> Session -> Html
Edit.view model session =
  <Layout.Page title="Edit post">
    <h1>Edit post</h1>

    <al-card>
      -- @admin begin finder
      {if model.authorsTotal > 200 then
        <form submit={SearchAuthor { id: model.row.id }}>
          <al-input field="q" label="Find author" />
          <al-button type="submit" variant="secondary">Find</al-button>
        </form>
      else
        Html.none}
      -- @admin end
      <form submit={Save { id: model.row.id }}>
        -- @admin begin inputs
        <al-input field="title" label="Title" value={model.row.title} />
        <al-textarea field="body" label="Body" value={model.row.body} />
        <al-select field="status" label="Status" value={model.row.status} />
        <al-checkbox field="featured" label="Featured" value={model.row.featured} />
        <al-select
          field="author"
          label="Author"
          options={List.map (\r -> { value: r.id, label: r.email }) model.authors}
          value={model.row.author} />
        -- @admin end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Save</al-button>
      </form>
    </al-card>
    <a href={Admin.Posts.Show.Show { id: model.row.id }}>Back</a>
  </Layout.Page>

-- @admin begin tests
test "saving changes every field" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let page <- Test.get (Edit { id: post1 })
  let r <- Test.submit (Save { id: post1 }) {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    status: Published,
    featured: True,
    author: user2,
  }
  let after <- Db.get Post post1
  Task.succeed (
    {
      answer: r.answer,
      row: Maybe.map (\row -> {
        title: row.title,
        body: row.body,
        status: row.status,
        featured: row.featured,
        author: row.author,
      }) after,
      authors: Test.texts "select[name=author] option" page.doc,
    } == {
      answer: Redirected (Admin.Posts.Show.Show { id: post1 }),
      row: Just {
        title: Text.NonEmpty "title-2",
        body: "body-2",
        status: Published,
        featured: True,
        author: user2,
      },
      authors: ["email-1@example.com", "email-2@example.com"],
    }
  )
}

test "an author not offered is refused" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let page <- Test.get (Edit { id: post1 })
  let r <- Test.submitRaw (Save { id: post1 }) [
    { name: "title", value: "x" },
    { name: "body", value: "x" },
    { name: "status", value: "Draft" },
    { name: "featured", value: "True" },
    { name: "author", value: "missing" },
  ]
  let after <- Db.get Post post1
  Task.succeed (
    { answer: r.answer, author: Maybe.map (\row -> row.author) after }
      == {
        answer: FormRejected [{ field: "author", message: "must be one of the options" }],
        author: Just me,
      }
  )
}

test "a list of 200 users is offered whole" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert User {
        email: Text.Email ("email-" ++ Text.fromInt n ++ "@example.com"),
        name: Text.NonEmpty ("name-" ++ Text.fromInt n),
      }) (List.range 3 200)
    )
  let page <- Test.get (Edit { id: post1 })
  Task.succeed (List.length page.model.authors == 200)
}

test "a long list of users offers 50, and the search narrows it" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert User {
        email: Text.Email ("email-" ++ Text.fromInt n ++ "@example.com"),
        name: Text.NonEmpty ("name-" ++ Text.fromInt n),
      }) (List.range 3 203)
    )
  let all <- Test.get (Edit { id: post1 })
  let found <- Test.get (Edit { id: post1, findAuthor: "email-203@example.com" })
  let r <- Test.submit (SearchAuthor { id: post1 }) { q: "zz" }
  let _ <- Test.login { user: Nothing }
  let visitor <- Test.submit (SearchAuthor { id: post1 }) { q: "zz" }
  let _ <- Test.login { user: Just me, role: Admin }
  let _ <- Test.get (Edit { id: post1 })
  let _ <- Test.login { user: Just me, role: Reader }
  let reader <- Test.submitRaw (SearchAuthor { id: post1 }) []
  Task.succeed (
    {
      shown: List.length all.model.authors,
      total: all.model.authorsTotal,
      found: Test.count "select[name=author] option" found.doc <= 3,
      answer: r.answer,
      visitor: visitor.answer,
      reader: reader.answer,
    } == {
      shown: 51,
      total: 203,
      found: True,
      answer: Redirected (Edit { id: post1, findAuthor: "zz" }),
      visitor: Redirected (Auth.Login {}),
      reader: PageMissing,
    }
  )
}

test "the row's own author is offered first when it sorts past the 50" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let user2 <- Db.insert User { email: Text.Email "zz-1@example.com", name: Text.NonEmpty "name-2" }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: user2,
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert User {
        email: Text.Email ("email-" ++ Text.fromInt n ++ "@example.com"),
        name: Text.NonEmpty ("name-" ++ Text.fromInt n),
      }) (List.range 3 203)
    )
  let page <- Test.get (Edit { id: post1 })
  let r <- Test.submit (Save { id: post1 }) {
    title: page.model.row.title,
    body: page.model.row.body,
    status: page.model.row.status,
    featured: page.model.row.featured,
    author: page.model.row.author,
  }
  let after <- Db.get Post post1
  Task.succeed (
    {
      answer: r.answer,
      kept: Maybe.map (\row -> row.author) after,
      first: Maybe.map (\o -> o.id) (List.head page.model.authors),
      once: List.length (List.filter (\o -> o.id == user2) page.model.authors),
      shown: List.length page.model.authors,
    } == {
      answer: Redirected (Admin.Posts.Show.Show { id: post1 }),
      kept: Just user2,
      first: Just user2,
      once: 1,
      shown: 51,
    }
  )
}

test "a visitor cannot save a post" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let before <- Db.get Post post1
  let _ <- Test.get (Edit { id: post1 })
  let _ <- Test.login { user: Nothing }
  let r <- Test.submit (Save { id: post1 }) {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    status: Published,
    featured: True,
    author: user2,
  }
  let after <- Db.get Post post1
  Task.succeed (
    { answer: r.answer, row: after } == { answer: Redirected (Auth.Login {}), row: before }
  )
}

test "a Reader cannot save a post, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let before <- Db.get Post post1
  let _ <- Test.get (Edit { id: post1 })
  let _ <- Test.login { user: Just me, role: Reader }
  let r <- Test.submit (Save { id: post1 }) {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    status: Published,
    featured: True,
    author: user2,
  }
  let after <- Db.get Post post1
  Task.succeed ({ answer: r.answer, row: after } == { answer: PageMissing, row: before })
}

test "a demoted Admin cannot save a post" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let before <- Db.get Post post1
  let _ <- Test.get (Edit { id: post1 })
  let _ <- Db.update User me (\u -> { u | role: Reader })
  let r <- Test.submit (Save { id: post1 }) {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    status: Published,
    featured: True,
    author: user2,
  }
  let after <- Db.get Post post1
  Task.succeed (
    { answer: r.answer, row: after } == { answer: RequestFailed "400 bad request", row: before }
  )
}

test "a missing row is not found" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let r <- Test.open (Edit { id: Post.PostId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "a visitor is sent to log in" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let r <- Test.open (Edit { id: post1 })
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Reader gets no page, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Reader }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let r <- Test.open (Edit { id: post1 })
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Reader,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let r <- Test.open (Edit { id: post1 })
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
