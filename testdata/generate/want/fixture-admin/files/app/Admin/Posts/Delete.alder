-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Posts.Delete

-- @admin begin imports
import Admin.Layout
import Table.Comment
import Table.Post
import Table.Tag
import Table.User
-- @admin end

page "/admin/post/{id}/delete" { id: Post.PostId } requires user, role Admin

-- The row, and how many rows of each table refer to it.
type Model = {
  row: Post,
  -- @admin begin model
  comments: Int,
  tags: Int,
  -- @admin end
}

load : Params -> Session -> Query Model
load params session = {
  let admin <- Layout.isAdmin session.user
  if admin then {
    -- @admin begin load
    let found <- Db.get Post params.id
    let comments <-
      Db.from Comment
        |> Db.where (Comment.post.eq params.id)
        |> Db.count
    let tags <-
      Db.from Tag
        |> Db.where (Tag.post.eq params.id)
        |> Db.count
    match found {
      Just row -> Query.succeed {
        row: row,
        comments: comments,
        tags: tags,
      },
      Nothing -> Query.notFound,
    }
    -- @admin end
  } else
    Query.notFound
}

-- @admin begin blockers
-- blockers counts the rows that keep this one from being deleted, which the database would
-- refuse the delete for: the `@restrict` references to it, or to a row deleted with it.
blockers : Model -> Int
blockers model = model.tags
-- @admin end

-- Delete takes no input: the form is the button, and the place a refusal is shown.
form Confirm = { }

msg Remove form Confirm

-- Remove deletes the row, unless rows refer to it that keep it (load counted them, as it does
-- before every message): the database would refuse the delete with an error, and the page says
-- why instead.
update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  Remove p -> {
    -- @admin begin remove
    if blockers model > 0 then
      Task.succeed (Reject "This post cannot be deleted while other rows refer to it.")
    else {
      let _ <- Db.delete Post model.row.id
      Task.succeed (Redirect (Admin.Posts.Index {}))
    }
    -- @admin end
  },
}

view : Model -> Session -> Html Msg
view model session =
  <Layout.Page title="Delete post">
    <h1>Delete this post?</h1>

    <al-card>
      -- @admin begin row
      <p>{model.row.title}</p>
      -- @admin end
      <dl>
        -- @admin begin counts
        <dt>Comments deleted with it</dt>
        <dd id="comments">{Text.fromInt model.comments}</dd>
        <dt>Tags that keep it from being deleted</dt>
        <dd id="tags">{Text.fromInt model.tags}</dd>
        -- @admin end
      </dl>
      <form id="delete" submit={Remove}>
        <al-alert variant="destructive"><Errors form /></al-alert>
        {if blockers model > 0 then
          <p>It cannot be deleted while other rows refer to it.</p>
        else
          <al-button variant="destructive" type="submit">Delete</al-button>}
      </form>
    </al-card>
    <a href={Admin.Posts.Show { id: model.row.id }}>Back</a>
  </Layout.Page>

-- @admin begin tests
test "deleting a post nothing refers to" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let _ <- Db.insert Comment {
    post: post2,
    author: me,
    body: Text.NonEmpty "body-1",
  }
  let _ <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post2 }
  let _ <- Test.get (Admin.Posts.Delete { id: post1 })
  let r <- Test.submit Confirm {}
  let gone <- Db.get Post post1
  let kept <- Db.get Post post2
  Task.succeed (
    {
      answer: r.answer,
      gone: Maybe.map (\row -> row.id) gone,
      kept: Maybe.map (\row -> row.id) kept,
    } == {
      answer: Redirected (Admin.Posts.Index {}),
      gone: Nothing,
      kept: Just post2,
    }
  )
}

test "the page counts the rows that go with it" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let _ <- Db.insert Comment {
    post: post1,
    author: me,
    body: Text.NonEmpty "body-1",
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let _ <- Db.insert Comment {
    post: post2,
    author: me,
    body: Text.NonEmpty "body-2",
  }
  let page <- Test.get (Admin.Posts.Delete { id: post1 })
  Task.succeed ({ comments: Test.text "#comments" page.doc } == { comments: Just "1" })
}

test "a post that tags refer to is not deleted" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let _ <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let page <- Test.get (Admin.Posts.Delete { id: post1 })
  let r <- Test.submit Confirm {}
  let kept <- Db.get Post post1
  Task.succeed (
    {
      count: Test.text "#tags" page.doc,
      buttons: Test.count "#delete button" page.doc,
      answer: r.answer,
      kept: Maybe.map (\row -> row.id) kept,
    } == {
      count: Just "1",
      buttons: 0,
      answer: FormRejected [
        { field: "", message: "This post cannot be deleted while other rows refer to it." },
      ],
      kept: Just post1,
    }
  )
}

test "a missing row is not found" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let r <- Test.open (Admin.Posts.Delete { id: Post.PostId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "a visitor is sent to log in" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let r <- Test.open (Admin.Posts.Delete { id: post1 })
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Reader gets no page, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Reader }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let r <- Test.open (Admin.Posts.Delete { id: post1 })
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Reader,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let r <- Test.open (Admin.Posts.Delete { id: post1 })
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
