-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Posts.Bulk

-- @admin begin imports
import Admin.Layout
import Table.Post
import Table.Tag
import Table.User
-- @admin end

-- @admin begin routes
route Bulk            = GET  "/admin/post/bulk"                   { ids: List Post.PostId }                  requires user, role Admin
route BulkDelete      = POST "/admin/post/bulk/_/BulkDelete"      { ids: List Post.PostId } form Confirm     requires user, role Admin
route BulkSetStatus   = POST "/admin/post/bulk/_/BulkSetStatus"   { ids: List Post.PostId } form SetStatus   requires user, role Admin
route BulkSetFeatured = POST "/admin/post/bulk/_/BulkSetFeatured" { ids: List Post.PostId } form SetFeatured requires user, role Admin
-- @admin end

-- The rows chosen on the list (at most maxRows of them), the ids of those that other rows keep
-- from being deleted, how many ids the page was given, and the ids, which each action takes.
type Model = {
  rows: List Post,
  held: List Post.PostId,
  chosen: Int,
  ids: List Post.PostId,
}

-- maxRows is how many rows one action takes: a page of the list. More are refused.
maxRows : Int
maxRows = 25

-- tooMany says whether the page was given more ids than an action takes.
tooMany : Model -> Bool
tooMany model = model.chosen > maxRows

-- selected is the rows of ids: the page shows them, and each action reads them again.
selected : List Post.PostId -> Query Model
selected ids = {
  -- @admin begin load
  let taken = List.take maxRows ids
  let rows <-
    Db.from Post
      |> Db.where (Post.id.in taken)
      |> Db.all
  let held1 <-
    Db.from Tag
      |> Db.where (Tag.post.in taken)
      |> Db.all
  Query.succeed {
    rows: rows,
    held: List.concat [List.map (\r -> r.post) held1],
    chosen: List.length ids,
    ids: ids,
  }
  -- @admin end
}

Bulk.load : Bulk.Params -> Session -> Query Model
Bulk.load params session = {
  let _ <- Layout.adminOnly session.user
  selected params.ids
}

-- refused says whether a row is kept from being deleted: rows refer to it with a `@restrict`.
refused : Model -> Post -> Bool
refused model row = List.member row.id model.held

-- @admin begin bulk
-- Each action reads the rows again and answers with the page again and a toast; none takes
-- more than maxRows rows.

-- BulkDelete takes no input: the form is the button, and the place a refusal is shown.
form Confirm = { }

BulkDelete.update : BulkDelete.Params -> Session -> Task Response
BulkDelete.update params session = {
  let _ <- Layout.adminOnly session.user
  let model <- selected params.ids
  if tooMany model then
    Task.succeed (
      Response.invalid ("Choose at most " ++ Text.fromInt maxRows ++ " rows at a time.")
    )
  else {
    let allowed = List.filter (\row -> refused model row == False) model.rows
    let _ <- Task.all (List.map (\row -> Db.delete Post row.id) allowed)
    Task.succeed (
      Response.refresh
        |> Response.success (
          "Deleted "
            ++ Text.fromInt (List.length allowed)
            ++ " of "
            ++ Text.fromInt (List.length model.rows)
        )
    )
  }
}

form SetStatus = { value: Post.Status }

BulkSetStatus.update : BulkSetStatus.Params -> Session -> Task Response
BulkSetStatus.update params session = {
  let _ <- Layout.adminOnly session.user
  let model <- selected params.ids
  if tooMany model then
    Task.succeed (
      Response.invalid ("Choose at most " ++ Text.fromInt maxRows ++ " rows at a time.")
    )
  else {
    let _ <-
      Task.all (
        List.map (\row -> Db.update Post row.id (\r -> { r |
          status: params.form.value
        })) model.rows
      )
    Task.succeed (
      Response.refresh |> Response.success ("Updated " ++ Text.fromInt (List.length model.rows))
    )
  }
}

form SetFeatured = { value: Bool }

BulkSetFeatured.update : BulkSetFeatured.Params -> Session -> Task Response
BulkSetFeatured.update params session = {
  let _ <- Layout.adminOnly session.user
  let model <- selected params.ids
  if tooMany model then
    Task.succeed (
      Response.invalid ("Choose at most " ++ Text.fromInt maxRows ++ " rows at a time.")
    )
  else {
    let _ <-
      Task.all (
        List.map (\row -> Db.update Post row.id (\r -> { r |
          featured: params.form.value
        })) model.rows
      )
    Task.succeed (
      Response.refresh |> Response.success ("Updated " ++ Text.fromInt (List.length model.rows))
    )
  }
}
-- @admin end

Bulk.view : Model -> Session -> Html
Bulk.view model session =
  <Layout.Page title="Selected posts">
    <h1>{Text.fromInt (List.length model.rows)} selected</h1>

    <al-card>
      {if tooMany model then
        <al-alert id="too-many" variant="warning">
          {"Choose at most " ++ Text.fromInt maxRows ++ " rows at a time."}
        </al-alert>
      else
        Html.none}
      <ul id="selected">
        {for row in model.rows ->
          <li>
            {row.title}
            {if refused model row then
              <small> (kept: other rows refer to it)</small>
            else
              <span></span>}
          </li>}
      </ul>
      -- @admin begin actions
      <form id="bulk-delete" submit={BulkDelete { ids: model.ids }}>
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button variant="destructive" type="submit">
          Delete the rows that can be deleted
        </al-button>
      </form>
      <form id="set-status" submit={BulkSetStatus { ids: model.ids }}>
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-select field="value" label="Status" />
        <al-button type="submit">Set status</al-button>
      </form>
      <form id="set-featured" submit={BulkSetFeatured { ids: model.ids }}>
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-checkbox field="value" label="Featured" />
        <al-button type="submit">Set featured</al-button>
      </form>
      -- @admin end
    </al-card>
    <a href={Admin.Posts.Index.Index {}}>Back to the list</a>
  </Layout.Page>

-- @admin begin tests
test "deleting the chosen rows leaves the ones other rows refer to" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let _ <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let post3 <- Db.insert Post {
    title: Text.NonEmpty "title-3",
    body: "body-3",
    author: me,
  }
  let _ <- Test.get (Bulk { ids: [post1, post2] })
  let r <- Test.submit (BulkDelete { ids: [post1, post2] }) {}
  let gone <- Db.get Post post2
  let left <- Db.get Post post3
  let kept <- Db.get Post post1
  Task.succeed (
    {
      answer: r.answer,
      gone: Maybe.map (\row -> row.id) gone,
      left: Maybe.map (\row -> row.id) left,
      kept: Maybe.map (\row -> row.id) kept,
      listed: Test.count "#selected li small" r.doc,
    } == {
      answer: Refreshed,
      gone: Nothing,
      left: Just post3,
      kept: Just post1,
      listed: 1,
    }
  )
}

test "setting status changes the chosen rows only" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let _ <- Test.get (Bulk { ids: [post1] })
  let r <- Test.submit (BulkSetStatus { ids: [post1] }) { value: Published }
  let one <- Db.get Post post1
  let other <- Db.get Post post2
  Task.succeed (
    {
      answer: r.answer,
      one: Maybe.map (\row -> row.status == Published) one,
      other: Maybe.map (\row -> row.status == Published) other,
    } == {
      answer: Refreshed,
      one: Just True,
      other: Just False,
    }
  )
}

test "setting featured changes the chosen rows only" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let _ <- Test.get (Bulk { ids: [post1] })
  let r <- Test.submit (BulkSetFeatured { ids: [post1] }) { value: True }
  let one <- Db.get Post post1
  let other <- Db.get Post post2
  Task.succeed (
    {
      answer: r.answer,
      one: Maybe.map (\row -> row.featured == True) one,
      other: Maybe.map (\row -> row.featured == True) other,
    } == {
      answer: Refreshed,
      one: Just True,
      other: Just False,
    }
  )
}

test "25 chosen ids are taken" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let chosen = [post1] ++ List.map (\n -> Post.PostId ("none-" ++ Text.fromInt n)) (List.range 1 24)
  let page <- Test.get (Bulk { ids: chosen })
  let r <- Test.submit (BulkDelete { ids: chosen }) {}
  let after <- Db.get Post post1
  Task.succeed (
    {
      answer: r.answer,
      kept: Maybe.map (\row -> row.id) after,
      warned: Test.count "#too-many" page.doc,
    } == {
      answer: Refreshed,
      kept: Nothing,
      warned: 0,
    }
  )
}

test "26 chosen ids are refused" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let chosen = [post1] ++ List.map (\n -> Post.PostId ("none-" ++ Text.fromInt n)) (List.range 1 25)
  let page <- Test.get (Bulk { ids: chosen })
  let r <- Test.submit (BulkDelete { ids: chosen }) {}
  let after <- Db.get Post post1
  Task.succeed (
    {
      answer: r.answer,
      kept: Maybe.map (\row -> row.id) after,
      warned: Test.count "#too-many" page.doc,
    } == {
      answer: FormRejected [{ field: "", message: "Choose at most 25 rows at a time." }],
      kept: Just post1,
      warned: 1,
    }
  )
}

test "a demoted Admin cannot delete the chosen rows" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let _ <- Test.get (Bulk { ids: [post1] })
  let _ <- Db.update User me (\u -> { u | role: Reader })
  let r <- Test.submit (BulkDelete { ids: [post1] }) {}
  let kept <- Db.get Post post1
  Task.succeed (
    { answer: r.answer, kept: Maybe.map (\row -> row.id) kept }
      == { answer: PageMissing, kept: Just post1 }
  )
}

test "a demoted Admin cannot set status on the chosen rows" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let before <- Db.get Post post1
  let _ <- Test.get (Bulk { ids: [post1] })
  let _ <- Db.update User me (\u -> { u | role: Reader })
  let r <- Test.submit (BulkSetStatus { ids: [post1] }) { value: Published }
  let after <- Db.get Post post1
  Task.succeed ({ answer: r.answer, row: after } == { answer: PageMissing, row: before })
}

test "a demoted Admin cannot set featured on the chosen rows" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let before <- Db.get Post post1
  let _ <- Test.get (Bulk { ids: [post1] })
  let _ <- Db.update User me (\u -> { u | role: Reader })
  let r <- Test.submit (BulkSetFeatured { ids: [post1] }) { value: True }
  let after <- Db.get Post post1
  Task.succeed ({ answer: r.answer, row: after } == { answer: PageMissing, row: before })
}

test "a visitor is sent to log in" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let r <- Test.open (Bulk { ids: [post1] })
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Reader gets no page, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Reader }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let r <- Test.open (Bulk { ids: [post1] })
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Reader,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let r <- Test.open (Bulk { ids: [post1] })
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
