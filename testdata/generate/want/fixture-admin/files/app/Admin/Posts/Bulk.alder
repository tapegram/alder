-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Posts.Bulk

-- @admin begin imports
import Admin.Layout
import Table.Post
import Table.Tag
import Table.User
-- @admin end

page "/admin/post/bulk" { ids: List Post.PostId } requires user, role Admin

-- The rows chosen on the list (at most maxRows of them), the ids of those that other rows keep
-- from being deleted, and how many ids the page was given.
type Model = {
  rows: List Post,
  held: List Post.PostId,
  chosen: Int,
}

-- maxRows is how many rows one action takes: a page of the list. More are refused.
maxRows : Int
maxRows = 25

load : Params -> Session -> Query Model
load params session = {
  let admin <- Layout.isAdmin session.user
  if admin then {
    -- @admin begin load
    let ids = List.take maxRows params.ids
    let rows <-
      Db.from Post
        |> Db.where (Post.id.in ids)
        |> Db.all
    let held1 <-
      Db.from Tag
        |> Db.where (Tag.post.in ids)
        |> Db.all
    Query.succeed {
      rows: rows,
      held: List.concat [List.map (\r -> r.post) held1],
      chosen: List.length params.ids,
    }
    -- @admin end
  } else
    Query.notFound
}

-- refused says whether a row is kept from being deleted: rows refer to it with a `@restrict`.
refused : Model -> Session -> Post -> Bool
refused model session row = List.member row.id model.held

-- @admin begin bulk
form Confirm = { }

msg BulkDelete form Confirm

form SetStatus = { value: Post.Status }

msg BulkSetStatus form SetStatus

form SetFeatured = { value: Bool }

msg BulkSetFeatured form SetFeatured

-- Each action reads the rows again (load runs before every message) and answers with a notice;
-- none takes more than maxRows rows.
update : Msg -> Model -> Session -> Task Nav
update msg model session =
  if model.chosen > maxRows then
    Task.succeed (Reject ("Choose at most " ++ Text.fromInt maxRows ++ " rows at a time."))
  else
    match msg {
      BulkDelete p -> {
        let allowed = List.filter (\row -> refused model session row == False) model.rows
        let _ <- Task.all (List.map (\row -> Db.delete Post row.id) allowed)
        Task.succeed (
          Notice.with ("Deleted " ++ Text.fromInt (List.length allowed) ++ " of " ++ Text.fromInt (List.length model.rows)) (
            Redirect (Admin.Posts.Index {})
          )
        )
      },
      BulkSetStatus p -> {
        let _ <-
          Task.all (
            List.map (\row -> Db.update Post row.id (\r -> { r | status: p.form.value })) model.rows
          )
        Task.succeed (
          Notice.with ("Updated " ++ Text.fromInt (List.length model.rows)) (
            Redirect (Admin.Posts.Index {})
          )
        )
      },
      BulkSetFeatured p -> {
        let _ <-
          Task.all (
            List.map (\row -> Db.update Post row.id (\r -> { r |
              featured: p.form.value
            })) model.rows
          )
        Task.succeed (
          Notice.with ("Updated " ++ Text.fromInt (List.length model.rows)) (
            Redirect (Admin.Posts.Index {})
          )
        )
      },
    }
-- @admin end

view : Model -> Session -> Html Msg
view model session =
  <Layout.Page title="Selected posts">
    <h1>{Text.fromInt (List.length model.rows)} selected</h1>

    <al-card>
      {if model.chosen > maxRows then
        <al-alert id="too-many" variant="warning">
          {"Choose at most " ++ Text.fromInt maxRows ++ " rows at a time."}
        </al-alert>
      else
        <span></span>}
      <ul id="selected">
        {for row in model.rows ->
          <li>
            {row.title}
            {if refused model session row then
              <small> (kept: other rows refer to it)</small>
            else
              <span></span>}
          </li>}
      </ul>
      -- @admin begin actions
      <form id="bulk-delete" submit={BulkDelete}>
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button variant="destructive" type="submit">
          Delete the rows that can be deleted
        </al-button>
      </form>
      <form id="set-status" submit={BulkSetStatus}>
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-select field="value" label="Status" />
        <al-button type="submit">Set status</al-button>
      </form>
      <form id="set-featured" submit={BulkSetFeatured}>
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-checkbox field="value" label="Featured" />
        <al-button type="submit">Set featured</al-button>
      </form>
      -- @admin end
    </al-card>
    <a href={Admin.Posts.Index {}}>Back to the list</a>
  </Layout.Page>

-- @admin begin tests
test "deleting the chosen rows leaves the ones other rows refer to" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let _ <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let post3 <- Db.insert Post {
    title: Text.NonEmpty "title-3",
    body: "body-3",
    author: me,
  }
  let _ <- Test.get (Admin.Posts.Bulk { ids: [post1, post2] })
  let r <- Test.submit Confirm {}
  let gone <- Db.get Post post2
  let left <- Db.get Post post3
  let kept <- Db.get Post post1
  let page <- Test.get (Admin.Posts.Bulk { ids: [post1, post2] })
  Task.succeed (
    {
      answer: r.answer,
      gone: Maybe.map (\row -> row.id) gone,
      left: Maybe.map (\row -> row.id) left,
      kept: Maybe.map (\row -> row.id) kept,
      listed: Test.count "#selected li small" page.doc,
    } == {
        answer: Redirected (Admin.Posts.Index {}),
        gone: Nothing,
        left: Just post3,
        kept: Just post1,
        listed: 1,
      }
  )
}

test "setting status changes the chosen rows only" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let _ <- Test.get (Admin.Posts.Bulk { ids: [post1] })
  let r <- Test.submit SetStatus { value: Published }
  let one <- Db.get Post post1
  let other <- Db.get Post post2
  Task.succeed (
    {
      answer: r.answer,
      one: Maybe.map (\row -> row.status == Published) one,
      other: Maybe.map (\row -> row.status == Published) other,
    } == {
        answer: Redirected (Admin.Posts.Index {}),
        one: Just True,
        other: Just False,
      }
  )
}

test "setting featured changes the chosen rows only" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let _ <- Test.get (Admin.Posts.Bulk { ids: [post1] })
  let r <- Test.submit SetFeatured { value: True }
  let one <- Db.get Post post1
  let other <- Db.get Post post2
  Task.succeed (
    {
      answer: r.answer,
      one: Maybe.map (\row -> row.featured == True) one,
      other: Maybe.map (\row -> row.featured == True) other,
    } == {
        answer: Redirected (Admin.Posts.Index {}),
        one: Just True,
        other: Just False,
      }
  )
}

test "25 chosen ids are taken" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let page <-
    Test.get (Admin.Posts.Bulk {
      ids: [post1] ++ List.map (\n -> Post.PostId ("none-" ++ Text.fromInt n)) (List.range 1 24),
    })
  let r <- Test.submit Confirm {}
  let after <- Db.get Post post1
  Task.succeed (
    {
      answer: r.answer,
      kept: Maybe.map (\row -> row.id) after,
      warned: Test.count "#too-many" page.doc,
    } == {
        answer: Redirected (Admin.Posts.Index {}),
        kept: Nothing,
        warned: 0,
      }
  )
}

test "26 chosen ids are refused" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let page <-
    Test.get (Admin.Posts.Bulk {
      ids: [post1] ++ List.map (\n -> Post.PostId ("none-" ++ Text.fromInt n)) (List.range 1 25),
    })
  let r <- Test.submit Confirm {}
  let after <- Db.get Post post1
  Task.succeed (
    {
      answer: r.answer,
      kept: Maybe.map (\row -> row.id) after,
      warned: Test.count "#too-many" page.doc,
    } == {
        answer: FormRejected [{ field: "", message: "Choose at most 25 rows at a time." }],
        kept: Just post1,
        warned: 1,
      }
  )
}

test "a visitor is sent to log in" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let r <- Test.open (Admin.Posts.Bulk { ids: [post1] })
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Reader gets no page, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Reader }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let r <- Test.open (Admin.Posts.Bulk { ids: [post1] })
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Reader,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let r <- Test.open (Admin.Posts.Bulk { ids: [post1] })
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
