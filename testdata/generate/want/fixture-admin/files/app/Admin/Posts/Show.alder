-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Posts.Show

-- @admin begin imports
import Admin.Layout
import Table.Comment
import Table.Post
import Table.Tag
import Table.User
-- @admin end

page "/admin/post/{id}" { id: Post.PostId } requires user, role Admin

-- The row, the labels of the rows it refers to, and (for the delete dialog) how many rows of
-- each table refer to it.
type Model = {
  row: Post,
  labels: Labels,
  -- @admin begin model
  comments: Int,
  tags: Int,
  -- @admin end
}

load : Params -> Session -> Query Model
load params session = {
  let admin <- Layout.isAdmin session.user
  if admin then {
    -- @admin begin load
    let found <- Db.get Post params.id
    let comments <-
      Db.from Comment
        |> Db.where (Comment.post.eq params.id)
        |> Db.count
    let tags <-
      Db.from Tag
        |> Db.where (Tag.post.eq params.id)
        |> Db.count
    match found {
      Just row -> {
        let labels <- labelsOf [row]
        Query.succeed {
          row: row,
          labels: labels,
          comments: comments,
          tags: tags,
        }
      },
      Nothing -> Query.notFound,
    }
    -- @admin end
  } else
    Query.notFound
}

-- @admin begin labels
-- Labels are the rows the references of the rows shown name: their links show their labels.
type Labels = { authors: List User }

-- labelsOf reads the rows that rows refer to.
labelsOf : List Post -> Query Labels
labelsOf rows = {
  let authors <-
    Db.from User
      |> Db.where (User.id.in (List.map (\row -> row.author) rows))
      |> Db.all
  Query.succeed { authors: authors }
}

-- authorLabel is the label of the user id names (the id itself if it names none).
authorLabel : Labels -> User.UserId -> Text
authorLabel labels id = match List.find (\r -> r.id == id) labels.authors {
  Just r -> r.email,
  Nothing -> id,
}
-- @admin end

-- @admin begin blockers
-- blockers counts the rows that keep this one from being deleted, which the database would
-- refuse the delete for: the `@restrict` references to it, or to a row deleted with it.
blockers : Model -> Int
blockers model = model.tags
-- @admin end

-- The delete dialog's form: no input, the button and the place a refusal is shown.
form Confirm = { }

msg Remove form Confirm

-- Remove deletes the row, unless rows refer to it that keep it (load counted them, as it does
-- before every message), as the Delete page does.
update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  Remove p -> {
    -- @admin begin remove
    if blockers model > 0 then
      Task.succeed (Reject "This post cannot be deleted while other rows refer to it.")
    else {
      let _ <- Db.delete Post model.row.id
      Task.succeed (Redirect (Admin.Posts.Index {}))
    }
    -- @admin end
  },
}

view : Model -> Session -> Html Msg
view model session =
  <Layout.Page title="Post">
    <h1>Post</h1>

    <al-card>
      <dl id="fields">
        -- @admin begin fields
        <dt>Id</dt>
        <dd>{model.row.id}</dd>
        <dt>Title</dt>
        <dd>{model.row.title}</dd>
        <dt>Body</dt>
        <dd>{model.row.body}</dd>
        <dt>Status</dt>
        <dd>
          <al-badge>
            {match model.row.status {
              Draft -> "Draft",
              Published -> "Published",
            }}
          </al-badge>
        </dd>
        <dt>Featured</dt>
        <dd>
          {if model.row.featured then
            <al-badge>Yes</al-badge>
          else
            <al-badge variant="secondary">No</al-badge>}
        </dd>
        <dt>Author</dt>
        <dd>
          <a href={Admin.Users.Show { id: model.row.author }}>
            {authorLabel model.labels model.row.author}
          </a>
        </dd>
        <dt>Created</dt>
        <dd>{Time.format "Jan 2, 2006" model.row.created}</dd>
        <dt>Updated</dt>
        <dd>{Time.format "Jan 2, 2006" model.row.updated}</dd>
        -- @admin end
      </dl>
      <div slot="actions">
        <al-button href={Admin.Posts.Edit { id: model.row.id }}>Edit</al-button>
        <al-button variant="destructive">
          <button type="button" commandfor="delete-dialog" command="show-modal">Delete</button>
        </al-button>
      </div>
    </al-card>
    <al-dialog id="delete-dialog" heading="Delete this post?" dismissible>
      <dl>
        -- @admin begin counts
        <dt>Comments deleted with it</dt>
        <dd id="comments">{Text.fromInt model.comments}</dd>
        <dt>Tags that keep it from being deleted</dt>
        <dd id="tags">{Text.fromInt model.tags}</dd>
        -- @admin end
      </dl>
      <form id="delete" submit={Remove}>
        <al-alert variant="destructive"><Errors form /></al-alert>
        {if blockers model > 0 then
          <p>It cannot be deleted while other rows refer to it.</p>
        else
          <al-button variant="destructive" type="submit">Delete</al-button>}
      </form>
      <div slot="actions">
        <a href={Admin.Posts.Delete { id: model.row.id }}>See the details</a>
      </div>
    </al-dialog>
    <a href={Admin.Posts.Index {}}>All posts</a>
  </Layout.Page>

-- @admin begin tests
test "the page shows the row" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let r <- Test.open (Admin.Posts.Show { id: post1 })
  let page <- Test.get (Admin.Posts.Show { id: post1 })
  Task.succeed (
    {
      answer: r.answer,
      title: List.member "title-1" (Test.texts "#fields dd" r.doc),
      authors: List.length page.model.labels.authors,
      authorLabel: authorLabel page.model.labels me,
    } == {
      answer: Shown,
      title: True,
      authors: 1,
      authorLabel: "email-1@example.com",
    }
  )
}

test "deleting a post nothing refers to" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let _ <- Db.insert Comment {
    post: post2,
    author: me,
    body: Text.NonEmpty "body-1",
  }
  let _ <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post2 }
  let _ <- Test.get (Admin.Posts.Show { id: post1 })
  let r <- Test.submit Confirm {}
  let gone <- Db.get Post post1
  let kept <- Db.get Post post2
  Task.succeed (
    {
      answer: r.answer,
      gone: Maybe.map (\row -> row.id) gone,
      kept: Maybe.map (\row -> row.id) kept,
    } == {
      answer: Redirected (Admin.Posts.Index {}),
      gone: Nothing,
      kept: Just post2,
    }
  )
}

test "the page counts the rows that go with it" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let _ <- Db.insert Comment {
    post: post1,
    author: me,
    body: Text.NonEmpty "body-1",
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let _ <- Db.insert Comment {
    post: post2,
    author: me,
    body: Text.NonEmpty "body-2",
  }
  let page <- Test.get (Admin.Posts.Show { id: post1 })
  Task.succeed ({ comments: Test.text "#comments" page.doc } == { comments: Just "1" })
}

test "a post that tags refer to is not deleted" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let _ <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let page <- Test.get (Admin.Posts.Show { id: post1 })
  let r <- Test.submit Confirm {}
  let kept <- Db.get Post post1
  Task.succeed (
    {
      count: Test.text "#tags" page.doc,
      buttons: Test.count "#delete button" page.doc,
      answer: r.answer,
      kept: Maybe.map (\row -> row.id) kept,
    } == {
      count: Just "1",
      buttons: 0,
      answer: FormRejected [
        { field: "", message: "This post cannot be deleted while other rows refer to it." },
      ],
      kept: Just post1,
    }
  )
}

test "a missing row is not found" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let r <- Test.open (Admin.Posts.Show { id: Post.PostId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "a visitor is sent to log in" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let r <- Test.open (Admin.Posts.Show { id: post1 })
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Reader gets no page, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Reader }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let r <- Test.open (Admin.Posts.Show { id: post1 })
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Reader,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let r <- Test.open (Admin.Posts.Show { id: post1 })
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
