-- generated by `alder new admin` (alder v0.0.0-test); regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Post.Show

-- @admin begin imports
import Admin.Layout
import Post
import User
-- @admin end

page "/admin/post/{id}" { id: Post.PostId } requires user, role Admin

type Model = { row: Post }

load : Params -> Session -> Query Model
load params session = {
  let found <- Db.get Post params.id
  match found {
    Just row -> Query.succeed { row: row },
    Nothing -> Query.notFound,
  }
}

view : Model -> Session -> Html Msg
view model session =
  <Admin.Layout.Page title="Post">
    <h1>Post</h1>

    <al-card>
      <dl>
        -- @admin begin fields
        <dt>Id</dt>
        <dd>{model.row.id}</dd>
        <dt>Title</dt>
        <dd>{model.row.title}</dd>
        <dt>Body</dt>
        <dd>{model.row.body}</dd>
        <dt>Status</dt>
        <dd><al-badge>{match model.row.status { Draft -> "Draft", Published -> "Published" }}</al-badge></dd>
        <dt>Featured</dt>
        <dd>{if model.row.featured then <al-badge>Yes</al-badge> else <al-badge variant="secondary">No</al-badge>}</dd>
        <dt>Author</dt>
        <dd><a href={Admin.User.Show { id: model.row.author }}>{model.row.author}</a></dd>
        <dt>Created</dt>
        <dd>{Time.format "Jan 2, 2006" model.row.created}</dd>
        <dt>Updated</dt>
        <dd>{Time.format "Jan 2, 2006" model.row.updated}</dd>
        -- @admin end
      </dl>
      <div slot="actions">
        <al-button href={Admin.Post.Edit { id: model.row.id }}>Edit</al-button>
        <al-button variant="destructive" href={Admin.Post.Delete { id: model.row.id }}>Delete</al-button>
      </div>
    </al-card>
    <a href={Admin.Post.Index {}}>All posts</a>
  </Admin.Layout.Page>

-- @admin begin tests
test "the page shows the row" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post { title: Text.NonEmpty "title-1", body: "body-1", author: me }
  let r <- Test.open (Admin.Post.Show { id: post1 })
  Task.succeed ({ answer: r.answer, title: List.member "title-1" (Test.texts "dd" r.doc) } == { answer: Shown, title: True })
}

test "a missing row is not found" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me, role: Admin }
  let r <- Test.open (Admin.Post.Show { id: Post.PostId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "a visitor is sent to log in" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let post1 <- Db.insert Post { title: Text.NonEmpty "title-1", body: "body-1", author: me }
  let r <- Test.open (Admin.Post.Show { id: post1 })
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Reader gets no page" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me, role: Reader }
  let post1 <- Db.insert Post { title: Text.NonEmpty "title-1", body: "body-1", author: me }
  let r <- Test.open (Admin.Post.Show { id: post1 })
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
