-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Post.Edit

-- @admin begin imports
import Admin.Layout
import Post
import User
-- @admin end

page "/admin/post/{id}/edit" { id: Post.PostId } requires user, role Admin

type Model = {
  row: Post,
  -- @admin begin model
  authors: List User,
  -- @admin end
}

load : Params -> Session -> Query Model
load params session = {
  -- @admin begin load
  let found <- Db.get Post params.id
  let authors <- Db.from User |> Db.orderBy User.email.asc |> Db.all
  match found {
    Just row -> Query.succeed { row: row, authors: authors },
    Nothing -> Query.notFound,
  }
  -- @admin end
}

-- @admin begin form
form PostForm = {
  title: Text.NonEmpty,
  body: Text,
  status: Post.Status,
  featured: Bool,
  author: User.UserId,
}
-- @admin end

msg Save form PostForm

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  Save p -> {
    -- @admin begin update
    let _ <- Db.update Post model.row.id (\row -> { row |
      title: p.form.title,
      body: p.form.body,
      status: p.form.status,
      featured: p.form.featured,
      author: p.form.author,
    })
    Task.succeed (Redirect (Admin.Post.Show { id: model.row.id }))
    -- @admin end
  },
}

view : Model -> Session -> Html Msg
view model session =
  <Admin.Layout.Page title="Edit post">
    <h1>Edit post</h1>

    <al-card>
      <form submit={Save}>
        -- @admin begin inputs
        <al-input field="title" label="Title" value={model.row.title} />
        <al-textarea field="body" label="Body" value={model.row.body} />
        <al-select field="status" label="Status" value={model.row.status} />
        <al-checkbox field="featured" label="Featured" value={model.row.featured} />
        <al-select field="author" label="Author" options={List.map (\r -> { value: r.id, label: r.email }) model.authors} value={model.row.author} />
        -- @admin end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Save</al-button>
      </form>
    </al-card>
    <a href={Admin.Post.Show { id: model.row.id }}>Back</a>
  </Admin.Layout.Page>

-- @admin begin tests
test "saving changes every field" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post { title: Text.NonEmpty "title-1", body: "body-1", author: me }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let page <- Test.get (Admin.Post.Edit { id: post1 })
  let r <- Test.submit PostForm {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    status: Published,
    featured: True,
    author: user2,
  }
  let after <- Db.get Post post1
  Task.succeed ({
    answer: r.answer,
    row: Maybe.map (\row -> {
      title: row.title,
      body: row.body,
      status: row.status,
      featured: row.featured,
      author: row.author,
    }) after,
    authors: Test.texts "select[name=author] option" page.doc,
  } == {
    answer: Redirected (Admin.Post.Show { id: post1 }),
    row: Just {
      title: Text.NonEmpty "title-2",
      body: "body-2",
      status: Published,
      featured: True,
      author: user2,
    },
    authors: ["email-1@example.com", "email-2@example.com"],
  })
}

test "an author not offered is refused" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post { title: Text.NonEmpty "title-1", body: "body-1", author: me }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let page <- Test.get (Admin.Post.Edit { id: post1 })
  let r <- Test.submitRaw PostForm [
    { name: "title", value: "x" },
    { name: "body", value: "x" },
    { name: "status", value: "Draft" },
    { name: "featured", value: "True" },
    { name: "author", value: "missing" },
  ]
  let after <- Db.get Post post1
  Task.succeed ({
    answer: r.answer,
    author: Maybe.map (\row -> row.author) after,
  } == {
    answer: FormRejected [{ field: "author", message: "must be one of the options" }],
    author: Just me,
  })
}

test "a missing row is not found" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me, role: Admin }
  let r <- Test.open (Admin.Post.Edit { id: Post.PostId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "a visitor is sent to log in" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let post1 <- Db.insert Post { title: Text.NonEmpty "title-1", body: "body-1", author: me }
  let r <- Test.open (Admin.Post.Edit { id: post1 })
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Reader gets no page" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me, role: Reader }
  let post1 <- Db.insert Post { title: Text.NonEmpty "title-1", body: "body-1", author: me }
  let r <- Test.open (Admin.Post.Edit { id: post1 })
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
