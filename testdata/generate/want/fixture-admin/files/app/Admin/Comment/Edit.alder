test "the row's own author is offered first when it sorts past the 50" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let user2 <- Db.insert User { email: Text.Email "zz-1@example.com", name: Text.NonEmpty "name-2" }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let comment1 <- Db.insert Comment {
    post: post1,
    author: user2,
    body: Text.NonEmpty "body-1",
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert User {
        email: Text.Email ("email-" ++ Text.fromInt n ++ "@example.com"),
        name: Text.NonEmpty ("name-" ++ Text.fromInt n),
      }) (List.range 3 203)
    )
  let page <- Test.get (Admin.Comment.Edit { id: comment1 })
  let r <- Test.submit CommentForm {
    post: page.model.row.post,
    author: page.model.row.author,
    body: page.model.row.body,
  }
  let after <- Db.get Comment comment1
  Task.succeed (
    {
      answer: r.answer,
      kept: Maybe.map (\row -> row.author) after,
      first: Maybe.map (\o -> o.id) (List.head page.model.authors),
      once: List.length (List.filter (\o -> o.id == user2) page.model.authors),
      shown: List.length page.model.authors,
    } == {
        answer: Redirected (Admin.Comment.Show { id: comment1 }),
        kept: Just user2,
        first: Just user2,
        once: 1,
        shown: 51,
      }
  )
}

test "a missing row is not found" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let r <- Test.open (Admin.Comment.Edit { id: Comment.CommentId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "a visitor is sent to log in" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let comment1 <- Db.insert Comment {
    post: post1,
    author: me,
    body: Text.NonEmpty "body-1",
  }
  let r <- Test.open (Admin.Comment.Edit { id: comment1 })
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Reader gets no page, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Reader }
