-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Comment.Edit

-- @admin begin imports
import Admin.Layout
import Comment
import Post
import User
-- @admin end

page "/admin/comment/{id}/edit" {
  id: Comment.CommentId,
  findPost: Text = "",
  findAuthor: Text = "",
} requires user, role Admin

type Model = {
  row: Comment,
  -- @admin begin model
  posts: List Post,
  postsTotal: Int,
  authors: List User,
  authorsTotal: Int,
  -- @admin end
}

load : Params -> Session -> Query Model
load params session = {
  let admin <- Layout.isAdmin session.user
  if admin then {
    -- @admin begin load
    let found <- Db.get Comment params.id
    match found {
      Just row -> {
        let findPost = Text.slice 0 200 params.findPost
        let postsTotal <- Db.from Post |> Db.count
        let postsOwn <-
          if postsTotal > 200 then
            Db.from Post
              |> Db.where (Post.id.eq row.post)
              |> Db.all
          else
            Query.succeed []
        let postsFound <-
          Db.from Post
            |> Db.orderBy Post.title.asc
            |> Db.where (
              if postsTotal > 200 then
                Db.and [Post.title.contains findPost, Post.id.ne row.post]
              else
                Db.and []
            )
            |> Db.limit (if postsTotal > 200 then 50 else 200)
            |> Db.all
        let posts = postsOwn ++ postsFound
        let findAuthor = Text.slice 0 200 params.findAuthor
        let authorsTotal <- Db.from User |> Db.count
        let authorsOwn <-
          if authorsTotal > 200 then
            Db.from User
              |> Db.where (User.id.eq row.author)
              |> Db.all
          else
            Query.succeed []
        let authorsFound <-
          Db.from User
            |> Db.orderBy User.email.asc
            |> Db.where (
              if authorsTotal > 200 then
                Db.and [User.email.contains findAuthor, User.id.ne row.author]
              else
                Db.and []
            )
            |> Db.limit (if authorsTotal > 200 then 50 else 200)
            |> Db.all
        let authors = authorsOwn ++ authorsFound
        Query.succeed {
          row: row,
          posts: posts,
          postsTotal: postsTotal,
          authors: authors,
          authorsTotal: authorsTotal,
        }
      },
      Nothing -> Query.notFound,
    }
    -- @admin end
  } else
    Query.notFound
}

-- @admin begin form
form CommentForm = {
  post: Post.PostId,
  author: User.UserId,
  body: Text.NonEmpty,
}
-- @admin end

-- @admin begin search
form FindPost = { q: Text }

msg SearchPost form FindPost

form FindAuthor = { q: Text }

msg SearchAuthor form FindAuthor

-- @admin end

msg Save form CommentForm

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  -- @admin begin finds
  SearchPost p ->
    Task.succeed (
      Redirect (Admin.Comment.Edit { id: model.row.id, findPost: Text.slice 0 200 p.form.q })
    ),
  SearchAuthor p ->
    Task.succeed (
      Redirect (Admin.Comment.Edit { id: model.row.id, findAuthor: Text.slice 0 200 p.form.q })
    ),
  -- @admin end
  Save p -> {
    -- @admin begin update
    let _ <- Db.update Comment model.row.id (\row -> { row |
      post: p.form.post,
      author: p.form.author,
      body: p.form.body
    })
    Task.succeed (Redirect (Admin.Comment.Show { id: model.row.id }))
    -- @admin end
  },
}

view : Model -> Session -> Html Msg
view model session =
  <Layout.Page title="Edit comment">
    <h1>Edit comment</h1>

    <al-card>
      -- @admin begin finder
      {if model.postsTotal > 200 then
        <form submit={SearchPost}>
          <al-input field="q" label="Find post" />
          <al-button type="submit" variant="secondary">Find</al-button>
        </form>
      else
        <span></span>}
      {if model.authorsTotal > 200 then
        <form submit={SearchAuthor}>
          <al-input field="q" label="Find author" />
          <al-button type="submit" variant="secondary">Find</al-button>
        </form>
      else
        <span></span>}
      -- @admin end
      <form submit={Save}>
        -- @admin begin inputs
        <al-select
          field="post"
          label="Post"
          options={List.map (\r -> { value: r.id, label: r.title }) model.posts}
          value={model.row.post} />
        <al-select
          field="author"
          label="Author"
          options={List.map (\r -> { value: r.id, label: r.email }) model.authors}
          value={model.row.author} />
        <al-textarea field="body" label="Body" value={model.row.body} />
        -- @admin end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Save</al-button>
      </form>
    </al-card>
    <a href={Admin.Comment.Show { id: model.row.id }}>Back</a>
  </Layout.Page>

-- @admin begin tests
test "saving changes every field" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let comment1 <- Db.insert Comment {
    post: post1,
    author: me,
    body: Text.NonEmpty "body-1",
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let page <- Test.get (Admin.Comment.Edit { id: comment1 })
  let r <- Test.submit CommentForm {
    post: post2,
    author: user2,
    body: Text.NonEmpty "body-2",
  }
  let after <- Db.get Comment comment1
  Task.succeed (
    {
      answer: r.answer,
      row: Maybe.map (\row -> {
        post: row.post,
        author: row.author,
        body: row.body,
      }) after,
      posts: Test.texts "select[name=post] option" page.doc,
      authors: Test.texts "select[name=author] option" page.doc,
    } == {
        answer: Redirected (Admin.Comment.Show { id: comment1 }),
        row: Just {
          post: post2,
          author: user2,
          body: Text.NonEmpty "body-2",
        },
        posts: ["title-1", "title-2"],
        authors: ["email-1@example.com", "email-2@example.com"],
      }
  )
}

test "a post not offered is refused" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let comment1 <- Db.insert Comment {
    post: post1,
    author: me,
    body: Text.NonEmpty "body-1",
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let page <- Test.get (Admin.Comment.Edit { id: comment1 })
  let authorId = Maybe.withDefault "" (Test.attr "value" "select[name=author] option" page.doc)
  let r <- Test.submitRaw CommentForm [
    { name: "post", value: "missing" },
    { name: "author", value: authorId },
    { name: "body", value: "x" },
  ]
  let after <- Db.get Comment comment1
  Task.succeed (
    { answer: r.answer, post: Maybe.map (\row -> row.post) after }
      == {
        answer: FormRejected [{ field: "post", message: "must be one of the options" }],
        post: Just post1,
      }
  )
}

