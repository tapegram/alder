test "a list of 200 posts is offered whole" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let comment1 <- Db.insert Comment {
    post: post1,
    author: me,
    body: Text.NonEmpty "body-1",
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Post {
        title: Text.NonEmpty ("title-" ++ Text.fromInt n),
        body: "body-" ++ Text.fromInt n,
        author: me,
      }) (List.range 3 200)
    )
  let page <- Test.get (Admin.Comment.Edit { id: comment1 })
  Task.succeed (List.length page.model.posts == 200)
}

test "a long list of posts offers 50, and the search narrows it" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let comment1 <- Db.insert Comment {
    post: post1,
    author: me,
    body: Text.NonEmpty "body-1",
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Post {
        title: Text.NonEmpty ("title-" ++ Text.fromInt n),
        body: "body-" ++ Text.fromInt n,
        author: me,
      }) (List.range 3 203)
    )
  let all <- Test.get (Admin.Comment.Edit { id: comment1 })
  let found <- Test.get (Admin.Comment.Edit { id: comment1, findPost: "title-203" })
  let r <- Test.submit FindPost { q: "zz" }
  Task.succeed (
    {
      shown: List.length all.model.posts,
      total: all.model.postsTotal,
      found: Test.count "select[name=post] option" found.doc <= 3,
      answer: r.answer,
    } == {
        shown: 51,
        total: 203,
        found: True,
        answer: Redirected (Admin.Comment.Edit { id: comment1, findPost: "zz" }),
      }
  )
}

test "the row's own post is offered first when it sorts past the 50" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "zz-1",
    body: "body-1",
    author: me,
  }
  let comment1 <- Db.insert Comment {
    post: post1,
    author: me,
    body: Text.NonEmpty "body-1",
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Post {
        title: Text.NonEmpty ("title-" ++ Text.fromInt n),
        body: "body-" ++ Text.fromInt n,
        author: me,
      }) (List.range 2 202)
    )
  let page <- Test.get (Admin.Comment.Edit { id: comment1 })
  let r <- Test.submit CommentForm {
    post: page.model.row.post,
    author: page.model.row.author,
    body: page.model.row.body,
  }
  let after <- Db.get Comment comment1
  Task.succeed (
    {
      answer: r.answer,
      kept: Maybe.map (\row -> row.post) after,
      first: Maybe.map (\o -> o.id) (List.head page.model.posts),
      once: List.length (List.filter (\o -> o.id == post1) page.model.posts),
      shown: List.length page.model.posts,
    } == {
        answer: Redirected (Admin.Comment.Show { id: comment1 }),
        kept: Just post1,
        first: Just post1,
        once: 1,
        shown: 51,
      }
  )
}

