-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Comment.Edit

-- @admin begin imports
import Admin.Layout
import Comment
import Post
import User
-- @admin end

page "/admin/comment/{id}/edit" { id: Comment.CommentId } requires user, role Admin

type Model = {
  row: Comment,
  -- @admin begin model
  posts: List Post,
  authors: List User,
  -- @admin end
}

load : Params -> Session -> Query Model
load params session = {
  -- @admin begin load
  let found <- Db.get Comment params.id
  let posts <- Db.from Post |> Db.orderBy Post.title.asc |> Db.all
  let authors <- Db.from User |> Db.orderBy User.email.asc |> Db.all
  match found {
    Just row -> Query.succeed { row: row, posts: posts, authors: authors },
    Nothing -> Query.notFound,
  }
  -- @admin end
}

-- @admin begin form
form CommentForm = {
  post: Post.PostId,
  author: User.UserId,
  body: Text.NonEmpty,
}
-- @admin end

msg Save form CommentForm

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  Save p -> {
    -- @admin begin update
    let _ <- Db.update Comment model.row.id (\row -> { row |
      post: p.form.post,
      author: p.form.author,
      body: p.form.body,
    })
    Task.succeed (Redirect (Admin.Comment.Show { id: model.row.id }))
    -- @admin end
  },
}

view : Model -> Session -> Html Msg
view model session =
  <Admin.Layout.Page title="Edit comment">
    <h1>Edit comment</h1>

    <al-card>
      <form submit={Save}>
        -- @admin begin inputs
        <al-select field="post" label="Post" options={List.map (\r -> { value: r.id, label: r.title }) model.posts} value={model.row.post} />
        <al-select field="author" label="Author" options={List.map (\r -> { value: r.id, label: r.email }) model.authors} value={model.row.author} />
        <al-textarea field="body" label="Body" value={model.row.body} />
        -- @admin end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Save</al-button>
      </form>
    </al-card>
    <a href={Admin.Comment.Show { id: model.row.id }}>Back</a>
  </Admin.Layout.Page>

-- @admin begin tests
test "saving changes every field" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post { title: Text.NonEmpty "title-1", body: "body-1", author: me }
  let comment1 <- Db.insert Comment { post: post1, author: me, body: Text.NonEmpty "body-1" }
  let post2 <- Db.insert Post { title: Text.NonEmpty "title-2", body: "body-2", author: me }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let page <- Test.get (Admin.Comment.Edit { id: comment1 })
  let r <- Test.submit CommentForm { post: post2, author: user2, body: Text.NonEmpty "body-2" }
  let after <- Db.get Comment comment1
  Task.succeed ({
    answer: r.answer,
    row: Maybe.map (\row -> { post: row.post, author: row.author, body: row.body }) after,
    posts: Test.texts "select[name=post] option" page.doc,
    authors: Test.texts "select[name=author] option" page.doc,
  } == {
    answer: Redirected (Admin.Comment.Show { id: comment1 }),
    row: Just { post: post2, author: user2, body: Text.NonEmpty "body-2" },
    posts: ["title-1", "title-2"],
    authors: ["email-1@example.com", "email-2@example.com"],
  })
}

test "a post not offered is refused" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post { title: Text.NonEmpty "title-1", body: "body-1", author: me }
  let comment1 <- Db.insert Comment { post: post1, author: me, body: Text.NonEmpty "body-1" }
  let post2 <- Db.insert Post { title: Text.NonEmpty "title-2", body: "body-2", author: me }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let page <- Test.get (Admin.Comment.Edit { id: comment1 })
  let authorId = Maybe.withDefault "" (Test.attr "value" "select[name=author] option" page.doc)
  let r <- Test.submitRaw CommentForm [
    { name: "post", value: "missing" },
    { name: "author", value: authorId },
    { name: "body", value: "x" },
  ]
  let after <- Db.get Comment comment1
  Task.succeed ({
    answer: r.answer,
    post: Maybe.map (\row -> row.post) after,
  } == {
    answer: FormRejected [{ field: "post", message: "must be one of the options" }],
    post: Just post1,
  })
}

test "an author not offered is refused" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post { title: Text.NonEmpty "title-1", body: "body-1", author: me }
  let comment1 <- Db.insert Comment { post: post1, author: me, body: Text.NonEmpty "body-1" }
  let post2 <- Db.insert Post { title: Text.NonEmpty "title-2", body: "body-2", author: me }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let page <- Test.get (Admin.Comment.Edit { id: comment1 })
  let postId = Maybe.withDefault "" (Test.attr "value" "select[name=post] option" page.doc)
  let r <- Test.submitRaw CommentForm [
    { name: "post", value: postId },
    { name: "author", value: "missing" },
    { name: "body", value: "x" },
  ]
  let after <- Db.get Comment comment1
  Task.succeed ({
    answer: r.answer,
    author: Maybe.map (\row -> row.author) after,
  } == {
    answer: FormRejected [{ field: "author", message: "must be one of the options" }],
    author: Just me,
  })
}

test "a missing row is not found" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me, role: Admin }
  let r <- Test.open (Admin.Comment.Edit { id: Comment.CommentId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "a visitor is sent to log in" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let post1 <- Db.insert Post { title: Text.NonEmpty "title-1", body: "body-1", author: me }
  let comment1 <- Db.insert Comment { post: post1, author: me, body: Text.NonEmpty "body-1" }
  let r <- Test.open (Admin.Comment.Edit { id: comment1 })
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Reader gets no page" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me, role: Reader }
  let post1 <- Db.insert Post { title: Text.NonEmpty "title-1", body: "body-1", author: me }
  let comment1 <- Db.insert Comment { post: post1, author: me, body: Text.NonEmpty "body-1" }
  let r <- Test.open (Admin.Comment.Edit { id: comment1 })
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
