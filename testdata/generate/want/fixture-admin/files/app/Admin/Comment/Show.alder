-- generated by `alder new admin` (alder v0.0.0-test); regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Comment.Show

-- @admin begin imports
import Admin.Layout
import Comment
import Post
import User
-- @admin end

page "/admin/comment/{id}" { id: Comment.CommentId } requires user, role Admin

type Model = { row: Comment, labels: Labels }

load : Params -> Session -> Query Model
load params session = {
  let found <- Db.get Comment params.id
  match found {
    Just row -> {
      let labels <- labelsOf [row]
      Query.succeed { row: row, labels: labels }
    },
    Nothing -> Query.notFound,
  }
}

-- @admin begin labels
-- Labels are the rows the references of the rows shown name: their links show their labels.
type Labels = { posts: List Post, authors: List User }

-- labelsOf reads the rows that rows refer to.
labelsOf : List Comment -> Query Labels
labelsOf rows = {
  let posts <- Db.from Post |> Db.where (Post.id.in (List.map (\row -> row.post) rows)) |> Db.all
  let authors <- Db.from User |> Db.where (User.id.in (List.map (\row -> row.author) rows)) |> Db.all
  Query.succeed { posts: posts, authors: authors }
}

-- postLabel is the label of the post id names (the id itself if it names none).
postLabel : Labels -> Post.PostId -> Text
postLabel labels id = match List.find (\r -> r.id == id) labels.posts {
  Just r -> r.title,
  Nothing -> id,
}

-- authorLabel is the label of the user id names (the id itself if it names none).
authorLabel : Labels -> User.UserId -> Text
authorLabel labels id = match List.find (\r -> r.id == id) labels.authors {
  Just r -> r.email,
  Nothing -> id,
}
-- @admin end

view : Model -> Session -> Html Msg
view model session =
  <Admin.Layout.Page title="Comment">
    <h1>Comment</h1>

    <al-card>
      <dl>
        -- @admin begin fields
        <dt>Id</dt>
        <dd>{model.row.id}</dd>
        <dt>Post</dt>
        <dd><a href={Admin.Post.Show { id: model.row.post }}>{postLabel model.labels model.row.post}</a></dd>
        <dt>Author</dt>
        <dd><a href={Admin.User.Show { id: model.row.author }}>{authorLabel model.labels model.row.author}</a></dd>
        <dt>Body</dt>
        <dd>{model.row.body}</dd>
        <dt>Created</dt>
        <dd>{Time.format "Jan 2, 2006" model.row.created}</dd>
        -- @admin end
      </dl>
      <div slot="actions">
        <al-button href={Admin.Comment.Edit { id: model.row.id }}>Edit</al-button>
        <al-button variant="destructive" href={Admin.Comment.Delete { id: model.row.id }}>Delete</al-button>
      </div>
    </al-card>
    <a href={Admin.Comment.Index {}}>All comments</a>
  </Admin.Layout.Page>

-- @admin begin tests
test "the page shows the row" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post { title: Text.NonEmpty "title-1", body: "body-1", author: me }
  let comment1 <- Db.insert Comment { post: post1, author: me, body: Text.NonEmpty "body-1" }
  let post2 <- Db.insert Post { title: Text.NonEmpty "title-2", body: "body-2", author: me }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let r <- Test.open (Admin.Comment.Show { id: comment1 })
  let page <- Test.get (Admin.Comment.Show { id: comment1 })
  Task.succeed ({
    answer: r.answer,
    body: List.member "body-1" (Test.texts "dd" r.doc),
    posts: List.length page.model.labels.posts,
    postLabel: postLabel page.model.labels post1,
    authors: List.length page.model.labels.authors,
    authorLabel: authorLabel page.model.labels me,
  } == {
    answer: Shown,
    body: True,
    posts: 1,
    postLabel: "title-1",
    authors: 1,
    authorLabel: "email-1@example.com",
  })
}

test "a missing row is not found" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me, role: Admin }
  let r <- Test.open (Admin.Comment.Show { id: Comment.CommentId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "a visitor is sent to log in" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let post1 <- Db.insert Post { title: Text.NonEmpty "title-1", body: "body-1", author: me }
  let comment1 <- Db.insert Comment { post: post1, author: me, body: Text.NonEmpty "body-1" }
  let r <- Test.open (Admin.Comment.Show { id: comment1 })
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Reader gets no page" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me, role: Reader }
  let post1 <- Db.insert Post { title: Text.NonEmpty "title-1", body: "body-1", author: me }
  let comment1 <- Db.insert Comment { post: post1, author: me, body: Text.NonEmpty "body-1" }
  let r <- Test.open (Admin.Comment.Show { id: comment1 })
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
