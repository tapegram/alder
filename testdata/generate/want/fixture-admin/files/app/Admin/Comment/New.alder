-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Comment.New

-- @admin begin imports
import Admin.Layout
import Comment
import Post
import User
-- @admin end

page "/admin/comment/new" { } requires user, role Admin

type Model = {
  -- @admin begin model
  posts: List Post,
  authors: List User,
  -- @admin end
}

load : Params -> Session -> Query Model
load params session = {
  let admin <- Admin.Layout.isAdmin session.user
  if admin then {
    -- @admin begin load
    let posts <- Db.from Post |> Db.orderBy Post.title.asc |> Db.all
    let authors <- Db.from User |> Db.orderBy User.email.asc |> Db.all
    Query.succeed { posts: posts, authors: authors }
    -- @admin end
  } else Query.notFound
}

-- @admin begin form
form CommentForm = {
  post: Post.PostId,
  author: User.UserId,
  body: Text.NonEmpty,
}
-- @admin end

msg Create form CommentForm

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  Create p -> {
    -- @admin begin insert
    let id <- Db.insert Comment { post: p.form.post, author: p.form.author, body: p.form.body }
    Task.succeed (Redirect (Admin.Comment.Show { id: id }))
    -- @admin end
  },
}

view : Model -> Session -> Html Msg
view model session =
  <Admin.Layout.Page title="New comment">
    <h1>New comment</h1>

    <al-card>
      <form submit={Create}>
        -- @admin begin inputs
        <al-select field="post" label="Post" options={List.map (\r -> { value: r.id, label: r.title }) model.posts} />
        <al-select field="author" label="Author" options={List.map (\r -> { value: r.id, label: r.email }) model.authors} />
        <al-textarea field="body" label="Body" />
        -- @admin end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Create</al-button>
      </form>
    </al-card>
  </Admin.Layout.Page>

-- @admin begin tests
test "creating a comment adds it, with the values submitted" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post { title: Text.NonEmpty "title-1", body: "body-1", author: me }
  let post2 <- Db.insert Post { title: Text.NonEmpty "title-2", body: "body-2", author: me }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let page <- Test.get (Admin.Comment.New {})
  let r <- Test.submit CommentForm { post: post2, author: user2, body: Text.NonEmpty "body-1" }
  let rows <- Db.from Comment |> Db.all
  Task.succeed ({
    answers: List.map (\row -> Redirected (Admin.Comment.Show { id: row.id })) rows,
    rows: List.map (\row -> { post: row.post, author: row.author, body: row.body }) rows,
    posts: Test.texts "select[name=post] option" page.doc,
    authors: Test.texts "select[name=author] option" page.doc,
  } == {
    answers: [r.answer],
    rows: [{ post: post2, author: user2, body: Text.NonEmpty "body-1" }],
    posts: ["title-1", "title-2"],
    authors: ["email-1@example.com", "email-2@example.com"],
  })
}

test "a post not offered is refused" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post { title: Text.NonEmpty "title-1", body: "body-1", author: me }
  let post2 <- Db.insert Post { title: Text.NonEmpty "title-2", body: "body-2", author: me }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let page <- Test.get (Admin.Comment.New {})
  let authorId = Maybe.withDefault "" (Test.attr "value" "select[name=author] option" page.doc)
  let r <- Test.submitRaw CommentForm [
    { name: "post", value: "missing" },
    { name: "author", value: authorId },
    { name: "body", value: "x" },
  ]
  let rows <- Db.from Comment |> Db.count
  Task.succeed ({
    answer: r.answer,
    rows: rows,
  } == {
    answer: FormRejected [{ field: "post", message: "must be one of the options" }],
    rows: 0,
  })
}

test "an author not offered is refused" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post { title: Text.NonEmpty "title-1", body: "body-1", author: me }
  let post2 <- Db.insert Post { title: Text.NonEmpty "title-2", body: "body-2", author: me }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let page <- Test.get (Admin.Comment.New {})
  let postId = Maybe.withDefault "" (Test.attr "value" "select[name=post] option" page.doc)
  let r <- Test.submitRaw CommentForm [
    { name: "post", value: postId },
    { name: "author", value: "missing" },
    { name: "body", value: "x" },
  ]
  let rows <- Db.from Comment |> Db.count
  Task.succeed ({
    answer: r.answer,
    rows: rows,
  } == {
    answer: FormRejected [{ field: "author", message: "must be one of the options" }],
    rows: 0,
  })
}

test "a visitor is sent to log in" = {
  let r <- Test.open (Admin.Comment.New {})
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Reader gets no page, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Reader }
  let r <- Test.open (Admin.Comment.New {})
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Reader,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let r <- Test.open (Admin.Comment.New {})
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
