-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Tags.Edit

-- @admin begin imports
import Admin.Layout
import Table.Post
import Table.Tag
import Table.User
-- @admin end

-- @admin begin routes
route Edit       = GET  "/admin/tag/{id}/edit"              { id: Tag.TagId, findPost: Text = "" } requires user, role Admin
route Save       = PUT  "/admin/tag/{id}/edit/_/Save"       { id: Tag.TagId } form TagForm         requires user, role Admin
route SearchPost = POST "/admin/tag/{id}/edit/_/SearchPost" { id: Tag.TagId } form FindPost        requires user, role Admin
-- @admin end

type Model = {
  row: Tag,
  -- @admin begin model
  posts: List Post,
  postsTotal: Int,
  -- @admin end
}

Edit.load : Edit.Params -> Session -> Query Model
Edit.load params session = {
  let _ <- Layout.adminOnly session.user
  -- @admin begin load
  let found <- Db.get Tag params.id
  match found {
    Just row -> {
      let findPost = Text.slice 0 200 params.findPost
      let postsTotal <- Db.from Post |> Db.count
      let postsOwn <-
        if postsTotal > 200 then
          Db.from Post
            |> Db.where (Post.id.eq row.post)
            |> Db.all
        else
          Query.succeed []
      let postsFound <-
        Db.from Post
          |> Db.orderBy Post.title.asc
          |> Db.where (
            if postsTotal > 200 then
              Db.and [Post.title.contains findPost, Post.id.ne row.post]
            else
              Db.and []
          )
          |> Db.limit (if postsTotal > 200 then 50 else 200)
          |> Db.all
      let posts = postsOwn ++ postsFound
      Query.succeed {
        row: row,
        posts: posts,
        postsTotal: postsTotal,
      }
    },
    Nothing -> Query.notFound,
  }
  -- @admin end
}

-- @admin begin form
form TagForm = { name: Text.NonEmpty, post: Post.PostId }
-- @admin end

-- @admin begin search
form FindPost = { q: Text }

-- SearchPost answers the page again at the text.
SearchPost.update : SearchPost.Params -> Session -> Task Response
SearchPost.update params session =
  Task.succeed (
    Response.redirect (Edit { id: params.id, findPost: Text.slice 0 200 params.form.q })
  )

-- @admin end

-- Save writes the form over the row (a row deleted since is not found) and goes to its page.
Save.update : Save.Params -> Session -> Task Response
Save.update params session = {
  let _ <- Layout.adminOnly session.user
  let found <- Db.get Tag params.id
  match found {
    Just row -> {
      -- @admin begin update
      let nameTaken <-
        Db.from Tag
          |> Db.where (Db.and [Tag.name.eq params.form.name, Tag.id.ne row.id])
          |> Db.count
      if nameTaken > 0 then
        Task.succeed (Response.invalid "A tag with this name exists.")
      else {
        let _ <- Db.update Tag row.id (\r -> { r | name: params.form.name, post: params.form.post })
        Task.succeed (Response.redirect (Admin.Tags.Show.Show { id: row.id }))
      }
      -- @admin end
    },
    Nothing -> Task.notFound,
  }
}

Edit.view : Model -> Session -> Html
Edit.view model session =
  <Layout.Page title="Edit tag">
    <h1>Edit tag</h1>

    <al-card>
      -- @admin begin finder
      {if model.postsTotal > 200 then
        <form submit={SearchPost { id: model.row.id }}>
          <al-input field="q" label="Find post" />
          <al-button type="submit" variant="secondary">Find</al-button>
        </form>
      else
        Html.none}
      -- @admin end
      <form submit={Save { id: model.row.id }}>
        -- @admin begin inputs
        <al-input field="name" label="Name" value={model.row.name} />
        <al-select
          field="post"
          label="Post"
          options={List.map (\r -> { value: r.id, label: r.title }) model.posts}
          value={model.row.post} />
        -- @admin end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Save</al-button>
      </form>
    </al-card>
    <a href={Admin.Tags.Show.Show { id: model.row.id }}>Back</a>
  </Layout.Page>

-- @admin begin tests
test "saving changes every field" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let page <- Test.get (Edit { id: tag1 })
  let r <- Test.submit (Save { id: tag1 }) { name: Text.NonEmpty "name-2", post: post2 }
  let after <- Db.get Tag tag1
  Task.succeed (
    {
      answer: r.answer,
      row: Maybe.map (\row -> { name: row.name, post: row.post }) after,
      posts: Test.texts "select[name=post] option" page.doc,
    } == {
      answer: Redirected (Admin.Tags.Show.Show { id: tag1 }),
      row: Just { name: Text.NonEmpty "name-2", post: post2 },
      posts: ["title-1", "title-2"],
    }
  )
}

test "saving a name another tag has is refused" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let _ <- Db.insert Tag { name: Text.NonEmpty "name-2", post: post1 }
  let before <- Db.get Tag tag1
  let _ <- Test.get (Edit { id: tag1 })
  let r <- Test.submit (Save { id: tag1 }) { name: Text.NonEmpty "name-2", post: post2 }
  let after <- Db.get Tag tag1
  Task.succeed (
    { answer: r.answer, row: after }
      == {
        answer: FormRejected [{ field: "", message: "A tag with this name exists." }],
        row: before,
      }
  )
}

test "a post not offered is refused" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let page <- Test.get (Edit { id: tag1 })
  let r <- Test.submitRaw (Save { id: tag1 }) [
    { name: "name", value: "x" },
    { name: "post", value: "missing" },
  ]
  let after <- Db.get Tag tag1
  Task.succeed (
    { answer: r.answer, post: Maybe.map (\row -> row.post) after }
      == {
        answer: FormRejected [{ field: "post", message: "must be one of the options" }],
        post: Just post1,
      }
  )
}

test "a list of 200 posts is offered whole" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Post {
        title: Text.NonEmpty ("title-" ++ Text.fromInt n),
        body: "body-" ++ Text.fromInt n,
        author: me,
      }) (List.range 3 200)
    )
  let page <- Test.get (Edit { id: tag1 })
  Task.succeed (List.length page.model.posts == 200)
}

test "a long list of posts offers 50, and the search narrows it" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Post {
        title: Text.NonEmpty ("title-" ++ Text.fromInt n),
        body: "body-" ++ Text.fromInt n,
        author: me,
      }) (List.range 3 203)
    )
  let all <- Test.get (Edit { id: tag1 })
  let found <- Test.get (Edit { id: tag1, findPost: "title-203" })
  let r <- Test.submit (SearchPost { id: tag1 }) { q: "zz" }
  Task.succeed (
    {
      shown: List.length all.model.posts,
      total: all.model.postsTotal,
      found: Test.count "select[name=post] option" found.doc <= 3,
      answer: r.answer,
    } == {
      shown: 51,
      total: 203,
      found: True,
      answer: Redirected (Edit { id: tag1, findPost: "zz" }),
    }
  )
}

test "the row's own post is offered first when it sorts past the 50" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "zz-1",
    body: "body-1",
    author: me,
  }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Post {
        title: Text.NonEmpty ("title-" ++ Text.fromInt n),
        body: "body-" ++ Text.fromInt n,
        author: me,
      }) (List.range 2 202)
    )
  let page <- Test.get (Edit { id: tag1 })
  let r <- Test.submit (Save { id: tag1 }) { name: page.model.row.name, post: page.model.row.post }
  let after <- Db.get Tag tag1
  Task.succeed (
    {
      answer: r.answer,
      kept: Maybe.map (\row -> row.post) after,
      first: Maybe.map (\o -> o.id) (List.head page.model.posts),
      once: List.length (List.filter (\o -> o.id == post1) page.model.posts),
      shown: List.length page.model.posts,
    } == {
      answer: Redirected (Admin.Tags.Show.Show { id: tag1 }),
      kept: Just post1,
      first: Just post1,
      once: 1,
      shown: 51,
    }
  )
}

test "a visitor cannot save a tag" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let before <- Db.get Tag tag1
  let _ <- Test.get (Edit { id: tag1 })
  let _ <- Test.login { user: Nothing }
  let r <- Test.submit (Save { id: tag1 }) { name: Text.NonEmpty "name-2", post: post2 }
  let after <- Db.get Tag tag1
  Task.succeed (
    { answer: r.answer, row: after } == { answer: Redirected (Auth.Login {}), row: before }
  )
}

test "a Reader cannot save a tag, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let before <- Db.get Tag tag1
  let _ <- Test.get (Edit { id: tag1 })
  let _ <- Test.login { user: Just me, role: Reader }
  let r <- Test.submit (Save { id: tag1 }) { name: Text.NonEmpty "name-2", post: post2 }
  let after <- Db.get Tag tag1
  Task.succeed ({ answer: r.answer, row: after } == { answer: PageMissing, row: before })
}

test "a demoted Admin cannot save a tag" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let before <- Db.get Tag tag1
  let _ <- Test.get (Edit { id: tag1 })
  let _ <- Db.update User me (\u -> { u | role: Reader })
  let r <- Test.submit (Save { id: tag1 }) { name: Text.NonEmpty "name-2", post: post2 }
  let after <- Db.get Tag tag1
  Task.succeed (
    { answer: r.answer, row: after } == { answer: RequestFailed "400 bad request", row: before }
  )
}

test "a missing row is not found" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let r <- Test.open (Edit { id: Tag.TagId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "a visitor is sent to log in" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let r <- Test.open (Edit { id: tag1 })
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Reader gets no page, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Reader }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let r <- Test.open (Edit { id: tag1 })
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Reader,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let r <- Test.open (Edit { id: tag1 })
  Task.succeed (r.answer == PageMissing)
}
