-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Tags.New

-- @admin begin imports
import Admin.Layout
import Table.Post
import Table.Tag
import Table.User
-- @admin end

-- @admin begin routes
route New        = GET  "/admin/tag/new"              { findPost: Text = "" } requires user, role Admin
route Create     = POST "/admin/tag/new/_/Create"     { } form TagForm        requires user, role Admin
route SearchPost = POST "/admin/tag/new/_/SearchPost" { } form FindPost       requires user, role Admin
-- @admin end

type Model = {
  -- @admin begin model
  posts: List Post,
  postsTotal: Int,
  -- @admin end
}

New.load : New.Params -> Session -> Query Model
New.load params session = {
  let _ <- Layout.adminOnly session.user
  -- @admin begin load
  let findPost = Text.slice 0 200 params.findPost
  let postsTotal <- Db.from Post |> Db.count
  let posts <-
    Db.from Post
      |> Db.orderBy Post.title.asc
      |> Db.where (if postsTotal > 200 then Post.title.contains findPost else Db.and [])
      |> Db.limit (if postsTotal > 200 then 50 else 200)
      |> Db.all
  Query.succeed { posts: posts, postsTotal: postsTotal }
  -- @admin end
}

-- @admin begin form
form TagForm = { name: Text.NonEmpty, post: Post.PostId }
-- @admin end

-- @admin begin search
form FindPost = { q: Text }

-- SearchPost answers the page again at the text.
SearchPost.update : SearchPost.Params -> Session -> Task Response
SearchPost.update params session =
  Task.succeed (Response.redirect (New { findPost: Text.slice 0 200 params.form.q }))

-- @admin end

-- Create adds the row and goes to its page.
Create.update : Create.Params -> Session -> Task Response
Create.update params session = {
  let _ <- Layout.adminOnly session.user
  -- @admin begin insert
  let nameTaken <-
    Db.from Tag
      |> Db.where (Tag.name.eq params.form.name)
      |> Db.count
  if nameTaken > 0 then
    Task.succeed (Response.invalid "A tag with this name exists.")
  else {
    let id <- Db.insert Tag { name: params.form.name, post: params.form.post }
    Task.succeed (Response.redirect (Admin.Tags.Show.Show { id: id }))
  }
  -- @admin end
}

New.view : Model -> Session -> Html
New.view model session =
  <Layout.Page title="New tag">
    <h1>New tag</h1>

    <al-card>
      -- @admin begin finder
      {if model.postsTotal > 200 then
        <form submit={SearchPost}>
          <al-input field="q" label="Find post" />
          <al-button type="submit" variant="secondary">Find</al-button>
        </form>
      else
        Html.none}
      -- @admin end
      <form submit={Create}>
        -- @admin begin inputs
        <al-input field="name" label="Name" />
        <al-select
          field="post"
          label="Post"
          options={List.map (\r -> { value: r.id, label: r.title }) model.posts} />
        -- @admin end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Create</al-button>
      </form>
    </al-card>
  </Layout.Page>

-- @admin begin tests
test "creating a tag adds it, with the values submitted" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let _ <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let page <- Test.get (New {})
  let r <- Test.submit Create { name: Text.NonEmpty "name-2", post: post2 }
  let rows <-
    Db.from Tag
      |> Db.where (Tag.name.eq (Text.NonEmpty "name-2"))
      |> Db.all
  Task.succeed (
    {
      answers: List.map (\row -> Redirected (Admin.Tags.Show.Show { id: row.id })) rows,
      rows: List.map (\row -> { name: row.name, post: row.post }) rows,
      posts: Test.texts "select[name=post] option" page.doc,
    } == {
      answers: [r.answer],
      rows: [{ name: Text.NonEmpty "name-2", post: post2 }],
      posts: ["title-1", "title-2"],
    }
  )
}

test "a tag with a name that exists is refused" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let _ <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let _ <- Test.get (New {})
  let r <- Test.submit Create { name: Text.NonEmpty "name-1", post: post2 }
  let rows <- Db.from Tag |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows }
      == { answer: FormRejected [{ field: "", message: "A tag with this name exists." }], rows: 1 }
  )
}

test "a post not offered is refused" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let page <- Test.get (New {})
  let r <- Test.submitRaw Create [{ name: "name", value: "x" }, { name: "post", value: "missing" }]
  let rows <- Db.from Tag |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows }
      == {
        answer: FormRejected [{ field: "post", message: "must be one of the options" }],
        rows: 0,
      }
  )
}

test "a list of 200 posts is offered whole" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Post {
        title: Text.NonEmpty ("title-" ++ Text.fromInt n),
        body: "body-" ++ Text.fromInt n,
        author: me,
      }) (List.range 3 200)
    )
  let page <- Test.get (New {})
  Task.succeed (List.length page.model.posts == 200)
}

test "a long list of posts offers 50, and the search narrows it" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Post {
        title: Text.NonEmpty ("title-" ++ Text.fromInt n),
        body: "body-" ++ Text.fromInt n,
        author: me,
      }) (List.range 3 203)
    )
  let all <- Test.get (New {})
  let found <- Test.get (New { findPost: "title-203" })
  let r <- Test.submit SearchPost { q: "zz" }
  let _ <- Test.login { user: Nothing }
  let visitor <- Test.submit SearchPost { q: "zz" }
  Task.succeed (
    {
      shown: List.length all.model.posts,
      total: all.model.postsTotal,
      found: Test.texts "select[name=post] option" found.doc == ["title-203"],
      answer: r.answer,
      visitor: visitor.answer,
    } == {
      shown: 50,
      total: 203,
      found: True,
      answer: Redirected (New { findPost: "zz" }),
      visitor: Redirected (Auth.Login.Login {}),
    }
  )
}

test "a post outside the narrowed list is refused" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Post {
        title: Text.NonEmpty ("title-" ++ Text.fromInt n),
        body: "body-" ++ Text.fromInt n,
        author: me,
      }) (List.range 3 203)
    )
  let all <- Test.get (New {})
  let found <- Test.get (New { findPost: "title-203" })
  let r <- Test.submit SearchPost { q: "zz" }
  let pick = Maybe.withDefault "" (Test.attr "value" "select[name=post] option" found.doc)
  let page <- Test.get (New {})
  let sent <- Test.submitRaw Create [{ name: "name", value: "x" }, { name: "post", value: pick }]
  let rows <- Db.from Tag |> Db.count
  Task.succeed (
    { answer: sent.answer, rows: rows }
      == {
        answer: FormRejected [{ field: "post", message: "must be one of the options" }],
        rows: 0,
      }
  )
}

test "a visitor cannot create a tag" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let _ <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let _ <- Test.get (New {})
  let _ <- Test.login { user: Nothing }
  let r <- Test.submit Create { name: Text.NonEmpty "name-2", post: post2 }
  let rows <- Db.from Tag |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows } == { answer: Redirected (Auth.Login.Login {}), rows: 1 }
  )
}

test "a Reader cannot create a tag, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let _ <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let _ <- Test.get (New {})
  let _ <- Test.login { user: Just me, role: Reader }
  let r <- Test.submit Create { name: Text.NonEmpty "name-2", post: post2 }
  let rows <- Db.from Tag |> Db.count
  Task.succeed ({ answer: r.answer, rows: rows } == { answer: PageMissing, rows: 1 })
}

test "a demoted Admin cannot create a tag" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let _ <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let _ <- Test.get (New {})
  let _ <- Db.update User me (\u -> { u | role: Reader })
  let r <- Test.submit Create { name: Text.NonEmpty "name-2", post: post2 }
  let rows <- Db.from Tag |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows } == { answer: RequestFailed "400 bad request", rows: 1 }
  )
}

test "a visitor is sent to log in" = {
  let r <- Test.open (New {})
  Task.succeed (r.answer == Redirected (Auth.Login.Login {}))
}

test "a Reader gets no page, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Reader }
  let r <- Test.open (New {})
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Reader,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let r <- Test.open (New {})
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
