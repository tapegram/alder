-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Comments.Bulk

-- @admin begin imports
import Admin.Layout
import Table.Comment
import Table.Post
import Table.User
-- @admin end

-- @admin begin routes
route Bulk       = GET  "/admin/comment/bulk"              { ids: List Comment.CommentId }              requires user, role Admin
route BulkDelete = POST "/admin/comment/bulk/_/BulkDelete" { ids: List Comment.CommentId } form Confirm requires user, role Admin
-- @admin end

-- The rows chosen on the list (at most maxRows of them), the ids of those that other rows keep
-- from being deleted, how many ids the page was given, and the ids, which each action takes.
type Model = {
  rows: List Comment,
  held: List Comment.CommentId,
  chosen: Int,
  ids: List Comment.CommentId,
}

-- maxRows is how many rows one action takes: a page of the list. More are refused.
maxRows : Int
maxRows = 25

-- tooMany says whether the page was given more ids than an action takes.
tooMany : Model -> Bool
tooMany model = model.chosen > maxRows

-- selected is the rows of ids: the page shows them, and each action reads them again.
selected : List Comment.CommentId -> Query Model
selected ids = {
  -- @admin begin load
  let taken = List.take maxRows ids
  let rows <-
    Db.from Comment
      |> Db.where (Comment.id.in taken)
      |> Db.all
  Query.succeed {
    rows: rows,
    held: [],
    chosen: List.length ids,
    ids: ids,
  }
  -- @admin end
}

Bulk.load : Bulk.Params -> Session -> Query Model
Bulk.load params session = {
  let _ <- Layout.adminOnly session.user
  selected params.ids
}

-- refused says whether a row is kept from being deleted: rows refer to it with a `@restrict`.
refused : Model -> Comment -> Bool
refused model row = List.member row.id model.held

-- @admin begin bulk
-- Each action reads the rows again and answers with the page again and a toast; none takes
-- more than maxRows rows.

-- BulkDelete takes no input: the form is the button, and the place a refusal is shown.
form Confirm = { }

BulkDelete.update : BulkDelete.Params -> Session -> Task Response
BulkDelete.update params session = {
  let _ <- Layout.adminOnly session.user
  let model <- selected params.ids
  if tooMany model then
    Task.succeed (
      Response.invalid ("Choose at most " ++ Text.fromInt maxRows ++ " rows at a time.")
    )
  else {
    let allowed = List.filter (\row -> refused model row == False) model.rows
    let _ <- Task.all (List.map (\row -> Db.delete Comment row.id) allowed)
    Task.succeed (
      Response.refresh
        |> Response.success (
          "Deleted "
            ++ Text.fromInt (List.length allowed)
            ++ " of "
            ++ Text.fromInt (List.length model.rows)
        )
    )
  }
}
-- @admin end

Bulk.view : Model -> Session -> Html
Bulk.view model session =
  <Layout.Page title="Selected comments">
    <h1>{Text.fromInt (List.length model.rows)} selected</h1>

    <al-card>
      {if tooMany model then
        <al-alert id="too-many" variant="warning">
          {"Choose at most " ++ Text.fromInt maxRows ++ " rows at a time."}
        </al-alert>
      else
        Html.none}
      <ul id="selected">
        {for row in model.rows ->
          <li>
            {row.body}
            {if refused model row then
              <small> (kept: other rows refer to it)</small>
            else
              <span></span>}
          </li>}
      </ul>
      -- @admin begin actions
      <form id="bulk-delete" submit={BulkDelete { ids: model.ids }}>
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button variant="destructive" type="submit">
          Delete the rows that can be deleted
        </al-button>
      </form>
      -- @admin end
    </al-card>
    <a href={Admin.Comments.Index.Index {}}>Back to the list</a>
  </Layout.Page>

-- @admin begin tests
test "deleting the chosen rows" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let comment1 <- Db.insert Comment {
    post: post1,
    author: me,
    body: Text.NonEmpty "body-1",
  }
  let comment2 <- Db.insert Comment {
    post: post1,
    author: me,
    body: Text.NonEmpty "body-2",
  }
  let _ <- Test.get (Bulk { ids: [comment1] })
  let r <- Test.submit (BulkDelete { ids: [comment1] }) {}
  let gone <- Db.get Comment comment1
  let left <- Db.get Comment comment2
  Task.succeed (
    {
      answer: r.answer,
      gone: Maybe.map (\row -> row.id) gone,
      left: Maybe.map (\row -> row.id) left,
    } == {
      answer: Refreshed,
      gone: Nothing,
      left: Just comment2,
    }
  )
}

test "25 chosen ids are taken" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let comment1 <- Db.insert Comment {
    post: post1,
    author: me,
    body: Text.NonEmpty "body-1",
  }
  let chosen =
    [comment1] ++ List.map (\n -> Comment.CommentId ("none-" ++ Text.fromInt n)) (List.range 1 24)
  let page <- Test.get (Bulk { ids: chosen })
  let r <- Test.submit (BulkDelete { ids: chosen }) {}
  let after <- Db.get Comment comment1
  Task.succeed (
    {
      answer: r.answer,
      kept: Maybe.map (\row -> row.id) after,
      warned: Test.count "#too-many" page.doc,
    } == {
      answer: Refreshed,
      kept: Nothing,
      warned: 0,
    }
  )
}

test "26 chosen ids are refused" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let comment1 <- Db.insert Comment {
    post: post1,
    author: me,
    body: Text.NonEmpty "body-1",
  }
  let chosen =
    [comment1] ++ List.map (\n -> Comment.CommentId ("none-" ++ Text.fromInt n)) (List.range 1 25)
  let page <- Test.get (Bulk { ids: chosen })
  let r <- Test.submit (BulkDelete { ids: chosen }) {}
  let after <- Db.get Comment comment1
  Task.succeed (
    {
      answer: r.answer,
      kept: Maybe.map (\row -> row.id) after,
      warned: Test.count "#too-many" page.doc,
    } == {
      answer: FormRejected [{ field: "", message: "Choose at most 25 rows at a time." }],
      kept: Just comment1,
      warned: 1,
    }
  )
}

test "a visitor is sent to log in" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let comment1 <- Db.insert Comment {
    post: post1,
    author: me,
    body: Text.NonEmpty "body-1",
  }
  let r <- Test.open (Bulk { ids: [comment1] })
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Reader gets no page, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Reader }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let comment1 <- Db.insert Comment {
    post: post1,
    author: me,
    body: Text.NonEmpty "body-1",
  }
  let r <- Test.open (Bulk { ids: [comment1] })
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Reader,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let comment1 <- Db.insert Comment {
    post: post1,
    author: me,
    body: Text.NonEmpty "body-1",
  }
  let r <- Test.open (Bulk { ids: [comment1] })
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
