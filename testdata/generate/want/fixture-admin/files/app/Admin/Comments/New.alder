test "a visitor cannot create a comment" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let _ <- Test.get (New {})
  let _ <- Test.login { user: Nothing }
  let r <- Test.submit Create {
    post: post2,
    author: user2,
    body: Text.NonEmpty "body-1",
  }
  let rows <- Db.from Comment |> Db.count
  Task.succeed ({ answer: r.answer, rows: rows } == { answer: Redirected (Auth.Login {}), rows: 0 })
}

test "a Reader cannot create a comment, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let _ <- Test.get (New {})
  let _ <- Test.login { user: Just me, role: Reader }
  let r <- Test.submit Create {
    post: post2,
    author: user2,
    body: Text.NonEmpty "body-1",
  }
  let rows <- Db.from Comment |> Db.count
  Task.succeed ({ answer: r.answer, rows: rows } == { answer: PageMissing, rows: 0 })
}

test "a demoted Admin cannot create a comment" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let _ <- Test.get (New {})
  let _ <- Db.update User me (\u -> { u | role: Reader })
  let r <- Test.submit Create {
    post: post2,
    author: user2,
    body: Text.NonEmpty "body-1",
  }
  let rows <- Db.from Comment |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows } == { answer: RequestFailed "400 bad request", rows: 0 }
  )
}

test "a visitor is sent to log in" = {
  let r <- Test.open (New {})
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Reader gets no page, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Reader }
  let r <- Test.open (New {})
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Reader,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let r <- Test.open (New {})
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
