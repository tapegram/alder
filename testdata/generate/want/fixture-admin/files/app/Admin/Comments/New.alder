-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Comments.New

-- @admin begin imports
import Admin.Layout
import Table.Comment
import Table.Post
import Table.User
-- @admin end

-- @admin begin routes
route New          = GET  "/admin/comment/new"                { findPost: Text = "", findAuthor: Text = "" } requires user, role Admin
route Create       = POST "/admin/comment/new/_/Create"       { } form CommentForm                           requires user, role Admin
route SearchPost   = POST "/admin/comment/new/_/SearchPost"   { } form FindPost                              requires user, role Admin
route SearchAuthor = POST "/admin/comment/new/_/SearchAuthor" { } form FindAuthor                            requires user, role Admin
-- @admin end

type Model = {
  -- @admin begin model
  posts: List Post,
  postsTotal: Int,
  authors: List User,
  authorsTotal: Int,
  -- @admin end
}

New.load : New.Params -> Session -> Query Model
New.load params session = {
  let _ <- Layout.adminOnly session.user
  -- @admin begin load
  let findPost = Text.slice 0 200 params.findPost
  let postsTotal <- Db.from Post |> Db.count
  let posts <-
    Db.from Post
      |> Db.orderBy Post.title.asc
      |> Db.where (if postsTotal > 200 then Post.title.contains findPost else Db.and [])
      |> Db.limit (if postsTotal > 200 then 50 else 200)
      |> Db.all
  let findAuthor = Text.slice 0 200 params.findAuthor
  let authorsTotal <- Db.from User |> Db.count
  let authors <-
    Db.from User
      |> Db.orderBy User.email.asc
      |> Db.where (if authorsTotal > 200 then User.email.contains findAuthor else Db.and [])
      |> Db.limit (if authorsTotal > 200 then 50 else 200)
      |> Db.all
  Query.succeed {
    posts: posts,
    postsTotal: postsTotal,
    authors: authors,
    authorsTotal: authorsTotal,
  }
  -- @admin end
}

-- @admin begin form
form CommentForm = {
  post: Post.PostId,
  author: User.UserId,
  body: Text.NonEmpty,
}
-- @admin end

-- @admin begin search
form FindPost = { q: Text }

-- SearchPost answers the page again at the text.
SearchPost.update : SearchPost.Params -> Session -> Task Response
SearchPost.update params session =
  Task.succeed (Response.redirect (New { findPost: Text.slice 0 200 params.form.q }))

form FindAuthor = { q: Text }

-- SearchAuthor answers the page again at the text.
SearchAuthor.update : SearchAuthor.Params -> Session -> Task Response
SearchAuthor.update params session =
  Task.succeed (Response.redirect (New { findAuthor: Text.slice 0 200 params.form.q }))

-- @admin end

-- Create adds the row and goes to its page.
Create.update : Create.Params -> Session -> Task Response
Create.update params session = {
  let _ <- Layout.adminOnly session.user
  -- @admin begin insert
  let id <- Db.insert Comment {
    post: params.form.post,
    author: params.form.author,
    body: params.form.body,
  }
  Task.succeed (Response.redirect (Admin.Comments.Show.Show { id: id }))
  -- @admin end
}

New.view : Model -> Session -> Html
New.view model session =
  <Layout.Page title="New comment">
    <h1>New comment</h1>

    <al-card>
      -- @admin begin finder
      {if model.postsTotal > 200 then
        <form submit={SearchPost}>
          <al-input field="q" label="Find post" />
          <al-button type="submit" variant="secondary">Find</al-button>
        </form>
      else
        Html.none}
      {if model.authorsTotal > 200 then
        <form submit={SearchAuthor}>
          <al-input field="q" label="Find author" />
          <al-button type="submit" variant="secondary">Find</al-button>
        </form>
      else
        Html.none}
      -- @admin end
      <form submit={Create}>
        -- @admin begin inputs
        <al-select
          field="post"
          label="Post"
          options={List.map (\r -> { value: r.id, label: r.title }) model.posts} />
        <al-select
          field="author"
          label="Author"
          options={List.map (\r -> { value: r.id, label: r.email }) model.authors} />
        <al-textarea field="body" label="Body" />
        -- @admin end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Create</al-button>
      </form>
    </al-card>
  </Layout.Page>

-- @admin begin tests
test "creating a comment adds it, with the values submitted" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let page <- Test.get (New {})
  let r <- Test.submit Create {
    post: post2,
    author: user2,
    body: Text.NonEmpty "body-1",
  }
  let rows <- Db.from Comment |> Db.all
  Task.succeed (
    {
      answers: List.map (\row -> Redirected (Admin.Comments.Show.Show { id: row.id })) rows,
      rows: List.map (\row -> {
        post: row.post,
        author: row.author,
        body: row.body,
      }) rows,
      posts: Test.texts "select[name=post] option" page.doc,
      authors: Test.texts "select[name=author] option" page.doc,
    } == {
      answers: [r.answer],
      rows: [
        {
          post: post2,
          author: user2,
          body: Text.NonEmpty "body-1",
        },
      ],
      posts: ["title-1", "title-2"],
      authors: ["email-1@example.com", "email-2@example.com"],
    }
  )
}

test "a post not offered is refused" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let page <- Test.get (New {})
  let authorId = Maybe.withDefault "" (Test.attr "value" "select[name=author] option" page.doc)
  let r <- Test.submitRaw Create [
    { name: "post", value: "missing" },
    { name: "author", value: authorId },
    { name: "body", value: "x" },
  ]
  let rows <- Db.from Comment |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows }
      == {
        answer: FormRejected [{ field: "post", message: "must be one of the options" }],
        rows: 0,
      }
  )
}

