-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.User.Index

-- @admin begin imports
import Admin.Layout
import User
-- @admin end

page "/admin/user" { q: Text = "", sort: Text = "created", dir: Text = "desc", page: Int = 1 } requires user, role Admin

type Model = {
  rows: List User,
  labels: Labels,
  q: Text,
  sort: Text,
  dir: Text,
  page: Int,
  pages: Int,
  count: Int,
}

perPage : Int
perPage = 25

-- @admin begin search
-- search is the rows whose text contains q (every row for "").
search : Text -> Condition User
search q = Db.or [User.email.contains q, User.name.contains q]
-- @admin end

-- @admin begin sorts
-- sorts are the columns the list sorts by, by name.
sorts : List { name: Text, asc: Order User, desc: Order User }
sorts = [
  { name: "email", asc: User.email.asc, desc: User.email.desc },
  { name: "name", asc: User.name.asc, desc: User.name.desc },
  { name: "role", asc: User.role.asc, desc: User.role.desc },
  { name: "created", asc: User.created.asc, desc: User.created.desc },
]
-- @admin end

-- order is the ordering sort names, ascending when dir is "asc"; a name that is not a column's
-- sorts newest first.
order : Text -> Text -> Order User
order sort dir = match List.find (\s -> s.name == sort) sorts {
  Just s -> if dir == "asc" then s.asc else s.desc,
  Nothing -> User.created.desc,
}

-- load reads how many rows match the search, and one page of them (the last, for a page past it),
-- in the order asked for. The search text is cut to 200 characters (Text.slice): a text over
-- 10,000 bytes would fail the query (chapter 8, "Search").
load : Params -> Session -> Query Model
load params session = {
  let q = Text.slice 0 200 params.q
  let count <- Db.from User |> Db.where (search q) |> Db.count
  let pages = Int.max 1 ((count + perPage - 1) / perPage)
  let page = Int.clamp { min: 1, max: pages } params.page
  let rows <-
    Db.from User
      |> Db.where (search q)
      |> Db.orderBy (order params.sort params.dir)
      |> Db.limit perPage
      |> Db.offset ((page - 1) * perPage)
      |> Db.all
  let labels <- labelsOf rows
  Query.succeed {
    rows: rows,
    labels: labels,
    q: q,
    sort: params.sort,
    dir: params.dir,
    page: page,
    pages: pages,
    count: count,
  }
}

-- @admin begin labels
-- Labels are the rows the references of the rows shown name: their links show their labels.
type Labels = { }

labelsOf : List User -> Query Labels
labelsOf rows = Query.succeed { }
-- @admin end

view : Model -> Session -> Html Msg
view model session =
  <Admin.Layout.Page title="Users">
    <h1>Users</h1>

    <al-stack direction="row" gap="sm">
      <form method="get" action="/admin/user">
        <input type="search" name="q" value={model.q} aria-label="Search" />
        <input type="hidden" name="sort" value={model.sort} />
        <input type="hidden" name="dir" value={model.dir} />
      </form>
      <al-button href={Admin.User.New {}}>New user</al-button>
    </al-stack>

    <p id="count">{if model.count == 1 then "1 row" else Text.fromInt model.count ++ " rows"}</p>

    <al-table>
      <table>
        <thead>
          <tr>
            -- @admin begin headers
            <th>
              <a href={Admin.User.Index {
                q: model.q,
                sort: "email",
                dir: if model.sort == "email" && model.dir == "asc" then "desc" else "asc",
              }}>Email</a>
            </th>
            <th>
              <a href={Admin.User.Index {
                q: model.q,
                sort: "name",
                dir: if model.sort == "name" && model.dir == "asc" then "desc" else "asc",
              }}>Name</a>
            </th>
            <th>
              <a href={Admin.User.Index {
                q: model.q,
                sort: "role",
                dir: if model.sort == "role" && model.dir == "asc" then "desc" else "asc",
              }}>Role</a>
            </th>
            <th>
              <a href={Admin.User.Index {
                q: model.q,
                sort: "created",
                dir: if model.sort == "created" && model.dir == "asc" then "desc" else "asc",
              }}>Created</a>
            </th>
            -- @admin end
          </tr>
        </thead>
        <tbody>
          {for row in model.rows ->
            <tr>
              -- @admin begin cells
              <td><a href={Admin.User.Show { id: row.id }}>{row.email}</a></td>
              <td>{row.name}</td>
              <td><al-badge>{match row.role { Reader -> "Reader", Admin -> "Admin" }}</al-badge></td>
              <td>{Time.format "Jan 2, 2006" row.created}</td>
              -- @admin end
            </tr>}
        </tbody>
      </table>
    </al-table>

    <al-pagination role="navigation" aria-label="Pages">
      {if model.page > 1 then <a slot="prev" href={Admin.User.Index { q: model.q, sort: model.sort, dir: model.dir, page: model.page - 1 }} rel="prev">Previous</a> else <span slot="prev" aria-disabled="true">Previous</span>}
      <span>Page {Text.fromInt model.page} of {Text.fromInt model.pages}</span>
      {if model.page < model.pages then <a slot="next" href={Admin.User.Index { q: model.q, sort: model.sort, dir: model.dir, page: model.page + 1 }} rel="next">Next</a> else <span slot="next" aria-disabled="true">Next</span>}
    </al-pagination>
  </Admin.Layout.Page>

-- @admin begin tests
test "the list shows every row, newest first" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me, role: Admin }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let user3 <- Db.insert User {
    email: Text.Email "email-3@example.com",
    name: Text.NonEmpty "name-3",
  }
  let page <- Test.get (Admin.User.Index {})
  Task.succeed ({ rows: List.map (\row -> row.id) page.model.rows } == { rows: [user3, user2, me] })
}

test "sorting by email goes both ways" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me, role: Admin }
  let user2 <- Db.insert User {
    email: Text.Email "email-3@example.com",
    name: Text.NonEmpty "name-2",
  }
  let user3 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-3",
  }
  let up <- Test.get (Admin.User.Index { sort: "email", dir: "asc" })
  let down <- Test.get (Admin.User.Index { sort: "email" })
  Task.succeed ({
    up: List.map (\row -> row.id) up.model.rows,
    down: List.map (\row -> row.id) down.model.rows,
  } == {
    up: [me, user3, user2],
    down: [user2, user3, me],
  })
}

test "searching finds the rows that contain the text" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me, role: Admin }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let user3 <- Db.insert User {
    email: Text.Email "email-3@example.com",
    name: Text.NonEmpty "name-3",
  }
  let page <- Test.get (Admin.User.Index { q: "email-3@example.com" })
  Task.succeed ({
    rows: List.map (\row -> row.id) page.model.rows,
    count: Test.text "#count" page.doc,
  } == {
    rows: [user3],
    count: Just "1 row",
  })
}

test "a search text of 20,000 characters is cut to 200" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me, role: Admin }
  let long = Text.join "" (List.map (\n -> "z") (List.range 1 20000))
  let page <- Test.get (Admin.User.Index { q: long })
  Task.succeed ({
    q: Text.length page.model.q,
    rows: List.length page.model.rows,
  } == {
    q: 200,
    rows: 0,
  })
}

test "the list has 25 rows a page, and a page past the last is the last" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me, role: Admin }
  let _ <- Task.all (List.map (\n -> Db.insert User {
    email: Text.Email ("email-" ++ Text.fromInt n ++ "@example.com"),
    name: Text.NonEmpty ("name-" ++ Text.fromInt n),
  }) (List.range 2 27))
  let first <- Test.get (Admin.User.Index {})
  let second <- Test.get (Admin.User.Index { page: 2 })
  let past <- Test.get (Admin.User.Index { page: 9 })
  Task.succeed ({
    first: List.length first.model.rows,
    second: List.length second.model.rows,
    past: { page: past.model.page, rows: List.length past.model.rows },
    count: Test.text "#count" first.doc,
    pages: Test.texts "al-pagination span" first.doc,
  } == {
    first: 25,
    second: 2,
    past: { page: 2, rows: 2 },
    count: Just "27 rows",
    pages: ["Previous", "Page 1 of 2"],
  })
}

test "a visitor is sent to log in" = {
  let r <- Test.open (Admin.User.Index {})
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Reader gets no page" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me, role: Reader }
  let r <- Test.open (Admin.User.Index {})
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
