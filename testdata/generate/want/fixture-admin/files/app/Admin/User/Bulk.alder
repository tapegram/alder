-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.User.Bulk

-- @admin begin imports
import Admin.Layout
import Comment
import Post
import User
-- @admin end

page "/admin/user/bulk" { ids: List User.UserId } requires user, role Admin

-- The rows chosen on the list, and the ids of those that other rows keep from being deleted.
type Model = { rows: List User, held: List User.UserId }

load : Params -> Session -> Query Model
load params session = {
  let admin <- Admin.Layout.isAdmin session.user
  if admin then {
    -- @admin begin load
    let rows <- Db.from User |> Db.where (User.id.in params.ids) |> Db.all
    let held1 <- Db.from Comment |> Db.where (Comment.author.in (params.ids)) |> Db.all
    let held2 <- Db.from Post |> Db.where (Post.author.in (params.ids)) |> Db.all
    Query.succeed {
      rows: rows,
      held: List.concat [List.map (\r -> r.author) held1, List.map (\r -> r.author) held2],
    }
    -- @admin end
  } else Query.notFound
}

-- refused says whether a row is kept from being deleted: rows refer to it with a `@restrict`,
-- or it is the signed-in user's own.
refused : Model -> Session -> User -> Bool
refused model session row = List.member row.id model.held || session.user == row.id

-- @admin begin bulk
form Confirm = { }

msg BulkDelete form Confirm

-- Each action reads the rows again (load runs before every message) and answers with a notice.
update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  BulkDelete p -> {
    let allowed = List.filter (\row -> refused model session row == False) model.rows
    let _ <- Task.all (List.map (\row -> Db.delete User row.id) allowed)
    Task.succeed (Notice.with ("Deleted " ++ Text.fromInt (List.length allowed) ++ " of " ++ Text.fromInt (List.length model.rows)) (Redirect (Admin.User.Index {})))
  },
}
-- @admin end

view : Model -> Session -> Html Msg
view model session =
  <Admin.Layout.Page title="Selected users">
    <h1>{Text.fromInt (List.length model.rows)} selected</h1>

    <al-card>
      <ul id="selected">
        {for row in model.rows ->
          <li>{row.email}{if refused model session row then <small> (kept: other rows refer to it)</small> else <span></span>}</li>}
      </ul>
      -- @admin begin actions
      <form id="bulk-delete" submit={BulkDelete}>
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button variant="destructive" type="submit">Delete the rows that can be deleted</al-button>
      </form>
      -- @admin end
    </al-card>
    <a href={Admin.User.Index {}}>Back to the list</a>
  </Admin.Layout.Page>

-- @admin begin tests
test "deleting the chosen rows leaves the ones other rows refer to" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let post1 <- Db.insert Post { title: Text.NonEmpty "title-1", body: "body-1", author: me }
  let _ <- Db.insert Comment { post: post1, author: user2, body: Text.NonEmpty "body-1" }
  let user3 <- Db.insert User {
    email: Text.Email "email-3@example.com",
    name: Text.NonEmpty "name-3",
  }
  let user4 <- Db.insert User {
    email: Text.Email "email-4@example.com",
    name: Text.NonEmpty "name-4",
  }
  let _ <- Test.get (Admin.User.Bulk { ids: [user2, user3] })
  let r <- Test.submit Confirm { }
  let gone <- Db.get User user3
  let left <- Db.get User user4
  let kept <- Db.get User user2
  let page <- Test.get (Admin.User.Bulk { ids: [user2, user3] })
  Task.succeed ({
    answer: r.answer,
    gone: Maybe.map (\row -> row.id) gone,
    left: Maybe.map (\row -> row.id) left,
    kept: Maybe.map (\row -> row.id) kept,
    listed: Test.count "#selected li small" page.doc,
  } == {
    answer: Redirected (Admin.User.Index {}),
    gone: Nothing,
    left: Just user4,
    kept: Just user2,
    listed: 1,
  })
}

test "an Admin's own row is not deleted with the chosen rows" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let _ <- Test.get (Admin.User.Bulk { ids: [me] })
  let r <- Test.submit Confirm { }
  let kept <- Db.get User me
  Task.succeed (Maybe.map (\row -> row.id) kept == Just me)
}

test "a visitor is sent to log in" = {
  let user1 <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
  }
  let r <- Test.open (Admin.User.Bulk { ids: [user1] })
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Reader gets no page, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Reader }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let r <- Test.open (Admin.User.Bulk { ids: [user2] })
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Reader,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let r <- Test.open (Admin.User.Bulk { ids: [user2] })
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
