-- generated by `alder new admin` (alder v0.0.0-test); regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.User.Edit

-- @admin begin imports
import Admin.Layout
import User
-- @admin end

page "/admin/user/{id}/edit" { id: User.UserId } requires user, role Admin

type Model = {
  row: User,
  -- @admin begin model
  -- @admin end
}

load : Params -> Session -> Query Model
load params session = {
  -- @admin begin load
  let found <- Db.get User params.id
  match found {
    Just row -> Query.succeed { row: row },
    Nothing -> Query.notFound,
  }
  -- @admin end
}

-- @admin begin form
form UserForm = {
  email: Text.Email,
  name: Text.NonEmpty,
  role: User.Role,
}
-- @admin end

msg Save form UserForm

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  Save p -> {
    -- @admin begin update
    let _ <- Db.update User model.row.id (\row -> { row | email: p.form.email, name: p.form.name, role: p.form.role })
    -- @admin end
    Task.succeed (Redirect (Admin.User.Show { id: model.row.id }))
  },
}

view : Model -> Session -> Html Msg
view model session =
  <Admin.Layout.Page title="Edit user">
    <h1>Edit user</h1>

    <al-card>
      <form submit={Save}>
        -- @admin begin inputs
        <al-input field="email" label="Email" value={model.row.email} />
        <al-input field="name" label="Name" value={model.row.name} />
        <al-select field="role" label="Role" value={model.row.role} />
        -- @admin end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Save</al-button>
      </form>
    </al-card>
    <a href={Admin.User.Show { id: model.row.id }}>Back</a>
  </Admin.Layout.Page>

-- @admin begin tests
test "saving changes every field" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me, role: Admin }
  let user2 <- Db.insert User { email: Text.Email "email-2@example.com", name: Text.NonEmpty "name-2" }
  let page <- Test.get (Admin.User.Edit { id: user2 })
  let r <- Test.submit UserForm { email: Text.Email "email-3@example.com", name: Text.NonEmpty "name-3", role: Admin }
  let after <- Db.get User user2
  Task.succeed ({ answer: r.answer, row: Maybe.map (\row -> { email: row.email, name: row.name, role: row.role }) after } == { answer: Redirected (Admin.User.Show { id: user2 }), row: Just { email: Text.Email "email-3@example.com", name: Text.NonEmpty "name-3", role: Admin } })
}

test "a missing row is not found" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me, role: Admin }
  let r <- Test.open (Admin.User.Edit { id: User.UserId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "a visitor is sent to log in" = {
  let user1 <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let r <- Test.open (Admin.User.Edit { id: user1 })
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Reader gets no page" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me, role: Reader }
  let user2 <- Db.insert User { email: Text.Email "email-2@example.com", name: Text.NonEmpty "name-2" }
  let r <- Test.open (Admin.User.Edit { id: user2 })
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
