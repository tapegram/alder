-- generated by `alder new admin` (alder v0.0.0-test); regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.User.Show

-- @admin begin imports
import Admin.Layout
import User
-- @admin end

page "/admin/user/{id}" { id: User.UserId } requires user, role Admin

type Model = { row: User }

load : Params -> Session -> Query Model
load params session = {
  let found <- Db.get User params.id
  match found {
    Just row -> Query.succeed { row: row },
    Nothing -> Query.notFound,
  }
}

view : Model -> Session -> Html Msg
view model session =
  <Admin.Layout.Page title="User">
    <h1>User</h1>

    <al-card>
      <dl>
        -- @admin begin fields
        <dt>Id</dt>
        <dd>{model.row.id}</dd>
        <dt>Email</dt>
        <dd>{model.row.email}</dd>
        <dt>Name</dt>
        <dd>{model.row.name}</dd>
        <dt>Role</dt>
        <dd><al-badge>{match model.row.role { Reader -> "Reader", Admin -> "Admin" }}</al-badge></dd>
        <dt>Created</dt>
        <dd>{Time.format "Jan 2, 2006" model.row.created}</dd>
        -- @admin end
      </dl>
      <div slot="actions">
        <al-button href={Admin.User.Edit { id: model.row.id }}>Edit</al-button>
        <al-button variant="destructive" href={Admin.User.Delete { id: model.row.id }}>Delete</al-button>
      </div>
    </al-card>
    <a href={Admin.User.Index {}}>All users</a>
  </Admin.Layout.Page>

-- @admin begin tests
test "the page shows the row" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me, role: Admin }
  let user2 <- Db.insert User { email: Text.Email "email-2@example.com", name: Text.NonEmpty "name-2" }
  let r <- Test.open (Admin.User.Show { id: user2 })
  Task.succeed ({ answer: r.answer, email: List.member "email-2@example.com" (Test.texts "dd" r.doc) } == { answer: Shown, email: True })
}

test "a missing row is not found" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me, role: Admin }
  let r <- Test.open (Admin.User.Show { id: User.UserId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "a visitor is sent to log in" = {
  let user1 <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let r <- Test.open (Admin.User.Show { id: user1 })
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Reader gets no page" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me, role: Reader }
  let user2 <- Db.insert User { email: Text.Email "email-2@example.com", name: Text.NonEmpty "name-2" }
  let r <- Test.open (Admin.User.Show { id: user2 })
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
