-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Tag.Show

-- @admin begin imports
import Admin.Layout
import Table.Post
import Table.Tag
import Table.User
-- @admin end

page "/admin/tag/{id}" { id: Tag.TagId } requires user, role Admin

-- The row, the labels of the rows it refers to, and (for the delete dialog) how many rows of
-- each table refer to it.
type Model = {
  row: Tag,
  labels: Labels,
  -- @admin begin model
  -- @admin end
}

load : Params -> Session -> Query Model
load params session = {
  let admin <- Layout.isAdmin session.user
  if admin then {
    -- @admin begin load
    let found <- Db.get Tag params.id
    match found {
      Just row -> {
        let labels <- labelsOf [row]
        Query.succeed { row: row, labels: labels }
      },
      Nothing -> Query.notFound,
    }
    -- @admin end
  } else
    Query.notFound
}

-- @admin begin labels
-- Labels are the rows the references of the rows shown name: their links show their labels.
type Labels = { posts: List Post }

-- labelsOf reads the rows that rows refer to.
labelsOf : List Tag -> Query Labels
labelsOf rows = {
  let posts <-
    Db.from Post
      |> Db.where (Post.id.in (List.map (\row -> row.post) rows))
      |> Db.all
  Query.succeed { posts: posts }
}

-- postLabel is the label of the post id names (the id itself if it names none).
postLabel : Labels -> Post.PostId -> Text
postLabel labels id = match List.find (\r -> r.id == id) labels.posts {
  Just r -> r.title,
  Nothing -> id,
}
-- @admin end

-- @admin begin blockers
-- blockers counts the rows that keep this one from being deleted, which the database would
-- refuse the delete for: the `@restrict` references to it, or to a row deleted with it.
blockers : Model -> Int
blockers model = 0
-- @admin end

-- The delete dialog's form: no input, the button and the place a refusal is shown.
form Confirm = { }

msg Remove form Confirm

-- Remove deletes the row, unless rows refer to it that keep it (load counted them, as it does
-- before every message), as the Delete page does.
update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  Remove p -> {
    -- @admin begin remove
    let _ <- Db.delete Tag model.row.id
    Task.succeed (Redirect (Admin.Tag.Index {}))
    -- @admin end
  },
}

view : Model -> Session -> Html Msg
view model session =
  <Layout.Page title="Tag">
    <h1>Tag</h1>

    <al-card>
      <dl id="fields">
        -- @admin begin fields
        <dt>Id</dt>
        <dd>{model.row.id}</dd>
        <dt>Name</dt>
        <dd>{model.row.name}</dd>
        <dt>Post</dt>
        <dd>
          <a href={Admin.Post.Show { id: model.row.post }}>
            {postLabel model.labels model.row.post}
          </a>
        </dd>
        <dt>Created</dt>
        <dd>{Time.format "Jan 2, 2006" model.row.created}</dd>
        -- @admin end
      </dl>
      <div slot="actions">
        <al-button href={Admin.Tag.Edit { id: model.row.id }}>Edit</al-button>
        <al-button variant="destructive">
          <button type="button" commandfor="delete-dialog" command="show-modal">Delete</button>
        </al-button>
      </div>
    </al-card>
    <al-dialog id="delete-dialog" heading="Delete this tag?" dismissible>
      <dl>
        -- @admin begin counts
        -- @admin end
      </dl>
      <form id="delete" submit={Remove}>
        <al-alert variant="destructive"><Errors form /></al-alert>
        {if blockers model > 0 then
          <p>It cannot be deleted while other rows refer to it.</p>
        else
          <al-button variant="destructive" type="submit">Delete</al-button>}
      </form>
      <div slot="actions"><a href={Admin.Tag.Delete { id: model.row.id }}>See the details</a></div>
    </al-dialog>
    <a href={Admin.Tag.Index {}}>All tags</a>
  </Layout.Page>

-- @admin begin tests
test "the page shows the row" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let r <- Test.open (Admin.Tag.Show { id: tag1 })
  let page <- Test.get (Admin.Tag.Show { id: tag1 })
  Task.succeed (
    {
      answer: r.answer,
      name: List.member "name-1" (Test.texts "#fields dd" r.doc),
      posts: List.length page.model.labels.posts,
      postLabel: postLabel page.model.labels post1,
    } == {
        answer: Shown,
        name: True,
        posts: 1,
        postLabel: "title-1",
      }
  )
}

test "deleting a tag nothing refers to" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let _ <- Test.get (Admin.Tag.Show { id: tag1 })
  let r <- Test.submit Confirm {}
  let gone <- Db.get Tag tag1
  Task.succeed (
    { answer: r.answer, gone: Maybe.map (\row -> row.id) gone }
      == { answer: Redirected (Admin.Tag.Index {}), gone: Nothing }
  )
}

test "a missing row is not found" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let r <- Test.open (Admin.Tag.Show { id: Tag.TagId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "a visitor is sent to log in" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let r <- Test.open (Admin.Tag.Show { id: tag1 })
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Reader gets no page, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Reader }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let r <- Test.open (Admin.Tag.Show { id: tag1 })
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Reader,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let r <- Test.open (Admin.Tag.Show { id: tag1 })
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
