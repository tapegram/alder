-- generated by `alder new admin` (alder v0.0.0-test); regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Tag.New

-- @admin begin imports
import Admin.Layout
import Post
import Tag
import User
-- @admin end

page "/admin/tag/new" { } requires user, role Admin

type Model = {
  -- @admin begin model
  posts: List Post,
  -- @admin end
}

load : Params -> Session -> Query Model
load params session = {
  -- @admin begin load
  let posts <- Db.from Post |> Db.orderBy Post.title.asc |> Db.all
  Query.succeed { posts: posts }
  -- @admin end
}

-- @admin begin form
form TagForm = {
  name: Text.NonEmpty,
  post: Post.PostId,
}
-- @admin end

msg Create form TagForm

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  Create p -> {
    -- @admin begin insert
    let nameTaken <- Db.from Tag |> Db.where (Tag.name.eq p.form.name) |> Db.count
    if nameTaken > 0 then
      Task.succeed (Reject "A tag with this name exists.")
    else {
      let id <- Db.insert Tag { name: p.form.name, post: p.form.post }
      Task.succeed (Redirect (Admin.Tag.Show { id: id }))
    }
    -- @admin end
  },
}

view : Model -> Session -> Html Msg
view model session =
  <Admin.Layout.Page title="New tag">
    <h1>New tag</h1>

    <al-card>
      <form submit={Create}>
        -- @admin begin inputs
        <al-input field="name" label="Name" />
        <al-select field="post" label="Post" options={List.map (\r -> { value: r.id, label: r.title }) model.posts} />
        -- @admin end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Create</al-button>
      </form>
    </al-card>
  </Admin.Layout.Page>

-- @admin begin tests
test "creating a tag adds it, with the values submitted" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post { title: Text.NonEmpty "title-1", body: "body-1", author: me }
  let post2 <- Db.insert Post { title: Text.NonEmpty "title-2", body: "body-2", author: me }
  let _ <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let page <- Test.get (Admin.Tag.New {})
  let r <- Test.submit TagForm { name: Text.NonEmpty "name-2", post: post2 }
  let rows <- Db.from Tag |> Db.where (Tag.name.eq (Text.NonEmpty "name-2")) |> Db.all
  Task.succeed ({
    answers: List.map (\row -> Redirected (Admin.Tag.Show { id: row.id })) rows,
    rows: List.map (\row -> { name: row.name, post: row.post }) rows,
    posts: Test.texts "select[name=post] option" page.doc,
  } == {
    answers: [r.answer],
    rows: [{ name: Text.NonEmpty "name-2", post: post2 }],
    posts: ["title-1", "title-2"],
  })
}

test "a tag with a name that exists is refused" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post { title: Text.NonEmpty "title-1", body: "body-1", author: me }
  let post2 <- Db.insert Post { title: Text.NonEmpty "title-2", body: "body-2", author: me }
  let _ <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let _ <- Test.get (Admin.Tag.New {})
  let r <- Test.submit TagForm { name: Text.NonEmpty "name-1", post: post2 }
  let rows <- Db.from Tag |> Db.count
  Task.succeed ({
    answer: r.answer,
    rows: rows,
  } == {
    answer: FormRejected [{ field: "", message: "A tag with this name exists." }],
    rows: 1,
  })
}

test "a post not offered is refused" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post { title: Text.NonEmpty "title-1", body: "body-1", author: me }
  let post2 <- Db.insert Post { title: Text.NonEmpty "title-2", body: "body-2", author: me }
  let page <- Test.get (Admin.Tag.New {})
  let r <- Test.submitRaw TagForm [{ name: "name", value: "x" }, { name: "post", value: "missing" }]
  let rows <- Db.from Tag |> Db.count
  Task.succeed ({
    answer: r.answer,
    rows: rows,
  } == {
    answer: FormRejected [{ field: "post", message: "must be one of the options" }],
    rows: 0,
  })
}

test "a visitor is sent to log in" = {
  let r <- Test.open (Admin.Tag.New {})
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Reader gets no page" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me, role: Reader }
  let r <- Test.open (Admin.Tag.New {})
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
