-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Tag.New

-- @admin begin imports
import Admin.Layout
import Table.Post
import Table.Tag
import Table.User
-- @admin end

page "/admin/tag/new" { findPost: Text = "" } requires user, role Admin

type Model = {
  -- @admin begin model
  posts: List Post,
  postsTotal: Int,
  -- @admin end
}

load : Params -> Session -> Query Model
load params session = {
  let admin <- Layout.isAdmin session.user
  if admin then {
    -- @admin begin load
    let findPost = Text.slice 0 200 params.findPost
    let postsTotal <- Db.from Post |> Db.count
    let posts <-
      Db.from Post
        |> Db.orderBy Post.title.asc
        |> Db.where (if postsTotal > 200 then Post.title.contains findPost else Db.and [])
        |> Db.limit (if postsTotal > 200 then 50 else 200)
        |> Db.all
    Query.succeed { posts: posts, postsTotal: postsTotal }
    -- @admin end
  } else
    Query.notFound
}

-- @admin begin form
form TagForm = { name: Text.NonEmpty, post: Post.PostId }
-- @admin end

-- @admin begin search
form FindPost = { q: Text }

msg SearchPost form FindPost

-- @admin end

msg Create form TagForm

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  -- @admin begin finds
  SearchPost p -> Task.succeed (Redirect (Admin.Tag.New { findPost: Text.slice 0 200 p.form.q })),
  -- @admin end
  Create p -> {
    -- @admin begin insert
    let nameTaken <-
      Db.from Tag
        |> Db.where (Tag.name.eq p.form.name)
        |> Db.count
    if nameTaken > 0 then
      Task.succeed (Reject "A tag with this name exists.")
    else {
      let id <- Db.insert Tag { name: p.form.name, post: p.form.post }
      Task.succeed (Redirect (Admin.Tag.Show { id: id }))
    }
    -- @admin end
  },
}

view : Model -> Session -> Html Msg
view model session =
  <Layout.Page title="New tag">
    <h1>New tag</h1>

    <al-card>
      -- @admin begin finder
      {if model.postsTotal > 200 then
        <form submit={SearchPost}>
          <al-input field="q" label="Find post" />
          <al-button type="submit" variant="secondary">Find</al-button>
        </form>
      else
        <span></span>}
      -- @admin end
      <form submit={Create}>
        -- @admin begin inputs
        <al-input field="name" label="Name" />
        <al-select
          field="post"
          label="Post"
          options={List.map (\r -> { value: r.id, label: r.title }) model.posts} />
        -- @admin end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Create</al-button>
      </form>
    </al-card>
  </Layout.Page>

-- @admin begin tests
test "creating a tag adds it, with the values submitted" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let _ <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let page <- Test.get (Admin.Tag.New {})
  let r <- Test.submit TagForm { name: Text.NonEmpty "name-2", post: post2 }
  let rows <-
    Db.from Tag
      |> Db.where (Tag.name.eq (Text.NonEmpty "name-2"))
      |> Db.all
  Task.succeed (
    {
      answers: List.map (\row -> Redirected (Admin.Tag.Show { id: row.id })) rows,
      rows: List.map (\row -> { name: row.name, post: row.post }) rows,
      posts: Test.texts "select[name=post] option" page.doc,
    } == {
        answers: [r.answer],
        rows: [{ name: Text.NonEmpty "name-2", post: post2 }],
        posts: ["title-1", "title-2"],
      }
  )
}

test "a tag with a name that exists is refused" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let _ <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let _ <- Test.get (Admin.Tag.New {})
  let r <- Test.submit TagForm { name: Text.NonEmpty "name-1", post: post2 }
  let rows <- Db.from Tag |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows }
      == { answer: FormRejected [{ field: "", message: "A tag with this name exists." }], rows: 1 }
  )
}

test "a post not offered is refused" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let page <- Test.get (Admin.Tag.New {})
  let r <- Test.submitRaw TagForm [{ name: "name", value: "x" }, { name: "post", value: "missing" }]
  let rows <- Db.from Tag |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows }
      == {
        answer: FormRejected [{ field: "post", message: "must be one of the options" }],
        rows: 0,
      }
  )
}

test "a list of 200 posts is offered whole" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Post {
        title: Text.NonEmpty ("title-" ++ Text.fromInt n),
        body: "body-" ++ Text.fromInt n,
        author: me,
      }) (List.range 3 200)
    )
  let page <- Test.get (Admin.Tag.New {})
  Task.succeed (List.length page.model.posts == 200)
}

test "a long list of posts offers 50, and the search narrows it" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Post {
        title: Text.NonEmpty ("title-" ++ Text.fromInt n),
        body: "body-" ++ Text.fromInt n,
        author: me,
      }) (List.range 3 203)
    )
  let all <- Test.get (Admin.Tag.New {})
  let found <- Test.get (Admin.Tag.New { findPost: "title-203" })
  let r <- Test.submit FindPost { q: "zz" }
  Task.succeed (
    {
      shown: List.length all.model.posts,
      total: all.model.postsTotal,
      found: Test.texts "select[name=post] option" found.doc == ["title-203"],
      answer: r.answer,
    } == {
        shown: 50,
        total: 203,
        found: True,
        answer: Redirected (Admin.Tag.New { findPost: "zz" }),
      }
  )
}

test "a post outside the narrowed list is refused" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Post {
        title: Text.NonEmpty ("title-" ++ Text.fromInt n),
        body: "body-" ++ Text.fromInt n,
        author: me,
      }) (List.range 3 203)
    )
  let all <- Test.get (Admin.Tag.New {})
  let found <- Test.get (Admin.Tag.New { findPost: "title-203" })
  let r <- Test.submit FindPost { q: "zz" }
  let pick = Maybe.withDefault "" (Test.attr "value" "select[name=post] option" found.doc)
  let page <- Test.get (Admin.Tag.New {})
  let sent <- Test.submitRaw TagForm [{ name: "name", value: "x" }, { name: "post", value: pick }]
  let rows <- Db.from Tag |> Db.count
  Task.succeed (
    { answer: sent.answer, rows: rows }
      == {
        answer: FormRejected [{ field: "post", message: "must be one of the options" }],
        rows: 0,
      }
  )
}

test "a visitor is sent to log in" = {
  let r <- Test.open (Admin.Tag.New {})
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Reader gets no page, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Reader }
  let r <- Test.open (Admin.Tag.New {})
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Reader,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let r <- Test.open (Admin.Tag.New {})
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
