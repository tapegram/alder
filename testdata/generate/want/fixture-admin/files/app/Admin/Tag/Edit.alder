-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Tag.Edit

-- @admin begin imports
import Admin.Layout
import Post
import Tag
import User
-- @admin end

page "/admin/tag/{id}/edit" { id: Tag.TagId, findPost: Text = "" } requires user, role Admin

type Model = {
  row: Tag,
  -- @admin begin model
  posts: List Post,
  postsTotal: Int,
  -- @admin end
}

load : Params -> Session -> Query Model
load params session = {
  let admin <- Admin.Layout.isAdmin session.user
  if admin then {
    -- @admin begin load
    let found <- Db.get Tag params.id
    match found {
      Just row -> {
        let findPost = Text.slice 0 200 params.findPost
        let postsTotal <- Db.from Post |> Db.count
        let postsOwn <-
          if postsTotal > 200 then
            Db.from Post
              |> Db.where (Post.id.eq row.post)
              |> Db.all
          else
            Query.succeed []
        let postsFound <-
          Db.from Post
            |> Db.orderBy Post.title.asc
            |> Db.where (
              if postsTotal > 200 then
                Db.and [Post.title.contains findPost, Post.id.ne row.post]
              else
                Db.and []
            )
            |> Db.limit (if postsTotal > 200 then 50 else 200)
            |> Db.all
        let posts = postsOwn ++ postsFound
        Query.succeed {
          row: row,
          posts: posts,
          postsTotal: postsTotal,
        }
      },
      Nothing -> Query.notFound,
    }
    -- @admin end
  } else
    Query.notFound
}

-- @admin begin form
form TagForm = { name: Text.NonEmpty, post: Post.PostId }
-- @admin end

-- @admin begin search
form FindPost = { q: Text }

msg SearchPost form FindPost

-- @admin end

msg Save form TagForm

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  -- @admin begin finds
  SearchPost p ->
    Task.succeed (
      Redirect (Admin.Tag.Edit { id: model.row.id, findPost: Text.slice 0 200 p.form.q })
    ),
  -- @admin end
  Save p -> {
    -- @admin begin update
    let nameTaken <-
      Db.from Tag
        |> Db.where (Db.and [Tag.name.eq p.form.name, Tag.id.ne model.row.id])
        |> Db.count
    if nameTaken > 0 then
      Task.succeed (Reject "A tag with this name exists.")
    else {
      let _ <- Db.update Tag model.row.id (\row -> { row | name: p.form.name, post: p.form.post })
      Task.succeed (Redirect (Admin.Tag.Show { id: model.row.id }))
    }
    -- @admin end
  },
}

view : Model -> Session -> Html Msg
view model session =
  <Admin.Layout.Page title="Edit tag">
    <h1>Edit tag</h1>

    <al-card>
      -- @admin begin finder
      {if model.postsTotal > 200 then
        <form submit={SearchPost}>
          <al-input field="q" label="Find post" />
          <al-button type="submit" variant="secondary">Find</al-button>
        </form>
      else
        <span></span>}
      -- @admin end
      <form submit={Save}>
        -- @admin begin inputs
        <al-input field="name" label="Name" value={model.row.name} />
        <al-select
          field="post"
          label="Post"
          options={List.map (\r -> { value: r.id, label: r.title }) model.posts}
          value={model.row.post} />
        -- @admin end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Save</al-button>
      </form>
    </al-card>
    <a href={Admin.Tag.Show { id: model.row.id }}>Back</a>
  </Admin.Layout.Page>

-- @admin begin tests
test "saving changes every field" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let page <- Test.get (Admin.Tag.Edit { id: tag1 })
  let r <- Test.submit TagForm { name: Text.NonEmpty "name-2", post: post2 }
  let after <- Db.get Tag tag1
  Task.succeed (
    {
      answer: r.answer,
      row: Maybe.map (\row -> { name: row.name, post: row.post }) after,
      posts: Test.texts "select[name=post] option" page.doc,
    } == {
        answer: Redirected (Admin.Tag.Show { id: tag1 }),
        row: Just { name: Text.NonEmpty "name-2", post: post2 },
        posts: ["title-1", "title-2"],
      }
  )
}

test "saving a name another tag has is refused" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let _ <- Db.insert Tag { name: Text.NonEmpty "name-2", post: post1 }
  let before <- Db.get Tag tag1
  let _ <- Test.get (Admin.Tag.Edit { id: tag1 })
  let r <- Test.submit TagForm { name: Text.NonEmpty "name-2", post: post2 }
  let after <- Db.get Tag tag1
  Task.succeed (
    { answer: r.answer, row: after }
      == {
        answer: FormRejected [{ field: "", message: "A tag with this name exists." }],
        row: before,
      }
  )
}

test "a post not offered is refused" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let page <- Test.get (Admin.Tag.Edit { id: tag1 })
  let r <- Test.submitRaw TagForm [{ name: "name", value: "x" }, { name: "post", value: "missing" }]
  let after <- Db.get Tag tag1
  Task.succeed (
    { answer: r.answer, post: Maybe.map (\row -> row.post) after }
      == {
        answer: FormRejected [{ field: "post", message: "must be one of the options" }],
        post: Just post1,
      }
  )
}

test "a list of 200 posts is offered whole" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Post {
        title: Text.NonEmpty ("title-" ++ Text.fromInt n),
        body: "body-" ++ Text.fromInt n,
        author: me,
      }) (List.range 3 200)
    )
  let page <- Test.get (Admin.Tag.Edit { id: tag1 })
  Task.succeed (List.length page.model.posts == 200)
}

test "a long list of posts offers 50, and the search narrows it" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Post {
        title: Text.NonEmpty ("title-" ++ Text.fromInt n),
        body: "body-" ++ Text.fromInt n,
        author: me,
      }) (List.range 3 203)
    )
  let all <- Test.get (Admin.Tag.Edit { id: tag1 })
  let found <- Test.get (Admin.Tag.Edit { id: tag1, findPost: "title-203" })
  let r <- Test.submit FindPost { q: "zz" }
  Task.succeed (
    {
      shown: List.length all.model.posts,
      total: all.model.postsTotal,
      found: Test.count "select[name=post] option" found.doc <= 3,
      answer: r.answer,
    } == {
        shown: 51,
        total: 203,
        found: True,
        answer: Redirected (Admin.Tag.Edit { id: tag1, findPost: "zz" }),
      }
  )
}

test "the row's own post is offered first when it sorts past the 50" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "zz-1",
    body: "body-1",
    author: me,
  }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Post {
        title: Text.NonEmpty ("title-" ++ Text.fromInt n),
        body: "body-" ++ Text.fromInt n,
        author: me,
      }) (List.range 2 202)
    )
  let page <- Test.get (Admin.Tag.Edit { id: tag1 })
  let r <- Test.submit TagForm { name: page.model.row.name, post: page.model.row.post }
  let after <- Db.get Tag tag1
  Task.succeed (
    {
      answer: r.answer,
      kept: Maybe.map (\row -> row.post) after,
      first: Maybe.map (\o -> o.id) (List.head page.model.posts),
      once: List.length (List.filter (\o -> o.id == post1) page.model.posts),
      shown: List.length page.model.posts,
    } == {
        answer: Redirected (Admin.Tag.Show { id: tag1 }),
        kept: Just post1,
        first: Just post1,
        once: 1,
        shown: 51,
      }
  )
}

test "a missing row is not found" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let r <- Test.open (Admin.Tag.Edit { id: Tag.TagId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "a visitor is sent to log in" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let r <- Test.open (Admin.Tag.Edit { id: tag1 })
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Reader gets no page, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Reader }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let r <- Test.open (Admin.Tag.Edit { id: tag1 })
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Reader,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let r <- Test.open (Admin.Tag.Edit { id: tag1 })
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
