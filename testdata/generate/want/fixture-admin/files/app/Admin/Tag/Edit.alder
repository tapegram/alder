-- generated by `alder new admin` (alder v0.0.0-test); regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Tag.Edit

-- @admin begin imports
import Admin.Layout
import Post
import Tag
import User
-- @admin end

page "/admin/tag/{id}/edit" { id: Tag.TagId } requires user, role Admin

type Model = {
  row: Tag,
  -- @admin begin model
  posts: List Post,
  -- @admin end
}

load : Params -> Session -> Query Model
load params session = {
  -- @admin begin load
  let found <- Db.get Tag params.id
  let posts <- Db.from Post |> Db.orderBy Post.title.asc |> Db.all
  match found {
    Just row -> Query.succeed { row: row, posts: posts },
    Nothing -> Query.notFound,
  }
  -- @admin end
}

-- @admin begin form
form TagForm = {
  name: Text.NonEmpty,
  post: Post.PostId,
}
-- @admin end

msg Save form TagForm

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  Save p -> {
    -- @admin begin update
    let nameTaken <- Db.from Tag |> Db.where (Db.and [
      Tag.name.eq p.form.name,
      Tag.id.ne model.row.id,
    ]) |> Db.count
    if nameTaken > 0 then
      Task.succeed (Reject "A tag with this name exists.")
    else {
      let _ <- Db.update Tag model.row.id (\row -> { row | name: p.form.name, post: p.form.post })
      Task.succeed (Redirect (Admin.Tag.Show { id: model.row.id }))
    }
    -- @admin end
  },
}

view : Model -> Session -> Html Msg
view model session =
  <Admin.Layout.Page title="Edit tag">
    <h1>Edit tag</h1>

    <al-card>
      <form submit={Save}>
        -- @admin begin inputs
        <al-input field="name" label="Name" value={model.row.name} />
        <al-select field="post" label="Post" options={List.map (\r -> { value: r.id, label: r.title }) model.posts} value={model.row.post} />
        -- @admin end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Save</al-button>
      </form>
    </al-card>
    <a href={Admin.Tag.Show { id: model.row.id }}>Back</a>
  </Admin.Layout.Page>

-- @admin begin tests
test "saving changes every field" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post { title: Text.NonEmpty "title-1", body: "body-1", author: me }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let post2 <- Db.insert Post { title: Text.NonEmpty "title-2", body: "body-2", author: me }
  let page <- Test.get (Admin.Tag.Edit { id: tag1 })
  let r <- Test.submit TagForm { name: Text.NonEmpty "name-2", post: post2 }
  let after <- Db.get Tag tag1
  Task.succeed ({
    answer: r.answer,
    row: Maybe.map (\row -> { name: row.name, post: row.post }) after,
    posts: Test.texts "select[name=post] option" page.doc,
  } == {
    answer: Redirected (Admin.Tag.Show { id: tag1 }),
    row: Just { name: Text.NonEmpty "name-2", post: post2 },
    posts: ["title-1", "title-2"],
  })
}

test "saving a name another tag has is refused" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post { title: Text.NonEmpty "title-1", body: "body-1", author: me }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let post2 <- Db.insert Post { title: Text.NonEmpty "title-2", body: "body-2", author: me }
  let _ <- Db.insert Tag { name: Text.NonEmpty "name-2", post: post1 }
  let before <- Db.get Tag tag1
  let _ <- Test.get (Admin.Tag.Edit { id: tag1 })
  let r <- Test.submit TagForm { name: Text.NonEmpty "name-2", post: post2 }
  let after <- Db.get Tag tag1
  Task.succeed ({
    answer: r.answer,
    row: after,
  } == {
    answer: FormRejected [{ field: "", message: "A tag with this name exists." }],
    row: before,
  })
}

test "a post not offered is refused" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post { title: Text.NonEmpty "title-1", body: "body-1", author: me }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let post2 <- Db.insert Post { title: Text.NonEmpty "title-2", body: "body-2", author: me }
  let page <- Test.get (Admin.Tag.Edit { id: tag1 })
  let r <- Test.submitRaw TagForm [{ name: "name", value: "x" }, { name: "post", value: "missing" }]
  let after <- Db.get Tag tag1
  Task.succeed ({
    answer: r.answer,
    post: Maybe.map (\row -> row.post) after,
  } == {
    answer: FormRejected [{ field: "post", message: "must be one of the options" }],
    post: Just post1,
  })
}

test "a missing row is not found" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me, role: Admin }
  let r <- Test.open (Admin.Tag.Edit { id: Tag.TagId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "a visitor is sent to log in" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let post1 <- Db.insert Post { title: Text.NonEmpty "title-1", body: "body-1", author: me }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let r <- Test.open (Admin.Tag.Edit { id: tag1 })
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Reader gets no page" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me, role: Reader }
  let post1 <- Db.insert Post { title: Text.NonEmpty "title-1", body: "body-1", author: me }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let r <- Test.open (Admin.Tag.Edit { id: tag1 })
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
