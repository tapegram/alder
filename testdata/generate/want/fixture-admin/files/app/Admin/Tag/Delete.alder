-- generated by `alder new admin` (alder v0.0.0-test); regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Tag.Delete

-- @admin begin imports
import Admin.Layout
import Post
import Tag
import User
-- @admin end

page "/admin/tag/{id}/delete" { id: Tag.TagId } requires user, role Admin

-- The row, and how many rows of each table refer to it.
type Model = {
  row: Tag,
  -- @admin begin model
  -- @admin end
}

load : Params -> Session -> Query Model
load params session = {
  -- @admin begin load
  let found <- Db.get Tag params.id
  match found {
    Just row -> Query.succeed { row: row },
    Nothing -> Query.notFound,
  }
  -- @admin end
}

-- @admin begin blockers
-- blockers counts the rows that keep this one from being deleted, which the database would
-- refuse the delete for: the `@restrict` references to it, or to a row deleted with it.
blockers : Model -> Int
blockers model = 0
-- @admin end

-- Delete takes no input: the form is the button, and the place a refusal is shown.
form Confirm = { }

msg Remove form Confirm

-- Remove deletes the row, unless rows refer to it that keep it (load counted them, as it does
-- before every message): the database would refuse the delete with an error, and the page says
-- why instead.
update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  Remove p -> {
    -- @admin begin remove
    let _ <- Db.delete Tag model.row.id
    Task.succeed (Redirect (Admin.Tag.Index {}))
    -- @admin end
  },
}

view : Model -> Session -> Html Msg
view model session =
  <Admin.Layout.Page title="Delete tag">
    <h1>Delete this tag?</h1>

    <al-card>
      -- @admin begin row
      <p>{model.row.name}</p>
      -- @admin end
      <dl>
        -- @admin begin counts
        -- @admin end
      </dl>
      <form id="delete" submit={Remove}>
        <al-alert variant="destructive"><Errors form /></al-alert>
        {if blockers model > 0 then <p>It cannot be deleted while other rows refer to it.</p> else <al-button variant="destructive" type="submit">Delete</al-button>}
      </form>
    </al-card>
    <a href={Admin.Tag.Show { id: model.row.id }}>Back</a>
  </Admin.Layout.Page>

-- @admin begin tests
test "deleting a tag nothing refers to" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post { title: Text.NonEmpty "title-1", body: "body-1", author: me }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let _ <- Test.get (Admin.Tag.Delete { id: tag1 })
  let r <- Test.submit Confirm { }
  let gone <- Db.get Tag tag1
  Task.succeed ({
    answer: r.answer,
    gone: Maybe.map (\row -> row.id) gone,
  } == {
    answer: Redirected (Admin.Tag.Index {}),
    gone: Nothing,
  })
}

test "a missing row is not found" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me, role: Admin }
  let r <- Test.open (Admin.Tag.Delete { id: Tag.TagId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "a visitor is sent to log in" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let post1 <- Db.insert Post { title: Text.NonEmpty "title-1", body: "body-1", author: me }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let r <- Test.open (Admin.Tag.Delete { id: tag1 })
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Reader gets no page" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me, role: Reader }
  let post1 <- Db.insert Post { title: Text.NonEmpty "title-1", body: "body-1", author: me }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let r <- Test.open (Admin.Tag.Delete { id: tag1 })
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
