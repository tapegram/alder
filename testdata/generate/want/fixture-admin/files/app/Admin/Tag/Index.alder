-- generated by `alder new admin` (alder v0.0.0-test); regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Tag.Index

-- @admin begin imports
import Admin.Layout
import Post
import Tag
import User
-- @admin end

page "/admin/tag" { q: Text = "", sort: Text = "created", dir: Text = "desc", page: Int = 1 } requires user, role Admin

type Model = { rows: List Tag, q: Text, sort: Text, dir: Text, page: Int, pages: Int, count: Int }

perPage : Int
perPage = 25

-- lastPage bounds `page`, so `(page - 1) * perPage` cannot overflow.
lastPage : Int
lastPage = 1000000

-- @admin begin search
-- search is the rows whose text contains q (every row for "").
search : Text -> Condition Tag
search q = Db.or [Tag.name.contains q]
-- @admin end

-- @admin begin sorts
-- sorts are the columns the list sorts by, by name.
sorts : List { name: Text, asc: Order Tag, desc: Order Tag }
sorts = [
  { name: "name", asc: Tag.name.asc, desc: Tag.name.desc },
  { name: "post", asc: Tag.post.asc, desc: Tag.post.desc },
  { name: "created", asc: Tag.created.asc, desc: Tag.created.desc },
]
-- @admin end

-- order is the ordering sort names, ascending when dir is "asc"; a name that is not a column's
-- sorts newest first.
order : Text -> Text -> Order Tag
order sort dir = match List.find (\s -> s.name == sort) sorts {
  Just s -> if dir == "asc" then s.asc else s.desc,
  Nothing -> Tag.created.desc,
}

-- load reads one page of the rows that match the search, in the order asked for, and how many
-- match.
load : Params -> Session -> Query Model
load params session = {
  let page = Int.clamp { min: 1, max: lastPage } params.page
  let rows <-
    Db.from Tag
      |> Db.where (search params.q)
      |> Db.orderBy (order params.sort params.dir)
      |> Db.limit perPage
      |> Db.offset ((page - 1) * perPage)
      |> Db.all
  let count <- Db.from Tag |> Db.where (search params.q) |> Db.count
  Query.succeed { rows: rows, q: params.q, sort: params.sort, dir: params.dir, page: page, pages: Int.max 1 ((count + perPage - 1) / perPage), count: count }
}

view : Model -> Session -> Html Msg
view model session =
  <Admin.Layout.Page title="Tags">
    <h1>Tags</h1>

    <al-stack direction="row" gap="sm">
      <form method="get" action="/admin/tag">
        <input type="search" name="q" value={model.q} aria-label="Search" />
        <input type="hidden" name="sort" value={model.sort} />
        <input type="hidden" name="dir" value={model.dir} />
      </form>
      <al-button href={Admin.Tag.New {}}>New tag</al-button>
    </al-stack>

    <p id="count">{Text.fromInt model.count} rows</p>

    <al-table>
      <table>
        <thead>
          <tr>
            -- @admin begin headers
            <th><a href={Admin.Tag.Index { q: model.q, sort: "name", dir: if model.sort == "name" && model.dir == "asc" then "desc" else "asc" }}>Name</a></th>
            <th><a href={Admin.Tag.Index { q: model.q, sort: "post", dir: if model.sort == "post" && model.dir == "asc" then "desc" else "asc" }}>Post</a></th>
            <th><a href={Admin.Tag.Index { q: model.q, sort: "created", dir: if model.sort == "created" && model.dir == "asc" then "desc" else "asc" }}>Created</a></th>
            -- @admin end
          </tr>
        </thead>
        <tbody>
          {for row in model.rows ->
            <tr>
              -- @admin begin cells
              <td><a href={Admin.Tag.Show { id: row.id }}>{row.name}</a></td>
              <td><a href={Admin.Post.Show { id: row.post }}>{row.post}</a></td>
              <td>{Time.format "Jan 2, 2006" row.created}</td>
              -- @admin end
            </tr>}
        </tbody>
      </table>
    </al-table>

    <al-pagination role="navigation" aria-label="Pages">
      {if model.page > 1 then <a slot="prev" href={Admin.Tag.Index { q: model.q, sort: model.sort, dir: model.dir, page: model.page - 1 }} rel="prev">Previous</a> else <span slot="prev" aria-disabled="true">Previous</span>}
      <span>Page {Text.fromInt model.page} of {Text.fromInt model.pages}</span>
      {if model.page < model.pages then <a slot="next" href={Admin.Tag.Index { q: model.q, sort: model.sort, dir: model.dir, page: model.page + 1 }} rel="next">Next</a> else <span slot="next" aria-disabled="true">Next</span>}
    </al-pagination>
  </Admin.Layout.Page>

-- @admin begin tests
test "the list shows every row, newest first" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post { title: Text.NonEmpty "title-1", body: "body-1", author: me }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let tag2 <- Db.insert Tag { name: Text.NonEmpty "name-2", post: post1 }
  let page <- Test.get (Admin.Tag.Index {})
  Task.succeed (List.map (\row -> row.id) page.model.rows == [tag2, tag1])
}

test "sorting by name goes both ways" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post { title: Text.NonEmpty "title-1", body: "body-1", author: me }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-2", post: post1 }
  let tag2 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let up <- Test.get (Admin.Tag.Index { sort: "name", dir: "asc" })
  let down <- Test.get (Admin.Tag.Index { sort: "name" })
  Task.succeed ({ up: List.map (\row -> row.id) up.model.rows, down: List.map (\row -> row.id) down.model.rows } == { up: [tag2, tag1], down: [tag1, tag2] })
}

test "searching finds the rows that contain the text" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post { title: Text.NonEmpty "title-1", body: "body-1", author: me }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let tag2 <- Db.insert Tag { name: Text.NonEmpty "name-2", post: post1 }
  let page <- Test.get (Admin.Tag.Index { q: "name-2" })
  Task.succeed ({ rows: List.map (\row -> row.id) page.model.rows, count: page.model.count } == { rows: [tag2], count: 1 })
}

test "the list has 25 rows a page" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post { title: Text.NonEmpty "title-1", body: "body-1", author: me }
  let _ <- Task.all (List.map (\n -> Db.insert Tag { name: Text.NonEmpty ("name-" ++ Text.fromInt n), post: post1 }) (List.range 1 26))
  let first <- Test.get (Admin.Tag.Index {})
  let second <- Test.get (Admin.Tag.Index { page: 2 })
  Task.succeed ({ first: List.length first.model.rows, second: List.length second.model.rows, pages: Test.texts "al-pagination span" first.doc } == { first: 25, second: 1, pages: ["Previous", "Page 1 of 2"] })
}

test "a visitor is sent to log in" = {
  let r <- Test.open (Admin.Tag.Index {})
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Reader gets no page" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me, role: Reader }
  let r <- Test.open (Admin.Tag.Index {})
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
