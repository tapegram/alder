module Tag

import Entry

type TagId = brand Text

table Tag {
  id: TagId @id,
  name: Text.NonEmpty @unique,
  entry: Entry.EntryId @ref Entry @cascade,
  note: Maybe Text,
  pinned: Bool = False,
  created: Time @created,
  updated: Time @updated,
}

test "deleting its entry deletes a Tag" = {
  let target <- Db.insert Entry { name: Text.NonEmpty "name-1", message: Text.NonEmpty "message-1" }
  let _ <- Db.insert Tag {
    name: Text.NonEmpty "name-1",
    entry: target,
    note: Nothing,
  }
  let _ <- Db.delete Entry target
  let left <- Db.from Tag |> Db.count
  Task.succeed (left == 0)
}
