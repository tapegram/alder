module Posts.Index

import Layout
import Table.Post
import Table.User

route Index       = GET  "/posts"               { page: Int = 1 } requires user
route SubmitQuick = POST "/posts/_/SubmitQuick" { } form Quick    requires user

type Model = {
  rows: List Post,
  page: Int,
  pages: Int,
}

perPage : Int
perPage = 20

-- lastPage bounds `page`, so `(page - 1) * perPage` cannot overflow.
lastPage : Int
lastPage = 1000000

-- Index.load reads one page of the rows, newest first, and how many pages there are.
Index.load : Index.Params -> Session -> Query Model
Index.load params session = {
  let page = Int.clamp { min: 1, max: lastPage } params.page
  let rows <-
    Db.mine Post
      |> Db.orderBy Post.created.desc
      |> Db.limit perPage
      |> Db.offset ((page - 1) * perPage)
      |> Db.all
  let count <- Db.mine Post |> Db.count
  Query.succeed {
    rows: rows,
    page: page,
    pages: Int.max 1 ((count + perPage - 1) / perPage),
  }
}

Index.view : Model -> Session -> Html
Index.view model session =
  <Layout.Page title="Posts">
    <h1>Posts</h1>

    <al-table>
      <table>
        <thead>
          <tr>
            <th>Title</th>
            <th>Body</th>
            <th>Status</th>
            <th>Featured</th>
            <th>Author</th>
            <th>Created</th>
            <th>Updated</th>
          </tr>
        </thead>
        <tbody>
          {for row in model.rows ->
            <tr>
              <td>{row.title}</td>
              <td>{row.body}</td>
              <td>
                <al-badge>
                  {match row.status {
                    Draft -> "Draft",
                    Published -> "Published",
                  }}
                </al-badge>
              </td>
              <td>
                {if row.featured then
                  <al-badge>Yes</al-badge>
                else
                  <al-badge variant="secondary">No</al-badge>}
              </td>
              <td>{row.author}</td>
              <td>{Time.format "Jan 2, 2006" row.created}</td>
              <td>{Time.format "Jan 2, 2006" row.updated}</td>
            </tr>}
        </tbody>
      </table>
    </al-table>

    <al-pagination role="navigation" aria-label="Pages">
      {if model.page > 1 then
        <a slot="prev" href={Index { page: model.page - 1 }} rel="prev">Previous</a>
      else
        <span slot="prev" aria-disabled="true">Previous</span>}
      <span>Page {Text.fromInt model.page} of {Text.fromInt model.pages}</span>
      {if model.page < model.pages then
        <a slot="next" href={Index { page: model.page + 1 }} rel="next">Next</a>
      else
        <span slot="next" aria-disabled="true">Next</span>}
    </al-pagination>

    <al-card>
      <h2 slot="header">Quick</h2>
      <form submit={SubmitQuick}>
        <al-input field="title" label="Title" />
        <al-textarea field="body" label="Body" />
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Quick</al-button>
      </form>
    </al-card>
  </Layout.Page>

form Quick = { title: Text.NonEmpty, body: Text }

SubmitQuick.update : SubmitQuick.Params -> Session -> Task Response
SubmitQuick.update params session = {
  let _ <- Db.insertMine Post { title: params.form.title, body: params.form.body }
  Task.succeed (Response.redirect (Index {}) |> Response.success "Saved")
}

test "the list shows my rows, newest first" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let other <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let post3 <- Db.insert Post {
    title: Text.NonEmpty "title-3",
    body: "body-3",
    author: other,
  }
  let page <- Test.get (Index {})
  Task.succeed (List.map (\row -> row.id) page.model.rows == [post2, post1])
}

test "the list has 20 rows a page" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Post {
        title: Text.NonEmpty ("title-" ++ Text.fromInt n),
        body: "body-" ++ Text.fromInt n,
        author: me,
      }) (List.range 1 21)
    )
  let other <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Post {
        title: Text.NonEmpty ("title-" ++ Text.fromInt n),
        body: "body-" ++ Text.fromInt n,
        author: other,
      }) (List.range 22 41)
    )
  let first <- Test.get (Index {})
  let second <- Test.get (Index { page: 2 })
  Task.succeed (
    {
      first: List.length first.model.rows,
      second: List.length second.model.rows,
      pages: Test.texts "al-pagination span" first.doc,
    } == {
      first: 20,
      second: 1,
      pages: ["Previous", "Page 1 of 2"],
    }
  )
}

test "a visitor is sent to log in" = {
  let r <- Test.open (Index {})
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "submitting Quick adds a row" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Index {})
  let r <- Test.submit SubmitQuick { title: Text.NonEmpty "title-1", body: "body-1" }
  let rows <- Db.from Post |> Db.all
  Task.succeed (
    {
      answer: r.answer,
      rows: List.map (\row -> {
        title: row.title,
        body: row.body,
        status: row.status,
        featured: row.featured,
      }) rows,
    } == {
      answer: Redirected (Index {}),
      rows: [
        {
          title: Text.NonEmpty "title-1",
          body: "body-1",
          status: Draft,
          featured: False,
        },
      ],
    }
  )
}

test "Quick refuses an empty title" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Index {})
  let r <- Test.submitRaw SubmitQuick [{ name: "title", value: "" }, { name: "body", value: "x" }]
  let rows <- Db.from Post |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows }
      == { answer: FormRejected [{ field: "title", message: "must not be empty" }], rows: 0 }
  )
}
