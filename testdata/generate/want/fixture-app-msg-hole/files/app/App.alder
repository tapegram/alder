module App

import Layout
import Table.User

-- The fixture of the generators' tests (cmd/alder/generate_test.go): a session with a user and
-- a role, copied from the user's row when they log in (Auth.Login).
session { user: Maybe User.UserId, role: User.Role = Reader }

login = Auth.Login.Login

route Logout = POST "/_/Logout" { }
route Ping   = POST "/ping"     { }

Logout.update : Logout.Params -> Session -> Task Response
Logout.update p session = {
  let _ <- Session.put (\s -> { s | user: Nothing, role: Reader })
  Task.succeed (Response.redirect (Auth.Login.Login {}))
}

error : Error -> Html
error err =
  <Layout.Page title="Error">
    <h1>Something went wrong</h1>
    <p>Please try again.</p>
  </Layout.Page>

notFound : Html
notFound = <Layout.Page title="Not found"><h1>Not found</h1></Layout.Page>

-- Press Ping from a page that has its button to test it: `Test.get` that page, then
-- `Test.click App.Ping`, and `r.answer` is Refreshed until `update` says otherwise.
Ping.update : Ping.Params -> Session -> Task Response
Ping.update params session = Task.succeed Response.refresh

-- From a page that `requires user` a refresh ends at the login page too; only a test of
-- `Logout.update` itself tells a redirect from a refresh.
test "Logout goes to log in" = {
  let r <- Test.run (Logout.update {} { user: Just (User.UserId "me"), role: Admin })
  Task.succeed (r.value == Ok (Response.redirect (Auth.Login.Login {})))
}
