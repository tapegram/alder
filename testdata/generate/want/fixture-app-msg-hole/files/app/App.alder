module App

import Layout
import User

-- The fixture of the generators' tests (cmd/alder/generate_test.go): a session with a user and
-- a role, copied from the user's row when they log in (Auth.Login).
session { user: Maybe User.UserId, role: User.Role = Reader }

login = Auth.Login

msg Logout

msg Ping

update : Msg -> Session -> Task Nav
update msg session = match msg {
  Logout p -> {
    let _ <- Session.put (\s -> { s | user: Nothing, role: Reader })
    Task.succeed (Redirect (Auth.Login {}))
  },
  Ping p -> ?ping,
}

error : Error -> Html Never
error err =
  <Layout.Page title="Error">
    <h1>Something went wrong</h1>
    <p>Please try again.</p>
  </Layout.Page>

notFound : Html Never
notFound = <Layout.Page title="Not found"><h1>Not found</h1></Layout.Page>

-- From a page that `requires user` a Rerender ends at the login page too; only a test of
-- `update` itself tells Redirect from Rerender.
test "Logout goes to log in" = {
  let r <- Test.run (update Logout { user: Just (User.UserId "me"), role: Admin })
  Task.succeed (r.value == Ok (Redirect (Auth.Login {})))
}

-- A message of App is sent from any page (`click={App.Ping}`), so the test calls update itself.
-- Fill ?expected with what Ping must do, as `{ value: r.value, trace: r.trace } ==
-- { value: Ok Rerender, trace: ["Session.put"] }`: its answer and the effects it ran.
test "pressing Ping" = {
  let r <- Test.run (update Ping { user: Nothing, role: Reader })
  Task.succeed ?expected
}
