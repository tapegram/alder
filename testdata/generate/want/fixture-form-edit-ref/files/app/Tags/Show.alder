module Tags.Show

import Layout
import Table.Post
import Table.Tag
import Table.User

route Show        = GET "/tags/{id}" { id: Tag.TagId, findPost: Text = "" } requires user
route SaveTagEdit = PUT "/tags/{id}" { id: Tag.TagId } form TagEdit         requires user

type Model = {
  row: Tag,
  posts: List Post,
  postsTotal: Int,
  findPost: Text,
}

Show.load : Show.Params -> Session -> Query Model
Show.load params session = {
  let found <- Db.get Tag params.id
  match found {
    Just row -> {
      let findPost = Text.slice 0 200 params.findPost
      let postsTotal <- Db.mine Post |> Db.count
      let postsOwn <-
        if postsTotal > 200 then
          Db.mine Post
            |> Db.where (Post.id.eq row.post)
            |> Db.all
        else
          Query.succeed []
      let postsFound <-
        Db.mine Post
          |> Db.orderBy Post.title.asc
          |> Db.where (
            if postsTotal > 200 then
              Db.and [Post.title.contains findPost, Post.id.ne row.post]
            else
              Db.and []
          )
          |> Db.limit (if postsTotal > 200 then 50 else 200)
          |> Db.all
      let posts = postsOwn ++ postsFound
      Query.succeed {
        row: row,
        posts: posts,
        postsTotal: postsTotal,
        findPost: findPost,
      }
    },
    Nothing -> Query.notFound,
  }
}

Show.view : Model -> Session -> Html
Show.view model session =
  <Layout.Page title="Tag">
    <h1>Tag</h1>

    <al-card>
      <dl>
        <dt>Id</dt>
        <dd>{model.row.id}</dd>
        <dt>Name</dt>
        <dd>{model.row.name}</dd>
        <dt>Post</dt>
        <dd>{model.row.post}</dd>
        <dt>Created</dt>
        <dd>{Time.format "Jan 2, 2006" model.row.created}</dd>
      </dl>
      {if model.postsTotal > 200 then
        <form method="get" action={"/tags/" ++ model.row.id}>
          <al-input>
            <label>Find post <input type="search" name="findPost" value={model.findPost} /></label>
          </al-input>
          <al-button type="submit" variant="secondary">Find</al-button>
        </form>
      else
        Html.none}
      <form submit={SaveTagEdit { id: model.row.id }}>
        <al-input field="name" label="Name" value={model.row.name} />
        <al-select
          field="post"
          label="Post"
          options={List.map (\r -> { value: r.id, label: r.title }) model.posts}
          value={model.row.post} />
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Tag edit</al-button>
      </form>
    </al-card>
  </Layout.Page>

form TagEdit = { name: Text.NonEmpty, post: Post.PostId }

-- SaveTagEdit writes the form over the row and goes back to the page;
-- a row deleted since is not found.
SaveTagEdit.update : SaveTagEdit.Params -> Session -> Task Response
SaveTagEdit.update params session = {
  let found <- Db.get Tag params.id
  match found {
    Just row -> {
      let nameTaken <-
        Db.from Tag
          |> Db.where (Db.and [Tag.name.eq params.form.name, Tag.id.ne row.id])
          |> Db.count
      if nameTaken > 0 then
        Task.succeed (Response.invalid "A tag with this name exists.")
      else {
        let _ <- Db.update Tag row.id (\r -> { r | name: params.form.name, post: params.form.post })
        Task.succeed (Response.redirect (Show { id: params.id }) |> Response.success "Saved")
      }
    },
    Nothing -> Task.notFound,
  }
}

test "the page shows the row" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let r <- Test.open (Show { id: tag1 })
  Task.succeed (
    { answer: r.answer, name: List.member "name-1" (Test.texts "dd" r.doc) }
      == { answer: Shown, name: True }
  )
}

test "a missing row is not found" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let r <- Test.open (Show { id: Tag.TagId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "a visitor is sent to log in" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let r <- Test.open (Show { id: tag1 })
  Task.succeed (r.answer == Redirected (Auth.Login.Login {}))
}

test "saving TagEdit changes every field" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let other <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let _ <- Db.insert Post {
    title: Text.NonEmpty "title-3",
    body: "body-3",
    author: other,
  }
  let page <- Test.get (Show { id: tag1 })
  let r <- Test.submit (SaveTagEdit { id: tag1 }) { name: Text.NonEmpty "name-2", post: post2 }
  let after <- Db.get Tag tag1
  Task.succeed (
    {
      answer: r.answer,
      notices: r.notices,
      row: Maybe.map (\row -> { name: row.name, post: row.post }) after,
      posts: Test.texts "select[name=post] option" page.doc,
    } == {
      answer: Redirected (Show { id: tag1 }),
      notices: ["Saved"],
      row: Just { name: Text.NonEmpty "name-2", post: post2 },
      posts: ["title-1", "title-2"],
    }
  )
}

test "a required field left empty in TagEdit is rejected" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let before <- Db.get Tag tag1
  let page <- Test.get (Show { id: tag1 })
  let postId = Maybe.withDefault "" (Test.attr "value" "select[name=post] option" page.doc)
  let r <- Test.submitRaw (SaveTagEdit { id: tag1 }) [
    { name: "name", value: "" },
    { name: "post", value: postId },
  ]
  let after <- Db.get Tag tag1
  Task.succeed (
    { answer: r.answer, row: after }
      == { answer: FormRejected [{ field: "name", message: "must not be empty" }], row: before }
  )
}

test "saving a name another tag has is refused" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let _ <- Db.insert Tag { name: Text.NonEmpty "name-2", post: post1 }
  let before <- Db.get Tag tag1
  let _ <- Test.get (Show { id: tag1 })
  let r <- Test.submit (SaveTagEdit { id: tag1 }) { name: Text.NonEmpty "name-2", post: post2 }
  let after <- Db.get Tag tag1
  Task.succeed (
    { answer: r.answer, row: after }
      == {
        answer: FormRejected [{ field: "", message: "A tag with this name exists." }],
        row: before,
      }
  )
}

test "a post not offered is refused" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let page <- Test.get (Show { id: tag1 })
  let r <- Test.submitRaw (SaveTagEdit { id: tag1 }) [
    { name: "name", value: "x" },
    { name: "post", value: "missing" },
  ]
  let after <- Db.get Tag tag1
  Task.succeed (
    { answer: r.answer, post: Maybe.map (\row -> row.post) after }
      == {
        answer: FormRejected [{ field: "post", message: "must be one of the options" }],
        post: Just post1,
      }
  )
}

test "a list of 200 posts is offered whole" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Post {
        title: Text.NonEmpty ("title-" ++ Text.fromInt n),
        body: "body-" ++ Text.fromInt n,
        author: me,
      }) (List.range 3 200)
    )
  let other <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let _ <- Db.insert Post {
    title: Text.NonEmpty "title-201",
    body: "body-201",
    author: other,
  }
  let page <- Test.get (Show { id: tag1 })
  Task.succeed (List.length page.model.posts == 200)
}

test "a long list of posts offers 50, and the search narrows it" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Post {
        title: Text.NonEmpty ("title-" ++ Text.fromInt n),
        body: "body-" ++ Text.fromInt n,
        author: me,
      }) (List.range 3 203)
    )
  let all <- Test.get (Show { id: tag1 })
  let found <- Test.get (Show { id: tag1, findPost: "title-203" })
  Task.succeed (
    {
      shown: List.length all.model.posts,
      total: all.model.postsTotal,
      found: Test.count "select[name=post] option" found.doc <= 3,
      input: Test.attr "value" "input[name=findPost]" found.doc,
    } == {
      shown: 51,
      total: 203,
      found: True,
      input: Just "title-203",
    }
  )
}

test "the row's own post is offered first when it sorts past the 50" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "zz-1",
    body: "body-1",
    author: me,
  }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Post {
        title: Text.NonEmpty ("title-" ++ Text.fromInt n),
        body: "body-" ++ Text.fromInt n,
        author: me,
      }) (List.range 2 202)
    )
  let page <- Test.get (Show { id: tag1 })
  let r <- Test.submit (SaveTagEdit { id: tag1 }) {
    name: page.model.row.name,
    post: page.model.row.post,
  }
  let after <- Db.get Tag tag1
  Task.succeed (
    {
      answer: r.answer,
      kept: Maybe.map (\row -> row.post) after,
      first: Maybe.map (\o -> o.id) (List.head page.model.posts),
      once: List.length (List.filter (\o -> o.id == post1) page.model.posts),
      shown: List.length page.model.posts,
    } == {
      answer: Redirected (Show { id: tag1 }),
      kept: Just post1,
      first: Just post1,
      once: 1,
      shown: 51,
    }
  )
}

test "another user's post the row refers to is not offered" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let other <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "zz-1",
    body: "body-1",
    author: other,
  }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Post {
        title: Text.NonEmpty ("title-" ++ Text.fromInt n),
        body: "body-" ++ Text.fromInt n,
        author: me,
      }) (List.range 2 202)
    )
  let page <- Test.get (Show { id: tag1 })
  Task.succeed (
    {
      offered: List.length (List.filter (\o -> o.id == post1) page.model.posts),
      shown: List.length page.model.posts,
    }
      == { offered: 0, shown: 50 }
  )
}

test "a visitor cannot submit TagEdit" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let before <- Db.get Tag tag1
  let _ <- Test.get (Show { id: tag1 })
  let _ <- Test.login { user: Nothing }
  let r <- Test.submit (SaveTagEdit { id: tag1 }) { name: Text.NonEmpty "name-2", post: post2 }
  let after <- Db.get Tag tag1
  Task.succeed (
    { answer: r.answer, row: after } == { answer: Redirected (Auth.Login.Login {}), row: before }
  )
}
