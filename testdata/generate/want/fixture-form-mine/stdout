+
+test "submitting Quick adds a row" = {
+  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
+  let _ <- Test.login { user: Just me }
+  let _ <- Test.get (Home {})
+  let r <- Test.submit Quick { title: Text.NonEmpty "title-1", body: "body-1" }
+  let rows <- Db.from Post |> Db.all
+  Task.succeed ({ answer: r.answer, rows: List.map (\row -> { title: row.title, body: row.body, status: row.status, featured: row.featured }) rows } == { answer: Redirected (Home {}), rows: [{ title: Text.NonEmpty "title-1", body: "body-1", status: Draft, featured: False }] })
+}
+
+test "Quick refuses an empty title" = {
+  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
+  let _ <- Test.login { user: Just me }
+  let _ <- Test.get (Home {})
+  let r <- Test.submitRaw Quick [{ name: "title", value: "" }, { name: "body", value: "x" }]
+  let rows <- Db.from Post |> Db.count
