module Posts.Index

import Layout
import Post
import User

page "/posts" { page: Int = 1 } requires user

type Model = { rows: List Post, page: Int, pages: Int }

perPage : Int
perPage = 20

-- load reads one page of the rows, newest first, and how many pages there are.
load : Params -> Session -> Query Model
load params session = {
  let page = Int.max 1 params.page
  let rows <-
    Db.mine Post
      |> Db.orderBy Post.created.desc
      |> Db.limit perPage
      |> Db.offset ((page - 1) * perPage)
      |> Db.all
  let count <- Db.mine Post |> Db.count
  Query.succeed { rows: rows, page: page, pages: Int.max 1 ((count + perPage - 1) / perPage) }
}

view : Model -> Session -> Html Msg
view model session =
  <Layout.Page title="Posts">
    <h1>Posts</h1>

    <al-table>
      <table>
        <thead>
          <tr><th>Title</th><th>Body</th><th>Status</th><th>Featured</th><th>Author</th><th>Created</th><th>Updated</th></tr>
        </thead>
        <tbody>
          {for row in model.rows ->
            <tr>
              <td>{row.title}</td>
              <td>{row.body}</td>
              <td><al-badge>{match row.status { Draft -> "Draft", Published -> "Published" }}</al-badge></td>
              <td>{if row.featured then <al-badge>Yes</al-badge> else <al-badge variant="secondary">No</al-badge>}</td>
              <td>{row.author}</td>
              <td>{Time.format "Jan 2, 2006" row.created}</td>
              <td>{Time.format "Jan 2, 2006" row.updated}</td>
            </tr>}
        </tbody>
      </table>
    </al-table>

    <al-pagination role="navigation" aria-label="Pages">
      {if model.page > 1 then <a slot="prev" href={Posts.Index { page: model.page - 1 }} rel="prev">Previous</a> else <span slot="prev" aria-disabled="true">Previous</span>}
      <span>Page {Text.fromInt model.page} of {Text.fromInt model.pages}</span>
      {if model.page < model.pages then <a slot="next" href={Posts.Index { page: model.page + 1 }} rel="next">Next</a> else <span slot="next" aria-disabled="true">Next</span>}
    </al-pagination>
  </Layout.Page>

test "the list shows every row" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let _ <- Db.insert Post { title: Text.NonEmpty "title-1", body: "body-1", author: me }
  let _ <- Db.insert Post { title: Text.NonEmpty "title-2", body: "body-2", author: me }
  let r <- Test.open (Posts.Index {})
  Task.succeed ({ answer: r.answer, rows: Test.count "al-table tbody tr" r.doc } == { answer: Shown, rows: 2 })
}
