-- generated by `alder new resource Post --module Posts --path /posts --read signed-in`; regions between
-- `-- @resource begin <name>` / `-- @resource end` are rewritten by `alder regen resource`
module Posts.New

-- @resource begin imports
import Layout
import Table.Post
import Table.User
-- @resource end

-- @resource begin routes
route New    = GET  "/posts/new" { }               requires user
route Create = POST "/posts"     { } form PostForm requires user
-- @resource end

type Model = {
  -- @resource begin model
  -- @resource end
}

New.load : New.Params -> Session -> Query Model
New.load params session = {
  -- @resource begin load
  Query.succeed {}
  -- @resource end
}

-- @resource begin form
form PostForm = {
  title: Text.NonEmpty,
  body: Text,
  status: Post.Status,
  featured: Bool,
}
-- @resource end

-- @resource begin search
-- @resource end

-- Create adds the row and goes to its page.
Create.update : Create.Params -> Session -> Task Response
Create.update params session = {
  -- @resource begin insert
  let id <- Db.insertMine Post {
    title: params.form.title,
    body: params.form.body,
    status: params.form.status,
    featured: params.form.featured,
  }
  Task.succeed (Response.redirect (Posts.Show.Show { id: id }))
  -- @resource end
}

New.view : Model -> Session -> Html
New.view model session =
  <Layout.Page title="New post">
    <h1>New post</h1>

    <al-card>
      -- @resource begin finder
      -- @resource end
      <form submit={Create}>
        -- @resource begin inputs
        <al-input field="title" label="Title" />
        <al-textarea field="body" label="Body" />
        <al-select field="status" label="Status" value={Draft} />
        <al-checkbox field="featured" label="Featured" value={False} />
        -- @resource end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Create</al-button>
      </form>
    </al-card>
  </Layout.Page>

-- @resource begin tests
test "creating adds a row that is mine" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let page <- Test.get (New {})
  let r <- Test.submit Create {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    status: Published,
    featured: True,
  }
  let rows <- Db.from Post |> Db.all
  Task.succeed (
    {
      answers: List.map (\row -> Redirected (Posts.Show.Show { id: row.id })) rows,
      rows: List.map (\row -> {
        title: row.title,
        body: row.body,
        status: row.status,
        featured: row.featured,
        author: row.author,
      }) rows,
    } == {
      answers: [r.answer],
      rows: [
        {
          title: Text.NonEmpty "title-1",
          body: "body-1",
          status: Published,
          featured: True,
          author: me,
        },
      ],
    }
  )
}

test "an empty title is rejected" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let page <- Test.get (New {})
  let r <- Test.submitRaw Create [
    { name: "title", value: "" },
    { name: "body", value: "x" },
    { name: "status", value: "Draft" },
    { name: "featured", value: "True" },
  ]
  let rows <- Db.from Post |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows }
      == { answer: FormRejected [{ field: "title", message: "must not be empty" }], rows: 0 }
  )
}

test "a visitor cannot create a post" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (New {})
  let _ <- Test.login { user: Nothing }
  let r <- Test.submit Create {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    status: Published,
    featured: True,
  }
  let rows <- Db.from Post |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows } == { answer: Redirected (Auth.Login.Login {}), rows: 0 }
  )
}

test "a visitor is sent to log in" = {
  let r <- Test.open (New {})
  Task.succeed (r.answer == Redirected (Auth.Login.Login {}))
}
-- @resource end
