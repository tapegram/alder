-- generated by `alder new resource BlogPost --module BlogPosts --path /blog-posts --read owner`; regions between
-- `-- @resource begin <name>` / `-- @resource end` are rewritten by `alder regen resource`
module BlogPosts.Edit

-- @resource begin imports
import Layout
import Table.BlogPost
import Table.Post
import Table.User
-- @resource end

-- @resource begin routes
route Edit = GET "/blog-posts/{id}/edit" { id: BlogPost.BlogPostId, findPost: Text = "" } requires user
route Save = PUT "/blog-posts/{id}"      { id: BlogPost.BlogPostId } form BlogPostForm    requires user
-- @resource end

type Model = {
  row: BlogPost,
  -- @resource begin model
  posts: List Post,
  postsTotal: Int,
  findPost: Text,
  -- @resource end
}

Edit.load : Edit.Params -> Session -> Query Model
Edit.load params session = {
  -- @resource begin load
  let row <- Db.getMine BlogPost params.id
  let findPost = Text.slice 0 200 params.findPost
  let postsTotal <- Db.mine Post |> Db.count
  let postsOwn <-
    if postsTotal > 200 then
      Db.mine Post
        |> Db.where (Post.id.in (List.filterMap (\i -> i) [row.post]))
        |> Db.all
    else
      Query.succeed []
  let postsFound <-
    Db.mine Post
      |> Db.orderBy Post.title.asc
      |> Db.where (
        if postsTotal > 200 then
          Db.and [
            Post.title.contains findPost,
            Db.not (Post.id.in (List.filterMap (\i -> i) [row.post])),
          ]
        else
          Db.and []
      )
      |> Db.limit (if postsTotal > 200 then 50 else 200)
      |> Db.all
  let posts = postsOwn ++ postsFound
  Query.succeed {
    row: row,
    posts: posts,
    postsTotal: postsTotal,
    findPost: findPost,
  }
  -- @resource end
}

-- @resource begin form
form BlogPostForm = {
  title: Text,
  body: Text,
  post: Maybe Post.PostId,
}
-- @resource end

-- @resource begin search
-- @resource end

-- Save writes the form over the row (another user's, or one deleted since, is not found) and goes
-- to its page.
Save.update : Save.Params -> Session -> Task Response
Save.update params session = {
  -- @resource begin update
  let _ <- Db.updateMine BlogPost params.id (\r -> { r |
    title: params.form.title,
    body: params.form.body,
    post: params.form.post
  })
  Task.succeed (Response.redirect (BlogPosts.Show.Show { id: params.id }))
  -- @resource end
}

Edit.view : Model -> Session -> Html
Edit.view model session =
  <Layout.Page title="Edit blog post">
    <h1>Edit blog post</h1>

    <al-card>
      -- @resource begin finder
      {if model.postsTotal > 200 then
        <form method="get" action={"/blog-posts/" ++ model.row.id ++ "/edit"}>
          <al-input>
            <label>Find post <input type="search" name="findPost" value={model.findPost} /></label>
          </al-input>
          <al-button type="submit" variant="secondary">Find</al-button>
        </form>
      else
        Html.none}
      -- @resource end
      <form submit={Save { id: model.row.id }}>
        -- @resource begin inputs
        <al-input field="title" label="Title" value={model.row.title} />
        <al-textarea field="body" label="Body" value={model.row.body} />
        <al-select
          field="post"
          label="Post"
          options={List.map (\r -> { value: r.id, label: r.title }) model.posts}
          value={model.row.post} />
        -- @resource end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Save</al-button>
      </form>
    </al-card>
    <a href={BlogPosts.Show.Show { id: model.row.id }}>Back</a>
  </Layout.Page>

-- @resource begin tests
test "saving changes every field" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let blogPost1 <- Db.insert BlogPost {
    title: "title-1",
    body: "body-1",
    owner: me,
    reviewer: Nothing,
    post: Nothing,
  }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let other <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let _ <- Db.insert Post {
    title: Text.NonEmpty "title-3",
    body: "body-3",
    author: other,
  }
  let page <- Test.get (Edit { id: blogPost1 })
  let r <- Test.submit (Save { id: blogPost1 }) {
    title: "title-2",
    body: "body-2",
    post: Just post2,
  }
  let after <- Db.get BlogPost blogPost1
  Task.succeed (
    {
      answer: r.answer,
      row: Maybe.map (\row -> {
        title: row.title,
        body: row.body,
        post: row.post,
      }) after,
      posts: Test.texts "select[name=post] option" page.doc,
    } == {
      answer: Redirected (BlogPosts.Show.Show { id: blogPost1 }),
      row: Just {
        title: "title-2",
        body: "body-2",
        post: Just post2,
      },
      posts: ["", "title-1", "title-2"],
    }
  )
}

test "a post not offered is refused" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let blogPost1 <- Db.insert BlogPost {
    title: "title-1",
    body: "body-1",
    owner: me,
    reviewer: Nothing,
    post: Nothing,
  }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let page <- Test.get (Edit { id: blogPost1 })
  let r <- Test.submitRaw (Save { id: blogPost1 }) [
    { name: "title", value: "x" },
    { name: "body", value: "x" },
    { name: "post", value: "missing" },
  ]
  let after <- Db.get BlogPost blogPost1
  Task.succeed (
    { answer: r.answer, post: Maybe.map (\row -> row.post) after }
      == {
        answer: FormRejected [{ field: "post", message: "must be one of the options" }],
        post: Just Nothing,
      }
  )
}

test "a list of 200 posts is offered whole" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let blogPost1 <- Db.insert BlogPost {
    title: "title-1",
    body: "body-1",
    owner: me,
    reviewer: Nothing,
    post: Just post1,
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Post {
        title: Text.NonEmpty ("title-" ++ Text.fromInt n),
        body: "body-" ++ Text.fromInt n,
        author: me,
      }) (List.range 3 200)
    )
  let other <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let _ <- Db.insert Post {
    title: Text.NonEmpty "title-201",
    body: "body-201",
    author: other,
  }
  let page <- Test.get (Edit { id: blogPost1 })
  Task.succeed (List.length page.model.posts == 200)
}

test "a long list of posts offers 50, and the search narrows it" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let blogPost1 <- Db.insert BlogPost {
    title: "title-1",
    body: "body-1",
    owner: me,
    reviewer: Nothing,
    post: Just post1,
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Post {
        title: Text.NonEmpty ("title-" ++ Text.fromInt n),
        body: "body-" ++ Text.fromInt n,
        author: me,
      }) (List.range 3 203)
    )
  let all <- Test.get (Edit { id: blogPost1 })
  let found <- Test.get (Edit { id: blogPost1, findPost: "title-203" })
  Task.succeed (
    {
      shown: List.length all.model.posts,
      total: all.model.postsTotal,
      found: Test.count "select[name=post] option" found.doc <= 3,
      input: Test.attr "value" "input[name=findPost]" found.doc,
    } == {
      shown: 51,
      total: 203,
      found: True,
      input: Just "title-203",
    }
  )
}

test "the row's own post is offered first when it sorts past the 50" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "zz-1",
    body: "body-1",
    author: me,
  }
  let blogPost1 <- Db.insert BlogPost {
    title: "title-1",
    body: "body-1",
    owner: me,
    reviewer: Nothing,
    post: Just post1,
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Post {
        title: Text.NonEmpty ("title-" ++ Text.fromInt n),
        body: "body-" ++ Text.fromInt n,
        author: me,
      }) (List.range 2 202)
    )
  let page <- Test.get (Edit { id: blogPost1 })
  let r <- Test.submit (Save { id: blogPost1 }) {
    title: page.model.row.title,
    body: page.model.row.body,
    post: page.model.row.post,
  }
  let after <- Db.get BlogPost blogPost1
  Task.succeed (
    {
      answer: r.answer,
      kept: Maybe.map (\row -> row.post) after,
      first: Maybe.map (\o -> o.id) (List.head page.model.posts),
      once: List.length (List.filter (\o -> o.id == post1) page.model.posts),
      shown: List.length page.model.posts,
    } == {
      answer: Redirected (BlogPosts.Show.Show { id: blogPost1 }),
      kept: Just (Just post1),
      first: Just post1,
      once: 1,
      shown: 51,
    }
  )
}

test "a visitor cannot save a blog post" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let blogPost1 <- Db.insert BlogPost {
    title: "title-1",
    body: "body-1",
    owner: me,
    reviewer: Nothing,
    post: Nothing,
  }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let before <- Db.get BlogPost blogPost1
  let _ <- Test.get (Edit { id: blogPost1 })
  let _ <- Test.login { user: Nothing }
  let r <- Test.submit (Save { id: blogPost1 }) {
    title: "title-2",
    body: "body-2",
    post: Just post2,
  }
  let after <- Db.get BlogPost blogPost1
  Task.succeed (
    { answer: r.answer, row: after } == { answer: Redirected (Auth.Login.Login {}), row: before }
  )
}

test "another user cannot save it" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let other <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let blogPost1 <- Db.insert BlogPost {
    title: "title-1",
    body: "body-1",
    owner: other,
    reviewer: Nothing,
    post: Nothing,
  }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let before <- Db.get BlogPost blogPost1
  let _ <- Test.login { user: Just other }
  let _ <- Test.get (Edit { id: blogPost1 })
  let _ <- Test.login { user: Just me }
  let r <- Test.submit (Save { id: blogPost1 }) {
    title: "title-2",
    body: "body-2",
    post: Just post2,
  }
  let after <- Db.get BlogPost blogPost1
  Task.succeed (
    { answer: r.answer, row: after } == { answer: RequestFailed "400 bad request", row: before }
  )
}

test "a missing row is not found" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let r <- Test.open (Edit { id: BlogPost.BlogPostId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "another user's row: the edit page is not found" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let other <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let blogPost1 <- Db.insert BlogPost {
    title: "title-1",
    body: "body-1",
    owner: other,
    reviewer: Nothing,
    post: Nothing,
  }
  let r <- Test.open (Edit { id: blogPost1 })
  Task.succeed (r.answer == PageMissing)
}

test "a visitor is sent to log in" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let blogPost1 <- Db.insert BlogPost {
    title: "title-1",
    body: "body-1",
    owner: me,
    reviewer: Nothing,
    post: Nothing,
  }
  let r <- Test.open (Edit { id: blogPost1 })
  Task.succeed (r.answer == Redirected (Auth.Login.Login {}))
}
-- @resource end
