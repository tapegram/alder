-- generated by `alder new resource BlogPost --module BlogPosts --path /blog-posts --read owner`; regions between
-- `-- @resource begin <name>` / `-- @resource end` are rewritten by `alder regen resource`
module BlogPosts.Index

-- @resource begin imports
import Layout
import Table.BlogPost
import Table.Post
import Table.User
-- @resource end

-- @resource begin routes
route Index = GET "/blog-posts" { q: Text = "", sort: Text = "created", dir: Text = "desc", page: Int = 1 } requires user
-- @resource end

type Model = {
  rows: List BlogPost,
  labels: Labels,
  q: Text,
  filters: Filters,
  sort: Text,
  dir: Text,
  page: Int,
  pages: Int,
  count: Int,
}

perPage : Int
perPage = 20

-- @resource begin search
-- search is the rows whose text contains q (every row for "").
search : Text -> Condition BlogPost
search q = Db.or [BlogPost.title.contains q, BlogPost.body.contains q]
-- @resource end

-- A Filter is one of the list's selects: the column it filters, the option chosen ("" for any),
-- and each option's value in the address, its label, and the rows it selects.
type Filter = {
  name: Text,
  label: Text,
  value: Text,
  options: List {
    value: Text,
    label: Text,
    rows: Condition BlogPost,
  },
}

-- @resource begin filters
-- Filters are the option each filter has chosen in the address ("" for any): a select for each
-- Bool and union column: this table has none.
type Filters = { }

-- chosen is the filters' options in params.
chosen : Index.Params -> Filters
chosen params = {}

-- filters are the list's filters, each with the option f has chosen.
filters : Filters -> List Filter
filters f = []

-- filtered is the rows that the option each filter has chosen selects (every row for "", or for
-- a value that is no option's).
filtered : List Filter -> Condition BlogPost
filtered fs = Db.and []

-- listAt is this list with the model's search and filters, sorted by sort and dir, at page n.
listAt : Model -> Text -> Text -> Int -> Route
listAt model sort dir n = Index {
  q: model.q,
  sort: sort,
  dir: dir,
  page: n,
}
-- @resource end

-- @resource begin sorts
-- sorts are the columns the list sorts by, by name.
sorts : List {
  name: Text,
  asc: Order BlogPost,
  desc: Order BlogPost,
}
sorts = [
  {
    name: "title",
    asc: BlogPost.title.asc,
    desc: BlogPost.title.desc,
  },
  {
    name: "body",
    asc: BlogPost.body.asc,
    desc: BlogPost.body.desc,
  },
  {
    name: "owner",
    asc: BlogPost.owner.asc,
    desc: BlogPost.owner.desc,
  },
  {
    name: "reviewer",
    asc: BlogPost.reviewer.asc,
    desc: BlogPost.reviewer.desc,
  },
  {
    name: "post",
    asc: BlogPost.post.asc,
    desc: BlogPost.post.desc,
  },
  {
    name: "created",
    asc: BlogPost.created.asc,
    desc: BlogPost.created.desc,
  },
  {
    name: "updated",
    asc: BlogPost.updated.asc,
    desc: BlogPost.updated.desc,
  },
]
-- @resource end

-- order is the ordering sort names, ascending when dir is "asc"; a name that is not a column's
-- sorts newest first.
order : Text -> Text -> Order BlogPost
order sort dir = match List.find (\s -> s.name == sort) sorts {
  Just s -> if dir == "asc" then s.asc else s.desc,
  Nothing -> BlogPost.created.desc,
}

-- toggle is the direction a column's header sorts by: the other way round when the list is
-- sorted by that column ascending.
toggle : Model -> Text -> Text
toggle model sort = if model.sort == sort && model.dir == "asc" then "desc" else "asc"

-- Index.load reads how many rows match the search and the filters, and one page of them (the last,
-- for a page past it), in the order asked for. The search text is cut to 200 characters (Text.slice):
-- a text over 10,000 bytes would fail the query (chapter 8, "Search").
Index.load : Index.Params -> Session -> Query Model
Index.load params session = {
  let q = Text.slice 0 200 params.q
  let f = chosen params
  let count <-
    Db.mine BlogPost
      |> Db.where (Db.and [search q, filtered (filters f)])
      |> Db.count
  let pages = Int.max 1 ((count + perPage - 1) / perPage)
  let page = Int.clamp { min: 1, max: pages } params.page
  let rows <-
    Db.mine BlogPost
      |> Db.where (Db.and [search q, filtered (filters f)])
      |> Db.orderBy (order params.sort params.dir)
      |> Db.limit perPage
      |> Db.offset ((page - 1) * perPage)
      |> Db.all
  let labels <- labelsOf rows
  Query.succeed {
    rows: rows,
    labels: labels,
    q: q,
    filters: f,
    sort: params.sort,
    dir: params.dir,
    page: page,
    pages: pages,
    count: count,
  }
}

-- @resource begin labels
-- Labels are the rows the references of the rows shown name: their links show their labels.
type Labels = {
  owners: List User,
  reviewers: List User,
  posts: List Post,
}

-- labelsOf reads the rows that rows refer to.
labelsOf : List BlogPost -> Query Labels
labelsOf rows = {
  -- every user's rows: User has no owner
  let owners <-
    Db.from User
      |> Db.where (User.id.in (List.map (\row -> row.owner) rows))
      |> Db.all
  -- every user's rows: User has no owner
  let reviewers <-
    Db.from User
      |> Db.where (User.id.in (List.filterMap (\row -> row.reviewer) rows))
      |> Db.all
  let posts <-
    Db.mine Post
      |> Db.where (Post.id.in (List.filterMap (\row -> row.post) rows))
      |> Db.all
  Query.succeed {
    owners: owners,
    reviewers: reviewers,
    posts: posts,
  }
}

-- ownerLabel is the label of the user id names (the id itself if it names none).
ownerLabel : Labels -> User.UserId -> Text
ownerLabel labels id = match List.find (\r -> r.id == id) labels.owners {
  Just r -> r.name,
  Nothing -> id,
}

-- reviewerLabel is the label of the user id names (the id itself if it names none).
reviewerLabel : Labels -> User.UserId -> Text
reviewerLabel labels id = match List.find (\r -> r.id == id) labels.reviewers {
  Just r -> r.name,
  Nothing -> id,
}

-- postLabel is the label of the post id names (the id itself if it names none).
postLabel : Labels -> Post.PostId -> Text
postLabel labels id = match List.find (\r -> r.id == id) labels.posts {
  Just r -> r.title,
  Nothing -> id,
}
-- @resource end

Index.view : Model -> Session -> Html
Index.view model session =
  <Layout.Page title="Blog posts">
    <h1>Blog posts</h1>

    <al-stack direction="row" gap="sm">
      <form method="get" action="/blog-posts">
        <al-stack direction="row" gap="sm">
          <al-input><label>Search<input type="search" name="q" value={model.q} /></label></al-input>
          {for f in filters model.filters ->
            <al-select label={f.label}>
              <label>
                {f.label}
                <select name={f.name}>
                  <option value="" selected={f.value == ""}>any</option>
                  {for o in f.options ->
                    <option value={o.value} selected={o.value == f.value}>{o.label}</option>}
                </select>
              </label>
            </al-select>}
          <input type="hidden" name="sort" value={model.sort} />
          <input type="hidden" name="dir" value={model.dir} />
          <al-button type="submit" variant="secondary">Search</al-button>
        </al-stack>
      </form>
      <al-button href={BlogPosts.New.New {}}>New blog post</al-button>
    </al-stack>

    <p id="count">{if model.count == 1 then "1 row" else Text.fromInt model.count ++ " rows"}</p>

    <al-table>
      <table>
        <thead>
          <tr>
            -- @resource begin headers
            <th><a href={listAt model "title" (toggle model "title") 1}>Title</a></th>
            <th><a href={listAt model "body" (toggle model "body") 1}>Body</a></th>
            <th><a href={listAt model "owner" (toggle model "owner") 1}>Owner</a></th>
            <th><a href={listAt model "reviewer" (toggle model "reviewer") 1}>Reviewer</a></th>
            <th><a href={listAt model "post" (toggle model "post") 1}>Post</a></th>
            <th><a href={listAt model "created" (toggle model "created") 1}>Created</a></th>
            <th><a href={listAt model "updated" (toggle model "updated") 1}>Updated</a></th>
            -- @resource end
          </tr>
        </thead>
        <tbody>
          {for row in model.rows ->
            <tr>
              -- @resource begin cells
              <td><a href={BlogPosts.Show.Show { id: row.id }}>{row.title}</a></td>
              <td>{row.body}</td>
              <td>{ownerLabel model.labels row.owner}</td>
              <td>
                {match row.reviewer {
                  Just v -> reviewerLabel model.labels v,
                  Nothing -> "",
                }}
              </td>
              <td>
                {match row.post {
                  Just v -> postLabel model.labels v,
                  Nothing -> "",
                }}
              </td>
              <td>{Time.format "Jan 2, 2006" row.created}</td>
              <td>{Time.format "Jan 2, 2006" row.updated}</td>
              -- @resource end
            </tr>}
        </tbody>
      </table>
    </al-table>

    <al-pagination role="navigation" aria-label="Pages">
      {if model.page > 1 then
        <a slot="prev" href={listAt model model.sort model.dir (model.page - 1)} rel="prev">
          Previous
        </a>
      else
        <span slot="prev" aria-disabled="true">Previous</span>}
      <span>Page {Text.fromInt model.page} of {Text.fromInt model.pages}</span>
      {if model.page < model.pages then
        <a slot="next" href={listAt model model.sort model.dir (model.page + 1)} rel="next">Next</a>
      else
        <span slot="next" aria-disabled="true">Next</span>}
    </al-pagination>
  </Layout.Page>

-- @resource begin tests
test "shows my rows newest first, and the labels of the rows they refer to" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let blogPost1 <- Db.insert BlogPost {
    title: "title-1",
    body: "body-1",
    owner: me,
    reviewer: Nothing,
    post: Nothing,
  }
  let blogPost2 <- Db.insert BlogPost {
    title: "title-2",
    body: "body-2",
    owner: me,
    reviewer: Nothing,
    post: Nothing,
  }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let user3 <- Db.insert User {
    email: Text.Email "email-3@example.com",
    name: Text.NonEmpty "name-3",
  }
  let reviewersAll <- Db.from User |> Db.all
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let postsAll <- Db.from Post |> Db.all
  let page <- Test.get (Index {})
  Task.succeed (
    {
      rows: List.map (\row -> row.id) page.model.rows,
      owners: List.length page.model.labels.owners,
      ownerLabel: ownerLabel page.model.labels me,
      reviewerLabel: reviewerLabel { page.model.labels | reviewers: reviewersAll } user3,
      reviewers: List.length page.model.labels.reviewers,
      postLabel: postLabel { page.model.labels | posts: postsAll } post1,
      posts: List.length page.model.labels.posts,
    } == {
      rows: [blogPost2, blogPost1],
      owners: 1,
      ownerLabel: "name-1",
      reviewerLabel: "name-3",
      reviewers: 0,
      postLabel: "title-1",
      posts: 0,
    }
  )
}

test "does not show another user's rows" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let blogPost1 <- Db.insert BlogPost {
    title: "title-1",
    body: "body-1",
    owner: me,
    reviewer: Nothing,
    post: Nothing,
  }
  let other <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let blogPost2 <- Db.insert BlogPost {
    title: "title-2",
    body: "body-2",
    owner: other,
    reviewer: Nothing,
    post: Nothing,
  }
  let page <- Test.get (Index {})
  Task.succeed (
    { rows: List.map (\row -> row.id) page.model.rows, count: Test.text "#count" page.doc }
      == { rows: [blogPost1], count: Just "1 row" }
  )
}

test "another user's post is not named" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let other <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: other,
  }
  let blogPost1 <- Db.insert BlogPost {
    title: "title-1",
    body: "body-1",
    owner: me,
    reviewer: Nothing,
    post: Just post1,
  }
  let page <- Test.get (Index {})
  Task.succeed (List.length page.model.labels.posts == 0)
}

test "sorting by title goes both ways" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let blogPost1 <- Db.insert BlogPost {
    title: "title-2",
    body: "body-1",
    owner: me,
    reviewer: Nothing,
    post: Nothing,
  }
  let blogPost2 <- Db.insert BlogPost {
    title: "title-1",
    body: "body-2",
    owner: me,
    reviewer: Nothing,
    post: Nothing,
  }
  let up <- Test.get (Index { sort: "title", dir: "asc" })
  let down <- Test.get (Index { sort: "title" })
  Task.succeed (
    {
      up: List.map (\row -> row.id) up.model.rows,
      down: List.map (\row -> row.id) down.model.rows,
      toggles: [toggle up.model "title", toggle down.model "title", toggle up.model "body"],
    } == {
      up: [blogPost2, blogPost1],
      down: [blogPost1, blogPost2],
      toggles: ["desc", "asc", "asc"],
    }
  )
}

test "searching finds the rows that contain the text" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let blogPost1 <- Db.insert BlogPost {
    title: "title-1",
    body: "body-1",
    owner: me,
    reviewer: Nothing,
    post: Nothing,
  }
  let blogPost2 <- Db.insert BlogPost {
    title: "title-2",
    body: "body-2",
    owner: me,
    reviewer: Nothing,
    post: Nothing,
  }
  let page <- Test.get (Index { q: "title-2" })
  Task.succeed (
    { rows: List.map (\row -> row.id) page.model.rows, count: Test.text "#count" page.doc }
      == { rows: [blogPost2], count: Just "1 row" }
  )
}

test "a search text of 20,000 characters is cut to 200" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let long = Text.join "" (List.map (\n -> "z") (List.range 1 20000))
  let page <- Test.get (Index { q: long })
  Task.succeed (
    { q: Text.length page.model.q, rows: List.length page.model.rows } == { q: 200, rows: 0 }
  )
}

test "the list has 20 rows a page, and a page past the last is the last" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert BlogPost {
        title: "title-" ++ Text.fromInt n,
        body: "body-" ++ Text.fromInt n,
        owner: me,
        reviewer: Nothing,
        post: Nothing,
      }) (List.range 1 21)
    )
  let first <- Test.get (Index {})
  let second <- Test.get (Index { page: 2 })
  let past <- Test.get (Index { page: 9 })
  Task.succeed (
    {
      first: List.length first.model.rows,
      second: List.length second.model.rows,
      past: { page: past.model.page, rows: List.length past.model.rows },
      count: Test.text "#count" first.doc,
      pages: Test.texts "al-pagination span" first.doc,
    } == {
      first: 20,
      second: 1,
      past: { page: 2, rows: 1 },
      count: Just "21 rows",
      pages: ["Previous", "Page 1 of 2"],
    }
  )
}

test "a visitor is sent to log in" = {
  let r <- Test.open (Index {})
  Task.succeed (r.answer == Redirected (Auth.Login.Login {}))
}
-- @resource end
