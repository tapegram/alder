-- generated by `alder new resource BlogPost --module BlogPosts --path /blog-posts`; regions between
-- `-- @resource begin <name>` / `-- @resource end` are rewritten by `alder regen resource`
module BlogPosts.Delete

-- @resource begin imports
import Layout
import Table.BlogPost
import Table.User
-- @resource end

-- @resource begin routes
route Delete  = GET    "/blog-posts/{id}/delete" { id: BlogPost.BlogPostId }              requires user
route Destroy = DELETE "/blog-posts/{id}"        { id: BlogPost.BlogPostId } form Confirm requires user
-- @resource end

-- The row, and how many rows of each table refer to it.
type Model = {
  row: BlogPost,
  -- @resource begin model
  -- @resource end
}

-- counted is the row id names (none is not found) and how many rows of each table refer to it:
-- the page shows them, and Destroy counts them again before it deletes.
counted : BlogPost.BlogPostId -> Query Model
counted id = {
  -- @resource begin load
  let row <- Db.getMine BlogPost id
  Query.succeed { row: row }
  -- @resource end
}

Delete.load : Delete.Params -> Session -> Query Model
Delete.load params session = { counted params.id }

-- @resource begin blockers
-- blockers counts the rows that keep this one from being deleted, which the database would
-- refuse the delete for: the `@restrict` references to it, or to a row deleted with it.
blockers : Model -> Int
blockers model = 0
-- @resource end

-- Destroy takes no input: the form is the button, and the place a refusal is shown.
form Confirm = { }

-- Destroy deletes the row, unless rows refer to it that keep it (counted again, as the page
-- counted them): the database would refuse the delete with an error, and the page says why
-- instead. The Show page's dialog posts it too.
Destroy.update : Destroy.Params -> Session -> Task Response
Destroy.update params session = {
  let model <- counted params.id
  -- @resource begin remove
  let _ <- Db.deleteMine BlogPost params.id
  Task.succeed (Response.redirect (BlogPosts.Index.Index {}) |> Response.success "Deleted")
  -- @resource end
}

Delete.view : Model -> Session -> Html
Delete.view model session =
  <Layout.Page title="Delete blog post">
    <h1>Delete this blog post?</h1>

    <al-card>
      -- @resource begin row
      <p>{model.row.title}</p>
      -- @resource end
      <dl>
        -- @resource begin counts
        -- @resource end
      </dl>
      <form id="delete" submit={Destroy { id: model.row.id }}>
        <al-alert variant="destructive"><Errors form /></al-alert>
        {if blockers model > 0 then
          <p>It cannot be deleted while other rows refer to it.</p>
        else
          <al-button variant="destructive" type="submit">Delete</al-button>}
      </form>
    </al-card>
    <a href={BlogPosts.Show.Show { id: model.row.id }}>Back</a>
  </Layout.Page>

-- @resource begin tests
test "deleting a blog post nothing refers to" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let blogPost1 <- Db.insert BlogPost {
    title: "title-1",
    body: "body-1",
    owner: me,
    reviewer: Nothing,
    post: Nothing,
  }
  let page <- Test.get (Delete { id: blogPost1 })
  let r <- Test.submit (Destroy { id: blogPost1 }) {}
  let gone <- Db.get BlogPost blogPost1
  Task.succeed (
    {
      button: Test.count "#delete al-button" page.doc,
      answer: r.answer,
      notices: r.notices,
      gone: Maybe.map (\row -> row.id) gone,
    } == {
      button: 1,
      answer: Redirected (BlogPosts.Index.Index {}),
      notices: ["Deleted"],
      gone: Nothing,
    }
  )
}

test "a visitor cannot delete a blog post" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let blogPost1 <- Db.insert BlogPost {
    title: "title-1",
    body: "body-1",
    owner: me,
    reviewer: Nothing,
    post: Nothing,
  }
  let _ <- Test.get (Delete { id: blogPost1 })
  let _ <- Test.login { user: Nothing }
  let r <- Test.submit (Destroy { id: blogPost1 }) {}
  let kept <- Db.get BlogPost blogPost1
  Task.succeed (
    { answer: r.answer, kept: Maybe.map (\row -> row.id) kept }
      == { answer: Redirected (Auth.Login.Login {}), kept: Just blogPost1 }
  )
}

test "another user cannot delete it" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let other <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let blogPost1 <- Db.insert BlogPost {
    title: "title-1",
    body: "body-1",
    owner: other,
    reviewer: Nothing,
    post: Nothing,
  }
  let _ <- Test.login { user: Just other }
  let _ <- Test.get (Delete { id: blogPost1 })
  let _ <- Test.login { user: Just me }
  let r <- Test.submit (Destroy { id: blogPost1 }) {}
  let kept <- Db.get BlogPost blogPost1
  Task.succeed (
    { answer: r.answer, kept: Maybe.map (\row -> row.id) kept }
      == { answer: PageMissing, kept: Just blogPost1 }
  )
}

test "a missing row is not found" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let r <- Test.open (Delete { id: BlogPost.BlogPostId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "another user's row is not found" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let other <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let blogPost1 <- Db.insert BlogPost {
    title: "title-1",
    body: "body-1",
    owner: other,
    reviewer: Nothing,
    post: Nothing,
  }
  let r <- Test.open (Delete { id: blogPost1 })
  Task.succeed (r.answer == PageMissing)
}

test "a visitor is sent to log in" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let blogPost1 <- Db.insert BlogPost {
    title: "title-1",
    body: "body-1",
    owner: me,
    reviewer: Nothing,
    post: Nothing,
  }
  let r <- Test.open (Delete { id: blogPost1 })
  Task.succeed (r.answer == Redirected (Auth.Login.Login {}))
}
-- @resource end
