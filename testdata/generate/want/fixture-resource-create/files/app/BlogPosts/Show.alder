-- generated by `alder new resource BlogPost --module BlogPosts --path /blog-posts`; regions between
-- `-- @resource begin <name>` / `-- @resource end` are rewritten by `alder regen resource`
module BlogPosts.Show

-- @resource begin imports
import Layout
import Table.BlogPost
import Table.Post
import Table.User
-- @resource end

-- @resource begin routes
route Show = GET "/blog-posts/{id}" { id: BlogPost.BlogPostId } requires user
-- @resource end

-- The row, the labels of the rows it refers to, and (for the delete dialog) how many rows of
-- each table refer to it.
type Model = {
  row: BlogPost,
  labels: Labels,
  -- @resource begin model
  -- @resource end
}

Show.load : Show.Params -> Session -> Query Model
Show.load params session = {
  -- @resource begin load
  let row <- Db.getMine BlogPost params.id
  let labels <- labelsOf [row]
  Query.succeed { row: row, labels: labels }
  -- @resource end
}

-- @resource begin labels
-- Labels are the rows the references of the rows shown name: their links show their labels.
type Labels = {
  owners: List User,
  reviewers: List User,
  posts: List Post,
}

-- labelsOf reads the rows that rows refer to.
labelsOf : List BlogPost -> Query Labels requires user
labelsOf rows = {
  -- every user's rows: User has no owner
  let owners <-
    Db.from User
      |> Db.where (User.id.in (List.map (\row -> row.owner) rows))
      |> Db.all
  -- every user's rows: User has no owner
  let reviewers <-
    Db.from User
      |> Db.where (User.id.in (List.filterMap (\row -> row.reviewer) rows))
      |> Db.all
  let posts <-
    Db.mine Post
      |> Db.where (Post.id.in (List.filterMap (\row -> row.post) rows))
      |> Db.all
  Query.succeed {
    owners: owners,
    reviewers: reviewers,
    posts: posts,
  }
}

-- ownerLabel is the label of the user id names (the id itself if it names none).
ownerLabel : Labels -> User.UserId -> Text
ownerLabel labels id = match List.find (\r -> r.id == id) labels.owners {
  Just r -> r.name,
  Nothing -> id,
}

-- reviewerLabel is the label of the user id names (the id itself if it names none).
reviewerLabel : Labels -> User.UserId -> Text
reviewerLabel labels id = match List.find (\r -> r.id == id) labels.reviewers {
  Just r -> r.name,
  Nothing -> id,
}

-- postLabel is the label of the post id names (the id itself if it names none).
postLabel : Labels -> Post.PostId -> Text
postLabel labels id = match List.find (\r -> r.id == id) labels.posts {
  Just r -> r.title,
  Nothing -> id,
}
-- @resource end

-- @resource begin blockers
-- blockers counts the rows that keep this one from being deleted, which the database would
-- refuse the delete for: the `@restrict` references to it, or to a row deleted with it.
blockers : Model -> Int
blockers model = 0
-- @resource end

Show.view : Model -> Session -> Html
Show.view model session =
  <Layout.Page title="Blog post">
    <h1>Blog post</h1>

    <al-card>
      <dl id="fields">
        -- @resource begin fields
        <dt>Id</dt>
        <dd>{model.row.id}</dd>
        <dt>Title</dt>
        <dd>{model.row.title}</dd>
        <dt>Body</dt>
        <dd>{model.row.body}</dd>
        <dt>Owner</dt>
        <dd>{ownerLabel model.labels model.row.owner}</dd>
        <dt>Reviewer</dt>
        <dd>
          {match model.row.reviewer {
            Just v -> reviewerLabel model.labels v,
            Nothing -> "",
          }}
        </dd>
        <dt>Post</dt>
        <dd>
          {match model.row.post {
            Just v -> postLabel model.labels v,
            Nothing -> "",
          }}
        </dd>
        <dt>Created</dt>
        <dd>{Time.format "Jan 2, 2006" model.row.created}</dd>
        <dt>Updated</dt>
        <dd>{Time.format "Jan 2, 2006" model.row.updated}</dd>
        -- @resource end
      </dl>
      <div slot="actions">
        <al-button href={BlogPosts.Edit.Edit { id: model.row.id }}>Edit</al-button>
        <al-button variant="destructive">
          <button type="button" commandfor="delete-dialog" command="show-modal">Delete</button>
        </al-button>
      </div>
    </al-card>
    <al-dialog id="delete-dialog" heading="Delete this blog post?" dismissible>
      <dl>
        -- @resource begin counts
        -- @resource end
      </dl>
      <form id="delete" submit={BlogPosts.Delete.Destroy { id: model.row.id }}>
        <al-alert variant="destructive"><Errors form /></al-alert>
        {if blockers model > 0 then
          <p>It cannot be deleted while other rows refer to it.</p>
        else
          <al-button variant="destructive" type="submit">Delete</al-button>}
      </form>
      <div slot="actions">
        <a href={BlogPosts.Delete.Delete { id: model.row.id }}>See the details</a>
      </div>
    </al-dialog>
    <a href={BlogPosts.Index.Index {}}>All blog posts</a>
  </Layout.Page>

-- @resource begin tests
test "the page shows the row" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let blogPost1 <- Db.insert BlogPost {
    title: "title-1",
    body: "body-1",
    owner: me,
    reviewer: Nothing,
    post: Nothing,
  }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let user3 <- Db.insert User {
    email: Text.Email "email-3@example.com",
    name: Text.NonEmpty "name-3",
  }
  let reviewersAll <- Db.from User |> Db.all
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let postsAll <- Db.from Post |> Db.all
  let r <- Test.open (Show { id: blogPost1 })
  let page <- Test.get (Show { id: blogPost1 })
  Task.succeed (
    {
      answer: r.answer,
      title: List.member "title-1" (Test.texts "#fields dd" r.doc),
      owners: List.length page.model.labels.owners,
      ownerLabel: ownerLabel page.model.labels me,
      reviewerLabel: reviewerLabel { page.model.labels | reviewers: reviewersAll } user3,
      reviewers: List.length page.model.labels.reviewers,
      postLabel: postLabel { page.model.labels | posts: postsAll } post1,
      posts: List.length page.model.labels.posts,
    } == {
      answer: Shown,
      title: True,
      owners: 1,
      ownerLabel: "name-1",
      reviewerLabel: "name-3",
      reviewers: 0,
      postLabel: "title-1",
      posts: 0,
    }
  )
}

test "another user's post is not named" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let other <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: other,
  }
  let blogPost1 <- Db.insert BlogPost {
    title: "title-1",
    body: "body-1",
    owner: me,
    reviewer: Nothing,
    post: Just post1,
  }
  let page <- Test.get (Show { id: blogPost1 })
  Task.succeed (List.length page.model.labels.posts == 0)
}

test "deleting a blog post nothing refers to" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let blogPost1 <- Db.insert BlogPost {
    title: "title-1",
    body: "body-1",
    owner: me,
    reviewer: Nothing,
    post: Nothing,
  }
  let page <- Test.get (Show { id: blogPost1 })
  let r <- Test.submit (BlogPosts.Delete.Destroy { id: blogPost1 }) {}
  let gone <- Db.get BlogPost blogPost1
  Task.succeed (
    {
      button: Test.count "#delete al-button" page.doc,
      answer: r.answer,
      notices: r.notices,
      gone: Maybe.map (\row -> row.id) gone,
    } == {
      button: 1,
      answer: Redirected (BlogPosts.Index.Index {}),
      notices: ["Deleted"],
      gone: Nothing,
    }
  )
}

test "a missing row is not found" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let r <- Test.open (Show { id: BlogPost.BlogPostId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "another user's row is not found" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let other <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let blogPost1 <- Db.insert BlogPost {
    title: "title-1",
    body: "body-1",
    owner: other,
    reviewer: Nothing,
    post: Nothing,
  }
  let r <- Test.open (Show { id: blogPost1 })
  Task.succeed (r.answer == PageMissing)
}

test "a visitor is sent to log in" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let blogPost1 <- Db.insert BlogPost {
    title: "title-1",
    body: "body-1",
    owner: me,
    reviewer: Nothing,
    post: Nothing,
  }
  let r <- Test.open (Show { id: blogPost1 })
  Task.succeed (r.answer == Redirected (Auth.Login.Login {}))
}
-- @resource end
