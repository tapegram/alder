-- generated by `alder new resource BlogPost --module BlogPosts --path /blog-posts`; regions between
-- `-- @resource begin <name>` / `-- @resource end` are rewritten by `alder regen resource`
module BlogPosts.New

-- @resource begin imports
import Layout
import Table.BlogPost
import Table.Post
import Table.User
-- @resource end

-- @resource begin routes
route New    = GET  "/blog-posts/new" { findPost: Text = "" } requires user
route Create = POST "/blog-posts"     { } form BlogPostForm   requires user
-- @resource end

type Model = {
  -- @resource begin model
  posts: List Post,
  postsTotal: Int,
  findPost: Text,
  -- @resource end
}

New.load : New.Params -> Session -> Query Model
New.load params session = {
  -- @resource begin load
  let findPost = Text.slice 0 200 params.findPost
  let postsTotal <- Db.mine Post |> Db.count
  let posts <-
    Db.mine Post
      |> Db.orderBy Post.title.asc
      |> Db.where (if postsTotal > 200 then Post.title.contains findPost else Db.and [])
      |> Db.limit (if postsTotal > 200 then 50 else 200)
      |> Db.all
  Query.succeed {
    posts: posts,
    postsTotal: postsTotal,
    findPost: findPost,
  }
  -- @resource end
}

-- @resource begin form
form BlogPostForm = {
  title: Text,
  body: Text,
  post: Maybe Post.PostId,
}
-- @resource end

-- @resource begin search
-- @resource end

-- Create adds the row and goes to its page.
Create.update : Create.Params -> Session -> Task Response
Create.update params session = {
  -- @resource begin insert
  let id <- Db.insertMine BlogPost {
    title: params.form.title,
    body: params.form.body,
    post: params.form.post,
    reviewer: Nothing,
  }
  Task.succeed (Response.redirect (BlogPosts.Show.Show { id: id }))
  -- @resource end
}

New.view : Model -> Session -> Html
New.view model session =
  <Layout.Page title="New blog post">
    <h1>New blog post</h1>

    <al-card>
      -- @resource begin finder
      {if model.postsTotal > 200 then
        <form method="get" action="/blog-posts/new">
          <al-input>
            <label>Find post <input type="search" name="findPost" value={model.findPost} /></label>
          </al-input>
          <al-button type="submit" variant="secondary">Find</al-button>
        </form>
      else
        Html.none}
      -- @resource end
      <form submit={Create}>
        -- @resource begin inputs
        <al-input field="title" label="Title" />
        <al-textarea field="body" label="Body" />
        <al-select
          field="post"
          label="Post"
          options={List.map (\r -> { value: r.id, label: r.title }) model.posts} />
        -- @resource end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Create</al-button>
      </form>
    </al-card>
  </Layout.Page>

-- @resource begin tests
test "creating adds a row that is mine" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let other <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let _ <- Db.insert Post {
    title: Text.NonEmpty "title-3",
    body: "body-3",
    author: other,
  }
  let page <- Test.get (New {})
  let r <- Test.submit Create {
    title: "title-1",
    body: "body-1",
    post: Just post2,
  }
  let rows <- Db.from BlogPost |> Db.all
  Task.succeed (
    {
      answers: List.map (\row -> Redirected (BlogPosts.Show.Show { id: row.id })) rows,
      rows: List.map (\row -> {
        title: row.title,
        body: row.body,
        post: row.post,
        owner: row.owner,
      }) rows,
      posts: Test.texts "select[name=post] option" page.doc,
    } == {
      answers: [r.answer],
      rows: [
        {
          title: "title-1",
          body: "body-1",
          post: Just post2,
          owner: me,
        },
      ],
      posts: ["", "title-1", "title-2"],
    }
  )
}

test "a post not offered is refused" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let page <- Test.get (New {})
  let r <- Test.submitRaw Create [
    { name: "title", value: "x" },
    { name: "body", value: "x" },
    { name: "post", value: "missing" },
  ]
  let rows <- Db.from BlogPost |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows }
      == {
        answer: FormRejected [{ field: "post", message: "must be one of the options" }],
        rows: 0,
      }
  )
}

test "a list of 200 posts is offered whole" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Post {
        title: Text.NonEmpty ("title-" ++ Text.fromInt n),
        body: "body-" ++ Text.fromInt n,
        author: me,
      }) (List.range 3 200)
    )
  let other <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let _ <- Db.insert Post {
    title: Text.NonEmpty "title-201",
    body: "body-201",
    author: other,
  }
  let page <- Test.get (New {})
  Task.succeed (List.length page.model.posts == 200)
}

test "a long list of posts offers 50, and the search narrows it" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Post {
        title: Text.NonEmpty ("title-" ++ Text.fromInt n),
        body: "body-" ++ Text.fromInt n,
        author: me,
      }) (List.range 3 203)
    )
  let all <- Test.get (New {})
  let found <- Test.get (New { findPost: "title-203" })
  Task.succeed (
    {
      shown: List.length all.model.posts,
      total: all.model.postsTotal,
      found: Test.texts "select[name=post] option" found.doc == ["", "title-203"],
      input: Test.attr "value" "input[name=findPost]" found.doc,
    } == {
      shown: 50,
      total: 203,
      found: True,
      input: Just "title-203",
    }
  )
}

test "a visitor cannot create a blog post" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let _ <- Test.get (New {})
  let _ <- Test.login { user: Nothing }
  let r <- Test.submit Create {
    title: "title-1",
    body: "body-1",
    post: Just post2,
  }
  let rows <- Db.from BlogPost |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows } == { answer: Redirected (Auth.Login.Login {}), rows: 0 }
  )
}

test "a visitor is sent to log in" = {
  let r <- Test.open (New {})
  Task.succeed (r.answer == Redirected (Auth.Login.Login {}))
}
-- @resource end
