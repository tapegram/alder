module Table.BlogPost

import Table.Post
import Table.User

type BlogPostId = brand Text

table BlogPost {
  id: BlogPostId @id,
  title: Text,
  body: Text,
  owner: User.UserId @ref User @owner,
  reviewer: Maybe User.UserId @ref User,
  post: Maybe Post.PostId @ref Post,
  created: Time @created,
  updated: Time @updated,
}

test "a BlogPost keeps its owner from being deleted" = {
  let target <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
  }
  let _ <- Db.insert BlogPost {
    title: "title-1",
    body: "body-1",
    owner: target,
    reviewer: Nothing,
    post: Nothing,
  }
  let r <- Test.run (Db.delete User target)
  let left <- Db.from BlogPost |> Db.count
  Task.succeed ({ deleted: Result.toMaybe r.value, left: left } == { deleted: Nothing, left: 1 })
}

test "a BlogPost keeps its reviewer from being deleted" = {
  let target <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
  }
  let me <- Db.insert User { email: Text.Email "email-2@example.com", name: Text.NonEmpty "name-2" }
  let _ <- Db.insert BlogPost {
    title: "title-1",
    body: "body-1",
    owner: me,
    reviewer: Just target,
    post: Nothing,
  }
  let r <- Test.run (Db.delete User target)
  let left <- Db.from BlogPost |> Db.count
  Task.succeed ({ deleted: Result.toMaybe r.value, left: left } == { deleted: Nothing, left: 1 })
}

test "a BlogPost keeps its post from being deleted" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let target <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let _ <- Db.insert BlogPost {
    title: "title-1",
    body: "body-1",
    owner: me,
    reviewer: Nothing,
    post: Just target,
  }
  let r <- Test.run (Db.delete Post target)
  let left <- Db.from BlogPost |> Db.count
  Task.succeed ({ deleted: Result.toMaybe r.value, left: left } == { deleted: Nothing, left: 1 })
}
