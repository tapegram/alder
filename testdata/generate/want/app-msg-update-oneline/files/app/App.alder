module App

import Layout

session { }

msg Ping

msg Pong

update : Msg -> Session -> Task Nav
update msg session = match msg {
  Ping p -> Task.succeed Rerender,
  Pong p -> ?pong,
}

error : Error -> Html Never
error err =
  <Layout.Page title="Error">
    <h1>Something went wrong</h1>
    <p>Please try again.</p>
  </Layout.Page>

notFound : Html Never
notFound = <Layout.Page title="Not found"><h1>Not found</h1></Layout.Page>

-- A message of App is sent from any page (`click={App.Pong}`), so the test calls update itself.
-- Fill ?expected with what Pong must do, as `{ value: r.value, trace: r.trace } ==
-- { value: Ok Rerender, trace: ["Session.put"] }`: its answer and the effects it ran.
test "pressing Pong" = {
  let r <- Test.run (update Pong {})
  Task.succeed ?expected
}
