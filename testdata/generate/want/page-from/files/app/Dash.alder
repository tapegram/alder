module Dash

import Entry
import Layout

page "/dash" { }

type Model = { entries: List Entry }

load : Params -> Session -> Query Model
load params session = {
  let entries <- Db.from Entry |> Db.all
  Query.succeed { entries: entries }
}

view : Model -> Session -> Html Msg
view model session =
  <Layout.Page title="Dash">
    <h1>Dash</h1>

    <al-card>
      <h2 slot="header">Entries</h2>
      <ul id="entries">
        {for row in model.entries -> <li>{row.name}</li>}
      </ul>
    </al-card>
  </Layout.Page>

test "the page shows each table's rows" = {
  let entry1 <- Db.insert Entry { name: Text.NonEmpty "name-1", message: Text.NonEmpty "message-1" }
  let page <- Test.get (Dash {})
  Task.succeed (
    { heading: Test.text "h1" page.doc, entries: Test.count "#entries li" page.doc }
      == { heading: Just "Dash", entries: 1 }
  )
}
