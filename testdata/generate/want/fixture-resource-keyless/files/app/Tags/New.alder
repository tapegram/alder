-- generated by `alder new resource Tag --module Tags --path /tags`; regions between
-- `-- @resource begin <name>` / `-- @resource end` are rewritten by `alder regen resource`
module Tags.New

-- @resource begin imports
import Layout
import Table.Post
import Table.Tag
import Table.User
-- @resource end

-- @resource begin routes
route New    = GET  "/tags/new" { findPost: Text = "" } requires user
route Create = POST "/tags"     { } form TagForm        requires user
-- @resource end

type Model = {
  -- @resource begin model
  posts: List Post,
  postsTotal: Int,
  findPost: Text,
  -- @resource end
}

New.load : New.Params -> Session -> Query Model
New.load params session = {
  -- @resource begin load
  let findPost = Text.slice 0 200 params.findPost
  let postsTotal <- Db.mine Post |> Db.count
  let posts <-
    Db.mine Post
      |> Db.orderBy Post.title.asc
      |> Db.where (if postsTotal > 200 then Post.title.contains findPost else Db.and [])
      |> Db.limit (if postsTotal > 200 then 50 else 200)
      |> Db.all
  Query.succeed {
    posts: posts,
    postsTotal: postsTotal,
    findPost: findPost,
  }
  -- @resource end
}

-- @resource begin form
form TagForm = { name: Text.NonEmpty, post: Post.PostId }
-- @resource end

-- @resource begin search
-- @resource end

-- Create adds the row and goes to its page.
Create.update : Create.Params -> Session -> Task Response
Create.update params session = {
  -- @resource begin insert
  let nameTaken <-
    Db.from Tag
      |> Db.where (Tag.name.eq params.form.name)
      |> Db.count
  if nameTaken > 0 then
    Task.succeed (Response.invalid "A tag with this name exists.")
  else {
    let id <- Db.insert Tag { name: params.form.name, post: params.form.post }
    Task.succeed (Response.redirect (Tags.Show.Show { id: id }))
  }
  -- @resource end
}

New.view : Model -> Session -> Html
New.view model session =
  <Layout.Page title="New tag">
    <h1>New tag</h1>

    <al-card>
      -- @resource begin finder
      {if model.postsTotal > 200 then
        <form method="get" action="/tags/new">
          <al-input>
            <label>Find post <input type="search" name="findPost" value={model.findPost} /></label>
          </al-input>
          <al-button type="submit" variant="secondary">Find</al-button>
        </form>
      else
        Html.none}
      -- @resource end
      <form submit={Create}>
        -- @resource begin inputs
        <al-input field="name" label="Name" />
        <al-select
          field="post"
          label="Post"
          options={List.map (\r -> { value: r.id, label: r.title }) model.posts} />
        -- @resource end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Create</al-button>
      </form>
    </al-card>
  </Layout.Page>

-- @resource begin tests
test "creating a tag adds it, with the values submitted" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let other <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let _ <- Db.insert Post {
    title: Text.NonEmpty "title-3",
    body: "body-3",
    author: other,
  }
  let _ <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let page <- Test.get (New {})
  let r <- Test.submit Create { name: Text.NonEmpty "name-2", post: post2 }
  let rows <-
    Db.from Tag
      |> Db.where (Tag.name.eq (Text.NonEmpty "name-2"))
      |> Db.all
  Task.succeed (
    {
      answers: List.map (\row -> Redirected (Tags.Show.Show { id: row.id })) rows,
      rows: List.map (\row -> { name: row.name, post: row.post }) rows,
      posts: Test.texts "select[name=post] option" page.doc,
    } == {
      answers: [r.answer],
      rows: [{ name: Text.NonEmpty "name-2", post: post2 }],
      posts: ["title-1", "title-2"],
    }
  )
}

test "an empty name is rejected" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let page <- Test.get (New {})
  let postId = Maybe.withDefault "" (Test.attr "value" "select[name=post] option" page.doc)
  let r <- Test.submitRaw Create [{ name: "name", value: "" }, { name: "post", value: postId }]
  let rows <- Db.from Tag |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows }
      == { answer: FormRejected [{ field: "name", message: "must not be empty" }], rows: 0 }
  )
}

test "a tag with a name that exists is refused" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let _ <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let _ <- Test.get (New {})
  let r <- Test.submit Create { name: Text.NonEmpty "name-1", post: post2 }
  let rows <- Db.from Tag |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows }
      == { answer: FormRejected [{ field: "", message: "A tag with this name exists." }], rows: 1 }
  )
}

test "a post not offered is refused" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let page <- Test.get (New {})
  let r <- Test.submitRaw Create [{ name: "name", value: "x" }, { name: "post", value: "missing" }]
  let rows <- Db.from Tag |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows }
      == {
        answer: FormRejected [{ field: "post", message: "must be one of the options" }],
        rows: 0,
      }
  )
}

test "a list of 200 posts is offered whole" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Post {
        title: Text.NonEmpty ("title-" ++ Text.fromInt n),
        body: "body-" ++ Text.fromInt n,
        author: me,
      }) (List.range 3 200)
    )
  let other <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let _ <- Db.insert Post {
    title: Text.NonEmpty "title-201",
    body: "body-201",
    author: other,
  }
  let page <- Test.get (New {})
  Task.succeed (List.length page.model.posts == 200)
}

test "a long list of posts offers 50, and the search narrows it" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Post {
        title: Text.NonEmpty ("title-" ++ Text.fromInt n),
        body: "body-" ++ Text.fromInt n,
        author: me,
      }) (List.range 3 203)
    )
  let all <- Test.get (New {})
  let found <- Test.get (New { findPost: "title-203" })
  Task.succeed (
    {
      shown: List.length all.model.posts,
      total: all.model.postsTotal,
      found: Test.texts "select[name=post] option" found.doc == ["title-203"],
      input: Test.attr "value" "input[name=findPost]" found.doc,
    } == {
      shown: 50,
      total: 203,
      found: True,
      input: Just "title-203",
    }
  )
}

test "a post outside the narrowed list is refused" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Post {
        title: Text.NonEmpty ("title-" ++ Text.fromInt n),
        body: "body-" ++ Text.fromInt n,
        author: me,
      }) (List.range 3 203)
    )
  let all <- Test.get (New {})
  let found <- Test.get (New { findPost: "title-203" })
  let pick = Maybe.withDefault "" (Test.attr "value" "select[name=post] option" found.doc)
  let page <- Test.get (New {})
  let sent <- Test.submitRaw Create [{ name: "name", value: "x" }, { name: "post", value: pick }]
  let rows <- Db.from Tag |> Db.count
  Task.succeed (
    { answer: sent.answer, rows: rows }
      == {
        answer: FormRejected [{ field: "post", message: "must be one of the options" }],
        rows: 0,
      }
  )
}

test "a visitor cannot create a tag" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let _ <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let _ <- Test.get (New {})
  let _ <- Test.login { user: Nothing }
  let r <- Test.submit Create { name: Text.NonEmpty "name-2", post: post2 }
  let rows <- Db.from Tag |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows } == { answer: Redirected (Auth.Login.Login {}), rows: 1 }
  )
}

test "a visitor is sent to log in" = {
  let r <- Test.open (New {})
  Task.succeed (r.answer == Redirected (Auth.Login.Login {}))
}
-- @resource end
