-- generated by `alder new resource Tag --module Tags --path /tags --read signed-in`; regions between
-- `-- @resource begin <name>` / `-- @resource end` are rewritten by `alder regen resource`
module Tags.Show

-- @resource begin imports
import Layout
import Table.Post
import Table.Tag
import Table.User
-- @resource end

-- @resource begin routes
route Show = GET "/tags/{id}" { id: Tag.TagId } requires user
-- @resource end

-- The row, the labels of the rows it refers to, and (for the delete dialog) how many rows of
-- each table refer to it.
type Model = {
  row: Tag,
  labels: Labels,
  -- @resource begin model
  -- @resource end
}

Show.load : Show.Params -> Session -> Query Model
Show.load params session = {
  -- @resource begin load
  let found <- Db.get Tag params.id
  match found {
    Just row -> {
      let labels <- labelsOf [row]
      Query.succeed { row: row, labels: labels }
    },
    Nothing -> Query.notFound,
  }
  -- @resource end
}

-- @resource begin labels
-- Labels are the rows the references of the rows shown name: their links show their labels.
type Labels = { posts: List Post }

-- labelsOf reads the rows that rows refer to.
labelsOf : List Tag -> Query Labels
labelsOf rows = {
  let posts <-
    Db.mine Post
      |> Db.where (Post.id.in (List.map (\row -> row.post) rows))
      |> Db.all
  Query.succeed { posts: posts }
}

-- postLabel is the label of the post id names (the id itself if it names none).
postLabel : Labels -> Post.PostId -> Text
postLabel labels id = match List.find (\r -> r.id == id) labels.posts {
  Just r -> r.title,
  Nothing -> id,
}
-- @resource end

-- @resource begin blockers
-- blockers counts the rows that keep this one from being deleted, which the database would
-- refuse the delete for: the `@restrict` references to it, or to a row deleted with it.
blockers : Model -> Int
blockers model = 0
-- @resource end

Show.view : Model -> Session -> Html
Show.view model session =
  <Layout.Page title="Tag">
    <h1>Tag</h1>

    <al-card>
      <dl id="fields">
        -- @resource begin fields
        <dt>Id</dt>
        <dd>{model.row.id}</dd>
        <dt>Name</dt>
        <dd>{model.row.name}</dd>
        <dt>Post</dt>
        <dd>{postLabel model.labels model.row.post}</dd>
        <dt>Created</dt>
        <dd>{Time.format "Jan 2, 2006" model.row.created}</dd>
        -- @resource end
      </dl>
      <div slot="actions">
        <al-button href={Tags.Edit.Edit { id: model.row.id }}>Edit</al-button>
        <al-button variant="destructive">
          <button type="button" commandfor="delete-dialog" command="show-modal">Delete</button>
        </al-button>
      </div>
    </al-card>
    <al-dialog id="delete-dialog" heading="Delete this tag?" dismissible>
      <dl>
        -- @resource begin counts
        -- @resource end
      </dl>
      <form id="delete" submit={Tags.Delete.Destroy { id: model.row.id }}>
        <al-alert variant="destructive"><Errors form /></al-alert>
        {if blockers model > 0 then
          <p>It cannot be deleted while other rows refer to it.</p>
        else
          <al-button variant="destructive" type="submit">Delete</al-button>}
      </form>
      <div slot="actions">
        <a href={Tags.Delete.Delete { id: model.row.id }}>See the details</a>
      </div>
    </al-dialog>
    <a href={Tags.Index.Index {}}>All tags</a>
  </Layout.Page>

-- @resource begin tests
test "the page shows the row" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let r <- Test.open (Show { id: tag1 })
  let page <- Test.get (Show { id: tag1 })
  Task.succeed (
    {
      answer: r.answer,
      name: List.member "name-1" (Test.texts "#fields dd" r.doc),
      posts: List.length page.model.labels.posts,
      postLabel: postLabel page.model.labels post1,
    } == {
      answer: Shown,
      name: True,
      posts: 1,
      postLabel: "title-1",
    }
  )
}

test "another user's post is not named" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let other <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: other,
  }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let page <- Test.get (Show { id: tag1 })
  Task.succeed (List.length page.model.labels.posts == 0)
}

test "deleting a tag nothing refers to" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let page <- Test.get (Show { id: tag1 })
  let r <- Test.submit (Tags.Delete.Destroy { id: tag1 }) {}
  let gone <- Db.get Tag tag1
  Task.succeed (
    {
      button: Test.count "#delete al-button" page.doc,
      answer: r.answer,
      notices: r.notices,
      gone: Maybe.map (\row -> row.id) gone,
    } == {
      button: 1,
      answer: Redirected (Tags.Index.Index {}),
      notices: ["Deleted"],
      gone: Nothing,
    }
  )
}

test "a missing row is not found" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let r <- Test.open (Show { id: Tag.TagId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "any signed-in user sees the row" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let other <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let _ <- Test.login { user: Just other }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let _ <- Test.login { user: Just me }
  let r <- Test.open (Show { id: tag1 })
  Task.succeed (
    { answer: r.answer, fields: Test.count "#fields dd" r.doc } == { answer: Shown, fields: 4 }
  )
}

test "a visitor is sent to log in" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let r <- Test.open (Show { id: tag1 })
  Task.succeed (r.answer == Redirected (Auth.Login.Login {}))
}
-- @resource end
