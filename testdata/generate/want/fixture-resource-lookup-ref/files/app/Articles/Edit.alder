-- generated by `alder new resource Article --module Articles --path /articles`; regions between
-- `-- @resource begin <name>` / `-- @resource end` are rewritten by `alder regen resource`
module Articles.Edit

-- @resource begin imports
import Layout
import Table.Article
import Table.Category
import Table.User
-- @resource end

-- @resource begin routes
route Edit = GET "/articles/{id}/edit" { id: Article.ArticleId, findCategory: Text = "" } requires user
route Save = PUT "/articles/{id}"      { id: Article.ArticleId } form ArticleForm         requires user
-- @resource end

type Model = {
  row: Article,
  -- @resource begin model
  categories: List Category,
  categoriesTotal: Int,
  findCategory: Text,
  -- @resource end
}

Edit.load : Edit.Params -> Session -> Query Model
Edit.load params session = {
  -- @resource begin load
  let row <- Db.getMine Article params.id
  -- every user's rows: Category has no owner
  let findCategory = Text.slice 0 200 params.findCategory
  let categoriesTotal <- Db.from Category |> Db.count
  let categoriesOwn <-
    if categoriesTotal > 200 then
      Db.from Category
        |> Db.where (Category.id.eq row.category)
        |> Db.all
    else
      Query.succeed []
  let categoriesFound <-
    Db.from Category
      |> Db.orderBy Category.name.asc
      |> Db.where (
        if categoriesTotal > 200 then
          Db.and [Category.name.contains findCategory, Category.id.ne row.category]
        else
          Db.and []
      )
      |> Db.limit (if categoriesTotal > 200 then 50 else 200)
      |> Db.all
  let categories = categoriesOwn ++ categoriesFound
  Query.succeed {
    row: row,
    categories: categories,
    categoriesTotal: categoriesTotal,
    findCategory: findCategory,
  }
  -- @resource end
}

-- @resource begin form
form ArticleForm = { title: Text.NonEmpty, category: Category.CategoryId }
-- @resource end

-- @resource begin search
-- @resource end

-- Save writes the form over the row (another user's, or one deleted since, is not found) and goes
-- to its page.
Save.update : Save.Params -> Session -> Task Response
Save.update params session = {
  -- @resource begin update
  let _ <- Db.updateMine Article params.id (\r -> { r |
    title: params.form.title,
    category: params.form.category
  })
  Task.succeed (Response.redirect (Articles.Show.Show { id: params.id }))
  -- @resource end
}

Edit.view : Model -> Session -> Html
Edit.view model session =
  <Layout.Page title="Edit article">
    <h1>Edit article</h1>

    <al-card>
      -- @resource begin finder
      {if model.categoriesTotal > 200 then
        <form method="get" action={"/articles/" ++ model.row.id ++ "/edit"}>
          <al-input>
            <label>
              Find category <input type="search" name="findCategory" value={model.findCategory} />
            </label>
          </al-input>
          <al-button type="submit" variant="secondary">Find</al-button>
        </form>
      else
        Html.none}
      -- @resource end
      <form submit={Save { id: model.row.id }}>
        -- @resource begin inputs
        <al-input field="title" label="Title" value={model.row.title} />
        <al-select
          field="category"
          label="Category"
          options={List.map (\r -> { value: r.id, label: r.name }) model.categories}
          value={model.row.category} />
        -- @resource end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Save</al-button>
      </form>
    </al-card>
    <a href={Articles.Show.Show { id: model.row.id }}>Back</a>
  </Layout.Page>

-- @resource begin tests
test "saving changes every field" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let category1 <- Db.insert Category { name: Text.NonEmpty "name-1" }
  let article1 <- Db.insert Article {
    title: Text.NonEmpty "title-1",
    owner: me,
    category: category1,
  }
  let category2 <- Db.insert Category { name: Text.NonEmpty "name-2" }
  let page <- Test.get (Edit { id: article1 })
  let r <- Test.submit (Save { id: article1 }) {
    title: Text.NonEmpty "title-2",
    category: category2,
  }
  let after <- Db.get Article article1
  Task.succeed (
    {
      answer: r.answer,
      row: Maybe.map (\row -> { title: row.title, category: row.category }) after,
      categories: Test.texts "select[name=category] option" page.doc,
    } == {
      answer: Redirected (Articles.Show.Show { id: article1 }),
      row: Just { title: Text.NonEmpty "title-2", category: category2 },
      categories: ["name-1", "name-2"],
    }
  )
}

test "a category not offered is refused" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let category1 <- Db.insert Category { name: Text.NonEmpty "name-1" }
  let article1 <- Db.insert Article {
    title: Text.NonEmpty "title-1",
    owner: me,
    category: category1,
  }
  let category2 <- Db.insert Category { name: Text.NonEmpty "name-2" }
  let page <- Test.get (Edit { id: article1 })
  let r <- Test.submitRaw (Save { id: article1 }) [
    { name: "title", value: "x" },
    { name: "category", value: "missing" },
  ]
  let after <- Db.get Article article1
  Task.succeed (
    { answer: r.answer, category: Maybe.map (\row -> row.category) after }
      == {
        answer: FormRejected [{ field: "category", message: "must be one of the options" }],
        category: Just category1,
      }
  )
}

test "a list of 200 categories is offered whole" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let category1 <- Db.insert Category { name: Text.NonEmpty "name-1" }
  let article1 <- Db.insert Article {
    title: Text.NonEmpty "title-1",
    owner: me,
    category: category1,
  }
  let category2 <- Db.insert Category { name: Text.NonEmpty "name-2" }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Category { name: Text.NonEmpty ("name-" ++ Text.fromInt n) }) (
        List.range 3 200
      )
    )
  let page <- Test.get (Edit { id: article1 })
  Task.succeed (List.length page.model.categories == 200)
}

test "a long list of categories offers 50, and the search narrows it" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let category1 <- Db.insert Category { name: Text.NonEmpty "name-1" }
  let article1 <- Db.insert Article {
    title: Text.NonEmpty "title-1",
    owner: me,
    category: category1,
  }
  let category2 <- Db.insert Category { name: Text.NonEmpty "name-2" }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Category { name: Text.NonEmpty ("name-" ++ Text.fromInt n) }) (
        List.range 3 203
      )
    )
  let all <- Test.get (Edit { id: article1 })
  let found <- Test.get (Edit { id: article1, findCategory: "name-203" })
  Task.succeed (
    {
      shown: List.length all.model.categories,
      total: all.model.categoriesTotal,
      found: Test.count "select[name=category] option" found.doc <= 3,
      input: Test.attr "value" "input[name=findCategory]" found.doc,
    } == {
      shown: 51,
      total: 203,
      found: True,
      input: Just "name-203",
    }
  )
}

test "the row's own category is offered first when it sorts past the 50" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let category1 <- Db.insert Category { name: Text.NonEmpty "zz-1" }
  let article1 <- Db.insert Article {
    title: Text.NonEmpty "title-1",
    owner: me,
    category: category1,
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Category { name: Text.NonEmpty ("name-" ++ Text.fromInt n) }) (
        List.range 2 202
      )
    )
  let page <- Test.get (Edit { id: article1 })
  let r <- Test.submit (Save { id: article1 }) {
    title: page.model.row.title,
    category: page.model.row.category,
  }
  let after <- Db.get Article article1
  Task.succeed (
    {
      answer: r.answer,
      kept: Maybe.map (\row -> row.category) after,
      first: Maybe.map (\o -> o.id) (List.head page.model.categories),
      once: List.length (List.filter (\o -> o.id == category1) page.model.categories),
      shown: List.length page.model.categories,
    } == {
      answer: Redirected (Articles.Show.Show { id: article1 }),
      kept: Just category1,
      first: Just category1,
      once: 1,
      shown: 51,
    }
  )
}

test "a visitor cannot save an article" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let category1 <- Db.insert Category { name: Text.NonEmpty "name-1" }
  let article1 <- Db.insert Article {
    title: Text.NonEmpty "title-1",
    owner: me,
    category: category1,
  }
  let category2 <- Db.insert Category { name: Text.NonEmpty "name-2" }
  let before <- Db.get Article article1
  let _ <- Test.get (Edit { id: article1 })
  let _ <- Test.login { user: Nothing }
  let r <- Test.submit (Save { id: article1 }) {
    title: Text.NonEmpty "title-2",
    category: category2,
  }
  let after <- Db.get Article article1
  Task.succeed (
    { answer: r.answer, row: after } == { answer: Redirected (Auth.Login.Login {}), row: before }
  )
}

test "another user cannot save it" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let other <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let category1 <- Db.insert Category { name: Text.NonEmpty "name-1" }
  let article1 <- Db.insert Article {
    title: Text.NonEmpty "title-1",
    owner: other,
    category: category1,
  }
  let category2 <- Db.insert Category { name: Text.NonEmpty "name-2" }
  let before <- Db.get Article article1
  let _ <- Test.login { user: Just other }
  let _ <- Test.get (Edit { id: article1 })
  let _ <- Test.login { user: Just me }
  let r <- Test.submit (Save { id: article1 }) {
    title: Text.NonEmpty "title-2",
    category: category2,
  }
  let after <- Db.get Article article1
  Task.succeed (
    { answer: r.answer, row: after } == { answer: RequestFailed "400 bad request", row: before }
  )
}

test "Save itself does not change another user's row" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let other <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let category1 <- Db.insert Category { name: Text.NonEmpty "name-1" }
  let article1 <- Db.insert Article {
    title: Text.NonEmpty "title-1",
    owner: other,
    category: category1,
  }
  let category2 <- Db.insert Category { name: Text.NonEmpty "name-2" }
  let before <- Db.get Article article1
  let r <-
    Test.run (Save.update {
      id: article1,
      form: { title: Text.NonEmpty "title-2", category: category2 },
    } { user: me, role: Reader })
  let after <- Db.get Article article1
  Task.succeed (
    {
      value: r.value,
      wrote: List.member "Db.updateMine Article" r.trace,
      row: after,
    } == {
      value: Err "not found",
      wrote: True,
      row: before,
    }
  )
}

test "a missing row is not found" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let r <- Test.open (Edit { id: Article.ArticleId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "another user's row: the edit page is not found" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let other <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let category1 <- Db.insert Category { name: Text.NonEmpty "name-1" }
  let article1 <- Db.insert Article {
    title: Text.NonEmpty "title-1",
    owner: other,
    category: category1,
  }
  let r <- Test.open (Edit { id: article1 })
  Task.succeed (r.answer == PageMissing)
}

test "a visitor is sent to log in" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let category1 <- Db.insert Category { name: Text.NonEmpty "name-1" }
  let article1 <- Db.insert Article {
    title: Text.NonEmpty "title-1",
    owner: me,
    category: category1,
  }
  let r <- Test.open (Edit { id: article1 })
  Task.succeed (r.answer == Redirected (Auth.Login.Login {}))
}
-- @resource end
