-- generated by `alder new resource Article --module Articles --path /articles`; regions between
-- `-- @resource begin <name>` / `-- @resource end` are rewritten by `alder regen resource`
module Articles.New

-- @resource begin imports
import Layout
import Table.Article
import Table.Category
import Table.User
-- @resource end

-- @resource begin routes
route New    = GET  "/articles/new" { findCategory: Text = "" } requires user
route Create = POST "/articles"     { } form ArticleForm        requires user
-- @resource end

type Model = {
  -- @resource begin model
  categories: List Category,
  categoriesTotal: Int,
  findCategory: Text,
  -- @resource end
}

New.load : New.Params -> Session -> Query Model
New.load params session = {
  -- @resource begin load
  -- every user's rows: Category has no owner
  let findCategory = Text.slice 0 200 params.findCategory
  let categoriesTotal <- Db.from Category |> Db.count
  let categories <-
    Db.from Category
      |> Db.orderBy Category.name.asc
      |> Db.where (if categoriesTotal > 200 then Category.name.contains findCategory else Db.and [])
      |> Db.limit (if categoriesTotal > 200 then 50 else 200)
      |> Db.all
  Query.succeed {
    categories: categories,
    categoriesTotal: categoriesTotal,
    findCategory: findCategory,
  }
  -- @resource end
}

-- @resource begin form
form ArticleForm = { title: Text.NonEmpty, category: Category.CategoryId }
-- @resource end

-- @resource begin search
-- @resource end

-- Create adds the row and goes to its page.
Create.post : Create.Params -> Session -> Task Response
Create.post params session = {
  -- @resource begin insert
  let id <- Db.insertMine Article { title: params.form.title, category: params.form.category }
  Task.succeed (Response.redirect (Articles.Show.Show { id: id }))
  -- @resource end
}

New.view : Model -> Session -> Html
New.view model session =
  <Layout.Page title="New article">
    <h1>New article</h1>

    <al-card>
      -- @resource begin finder
      {if model.categoriesTotal > 200 then
        <form method="get" action="/articles/new">
          <al-input>
            <label>
              Find category <input type="search" name="findCategory" value={model.findCategory} />
            </label>
          </al-input>
          <al-button type="submit" variant="secondary">Find</al-button>
        </form>
      else
        Html.none}
      -- @resource end
      <form submit={Create}>
        -- @resource begin inputs
        <al-input field="title" label="Title" />
        <al-select
          field="category"
          label="Category"
          options={List.map (\r -> { value: r.id, label: r.name }) model.categories} />
        -- @resource end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Create</al-button>
      </form>
    </al-card>
  </Layout.Page>

-- @resource begin tests
test "creating adds a row that is mine" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let category1 <- Db.insert Category { name: Text.NonEmpty "name-1" }
  let category2 <- Db.insert Category { name: Text.NonEmpty "name-2" }
  let page <- Test.get (New {})
  let r <- Test.submit Create { title: Text.NonEmpty "title-1", category: category2 }
  let rows <- Db.from Article |> Db.all
  Task.succeed (
    {
      answers: List.map (\row -> Redirected (Articles.Show.Show { id: row.id })) rows,
      rows: List.map (\row -> {
        title: row.title,
        category: row.category,
        owner: row.owner,
      }) rows,
      categories: Test.texts "select[name=category] option" page.doc,
    } == {
      answers: [r.answer],
      rows: [
        {
          title: Text.NonEmpty "title-1",
          category: category2,
          owner: me,
        },
      ],
      categories: ["name-1", "name-2"],
    }
  )
}

test "an empty title is rejected" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let category1 <- Db.insert Category { name: Text.NonEmpty "name-1" }
  let category2 <- Db.insert Category { name: Text.NonEmpty "name-2" }
  let page <- Test.get (New {})
  let categoryId = Maybe.withDefault "" (Test.attr "value" "select[name=category] option" page.doc)
  let r <- Test.submitRaw Create [
    { name: "title", value: "" },
    { name: "category", value: categoryId },
  ]
  let rows <- Db.mine Article |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows }
      == { answer: FormRejected [{ field: "title", message: "must not be empty" }], rows: 0 }
  )
}

test "a category not offered is refused" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let category1 <- Db.insert Category { name: Text.NonEmpty "name-1" }
  let category2 <- Db.insert Category { name: Text.NonEmpty "name-2" }
  let page <- Test.get (New {})
  let r <- Test.submitRaw Create [
    { name: "title", value: "x" },
    { name: "category", value: "missing" },
  ]
  let rows <- Db.from Article |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows }
      == {
        answer: FormRejected [{ field: "category", message: "must be one of the options" }],
        rows: 0,
      }
  )
}

test "a list of 200 categories is offered whole" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let category1 <- Db.insert Category { name: Text.NonEmpty "name-1" }
  let category2 <- Db.insert Category { name: Text.NonEmpty "name-2" }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Category { name: Text.NonEmpty ("name-" ++ Text.fromInt n) }) (
        List.range 3 200
      )
    )
  let page <- Test.get (New {})
  Task.succeed (List.length page.model.categories == 200)
}

test "a long list of categories offers 50, and the search narrows it" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let category1 <- Db.insert Category { name: Text.NonEmpty "name-1" }
  let category2 <- Db.insert Category { name: Text.NonEmpty "name-2" }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Category { name: Text.NonEmpty ("name-" ++ Text.fromInt n) }) (
        List.range 3 203
      )
    )
  let all <- Test.get (New {})
  let found <- Test.get (New { findCategory: "name-203" })
  Task.succeed (
    {
      shown: List.length all.model.categories,
      total: all.model.categoriesTotal,
      found: Test.texts "select[name=category] option" found.doc == ["name-203"],
      input: Test.attr "value" "input[name=findCategory]" found.doc,
    } == {
      shown: 50,
      total: 203,
      found: True,
      input: Just "name-203",
    }
  )
}

test "a category outside the narrowed list is refused" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let category1 <- Db.insert Category { name: Text.NonEmpty "name-1" }
  let category2 <- Db.insert Category { name: Text.NonEmpty "name-2" }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Category { name: Text.NonEmpty ("name-" ++ Text.fromInt n) }) (
        List.range 3 203
      )
    )
  let all <- Test.get (New {})
  let found <- Test.get (New { findCategory: "name-203" })
  let pick = Maybe.withDefault "" (Test.attr "value" "select[name=category] option" found.doc)
  let page <- Test.get (New {})
  let sent <- Test.submitRaw Create [
    { name: "title", value: "x" },
    { name: "category", value: pick },
  ]
  let rows <- Db.from Article |> Db.count
  Task.succeed (
    { answer: sent.answer, rows: rows }
      == {
        answer: FormRejected [{ field: "category", message: "must be one of the options" }],
        rows: 0,
      }
  )
}

test "a visitor cannot create an article" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let category1 <- Db.insert Category { name: Text.NonEmpty "name-1" }
  let category2 <- Db.insert Category { name: Text.NonEmpty "name-2" }
  let _ <- Test.get (New {})
  let _ <- Test.login { user: Nothing }
  let r <- Test.submit Create { title: Text.NonEmpty "title-1", category: category2 }
  let rows <- Db.from Article |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows } == { answer: Redirected (Auth.Login.Login {}), rows: 0 }
  )
}

test "a visitor is sent to log in" = {
  let r <- Test.open (New {})
  Task.succeed (r.answer == Redirected (Auth.Login.Login {}))
}
-- @resource end
