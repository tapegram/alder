-- generated by `alder new resource Article --module Articles --path /articles`; regions between
-- `-- @resource begin <name>` / `-- @resource end` are rewritten by `alder regen resource`
module Articles.Show

-- @resource begin imports
import Layout
import Table.Article
import Table.Category
import Table.User
-- @resource end

-- @resource begin routes
route Show = GET "/articles/{id}" { id: Article.ArticleId } requires user
-- @resource end

-- The row, the labels of the rows it refers to, and (for the delete dialog) how many rows of
-- each table refer to it.
type Model = {
  row: Article,
  labels: Labels,
  -- @resource begin model
  -- @resource end
}

Show.load : Show.Params -> Session -> Query Model
Show.load params session = {
  -- @resource begin load
  let row <- Db.getMine Article params.id
  let labels <- labelsOf [row]
  Query.succeed { row: row, labels: labels }
  -- @resource end
}

-- @resource begin labels
-- Labels are the rows the references of the rows shown name: their links show their labels.
type Labels = { owners: List User, categories: List Category }

-- labelsOf reads the rows that rows refer to.
labelsOf : List Article -> Query Labels
labelsOf rows = {
  -- every user's rows: User has no owner
  let owners <-
    Db.from User
      |> Db.where (User.id.in (List.map (\row -> row.owner) rows))
      |> Db.all
  -- every user's rows: Category has no owner
  let categories <-
    Db.from Category
      |> Db.where (Category.id.in (List.map (\row -> row.category) rows))
      |> Db.all
  Query.succeed { owners: owners, categories: categories }
}

-- ownerLabel is the label of the user id names (the id itself if it names none).
ownerLabel : Labels -> User.UserId -> Text
ownerLabel labels id = match List.find (\r -> r.id == id) labels.owners {
  Just r -> r.name,
  Nothing -> id,
}

-- categoryLabel is the label of the category id names (the id itself if it names none).
categoryLabel : Labels -> Category.CategoryId -> Text
categoryLabel labels id = match List.find (\r -> r.id == id) labels.categories {
  Just r -> r.name,
  Nothing -> id,
}
-- @resource end

-- @resource begin blockers
-- blockers counts the rows that keep this one from being deleted, which the database would
-- refuse the delete for: the `@restrict` references to it, or to a row deleted with it.
blockers : Model -> Int
blockers model = 0
-- @resource end

Show.view : Model -> Session -> Html
Show.view model session =
  <Layout.Page title="Article">
    <h1>Article</h1>

    <al-card>
      <dl id="fields">
        -- @resource begin fields
        <dt>Id</dt>
        <dd>{model.row.id}</dd>
        <dt>Title</dt>
        <dd>{model.row.title}</dd>
        <dt>Owner</dt>
        <dd>{ownerLabel model.labels model.row.owner}</dd>
        <dt>Category</dt>
        <dd>{categoryLabel model.labels model.row.category}</dd>
        <dt>Created</dt>
        <dd>{Time.format "Jan 2, 2006" model.row.created}</dd>
        <dt>Updated</dt>
        <dd>{Time.format "Jan 2, 2006" model.row.updated}</dd>
        -- @resource end
      </dl>
      <div slot="actions">
        <al-button href={Articles.Edit.Edit { id: model.row.id }}>Edit</al-button>
        <al-button variant="destructive">
          <button type="button" commandfor="delete-dialog" command="show-modal">Delete</button>
        </al-button>
      </div>
    </al-card>
    <al-dialog id="delete-dialog" heading="Delete this article?" dismissible>
      <dl>
        -- @resource begin counts
        -- @resource end
      </dl>
      <form id="delete" submit={Articles.Delete.Destroy { id: model.row.id }}>
        <al-alert variant="destructive"><Errors form /></al-alert>
        {if blockers model > 0 then
          <p>It cannot be deleted while other rows refer to it.</p>
        else
          <al-button variant="destructive" type="submit">Delete</al-button>}
      </form>
      <div slot="actions">
        <a href={Articles.Delete.Delete { id: model.row.id }}>See the details</a>
      </div>
    </al-dialog>
    <a href={Articles.Index.Index {}}>All articles</a>
  </Layout.Page>

-- @resource begin tests
test "the page shows the row" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let category1 <- Db.insert Category { name: Text.NonEmpty "name-1" }
  let article1 <- Db.insert Article {
    title: Text.NonEmpty "title-1",
    owner: me,
    category: category1,
  }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let category2 <- Db.insert Category { name: Text.NonEmpty "name-2" }
  let r <- Test.open (Show { id: article1 })
  let page <- Test.get (Show { id: article1 })
  Task.succeed (
    {
      answer: r.answer,
      title: List.member "title-1" (Test.texts "#fields dd" r.doc),
      owners: List.length page.model.labels.owners,
      ownerLabel: ownerLabel page.model.labels me,
      categories: List.length page.model.labels.categories,
      categoryLabel: categoryLabel page.model.labels category1,
    } == {
      answer: Shown,
      title: True,
      owners: 1,
      ownerLabel: "name-1",
      categories: 1,
      categoryLabel: "name-1",
    }
  )
}

test "deleting an article nothing refers to" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let category1 <- Db.insert Category { name: Text.NonEmpty "name-1" }
  let article1 <- Db.insert Article {
    title: Text.NonEmpty "title-1",
    owner: me,
    category: category1,
  }
  let page <- Test.get (Show { id: article1 })
  let r <- Test.submit (Articles.Delete.Destroy { id: article1 }) {}
  let gone <- Db.get Article article1
  Task.succeed (
    {
      button: Test.count "#delete al-button" page.doc,
      answer: r.answer,
      notices: r.notices,
      gone: Maybe.map (\row -> row.id) gone,
    } == {
      button: 1,
      answer: Redirected (Articles.Index.Index {}),
      notices: ["Deleted"],
      gone: Nothing,
    }
  )
}

test "a missing row is not found" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let r <- Test.open (Show { id: Article.ArticleId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "another user's row is not found" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let other <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let category1 <- Db.insert Category { name: Text.NonEmpty "name-1" }
  let article1 <- Db.insert Article {
    title: Text.NonEmpty "title-1",
    owner: other,
    category: category1,
  }
  let r <- Test.open (Show { id: article1 })
  Task.succeed (r.answer == PageMissing)
}

test "a visitor is sent to log in" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let category1 <- Db.insert Category { name: Text.NonEmpty "name-1" }
  let article1 <- Db.insert Article {
    title: Text.NonEmpty "title-1",
    owner: me,
    category: category1,
  }
  let r <- Test.open (Show { id: article1 })
  Task.succeed (r.answer == Redirected (Auth.Login.Login {}))
}
-- @resource end
