module Projects.Index

import Layout
import Org
import Project
import User

page "/projects" { page: Int = 1 } requires user, org

type Model = { rows: List Project, page: Int, pages: Int }

perPage : Int
perPage = 20

-- lastPage bounds `page`, so `(page - 1) * perPage` cannot overflow.
lastPage : Int
lastPage = 1000000

-- load reads one page of the rows, newest first, and how many pages there are.
load : Params -> Session -> Query Model
load params session = {
  let page = Int.clamp { min: 1, max: lastPage } params.page
  let rows <-
    Db.scoped Project
      |> Db.orderBy Project.created.desc
      |> Db.limit perPage
      |> Db.offset ((page - 1) * perPage)
      |> Db.all
  let count <- Db.scoped Project |> Db.count
  Query.succeed { rows: rows, page: page, pages: Int.max 1 ((count + perPage - 1) / perPage) }
}

view : Model -> Session -> Html Msg
view model session =
  <Layout.Page title="Projects">
    <h1>Projects</h1>

    <al-table>
      <table>
        <thead>
          <tr><th>Name</th><th>Archived</th><th>Org</th><th>Created</th></tr>
        </thead>
        <tbody>
          {for row in model.rows ->
            <tr>
              <td>{row.name}</td>
              <td>{if row.archived then <al-badge>Yes</al-badge> else <al-badge variant="secondary">No</al-badge>}</td>
              <td>{row.org}</td>
              <td>{Time.format "Jan 2, 2006" row.created}</td>
            </tr>}
        </tbody>
      </table>
    </al-table>

    <al-pagination role="navigation" aria-label="Pages">
      {if model.page > 1 then <a slot="prev" href={Projects.Index { page: model.page - 1 }} rel="prev">Previous</a> else <span slot="prev" aria-disabled="true">Previous</span>}
      <span>Page {Text.fromInt model.page} of {Text.fromInt model.pages}</span>
      {if model.page < model.pages then <a slot="next" href={Projects.Index { page: model.page + 1 }} rel="next">Next</a> else <span slot="next" aria-disabled="true">Next</span>}
    </al-pagination>
  </Layout.Page>

test "the list shows this org's rows, newest first" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let other <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let _ <- Db.insert Project { name: Text.NonEmpty "name-1", org: other }
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org }
  let project2 <- Db.insert Project { name: Text.NonEmpty "name-2", org: org }
  let project3 <- Db.insert Project { name: Text.NonEmpty "name-3", org: org }
  let page <- Test.get (Projects.Index {})
  Task.succeed (List.map (\row -> row.id) page.model.rows == [project3, project2])
}

test "the list has 20 rows a page" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org }
  let _ <- Task.all (List.map (\n -> Db.insert Project { name: Text.NonEmpty ("name-" ++ Text.fromInt n), org: org }) (List.range 1 21))
  let first <- Test.get (Projects.Index {})
  let second <- Test.get (Projects.Index { page: 2 })
  Task.succeed ({ first: List.length first.model.rows, second: List.length second.model.rows, pages: Test.texts "al-pagination span" first.doc } == { first: 20, second: 1, pages: ["Previous", "Page 1 of 2"] })
}

test "a visitor is sent to log in" = {
  let r <- Test.open (Projects.Index {})
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "without an org the page sends you to choose one" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me, org: Nothing }
  let r <- Test.open (Projects.Index {})
  Task.succeed (r.answer == Redirected (Orgs {}))
}
