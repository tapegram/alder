-- generated by `alder new resource Post --module Posts --path /posts --read owner`; regions between
-- `-- @resource begin <name>` / `-- @resource end` are rewritten by `alder regen resource`
module Posts.Edit

-- @resource begin imports
import Layout
import Table.Post
import Table.User
-- @resource end

-- @resource begin routes
route Edit = GET "/posts/{id}/edit" { id: Post.PostId }               requires user
route Save = PUT "/posts/{id}"      { id: Post.PostId } form PostForm requires user
-- @resource end

type Model = {
  row: Post,
  -- @resource begin model
  -- @resource end
}

Edit.load : Edit.Params -> Session -> Query Model
Edit.load params session = {
  -- @resource begin load
  let row <- Db.getMine Post params.id
  Query.succeed { row: row }
  -- @resource end
}

-- @resource begin form
form PostForm = {
  title: Text.NonEmpty,
  body: Text,
  status: Post.Status,
  featured: Bool,
}
-- @resource end

-- @resource begin search
-- @resource end

-- Save writes the form over the row (another user's, or one deleted since, is not found) and goes
-- to its page.
Save.update : Save.Params -> Session -> Task Response
Save.update params session = {
  -- @resource begin update
  let _ <- Db.updateMine Post params.id (\r -> { r |
    title: params.form.title,
    body: params.form.body,
    status: params.form.status,
    featured: params.form.featured
  })
  Task.succeed (Response.redirect (Posts.Show.Show { id: params.id }))
  -- @resource end
}

Edit.view : Model -> Session -> Html
Edit.view model session =
  <Layout.Page title="Edit post">
    <h1>Edit post</h1>

    <al-card>
      -- @resource begin finder
      -- @resource end
      <form submit={Save { id: model.row.id }}>
        -- @resource begin inputs
        <al-input field="title" label="Title" value={model.row.title} />
        <al-textarea field="body" label="Body" value={model.row.body} />
        <al-select field="status" label="Status" value={model.row.status} />
        <al-checkbox field="featured" label="Featured" value={model.row.featured} />
        -- @resource end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Save</al-button>
      </form>
    </al-card>
    <a href={Posts.Show.Show { id: model.row.id }}>Back</a>
  </Layout.Page>

-- @resource begin tests
test "saving changes every field" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let page <- Test.get (Edit { id: post1 })
  let r <- Test.submit (Save { id: post1 }) {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    status: Published,
    featured: True,
  }
  let after <- Db.get Post post1
  Task.succeed (
    {
      answer: r.answer,
      row: Maybe.map (\row -> {
        title: row.title,
        body: row.body,
        status: row.status,
        featured: row.featured,
      }) after,
    } == {
      answer: Redirected (Posts.Show.Show { id: post1 }),
      row: Just {
        title: Text.NonEmpty "title-2",
        body: "body-2",
        status: Published,
        featured: True,
      },
    }
  )
}

test "a visitor cannot save a post" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let before <- Db.get Post post1
  let _ <- Test.get (Edit { id: post1 })
  let _ <- Test.login { user: Nothing }
  let r <- Test.submit (Save { id: post1 }) {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    status: Published,
    featured: True,
  }
  let after <- Db.get Post post1
  Task.succeed (
    { answer: r.answer, row: after } == { answer: Redirected (Auth.Login.Login {}), row: before }
  )
}

test "another user cannot save it" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let other <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: other,
  }
  let before <- Db.get Post post1
  let _ <- Test.login { user: Just other }
  let _ <- Test.get (Edit { id: post1 })
  let _ <- Test.login { user: Just me }
  let r <- Test.submit (Save { id: post1 }) {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    status: Published,
    featured: True,
  }
  let after <- Db.get Post post1
  Task.succeed ({ answer: r.answer, row: after } == { answer: PageMissing, row: before })
}

test "a missing row is not found" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let r <- Test.open (Edit { id: Post.PostId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "another user's row: the edit page is not found" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let other <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: other,
  }
  let r <- Test.open (Edit { id: post1 })
  Task.succeed (r.answer == PageMissing)
}

test "a visitor is sent to log in" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let r <- Test.open (Edit { id: post1 })
  Task.succeed (r.answer == Redirected (Auth.Login.Login {}))
}
-- @resource end
