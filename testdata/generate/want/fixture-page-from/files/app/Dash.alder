module Dash

import Layout
import Post
import Tag
import User

page "/dash" { } requires user

type Model = { posts: List Post, tags: List Tag }

load : Params -> Session -> Query Model
load params session = {
  let posts <- Db.mine Post |> Db.all
  let tags <- Db.from Tag |> Db.all
  Query.succeed { posts: posts, tags: tags }
}

view : Model -> Session -> Html Msg
view model session =
  <Layout.Page title="Dash">
    <h1>Dash</h1>

    <al-card>
      <h2 slot="header">Posts</h2>
      <ul id="posts">
        {for row in model.posts -> <li>{row.title}</li>}
      </ul>
    </al-card>

    <al-card>
      <h2 slot="header">Tags</h2>
      <ul id="tags">
        {for row in model.tags -> <li>{row.name}</li>}
      </ul>
    </al-card>
  </Layout.Page>

test "the page shows each table's rows" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let post1 <- Db.insert Post { title: Text.NonEmpty "title-1", body: "body-1", author: me }
  let other <- Db.insert User { email: Text.Email "email-2@example.com", name: Text.NonEmpty "name-2" }
  let post2 <- Db.insert Post { title: Text.NonEmpty "title-2", body: "body-2", author: other }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let page <- Test.get (Dash {})
  Task.succeed ({ heading: Test.text "h1" page.doc, posts: Test.count "#posts li" page.doc, tags: Test.count "#tags li" page.doc } == { heading: Just "Dash", posts: 1, tags: 1 })
}

test "a visitor is sent to log in" = {
  let r <- Test.open (Dash {})
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}
