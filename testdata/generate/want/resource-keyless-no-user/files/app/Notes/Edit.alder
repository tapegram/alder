-- generated by `alder new resource Note --module Notes --path /notes --read all`; regions between
-- `-- @resource begin <name>` / `-- @resource end` are rewritten by `alder regen resource`
module Notes.Edit

-- @resource begin imports
import Layout
import Table.Note
-- @resource end

-- @resource begin routes
route Edit = GET "/notes/{id}/edit" { id: Note.NoteId }
route Save = PUT "/notes/{id}"      { id: Note.NoteId } form NoteForm
-- @resource end

type Model = {
  row: Note,
  -- @resource begin model
  -- @resource end
}

Edit.load : Edit.Params -> Session -> Query Model
Edit.load params session = {
  -- @resource begin load
  let found <- Db.get Note params.id
  match found {
    Just row -> { Query.succeed { row: row } },
    Nothing -> Query.notFound,
  }
  -- @resource end
}

-- @resource begin form
form NoteForm = { title: Text.NonEmpty }
-- @resource end

-- @resource begin search
-- @resource end

-- Save writes the form over the row (a row deleted since is not found) and goes to its page.
Save.update : Save.Params -> Session -> Task Response
Save.update params session = {
  let found <- Db.get Note params.id
  match found {
    Just row -> {
      -- @resource begin update
      let _ <- Db.update Note row.id (\r -> { r | title: params.form.title })
      Task.succeed (Response.redirect (Notes.Show.Show { id: row.id }))
      -- @resource end
    },
    Nothing -> Task.notFound,
  }
}

Edit.view : Model -> Session -> Html
Edit.view model session =
  <Layout.Page title="Edit note">
    <h1>Edit note</h1>

    <al-card>
      -- @resource begin finder
      -- @resource end
      <form submit={Save { id: model.row.id }}>
        -- @resource begin inputs
        <al-input field="title" label="Title" value={model.row.title} />
        -- @resource end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Save</al-button>
      </form>
    </al-card>
    <a href={Notes.Show.Show { id: model.row.id }}>Back</a>
  </Layout.Page>

-- @resource begin tests
test "saving changes every field" = {
  let note1 <- Db.insert Note { title: Text.NonEmpty "title-1" }
  let page <- Test.get (Edit { id: note1 })
  let r <- Test.submit (Save { id: note1 }) { title: Text.NonEmpty "title-2" }
  let after <- Db.get Note note1
  Task.succeed (
    { answer: r.answer, row: Maybe.map (\row -> { title: row.title }) after }
      == {
        answer: Redirected (Notes.Show.Show { id: note1 }),
        row: Just { title: Text.NonEmpty "title-2" },
      }
  )
}

test "a missing row is not found" = {
  let r <- Test.open (Edit { id: Note.NoteId "missing" })
  Task.succeed (r.answer == PageMissing)
}
-- @resource end
