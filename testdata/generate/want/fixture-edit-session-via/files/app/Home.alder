module Home

import Layout
import Table.Post
import Table.User

route Home   = GET  "/"         { }            requires user
route Submit = POST "/_/Submit" { } form Write requires user

type Model = { posts: List Post }

Home.load : Home.Params -> Session -> Query Model
Home.load params session = {
  let posts <-
    Db.mine Post
      |> Db.orderBy Post.created.desc
      |> Db.all
  Query.succeed { posts: posts }
}

form Write = { title: Text.NonEmpty, body: Text }

Submit.update : Submit.Params -> Session -> Task Response
Submit.update p session = {
  let _ <- Db.insertMine Post { title: p.form.title, body: p.form.body }
  Task.succeed (Response.redirect (Home {}))
}

Home.view : Model -> Session -> Html
Home.view model session =
  <Layout.Page title="Your posts">
    <h1>Your posts</h1>

    <ul id="posts">
      {for post in model.posts -> <li>{post.title}</li>}
    </ul>

    <al-card>
      <h2 slot="header">Write a post</h2>
      <form submit={Submit}>
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-input field="title" label="Title" />
        <al-textarea field="body" label="Body" />
        <al-button type="submit">Write</al-button>
      </form>
    </al-card>

    <al-button variant="outline" click={App.Logout}>Log out</al-button>
  </Layout.Page>

test "writing a post lists it, a draft" = {
  let me <- Db.insert User { email: Text.Email "me@example.com", name: Text.NonEmpty "Me" }
  let _ <- Test.login { user: Just me, post: Nothing }
  let _ <- Test.get (Home {})
  let r <- Test.submit Submit { title: Text.NonEmpty "Hello", body: "" }
  let posts <- Db.from Post |> Db.all
  Task.succeed (
    {
      answer: r.answer,
      listed: Test.texts "#posts li" r.doc,
      posts: List.map (\p -> {
        status: p.status,
        featured: p.featured,
        author: p.author,
      }) posts,
    } == {
      answer: Redirected (Home {}),
      listed: ["Hello"],
      posts: [
        {
          status: Draft,
          featured: False,
          author: me,
        },
      ],
    }
  )
}

test "only my posts are listed, newest first" = {
  let me <- Db.insert User { email: Text.Email "me@example.com", name: Text.NonEmpty "Me" }
  let other <- Db.insert User { email: Text.Email "other@example.com", name: Text.NonEmpty "Other" }
  let _ <- Db.insert Post {
    title: Text.NonEmpty "First",
    body: "",
    author: me,
  }
  let _ <- Db.insert Post {
    title: Text.NonEmpty "Theirs",
    body: "",
    author: other,
  }
  let _ <- Db.insert Post {
    title: Text.NonEmpty "Second",
    body: "",
    author: me,
  }
  let _ <- Test.login { user: Just me, post: Nothing }
  let page <- Test.get (Home {})
  Task.succeed (Test.texts "#posts li" page.doc == ["Second", "First"])
}

test "a visitor is sent to log in" = {
  let r <- Test.open (Home {})
  Task.succeed (r.answer == Redirected (Auth.Login.Login {}))
}

-- Submit has its own `requires user`: a post from a page still open after logging out is sent
-- to log in, and nothing is written.
test "writing after logging out is sent to log in" = {
  let me <- Db.insert User { email: Text.Email "me@example.com", name: Text.NonEmpty "Me" }
  let _ <- Test.login { user: Just me, post: Nothing }
  let _ <- Test.get (Home {})
  let _ <- Test.login { user: Nothing, post: Nothing }
  let r <- Test.submit Submit { title: Text.NonEmpty "Hello", body: "" }
  let posts <- Db.from Post |> Db.count
  Task.succeed (
    { answer: r.answer, posts: posts } == { answer: Redirected (Auth.Login.Login {}), posts: 0 }
  )
}

test "logging out signs the user out" = {
  let me <- Db.insert User {
    email: Text.Email "me@example.com",
    name: Text.NonEmpty "Me",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    role: Admin,
    post: Nothing,
  }
  let _ <- Test.get (Home {})
  let out <- Test.click App.Logout
  Task.succeed (
    {
      answer: out.answer,
      user: out.session.user,
      role: out.session.role,
    } == {
      answer: Redirected (Auth.Login.Login {}),
      user: Nothing,
      role: Reader,
    }
  )
}
