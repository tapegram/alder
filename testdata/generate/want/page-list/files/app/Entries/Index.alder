module Entries.Index

import Layout
import Table.Entry

page "/entries" { page: Int = 1 }

type Model = {
  rows: List Entry,
  page: Int,
  pages: Int,
}

perPage : Int
perPage = 20

-- lastPage bounds `page`, so `(page - 1) * perPage` cannot overflow.
lastPage : Int
lastPage = 1000000

-- load reads one page of the rows, newest first, and how many pages there are.
load : Params -> Session -> Query Model
load params session = {
  let page = Int.clamp { min: 1, max: lastPage } params.page
  let rows <-
    Db.from Entry
      |> Db.orderBy Entry.created.desc
      |> Db.limit perPage
      |> Db.offset ((page - 1) * perPage)
      |> Db.all
  let count <- Db.from Entry |> Db.count
  Query.succeed {
    rows: rows,
    page: page,
    pages: Int.max 1 ((count + perPage - 1) / perPage),
  }
}

view : Model -> Session -> Html Msg
view model session =
  <Layout.Page title="Entries">
    <h1>Entries</h1>

    <al-table>
      <table>
        <thead>
          <tr>
            <th>Name</th>
            <th>Message</th>
            <th>Created</th>
          </tr>
        </thead>
        <tbody>
          {for row in model.rows ->
            <tr>
              <td>{row.name}</td>
              <td>{row.message}</td>
              <td>{Time.format "Jan 2, 2006" row.created}</td>
            </tr>}
        </tbody>
      </table>
    </al-table>

    <al-pagination role="navigation" aria-label="Pages">
      {if model.page > 1 then
        <a slot="prev" href={Entries.Index { page: model.page - 1 }} rel="prev">Previous</a>
      else
        <span slot="prev" aria-disabled="true">Previous</span>}
      <span>Page {Text.fromInt model.page} of {Text.fromInt model.pages}</span>
      {if model.page < model.pages then
        <a slot="next" href={Entries.Index { page: model.page + 1 }} rel="next">Next</a>
      else
        <span slot="next" aria-disabled="true">Next</span>}
    </al-pagination>
  </Layout.Page>

test "the list shows the rows, newest first" = {
  let entry1 <- Db.insert Entry { name: Text.NonEmpty "name-1", message: Text.NonEmpty "message-1" }
  let entry2 <- Db.insert Entry { name: Text.NonEmpty "name-2", message: Text.NonEmpty "message-2" }
  let page <- Test.get (Entries.Index {})
  Task.succeed (List.map (\row -> row.id) page.model.rows == [entry2, entry1])
}

test "the list has 20 rows a page" = {
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Entry {
        name: Text.NonEmpty ("name-" ++ Text.fromInt n),
        message: Text.NonEmpty ("message-" ++ Text.fromInt n),
      }) (List.range 1 21)
    )
  let first <- Test.get (Entries.Index {})
  let second <- Test.get (Entries.Index { page: 2 })
  Task.succeed (
    {
      first: List.length first.model.rows,
      second: List.length second.model.rows,
      pages: Test.texts "al-pagination span" first.doc,
    } == {
      first: 20,
      second: 1,
      pages: ["Previous", "Page 1 of 2"],
    }
  )
}
