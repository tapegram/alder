module Posts.Show

import Layout
import Table.Post
import Table.Tag
import Table.User

route Show      = GET  "/posts/{id}" { id: Post.PostId }
route SendReply = POST "/tags"       { id: Post.PostId } form Reply

type Model = { row: Post }

Show.load : Show.Params -> Session -> Query Model
Show.load params session = {
  let found <- Db.get Post params.id
  match found {
    Just row -> Query.succeed { row: row },
    Nothing -> Query.notFound,
  }
}

Show.view : Model -> Session -> Html
Show.view model session =
  <Layout.Page title="Post">
    <h1>Post</h1>

    <al-card>
      <dl>
        <dt>Id</dt>
        <dd>{model.row.id}</dd>
        <dt>Title</dt>
        <dd>{model.row.title}</dd>
        <dt>Body</dt>
        <dd>{model.row.body}</dd>
        <dt>Status</dt>
        <dd>
          <al-badge>
            {match model.row.status {
              Draft -> "Draft",
              Published -> "Published",
            }}
          </al-badge>
        </dd>
        <dt>Featured</dt>
        <dd>
          {if model.row.featured then
            <al-badge>Yes</al-badge>
          else
            <al-badge variant="secondary">No</al-badge>}
        </dd>
        <dt>Author</dt>
        <dd>{model.row.author}</dd>
        <dt>Created</dt>
        <dd>{Time.format "Jan 2, 2006" model.row.created}</dd>
        <dt>Updated</dt>
        <dd>{Time.format "Jan 2, 2006" model.row.updated}</dd>
      </dl>
      <form submit={SendReply { id: model.row.id }}>
        <al-input field="name" label="Name" />
        <al-input field="post" label="Post" />
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Reply</al-button>
      </form>
    </al-card>
  </Layout.Page>

form Reply = { name: Text.NonEmpty, post: Post.PostId }

SendReply.update : SendReply.Params -> Session -> Task Response
SendReply.update params session = {
  let _ <- Db.insert Tag { name: params.form.name, post: params.form.post }
  Task.succeed (Response.redirect (Show { id: params.id }) |> Response.success "Saved")
}

test "the page shows the row" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let r <- Test.open (Show { id: post1 })
  Task.succeed (
    { answer: r.answer, title: List.member "title-1" (Test.texts "dd" r.doc) }
      == { answer: Shown, title: True }
  )
}

test "a missing row is not found" = {
  let r <- Test.open (Show { id: Post.PostId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "submitting Reply adds a row" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let _ <- Test.get (Show { id: post1 })
  let r <- Test.submit (SendReply { id: post1 }) { name: Text.NonEmpty "name-1", post: post1 }
  let rows <- Db.from Tag |> Db.all
  Task.succeed (
    {
      answer: r.answer,
      notices: r.notices,
      rows: List.map (\row -> { name: row.name, post: row.post }) rows,
    } == {
      answer: Redirected (Show { id: post1 }),
      notices: ["Saved"],
      rows: [{ name: Text.NonEmpty "name-1", post: post1 }],
    }
  )
}

test "Reply refuses an empty name" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let _ <- Test.get (Show { id: post1 })
  let r <- Test.submitRaw (SendReply { id: post1 }) [
    { name: "name", value: "" },
    { name: "post", value: "x" },
  ]
  let rows <- Db.from Tag |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows }
      == { answer: FormRejected [{ field: "name", message: "must not be empty" }], rows: 0 }
  )
}
