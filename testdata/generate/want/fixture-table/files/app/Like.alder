module Like

import Post
import User

type LikeId = brand Text

table Like {
  id: LikeId @id,
  post: Post.PostId @ref Post @cascade,
  owner: User.UserId @ref User @owner,
  created: Time @created,
  updated: Time @updated,
}

test "deleting its post deletes a Like" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let target <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let _ <- Db.insert Like { post: target, owner: me }
  let _ <- Db.delete Post target
  let left <- Db.from Like |> Db.count
  Task.succeed (left == 0)
}

test "a Like keeps its owner from being deleted" = {
  let target <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
  }
  let me <- Db.insert User { email: Text.Email "email-2@example.com", name: Text.NonEmpty "name-2" }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let _ <- Db.insert Like { post: post1, owner: target }
  let r <- Test.run (Db.delete User target)
  let left <- Db.from Like |> Db.count
  Task.succeed ({ deleted: Result.toMaybe r.value, left: left } == { deleted: Nothing, left: 1 })
}
