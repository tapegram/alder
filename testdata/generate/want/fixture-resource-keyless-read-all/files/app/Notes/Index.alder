-- generated by `alder new resource Note --module Notes --path /notes --read all`; regions between
-- `-- @resource begin <name>` / `-- @resource end` are rewritten by `alder regen resource`
module Notes.Index

-- @resource begin imports
import Layout
import Table.Note
import Table.User
-- @resource end

-- @resource begin routes
route Index = GET "/notes" { q: Text = "", sort: Text = "created", dir: Text = "desc", page: Int = 1 }
-- @resource end

type Model = {
  rows: List Note,
  labels: Labels,
  q: Text,
  filters: Filters,
  sort: Text,
  dir: Text,
  page: Int,
  pages: Int,
  count: Int,
}

perPage : Int
perPage = 20

-- @resource begin search
-- search is the rows whose text contains q (every row for "").
search : Text -> Condition Note
search q = Db.or [Note.title.contains q]
-- @resource end

-- A Filter is one of the list's selects: the column it filters, the option chosen ("" for any),
-- and each option's value in the address, its label, and the rows it selects.
type Filter = {
  name: Text,
  label: Text,
  value: Text,
  options: List {
    value: Text,
    label: Text,
    rows: Condition Note,
  },
}

-- @resource begin filters
-- Filters are the option each filter has chosen in the address ("" for any): a select for each
-- Bool and union column: this table has none.
type Filters = { }

-- chosen is the filters' options in params.
chosen : Index.Params -> Filters
chosen params = {}

-- filters are the list's filters, each with the option f has chosen.
filters : Filters -> List Filter
filters f = []

-- filtered is the rows that the option each filter has chosen selects (every row for "", or for
-- a value that is no option's).
filtered : List Filter -> Condition Note
filtered fs = Db.and []

-- listAt is this list with the model's search and filters, sorted by sort and dir, at page n.
listAt : Model -> Text -> Text -> Int -> Route
listAt model sort dir n = Index {
  q: model.q,
  sort: sort,
  dir: dir,
  page: n,
}
-- @resource end

-- @resource begin sorts
-- sorts are the columns the list sorts by, by name.
sorts : List {
  name: Text,
  asc: Order Note,
  desc: Order Note,
}
sorts = [
  {
    name: "title",
    asc: Note.title.asc,
    desc: Note.title.desc,
  },
  {
    name: "created",
    asc: Note.created.asc,
    desc: Note.created.desc,
  },
  {
    name: "updated",
    asc: Note.updated.asc,
    desc: Note.updated.desc,
  },
]
-- @resource end

-- order is the ordering sort names, ascending when dir is "asc"; a name that is not a column's
-- sorts newest first.
order : Text -> Text -> Order Note
order sort dir = match List.find (\s -> s.name == sort) sorts {
  Just s -> if dir == "asc" then s.asc else s.desc,
  Nothing -> Note.created.desc,
}

-- toggle is the direction a column's header sorts by: the other way round when the list is
-- sorted by that column ascending.
toggle : Model -> Text -> Text
toggle model sort = if model.sort == sort && model.dir == "asc" then "desc" else "asc"

-- Index.load reads how many rows match the search and the filters, and one page of them (the last,
-- for a page past it), in the order asked for. The search text is cut to 200 characters (Text.slice):
-- a text over 10,000 bytes would fail the query (chapter 8, "Search").
Index.load : Index.Params -> Session -> Query Model
Index.load params session = {
  let q = Text.slice 0 200 params.q
  let f = chosen params
  let count <-
    Db.from Note
      |> Db.where (Db.and [search q, filtered (filters f)])
      |> Db.count
  let pages = Int.max 1 ((count + perPage - 1) / perPage)
  let page = Int.clamp { min: 1, max: pages } params.page
  let rows <-
    Db.from Note
      |> Db.where (Db.and [search q, filtered (filters f)])
      |> Db.orderBy (order params.sort params.dir)
      |> Db.limit perPage
      |> Db.offset ((page - 1) * perPage)
      |> Db.all
  let labels <- labelsOf rows
  Query.succeed {
    rows: rows,
    labels: labels,
    q: q,
    filters: f,
    sort: params.sort,
    dir: params.dir,
    page: page,
    pages: pages,
    count: count,
  }
}

-- @resource begin labels
-- Labels are the rows the references of the rows shown name: their links show their labels.
type Labels = { }

labelsOf : List Note -> Query Labels
labelsOf rows = Query.succeed {}
-- @resource end

Index.view : Model -> Session -> Html
Index.view model session =
  <Layout.Page title="Notes">
    <h1>Notes</h1>

    <al-stack direction="row" gap="sm">
      <form method="get" action="/notes">
        <al-stack direction="row" gap="sm">
          <al-input><label>Search<input type="search" name="q" value={model.q} /></label></al-input>
          {for f in filters model.filters ->
            <al-select label={f.label}>
              <label>
                {f.label}
                <select name={f.name}>
                  <option value="" selected={f.value == ""}>any</option>
                  {for o in f.options ->
                    <option value={o.value} selected={o.value == f.value}>{o.label}</option>}
                </select>
              </label>
            </al-select>}
          <input type="hidden" name="sort" value={model.sort} />
          <input type="hidden" name="dir" value={model.dir} />
          <al-button type="submit" variant="secondary">Search</al-button>
        </al-stack>
      </form>
      <al-button href={Notes.New.New {}}>New note</al-button>
    </al-stack>

    <p id="count">{if model.count == 1 then "1 row" else Text.fromInt model.count ++ " rows"}</p>

    <al-table>
      <table>
        <thead>
          <tr>
            -- @resource begin headers
            <th><a href={listAt model "title" (toggle model "title") 1}>Title</a></th>
            <th><a href={listAt model "created" (toggle model "created") 1}>Created</a></th>
            <th><a href={listAt model "updated" (toggle model "updated") 1}>Updated</a></th>
            -- @resource end
          </tr>
        </thead>
        <tbody>
          {for row in model.rows ->
            <tr>
              -- @resource begin cells
              <td><a href={Notes.Show.Show { id: row.id }}>{row.title}</a></td>
              <td>{Time.format "Jan 2, 2006" row.created}</td>
              <td>{Time.format "Jan 2, 2006" row.updated}</td>
              -- @resource end
            </tr>}
        </tbody>
      </table>
    </al-table>

    <al-pagination role="navigation" aria-label="Pages">
      {if model.page > 1 then
        <a slot="prev" href={listAt model model.sort model.dir (model.page - 1)} rel="prev">
          Previous
        </a>
      else
        <span slot="prev" aria-disabled="true">Previous</span>}
      <span>Page {Text.fromInt model.page} of {Text.fromInt model.pages}</span>
      {if model.page < model.pages then
        <a slot="next" href={listAt model model.sort model.dir (model.page + 1)} rel="next">Next</a>
      else
        <span slot="next" aria-disabled="true">Next</span>}
    </al-pagination>
  </Layout.Page>

-- @resource begin tests
test "the list shows every row, newest first" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let note1 <- Db.insert Note { title: Text.NonEmpty "title-1" }
  let note2 <- Db.insert Note { title: Text.NonEmpty "title-2" }
  let page <- Test.get (Index {})
  Task.succeed ({ rows: List.map (\row -> row.id) page.model.rows } == { rows: [note2, note1] })
}

test "sorting by title goes both ways" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let note1 <- Db.insert Note { title: Text.NonEmpty "title-2" }
  let note2 <- Db.insert Note { title: Text.NonEmpty "title-1" }
  let up <- Test.get (Index { sort: "title", dir: "asc" })
  let down <- Test.get (Index { sort: "title" })
  Task.succeed (
    {
      up: List.map (\row -> row.id) up.model.rows,
      down: List.map (\row -> row.id) down.model.rows,
      toggles: [toggle up.model "title", toggle down.model "title", toggle up.model "created"],
    } == {
      up: [note2, note1],
      down: [note1, note2],
      toggles: ["desc", "asc", "asc"],
    }
  )
}

test "searching finds the rows that contain the text" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let note1 <- Db.insert Note { title: Text.NonEmpty "title-1" }
  let note2 <- Db.insert Note { title: Text.NonEmpty "title-2" }
  let page <- Test.get (Index { q: "title-2" })
  Task.succeed (
    { rows: List.map (\row -> row.id) page.model.rows, count: Test.text "#count" page.doc }
      == { rows: [note2], count: Just "1 row" }
  )
}

test "a search text of 20,000 characters is cut to 200" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let long = Text.join "" (List.map (\n -> "z") (List.range 1 20000))
  let page <- Test.get (Index { q: long })
  Task.succeed (
    { q: Text.length page.model.q, rows: List.length page.model.rows } == { q: 200, rows: 0 }
  )
}

test "the list has 20 rows a page, and a page past the last is the last" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Note { title: Text.NonEmpty ("title-" ++ Text.fromInt n) }) (
        List.range 1 21
      )
    )
  let first <- Test.get (Index {})
  let second <- Test.get (Index { page: 2 })
  let past <- Test.get (Index { page: 9 })
  Task.succeed (
    {
      first: List.length first.model.rows,
      second: List.length second.model.rows,
      past: { page: past.model.page, rows: List.length past.model.rows },
      count: Test.text "#count" first.doc,
      pages: Test.texts "al-pagination span" first.doc,
    } == {
      first: 20,
      second: 1,
      past: { page: 2, rows: 1 },
      count: Just "21 rows",
      pages: ["Previous", "Page 1 of 2"],
    }
  )
}
-- @resource end
