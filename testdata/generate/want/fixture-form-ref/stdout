+test "submitting Tagging adds a row" = {
+  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
+  let _ <- Test.login { user: Just me }
+  let post1 <- Db.insert Post { title: Text.NonEmpty "title-1", body: "body-1", author: me }
+  let _ <- Test.get (Home {})
+  let r <- Test.submit Tagging { name: Text.NonEmpty "name-1", post: post1 }
+  let rows <- Db.from Tag |> Db.all
+  Task.succeed ({ answer: r.answer, rows: List.map (\row -> { name: row.name, post: row.post }) rows } == { answer: Redirected (Home {}), rows: [{ name: Text.NonEmpty "name-1", post: post1 }] })
+}
