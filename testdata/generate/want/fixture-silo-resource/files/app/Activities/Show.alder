-- generated by `alder new resource Activity --module Activities --path /activities --read owner`; regions between
-- `-- @resource begin <name>` / `-- @resource end` are rewritten by `alder regen resource`
module Activities.Show

-- @resource begin imports
import Activity
import Layout
import Org
import User
-- @resource end

-- @resource begin routes
route Show = GET "/activities/{id}" { id: Activity.ActivityId } requires user, org
-- @resource end

-- The row, the labels of the rows it refers to, and (for the delete dialog) how many rows of
-- each table refer to it.
type Model = {
  row: Activity,
  labels: Labels,
  -- @resource begin model
  -- @resource end
}

Show.load : Show.Params -> Session -> Query Model
Show.load params session = {
  -- @resource begin load
  let row <- Db.getScoped Activity params.id
  let labels <- labelsOf [row]
  Query.succeed { row: row, labels: labels }
  -- @resource end
}

-- @resource begin labels
-- Labels are the rows the references of the rows shown name: their links show their labels.
type Labels = { orgs: List Org }

-- labelsOf reads the rows that rows refer to.
labelsOf : List Activity -> Query Labels
labelsOf rows = {
  -- every user's rows: Org has no owner
  let orgs <-
    Db.from Org
      |> Db.where (Org.id.in (List.map (\row -> row.org) rows))
      |> Db.all
  Query.succeed { orgs: orgs }
}

-- orgLabel is the label of the org id names (the id itself if it names none).
orgLabel : Labels -> Org.OrgId -> Text
orgLabel labels id = match List.find (\r -> r.id == id) labels.orgs {
  Just r -> r.name,
  Nothing -> id,
}
-- @resource end

-- @resource begin blockers
-- blockers counts the rows that keep this one from being deleted, which the database would
-- refuse the delete for: the `@restrict` references to it, or to a row deleted with it.
blockers : Model -> Int
blockers model = 0
-- @resource end

Show.view : Model -> Session -> Html
Show.view model session =
  <Layout.Page title="Activity">
    <h1>Activity</h1>

    <al-card>
      <dl id="fields">
        -- @resource begin fields
        <dt>Id</dt>
        <dd>{model.row.id}</dd>
        <dt>Text</dt>
        <dd>{model.row.text}</dd>
        <dt>Org</dt>
        <dd>{orgLabel model.labels model.row.org}</dd>
        <dt>Created</dt>
        <dd>{Time.format "Jan 2, 2006" model.row.created}</dd>
        -- @resource end
      </dl>
      <div slot="actions">
        <al-button href={Activities.Edit.Edit { id: model.row.id }}>Edit</al-button>
        <al-button variant="destructive">
          <button type="button" commandfor="delete-dialog" command="show-modal">Delete</button>
        </al-button>
      </div>
    </al-card>
    <al-dialog id="delete-dialog" heading="Delete this activity?" dismissible>
      <dl>
        -- @resource begin counts
        -- @resource end
      </dl>
      <form id="delete" submit={Activities.Delete.Destroy { id: model.row.id }}>
        <al-alert variant="destructive"><Errors form /></al-alert>
        {if blockers model > 0 then
          <p>It cannot be deleted while other rows refer to it.</p>
        else
          <al-button variant="destructive" type="submit">Delete</al-button>}
      </form>
      <div slot="actions">
        <a href={Activities.Delete.Delete { id: model.row.id }}>See the details</a>
      </div>
    </al-dialog>
    <a href={Activities.Index.Index {}}>All activities</a>
  </Layout.Page>

-- @resource begin tests
test "the page shows the row" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org }
  let activity1 <- Db.insert Activity { text: Text.NonEmpty "text-1", org: org }
  let org2 <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let r <- Test.open (Show { id: activity1 })
  let page <- Test.get (Show { id: activity1 })
  Task.succeed (
    {
      answer: r.answer,
      text: List.member "text-1" (Test.texts "#fields dd" r.doc),
      orgs: List.length page.model.labels.orgs,
      orgLabel: orgLabel page.model.labels org,
    } == {
      answer: Shown,
      text: True,
      orgs: 1,
      orgLabel: "name-1",
    }
  )
}

test "deleting an activity nothing refers to" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org }
  let activity1 <- Db.insert Activity { text: Text.NonEmpty "text-1", org: org }
  let page <- Test.get (Show { id: activity1 })
  let r <- Test.submit (Activities.Delete.Destroy { id: activity1 }) {}
  let gone <- Db.get Activity activity1
  Task.succeed (
    {
      button: Test.count "#delete al-button" page.doc,
      answer: r.answer,
      notices: r.notices,
      gone: Maybe.map (\row -> row.id) gone,
    } == {
      button: 1,
      answer: Redirected (Activities.Index.Index {}),
      notices: ["Deleted"],
      gone: Nothing,
    }
  )
}

test "a missing row is not found" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org }
  let r <- Test.open (Show { id: Activity.ActivityId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "another org's row is not found" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org }
  let otherOrg <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let activity1 <- Db.insert Activity { text: Text.NonEmpty "text-1", org: otherOrg }
  let r <- Test.open (Show { id: activity1 })
  Task.succeed (r.answer == PageMissing)
}

test "a visitor is sent to log in" = {
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let activity1 <- Db.insert Activity { text: Text.NonEmpty "text-1", org: org1 }
  let r <- Test.open (Show { id: activity1 })
  Task.succeed (r.answer == Redirected (Auth.Login.Login {}))
}
-- @resource end
