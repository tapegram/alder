-- generated by `alder new resource Activity --module Activities --path /activities --read owner`; regions between
-- `-- @resource begin <name>` / `-- @resource end` are rewritten by `alder regen resource`
module Activities.New

-- @resource begin imports
import Activity
import Layout
import Org
import User
-- @resource end

-- @resource begin routes
route New    = GET  "/activities/new" { }                   requires user, org
route Create = POST "/activities"     { } form ActivityForm requires user, org
-- @resource end

type Model = {
  -- @resource begin model
  -- @resource end
}

New.load : New.Params -> Session -> Query Model
New.load params session = {
  -- @resource begin load
  Query.succeed {}
  -- @resource end
}

-- @resource begin form
form ActivityForm = { text: Text.NonEmpty }
-- @resource end

-- @resource begin search
-- @resource end

-- Create adds the row and goes to its page.
Create.update : Create.Params -> Session -> Task Response
Create.update params session = {
  -- @resource begin insert
  let id <- Db.insertScoped Activity { text: params.form.text }
  Task.succeed (Response.redirect (Activities.Show.Show { id: id }))
  -- @resource end
}

New.view : Model -> Session -> Html
New.view model session =
  <Layout.Page title="New activity">
    <h1>New activity</h1>

    <al-card>
      -- @resource begin finder
      -- @resource end
      <form submit={Create}>
        -- @resource begin inputs
        <al-input field="text" label="Text" />
        -- @resource end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Create</al-button>
      </form>
    </al-card>
  </Layout.Page>

-- @resource begin tests
test "creating an activity adds it, with the values submitted" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org }
  let page <- Test.get (New {})
  let r <- Test.submit Create { text: Text.NonEmpty "text-1" }
  let rows <- Db.from Activity |> Db.all
  Task.succeed (
    {
      answers: List.map (\row -> Redirected (Activities.Show.Show { id: row.id })) rows,
      rows: List.map (\row -> { text: row.text, org: row.org }) rows,
    }
      == { answers: [r.answer], rows: [{ text: Text.NonEmpty "text-1", org: org }] }
  )
}

test "an empty text is rejected" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org }
  let page <- Test.get (New {})
  let r <- Test.submitRaw Create [{ name: "text", value: "" }]
  let rows <- Db.scoped Activity |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows }
      == { answer: FormRejected [{ field: "text", message: "must not be empty" }], rows: 0 }
  )
}

test "a visitor cannot create an activity" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org }
  let _ <- Test.get (New {})
  let _ <- Test.login { user: Nothing, org: Nothing }
  let r <- Test.submit Create { text: Text.NonEmpty "text-1" }
  let _ <- Test.login { user: Just me, org: Just org }
  let rows <- Db.from Activity |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows } == { answer: Redirected (Auth.Login.Login {}), rows: 0 }
  )
}

test "a visitor is sent to log in" = {
  let r <- Test.open (New {})
  Task.succeed (r.answer == Redirected (Auth.Login.Login {}))
}
-- @resource end
