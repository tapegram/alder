-- generated by `alder new resource Activity --module Activities --path /activities`; regions between
-- `-- @resource begin <name>` / `-- @resource end` are rewritten by `alder regen resource`
module Activities.Edit

-- @resource begin imports
import Activity
import Layout
import Org
import User
-- @resource end

-- @resource begin routes
route Edit = GET "/activities/{id}/edit" { id: Activity.ActivityId }                   requires user, org
route Save = PUT "/activities/{id}"      { id: Activity.ActivityId } form ActivityForm requires user, org
-- @resource end

type Model = {
  row: Activity,
  -- @resource begin model
  -- @resource end
}

Edit.load : Edit.Params -> Session -> Query Model
Edit.load params session = {
  -- @resource begin load
  let row <- Db.getScoped Activity params.id
  Query.succeed { row: row }
  -- @resource end
}

-- @resource begin form
form ActivityForm = { text: Text.NonEmpty }
-- @resource end

-- @resource begin search
-- @resource end

-- Save writes the form over the row (another user's, or one deleted since, is not found) and goes
-- to its page.
Save.update : Save.Params -> Session -> Task Response
Save.update params session = {
  -- @resource begin update
  let _ <- Db.updateScoped Activity params.id (\r -> { r | text: params.form.text })
  Task.succeed (Response.redirect (Activities.Show.Show { id: params.id }))
  -- @resource end
}

Edit.view : Model -> Session -> Html
Edit.view model session =
  <Layout.Page title="Edit activity">
    <h1>Edit activity</h1>

    <al-card>
      -- @resource begin finder
      -- @resource end
      <form submit={Save { id: model.row.id }}>
        -- @resource begin inputs
        <al-input field="text" label="Text" value={model.row.text} />
        -- @resource end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Save</al-button>
      </form>
    </al-card>
    <a href={Activities.Show.Show { id: model.row.id }}>Back</a>
  </Layout.Page>

-- @resource begin tests
test "saving changes every field" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org }
  let activity1 <- Db.insert Activity { text: Text.NonEmpty "text-1", org: org }
  let page <- Test.get (Edit { id: activity1 })
  let r <- Test.submit (Save { id: activity1 }) { text: Text.NonEmpty "text-2" }
  let after <- Db.get Activity activity1
  Task.succeed (
    { answer: r.answer, row: Maybe.map (\row -> { text: row.text }) after }
      == {
        answer: Redirected (Activities.Show.Show { id: activity1 }),
        row: Just { text: Text.NonEmpty "text-2" },
      }
  )
}

test "a visitor cannot save an activity" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org }
  let activity1 <- Db.insert Activity { text: Text.NonEmpty "text-1", org: org }
  let before <- Db.get Activity activity1
  let _ <- Test.get (Edit { id: activity1 })
  let _ <- Test.login { user: Nothing, org: Nothing }
  let r <- Test.submit (Save { id: activity1 }) { text: Text.NonEmpty "text-2" }
  let _ <- Test.login { user: Just me, org: Just org }
  let after <- Db.get Activity activity1
  Task.succeed (
    { answer: r.answer, row: after } == { answer: Redirected (Auth.Login.Login {}), row: before }
  )
}

test "another org's row cannot be saved" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org }
  let otherOrg <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let activity1 <- Db.insert Activity { text: Text.NonEmpty "text-1", org: otherOrg }
  let before <- Db.get Activity activity1
  let _ <- Test.member me otherOrg
  let _ <- Test.login { user: Just me, org: Just otherOrg }
  let _ <- Test.get (Edit { id: activity1 })
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org }
  let r <- Test.submit (Save { id: activity1 }) { text: Text.NonEmpty "text-2" }
  let after <- Db.get Activity activity1
  Task.succeed ({ answer: r.answer, row: after } == { answer: PageMissing, row: before })
}

test "a missing row is not found" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org }
  let r <- Test.open (Edit { id: Activity.ActivityId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "another org's row: the edit page is not found" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org }
  let otherOrg <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let activity1 <- Db.insert Activity { text: Text.NonEmpty "text-1", org: otherOrg }
  let r <- Test.open (Edit { id: activity1 })
  Task.succeed (r.answer == PageMissing)
}

test "a visitor is sent to log in" = {
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let activity1 <- Db.insert Activity { text: Text.NonEmpty "text-1", org: org1 }
  let r <- Test.open (Edit { id: activity1 })
  Task.succeed (r.answer == Redirected (Auth.Login.Login {}))
}
-- @resource end
