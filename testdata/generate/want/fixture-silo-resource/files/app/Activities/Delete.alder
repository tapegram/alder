-- generated by `alder new resource Activity --module Activities --path /activities`; regions between
-- `-- @resource begin <name>` / `-- @resource end` are rewritten by `alder regen resource`
module Activities.Delete

-- @resource begin imports
import Activity
import Layout
import Org
import User
-- @resource end

-- @resource begin routes
route Delete  = GET    "/activities/{id}/delete" { id: Activity.ActivityId }              requires user, org
route Destroy = DELETE "/activities/{id}"        { id: Activity.ActivityId } form Confirm requires user, org
-- @resource end

-- The row, and how many rows of each table refer to it.
type Model = {
  row: Activity,
  -- @resource begin model
  -- @resource end
}

-- counted is the row id names (none is not found) and how many rows of each table refer to it:
-- the page shows them, and Destroy counts them again before it deletes.
counted : Activity.ActivityId -> Query Model
counted id = {
  -- @resource begin load
  let row <- Db.getScoped Activity id
  Query.succeed { row: row }
  -- @resource end
}

Delete.load : Delete.Params -> Session -> Query Model
Delete.load params session = { counted params.id }

-- @resource begin blockers
-- blockers counts the rows that keep this one from being deleted, which the database would
-- refuse the delete for: the `@restrict` references to it, or to a row deleted with it.
blockers : Model -> Int
blockers model = 0
-- @resource end

-- Destroy takes no input: the form is the button, and the place a refusal is shown.
form Confirm = { }

-- Destroy deletes the row, unless rows refer to it that keep it (counted again, as the page
-- counted them): the database would refuse the delete with an error, and the page says why
-- instead. The Show page's dialog posts it too.
Destroy.delete : Destroy.Params -> Session -> Task Response
Destroy.delete params session = {
  let model <- counted params.id
  -- @resource begin remove
  let _ <- Db.deleteScoped Activity params.id
  Task.succeed (Response.redirect (Activities.Index.Index {}) |> Response.success "Deleted")
  -- @resource end
}

Delete.view : Model -> Session -> Html
Delete.view model session =
  <Layout.Page title="Delete activity">
    <h1>Delete this activity?</h1>

    <al-card>
      -- @resource begin row
      <p>{model.row.text}</p>
      -- @resource end
      <dl>
        -- @resource begin counts
        -- @resource end
      </dl>
      <form id="delete" submit={Destroy { id: model.row.id }}>
        <al-alert variant="destructive"><Errors form /></al-alert>
        {if blockers model > 0 then
          <p>It cannot be deleted while other rows refer to it.</p>
        else
          <al-button variant="destructive" type="submit">Delete</al-button>}
      </form>
    </al-card>
    <a href={Activities.Show.Show { id: model.row.id }}>Back</a>
  </Layout.Page>

-- @resource begin tests
test "deleting an activity nothing refers to" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org }
  let activity1 <- Db.insert Activity { text: Text.NonEmpty "text-1", org: org }
  let page <- Test.get (Delete { id: activity1 })
  let r <- Test.submit (Destroy { id: activity1 }) {}
  let gone <- Db.get Activity activity1
  Task.succeed (
    {
      button: Test.count "#delete al-button" page.doc,
      answer: r.answer,
      notices: r.notices,
      gone: Maybe.map (\row -> row.id) gone,
    } == {
      button: 1,
      answer: Redirected (Activities.Index.Index {}),
      notices: ["Deleted"],
      gone: Nothing,
    }
  )
}

test "a visitor cannot delete an activity" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org }
  let activity1 <- Db.insert Activity { text: Text.NonEmpty "text-1", org: org }
  let _ <- Test.get (Delete { id: activity1 })
  let _ <- Test.login { user: Nothing, org: Nothing }
  let r <- Test.submit (Destroy { id: activity1 }) {}
  let _ <- Test.login { user: Just me, org: Just org }
  let kept <- Db.get Activity activity1
  Task.succeed (
    { answer: r.answer, kept: Maybe.map (\row -> row.id) kept }
      == { answer: Redirected (Auth.Login.Login {}), kept: Just activity1 }
  )
}

test "another org's row cannot be deleted" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org }
  let otherOrg <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let activity1 <- Db.insert Activity { text: Text.NonEmpty "text-1", org: otherOrg }
  let _ <- Test.member me otherOrg
  let _ <- Test.login { user: Just me, org: Just otherOrg }
  let _ <- Test.get (Delete { id: activity1 })
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org }
  let r <- Test.submit (Destroy { id: activity1 }) {}
  let kept <- Db.get Activity activity1
  Task.succeed (
    { answer: r.answer, kept: Maybe.map (\row -> row.id) kept }
      == { answer: PageMissing, kept: Just activity1 }
  )
}

test "a missing row is not found" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org }
  let r <- Test.open (Delete { id: Activity.ActivityId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "another org's row is not found" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org }
  let otherOrg <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let activity1 <- Db.insert Activity { text: Text.NonEmpty "text-1", org: otherOrg }
  let r <- Test.open (Delete { id: activity1 })
  Task.succeed (r.answer == PageMissing)
}

test "a visitor is sent to log in" = {
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let activity1 <- Db.insert Activity { text: Text.NonEmpty "text-1", org: org1 }
  let r <- Test.open (Delete { id: activity1 })
  Task.succeed (r.answer == Redirected (Auth.Login.Login {}))
}
-- @resource end
