-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Membership.Edit

-- @admin begin imports
import Admin.Layout
import Membership
import Org
import User
-- @admin end

page "/admin/membership/{id}/edit" { id: Membership.MembershipId, findUser: Text = "", findOrg: Text = "" } requires user, role Admin

type Model = {
  row: Membership,
  -- @admin begin model
  users: List User,
  usersTotal: Int,
  orgs: List Org,
  orgsTotal: Int,
  -- @admin end
}

load : Params -> Session -> Query Model
load params session = {
  let admin <- Admin.Layout.isAdmin session.user
  if admin then {
    -- @admin begin load
    let found <- Db.get Membership params.id
    match found {
      Just row -> {
        let findUser = Text.slice 0 200 params.findUser
        let usersTotal <- Db.from User |> Db.count
        let usersOwn <- if usersTotal > 200 then Db.from User |> Db.where (User.id.eq row.user) |> Db.all else Query.succeed []
        let usersFound <- Db.from User |> Db.orderBy User.email.asc |> Db.where (if usersTotal > 200 then Db.and [
          User.email.contains findUser,
          User.id.ne row.user,
        ] else Db.and []) |> Db.limit (if usersTotal > 200 then 50 else 200) |> Db.all
        let users = usersOwn ++ usersFound
        let findOrg = Text.slice 0 200 params.findOrg
        let orgsTotal <- Db.from Org |> Db.count
        let orgsOwn <- if orgsTotal > 200 then Db.from Org |> Db.where (Org.id.eq row.org) |> Db.all else Query.succeed []
        let orgsFound <- Db.from Org |> Db.orderBy Org.name.asc |> Db.where (if orgsTotal > 200 then Db.and [
          Org.name.contains findOrg,
          Org.id.ne row.org,
        ] else Db.and []) |> Db.limit (if orgsTotal > 200 then 50 else 200) |> Db.all
        let orgs = orgsOwn ++ orgsFound
        Query.succeed {
          row: row,
          users: users,
          usersTotal: usersTotal,
          orgs: orgs,
          orgsTotal: orgsTotal,
        }
      },
      Nothing -> Query.notFound,
    }
    -- @admin end
  } else Query.notFound
}

-- @admin begin form
form MembershipForm = {
  user: User.UserId,
  org: Org.OrgId,
}
-- @admin end

-- @admin begin search
form FindUser = { q: Text }

msg SearchUser form FindUser

form FindOrg = { q: Text }

msg SearchOrg form FindOrg

-- @admin end

msg Save form MembershipForm

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  -- @admin begin finds
  SearchUser p -> Task.succeed (Redirect (Admin.Membership.Edit { id: model.row.id, findUser: Text.slice 0 200 p.form.q })),
  SearchOrg p -> Task.succeed (Redirect (Admin.Membership.Edit { id: model.row.id, findOrg: Text.slice 0 200 p.form.q })),
  -- @admin end
  Save p -> {
    -- @admin begin update
    let _ <- Db.update Membership model.row.id (\row -> { row | user: p.form.user, org: p.form.org })
    Task.succeed (Redirect (Admin.Membership.Show { id: model.row.id }))
    -- @admin end
  },
}

view : Model -> Session -> Html Msg
view model session =
  <Admin.Layout.Page title="Edit membership">
    <h1>Edit membership</h1>

    <al-card>
      -- @admin begin finder
      {if model.usersTotal > 200 then <form submit={SearchUser}><al-input field="q" label="Find user" /><al-button type="submit" variant="secondary">Find</al-button></form> else <span></span>}
      {if model.orgsTotal > 200 then <form submit={SearchOrg}><al-input field="q" label="Find org" /><al-button type="submit" variant="secondary">Find</al-button></form> else <span></span>}
      -- @admin end
      <form submit={Save}>
        -- @admin begin inputs
        <al-select field="user" label="User" options={List.map (\r -> { value: r.id, label: r.email }) model.users} value={model.row.user} />
        <al-select field="org" label="Org" options={List.map (\r -> { value: r.id, label: r.name }) model.orgs} value={model.row.org} />
        -- @admin end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Save</al-button>
      </form>
    </al-card>
    <a href={Admin.Membership.Show { id: model.row.id }}>Back</a>
  </Admin.Layout.Page>

-- @admin begin tests
test "saving changes every field" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, org: Nothing, role: Admin }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let membership1 <- Db.insert Membership { user: me, org: org1 }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let org2 <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let page <- Test.get (Admin.Membership.Edit { id: membership1 })
  let r <- Test.submit MembershipForm { user: user2, org: org2 }
  let after <- Db.get Membership membership1
  Task.succeed ({
    answer: r.answer,
    row: Maybe.map (\row -> { user: row.user, org: row.org }) after,
    users: Test.texts "select[name=user] option" page.doc,
    orgs: Test.texts "select[name=org] option" page.doc,
  } == {
    answer: Redirected (Admin.Membership.Show { id: membership1 }),
    row: Just { user: user2, org: org2 },
    users: ["email-1@example.com", "email-2@example.com"],
    orgs: ["name-1", "name-2"],
  })
}

test "a user not offered is refused" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, org: Nothing, role: Admin }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let membership1 <- Db.insert Membership { user: me, org: org1 }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let org2 <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let page <- Test.get (Admin.Membership.Edit { id: membership1 })
  let orgId = Maybe.withDefault "" (Test.attr "value" "select[name=org] option" page.doc)
  let r <- Test.submitRaw MembershipForm [
    { name: "user", value: "missing" },
    { name: "org", value: orgId },
  ]
  let after <- Db.get Membership membership1
  Task.succeed ({
    answer: r.answer,
    user: Maybe.map (\row -> row.user) after,
  } == {
    answer: FormRejected [{ field: "user", message: "must be one of the options" }],
    user: Just me,
  })
}

test "an org not offered is refused" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, org: Nothing, role: Admin }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let membership1 <- Db.insert Membership { user: me, org: org1 }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let org2 <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let page <- Test.get (Admin.Membership.Edit { id: membership1 })
  let userId = Maybe.withDefault "" (Test.attr "value" "select[name=user] option" page.doc)
  let r <- Test.submitRaw MembershipForm [
    { name: "user", value: userId },
    { name: "org", value: "missing" },
  ]
  let after <- Db.get Membership membership1
  Task.succeed ({
    answer: r.answer,
    org: Maybe.map (\row -> row.org) after,
  } == {
    answer: FormRejected [{ field: "org", message: "must be one of the options" }],
    org: Just org1,
  })
}

test "a list of 200 users is offered whole" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, org: Nothing, role: Admin }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let membership1 <- Db.insert Membership { user: me, org: org1 }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let org2 <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let _ <- Task.all (List.map (\n -> Db.insert User {
    email: Text.Email ("email-" ++ Text.fromInt n ++ "@example.com"),
    name: Text.NonEmpty ("name-" ++ Text.fromInt n),
  }) (List.range 3 200))
  let page <- Test.get (Admin.Membership.Edit { id: membership1 })
  Task.succeed (List.length page.model.users == 200)
}

test "a long list of users offers 50, and the search narrows it" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, org: Nothing, role: Admin }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let membership1 <- Db.insert Membership { user: me, org: org1 }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let org2 <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let _ <- Task.all (List.map (\n -> Db.insert User {
    email: Text.Email ("email-" ++ Text.fromInt n ++ "@example.com"),
    name: Text.NonEmpty ("name-" ++ Text.fromInt n),
  }) (List.range 3 203))
  let all <- Test.get (Admin.Membership.Edit { id: membership1 })
  let found <- Test.get (Admin.Membership.Edit {
    id: membership1,
    findUser: "email-203@example.com",
  })
  let r <- Test.submit FindUser { q: "zz" }
  Task.succeed ({
    shown: List.length all.model.users,
    total: all.model.usersTotal,
    found: Test.count "select[name=user] option" found.doc <= 3,
    answer: r.answer,
  } == {
    shown: 51,
    total: 203,
    found: True,
    answer: Redirected (Admin.Membership.Edit { id: membership1, findUser: "zz" }),
  })
}

test "the row's own user is offered first when it sorts past the 50" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, org: Nothing, role: Admin }
  let user2 <- Db.insert User { email: Text.Email "zz-1@example.com", name: Text.NonEmpty "name-2" }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let membership1 <- Db.insert Membership { user: user2, org: org1 }
  let _ <- Task.all (List.map (\n -> Db.insert User {
    email: Text.Email ("email-" ++ Text.fromInt n ++ "@example.com"),
    name: Text.NonEmpty ("name-" ++ Text.fromInt n),
  }) (List.range 3 203))
  let page <- Test.get (Admin.Membership.Edit { id: membership1 })
  let r <- Test.submit MembershipForm { user: page.model.row.user, org: page.model.row.org }
  let after <- Db.get Membership membership1
  Task.succeed ({
    answer: r.answer,
    kept: Maybe.map (\row -> row.user) after,
    first: Maybe.map (\o -> o.id) (List.head page.model.users),
    once: List.length (List.filter (\o -> o.id == user2) page.model.users),
    shown: List.length page.model.users,
  } == {
    answer: Redirected (Admin.Membership.Show { id: membership1 }),
    kept: Just user2,
    first: Just user2,
    once: 1,
    shown: 51,
  })
}

