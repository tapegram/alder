-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Membership.New

-- @admin begin imports
import Admin.Layout
import Membership
import Org
import User
-- @admin end

page "/admin/membership/new" { findUser: Text = "", findOrg: Text = "" } requires user, role Admin

type Model = {
  -- @admin begin model
  users: List User,
  usersTotal: Int,
  orgs: List Org,
  orgsTotal: Int,
  -- @admin end
}

load : Params -> Session -> Query Model
load params session = {
  let admin <- Admin.Layout.isAdmin session.user
  if admin then {
    -- @admin begin load
    let findUser = Text.slice 0 200 params.findUser
    let usersTotal <- Db.from User |> Db.count
    let users <- Db.from User |> Db.orderBy User.email.asc |> Db.where (if usersTotal > 200 then User.email.contains findUser else Db.and []) |> Db.limit (if usersTotal > 200 then 50 else 200) |> Db.all
    let findOrg = Text.slice 0 200 params.findOrg
    let orgsTotal <- Db.from Org |> Db.count
    let orgs <- Db.from Org |> Db.orderBy Org.name.asc |> Db.where (if orgsTotal > 200 then Org.name.contains findOrg else Db.and []) |> Db.limit (if orgsTotal > 200 then 50 else 200) |> Db.all
    Query.succeed { users: users, usersTotal: usersTotal, orgs: orgs, orgsTotal: orgsTotal }
    -- @admin end
  } else Query.notFound
}

-- @admin begin form
form MembershipForm = {
  user: User.UserId,
  org: Org.OrgId,
}
-- @admin end

-- @admin begin search
form FindUser = { q: Text }

msg SearchUser form FindUser

form FindOrg = { q: Text }

msg SearchOrg form FindOrg

-- @admin end

msg Create form MembershipForm

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  -- @admin begin finds
  SearchUser p -> Task.succeed (Redirect (Admin.Membership.New { findUser: Text.slice 0 200 p.form.q })),
  SearchOrg p -> Task.succeed (Redirect (Admin.Membership.New { findOrg: Text.slice 0 200 p.form.q })),
  -- @admin end
  Create p -> {
    -- @admin begin insert
    let id <- Db.insert Membership { user: p.form.user, org: p.form.org }
    Task.succeed (Redirect (Admin.Membership.Show { id: id }))
    -- @admin end
  },
}

view : Model -> Session -> Html Msg
view model session =
  <Admin.Layout.Page title="New membership">
    <h1>New membership</h1>

    <al-card>
      -- @admin begin finder
      {if model.usersTotal > 200 then <form submit={SearchUser}><al-input field="q" label="Find user" /><al-button type="submit" variant="secondary">Find</al-button></form> else <span></span>}
      {if model.orgsTotal > 200 then <form submit={SearchOrg}><al-input field="q" label="Find org" /><al-button type="submit" variant="secondary">Find</al-button></form> else <span></span>}
      -- @admin end
      <form submit={Create}>
        -- @admin begin inputs
        <al-select field="user" label="User" options={List.map (\r -> { value: r.id, label: r.email }) model.users} />
        <al-select field="org" label="Org" options={List.map (\r -> { value: r.id, label: r.name }) model.orgs} />
        -- @admin end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Create</al-button>
      </form>
    </al-card>
  </Admin.Layout.Page>

-- @admin begin tests
test "creating a membership adds it, with the values submitted" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, org: Nothing, role: Admin }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let org2 <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let page <- Test.get (Admin.Membership.New {})
  let r <- Test.submit MembershipForm { user: user2, org: org2 }
  let rows <- Db.from Membership |> Db.all
  Task.succeed ({
    answers: List.map (\row -> Redirected (Admin.Membership.Show { id: row.id })) rows,
    rows: List.map (\row -> { user: row.user, org: row.org }) rows,
    users: Test.texts "select[name=user] option" page.doc,
    orgs: Test.texts "select[name=org] option" page.doc,
  } == {
    answers: [r.answer],
    rows: [{ user: user2, org: org2 }],
    users: ["email-1@example.com", "email-2@example.com"],
    orgs: ["name-1", "name-2"],
  })
}

test "a user not offered is refused" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, org: Nothing, role: Admin }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let org2 <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let page <- Test.get (Admin.Membership.New {})
  let orgId = Maybe.withDefault "" (Test.attr "value" "select[name=org] option" page.doc)
  let r <- Test.submitRaw MembershipForm [
    { name: "user", value: "missing" },
    { name: "org", value: orgId },
  ]
  let rows <- Db.from Membership |> Db.count
  Task.succeed ({
    answer: r.answer,
    rows: rows,
  } == {
    answer: FormRejected [{ field: "user", message: "must be one of the options" }],
    rows: 0,
  })
}

