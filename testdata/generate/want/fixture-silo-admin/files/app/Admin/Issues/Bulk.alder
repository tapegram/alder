-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Issues.Bulk

-- @admin begin imports
import Admin.Layout
import Issue
import Org
import Project
import User
-- @admin end

-- @admin begin routes
route Bulk          = GET  "/admin/orgs/{org}/issue/bulk"                 { org: Org.OrgId, ids: List Issue.IssueId }                requires user, role Admin, silo org
route BulkDelete    = POST "/admin/orgs/{org}/issue/bulk/_/BulkDelete"    { org: Org.OrgId, ids: List Issue.IssueId } form Confirm   requires user, role Admin, silo org
route BulkSetStatus = POST "/admin/orgs/{org}/issue/bulk/_/BulkSetStatus" { org: Org.OrgId, ids: List Issue.IssueId } form SetStatus requires user, role Admin, silo org
-- @admin end

-- The rows chosen on the list (at most maxRows of them), the ids of those that other rows keep
-- from being deleted, how many ids the page was given, and the ids, which each action takes.
type Model = {
  rows: List Issue,
  held: List Issue.IssueId,
  chosen: Int,
  ids: List Issue.IssueId,
}

-- maxRows is how many rows one action takes: a page of the list. More are refused.
maxRows : Int
maxRows = 25

-- tooMany says whether the page was given more ids than an action takes.
tooMany : Model -> Bool
tooMany model = model.chosen > maxRows

-- selected is the rows of ids: the page shows them, and each action reads them again.
selected : List Issue.IssueId -> Query Model
selected ids = {
  -- @admin begin load
  let taken = List.take maxRows ids
  let rows <-
    Db.from Issue
      |> Db.where (Issue.id.in taken)
      |> Db.all
  Query.succeed {
    rows: rows,
    held: [],
    chosen: List.length ids,
    ids: ids,
  }
  -- @admin end
}

Bulk.load : Bulk.Params -> Session -> Query Model
Bulk.load params session = {
  let _ <- Layout.adminOnly session.user
  selected params.ids
}

-- refused says whether a row is kept from being deleted: rows refer to it with a `@restrict`.
refused : Model -> Issue -> Bool
refused model row = List.member row.id model.held

-- @admin begin bulk
-- Each action reads the rows again and answers with the page again and a toast; none takes
-- more than maxRows rows.

-- BulkDelete takes no input: the form is the button, and the place a refusal is shown.
form Confirm = { }

BulkDelete.update : BulkDelete.Params -> Session -> Task Response
BulkDelete.update params session = {
  let _ <- Layout.adminOnly session.user
  let model <- selected params.ids
  if tooMany model then
    Task.succeed (
      Response.invalid ("Choose at most " ++ Text.fromInt maxRows ++ " rows at a time.")
    )
  else {
    let allowed = List.filter (\row -> refused model row == False) model.rows
    let _ <- Task.all (List.map (\row -> Db.delete Issue row.id) allowed)
    Task.succeed (
      Response.refresh
        |> Response.success (
          "Deleted "
            ++ Text.fromInt (List.length allowed)
            ++ " of "
            ++ Text.fromInt (List.length model.rows)
        )
    )
  }
}

form SetStatus = { value: Issue.Status }

BulkSetStatus.update : BulkSetStatus.Params -> Session -> Task Response
BulkSetStatus.update params session = {
  let _ <- Layout.adminOnly session.user
  let model <- selected params.ids
  if tooMany model then
    Task.succeed (
      Response.invalid ("Choose at most " ++ Text.fromInt maxRows ++ " rows at a time.")
    )
  else {
    let _ <-
      Task.all (
        List.map (\row -> Db.update Issue row.id (\r -> { r |
          status: params.form.value
        })) model.rows
      )
    Task.succeed (
      Response.refresh |> Response.success ("Updated " ++ Text.fromInt (List.length model.rows))
    )
  }
}
-- @admin end

Bulk.view : Model -> Session -> Html
Bulk.view model session =
  <Layout.Page title="Selected issues">
    <h1>{Text.fromInt (List.length model.rows)} selected</h1>

    <al-card>
      {if tooMany model then
        <al-alert id="too-many" variant="warning">
          {"Choose at most " ++ Text.fromInt maxRows ++ " rows at a time."}
        </al-alert>
      else
        Html.none}
      <ul id="selected">
        {for row in model.rows ->
          <li>
            {row.title}
            {if refused model row then
              <small> (kept: other rows refer to it)</small>
            else
              <span></span>}
          </li>}
      </ul>
      -- @admin begin actions
      <form id="bulk-delete" submit={BulkDelete { org: session.org, ids: model.ids }}>
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button variant="destructive" type="submit">
          Delete the rows that can be deleted
        </al-button>
      </form>
      <form id="set-status" submit={BulkSetStatus { org: session.org, ids: model.ids }}>
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-select field="value" label="Status" />
        <al-button type="submit">Set status</al-button>
      </form>
      -- @admin end
    </al-card>
    <a href={Admin.Issues.Index.Index { org: session.org }}>Back to the list</a>
  </Layout.Page>

-- @admin begin tests
test "deleting the chosen rows" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let issue1 <- Db.insert Issue {
    title: Text.NonEmpty "title-1",
    project: project1,
    org: org,
    assignee: Nothing,
  }
  let issue2 <- Db.insert Issue {
    title: Text.NonEmpty "title-2",
    project: project1,
    org: org,
    assignee: Nothing,
  }
  let _ <- Test.get (Bulk { org: org, ids: [issue1] })
  let r <- Test.submit (BulkDelete { org: org, ids: [issue1] }) {}
  let gone <- Db.get Issue issue1
  let left <- Db.get Issue issue2
  Task.succeed (
    {
      answer: r.answer,
      notices: r.notices,
      gone: Maybe.map (\row -> row.id) gone,
      left: Maybe.map (\row -> row.id) left,
    } == {
      answer: Refreshed,
      notices: ["Deleted 1 of 1"],
      gone: Nothing,
      left: Just issue2,
    }
  )
}

test "setting status changes the chosen rows only" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let issue1 <- Db.insert Issue {
    title: Text.NonEmpty "title-1",
    project: project1,
    org: org,
    assignee: Nothing,
  }
  let issue2 <- Db.insert Issue {
    title: Text.NonEmpty "title-2",
    project: project1,
    org: org,
    assignee: Nothing,
  }
  let _ <- Test.get (Bulk { org: org, ids: [issue1] })
  let r <- Test.submit (BulkSetStatus { org: org, ids: [issue1] }) { value: Closed }
  let one <- Db.get Issue issue1
  let other <- Db.get Issue issue2
  Task.succeed (
    {
      answer: r.answer,
      notices: r.notices,
      one: Maybe.map (\row -> row.status == Closed) one,
      other: Maybe.map (\row -> row.status == Closed) other,
    } == {
      answer: Refreshed,
      notices: ["Updated 1"],
      one: Just True,
      other: Just False,
    }
  )
}

test "25 chosen ids are taken" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let issue1 <- Db.insert Issue {
    title: Text.NonEmpty "title-1",
    project: project1,
    org: org,
    assignee: Nothing,
  }
  let chosen =
    [issue1] ++ List.map (\n -> Issue.IssueId ("none-" ++ Text.fromInt n)) (List.range 1 24)
  let page <- Test.get (Bulk { org: org, ids: chosen })
  let r <- Test.submit (BulkDelete { org: org, ids: chosen }) {}
  let after <- Db.get Issue issue1
  Task.succeed (
    {
      answer: r.answer,
      kept: Maybe.map (\row -> row.id) after,
      warned: Test.count "#too-many" page.doc,
    } == {
      answer: Refreshed,
      kept: Nothing,
      warned: 0,
    }
  )
}

