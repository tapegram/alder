  let issue1 <- Db.insert Issue {
    title: Text.NonEmpty "title-1",
    project: project1,
    org: org,
    assignee: Nothing,
  }
  let chosen =
    [issue1] ++ List.map (\n -> Issue.IssueId ("none-" ++ Text.fromInt n)) (List.range 1 25)
  let _ <- Test.get (Bulk { org: org, ids: chosen })
  let r <- Test.submit (BulkSetStatus { org: org, ids: chosen }) { value: Closed }
  let after <- Db.get Issue issue1
  Task.succeed (
