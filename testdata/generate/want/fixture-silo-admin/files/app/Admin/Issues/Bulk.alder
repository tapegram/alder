        set: Just False,
      }
  )
}

test "a visitor cannot delete the chosen rows" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let issue1 <- Db.insert Issue {
    title: Text.NonEmpty "title-1",
    project: project1,
    org: org,
    assignee: Nothing,
  }
  let _ <- Test.get (Bulk { org: org, ids: [issue1] })
  let _ <- Test.login { user: Nothing, org: Nothing }
  let r <- Test.submit (BulkDelete { org: org, ids: [issue1] }) {}
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let kept <- Db.get Issue issue1
  Task.succeed (
    { answer: r.answer, kept: Maybe.map (\row -> row.id) kept }
      == { answer: Redirected (Auth.Login.Login {}), kept: Just issue1 }
  )
}

