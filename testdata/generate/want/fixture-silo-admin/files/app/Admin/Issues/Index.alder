-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Issues.Index

-- @admin begin imports
import Admin.Layout
import Issue
import Org
import Project
import User
-- @admin end

-- @admin begin params
page "/admin/orgs/{org}/issue" {
  org: Org.OrgId,
  q: Text = "",
  status: Text = "",
  sort: Text = "created",
  dir: Text = "desc",
  page: Int = 1,
} requires user, role Admin, silo org
-- @admin end

type Model = {
  org: Org.OrgId,
  rows: List Issue,
  labels: Labels,
  q: Text,
  filters: Filters,
  sort: Text,
  dir: Text,
  page: Int,
  pages: Int,
  count: Int,
}

perPage : Int
perPage = 25

-- @admin begin search
-- search is the rows whose text contains q (every row for "").
search : Text -> Condition Issue
search q = Db.or [Issue.title.contains q]
-- @admin end

-- A Filter is one of the list's selects: the column it filters, the option chosen ("" for any),
-- and each option's value in the address, its label, and the rows it selects.
type Filter = {
  name: Text,
  label: Text,
  value: Text,
  options: List {
    value: Text,
    label: Text,
    rows: Condition Issue,
  },
}

-- @admin begin filters
-- Filters are the option each filter has chosen in the address ("" for any): a select for each
-- Bool and union column.
type Filters = { status: Text }

-- chosen is the filters' options in params.
chosen : Params -> Filters
chosen params = { status: params.status }

-- filters are the list's filters, each with the option f has chosen.
filters : Filters -> List Filter
filters f = [
  {
    name: "status",
    label: "Status",
    value: f.status,
    options: [
      {
        value: "Open",
        label: "Open",
        rows: Issue.status.eq Open,
      },
      {
        value: "Closed",
        label: "Closed",
        rows: Issue.status.eq Closed,
      },
    ],
  },
]

-- filtered is the rows that the option each filter has chosen selects (every row for "", or for
-- a value that is no option's).
filtered : List Filter -> Condition Issue
filtered fs =
  Db.and (
    List.map (\f -> match List.find (\o -> o.value == f.value) f.options {
      Just o -> o.rows,
      Nothing -> Db.and [],
    }) fs
  )

-- listAt is this list with the model's search and filters, sorted by sort and dir, at page n.
listAt : Model -> Text -> Text -> Int -> Page
listAt model sort dir n = Admin.Issues.Index {
  org: model.org,
  q: model.q,
  status: model.filters.status,
  sort: sort,
  dir: dir,
  page: n,
}
-- @admin end

-- @admin begin sorts
-- sorts are the columns the list sorts by, by name.
sorts : List {
  name: Text,
  asc: Order Issue,
  desc: Order Issue,
}
sorts = [
  {
    name: "title",
    asc: Issue.title.asc,
    desc: Issue.title.desc,
  },
  {
    name: "project",
    asc: Issue.project.asc,
    desc: Issue.project.desc,
  },
  {
    name: "status",
    asc: Issue.status.asc,
    desc: Issue.status.desc,
  },
  {
    name: "assignee",
    asc: Issue.assignee.asc,
    desc: Issue.assignee.desc,
  },
  {
    name: "created",
    asc: Issue.created.asc,
    desc: Issue.created.desc,
  },
]
-- @admin end

-- order is the ordering sort names, ascending when dir is "asc"; a name that is not a column's
-- sorts newest first.
order : Text -> Text -> Order Issue
order sort dir = match List.find (\s -> s.name == sort) sorts {
  Just s -> if dir == "asc" then s.asc else s.desc,
  Nothing -> Issue.created.desc,
}

-- toggle is the direction a column's header sorts by: the other way round when the list is
-- sorted by that column ascending.
toggle : Model -> Text -> Text
toggle model sort = if model.sort == sort && model.dir == "asc" then "desc" else "asc"

-- load reads how many rows match the search and the filters, and one page of them (the last, for
-- a page past it), in the order asked for. The search text is cut to 200 characters (Text.slice):
-- a text over 10,000 bytes would fail the query (chapter 8, "Search").
load : Params -> Session -> Query Model
load params session = {
  let admin <- Layout.isAdmin session.user
  if admin then {
    let q = Text.slice 0 200 params.q
    let f = chosen params
    let count <-
      Db.from Issue
        |> Db.where (Db.and [search q, filtered (filters f)])
        |> Db.count
    let pages = Int.max 1 ((count + perPage - 1) / perPage)
    let page = Int.clamp { min: 1, max: pages } params.page
    let rows <-
      Db.from Issue
        |> Db.where (Db.and [search q, filtered (filters f)])
        |> Db.orderBy (order params.sort params.dir)
        |> Db.limit perPage
        |> Db.offset ((page - 1) * perPage)
        |> Db.all
    let labels <- labelsOf rows
    Query.succeed {
      org: session.org,
      rows: rows,
      labels: labels,
      q: q,
      filters: f,
      sort: params.sort,
      dir: params.dir,
      page: page,
      pages: pages,
      count: count,
    }
  } else
    Query.notFound
}

-- @admin begin labels
-- Labels are the rows the references of the rows shown name: their links show their labels.
type Labels = { projects: List Project, assignees: List User }

-- labelsOf reads the rows that rows refer to.
labelsOf : List Issue -> Query Labels
labelsOf rows = {
  let projects <-
    Db.from Project
      |> Db.where (Project.id.in (List.map (\row -> row.project) rows))
      |> Db.all
  let assignees <-
    Db.from User
      |> Db.where (User.id.in (List.filterMap (\row -> row.assignee) rows))
      |> Db.all
  Query.succeed { projects: projects, assignees: assignees }
}

-- projectLabel is the label of the project id names (the id itself if it names none).
projectLabel : Labels -> Project.ProjectId -> Text
projectLabel labels id = match List.find (\r -> r.id == id) labels.projects {
  Just r -> r.name,
  Nothing -> id,
}

-- assigneeLabel is the label of the user id names (the id itself if it names none).
assigneeLabel : Labels -> User.UserId -> Text
assigneeLabel labels id = match List.find (\r -> r.id == id) labels.assignees {
  Just r -> r.email,
  Nothing -> id,
}
-- @admin end

view : Model -> Session -> Html Msg
view model session =
  <Layout.Page title="Issues">
    <h1>Issues</h1>

    <al-stack direction="row" gap="sm">
      <form method="get" action={"/admin/orgs/" ++ session.org ++ "/issue"}>
        <input type="search" name="q" value={model.q} aria-label="Search" />
        {for f in filters model.filters ->
          <al-select label={f.label}>
            <label>
              {f.label}
              <select name={f.name}>
                <option value="" selected={f.value == ""}>any</option>
                {for o in f.options ->
                  <option value={o.value} selected={o.value == f.value}>{o.label}</option>}
              </select>
            </label>
          </al-select>}
        <input type="hidden" name="sort" value={model.sort} />
        <input type="hidden" name="dir" value={model.dir} />
        <al-button type="submit" variant="secondary">Search</al-button>
      </form>
      <al-button href={Admin.Issues.New { org: session.org }}>New issue</al-button>
    </al-stack>

    <p id="count">{if model.count == 1 then "1 row" else Text.fromInt model.count ++ " rows"}</p>

    <al-table>
      <table>
        <thead>
          <tr>
            -- @admin begin headers
            <th><span class="sr-only">Choose</span></th>
            <th><a href={listAt model "title" (toggle model "title") 1}>Title</a></th>
            <th><a href={listAt model "project" (toggle model "project") 1}>Project</a></th>
            <th><a href={listAt model "status" (toggle model "status") 1}>Status</a></th>
            <th><a href={listAt model "assignee" (toggle model "assignee") 1}>Assignee</a></th>
            <th><a href={listAt model "created" (toggle model "created") 1}>Created</a></th>
            -- @admin end
          </tr>
        </thead>
        <tbody>
          {for row in model.rows ->
            <tr>
              -- @admin begin cells
              <td>
                <input
                  type="checkbox"
                  name="ids"
                  form="bulk"
                  value={row.id}
                  aria-label={"Choose " ++ row.title} />
              </td>
              <td><a href={Admin.Issues.Show { org: session.org, id: row.id }}>{row.title}</a></td>
              <td>
                <a href={Admin.Projects.Show { org: session.org, id: row.project }}>
                  {projectLabel model.labels row.project}
                </a>
              </td>
              <td>
                <al-badge>
                  {match row.status {
                    Open -> "Open",
                    Closed -> "Closed",
                  }}
                </al-badge>
              </td>
              <td>
                {match row.assignee {
                  Just v -> <a href={Admin.Users.Show { id: v }}>{assigneeLabel model.labels v}</a>,
                  Nothing -> Html.none,
                }}
              </td>
              <td>{Time.format "Jan 2, 2006" row.created}</td>
              -- @admin end
            </tr>}
        </tbody>
      </table>
    </al-table>

    <al-stack direction="row" gap="sm">
      <form id="bulk" method="get" action={"/admin/orgs/" ++ session.org ++ "/issue/bulk"}>
        <al-button type="submit" variant="secondary">Act on the chosen rows</al-button>
      </form>
      <form id="bulk-page" method="get" action={"/admin/orgs/" ++ session.org ++ "/issue/bulk"}>
        {for row in model.rows -> <input type="hidden" name="ids" value={row.id} />}
        <al-button type="submit" variant="secondary">Act on all rows on this page</al-button>
      </form>
    </al-stack>

    <al-pagination role="navigation" aria-label="Pages">
      {if model.page > 1 then
        <a slot="prev" href={listAt model model.sort model.dir (model.page - 1)} rel="prev">
          Previous
        </a>
      else
        <span slot="prev" aria-disabled="true">Previous</span>}
      <span>Page {Text.fromInt model.page} of {Text.fromInt model.pages}</span>
      {if model.page < model.pages then
        <a slot="next" href={listAt model model.sort model.dir (model.page + 1)} rel="next">Next</a>
      else
        <span slot="next" aria-disabled="true">Next</span>}
    </al-pagination>
  </Layout.Page>

-- @admin begin tests
test "the list shows every row, newest first, and the labels of the rows they refer to" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let issue1 <- Db.insert Issue {
    title: Text.NonEmpty "title-1",
    project: project1,
    org: org,
    assignee: Nothing,
  }
  let issue2 <- Db.insert Issue {
    title: Text.NonEmpty "title-2",
    project: project1,
    org: org,
    assignee: Nothing,
  }
  let project2 <- Db.insert Project { name: Text.NonEmpty "name-2", org: org }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let assigneesAll <- Db.from User |> Db.all
  let page <- Test.get (Admin.Issues.Index { org: org })
  Task.succeed (
    {
      rows: List.map (\row -> row.id) page.model.rows,
      projects: List.length page.model.labels.projects,
      projectLabel: projectLabel page.model.labels project1,
      assigneeLabel: assigneeLabel { page.model.labels | assignees: assigneesAll } user2,
      assignees: List.length page.model.labels.assignees,
    } == {
      rows: [issue2, issue1],
      projects: 1,
      projectLabel: "name-1",
      assigneeLabel: "email-2@example.com",
      assignees: 0,
    }
  )
}

test "sorting by title goes both ways" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let issue1 <- Db.insert Issue {
    title: Text.NonEmpty "title-2",
    project: project1,
    org: org,
    assignee: Nothing,
  }
  let issue2 <- Db.insert Issue {
    title: Text.NonEmpty "title-1",
    project: project1,
    org: org,
    assignee: Nothing,
  }
  let up <-
    Test.get (Admin.Issues.Index {
      org: org,
      sort: "title",
      dir: "asc",
    })
  let down <- Test.get (Admin.Issues.Index { org: org, sort: "title" })
  Task.succeed (
    {
      up: List.map (\row -> row.id) up.model.rows,
      down: List.map (\row -> row.id) down.model.rows,
      toggles: [toggle up.model "title", toggle down.model "title", toggle up.model "project"],
    } == {
      up: [issue2, issue1],
      down: [issue1, issue2],
      toggles: ["desc", "asc", "asc"],
    }
  )
}

test "searching finds the rows that contain the text" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let issue1 <- Db.insert Issue {
    title: Text.NonEmpty "title-1",
    project: project1,
    org: org,
    assignee: Nothing,
  }
  let issue2 <- Db.insert Issue {
    title: Text.NonEmpty "title-2",
    project: project1,
    org: org,
    assignee: Nothing,
  }
  let page <- Test.get (Admin.Issues.Index { org: org, q: "title-2" })
  Task.succeed (
    { rows: List.map (\row -> row.id) page.model.rows, count: Test.text "#count" page.doc }
      == { rows: [issue2], count: Just "1 row" }
  )
}

test "filtering by status lists the rows with that value" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let issue1 <- Db.insert Issue {
    title: Text.NonEmpty "title-1",
    project: project1,
    org: org,
    status: Closed,
    assignee: Nothing,
  }
  let issue2 <- Db.insert Issue {
    title: Text.NonEmpty "title-2",
    project: project1,
    org: org,
    status: Open,
    assignee: Nothing,
  }
  let closed <- Test.get (Admin.Issues.Index { org: org, status: "Closed" })
  Task.succeed (
    {
      closed: List.map (\id -> List.member id (List.map (\row -> row.id) closed.model.rows)) [
        issue1,
        issue2,
      ],
      count: closed.model.count == List.length closed.model.rows,
      chosen: Test.texts "select[name=status] option[selected]" closed.doc,
    } == {
      closed: [True, False],
      count: True,
      chosen: ["Closed"],
    }
  )
}

test "a search text of 20,000 characters is cut to 200" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let long = Text.join "" (List.map (\n -> "z") (List.range 1 20000))
  let page <- Test.get (Admin.Issues.Index { org: org, q: long })
  Task.succeed (
    { q: Text.length page.model.q, rows: List.length page.model.rows } == { q: 200, rows: 0 }
  )
}

test "the list has 25 rows a page, and a page past the last is the last" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Issue {
        title: Text.NonEmpty ("title-" ++ Text.fromInt n),
        project: project1,
        org: org,
        assignee: Nothing,
      }) (List.range 1 26)
    )
  let first <- Test.get (Admin.Issues.Index { org: org })
  let second <- Test.get (Admin.Issues.Index { org: org, page: 2 })
  let past <- Test.get (Admin.Issues.Index { org: org, page: 9 })
  Task.succeed (
    {
      first: List.length first.model.rows,
      second: List.length second.model.rows,
      past: { page: past.model.page, rows: List.length past.model.rows },
      count: Test.text "#count" first.doc,
      pages: Test.texts "al-pagination span" first.doc,
    } == {
      first: 25,
      second: 1,
      past: { page: 2, rows: 1 },
      count: Just "26 rows",
      pages: ["Previous", "Page 1 of 2"],
    }
  )
}

-- Each org's rows live in its own database: the page's parameter and the role check open it.
test "an Admin who is no member of the org lists its issues, and only its" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let issue1 <- Db.insert Issue {
    title: Text.NonEmpty "title-1",
    project: project1,
    org: org,
    assignee: Nothing,
  }
  let other <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let project2 <- Db.insert Project { name: Text.NonEmpty "name-2", org: other }
  let issue2 <- Db.insert Issue {
    title: Text.NonEmpty "title-2",
    project: project2,
    org: other,
    assignee: Nothing,
  }
  let page <- Test.get (Admin.Issues.Index { org: org })
  let them <- Test.get (Admin.Issues.Index { org: other })
  Task.succeed (
    {
      mine: List.map (\row -> row.id) page.model.rows,
      theirs: List.map (\row -> row.id) them.model.rows,
    }
      == { mine: [issue1], theirs: [issue2] }
  )
}

test "a visitor is sent to log in" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let r <- Test.open (Admin.Issues.Index { org: org })
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Member gets no page, even one made Admin since logging in" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Member,
  }
  let r <- Test.open (Admin.Issues.Index { org: org })
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Member,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let r <- Test.open (Admin.Issues.Index { org: org })
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
