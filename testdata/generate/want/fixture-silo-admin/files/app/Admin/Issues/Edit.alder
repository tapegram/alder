-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Issues.Edit

-- @admin begin imports
import Admin.Layout
import Issue
import Org
import Project
import User
-- @admin end

page "/admin/orgs/{org}/issue/{id}/edit" {
  org: Org.OrgId,
  id: Issue.IssueId,
  findProject: Text = "",
  findAssignee: Text = "",
} requires user, role Admin, silo org

type Model = {
  row: Issue,
  -- @admin begin model
  projects: List Project,
  projectsTotal: Int,
  assignees: List User,
  assigneesTotal: Int,
  -- @admin end
}

load : Params -> Session -> Query Model
load params session = {
  let admin <- Layout.isAdmin session.user
  if admin then {
    -- @admin begin load
    let found <- Db.get Issue params.id
    match found {
      Just row -> {
        let findProject = Text.slice 0 200 params.findProject
        let projectsTotal <- Db.from Project |> Db.count
        let projectsOwn <-
          if projectsTotal > 200 then
            Db.from Project
              |> Db.where (Project.id.eq row.project)
              |> Db.all
          else
            Query.succeed []
        let projectsFound <-
          Db.from Project
            |> Db.orderBy Project.name.asc
            |> Db.where (
              if projectsTotal > 200 then
                Db.and [Project.name.contains findProject, Project.id.ne row.project]
              else
                Db.and []
            )
            |> Db.limit (if projectsTotal > 200 then 50 else 200)
            |> Db.all
        let projects = projectsOwn ++ projectsFound
        let findAssignee = Text.slice 0 200 params.findAssignee
        let assigneesTotal <- Db.from User |> Db.count
        let assigneesOwn <-
          if assigneesTotal > 200 then
            Db.from User
              |> Db.where (User.id.in (List.filterMap (\i -> i) [row.assignee]))
              |> Db.all
          else
            Query.succeed []
        let assigneesFound <-
          Db.from User
            |> Db.orderBy User.email.asc
            |> Db.where (
              if assigneesTotal > 200 then
                Db.and [
                  User.email.contains findAssignee,
                  Db.not (User.id.in (List.filterMap (\i -> i) [row.assignee])),
                ]
              else
                Db.and []
            )
            |> Db.limit (if assigneesTotal > 200 then 50 else 200)
            |> Db.all
        let assignees = assigneesOwn ++ assigneesFound
        Query.succeed {
          row: row,
          projects: projects,
          projectsTotal: projectsTotal,
          assignees: assignees,
          assigneesTotal: assigneesTotal,
        }
      },
      Nothing -> Query.notFound,
    }
    -- @admin end
  } else
    Query.notFound
}

-- @admin begin form
form IssueForm = {
  title: Text.NonEmpty,
  project: Project.ProjectId,
  status: Issue.Status,
  assignee: Maybe User.UserId,
}
-- @admin end

-- @admin begin search
form FindProject = { q: Text }

msg SearchProject form FindProject

form FindAssignee = { q: Text }

msg SearchAssignee form FindAssignee

-- @admin end

msg Save form IssueForm

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  -- @admin begin finds
  SearchProject p ->
    Task.succeed (
      Redirect (Admin.Issues.Edit {
        org: session.org,
        id: model.row.id,
        findProject: Text.slice 0 200 p.form.q,
      })
    ),
  SearchAssignee p ->
    Task.succeed (
      Redirect (Admin.Issues.Edit {
        org: session.org,
        id: model.row.id,
        findAssignee: Text.slice 0 200 p.form.q,
      })
    ),
  -- @admin end
  Save p -> {
    -- @admin begin update
    let _ <- Db.update Issue model.row.id (\row -> { row |
      title: p.form.title,
      project: p.form.project,
      status: p.form.status,
      assignee: p.form.assignee
    })
    Task.succeed (Redirect (Admin.Issues.Show { org: session.org, id: model.row.id }))
    -- @admin end
  },
}

view : Model -> Session -> Html Msg
view model session =
  <Layout.Page title="Edit issue">
    <h1>Edit issue</h1>

    <al-card>
      -- @admin begin finder
      {if model.projectsTotal > 200 then
        <form submit={SearchProject}>
          <al-input field="q" label="Find project" />
          <al-button type="submit" variant="secondary">Find</al-button>
        </form>
      else
        <span></span>}
      {if model.assigneesTotal > 200 then
        <form submit={SearchAssignee}>
          <al-input field="q" label="Find assignee" />
          <al-button type="submit" variant="secondary">Find</al-button>
        </form>
      else
        <span></span>}
      -- @admin end
      <form submit={Save}>
        -- @admin begin inputs
        <al-input field="title" label="Title" value={model.row.title} />
        <al-select
          field="project"
          label="Project"
          options={List.map (\r -> { value: r.id, label: r.name }) model.projects}
          value={model.row.project} />
        <al-select field="status" label="Status" value={model.row.status} />
        <al-select
          field="assignee"
          label="Assignee"
          options={List.map (\r -> { value: r.id, label: r.email }) model.assignees}
          value={model.row.assignee} />
        -- @admin end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Save</al-button>
      </form>
    </al-card>
    <a href={Admin.Issues.Show { org: session.org, id: model.row.id }}>Back</a>
  </Layout.Page>

-- @admin begin tests
test "saving changes every field" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let issue1 <- Db.insert Issue {
    title: Text.NonEmpty "title-1",
    project: project1,
    org: org,
    assignee: Nothing,
  }
  let project2 <- Db.insert Project { name: Text.NonEmpty "name-2", org: org }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let page <- Test.get (Admin.Issues.Edit { org: org, id: issue1 })
  let r <- Test.submit IssueForm {
    title: Text.NonEmpty "title-2",
    project: project2,
    status: Closed,
    assignee: Just user2,
  }
  let after <- Db.get Issue issue1
  Task.succeed (
    {
      answer: r.answer,
      row: Maybe.map (\row -> {
        title: row.title,
        project: row.project,
        status: row.status,
        assignee: row.assignee,
      }) after,
      projects: Test.texts "select[name=project] option" page.doc,
      assignees: Test.texts "select[name=assignee] option" page.doc,
    } == {
        answer: Redirected (Admin.Issues.Show { org: org, id: issue1 }),
        row: Just {
          title: Text.NonEmpty "title-2",
          project: project2,
          status: Closed,
          assignee: Just user2,
        },
        projects: ["name-1", "name-2"],
        assignees: ["", "email-1@example.com", "email-2@example.com"],
      }
  )
}

test "a project not offered is refused" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let issue1 <- Db.insert Issue {
    title: Text.NonEmpty "title-1",
    project: project1,
    org: org,
    assignee: Nothing,
  }
  let project2 <- Db.insert Project { name: Text.NonEmpty "name-2", org: org }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let page <- Test.get (Admin.Issues.Edit { org: org, id: issue1 })
  let r <- Test.submitRaw IssueForm [
    { name: "title", value: "x" },
    { name: "project", value: "missing" },
    { name: "status", value: "Open" },
    { name: "assignee", value: "" },
  ]
  let after <- Db.get Issue issue1
  Task.succeed (
    { answer: r.answer, project: Maybe.map (\row -> row.project) after }
      == {
        answer: FormRejected [{ field: "project", message: "must be one of the options" }],
        project: Just project1,
      }
  )
}

test "an assignee not offered is refused" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let issue1 <- Db.insert Issue {
    title: Text.NonEmpty "title-1",
    project: project1,
    org: org,
    assignee: Nothing,
  }
  let project2 <- Db.insert Project { name: Text.NonEmpty "name-2", org: org }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let page <- Test.get (Admin.Issues.Edit { org: org, id: issue1 })
  let projectId = Maybe.withDefault "" (Test.attr "value" "select[name=project] option" page.doc)
  let r <- Test.submitRaw IssueForm [
    { name: "title", value: "x" },
    { name: "project", value: projectId },
    { name: "status", value: "Open" },
    { name: "assignee", value: "missing" },
  ]
  let after <- Db.get Issue issue1
  Task.succeed (
    { answer: r.answer, assignee: Maybe.map (\row -> row.assignee) after }
      == {
        answer: FormRejected [{ field: "assignee", message: "must be one of the options" }],
        assignee: Just Nothing,
      }
  )
}

test "a list of 200 projects is offered whole" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let issue1 <- Db.insert Issue {
    title: Text.NonEmpty "title-1",
    project: project1,
    org: org,
    assignee: Nothing,
  }
  let project2 <- Db.insert Project { name: Text.NonEmpty "name-2", org: org }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Project {
        name: Text.NonEmpty ("name-" ++ Text.fromInt n),
        org: org,
      }) (List.range 3 200)
    )
  let page <- Test.get (Admin.Issues.Edit { org: org, id: issue1 })
  Task.succeed (List.length page.model.projects == 200)
}

test "a long list of projects offers 50, and the search narrows it" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let issue1 <- Db.insert Issue {
    title: Text.NonEmpty "title-1",
    project: project1,
    org: org,
    assignee: Nothing,
  }
  let project2 <- Db.insert Project { name: Text.NonEmpty "name-2", org: org }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Project {
        name: Text.NonEmpty ("name-" ++ Text.fromInt n),
        org: org,
      }) (List.range 3 203)
    )
  let all <- Test.get (Admin.Issues.Edit { org: org, id: issue1 })
  let found <-
    Test.get (Admin.Issues.Edit {
      org: org,
      id: issue1,
      findProject: "name-203",
    })
  let r <- Test.submit FindProject { q: "zz" }
  Task.succeed (
    {
      shown: List.length all.model.projects,
      total: all.model.projectsTotal,
      found: Test.count "select[name=project] option" found.doc <= 3,
      answer: r.answer,
    } == {
        shown: 51,
        total: 203,
        found: True,
        answer: Redirected (Admin.Issues.Edit {
          org: org,
          id: issue1,
          findProject: "zz",
        }),
      }
  )
}

test "the row's own project is offered first when it sorts past the 50" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "zz-1", org: org }
  let issue1 <- Db.insert Issue {
    title: Text.NonEmpty "title-1",
    project: project1,
    org: org,
    assignee: Nothing,
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Project {
        name: Text.NonEmpty ("name-" ++ Text.fromInt n),
        org: org,
      }) (List.range 2 202)
    )
  let page <- Test.get (Admin.Issues.Edit { org: org, id: issue1 })
  let r <- Test.submit IssueForm {
    title: page.model.row.title,
    project: page.model.row.project,
    status: page.model.row.status,
    assignee: page.model.row.assignee,
  }
  let after <- Db.get Issue issue1
  Task.succeed (
    {
      answer: r.answer,
      kept: Maybe.map (\row -> row.project) after,
      first: Maybe.map (\o -> o.id) (List.head page.model.projects),
      once: List.length (List.filter (\o -> o.id == project1) page.model.projects),
      shown: List.length page.model.projects,
    } == {
        answer: Redirected (Admin.Issues.Show { org: org, id: issue1 }),
        kept: Just project1,
        first: Just project1,
        once: 1,
        shown: 51,
      }
  )
}

