-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Issues.New

-- @admin begin imports
import Admin.Layout
import Issue
import Org
import Project
import User
-- @admin end

-- @admin begin routes
route New    = GET  "/admin/orgs/{org}/issue/new" { org: Org.OrgId, findProject: Text = "", findAssignee: Text = "" } requires user, role Admin, silo org
route Create = POST "/admin/orgs/{org}/issue"     { org: Org.OrgId } form IssueForm                                   requires user, role Admin, silo org
-- @admin end

type Model = {
  -- @admin begin model
  projects: List Project,
  projectsTotal: Int,
  findProject: Text,
  assignees: List User,
  assigneesTotal: Int,
  findAssignee: Text,
  -- @admin end
}

New.load : New.Params -> Session -> Query Model
New.load params session = {
  let _ <- Layout.adminOnly session.user
  -- @admin begin load
  let findProject = Text.slice 0 200 params.findProject
  let projectsTotal <- Db.from Project |> Db.count
  let projects <-
    Db.from Project
      |> Db.orderBy Project.name.asc
      |> Db.where (if projectsTotal > 200 then Project.name.contains findProject else Db.and [])
      |> Db.limit (if projectsTotal > 200 then 50 else 200)
      |> Db.all
  let findAssignee = Text.slice 0 200 params.findAssignee
  let assigneesTotal <- Db.from User |> Db.count
  let assignees <-
    Db.from User
      |> Db.orderBy User.email.asc
      |> Db.where (if assigneesTotal > 200 then User.email.contains findAssignee else Db.and [])
      |> Db.limit (if assigneesTotal > 200 then 50 else 200)
      |> Db.all
  Query.succeed {
    projects: projects,
    projectsTotal: projectsTotal,
    findProject: findProject,
    assignees: assignees,
    assigneesTotal: assigneesTotal,
    findAssignee: findAssignee,
  }
  -- @admin end
}

-- @admin begin form
form IssueForm = {
  title: Text.NonEmpty,
  project: Project.ProjectId,
  status: Issue.Status,
  assignee: Maybe User.UserId,
}
-- @admin end

-- @admin begin search
-- @admin end

-- Create adds the row and goes to its page.
Create.update : Create.Params -> Session -> Task Response
Create.update params session = {
  let _ <- Layout.adminOnly session.user
  -- @admin begin insert
  let id <- Db.insert Issue {
    title: params.form.title,
    project: params.form.project,
    status: params.form.status,
    assignee: params.form.assignee,
    org: session.org,
  }
  Task.succeed (Response.redirect (Admin.Issues.Show.Show { org: session.org, id: id }))
  -- @admin end
}

New.view : Model -> Session -> Html
New.view model session =
  <Layout.Page title="New issue">
    <h1>New issue</h1>

    <al-card>
      -- @admin begin finder
      {if model.projectsTotal > 200 then
        <form method="get" action={"/admin/orgs/" ++ session.org ++ "/issue/new"}>
          <al-input>
            <label>
              Find project <input type="search" name="findProject" value={model.findProject} />
            </label>
          </al-input>
          <al-button type="submit" variant="secondary">Find</al-button>
        </form>
      else
        Html.none}
      {if model.assigneesTotal > 200 then
        <form method="get" action={"/admin/orgs/" ++ session.org ++ "/issue/new"}>
          <al-input>
            <label>
              Find assignee <input type="search" name="findAssignee" value={model.findAssignee} />
            </label>
          </al-input>
          <al-button type="submit" variant="secondary">Find</al-button>
        </form>
      else
        Html.none}
      -- @admin end
      <form submit={Create { org: session.org }}>
        -- @admin begin inputs
        <al-input field="title" label="Title" />
        <al-select
          field="project"
          label="Project"
          options={List.map (\r -> { value: r.id, label: r.name }) model.projects} />
        <al-select field="status" label="Status" value={Open} />
        <al-select
          field="assignee"
          label="Assignee"
          options={List.map (\r -> { value: r.id, label: r.email }) model.assignees} />
        -- @admin end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Create</al-button>
      </form>
    </al-card>
  </Layout.Page>

-- @admin begin tests
test "creating an issue adds it, with the values submitted" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let project2 <- Db.insert Project { name: Text.NonEmpty "name-2", org: org }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let page <- Test.get (New { org: org })
  let r <- Test.submit (Create { org: org }) {
    title: Text.NonEmpty "title-1",
    project: project2,
    status: Closed,
    assignee: Just user2,
  }
  let rows <- Db.from Issue |> Db.all
  Task.succeed (
    {
      answers: List.map (\row -> Redirected (Admin.Issues.Show.Show { org: org, id: row.id })) rows,
      rows: List.map (\row -> {
        title: row.title,
        project: row.project,
        status: row.status,
        assignee: row.assignee,
      }) rows,
      projects: Test.texts "select[name=project] option" page.doc,
      assignees: Test.texts "select[name=assignee] option" page.doc,
    } == {
      answers: [r.answer],
      rows: [
        {
          title: Text.NonEmpty "title-1",
          project: project2,
          status: Closed,
          assignee: Just user2,
        },
      ],
      projects: ["name-1", "name-2"],
      assignees: ["", "email-1@example.com", "email-2@example.com"],
    }
  )
}

test "a project not offered is refused" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let project2 <- Db.insert Project { name: Text.NonEmpty "name-2", org: org }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let page <- Test.get (New { org: org })
  let r <- Test.submitRaw (Create { org: org }) [
    { name: "title", value: "x" },
    { name: "project", value: "missing" },
    { name: "status", value: "Open" },
    { name: "assignee", value: "" },
  ]
  let rows <- Db.from Issue |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows }
      == {
        answer: FormRejected [{ field: "project", message: "must be one of the options" }],
        rows: 0,
      }
  )
}

