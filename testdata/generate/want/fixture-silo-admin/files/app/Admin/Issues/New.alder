test "a visitor cannot create an issue" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let project2 <- Db.insert Project { name: Text.NonEmpty "name-2", org: org }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let _ <- Test.get (New { org: org })
  let _ <- Test.login { user: Nothing, org: Nothing }
  let r <- Test.submit (Create { org: org }) {
    title: Text.NonEmpty "title-1",
    project: project2,
    status: Closed,
    assignee: Just user2,
  }
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let rows <- Db.from Issue |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows } == { answer: Redirected (Auth.Login.Login {}), rows: 0 }
  )
}

test "a Member cannot create an issue, even one made Admin since logging in" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let project2 <- Db.insert Project { name: Text.NonEmpty "name-2", org: org }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let _ <- Test.get (New { org: org })
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Member,
  }
  let r <- Test.submit (Create { org: org }) {
    title: Text.NonEmpty "title-1",
    project: project2,
    status: Closed,
    assignee: Just user2,
  }
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let rows <- Db.from Issue |> Db.count
  Task.succeed ({ answer: r.answer, rows: rows } == { answer: PageMissing, rows: 0 })
}

test "a demoted Admin cannot create an issue" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let project2 <- Db.insert Project { name: Text.NonEmpty "name-2", org: org }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let _ <- Test.get (New { org: org })
  let _ <- Db.update User me (\u -> { u | role: Member })
  let r <- Test.submit (Create { org: org }) {
    title: Text.NonEmpty "title-1",
    project: project2,
    status: Closed,
    assignee: Just user2,
  }
  let rows <- Db.from Issue |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows } == { answer: RequestFailed "400 bad request", rows: 0 }
  )
}

test "a visitor is sent to log in" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let r <- Test.open (New { org: org })
  Task.succeed (r.answer == Redirected (Auth.Login.Login {}))
}

test "a Member gets no page, even one made Admin since logging in" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Member,
  }
  let r <- Test.open (New { org: org })
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Member,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let r <- Test.open (New { org: org })
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
