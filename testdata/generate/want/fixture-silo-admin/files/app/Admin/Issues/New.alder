-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Issues.New

-- @admin begin imports
import Admin.Layout
import Issue
import Org
import Project
import User
-- @admin end

page "/admin/orgs/{org}/issue/new" {
  org: Org.OrgId,
  findProject: Text = "",
  findAssignee: Text = "",
} requires user, role Admin, silo org

type Model = {
  -- @admin begin model
  projects: List Project,
  projectsTotal: Int,
  assignees: List User,
  assigneesTotal: Int,
  -- @admin end
}

load : Params -> Session -> Query Model
load params session = {
  let admin <- Layout.isAdmin session.user
  if admin then {
    -- @admin begin load
    let findProject = Text.slice 0 200 params.findProject
    let projectsTotal <- Db.from Project |> Db.count
    let projects <-
      Db.from Project
        |> Db.orderBy Project.name.asc
        |> Db.where (if projectsTotal > 200 then Project.name.contains findProject else Db.and [])
        |> Db.limit (if projectsTotal > 200 then 50 else 200)
        |> Db.all
    let findAssignee = Text.slice 0 200 params.findAssignee
    let assigneesTotal <- Db.from User |> Db.count
    let assignees <-
      Db.from User
        |> Db.orderBy User.email.asc
        |> Db.where (if assigneesTotal > 200 then User.email.contains findAssignee else Db.and [])
        |> Db.limit (if assigneesTotal > 200 then 50 else 200)
        |> Db.all
    Query.succeed {
      projects: projects,
      projectsTotal: projectsTotal,
      assignees: assignees,
      assigneesTotal: assigneesTotal,
    }
    -- @admin end
  } else
    Query.notFound
}

-- @admin begin form
form IssueForm = {
  title: Text.NonEmpty,
  project: Project.ProjectId,
  status: Issue.Status,
  assignee: Maybe User.UserId,
}
-- @admin end

-- @admin begin search
form FindProject = { q: Text }

msg SearchProject form FindProject

form FindAssignee = { q: Text }

msg SearchAssignee form FindAssignee

-- @admin end

msg Create form IssueForm

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  -- @admin begin finds
  SearchProject p ->
    Task.succeed (
      Redirect (Admin.Issues.New { org: session.org, findProject: Text.slice 0 200 p.form.q })
    ),
  SearchAssignee p ->
    Task.succeed (
      Redirect (Admin.Issues.New { org: session.org, findAssignee: Text.slice 0 200 p.form.q })
    ),
  -- @admin end
  Create p -> {
    -- @admin begin insert
    let id <- Db.insert Issue {
      title: p.form.title,
      project: p.form.project,
      status: p.form.status,
      assignee: p.form.assignee,
      org: session.org,
    }
    Task.succeed (Redirect (Admin.Issues.Show { org: session.org, id: id }))
    -- @admin end
  },
}

view : Model -> Session -> Html Msg
view model session =
  <Layout.Page title="New issue">
    <h1>New issue</h1>

    <al-card>
      -- @admin begin finder
      {if model.projectsTotal > 200 then
        <form submit={SearchProject}>
          <al-input field="q" label="Find project" />
          <al-button type="submit" variant="secondary">Find</al-button>
        </form>
      else
        <span></span>}
      {if model.assigneesTotal > 200 then
        <form submit={SearchAssignee}>
          <al-input field="q" label="Find assignee" />
          <al-button type="submit" variant="secondary">Find</al-button>
        </form>
      else
        <span></span>}
      -- @admin end
      <form submit={Create}>
        -- @admin begin inputs
        <al-input field="title" label="Title" />
        <al-select
          field="project"
          label="Project"
          options={List.map (\r -> { value: r.id, label: r.name }) model.projects} />
        <al-select field="status" label="Status" value={Open} />
        <al-select
          field="assignee"
          label="Assignee"
          options={List.map (\r -> { value: r.id, label: r.email }) model.assignees} />
        -- @admin end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Create</al-button>
      </form>
    </al-card>
  </Layout.Page>

-- @admin begin tests
test "creating an issue adds it, with the values submitted" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let project2 <- Db.insert Project { name: Text.NonEmpty "name-2", org: org }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let page <- Test.get (Admin.Issues.New { org: org })
  let r <- Test.submit IssueForm {
    title: Text.NonEmpty "title-1",
    project: project2,
    status: Closed,
    assignee: Just user2,
  }
  let rows <- Db.from Issue |> Db.all
  Task.succeed (
    {
      answers: List.map (\row -> Redirected (Admin.Issues.Show { org: org, id: row.id })) rows,
      rows: List.map (\row -> {
        title: row.title,
        project: row.project,
        status: row.status,
        assignee: row.assignee,
      }) rows,
      projects: Test.texts "select[name=project] option" page.doc,
      assignees: Test.texts "select[name=assignee] option" page.doc,
    } == {
        answers: [r.answer],
        rows: [
          {
            title: Text.NonEmpty "title-1",
            project: project2,
            status: Closed,
            assignee: Just user2,
          },
        ],
        projects: ["name-1", "name-2"],
        assignees: ["", "email-1@example.com", "email-2@example.com"],
      }
  )
}

test "a project not offered is refused" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let project2 <- Db.insert Project { name: Text.NonEmpty "name-2", org: org }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let page <- Test.get (Admin.Issues.New { org: org })
  let r <- Test.submitRaw IssueForm [
    { name: "title", value: "x" },
    { name: "project", value: "missing" },
    { name: "status", value: "Open" },
    { name: "assignee", value: "" },
  ]
  let rows <- Db.from Issue |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows }
      == {
        answer: FormRejected [{ field: "project", message: "must be one of the options" }],
        rows: 0,
      }
  )
}

test "an assignee not offered is refused" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let project2 <- Db.insert Project { name: Text.NonEmpty "name-2", org: org }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let page <- Test.get (Admin.Issues.New { org: org })
  let projectId = Maybe.withDefault "" (Test.attr "value" "select[name=project] option" page.doc)
  let r <- Test.submitRaw IssueForm [
    { name: "title", value: "x" },
    { name: "project", value: projectId },
    { name: "status", value: "Open" },
    { name: "assignee", value: "missing" },
  ]
  let rows <- Db.from Issue |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows }
      == {
        answer: FormRejected [{ field: "assignee", message: "must be one of the options" }],
        rows: 0,
      }
  )
}

test "a list of 200 projects is offered whole" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let project2 <- Db.insert Project { name: Text.NonEmpty "name-2", org: org }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Project {
        name: Text.NonEmpty ("name-" ++ Text.fromInt n),
        org: org,
      }) (List.range 3 200)
    )
  let page <- Test.get (Admin.Issues.New { org: org })
  Task.succeed (List.length page.model.projects == 200)
}

test "a long list of projects offers 50, and the search narrows it" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let project2 <- Db.insert Project { name: Text.NonEmpty "name-2", org: org }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Project {
        name: Text.NonEmpty ("name-" ++ Text.fromInt n),
        org: org,
      }) (List.range 3 203)
    )
  let all <- Test.get (Admin.Issues.New { org: org })
  let found <- Test.get (Admin.Issues.New { org: org, findProject: "name-203" })
  let r <- Test.submit FindProject { q: "zz" }
  Task.succeed (
    {
      shown: List.length all.model.projects,
      total: all.model.projectsTotal,
      found: Test.texts "select[name=project] option" found.doc == ["name-203"],
      answer: r.answer,
    } == {
        shown: 50,
        total: 203,
        found: True,
        answer: Redirected (Admin.Issues.New { org: org, findProject: "zz" }),
      }
  )
}

test "a project outside the narrowed list is refused" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let project2 <- Db.insert Project { name: Text.NonEmpty "name-2", org: org }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Project {
        name: Text.NonEmpty ("name-" ++ Text.fromInt n),
        org: org,
      }) (List.range 3 203)
    )
  let all <- Test.get (Admin.Issues.New { org: org })
  let found <- Test.get (Admin.Issues.New { org: org, findProject: "name-203" })
  let r <- Test.submit FindProject { q: "zz" }
  let pick = Maybe.withDefault "" (Test.attr "value" "select[name=project] option" found.doc)
  let page <- Test.get (Admin.Issues.New { org: org })
  let sent <- Test.submitRaw IssueForm [
    { name: "title", value: "x" },
    { name: "project", value: pick },
    { name: "status", value: "Open" },
    { name: "assignee", value: "" },
  ]
  let rows <- Db.from Issue |> Db.count
  Task.succeed (
    { answer: sent.answer, rows: rows }
      == {
        answer: FormRejected [{ field: "project", message: "must be one of the options" }],
        rows: 0,
      }
  )
}

