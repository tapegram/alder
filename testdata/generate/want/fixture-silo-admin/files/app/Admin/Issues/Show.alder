-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Issues.Show

-- @admin begin imports
import Admin.Layout
import Issue
import Org
import Project
import User
-- @admin end

-- @admin begin routes
route Show = GET "/admin/orgs/{org}/issue/{id}" { org: Org.OrgId, id: Issue.IssueId } requires user, role Admin, silo org
-- @admin end

-- The row, the labels of the rows it refers to, and (for the delete dialog) how many rows of
-- each table refer to it.
type Model = {
  row: Issue,
  labels: Labels,
  -- @admin begin model
  -- @admin end
}

Show.load : Show.Params -> Session -> Query Model
Show.load params session = {
  let _ <- Layout.adminOnly session.user
  -- @admin begin load
  let found <- Db.get Issue params.id
  match found {
    Just row -> {
      let labels <- labelsOf [row]
      Query.succeed { row: row, labels: labels }
    },
    Nothing -> Query.notFound,
  }
  -- @admin end
}

-- @admin begin labels
-- Labels are the rows the references of the rows shown name: their links show their labels.
type Labels = { projects: List Project, assignees: List User }

-- labelsOf reads the rows that rows refer to.
labelsOf : List Issue -> Query Labels
labelsOf rows = {
  let projects <-
    Db.from Project
      |> Db.where (Project.id.in (List.map (\row -> row.project) rows))
      |> Db.all
  let assignees <-
    Db.from User
      |> Db.where (User.id.in (List.filterMap (\row -> row.assignee) rows))
      |> Db.all
  Query.succeed { projects: projects, assignees: assignees }
}

-- projectLabel is the label of the project id names (the id itself if it names none).
projectLabel : Labels -> Project.ProjectId -> Text
projectLabel labels id = match List.find (\r -> r.id == id) labels.projects {
  Just r -> r.name,
  Nothing -> id,
}

-- assigneeLabel is the label of the user id names (the id itself if it names none).
assigneeLabel : Labels -> User.UserId -> Text
assigneeLabel labels id = match List.find (\r -> r.id == id) labels.assignees {
  Just r -> r.email,
  Nothing -> id,
}
-- @admin end

-- @admin begin blockers
-- blockers counts the rows that keep this one from being deleted, which the database would
-- refuse the delete for: the `@restrict` references to it, or to a row deleted with it.
blockers : Model -> Int
blockers model = 0
-- @admin end

Show.view : Model -> Session -> Html
Show.view model session =
  <Layout.Page title="Issue">
    <h1>Issue</h1>

    <al-card>
      <dl id="fields">
        -- @admin begin fields
        <dt>Id</dt>
        <dd>{model.row.id}</dd>
        <dt>Title</dt>
        <dd>{model.row.title}</dd>
        <dt>Project</dt>
        <dd>
          <a href={Admin.Projects.Show.Show { org: session.org, id: model.row.project }}>
            {projectLabel model.labels model.row.project}
          </a>
        </dd>
        <dt>Status</dt>
        <dd>
          <al-badge>
            {match model.row.status {
              Open -> "Open",
              Closed -> "Closed",
            }}
          </al-badge>
        </dd>
        <dt>Assignee</dt>
        <dd>
          {match model.row.assignee {
            Just v -> <a href={Admin.Users.Show.Show { id: v }}>{assigneeLabel model.labels v}</a>,
            Nothing -> Html.none,
          }}
        </dd>
        <dt>Created</dt>
        <dd>{Time.format "Jan 2, 2006" model.row.created}</dd>
        -- @admin end
      </dl>
      <div slot="actions">
        <al-button href={Admin.Issues.Edit.Edit { org: session.org, id: model.row.id }}>
          Edit
        </al-button>
        <al-button variant="destructive">
          <button type="button" commandfor="delete-dialog" command="show-modal">Delete</button>
        </al-button>
      </div>
    </al-card>
    <al-dialog id="delete-dialog" heading="Delete this issue?" dismissible>
      <dl>
        -- @admin begin counts
        -- @admin end
      </dl>
      <form id="delete" submit={Admin.Issues.Delete.Destroy { org: session.org, id: model.row.id }}>
        <al-alert variant="destructive"><Errors form /></al-alert>
        {if blockers model > 0 then
          <p>It cannot be deleted while other rows refer to it.</p>
        else
          <al-button variant="destructive" type="submit">Delete</al-button>}
      </form>
      <div slot="actions">
        <a href={Admin.Issues.Delete.Delete { org: session.org, id: model.row.id }}>
          See the details
        </a>
      </div>
    </al-dialog>
    <a href={Admin.Issues.Index.Index { org: session.org }}>All issues</a>
  </Layout.Page>

-- @admin begin tests
test "the page shows the row" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let issue1 <- Db.insert Issue {
    title: Text.NonEmpty "title-1",
    project: project1,
    org: org,
    assignee: Nothing,
  }
  let project2 <- Db.insert Project { name: Text.NonEmpty "name-2", org: org }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let assigneesAll <- Db.from User |> Db.all
  let r <- Test.open (Show { org: org, id: issue1 })
  let page <- Test.get (Show { org: org, id: issue1 })
  Task.succeed (
    {
      answer: r.answer,
      title: List.member "title-1" (Test.texts "#fields dd" r.doc),
      projects: List.length page.model.labels.projects,
      projectLabel: projectLabel page.model.labels project1,
      assigneeLabel: assigneeLabel { page.model.labels | assignees: assigneesAll } user2,
      assignees: List.length page.model.labels.assignees,
    } == {
      answer: Shown,
      title: True,
      projects: 1,
      projectLabel: "name-1",
      assigneeLabel: "email-2@example.com",
      assignees: 0,
    }
  )
}

test "deleting an issue nothing refers to" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let issue1 <- Db.insert Issue {
    title: Text.NonEmpty "title-1",
    project: project1,
    org: org,
    assignee: Nothing,
  }
  let page <- Test.get (Show { org: org, id: issue1 })
  let r <- Test.submit (Admin.Issues.Delete.Destroy { org: org, id: issue1 }) {}
  let gone <- Db.get Issue issue1
  Task.succeed (
    {
      button: Test.count "#delete al-button" page.doc,
      answer: r.answer,
      notices: r.notices,
      gone: Maybe.map (\row -> row.id) gone,
    } == {
      button: 1,
      answer: Redirected (Admin.Issues.Index.Index { org: org }),
      notices: ["Deleted"],
      gone: Nothing,
    }
  )
}

test "a missing row is not found" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let r <- Test.open (Show { org: org, id: Issue.IssueId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "a visitor is sent to log in" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let issue1 <- Db.insert Issue {
    title: Text.NonEmpty "title-1",
    project: project1,
    org: org,
    assignee: Nothing,
  }
  let r <- Test.open (Show { org: org, id: issue1 })
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Member gets no page, even one made Admin since logging in" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Member,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let issue1 <- Db.insert Issue {
    title: Text.NonEmpty "title-1",
    project: project1,
    org: org,
    assignee: Nothing,
  }
  let r <- Test.open (Show { org: org, id: issue1 })
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Member,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let issue1 <- Db.insert Issue {
    title: Text.NonEmpty "title-1",
    project: project1,
    org: org,
    assignee: Nothing,
  }
  let r <- Test.open (Show { org: org, id: issue1 })
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
