-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Project.Delete

-- @admin begin imports
import Admin.Layout
import Issue
import Org
import Project
import User
-- @admin end

page "/admin/org/{org}/project/{id}/delete" { org: Org.OrgId, id: Project.ProjectId } requires user, role Admin, silo org

-- The row, and how many rows of each table refer to it.
type Model = {
  row: Project,
  -- @admin begin model
  issues: Int,
  -- @admin end
}

load : Params -> Session -> Query Model
load params session = {
  let admin <- Admin.Layout.isAdmin session.user
  if admin then {
    -- @admin begin load
    let found <- Db.get Project params.id
    let issues <- Db.from Issue |> Db.where (Issue.project.eq params.id) |> Db.count
    match found {
      Just row -> Query.succeed { row: row, issues: issues },
      Nothing -> Query.notFound,
    }
    -- @admin end
  } else Query.notFound
}

-- @admin begin blockers
-- blockers counts the rows that keep this one from being deleted, which the database would
-- refuse the delete for: the `@restrict` references to it, or to a row deleted with it.
blockers : Model -> Int
blockers model = 0
-- @admin end

-- Delete takes no input: the form is the button, and the place a refusal is shown.
form Confirm = { }

msg Remove form Confirm

-- Remove deletes the row, unless rows refer to it that keep it (load counted them, as it does
-- before every message): the database would refuse the delete with an error, and the page says
-- why instead.
update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  Remove p -> {
    -- @admin begin remove
    let _ <- Db.delete Project model.row.id
    Task.succeed (Redirect (Admin.Project.Index { org: session.org }))
    -- @admin end
  },
}

view : Model -> Session -> Html Msg
view model session =
  <Admin.Layout.Page title="Delete project">
    <h1>Delete this project?</h1>

    <al-card>
      -- @admin begin row
      <p>{model.row.name}</p>
      -- @admin end
      <dl>
        -- @admin begin counts
        <dt>Issues deleted with it</dt>
        <dd id="issues">{Text.fromInt model.issues}</dd>
        -- @admin end
      </dl>
      <form id="delete" submit={Remove}>
        <al-alert variant="destructive"><Errors form /></al-alert>
        {if blockers model > 0 then <p>It cannot be deleted while other rows refer to it.</p> else <al-button variant="destructive" type="submit">Delete</al-button>}
      </form>
    </al-card>
    <a href={Admin.Project.Show { org: session.org, id: model.row.id }}>Back</a>
  </Admin.Layout.Page>

-- @admin begin tests
test "deleting a project nothing refers to" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org, role: Admin }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let project2 <- Db.insert Project { name: Text.NonEmpty "name-2", org: org }
  let _ <- Db.insert Issue {
    title: Text.NonEmpty "title-1",
    project: project2,
    org: org,
    assignee: Nothing,
  }
  let _ <- Test.get (Admin.Project.Delete { org: org, id: project1 })
  let r <- Test.submit Confirm { }
  let gone <- Db.get Project project1
  let kept <- Db.get Project project2
  Task.succeed ({
    answer: r.answer,
    gone: Maybe.map (\row -> row.id) gone,
    kept: Maybe.map (\row -> row.id) kept,
  } == {
    answer: Redirected (Admin.Project.Index { org: org }),
    gone: Nothing,
    kept: Just project2,
  })
}

test "the page counts the rows that go with it" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org, role: Admin }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let _ <- Db.insert Issue {
    title: Text.NonEmpty "title-1",
    project: project1,
    org: org,
    assignee: Nothing,
  }
  let project2 <- Db.insert Project { name: Text.NonEmpty "name-2", org: org }
  let _ <- Db.insert Issue {
    title: Text.NonEmpty "title-2",
    project: project2,
    org: org,
    assignee: Nothing,
  }
  let page <- Test.get (Admin.Project.Delete { org: org, id: project1 })
  Task.succeed ({ issues: Test.text "#issues" page.doc } == { issues: Just "1" })
}

test "a missing row is not found" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org, role: Admin }
  let r <- Test.open (Admin.Project.Delete { org: org, id: Project.ProjectId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "a visitor is sent to log in" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let r <- Test.open (Admin.Project.Delete { org: org, id: project1 })
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Member gets no page, even one made Admin since logging in" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, org: Nothing, role: Member }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let r <- Test.open (Admin.Project.Delete { org: org, id: project1 })
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Member,
  }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org, role: Admin }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let r <- Test.open (Admin.Project.Delete { org: org, id: project1 })
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
