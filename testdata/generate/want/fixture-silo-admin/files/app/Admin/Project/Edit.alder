-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Project.Edit

-- @admin begin imports
import Admin.Layout
import Org
import Project
import User
-- @admin end

page "/admin/org/{org}/project/{id}/edit" { org: Org.OrgId, id: Project.ProjectId } requires user, role Admin, silo org

type Model = {
  row: Project,
  -- @admin begin model
  -- @admin end
}

load : Params -> Session -> Query Model
load params session = {
  let admin <- Admin.Layout.isAdmin session.user
  if admin then {
    -- @admin begin load
    let found <- Db.get Project params.id
    match found {
      Just row -> {
        Query.succeed { row: row }
      },
      Nothing -> Query.notFound,
    }
    -- @admin end
  } else Query.notFound
}

-- @admin begin form
form ProjectForm = {
  name: Text.NonEmpty,
  archived: Bool,
}
-- @admin end

-- @admin begin search
-- @admin end

msg Save form ProjectForm

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  -- @admin begin finds
  -- @admin end
  Save p -> {
    -- @admin begin update
    let _ <- Db.update Project model.row.id (\row -> { row |
      name: p.form.name,
      archived: p.form.archived,
    })
    Task.succeed (Redirect (Admin.Project.Show { org: session.org, id: model.row.id }))
    -- @admin end
  },
}

view : Model -> Session -> Html Msg
view model session =
  <Admin.Layout.Page title="Edit project">
    <h1>Edit project</h1>

    <al-card>
      -- @admin begin finder
      -- @admin end
      <form submit={Save}>
        -- @admin begin inputs
        <al-input field="name" label="Name" value={model.row.name} />
        <al-checkbox field="archived" label="Archived" value={model.row.archived} />
        -- @admin end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Save</al-button>
      </form>
    </al-card>
    <a href={Admin.Project.Show { org: session.org, id: model.row.id }}>Back</a>
  </Admin.Layout.Page>

-- @admin begin tests
test "saving changes every field" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org, role: Admin }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let page <- Test.get (Admin.Project.Edit { org: org, id: project1 })
  let r <- Test.submit ProjectForm { name: Text.NonEmpty "name-2", archived: True }
  let after <- Db.get Project project1
  Task.succeed ({
    answer: r.answer,
    row: Maybe.map (\row -> { name: row.name, archived: row.archived }) after,
  } == {
    answer: Redirected (Admin.Project.Show { org: org, id: project1 }),
    row: Just { name: Text.NonEmpty "name-2", archived: True },
  })
}

test "a missing row is not found" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org, role: Admin }
  let r <- Test.open (Admin.Project.Edit { org: org, id: Project.ProjectId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "a visitor is sent to log in" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let r <- Test.open (Admin.Project.Edit { org: org, id: project1 })
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Member gets no page, even one made Admin since logging in" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, org: Nothing, role: Member }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let r <- Test.open (Admin.Project.Edit { org: org, id: project1 })
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Member,
  }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org, role: Admin }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let r <- Test.open (Admin.Project.Edit { org: org, id: project1 })
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
