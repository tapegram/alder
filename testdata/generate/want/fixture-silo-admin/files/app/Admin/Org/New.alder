-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Org.New

-- @admin begin imports
import Admin.Layout
import Org
import User
-- @admin end

page "/admin/org/new" { } requires user, role Admin

type Model = {
  -- @admin begin model
  -- @admin end
}

load : Params -> Session -> Query Model
load params session = {
  let admin <- Admin.Layout.isAdmin session.user
  if admin then {
    -- @admin begin load
    Query.succeed {}
    -- @admin end
  } else
    Query.notFound
}

-- @admin begin form
form OrgForm = { name: Text.NonEmpty }
-- @admin end

-- @admin begin search
-- @admin end

msg Create form OrgForm

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  -- @admin begin finds
  -- @admin end
  Create p -> {
    -- @admin begin insert
    let id <- Db.insert Org { name: p.form.name }
    Task.succeed (Redirect (Admin.Org.Show { id: id }))
    -- @admin end
  },
}

view : Model -> Session -> Html Msg
view model session =
  <Admin.Layout.Page title="New org">
    <h1>New org</h1>

    <al-card>
      -- @admin begin finder
      -- @admin end
      <form submit={Create}>
        -- @admin begin inputs
        <al-input field="name" label="Name" />
        -- @admin end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Create</al-button>
      </form>
    </al-card>
  </Admin.Layout.Page>

-- @admin begin tests
test "creating an org adds it, with the values submitted" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let page <- Test.get (Admin.Org.New {})
  let r <- Test.submit OrgForm { name: Text.NonEmpty "name-1" }
  let rows <- Db.from Org |> Db.all
  Task.succeed (
    {
      answers: List.map (\row -> Redirected (Admin.Org.Show { id: row.id })) rows,
      rows: List.map (\row -> { name: row.name }) rows,
    }
      == { answers: [r.answer], rows: [{ name: Text.NonEmpty "name-1" }] }
  )
}

test "a visitor is sent to log in" = {
  let r <- Test.open (Admin.Org.New {})
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Member gets no page, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Member,
  }
  let r <- Test.open (Admin.Org.New {})
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Member,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let r <- Test.open (Admin.Org.New {})
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
