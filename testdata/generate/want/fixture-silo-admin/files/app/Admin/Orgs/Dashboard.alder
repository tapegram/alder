-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Orgs.Dashboard

-- @admin begin imports
import Admin.Layout
import Issue
import Org
import Project
import User
-- @admin end

page "/admin/orgs/{org}" { org: Org.OrgId } requires user, role Admin, silo org

-- The org of the page's parameter: each table in `silo org`, counted in its database. The role
-- check guards the page (`silo org` takes the org from the parameter): an Admin need not be a member.
type Card = {
  key: Text,
  title: Text,
  href: Page,
  count: Int,
  rows: List { label: Text, href: Page },
}

type Model = { name: Text, cards: List Card }

-- recent is how many of a table's newest rows its card lists.
recent : Int
recent = 5

load : Params -> Session -> Query Model
load params session = {
  let admin <- Layout.isAdmin session.user
  if admin then {
    -- @admin begin cards
    let found <- Db.get Org params.org
    match found {
      Just row -> {
        let issues <-
          Db.from Issue
            |> Db.orderBy Issue.created.desc
            |> Db.limit recent
            |> Db.all
        let issueCount <- Db.from Issue |> Db.count
        let projects <-
          Db.from Project
            |> Db.orderBy Project.created.desc
            |> Db.limit recent
            |> Db.all
        let projectCount <- Db.from Project |> Db.count
        Query.succeed {
          name: row.name,
          cards: [
            {
              key: "issues",
              title: "Issues",
              href: Admin.Issues.Index { org: params.org },
              count: issueCount,
              rows: List.map (\row -> {
                label: row.title,
                href: Admin.Issues.Show { org: params.org, id: row.id },
              }) issues,
            },
            {
              key: "projects",
              title: "Projects",
              href: Admin.Projects.Index { org: params.org },
              count: projectCount,
              rows: List.map (\row -> {
                label: row.name,
                href: Admin.Projects.Show { org: params.org, id: row.id },
              }) projects,
            },
          ],
        }
      },
      Nothing -> Query.notFound,
    }
    -- @admin end
  } else
    Query.notFound
}

view : Model -> Session -> Html Msg
view model session =
  <Layout.Page title="Org">
    <h1>{model.name}</h1>

    <al-stack gap="md">
      {for card in model.cards ->
        <al-card id={card.key}>
          <h2 slot="header">
            <a href={card.href}>{card.title}</a> <al-badge variant="secondary">{Text.fromInt card.count}</al-badge>
          </h2>
          <ul>
            {for row in card.rows -> <li><a href={row.href}>{row.label}</a></li>}
          </ul>
        </al-card>}
    </al-stack>
    <a href={Admin.Orgs.Pick {}}>Another org</a>
  </Layout.Page>

-- @admin begin tests
-- The Admin is no member of the org: the page's parameter and the role check open its database.
test "the org's dashboard counts its issues, not another org's, and lists the newest five" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Issue {
        title: Text.NonEmpty ("title-" ++ Text.fromInt n),
        project: project1,
        org: org,
        assignee: Nothing,
      }) (List.range 1 6)
    )
  let other <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let project2 <- Db.insert Project { name: Text.NonEmpty "name-2", org: other }
  let _ <- Db.insert Issue {
    title: Text.NonEmpty "title-7",
    project: project2,
    org: other,
    assignee: Nothing,
  }
  let page <- Test.get (Admin.Orgs.Dashboard { org: org })
  Task.succeed (
    {
      name: Test.text "h1" page.doc,
      count: Test.text "#issues al-badge" page.doc,
      rows: Test.texts "#issues li" page.doc,
    } == {
        name: Just "name-1",
        count: Just "6",
        rows: ["title-6", "title-5", "title-4", "title-3", "title-2"],
      }
  )
}

-- The Admin is no member of the org: the page's parameter and the role check open its database.
test "the org's dashboard counts its projects, not another org's, and lists the newest five" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Project {
        name: Text.NonEmpty ("name-" ++ Text.fromInt n),
        org: org,
      }) (List.range 1 6)
    )
  let other <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let _ <- Db.insert Project { name: Text.NonEmpty "name-7", org: other }
  let page <- Test.get (Admin.Orgs.Dashboard { org: org })
  Task.succeed (
    {
      name: Test.text "h1" page.doc,
      count: Test.text "#projects al-badge" page.doc,
      rows: Test.texts "#projects li" page.doc,
    } == {
        name: Just "name-1",
        count: Just "6",
        rows: ["name-6", "name-5", "name-4", "name-3", "name-2"],
      }
  )
}

test "a missing org is not found" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let r <- Test.open (Admin.Orgs.Dashboard { org: Org.OrgId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "a visitor is sent to log in" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let r <- Test.open (Admin.Orgs.Dashboard { org: org })
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Member gets no page, even one made Admin since logging in" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Member,
  }
  let r <- Test.open (Admin.Orgs.Dashboard { org: org })
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Member,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let r <- Test.open (Admin.Orgs.Dashboard { org: org })
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
