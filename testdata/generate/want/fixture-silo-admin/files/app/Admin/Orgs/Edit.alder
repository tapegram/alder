-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Orgs.Edit

-- @admin begin imports
import Admin.Layout
import Org
import User
-- @admin end

page "/admin/org/{id}/edit" { id: Org.OrgId } requires user, role Admin

type Model = {
  row: Org,
  -- @admin begin model
  -- @admin end
}

load : Params -> Session -> Query Model
load params session = {
  let admin <- Layout.isAdmin session.user
  if admin then {
    -- @admin begin load
    let found <- Db.get Org params.id
    match found {
      Just row -> { Query.succeed { row: row } },
      Nothing -> Query.notFound,
    }
    -- @admin end
  } else
    Query.notFound
}

-- @admin begin form
form OrgForm = { name: Text.NonEmpty }
-- @admin end

-- @admin begin search
-- @admin end

msg Save form OrgForm

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  -- @admin begin finds
  -- @admin end
  Save p -> {
    -- @admin begin update
    let _ <- Db.update Org model.row.id (\row -> { row | name: p.form.name })
    Task.succeed (Redirect (Admin.Orgs.Show { id: model.row.id }))
    -- @admin end
  },
}

view : Model -> Session -> Html Msg
view model session =
  <Layout.Page title="Edit org">
    <h1>Edit org</h1>

    <al-card>
      -- @admin begin finder
      -- @admin end
      <form submit={Save}>
        -- @admin begin inputs
        <al-input field="name" label="Name" value={model.row.name} />
        -- @admin end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Save</al-button>
      </form>
    </al-card>
    <a href={Admin.Orgs.Show { id: model.row.id }}>Back</a>
  </Layout.Page>

-- @admin begin tests
test "saving changes every field" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let page <- Test.get (Admin.Orgs.Edit { id: org1 })
  let r <- Test.submit OrgForm { name: Text.NonEmpty "name-2" }
  let after <- Db.get Org org1
  Task.succeed (
    { answer: r.answer, row: Maybe.map (\row -> { name: row.name }) after }
      == {
        answer: Redirected (Admin.Orgs.Show { id: org1 }),
        row: Just { name: Text.NonEmpty "name-2" },
      }
  )
}

test "a missing row is not found" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let r <- Test.open (Admin.Orgs.Edit { id: Org.OrgId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "a visitor is sent to log in" = {
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let r <- Test.open (Admin.Orgs.Edit { id: org1 })
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Member gets no page, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Member,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let r <- Test.open (Admin.Orgs.Edit { id: org1 })
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Member,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let r <- Test.open (Admin.Orgs.Edit { id: org1 })
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
