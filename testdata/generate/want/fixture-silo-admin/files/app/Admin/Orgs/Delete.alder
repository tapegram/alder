-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Orgs.Delete

-- @admin begin imports
import Activity
import Admin.Layout
import Membership
import Org
import User
-- @admin end

-- @admin begin routes
route Delete  = GET    "/admin/org/{id}/delete"           { id: Org.OrgId }              requires user, role Admin
route Destroy = DELETE "/admin/org/{id}/delete/_/Destroy" { id: Org.OrgId } form Confirm requires user, role Admin
-- @admin end

-- The row, and how many rows of each table refer to it.
type Model = {
  row: Org,
  -- @admin begin model
  activities: Int,
  memberships: Int,
  -- @admin end
}

-- counted is the row id names (none is not found) and how many rows of each table refer to it:
-- the page shows them, and Destroy counts them again before it deletes.
counted : Org.OrgId -> Query Model
counted id = {
  -- @admin begin load
  let found <- Db.get Org id
  let activities <-
    Db.from Activity
      |> Db.where (Activity.org.eq id)
      |> Db.count
  let memberships <-
    Db.from Membership
      |> Db.where (Membership.org.eq id)
      |> Db.count
  match found {
    Just row -> Query.succeed {
      row: row,
      activities: activities,
      memberships: memberships,
    },
    Nothing -> Query.notFound,
  }
  -- @admin end
}

Delete.load : Delete.Params -> Session -> Query Model
Delete.load params session = {
  let _ <- Layout.adminOnly session.user
  counted params.id
}

-- @admin begin blockers
-- blockers counts the rows that keep this one from being deleted, which the database would
-- refuse the delete for: the `@restrict` references to it, or to a row deleted with it.
blockers : Model -> Int
blockers model = 0
-- @admin end

-- Destroy takes no input: the form is the button, and the place a refusal is shown.
form Confirm = { }

-- Destroy deletes the row, unless rows refer to it that keep it (counted again, as the page
-- counted them): the database would refuse the delete with an error, and the page says why
-- instead. The Show page's dialog posts it too.
Destroy.update : Destroy.Params -> Session -> Task Response
Destroy.update params session = {
  let _ <- Layout.adminOnly session.user
  let model <- counted params.id
  -- @admin begin remove
  let _ <- Db.delete Org params.id
  Task.succeed (Response.redirect (Admin.Orgs.Index.Index {}) |> Response.success "Deleted")
  -- @admin end
}

Delete.view : Model -> Session -> Html
Delete.view model session =
  <Layout.Page title="Delete org">
    <h1>Delete this org?</h1>

    <al-card>
      -- @admin begin row
      <p>{model.row.name}</p>
      -- @admin end
      <dl>
        -- @admin begin counts
        <dt>Activities deleted with it</dt>
        <dd id="activities">{Text.fromInt model.activities}</dd>
        <dt>Memberships deleted with it</dt>
        <dd id="memberships">{Text.fromInt model.memberships}</dd>
        -- @admin end
      </dl>
      <form id="delete" submit={Destroy { id: model.row.id }}>
        <al-alert variant="destructive"><Errors form /></al-alert>
        {if blockers model > 0 then
          <p>It cannot be deleted while other rows refer to it.</p>
        else
          <al-button variant="destructive" type="submit">Delete</al-button>}
      </form>
    </al-card>
    <a href={Admin.Orgs.Show.Show { id: model.row.id }}>Back</a>
  </Layout.Page>

-- @admin begin tests
test "deleting an org nothing refers to" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let org2 <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let _ <- Db.insert Activity { text: Text.NonEmpty "text-1", org: org2 }
  let _ <- Db.insert Membership { user: me, org: org2 }
  let page <- Test.get (Delete { id: org1 })
  let r <- Test.submit (Destroy { id: org1 }) {}
  let gone <- Db.get Org org1
  let kept <- Db.get Org org2
  Task.succeed (
    {
      button: Test.count "#delete al-button" page.doc,
      answer: r.answer,
      notices: r.notices,
      gone: Maybe.map (\row -> row.id) gone,
      kept: Maybe.map (\row -> row.id) kept,
    } == {
      button: 1,
      answer: Redirected (Admin.Orgs.Index.Index {}),
      notices: ["Deleted"],
      gone: Nothing,
      kept: Just org2,
    }
  )
}

test "the page counts the rows that go with it" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Db.insert Activity { text: Text.NonEmpty "text-1", org: org1 }
  let _ <- Db.insert Membership { user: me, org: org1 }
  let org2 <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let _ <- Db.insert Activity { text: Text.NonEmpty "text-2", org: org2 }
  let _ <- Db.insert Membership { user: me, org: org2 }
  let page <- Test.get (Delete { id: org1 })
  Task.succeed (
    { activities: Test.text "#activities" page.doc, memberships: Test.text "#memberships" page.doc }
      == { activities: Just "1", memberships: Just "1" }
  )
}

test "a visitor cannot delete an org" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Test.get (Delete { id: org1 })
  let _ <- Test.login { user: Nothing, org: Nothing }
  let r <- Test.submit (Destroy { id: org1 }) {}
  let kept <- Db.get Org org1
  Task.succeed (
    { answer: r.answer, kept: Maybe.map (\row -> row.id) kept }
      == { answer: Redirected (Auth.Login.Login {}), kept: Just org1 }
  )
}

test "a Member cannot delete an org, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Test.get (Delete { id: org1 })
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Member,
  }
  let r <- Test.submit (Destroy { id: org1 }) {}
  let kept <- Db.get Org org1
  Task.succeed (
    { answer: r.answer, kept: Maybe.map (\row -> row.id) kept }
      == { answer: PageMissing, kept: Just org1 }
  )
}

test "a demoted Admin cannot delete an org" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Test.get (Delete { id: org1 })
  let _ <- Db.update User me (\u -> { u | role: Member })
  let r <- Test.submit (Destroy { id: org1 }) {}
  let kept <- Db.get Org org1
  Task.succeed (
    { answer: r.answer, kept: Maybe.map (\row -> row.id) kept }
      == { answer: PageMissing, kept: Just org1 }
  )
}

test "a missing row is not found" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let r <- Test.open (Delete { id: Org.OrgId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "a visitor is sent to log in" = {
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let r <- Test.open (Delete { id: org1 })
  Task.succeed (r.answer == Redirected (Auth.Login.Login {}))
}

test "a Member gets no page, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Member,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let r <- Test.open (Delete { id: org1 })
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Member,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let r <- Test.open (Delete { id: org1 })
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
