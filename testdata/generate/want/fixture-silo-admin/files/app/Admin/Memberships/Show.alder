-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Memberships.Show

-- @admin begin imports
import Admin.Layout
import Membership
import Org
import User
-- @admin end

-- @admin begin routes
route Show = GET "/admin/membership/{id}" { id: Membership.MembershipId } requires user, role Admin
-- @admin end

-- The row, the labels of the rows it refers to, and (for the delete dialog) how many rows of
-- each table refer to it.
type Model = {
  row: Membership,
  labels: Labels,
  -- @admin begin model
  -- @admin end
}

Show.load : Show.Params -> Session -> Query Model
Show.load params session = {
  let _ <- Layout.adminOnly session.user
  -- @admin begin load
  let found <- Db.get Membership params.id
  match found {
    Just row -> {
      let labels <- labelsOf [row]
      Query.succeed { row: row, labels: labels }
    },
    Nothing -> Query.notFound,
  }
  -- @admin end
}

-- @admin begin labels
-- Labels are the rows the references of the rows shown name: their links show their labels.
type Labels = { users: List User, orgs: List Org }

-- labelsOf reads the rows that rows refer to.
labelsOf : List Membership -> Query Labels
labelsOf rows = {
  let users <-
    Db.from User
      |> Db.where (User.id.in (List.map (\row -> row.user) rows))
      |> Db.all
  let orgs <-
    Db.from Org
      |> Db.where (Org.id.in (List.map (\row -> row.org) rows))
      |> Db.all
  Query.succeed { users: users, orgs: orgs }
}

-- userLabel is the label of the user id names (the id itself if it names none).
userLabel : Labels -> User.UserId -> Text
userLabel labels id = match List.find (\r -> r.id == id) labels.users {
  Just r -> r.email,
  Nothing -> id,
}

-- orgLabel is the label of the org id names (the id itself if it names none).
orgLabel : Labels -> Org.OrgId -> Text
orgLabel labels id = match List.find (\r -> r.id == id) labels.orgs {
  Just r -> r.name,
  Nothing -> id,
}
-- @admin end

-- @admin begin blockers
-- blockers counts the rows that keep this one from being deleted, which the database would
-- refuse the delete for: the `@restrict` references to it, or to a row deleted with it.
blockers : Model -> Int
blockers model = 0
-- @admin end

Show.view : Model -> Session -> Html
Show.view model session =
  <Layout.Page title="Membership">
    <h1>Membership</h1>

    <al-card>
      <dl id="fields">
        -- @admin begin fields
        <dt>Id</dt>
        <dd>{model.row.id}</dd>
        <dt>User</dt>
        <dd>
          <a href={Admin.Users.Show.Show { id: model.row.user }}>
            {userLabel model.labels model.row.user}
          </a>
        </dd>
        <dt>Org</dt>
        <dd>
          <a href={Admin.Orgs.Show.Show { id: model.row.org }}>
            {orgLabel model.labels model.row.org}
          </a>
        </dd>
        <dt>Created</dt>
        <dd>{Time.format "Jan 2, 2006" model.row.created}</dd>
        -- @admin end
      </dl>
      <div slot="actions">
        <al-button href={Admin.Memberships.Edit.Edit { id: model.row.id }}>Edit</al-button>
        <al-button variant="destructive">
          <button type="button" commandfor="delete-dialog" command="show-modal">Delete</button>
        </al-button>
      </div>
    </al-card>
    <al-dialog id="delete-dialog" heading="Delete this membership?" dismissible>
      <dl>
        -- @admin begin counts
        -- @admin end
      </dl>
      <form id="delete" submit={Admin.Memberships.Delete.Destroy { id: model.row.id }}>
        <al-alert variant="destructive"><Errors form /></al-alert>
        {if blockers model > 0 then
          <p>It cannot be deleted while other rows refer to it.</p>
        else
          <al-button variant="destructive" type="submit">Delete</al-button>}
      </form>
      <div slot="actions">
        <a href={Admin.Memberships.Delete.Delete { id: model.row.id }}>See the details</a>
      </div>
    </al-dialog>
    <a href={Admin.Memberships.Index.Index {}}>All memberships</a>
  </Layout.Page>

-- @admin begin tests
test "the page shows the row" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let membership1 <- Db.insert Membership { user: me, org: org1 }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let org2 <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let r <- Test.open (Show { id: membership1 })
  let page <- Test.get (Show { id: membership1 })
  Task.succeed (
    {
      answer: r.answer,
      fields: Test.count "#fields dd" r.doc,
      users: List.length page.model.labels.users,
      userLabel: userLabel page.model.labels me,
      orgs: List.length page.model.labels.orgs,
      orgLabel: orgLabel page.model.labels org1,
    } == {
      answer: Shown,
      fields: 4,
      users: 1,
      userLabel: "email-1@example.com",
      orgs: 1,
      orgLabel: "name-1",
    }
  )
}

test "deleting a membership nothing refers to" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let membership1 <- Db.insert Membership { user: me, org: org1 }
  let page <- Test.get (Show { id: membership1 })
  let r <- Test.submit (Admin.Memberships.Delete.Destroy { id: membership1 }) {}
  let gone <- Db.get Membership membership1
  Task.succeed (
    {
      button: Test.count "#delete al-button" page.doc,
      answer: r.answer,
      gone: Maybe.map (\row -> row.id) gone,
    } == {
      button: 1,
      answer: Redirected (Admin.Memberships.Index.Index {}),
      gone: Nothing,
    }
  )
}

test "a missing row is not found" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let r <- Test.open (Show { id: Membership.MembershipId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "a visitor is sent to log in" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let membership1 <- Db.insert Membership { user: me, org: org1 }
  let r <- Test.open (Show { id: membership1 })
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Member gets no page, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Member,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let membership1 <- Db.insert Membership { user: me, org: org1 }
  let r <- Test.open (Show { id: membership1 })
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Member,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let membership1 <- Db.insert Membership { user: me, org: org1 }
  let r <- Test.open (Show { id: membership1 })
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
