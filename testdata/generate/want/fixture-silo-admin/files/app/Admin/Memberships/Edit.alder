-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Memberships.Edit

-- @admin begin imports
import Admin.Layout
import Membership
import Org
import User
-- @admin end

-- @admin begin routes
route Edit       = GET  "/admin/membership/{id}/edit"              { id: Membership.MembershipId, findUser: Text = "", findOrg: Text = "" } requires user, role Admin
route Save       = PUT  "/admin/membership/{id}/edit/_/Save"       { id: Membership.MembershipId } form MembershipForm                      requires user, role Admin
route SearchUser = POST "/admin/membership/{id}/edit/_/SearchUser" { id: Membership.MembershipId } form FindUser                            requires user, role Admin
route SearchOrg  = POST "/admin/membership/{id}/edit/_/SearchOrg"  { id: Membership.MembershipId } form FindOrg                             requires user, role Admin
-- @admin end

type Model = {
  row: Membership,
  -- @admin begin model
  users: List User,
  usersTotal: Int,
  orgs: List Org,
  orgsTotal: Int,
  -- @admin end
}

Edit.load : Edit.Params -> Session -> Query Model
Edit.load params session = {
  let _ <- Layout.adminOnly session.user
  -- @admin begin load
  let found <- Db.get Membership params.id
  match found {
    Just row -> {
      let findUser = Text.slice 0 200 params.findUser
      let usersTotal <- Db.from User |> Db.count
      let usersOwn <-
        if usersTotal > 200 then
          Db.from User
            |> Db.where (User.id.eq row.user)
            |> Db.all
        else
          Query.succeed []
      let usersFound <-
        Db.from User
          |> Db.orderBy User.email.asc
          |> Db.where (
            if usersTotal > 200 then
              Db.and [User.email.contains findUser, User.id.ne row.user]
            else
              Db.and []
          )
          |> Db.limit (if usersTotal > 200 then 50 else 200)
          |> Db.all
      let users = usersOwn ++ usersFound
      let findOrg = Text.slice 0 200 params.findOrg
      let orgsTotal <- Db.from Org |> Db.count
      let orgsOwn <-
        if orgsTotal > 200 then
          Db.from Org
            |> Db.where (Org.id.eq row.org)
            |> Db.all
        else
          Query.succeed []
      let orgsFound <-
        Db.from Org
          |> Db.orderBy Org.name.asc
          |> Db.where (
            if orgsTotal > 200 then
              Db.and [Org.name.contains findOrg, Org.id.ne row.org]
            else
              Db.and []
          )
          |> Db.limit (if orgsTotal > 200 then 50 else 200)
          |> Db.all
      let orgs = orgsOwn ++ orgsFound
      Query.succeed {
        row: row,
        users: users,
        usersTotal: usersTotal,
        orgs: orgs,
        orgsTotal: orgsTotal,
      }
    },
    Nothing -> Query.notFound,
  }
  -- @admin end
}

-- @admin begin form
form MembershipForm = { user: User.UserId, org: Org.OrgId }
-- @admin end

-- @admin begin search
form FindUser = { q: Text }

-- SearchUser answers the page again at the text.
SearchUser.update : SearchUser.Params -> Session -> Task Response
SearchUser.update params session =
  Task.succeed (
    Response.redirect (Edit { id: params.id, findUser: Text.slice 0 200 params.form.q })
  )

form FindOrg = { q: Text }

-- SearchOrg answers the page again at the text.
SearchOrg.update : SearchOrg.Params -> Session -> Task Response
SearchOrg.update params session =
  Task.succeed (Response.redirect (Edit { id: params.id, findOrg: Text.slice 0 200 params.form.q }))

-- @admin end

-- Save writes the form over the row (a row deleted since is not found) and goes to its page.
Save.update : Save.Params -> Session -> Task Response
Save.update params session = {
  let _ <- Layout.adminOnly session.user
  let found <- Db.get Membership params.id
  match found {
    Just row -> {
      -- @admin begin update
      let _ <- Db.update Membership row.id (\r -> { r |
        user: params.form.user,
        org: params.form.org
      })
      Task.succeed (Response.redirect (Admin.Memberships.Show.Show { id: row.id }))
      -- @admin end
    },
    Nothing -> Task.notFound,
  }
}

Edit.view : Model -> Session -> Html
Edit.view model session =
  <Layout.Page title="Edit membership">
    <h1>Edit membership</h1>

    <al-card>
      -- @admin begin finder
      {if model.usersTotal > 200 then
        <form submit={SearchUser { id: model.row.id }}>
          <al-input field="q" label="Find user" />
          <al-button type="submit" variant="secondary">Find</al-button>
        </form>
      else
        Html.none}
      {if model.orgsTotal > 200 then
        <form submit={SearchOrg { id: model.row.id }}>
          <al-input field="q" label="Find org" />
          <al-button type="submit" variant="secondary">Find</al-button>
        </form>
      else
        Html.none}
      -- @admin end
      <form submit={Save { id: model.row.id }}>
        -- @admin begin inputs
        <al-select
          field="user"
          label="User"
          options={List.map (\r -> { value: r.id, label: r.email }) model.users}
          value={model.row.user} />
        <al-select
          field="org"
          label="Org"
          options={List.map (\r -> { value: r.id, label: r.name }) model.orgs}
          value={model.row.org} />
        -- @admin end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Save</al-button>
      </form>
    </al-card>
    <a href={Admin.Memberships.Show.Show { id: model.row.id }}>Back</a>
  </Layout.Page>

-- @admin begin tests
test "saving changes every field" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let membership1 <- Db.insert Membership { user: me, org: org1 }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let org2 <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let page <- Test.get (Edit { id: membership1 })
  let r <- Test.submit (Save { id: membership1 }) { user: user2, org: org2 }
  let after <- Db.get Membership membership1
  Task.succeed (
    {
      answer: r.answer,
      row: Maybe.map (\row -> { user: row.user, org: row.org }) after,
      users: Test.texts "select[name=user] option" page.doc,
      orgs: Test.texts "select[name=org] option" page.doc,
    } == {
      answer: Redirected (Admin.Memberships.Show.Show { id: membership1 }),
      row: Just { user: user2, org: org2 },
      users: ["email-1@example.com", "email-2@example.com"],
      orgs: ["name-1", "name-2"],
    }
  )
}

test "a user not offered is refused" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let membership1 <- Db.insert Membership { user: me, org: org1 }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let org2 <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let page <- Test.get (Edit { id: membership1 })
  let orgId = Maybe.withDefault "" (Test.attr "value" "select[name=org] option" page.doc)
  let r <- Test.submitRaw (Save { id: membership1 }) [
    { name: "user", value: "missing" },
    { name: "org", value: orgId },
  ]
  let after <- Db.get Membership membership1
  Task.succeed (
    { answer: r.answer, user: Maybe.map (\row -> row.user) after }
      == {
        answer: FormRejected [{ field: "user", message: "must be one of the options" }],
        user: Just me,
      }
  )
}

test "an org not offered is refused" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let membership1 <- Db.insert Membership { user: me, org: org1 }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let org2 <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let page <- Test.get (Edit { id: membership1 })
  let userId = Maybe.withDefault "" (Test.attr "value" "select[name=user] option" page.doc)
  let r <- Test.submitRaw (Save { id: membership1 }) [
    { name: "user", value: userId },
    { name: "org", value: "missing" },
  ]
  let after <- Db.get Membership membership1
  Task.succeed (
    { answer: r.answer, org: Maybe.map (\row -> row.org) after }
      == {
        answer: FormRejected [{ field: "org", message: "must be one of the options" }],
        org: Just org1,
      }
  )
}

test "a list of 200 users is offered whole" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let membership1 <- Db.insert Membership { user: me, org: org1 }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let org2 <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert User {
        email: Text.Email ("email-" ++ Text.fromInt n ++ "@example.com"),
        name: Text.NonEmpty ("name-" ++ Text.fromInt n),
      }) (List.range 3 200)
    )
  let page <- Test.get (Edit { id: membership1 })
  Task.succeed (List.length page.model.users == 200)
}

test "a long list of users offers 50, and the search narrows it" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let membership1 <- Db.insert Membership { user: me, org: org1 }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let org2 <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert User {
        email: Text.Email ("email-" ++ Text.fromInt n ++ "@example.com"),
        name: Text.NonEmpty ("name-" ++ Text.fromInt n),
      }) (List.range 3 203)
    )
  let all <- Test.get (Edit { id: membership1 })
  let found <- Test.get (Edit { id: membership1, findUser: "email-203@example.com" })
  let r <- Test.submit (SearchUser { id: membership1 }) { q: "zz" }
  Task.succeed (
    {
      shown: List.length all.model.users,
      total: all.model.usersTotal,
      found: Test.count "select[name=user] option" found.doc <= 3,
      answer: r.answer,
    } == {
      shown: 51,
      total: 203,
      found: True,
      answer: Redirected (Edit { id: membership1, findUser: "zz" }),
    }
  )
}

test "the row's own user is offered first when it sorts past the 50" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let user2 <- Db.insert User { email: Text.Email "zz-1@example.com", name: Text.NonEmpty "name-2" }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let membership1 <- Db.insert Membership { user: user2, org: org1 }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert User {
        email: Text.Email ("email-" ++ Text.fromInt n ++ "@example.com"),
        name: Text.NonEmpty ("name-" ++ Text.fromInt n),
      }) (List.range 3 203)
    )
  let page <- Test.get (Edit { id: membership1 })
  let r <- Test.submit (Save { id: membership1 }) {
    user: page.model.row.user,
    org: page.model.row.org,
  }
  let after <- Db.get Membership membership1
  Task.succeed (
    {
      answer: r.answer,
      kept: Maybe.map (\row -> row.user) after,
      first: Maybe.map (\o -> o.id) (List.head page.model.users),
      once: List.length (List.filter (\o -> o.id == user2) page.model.users),
      shown: List.length page.model.users,
    } == {
      answer: Redirected (Admin.Memberships.Show.Show { id: membership1 }),
      kept: Just user2,
      first: Just user2,
      once: 1,
      shown: 51,
    }
  )
}

