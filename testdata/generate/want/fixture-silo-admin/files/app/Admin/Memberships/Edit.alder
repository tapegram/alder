test "the row's own org is offered first when it sorts past the 50" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "zz-1" }
  let membership1 <- Db.insert Membership { user: me, org: org1 }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Org { name: Text.NonEmpty ("name-" ++ Text.fromInt n) }) (
        List.range 2 202
      )
    )
  let page <- Test.get (Edit { id: membership1 })
  let r <- Test.submit (Save { id: membership1 }) {
    user: page.model.row.user,
    org: page.model.row.org,
  }
  let after <- Db.get Membership membership1
  Task.succeed (
    {
      answer: r.answer,
      kept: Maybe.map (\row -> row.org) after,
      first: Maybe.map (\o -> o.id) (List.head page.model.orgs),
      once: List.length (List.filter (\o -> o.id == org1) page.model.orgs),
      shown: List.length page.model.orgs,
    } == {
      answer: Redirected (Admin.Memberships.Show.Show { id: membership1 }),
      kept: Just org1,
      first: Just org1,
      once: 1,
      shown: 51,
    }
  )
}

test "a demoted Admin cannot save a membership" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let membership1 <- Db.insert Membership { user: me, org: org1 }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let org2 <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let before <- Db.get Membership membership1
  let _ <- Test.get (Edit { id: membership1 })
  let _ <- Db.update User me (\u -> { u | role: Member })
  let r <- Test.submit (Save { id: membership1 }) { user: user2, org: org2 }
  let after <- Db.get Membership membership1
  Task.succeed (
    { answer: r.answer, row: after } == { answer: RequestFailed "400 bad request", row: before }
  )
}

test "a missing row is not found" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let r <- Test.open (Edit { id: Membership.MembershipId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "a visitor is sent to log in" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let membership1 <- Db.insert Membership { user: me, org: org1 }
  let r <- Test.open (Edit { id: membership1 })
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Member gets no page, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Member,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let membership1 <- Db.insert Membership { user: me, org: org1 }
  let r <- Test.open (Edit { id: membership1 })
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Member,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let membership1 <- Db.insert Membership { user: me, org: org1 }
  let r <- Test.open (Edit { id: membership1 })
  Task.succeed (r.answer == PageMissing)
}
