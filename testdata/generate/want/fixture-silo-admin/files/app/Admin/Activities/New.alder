-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Activities.New

-- @admin begin imports
import Activity
import Admin.Layout
import Org
import User
-- @admin end

page "/admin/activity/new" { findOrg: Text = "" } requires user, role Admin

type Model = {
  -- @admin begin model
  orgs: List Org,
  orgsTotal: Int,
  -- @admin end
}

load : Params -> Session -> Query Model
load params session = {
  let admin <- Layout.isAdmin session.user
  if admin then {
    -- @admin begin load
    let findOrg = Text.slice 0 200 params.findOrg
    let orgsTotal <- Db.from Org |> Db.count
    let orgs <-
      Db.from Org
        |> Db.orderBy Org.name.asc
        |> Db.where (if orgsTotal > 200 then Org.name.contains findOrg else Db.and [])
        |> Db.limit (if orgsTotal > 200 then 50 else 200)
        |> Db.all
    Query.succeed { orgs: orgs, orgsTotal: orgsTotal }
    -- @admin end
  } else
    Query.notFound
}

-- @admin begin form
form ActivityForm = { text: Text.NonEmpty, org: Org.OrgId }
-- @admin end

-- @admin begin search
form FindOrg = { q: Text }

msg SearchOrg form FindOrg

-- @admin end

msg Create form ActivityForm

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  -- @admin begin finds
  SearchOrg p ->
    Task.succeed (Redirect (Admin.Activities.New { findOrg: Text.slice 0 200 p.form.q })),
  -- @admin end
  Create p -> {
    -- @admin begin insert
    let id <- Db.insert Activity { text: p.form.text, org: p.form.org }
    Task.succeed (Redirect (Admin.Activities.Show { id: id }))
    -- @admin end
  },
}

view : Model -> Session -> Html Msg
view model session =
  <Layout.Page title="New activity">
    <h1>New activity</h1>

    <al-card>
      -- @admin begin finder
      {if model.orgsTotal > 200 then
        <form submit={SearchOrg}>
          <al-input field="q" label="Find org" />
          <al-button type="submit" variant="secondary">Find</al-button>
        </form>
      else
        <span></span>}
      -- @admin end
      <form submit={Create}>
        -- @admin begin inputs
        <al-input field="text" label="Text" />
        <al-select
          field="org"
          label="Org"
          options={List.map (\r -> { value: r.id, label: r.name }) model.orgs} />
        -- @admin end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Create</al-button>
      </form>
    </al-card>
  </Layout.Page>

-- @admin begin tests
test "creating an activity adds it, with the values submitted" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let org2 <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let page <- Test.get (Admin.Activities.New {})
  let r <- Test.submit ActivityForm { text: Text.NonEmpty "text-1", org: org2 }
  let rows <- Db.from Activity |> Db.all
  Task.succeed (
    {
      answers: List.map (\row -> Redirected (Admin.Activities.Show { id: row.id })) rows,
      rows: List.map (\row -> { text: row.text, org: row.org }) rows,
      orgs: Test.texts "select[name=org] option" page.doc,
    } == {
      answers: [r.answer],
      rows: [{ text: Text.NonEmpty "text-1", org: org2 }],
      orgs: ["name-1", "name-2"],
    }
  )
}

test "an org not offered is refused" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let org2 <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let page <- Test.get (Admin.Activities.New {})
  let r <- Test.submitRaw ActivityForm [
    { name: "text", value: "x" },
    { name: "org", value: "missing" },
  ]
  let rows <- Db.from Activity |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows }
      == { answer: FormRejected [{ field: "org", message: "must be one of the options" }], rows: 0 }
  )
}

test "a list of 200 orgs is offered whole" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let org2 <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Org { name: Text.NonEmpty ("name-" ++ Text.fromInt n) }) (
        List.range 3 200
      )
    )
  let page <- Test.get (Admin.Activities.New {})
  Task.succeed (List.length page.model.orgs == 200)
}

test "a long list of orgs offers 50, and the search narrows it" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let org2 <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Org { name: Text.NonEmpty ("name-" ++ Text.fromInt n) }) (
        List.range 3 203
      )
    )
  let all <- Test.get (Admin.Activities.New {})
  let found <- Test.get (Admin.Activities.New { findOrg: "name-203" })
  let r <- Test.submit FindOrg { q: "zz" }
  Task.succeed (
    {
      shown: List.length all.model.orgs,
      total: all.model.orgsTotal,
      found: Test.texts "select[name=org] option" found.doc == ["name-203"],
      answer: r.answer,
    } == {
      shown: 50,
      total: 203,
      found: True,
      answer: Redirected (Admin.Activities.New { findOrg: "zz" }),
    }
  )
}

test "an org outside the narrowed list is refused" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let org2 <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Org { name: Text.NonEmpty ("name-" ++ Text.fromInt n) }) (
        List.range 3 203
      )
    )
  let all <- Test.get (Admin.Activities.New {})
  let found <- Test.get (Admin.Activities.New { findOrg: "name-203" })
  let r <- Test.submit FindOrg { q: "zz" }
  let pick = Maybe.withDefault "" (Test.attr "value" "select[name=org] option" found.doc)
  let page <- Test.get (Admin.Activities.New {})
  let sent <- Test.submitRaw ActivityForm [
    { name: "text", value: "x" },
    { name: "org", value: pick },
  ]
  let rows <- Db.from Activity |> Db.count
  Task.succeed (
    { answer: sent.answer, rows: rows }
      == { answer: FormRejected [{ field: "org", message: "must be one of the options" }], rows: 0 }
  )
}

test "a visitor is sent to log in" = {
  let r <- Test.open (Admin.Activities.New {})
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Member gets no page, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Member,
  }
  let r <- Test.open (Admin.Activities.New {})
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Member,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let r <- Test.open (Admin.Activities.New {})
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
