-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Projects.Bulk

-- @admin begin imports
import Admin.Layout
import Org
import Project
import User
-- @admin end

page "/admin/orgs/{org}/project/bulk" {
  org: Org.OrgId,
  ids: List Project.ProjectId,
} requires user, role Admin, silo org

-- The rows chosen on the list (at most maxRows of them), the ids of those that other rows keep
-- from being deleted, and how many ids the page was given.
type Model = {
  rows: List Project,
  held: List Project.ProjectId,
  chosen: Int,
}

-- maxRows is how many rows one action takes: a page of the list. More are refused.
maxRows : Int
maxRows = 25

load : Params -> Session -> Query Model
load params session = {
  let admin <- Layout.isAdmin session.user
  if admin then {
    -- @admin begin load
    let ids = List.take maxRows params.ids
    let rows <-
      Db.from Project
        |> Db.where (Project.id.in ids)
        |> Db.all
    Query.succeed {
      rows: rows,
      held: [],
      chosen: List.length params.ids,
    }
    -- @admin end
  } else
    Query.notFound
}

-- refused says whether a row is kept from being deleted: rows refer to it with a `@restrict`.
refused : Model -> Session -> Project -> Bool
refused model session row = List.member row.id model.held

-- @admin begin bulk
form Confirm = { }

msg BulkDelete form Confirm

form SetArchived = { value: Bool }

msg BulkSetArchived form SetArchived

-- Each action reads the rows again (load runs before every message) and answers with a notice;
-- none takes more than maxRows rows.
update : Msg -> Model -> Session -> Task Nav
update msg model session =
  if model.chosen > maxRows then
    Task.succeed (Reject ("Choose at most " ++ Text.fromInt maxRows ++ " rows at a time."))
  else
    match msg {
      BulkDelete p -> {
        let allowed = List.filter (\row -> refused model session row == False) model.rows
        let _ <- Task.all (List.map (\row -> Db.delete Project row.id) allowed)
        Task.succeed (
          Notice.with ("Deleted " ++ Text.fromInt (List.length allowed) ++ " of " ++ Text.fromInt (List.length model.rows)) (
            Redirect (Admin.Projects.Index { org: session.org })
          )
        )
      },
      BulkSetArchived p -> {
        let _ <-
          Task.all (
            List.map (\row -> Db.update Project row.id (\r -> { r |
              archived: p.form.value
            })) model.rows
          )
        Task.succeed (
          Notice.with ("Updated " ++ Text.fromInt (List.length model.rows)) (
            Redirect (Admin.Projects.Index { org: session.org })
          )
        )
      },
    }
-- @admin end

view : Model -> Session -> Html Msg
view model session =
  <Layout.Page title="Selected projects">
    <h1>{Text.fromInt (List.length model.rows)} selected</h1>

    <al-card>
      {if model.chosen > maxRows then
        <al-alert id="too-many" variant="warning">
          {"Choose at most " ++ Text.fromInt maxRows ++ " rows at a time."}
        </al-alert>
      else
        Html.none}
      <ul id="selected">
        {for row in model.rows ->
          <li>
            {row.name}
            {if refused model session row then
              <small> (kept: other rows refer to it)</small>
            else
              <span></span>}
          </li>}
      </ul>
      -- @admin begin actions
      <form id="bulk-delete" submit={BulkDelete}>
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button variant="destructive" type="submit">
          Delete the rows that can be deleted
        </al-button>
      </form>
      <form id="set-archived" submit={BulkSetArchived}>
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-checkbox field="value" label="Archived" />
        <al-button type="submit">Set archived</al-button>
      </form>
      -- @admin end
    </al-card>
    <a href={Admin.Projects.Index { org: session.org }}>Back to the list</a>
  </Layout.Page>

-- @admin begin tests
test "deleting the chosen rows" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let project2 <- Db.insert Project { name: Text.NonEmpty "name-2", org: org }
  let _ <- Test.get (Admin.Projects.Bulk { org: org, ids: [project1] })
  let r <- Test.submit Confirm {}
  let gone <- Db.get Project project1
  let left <- Db.get Project project2
  Task.succeed (
    {
      answer: r.answer,
      gone: Maybe.map (\row -> row.id) gone,
      left: Maybe.map (\row -> row.id) left,
    } == {
      answer: Redirected (Admin.Projects.Index { org: org }),
      gone: Nothing,
      left: Just project2,
    }
  )
}

test "setting archived changes the chosen rows only" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let project2 <- Db.insert Project { name: Text.NonEmpty "name-2", org: org }
  let _ <- Test.get (Admin.Projects.Bulk { org: org, ids: [project1] })
  let r <- Test.submit SetArchived { value: True }
  let one <- Db.get Project project1
  let other <- Db.get Project project2
  Task.succeed (
    {
      answer: r.answer,
      one: Maybe.map (\row -> row.archived == True) one,
      other: Maybe.map (\row -> row.archived == True) other,
    } == {
      answer: Redirected (Admin.Projects.Index { org: org }),
      one: Just True,
      other: Just False,
    }
  )
}

test "25 chosen ids are taken" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let page <-
    Test.get (Admin.Projects.Bulk {
      org: org,
      ids: [project1]
        ++ List.map (\n -> Project.ProjectId ("none-" ++ Text.fromInt n)) (List.range 1 24),
    })
  let r <- Test.submit Confirm {}
  let after <- Db.get Project project1
  Task.succeed (
    {
      answer: r.answer,
      kept: Maybe.map (\row -> row.id) after,
      warned: Test.count "#too-many" page.doc,
    } == {
      answer: Redirected (Admin.Projects.Index { org: org }),
      kept: Nothing,
      warned: 0,
    }
  )
}

test "26 chosen ids are refused" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let page <-
    Test.get (Admin.Projects.Bulk {
      org: org,
      ids: [project1]
        ++ List.map (\n -> Project.ProjectId ("none-" ++ Text.fromInt n)) (List.range 1 25),
    })
  let r <- Test.submit Confirm {}
  let after <- Db.get Project project1
  Task.succeed (
    {
      answer: r.answer,
      kept: Maybe.map (\row -> row.id) after,
      warned: Test.count "#too-many" page.doc,
    } == {
      answer: FormRejected [{ field: "", message: "Choose at most 25 rows at a time." }],
      kept: Just project1,
      warned: 1,
    }
  )
}

test "a bulk action stays inside one org" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let other <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let project2 <- Db.insert Project { name: Text.NonEmpty "name-2", org: other }
  let page <- Test.get (Admin.Projects.Bulk { org: org, ids: [project1, project2] })
  let _ <- Test.submit Confirm {}
  let mineAfter <- Test.get (Admin.Projects.Index { org: org })
  let theirsAfter <- Test.get (Admin.Projects.Index { org: other })
  Task.succeed (
    {
      chosen: List.map (\row -> row.id) page.model.rows,
      mine: List.length mineAfter.model.rows,
      theirs: List.map (\row -> row.id) theirsAfter.model.rows,
    } == {
      chosen: [project1],
      mine: 0,
      theirs: [project2],
    }
  )
}

test "a visitor is sent to log in" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let r <- Test.open (Admin.Projects.Bulk { org: org, ids: [project1] })
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Member gets no page, even one made Admin since logging in" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Member,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let r <- Test.open (Admin.Projects.Bulk { org: org, ids: [project1] })
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Member,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let r <- Test.open (Admin.Projects.Bulk { org: org, ids: [project1] })
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
