-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Projects.Bulk

-- @admin begin imports
import Admin.Layout
import Org
import Project
import User
-- @admin end

-- @admin begin routes
route Bulk            = GET  "/admin/orgs/{org}/project/bulk"                   { org: Org.OrgId, ids: List Project.ProjectId }                  requires user, role Admin, silo org
route BulkDelete      = POST "/admin/orgs/{org}/project/bulk/_/BulkDelete"      { org: Org.OrgId, ids: List Project.ProjectId } form Confirm     requires user, role Admin, silo org
route BulkSetArchived = POST "/admin/orgs/{org}/project/bulk/_/BulkSetArchived" { org: Org.OrgId, ids: List Project.ProjectId } form SetArchived requires user, role Admin, silo org
-- @admin end

-- The rows chosen on the list (at most maxRows of them), the ids of those that other rows keep
-- from being deleted, how many ids the page was given, and the ids, which each action takes.
type Model = {
  rows: List Project,
  held: List Project.ProjectId,
  chosen: Int,
  ids: List Project.ProjectId,
}

-- maxRows is how many rows one action takes: a page of the list. More are refused.
maxRows : Int
maxRows = 25

-- tooMany says whether the page was given more ids than an action takes.
tooMany : Model -> Bool
tooMany model = model.chosen > maxRows

-- selected is the rows of ids: the page shows them, and each action reads them again.
selected : List Project.ProjectId -> Query Model
selected ids = {
  -- @admin begin load
  let taken = List.take maxRows ids
  let rows <-
    Db.from Project
      |> Db.where (Project.id.in taken)
      |> Db.all
  Query.succeed {
    rows: rows,
    held: [],
    chosen: List.length ids,
    ids: ids,
  }
  -- @admin end
}

Bulk.load : Bulk.Params -> Session -> Query Model
Bulk.load params session = {
  let _ <- Layout.adminOnly session.user
  selected params.ids
}

-- refused says whether a row is kept from being deleted: rows refer to it with a `@restrict`.
refused : Model -> Project -> Bool
refused model row = List.member row.id model.held

-- @admin begin bulk
-- Each action reads the rows again and answers with the page again and a toast; none takes
-- more than maxRows rows.

-- BulkDelete takes no input: the form is the button, and the place a refusal is shown.
form Confirm = { }

BulkDelete.update : BulkDelete.Params -> Session -> Task Response
BulkDelete.update params session = {
  let _ <- Layout.adminOnly session.user
  let model <- selected params.ids
  if tooMany model then
    Task.succeed (
      Response.invalid ("Choose at most " ++ Text.fromInt maxRows ++ " rows at a time.")
    )
  else {
    let allowed = List.filter (\row -> refused model row == False) model.rows
    let _ <- Task.all (List.map (\row -> Db.delete Project row.id) allowed)
    Task.succeed (
      Response.refresh
        |> Response.success (
          "Deleted "
            ++ Text.fromInt (List.length allowed)
            ++ " of "
            ++ Text.fromInt (List.length model.rows)
        )
    )
  }
}

form SetArchived = { value: Bool }

BulkSetArchived.update : BulkSetArchived.Params -> Session -> Task Response
BulkSetArchived.update params session = {
  let _ <- Layout.adminOnly session.user
  let model <- selected params.ids
  if tooMany model then
    Task.succeed (
      Response.invalid ("Choose at most " ++ Text.fromInt maxRows ++ " rows at a time.")
    )
  else {
    let _ <-
      Task.all (
        List.map (\row -> Db.update Project row.id (\r -> { r |
          archived: params.form.value
        })) model.rows
      )
    Task.succeed (
      Response.refresh |> Response.success ("Updated " ++ Text.fromInt (List.length model.rows))
    )
  }
}
-- @admin end

Bulk.view : Model -> Session -> Html
Bulk.view model session =
  <Layout.Page title="Selected projects">
    <h1>{Text.fromInt (List.length model.rows)} selected</h1>

    <al-card>
      {if tooMany model then
        <al-alert id="too-many" variant="warning">
          {"Choose at most " ++ Text.fromInt maxRows ++ " rows at a time."}
        </al-alert>
      else
        Html.none}
      <ul id="selected">
        {for row in model.rows ->
          <li>
            {row.name}
            {if refused model row then
              <small> (kept: other rows refer to it)</small>
            else
              <span></span>}
          </li>}
      </ul>
      -- @admin begin actions
      <form id="bulk-delete" submit={BulkDelete { org: session.org, ids: model.ids }}>
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button variant="destructive" type="submit">
          Delete the rows that can be deleted
        </al-button>
      </form>
      <form id="set-archived" submit={BulkSetArchived { org: session.org, ids: model.ids }}>
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-checkbox field="value" label="Archived" />
        <al-button type="submit">Set archived</al-button>
      </form>
      -- @admin end
    </al-card>
    <a href={Admin.Projects.Index.Index { org: session.org }}>Back to the list</a>
  </Layout.Page>

-- @admin begin tests
test "deleting the chosen rows" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let project2 <- Db.insert Project { name: Text.NonEmpty "name-2", org: org }
  let _ <- Test.get (Bulk { org: org, ids: [project1] })
  let r <- Test.submit (BulkDelete { org: org, ids: [project1] }) {}
  let gone <- Db.get Project project1
  let left <- Db.get Project project2
  Task.succeed (
    {
      answer: r.answer,
      notices: r.notices,
      gone: Maybe.map (\row -> row.id) gone,
      left: Maybe.map (\row -> row.id) left,
    } == {
      answer: Refreshed,
      notices: ["Deleted 1 of 1"],
      gone: Nothing,
      left: Just project2,
    }
  )
}

test "setting archived changes the chosen rows only" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let project2 <- Db.insert Project { name: Text.NonEmpty "name-2", org: org }
  let _ <- Test.get (Bulk { org: org, ids: [project1] })
  let r <- Test.submit (BulkSetArchived { org: org, ids: [project1] }) { value: True }
  let one <- Db.get Project project1
  let other <- Db.get Project project2
  Task.succeed (
    {
      answer: r.answer,
      notices: r.notices,
      one: Maybe.map (\row -> row.archived == True) one,
      other: Maybe.map (\row -> row.archived == True) other,
    } == {
      answer: Refreshed,
      notices: ["Updated 1"],
      one: Just True,
      other: Just False,
    }
  )
}

test "25 chosen ids are taken" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let chosen =
    [project1] ++ List.map (\n -> Project.ProjectId ("none-" ++ Text.fromInt n)) (List.range 1 24)
  let page <- Test.get (Bulk { org: org, ids: chosen })
  let r <- Test.submit (BulkDelete { org: org, ids: chosen }) {}
  let after <- Db.get Project project1
  Task.succeed (
    {
      answer: r.answer,
      kept: Maybe.map (\row -> row.id) after,
      warned: Test.count "#too-many" page.doc,
    } == {
      answer: Refreshed,
      kept: Nothing,
      warned: 0,
    }
  )
}

test "26 chosen ids are refused" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let chosen =
    [project1] ++ List.map (\n -> Project.ProjectId ("none-" ++ Text.fromInt n)) (List.range 1 25)
  let page <- Test.get (Bulk { org: org, ids: chosen })
  let r <- Test.submit (BulkDelete { org: org, ids: chosen }) {}
  let after <- Db.get Project project1
  Task.succeed (
    {
      answer: r.answer,
      kept: Maybe.map (\row -> row.id) after,
      warned: Test.count "#too-many" page.doc,
    } == {
      answer: FormRejected [{ field: "", message: "Choose at most 25 rows at a time." }],
      kept: Just project1,
      warned: 1,
    }
  )
}

test "setting archived on 26 chosen ids is refused" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let chosen =
    [project1] ++ List.map (\n -> Project.ProjectId ("none-" ++ Text.fromInt n)) (List.range 1 25)
  let _ <- Test.get (Bulk { org: org, ids: chosen })
  let r <- Test.submit (BulkSetArchived { org: org, ids: chosen }) { value: True }
  let after <- Db.get Project project1
  Task.succeed (
    { answer: r.answer, set: Maybe.map (\row -> row.archived == True) after }
      == {
        answer: FormRejected [{ field: "", message: "Choose at most 25 rows at a time." }],
        set: Just False,
      }
  )
}

test "a visitor cannot delete the chosen rows" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let _ <- Test.get (Bulk { org: org, ids: [project1] })
  let _ <- Test.login { user: Nothing, org: Nothing }
  let r <- Test.submit (BulkDelete { org: org, ids: [project1] }) {}
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let kept <- Db.get Project project1
  Task.succeed (
    { answer: r.answer, kept: Maybe.map (\row -> row.id) kept }
      == { answer: Redirected (Auth.Login {}), kept: Just project1 }
  )
}

test "a Member cannot delete the chosen rows, even one made Admin since logging in" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let _ <- Test.get (Bulk { org: org, ids: [project1] })
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Member,
  }
  let r <- Test.submit (BulkDelete { org: org, ids: [project1] }) {}
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let kept <- Db.get Project project1
  Task.succeed (
    { answer: r.answer, kept: Maybe.map (\row -> row.id) kept }
      == { answer: PageMissing, kept: Just project1 }
  )
}

