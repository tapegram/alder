-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Users.Show

-- @admin begin imports
import Admin.Layout
import Membership
import Org
import User
-- @admin end

-- @admin begin routes
route Show = GET "/admin/user/{id}" { id: User.UserId } requires user, role Admin
-- @admin end

-- The row, the labels of the rows it refers to, and (for the delete dialog) how many rows of
-- each table refer to it.
type Model = {
  row: User,
  labels: Labels,
  -- @admin begin model
  memberships: Int,
  -- @admin end
}

Show.load : Show.Params -> Session -> Query Model
Show.load params session = {
  let _ <- Layout.adminOnly session.user
  -- @admin begin load
  let found <- Db.get User params.id
  let memberships <-
    Db.from Membership
      |> Db.where (Membership.user.eq params.id)
      |> Db.count
  match found {
    Just row -> {
      let labels <- labelsOf [row]
      Query.succeed {
        row: row,
        labels: labels,
        memberships: memberships,
      }
    },
    Nothing -> Query.notFound,
  }
  -- @admin end
}

-- @admin begin labels
-- Labels are the rows the references of the rows shown name: their links show their labels.
type Labels = { }

labelsOf : List User -> Query Labels
labelsOf rows = Query.succeed {}
-- @admin end

-- @admin begin blockers
-- blockers counts the rows that keep this one from being deleted, which the database would
-- refuse the delete for: the `@restrict` references to it, or to a row deleted with it.
blockers : Model -> Int
blockers model = 0
-- @admin end

Show.view : Model -> Session -> Html
Show.view model session =
  <Layout.Page title="User">
    <h1>User</h1>

    <al-card>
      <dl id="fields">
        -- @admin begin fields
        <dt>Id</dt>
        <dd>{model.row.id}</dd>
        <dt>Email</dt>
        <dd>{model.row.email}</dd>
        <dt>Name</dt>
        <dd>{model.row.name}</dd>
        <dt>Role</dt>
        <dd>
          <al-badge>
            {match model.row.role {
              Member -> "Member",
              Admin -> "Admin",
            }}
          </al-badge>
        </dd>
        <dt>Created</dt>
        <dd>{Time.format "Jan 2, 2006" model.row.created}</dd>
        -- @admin end
      </dl>
      <div slot="actions">
        <al-button href={Admin.Users.Edit.Edit { id: model.row.id }}>Edit</al-button>
        <al-button variant="destructive">
          <button type="button" commandfor="delete-dialog" command="show-modal">Delete</button>
        </al-button>
      </div>
    </al-card>
    <al-dialog id="delete-dialog" heading="Delete this user?" dismissible>
      <dl>
        -- @admin begin counts
        <dt>Memberships deleted with it</dt>
        <dd id="memberships">{Text.fromInt model.memberships}</dd>
        -- @admin end
      </dl>
      <form id="delete" submit={Admin.Users.Delete.Destroy { id: model.row.id }}>
        <al-alert variant="destructive"><Errors form /></al-alert>
        {if session.user == model.row.id then
          <p>You cannot delete your own account.</p>
        else if blockers model > 0 then
          <p>It cannot be deleted while other rows refer to it.</p>
        else
          <al-button variant="destructive" type="submit">Delete</al-button>}
      </form>
      <div slot="actions">
        <a href={Admin.Users.Delete.Delete { id: model.row.id }}>See the details</a>
      </div>
    </al-dialog>
    <a href={Admin.Users.Index.Index {}}>All users</a>
  </Layout.Page>

-- @admin begin tests
test "the page shows the row" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let r <- Test.open (Show { id: user2 })
  Task.succeed (
    { answer: r.answer, email: List.member "email-2@example.com" (Test.texts "#fields dd" r.doc) }
      == { answer: Shown, email: True }
  )
}

test "deleting a user nothing refers to" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let user3 <- Db.insert User {
    email: Text.Email "email-3@example.com",
    name: Text.NonEmpty "name-3",
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Db.insert Membership { user: user3, org: org1 }
  let page <- Test.get (Show { id: user2 })
  let r <- Test.submit (Admin.Users.Delete.Destroy { id: user2 }) {}
  let gone <- Db.get User user2
  let kept <- Db.get User user3
  Task.succeed (
    {
      button: Test.count "#delete al-button" page.doc,
      answer: r.answer,
      gone: Maybe.map (\row -> row.id) gone,
      kept: Maybe.map (\row -> row.id) kept,
    } == {
      button: 1,
      answer: Redirected (Admin.Users.Index.Index {}),
      gone: Nothing,
      kept: Just user3,
    }
  )
}

test "the page counts the rows that go with it" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Db.insert Membership { user: user2, org: org1 }
  let user3 <- Db.insert User {
    email: Text.Email "email-3@example.com",
    name: Text.NonEmpty "name-3",
  }
  let _ <- Db.insert Membership { user: user3, org: org1 }
  let page <- Test.get (Show { id: user2 })
  Task.succeed ({ memberships: Test.text "#memberships" page.doc } == { memberships: Just "1" })
}

test "an Admin cannot delete their own account" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let page <- Test.get (Show { id: me })
  let r <- Test.submit (Admin.Users.Delete.Destroy { id: me }) {}
  let kept <- Db.get User me
  Task.succeed (
    {
      says: Test.texts "#delete p" page.doc,
      buttons: Test.count "#delete button" page.doc,
      answer: r.answer,
      kept: Maybe.map (\row -> row.id) kept,
    } == {
      says: ["You cannot delete your own account."],
      buttons: 0,
      answer: FormRejected [{ field: "", message: "You cannot delete your own account." }],
      kept: Just me,
    }
  )
}

test "a missing row is not found" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let r <- Test.open (Show { id: User.UserId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "a visitor is sent to log in" = {
  let user1 <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
  }
  let r <- Test.open (Show { id: user1 })
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Member gets no page, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Member,
  }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let r <- Test.open (Show { id: user2 })
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Member,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let r <- Test.open (Show { id: user2 })
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
