+test "saving ActivityEdit changes every field" = {
+  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
+  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
+  let _ <- Test.member me org
+  let _ <- Test.login { user: Just me, org: Just org }
+  let activity1 <- Db.insert Activity { text: Text.NonEmpty "text-1", org: org }
+  let page <- Test.get (Show { id: activity1 })
+  let r <- Test.submit (SaveActivityEdit { id: activity1 }) { text: Text.NonEmpty "text-2" }
+  let after <- Db.get Activity activity1
+  Task.succeed (
+    {
+      answer: r.answer,
+      notices: r.notices,
+      row: Maybe.map (\row -> { text: row.text }) after,
+    } == {
+      answer: Redirected (Show { id: activity1 }),
+      notices: ["Saved"],
+      row: Just { text: Text.NonEmpty "text-2" },
+    }
+  )
+}
+
+test "a required field left empty in ActivityEdit is rejected" = {
+  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
+  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
+  let _ <- Test.member me org
+  let _ <- Test.login { user: Just me, org: Just org }
+  let activity1 <- Db.insert Activity { text: Text.NonEmpty "text-1", org: org }
+  let before <- Db.get Activity activity1
+  let page <- Test.get (Show { id: activity1 })
+  let r <- Test.submitRaw (SaveActivityEdit { id: activity1 }) [{ name: "text", value: "" }]
+  let after <- Db.get Activity activity1
+  Task.succeed (
+    { answer: r.answer, row: after }
+      == { answer: FormRejected [{ field: "text", message: "must not be empty" }], row: before }
+  )
+}
