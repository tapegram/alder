-- generated by `alder new resource Note --module Notes --path /notes`; regions between
-- `-- @resource begin <name>` / `-- @resource end` are rewritten by `alder regen resource`
module Notes.New

-- @resource begin imports
import Activity
import Layout
import Org
import Table.Note
import User
-- @resource end

-- @resource begin routes
route New    = GET  "/notes/new" { findActivity: Text = "" } requires user, org
route Create = POST "/notes"     { } form NoteForm           requires user, org
-- @resource end

type Model = {
  -- @resource begin model
  activities: List Activity,
  activitiesTotal: Int,
  findActivity: Text,
  -- @resource end
}

New.load : New.Params -> Session -> Query Model
New.load params session = {
  -- @resource begin load
  let findActivity = Text.slice 0 200 params.findActivity
  let activitiesTotal <- Db.scoped Activity |> Db.count
  let activities <-
    Db.scoped Activity
      |> Db.orderBy Activity.text.asc
      |> Db.where (if activitiesTotal > 200 then Activity.text.contains findActivity else Db.and [])
      |> Db.limit (if activitiesTotal > 200 then 50 else 200)
      |> Db.all
  Query.succeed {
    activities: activities,
    activitiesTotal: activitiesTotal,
    findActivity: findActivity,
  }
  -- @resource end
}

-- @resource begin form
form NoteForm = { text: Text.NonEmpty, activity: Activity.ActivityId }
-- @resource end

-- @resource begin search
-- @resource end

-- Create adds the row and goes to its page.
Create.update : Create.Params -> Session -> Task Response
Create.update params session = {
  -- @resource begin insert
  let id <- Db.insertMine Note { text: params.form.text, activity: params.form.activity }
  Task.succeed (Response.redirect (Notes.Show.Show { id: id }))
  -- @resource end
}

New.view : Model -> Session -> Html
New.view model session =
  <Layout.Page title="New note">
    <h1>New note</h1>

    <al-card>
      -- @resource begin finder
      {if model.activitiesTotal > 200 then
        <form method="get" action="/notes/new">
          <al-input>
            <label>
              Find activity <input type="search" name="findActivity" value={model.findActivity} />
            </label>
          </al-input>
          <al-button type="submit" variant="secondary">Find</al-button>
        </form>
      else
        Html.none}
      -- @resource end
      <form submit={Create}>
        -- @resource begin inputs
        <al-input field="text" label="Text" />
        <al-select
          field="activity"
          label="Activity"
          options={List.map (\r -> { value: r.id, label: r.text }) model.activities} />
        -- @resource end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Create</al-button>
      </form>
    </al-card>
  </Layout.Page>

-- @resource begin tests
test "creating adds a row that is mine" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org }
  let activity1 <- Db.insert Activity { text: Text.NonEmpty "text-1", org: org }
  let activity2 <- Db.insert Activity { text: Text.NonEmpty "text-2", org: org }
  let otherOrg <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let _ <- Db.insert Activity { text: Text.NonEmpty "text-3", org: otherOrg }
  let page <- Test.get (New {})
  let r <- Test.submit Create { text: Text.NonEmpty "text-1", activity: activity2 }
  let rows <- Db.from Note |> Db.all
  Task.succeed (
    {
      answers: List.map (\row -> Redirected (Notes.Show.Show { id: row.id })) rows,
      rows: List.map (\row -> {
        text: row.text,
        activity: row.activity,
        owner: row.owner,
      }) rows,
      activities: Test.texts "select[name=activity] option" page.doc,
    } == {
      answers: [r.answer],
      rows: [
        {
          text: Text.NonEmpty "text-1",
          activity: activity2,
          owner: me,
        },
      ],
      activities: ["text-1", "text-2"],
    }
  )
}

test "an empty text is rejected" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org }
  let activity1 <- Db.insert Activity { text: Text.NonEmpty "text-1", org: org }
  let activity2 <- Db.insert Activity { text: Text.NonEmpty "text-2", org: org }
  let page <- Test.get (New {})
  let activityId = Maybe.withDefault "" (Test.attr "value" "select[name=activity] option" page.doc)
  let r <- Test.submitRaw Create [
    { name: "text", value: "" },
    { name: "activity", value: activityId },
  ]
  let rows <- Db.mine Note |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows }
      == { answer: FormRejected [{ field: "text", message: "must not be empty" }], rows: 0 }
  )
}

test "an activity not offered is refused" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org }
  let activity1 <- Db.insert Activity { text: Text.NonEmpty "text-1", org: org }
  let activity2 <- Db.insert Activity { text: Text.NonEmpty "text-2", org: org }
  let page <- Test.get (New {})
  let r <- Test.submitRaw Create [
    { name: "text", value: "x" },
    { name: "activity", value: "missing" },
  ]
  let rows <- Db.from Note |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows }
      == {
        answer: FormRejected [{ field: "activity", message: "must be one of the options" }],
        rows: 0,
      }
  )
}

test "a list of 200 activities is offered whole" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org }
  let activity1 <- Db.insert Activity { text: Text.NonEmpty "text-1", org: org }
  let activity2 <- Db.insert Activity { text: Text.NonEmpty "text-2", org: org }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Activity {
        text: Text.NonEmpty ("text-" ++ Text.fromInt n),
        org: org,
      }) (List.range 3 200)
    )
  let otherOrg <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let _ <- Db.insert Activity { text: Text.NonEmpty "text-201", org: otherOrg }
  let page <- Test.get (New {})
  Task.succeed (List.length page.model.activities == 200)
}

test "a long list of activities offers 50, and the search narrows it" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org }
  let activity1 <- Db.insert Activity { text: Text.NonEmpty "text-1", org: org }
  let activity2 <- Db.insert Activity { text: Text.NonEmpty "text-2", org: org }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Activity {
        text: Text.NonEmpty ("text-" ++ Text.fromInt n),
        org: org,
      }) (List.range 3 203)
    )
  let all <- Test.get (New {})
  let found <- Test.get (New { findActivity: "text-203" })
  Task.succeed (
    {
      shown: List.length all.model.activities,
      total: all.model.activitiesTotal,
      found: Test.texts "select[name=activity] option" found.doc == ["text-203"],
      input: Test.attr "value" "input[name=findActivity]" found.doc,
    } == {
      shown: 50,
      total: 203,
      found: True,
      input: Just "text-203",
    }
  )
}

test "an activity outside the narrowed list is refused" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org }
  let activity1 <- Db.insert Activity { text: Text.NonEmpty "text-1", org: org }
  let activity2 <- Db.insert Activity { text: Text.NonEmpty "text-2", org: org }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Activity {
        text: Text.NonEmpty ("text-" ++ Text.fromInt n),
        org: org,
      }) (List.range 3 203)
    )
  let all <- Test.get (New {})
  let found <- Test.get (New { findActivity: "text-203" })
  let pick = Maybe.withDefault "" (Test.attr "value" "select[name=activity] option" found.doc)
  let page <- Test.get (New {})
  let sent <- Test.submitRaw Create [
    { name: "text", value: "x" },
    { name: "activity", value: pick },
  ]
  let rows <- Db.from Note |> Db.count
  Task.succeed (
    { answer: sent.answer, rows: rows }
      == {
        answer: FormRejected [{ field: "activity", message: "must be one of the options" }],
        rows: 0,
      }
  )
}

test "a visitor cannot create a note" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org }
  let activity1 <- Db.insert Activity { text: Text.NonEmpty "text-1", org: org }
  let activity2 <- Db.insert Activity { text: Text.NonEmpty "text-2", org: org }
  let _ <- Test.get (New {})
  let _ <- Test.login { user: Nothing, org: Nothing }
  let r <- Test.submit Create { text: Text.NonEmpty "text-1", activity: activity2 }
  let _ <- Test.login { user: Just me, org: Just org }
  let rows <- Db.from Note |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows } == { answer: Redirected (Auth.Login.Login {}), rows: 0 }
  )
}

test "a visitor is sent to log in" = {
  let r <- Test.open (New {})
  Task.succeed (r.answer == Redirected (Auth.Login.Login {}))
}
-- @resource end
