-- generated by `alder new resource Note --module Notes --path /notes`; regions between
-- `-- @resource begin <name>` / `-- @resource end` are rewritten by `alder regen resource`
module Notes.Show

-- @resource begin imports
import Activity
import Layout
import Org
import Table.Note
import User
-- @resource end

-- @resource begin routes
route Show = GET "/notes/{id}" { id: Note.NoteId } requires user, org
-- @resource end

-- The row, the labels of the rows it refers to, and (for the delete dialog) how many rows of
-- each table refer to it.
type Model = {
  row: Note,
  labels: Labels,
  -- @resource begin model
  -- @resource end
}

Show.load : Show.Params -> Session -> Query Model
Show.load params session = {
  -- @resource begin load
  let row <- Db.getMine Note params.id
  let labels <- labelsOf [row]
  Query.succeed { row: row, labels: labels }
  -- @resource end
}

-- @resource begin labels
-- Labels are the rows the references of the rows shown name: their links show their labels.
type Labels = { owners: List User, activities: List Activity }

-- labelsOf reads the rows that rows refer to.
labelsOf : List Note -> Query Labels requires org
labelsOf rows = {
  -- every user's rows: User has no owner
  let owners <-
    Db.from User
      |> Db.where (User.id.in (List.map (\row -> row.owner) rows))
      |> Db.all
  let activities <-
    Db.scoped Activity
      |> Db.where (Activity.id.in (List.map (\row -> row.activity) rows))
      |> Db.all
  Query.succeed { owners: owners, activities: activities }
}

-- ownerLabel is the label of the user id names (the id itself if it names none).
ownerLabel : Labels -> User.UserId -> Text
ownerLabel labels id = match List.find (\r -> r.id == id) labels.owners {
  Just r -> r.name,
  Nothing -> id,
}

-- activityLabel is the label of the activity id names (the id itself if it names none).
activityLabel : Labels -> Activity.ActivityId -> Text
activityLabel labels id = match List.find (\r -> r.id == id) labels.activities {
  Just r -> r.text,
  Nothing -> id,
}
-- @resource end

-- @resource begin blockers
-- blockers counts the rows that keep this one from being deleted, which the database would
-- refuse the delete for: the `@restrict` references to it, or to a row deleted with it.
blockers : Model -> Int
blockers model = 0
-- @resource end

Show.view : Model -> Session -> Html
Show.view model session =
  <Layout.Page title="Note">
    <h1>Note</h1>

    <al-card>
      <dl id="fields">
        -- @resource begin fields
        <dt>Id</dt>
        <dd>{model.row.id}</dd>
        <dt>Text</dt>
        <dd>{model.row.text}</dd>
        <dt>Owner</dt>
        <dd>{ownerLabel model.labels model.row.owner}</dd>
        <dt>Activity</dt>
        <dd>{activityLabel model.labels model.row.activity}</dd>
        <dt>Created</dt>
        <dd>{Time.format "Jan 2, 2006" model.row.created}</dd>
        <dt>Updated</dt>
        <dd>{Time.format "Jan 2, 2006" model.row.updated}</dd>
        -- @resource end
      </dl>
      <div slot="actions">
        <al-button href={Notes.Edit.Edit { id: model.row.id }}>Edit</al-button>
        <al-button variant="destructive">
          <button type="button" commandfor="delete-dialog" command="show-modal">Delete</button>
        </al-button>
      </div>
    </al-card>
    <al-dialog id="delete-dialog" heading="Delete this note?" dismissible>
      <dl>
        -- @resource begin counts
        -- @resource end
      </dl>
      <form id="delete" submit={Notes.Delete.Destroy { id: model.row.id }}>
        <al-alert variant="destructive"><Errors form /></al-alert>
        {if blockers model > 0 then
          <p>It cannot be deleted while other rows refer to it.</p>
        else
          <al-button variant="destructive" type="submit">Delete</al-button>}
      </form>
      <div slot="actions">
        <a href={Notes.Delete.Delete { id: model.row.id }}>See the details</a>
      </div>
    </al-dialog>
    <a href={Notes.Index.Index {}}>All notes</a>
  </Layout.Page>

-- @resource begin tests
test "the page shows the row" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org }
  let activity1 <- Db.insert Activity { text: Text.NonEmpty "text-1", org: org }
  let note1 <- Db.insert Note {
    text: Text.NonEmpty "text-1",
    owner: me,
    activity: activity1,
  }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let activity2 <- Db.insert Activity { text: Text.NonEmpty "text-2", org: org }
  let r <- Test.open (Show { id: note1 })
  let page <- Test.get (Show { id: note1 })
  Task.succeed (
    {
      answer: r.answer,
      text: List.member "text-1" (Test.texts "#fields dd" r.doc),
      owners: List.length page.model.labels.owners,
      ownerLabel: ownerLabel page.model.labels me,
      activities: List.length page.model.labels.activities,
      activityLabel: activityLabel page.model.labels activity1,
    } == {
      answer: Shown,
      text: True,
      owners: 1,
      ownerLabel: "name-1",
      activities: 1,
      activityLabel: "text-1",
    }
  )
}

test "another org's activity is not named" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org }
  let otherOrg <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let activity1 <- Db.insert Activity { text: Text.NonEmpty "text-1", org: otherOrg }
  let note1 <- Db.insert Note {
    text: Text.NonEmpty "text-1",
    owner: me,
    activity: activity1,
  }
  let page <- Test.get (Show { id: note1 })
  Task.succeed (List.length page.model.labels.activities == 0)
}

test "deleting a note nothing refers to" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org }
  let activity1 <- Db.insert Activity { text: Text.NonEmpty "text-1", org: org }
  let note1 <- Db.insert Note {
    text: Text.NonEmpty "text-1",
    owner: me,
    activity: activity1,
  }
  let page <- Test.get (Show { id: note1 })
  let r <- Test.submit (Notes.Delete.Destroy { id: note1 }) {}
  let gone <- Db.get Note note1
  Task.succeed (
    {
      button: Test.count "#delete al-button" page.doc,
      answer: r.answer,
      notices: r.notices,
      gone: Maybe.map (\row -> row.id) gone,
    } == {
      button: 1,
      answer: Redirected (Notes.Index.Index {}),
      notices: ["Deleted"],
      gone: Nothing,
    }
  )
}

test "a missing row is not found" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org }
  let r <- Test.open (Show { id: Note.NoteId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "another user's row is not found" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org }
  let other <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let activity1 <- Db.insert Activity { text: Text.NonEmpty "text-1", org: org }
  let note1 <- Db.insert Note {
    text: Text.NonEmpty "text-1",
    owner: other,
    activity: activity1,
  }
  let r <- Test.open (Show { id: note1 })
  Task.succeed (r.answer == PageMissing)
}

test "a visitor is sent to log in" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let activity1 <- Db.insert Activity { text: Text.NonEmpty "text-1", org: org1 }
  let note1 <- Db.insert Note {
    text: Text.NonEmpty "text-1",
    owner: me,
    activity: activity1,
  }
  let r <- Test.open (Show { id: note1 })
  Task.succeed (r.answer == Redirected (Auth.Login.Login {}))
}
-- @resource end
