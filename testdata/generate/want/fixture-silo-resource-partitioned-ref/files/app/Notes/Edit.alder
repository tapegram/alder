-- generated by `alder new resource Note --module Notes --path /notes`; regions between
-- `-- @resource begin <name>` / `-- @resource end` are rewritten by `alder regen resource`
module Notes.Edit

-- @resource begin imports
import Activity
import Layout
import Org
import Table.Note
import User
-- @resource end

-- @resource begin routes
route Edit = GET "/notes/{id}/edit" { id: Note.NoteId, findActivity: Text = "" } requires user, org
route Save = PUT "/notes/{id}"      { id: Note.NoteId } form NoteForm            requires user, org
-- @resource end

type Model = {
  row: Note,
  -- @resource begin model
  activities: List Activity,
  activitiesTotal: Int,
  findActivity: Text,
  -- @resource end
}

Edit.load : Edit.Params -> Session -> Query Model
Edit.load params session = {
  -- @resource begin load
  let row <- Db.getMine Note params.id
  let findActivity = Text.slice 0 200 params.findActivity
  let activitiesTotal <- Db.scoped Activity |> Db.count
  let activitiesOwn <-
    if activitiesTotal > 200 then
      Db.scoped Activity
        |> Db.where (Activity.id.eq row.activity)
        |> Db.all
    else
      Query.succeed []
  let activitiesFound <-
    Db.scoped Activity
      |> Db.orderBy Activity.text.asc
      |> Db.where (
        if activitiesTotal > 200 then
          Db.and [Activity.text.contains findActivity, Activity.id.ne row.activity]
        else
          Db.and []
      )
      |> Db.limit (if activitiesTotal > 200 then 50 else 200)
      |> Db.all
  let activities = activitiesOwn ++ activitiesFound
  Query.succeed {
    row: row,
    activities: activities,
    activitiesTotal: activitiesTotal,
    findActivity: findActivity,
  }
  -- @resource end
}

-- @resource begin form
form NoteForm = { text: Text.NonEmpty, activity: Activity.ActivityId }
-- @resource end

-- @resource begin search
-- @resource end

-- Save writes the form over the row (another user's, or one deleted since, is not found) and goes
-- to its page.
Save.update : Save.Params -> Session -> Task Response
Save.update params session = {
  -- @resource begin update
  let _ <- Db.updateMine Note params.id (\r -> { r |
    text: params.form.text,
    activity: params.form.activity
  })
  Task.succeed (Response.redirect (Notes.Show.Show { id: params.id }))
  -- @resource end
}

Edit.view : Model -> Session -> Html
Edit.view model session =
  <Layout.Page title="Edit note">
    <h1>Edit note</h1>

    <al-card>
      -- @resource begin finder
      {if model.activitiesTotal > 200 then
        <form method="get" action={"/notes/" ++ model.row.id ++ "/edit"}>
          <al-input>
            <label>
              Find activity <input type="search" name="findActivity" value={model.findActivity} />
            </label>
          </al-input>
          <al-button type="submit" variant="secondary">Find</al-button>
        </form>
      else
        Html.none}
      -- @resource end
      <form submit={Save { id: model.row.id }}>
        -- @resource begin inputs
        <al-input field="text" label="Text" value={model.row.text} />
        <al-select
          field="activity"
          label="Activity"
          options={List.map (\r -> { value: r.id, label: r.text }) model.activities}
          value={model.row.activity} />
        -- @resource end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Save</al-button>
      </form>
    </al-card>
    <a href={Notes.Show.Show { id: model.row.id }}>Back</a>
  </Layout.Page>

-- @resource begin tests
test "saving changes every field" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org }
  let activity1 <- Db.insert Activity { text: Text.NonEmpty "text-1", org: org }
  let note1 <- Db.insert Note {
    text: Text.NonEmpty "text-1",
    owner: me,
    activity: activity1,
  }
  let activity2 <- Db.insert Activity { text: Text.NonEmpty "text-2", org: org }
  let otherOrg <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let _ <- Db.insert Activity { text: Text.NonEmpty "text-3", org: otherOrg }
  let page <- Test.get (Edit { id: note1 })
  let r <- Test.submit (Save { id: note1 }) { text: Text.NonEmpty "text-2", activity: activity2 }
  let after <- Db.get Note note1
  Task.succeed (
    {
      answer: r.answer,
      row: Maybe.map (\row -> { text: row.text, activity: row.activity }) after,
      activities: Test.texts "select[name=activity] option" page.doc,
    } == {
      answer: Redirected (Notes.Show.Show { id: note1 }),
      row: Just { text: Text.NonEmpty "text-2", activity: activity2 },
      activities: ["text-1", "text-2"],
    }
  )
}

test "an activity not offered is refused" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org }
  let activity1 <- Db.insert Activity { text: Text.NonEmpty "text-1", org: org }
  let note1 <- Db.insert Note {
    text: Text.NonEmpty "text-1",
    owner: me,
    activity: activity1,
  }
  let activity2 <- Db.insert Activity { text: Text.NonEmpty "text-2", org: org }
  let page <- Test.get (Edit { id: note1 })
  let r <- Test.submitRaw (Save { id: note1 }) [
    { name: "text", value: "x" },
    { name: "activity", value: "missing" },
  ]
  let after <- Db.get Note note1
  Task.succeed (
    { answer: r.answer, activity: Maybe.map (\row -> row.activity) after }
      == {
        answer: FormRejected [{ field: "activity", message: "must be one of the options" }],
        activity: Just activity1,
      }
  )
}

test "a list of 200 activities is offered whole" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org }
  let activity1 <- Db.insert Activity { text: Text.NonEmpty "text-1", org: org }
  let note1 <- Db.insert Note {
    text: Text.NonEmpty "text-1",
    owner: me,
    activity: activity1,
  }
  let activity2 <- Db.insert Activity { text: Text.NonEmpty "text-2", org: org }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Activity {
        text: Text.NonEmpty ("text-" ++ Text.fromInt n),
        org: org,
      }) (List.range 3 200)
    )
  let otherOrg <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let _ <- Db.insert Activity { text: Text.NonEmpty "text-201", org: otherOrg }
  let page <- Test.get (Edit { id: note1 })
  Task.succeed (List.length page.model.activities == 200)
}

test "a long list of activities offers 50, and the search narrows it" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org }
  let activity1 <- Db.insert Activity { text: Text.NonEmpty "text-1", org: org }
  let note1 <- Db.insert Note {
    text: Text.NonEmpty "text-1",
    owner: me,
    activity: activity1,
  }
  let activity2 <- Db.insert Activity { text: Text.NonEmpty "text-2", org: org }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Activity {
        text: Text.NonEmpty ("text-" ++ Text.fromInt n),
        org: org,
      }) (List.range 3 203)
    )
  let all <- Test.get (Edit { id: note1 })
  let found <- Test.get (Edit { id: note1, findActivity: "text-203" })
  Task.succeed (
    {
      shown: List.length all.model.activities,
      total: all.model.activitiesTotal,
      found: Test.count "select[name=activity] option" found.doc <= 3,
      input: Test.attr "value" "input[name=findActivity]" found.doc,
    } == {
      shown: 51,
      total: 203,
      found: True,
      input: Just "text-203",
    }
  )
}

test "the row's own activity is offered first when it sorts past the 50" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org }
  let activity1 <- Db.insert Activity { text: Text.NonEmpty "zz-1", org: org }
  let note1 <- Db.insert Note {
    text: Text.NonEmpty "text-1",
    owner: me,
    activity: activity1,
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Activity {
        text: Text.NonEmpty ("text-" ++ Text.fromInt n),
        org: org,
      }) (List.range 2 202)
    )
  let page <- Test.get (Edit { id: note1 })
  let r <- Test.submit (Save { id: note1 }) {
    text: page.model.row.text,
    activity: page.model.row.activity,
  }
  let after <- Db.get Note note1
  Task.succeed (
    {
      answer: r.answer,
      kept: Maybe.map (\row -> row.activity) after,
      first: Maybe.map (\o -> o.id) (List.head page.model.activities),
      once: List.length (List.filter (\o -> o.id == activity1) page.model.activities),
      shown: List.length page.model.activities,
    } == {
      answer: Redirected (Notes.Show.Show { id: note1 }),
      kept: Just activity1,
      first: Just activity1,
      once: 1,
      shown: 51,
    }
  )
}

test "another org's activity the row refers to is not offered" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org }
  let otherOrg <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let activity1 <- Db.insert Activity { text: Text.NonEmpty "zz-1", org: otherOrg }
  let note1 <- Db.insert Note {
    text: Text.NonEmpty "text-1",
    owner: me,
    activity: activity1,
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Activity {
        text: Text.NonEmpty ("text-" ++ Text.fromInt n),
        org: org,
      }) (List.range 2 202)
    )
  let page <- Test.get (Edit { id: note1 })
  Task.succeed (
    {
      offered: List.length (List.filter (\o -> o.id == activity1) page.model.activities),
      shown: List.length page.model.activities,
    }
      == { offered: 0, shown: 50 }
  )
}

test "a visitor cannot save a note" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org }
  let activity1 <- Db.insert Activity { text: Text.NonEmpty "text-1", org: org }
  let note1 <- Db.insert Note {
    text: Text.NonEmpty "text-1",
    owner: me,
    activity: activity1,
  }
  let activity2 <- Db.insert Activity { text: Text.NonEmpty "text-2", org: org }
  let before <- Db.get Note note1
  let _ <- Test.get (Edit { id: note1 })
  let _ <- Test.login { user: Nothing, org: Nothing }
  let r <- Test.submit (Save { id: note1 }) { text: Text.NonEmpty "text-2", activity: activity2 }
  let _ <- Test.login { user: Just me, org: Just org }
  let after <- Db.get Note note1
  Task.succeed (
    { answer: r.answer, row: after } == { answer: Redirected (Auth.Login.Login {}), row: before }
  )
}

test "another user cannot save it" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org }
  let other <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let activity1 <- Db.insert Activity { text: Text.NonEmpty "text-1", org: org }
  let note1 <- Db.insert Note {
    text: Text.NonEmpty "text-1",
    owner: other,
    activity: activity1,
  }
  let activity2 <- Db.insert Activity { text: Text.NonEmpty "text-2", org: org }
  let before <- Db.get Note note1
  let _ <- Test.member other org
  let _ <- Test.login { user: Just other, org: Just org }
  let _ <- Test.get (Edit { id: note1 })
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org }
  let r <- Test.submit (Save { id: note1 }) { text: Text.NonEmpty "text-2", activity: activity2 }
  let after <- Db.get Note note1
  Task.succeed (
    { answer: r.answer, row: after } == { answer: RequestFailed "400 bad request", row: before }
  )
}

test "Save itself does not change another user's row" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org }
  let other <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let activity1 <- Db.insert Activity { text: Text.NonEmpty "text-1", org: org }
  let note1 <- Db.insert Note {
    text: Text.NonEmpty "text-1",
    owner: other,
    activity: activity1,
  }
  let activity2 <- Db.insert Activity { text: Text.NonEmpty "text-2", org: org }
  let before <- Db.get Note note1
  let r <-
    Test.run (Save.update {
      id: note1,
      form: { text: Text.NonEmpty "text-2", activity: activity2 },
    } {
      user: me,
      org: org,
      role: Member,
    })
  let after <- Db.get Note note1
  Task.succeed (
    {
      value: r.value,
      wrote: List.member "Db.updateMine Note" r.trace,
      row: after,
    } == {
      value: Err "not found",
      wrote: True,
      row: before,
    }
  )
}

test "a missing row is not found" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org }
  let r <- Test.open (Edit { id: Note.NoteId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "another user's row: the edit page is not found" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org }
  let other <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let activity1 <- Db.insert Activity { text: Text.NonEmpty "text-1", org: org }
  let note1 <- Db.insert Note {
    text: Text.NonEmpty "text-1",
    owner: other,
    activity: activity1,
  }
  let r <- Test.open (Edit { id: note1 })
  Task.succeed (r.answer == PageMissing)
}

test "a visitor is sent to log in" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let activity1 <- Db.insert Activity { text: Text.NonEmpty "text-1", org: org1 }
  let note1 <- Db.insert Note {
    text: Text.NonEmpty "text-1",
    owner: me,
    activity: activity1,
  }
  let r <- Test.open (Edit { id: note1 })
  Task.succeed (r.answer == Redirected (Auth.Login.Login {}))
}
-- @resource end
