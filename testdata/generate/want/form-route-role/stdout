+test "submitting Quick adds a row" = {
+  let me <- Db.insert User {
+    email: Text.Email "email-1@example.com",
+    name: Text.NonEmpty "name-1",
+    role: Admin,
+  }
+  let _ <- Test.login { user: Just me, role: Admin }
+  let post1 <- Db.insert Post {
+    title: Text.NonEmpty "title-1",
+    body: "body-1",
+    author: me,
+  }
+  let _ <- Test.get (Index {})
+  let r <- Test.submit SubmitQuick { name: Text.NonEmpty "name-1", post: post1 }
+  let rows <- Db.from Tag |> Db.all
+  Task.succeed (
+    {
+      answer: r.answer,
+      notices: r.notices,
+      rows: List.map (\row -> { name: row.name, post: row.post }) rows,
+    } == {
+      answer: Redirected (Index {}),
+      notices: ["Saved"],
+      rows: [{ name: Text.NonEmpty "name-1", post: post1 }],
+    }
+  )
+}
