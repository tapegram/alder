module Tags.Index

import Layout
import Table.Post
import Table.Tag
import Table.User

route Index       = GET  "/tags"               { page: Int = 1 } requires user, role Admin
route SubmitQuick = POST "/tags/_/SubmitQuick" { } form Quick    requires user, role Admin

type Model = {
  rows: List Tag,
  page: Int,
  pages: Int,
}

perPage : Int
perPage = 20

-- lastPage bounds `page`, so `(page - 1) * perPage` cannot overflow.
lastPage : Int
lastPage = 1000000

-- Index.load reads one page of the rows, newest first, and how many pages there are.
Index.load : Index.Params -> Session -> Query Model
Index.load params session = {
  let page = Int.clamp { min: 1, max: lastPage } params.page
  let rows <-
    Db.from Tag
      |> Db.orderBy Tag.created.desc
      |> Db.limit perPage
      |> Db.offset ((page - 1) * perPage)
      |> Db.all
  let count <- Db.from Tag |> Db.count
  Query.succeed {
    rows: rows,
    page: page,
    pages: Int.max 1 ((count + perPage - 1) / perPage),
  }
}

Index.view : Model -> Session -> Html
Index.view model session =
  <Layout.Page title="Tags">
    <h1>Tags</h1>

    <al-table>
      <table>
        <thead>
          <tr>
            <th>Name</th>
            <th>Post</th>
            <th>Created</th>
          </tr>
        </thead>
        <tbody>
          {for row in model.rows ->
            <tr>
              <td>{row.name}</td>
              <td>{row.post}</td>
              <td>{Time.format "Jan 2, 2006" row.created}</td>
            </tr>}
        </tbody>
      </table>
    </al-table>

    <al-pagination role="navigation" aria-label="Pages">
      {if model.page > 1 then
        <a slot="prev" href={Index { page: model.page - 1 }} rel="prev">Previous</a>
      else
        <span slot="prev" aria-disabled="true">Previous</span>}
      <span>Page {Text.fromInt model.page} of {Text.fromInt model.pages}</span>
      {if model.page < model.pages then
        <a slot="next" href={Index { page: model.page + 1 }} rel="next">Next</a>
      else
        <span slot="next" aria-disabled="true">Next</span>}
    </al-pagination>

    <al-card>
      <h2 slot="header">Quick</h2>
      <form submit={SubmitQuick}>
        <al-input field="name" label="Name" />
        <al-input field="post" label="Post" />
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Quick</al-button>
      </form>
    </al-card>
  </Layout.Page>

form Quick = { name: Text.NonEmpty, post: Post.PostId }

SubmitQuick.update : SubmitQuick.Params -> Session -> Task Response
SubmitQuick.update params session = {
  let _ <- Db.insert Tag { name: params.form.name, post: params.form.post }
  Task.succeed (Response.redirect (Index {}) |> Response.success "Saved")
}

test "the list shows the rows, newest first" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let tag1 <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let tag2 <- Db.insert Tag { name: Text.NonEmpty "name-2", post: post1 }
  let page <- Test.get (Index {})
  Task.succeed (List.map (\row -> row.id) page.model.rows == [tag2, tag1])
}

test "the list has 20 rows a page" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Tag {
        name: Text.NonEmpty ("name-" ++ Text.fromInt n),
        post: post1,
      }) (List.range 1 21)
    )
  let first <- Test.get (Index {})
  let second <- Test.get (Index { page: 2 })
  Task.succeed (
    {
      first: List.length first.model.rows,
      second: List.length second.model.rows,
      pages: Test.texts "al-pagination span" first.doc,
    } == {
      first: 20,
      second: 1,
      pages: ["Previous", "Page 1 of 2"],
    }
  )
}

test "a visitor is sent to log in" = {
  let r <- Test.open (Index {})
  Task.succeed (r.answer == Redirected (Auth.Login.Login {}))
}

test "a user who is not Admin gets no page" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Reader,
  }
  let _ <- Test.login { user: Just me, role: Reader }
  let r <- Test.open (Index {})
  Task.succeed (r.answer == PageMissing)
}

test "submitting Quick adds a row" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let _ <- Test.get (Index {})
  let r <- Test.submit SubmitQuick { name: Text.NonEmpty "name-1", post: post1 }
  let rows <- Db.from Tag |> Db.all
  Task.succeed (
    {
      answer: r.answer,
      notices: r.notices,
      rows: List.map (\row -> { name: row.name, post: row.post }) rows,
    } == {
      answer: Redirected (Index {}),
      notices: ["Saved"],
      rows: [{ name: Text.NonEmpty "name-1", post: post1 }],
    }
  )
}

test "Quick refuses an empty name" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let _ <- Test.get (Index {})
  let r <- Test.submitRaw SubmitQuick [{ name: "name", value: "" }, { name: "post", value: "x" }]
  let rows <- Db.from Tag |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows }
      == { answer: FormRejected [{ field: "name", message: "must not be empty" }], rows: 0 }
  )
}

test "a visitor cannot submit Quick" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let _ <- Test.get (Index {})
  let _ <- Test.login { user: Nothing }
  let r <- Test.submit SubmitQuick { name: Text.NonEmpty "name-1", post: post1 }
  let rows <- Db.from Tag |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows } == { answer: Redirected (Auth.Login.Login {}), rows: 0 }
  )
}

test "a Reader cannot submit Quick" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let _ <- Test.get (Index {})
  let _ <- Test.login { user: Just me, role: Reader }
  let r <- Test.submit SubmitQuick { name: Text.NonEmpty "name-1", post: post1 }
  let rows <- Db.from Tag |> Db.count
  Task.succeed ({ answer: r.answer, rows: rows } == { answer: PageMissing, rows: 0 })
}
