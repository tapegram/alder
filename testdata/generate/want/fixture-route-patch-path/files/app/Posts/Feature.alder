module Posts.Feature

import Table.Post

route Feature = PATCH "/posts/{id}/feature" { id: Post.PostId } requires user

-- Press Feature from a page that has its button to test it: `Test.get` that page, then
-- `Test.click (Feature { … })`, and `r.answer` is Refreshed until `update` says otherwise.
Feature.update : Feature.Params -> Session -> Task Response
Feature.update params session = Task.succeed Response.refresh
