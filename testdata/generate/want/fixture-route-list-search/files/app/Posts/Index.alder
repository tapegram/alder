module Posts.Index

import Layout
import Table.Post
import Table.User

route Index = GET "/posts" { q: Text = "", page: Int = 1 } requires user

type Model = {
  rows: List Post,
  q: Text,
  page: Int,
  pages: Int,
}

perPage : Int
perPage = 20

-- search is the rows whose text contains q (every row for "").
search : Text -> Condition Post
search q = Db.or [Post.title.contains q]

-- lastPage bounds `page`, so `(page - 1) * perPage` cannot overflow.
lastPage : Int
lastPage = 1000000

-- Index.load reads one page of the rows, newest first, and how many pages there are.
Index.load : Index.Params -> Session -> Query Model
Index.load params session = {
  let page = Int.clamp { min: 1, max: lastPage } params.page
  let q = Text.slice 0 200 params.q
  let rows <-
    Db.mine Post
      |> Db.where (search q)
      |> Db.orderBy Post.created.desc
      |> Db.limit perPage
      |> Db.offset ((page - 1) * perPage)
      |> Db.all
  let count <-
    Db.mine Post
      |> Db.where (search q)
      |> Db.count
  Query.succeed {
    rows: rows,
    q: q,
    page: page,
    pages: Int.max 1 ((count + perPage - 1) / perPage),
  }
}

Index.view : Model -> Session -> Html
Index.view model session =
  <Layout.Page title="Posts">
    <h1>Posts</h1>

    <form method="get" action="/posts">
      <al-stack direction="row" gap="sm">
        <al-input><label>Search<input type="search" name="q" value={model.q} /></label></al-input>
        <al-button type="submit" variant="secondary">Search</al-button>
      </al-stack>
    </form>

    <al-table>
      <table>
        <thead>
          <tr>
            <th>Title</th>
            <th>Body</th>
            <th>Status</th>
            <th>Featured</th>
            <th>Author</th>
            <th>Created</th>
            <th>Updated</th>
          </tr>
        </thead>
        <tbody>
          {for row in model.rows ->
            <tr>
              <td>{row.title}</td>
              <td>{row.body}</td>
              <td>
                <al-badge>
                  {match row.status {
                    Draft -> "Draft",
                    Published -> "Published",
                  }}
                </al-badge>
              </td>
              <td>
                {if row.featured then
                  <al-badge>Yes</al-badge>
                else
                  <al-badge variant="secondary">No</al-badge>}
              </td>
              <td>{row.author}</td>
              <td>{Time.format "Jan 2, 2006" row.created}</td>
              <td>{Time.format "Jan 2, 2006" row.updated}</td>
            </tr>}
        </tbody>
      </table>
    </al-table>

    <al-pagination role="navigation" aria-label="Pages">
      {if model.page > 1 then
        <a slot="prev" href={Index { q: model.q, page: model.page - 1 }} rel="prev">Previous</a>
      else
        <span slot="prev" aria-disabled="true">Previous</span>}
      <span>Page {Text.fromInt model.page} of {Text.fromInt model.pages}</span>
      {if model.page < model.pages then
        <a slot="next" href={Index { q: model.q, page: model.page + 1 }} rel="next">Next</a>
      else
        <span slot="next" aria-disabled="true">Next</span>}
    </al-pagination>
  </Layout.Page>

test "the list shows my rows, newest first" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let other <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let post3 <- Db.insert Post {
    title: Text.NonEmpty "title-3",
    body: "body-3",
    author: other,
  }
  let page <- Test.get (Index {})
  Task.succeed (List.map (\row -> row.id) page.model.rows == [post2, post1])
}

test "the list has 20 rows a page" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Post {
        title: Text.NonEmpty ("title-" ++ Text.fromInt n),
        body: "body-" ++ Text.fromInt n,
        author: me,
      }) (List.range 1 21)
    )
  let other <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Post {
        title: Text.NonEmpty ("title-" ++ Text.fromInt n),
        body: "body-" ++ Text.fromInt n,
        author: other,
      }) (List.range 22 41)
    )
  let first <- Test.get (Index {})
  let second <- Test.get (Index { page: 2 })
  Task.succeed (
    {
      first: List.length first.model.rows,
      second: List.length second.model.rows,
      pages: Test.texts "al-pagination span" first.doc,
    } == {
      first: 20,
      second: 1,
      pages: ["Previous", "Page 1 of 2"],
    }
  )
}

test "searching finds matching rows" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let page <- Test.get (Index { q: "title-2" })
  Task.succeed (List.map (\row -> row.id) page.model.rows == [post2])
}

test "a long query is cut" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let long = Text.join "" (List.map (\n -> "z") (List.range 1 20000))
  let page <- Test.get (Index { q: long })
  Task.succeed (
    { q: Text.length page.model.q, rows: List.length page.model.rows } == { q: 200, rows: 0 }
  )
}

test "a visitor is sent to log in" = {
  let r <- Test.open (Index {})
  Task.succeed (r.answer == Redirected (Auth.Login.Login {}))
}
