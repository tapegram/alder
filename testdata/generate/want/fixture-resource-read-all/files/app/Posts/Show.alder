-- generated by `alder new resource Post --module Posts --path /posts --read all`; regions between
-- `-- @resource begin <name>` / `-- @resource end` are rewritten by `alder regen resource`
module Posts.Show

-- @resource begin imports
import Layout
import Table.Comment
import Table.Post
import Table.Tag
import Table.User
-- @resource end

-- @resource begin routes
route Show = GET "/posts/{id}" { id: Post.PostId }
-- @resource end

-- The row, the labels of the rows it refers to, and (for the delete dialog) how many rows of
-- each table refer to it.
type Model = {
  row: Post,
  labels: Labels,
  -- @resource begin model
  comments: Int,
  tags: Int,
  -- @resource end
}

Show.load : Show.Params -> Session -> Query Model
Show.load params session = {
  -- @resource begin load
  -- unscoped: `--read all` shows every user's rows (the writes are the owner's)
  let found <- Db.get Post params.id
  -- unscoped: a row of Comment that refers to it may be another user's
  let comments <-
    Db.from Comment
      |> Db.where (Comment.post.eq params.id)
      |> Db.count
  -- unscoped: a row of Tag that refers to it may be another user's
  let tags <-
    Db.from Tag
      |> Db.where (Tag.post.eq params.id)
      |> Db.count
  match found {
    Just row -> {
      let labels <- labelsOf [row]
      Query.succeed {
        row: row,
        labels: labels,
        comments: comments,
        tags: tags,
      }
    },
    Nothing -> Query.notFound,
  }
  -- @resource end
}

-- @resource begin labels
-- Labels are the rows the references of the rows shown name: their links show their labels.
type Labels = { authors: List User }

-- labelsOf reads the rows that rows refer to.
labelsOf : List Post -> Query Labels
labelsOf rows = {
  -- every user's rows: User has no owner
  let authors <-
    Db.from User
      |> Db.where (User.id.in (List.map (\row -> row.author) rows))
      |> Db.all
  Query.succeed { authors: authors }
}

-- authorLabel is the label of the user id names (the id itself if it names none).
authorLabel : Labels -> User.UserId -> Text
authorLabel labels id = match List.find (\r -> r.id == id) labels.authors {
  Just r -> r.email,
  Nothing -> id,
}
-- @resource end

-- @resource begin blockers
-- blockers counts the rows that keep this one from being deleted, which the database would
-- refuse the delete for: the `@restrict` references to it, or to a row deleted with it.
blockers : Model -> Int
blockers model = model.tags
-- @resource end

Show.view : Model -> Session -> Html
Show.view model session =
  <Layout.Page title="Post">
    <h1>Post</h1>

    <al-card>
      <dl id="fields">
        -- @resource begin fields
        <dt>Id</dt>
        <dd>{model.row.id}</dd>
        <dt>Title</dt>
        <dd>{model.row.title}</dd>
        <dt>Body</dt>
        <dd>{model.row.body}</dd>
        <dt>Status</dt>
        <dd>
          <al-badge>
            {match model.row.status {
              Draft -> "Draft",
              Published -> "Published",
            }}
          </al-badge>
        </dd>
        <dt>Featured</dt>
        <dd>
          {if model.row.featured then
            <al-badge>Yes</al-badge>
          else
            <al-badge variant="secondary">No</al-badge>}
        </dd>
        <dt>Author</dt>
        <dd>{authorLabel model.labels model.row.author}</dd>
        <dt>Created</dt>
        <dd>{Time.format "Jan 2, 2006" model.row.created}</dd>
        <dt>Updated</dt>
        <dd>{Time.format "Jan 2, 2006" model.row.updated}</dd>
        -- @resource end
      </dl>
      -- hiding is not guarding: Save and Destroy require the owner (updateMine, deleteMine)
      {if session.user == Just model.row.author then
        <div slot="actions">
          <al-button href={Posts.Edit.Edit { id: model.row.id }}>Edit</al-button>
          <al-button variant="destructive">
            <button type="button" commandfor="delete-dialog" command="show-modal">Delete</button>
          </al-button>
        </div>
      else
        Html.none}
    </al-card>
    -- hiding is not guarding: Save and Destroy require the owner (updateMine, deleteMine)
    {if session.user == Just model.row.author then
      <al-dialog id="delete-dialog" heading="Delete this post?" dismissible>
        <dl>
          -- @resource begin counts
          <dt>Comments deleted with it</dt>
          <dd id="comments">{Text.fromInt model.comments}</dd>
          <dt>Tags that keep it from being deleted</dt>
          <dd id="tags">{Text.fromInt model.tags}</dd>
          -- @resource end
        </dl>
        <form id="delete" submit={Posts.Delete.Destroy { id: model.row.id }}>
          <al-alert variant="destructive"><Errors form /></al-alert>
          {if blockers model > 0 then
            <p>It cannot be deleted while other rows refer to it.</p>
          else
            <al-button variant="destructive" type="submit">Delete</al-button>}
        </form>
        <div slot="actions">
          <a href={Posts.Delete.Delete { id: model.row.id }}>See the details</a>
        </div>
      </al-dialog>
    else
      Html.none}
    <a href={Posts.Index.Index {}}>All posts</a>
  </Layout.Page>

-- @resource begin tests
test "the page shows the row" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let r <- Test.open (Show { id: post1 })
  let page <- Test.get (Show { id: post1 })
  Task.succeed (
    {
      answer: r.answer,
      title: List.member "title-1" (Test.texts "#fields dd" r.doc),
      authors: List.length page.model.labels.authors,
      authorLabel: authorLabel page.model.labels me,
    } == {
      answer: Shown,
      title: True,
      authors: 1,
      authorLabel: "email-1@example.com",
    }
  )
}

test "deleting a post nothing refers to" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let _ <- Db.insert Comment {
    post: post2,
    author: me,
    body: Text.NonEmpty "body-1",
  }
  let _ <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post2 }
  let page <- Test.get (Show { id: post1 })
  let r <- Test.submit (Posts.Delete.Destroy { id: post1 }) {}
  let gone <- Db.get Post post1
  let kept <- Db.get Post post2
  Task.succeed (
    {
      button: Test.count "#delete al-button" page.doc,
      answer: r.answer,
      notices: r.notices,
      gone: Maybe.map (\row -> row.id) gone,
      kept: Maybe.map (\row -> row.id) kept,
    } == {
      button: 1,
      answer: Redirected (Posts.Index.Index {}),
      notices: ["Deleted"],
      gone: Nothing,
      kept: Just post2,
    }
  )
}

test "the page counts the rows that go with it" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let _ <- Db.insert Comment {
    post: post1,
    author: me,
    body: Text.NonEmpty "body-1",
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let _ <- Db.insert Comment {
    post: post2,
    author: me,
    body: Text.NonEmpty "body-2",
  }
  let page <- Test.get (Show { id: post1 })
  Task.succeed ({ comments: Test.text "#comments" page.doc } == { comments: Just "1" })
}

test "a post that tags refer to is not deleted" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let _ <- Db.insert Tag { name: Text.NonEmpty "name-1", post: post1 }
  let page <- Test.get (Show { id: post1 })
  let r <- Test.submit (Posts.Delete.Destroy { id: post1 }) {}
  let kept <- Db.get Post post1
  Task.succeed (
    {
      count: Test.text "#tags" page.doc,
      buttons: Test.count "#delete button" page.doc,
      answer: r.answer,
      kept: Maybe.map (\row -> row.id) kept,
    } == {
      count: Just "1",
      buttons: 0,
      answer: FormRejected [
        { field: "", message: "This post cannot be deleted while other rows refer to it." },
      ],
      kept: Just post1,
    }
  )
}

test "a missing row is not found" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let r <- Test.open (Show { id: Post.PostId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "shows another user's row without Edit or Delete" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let other <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: other,
  }
  let r <- Test.open (Show { id: post1 })
  Task.succeed (
    {
      answer: r.answer,
      buttons: Test.texts "al-card al-button" r.doc,
      dialog: Test.count "#delete-dialog" r.doc,
    } == {
      answer: Shown,
      buttons: [],
      dialog: 0,
    }
  )
}

test "shows my row with Edit and Delete" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let _ <- Test.login { user: Just me }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let r <- Test.open (Show { id: post1 })
  Task.succeed (
    {
      answer: r.answer,
      buttons: Test.texts "al-card al-button" r.doc,
      dialog: Test.count "#delete-dialog" r.doc,
    } == {
      answer: Shown,
      buttons: ["Edit", "Delete"],
      dialog: 1,
    }
  )
}

test "a visitor sees the row" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let r <- Test.open (Show { id: post1 })
  Task.succeed (
    { answer: r.answer, fields: Test.count "#fields dd" r.doc } == { answer: Shown, fields: 8 }
  )
}

test "a visitor sees no New, Edit or Delete" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1" }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let r <- Test.open (Show { id: post1 })
  Task.succeed (
    {
      answer: r.answer,
      buttons: Test.texts "al-card al-button" r.doc,
      dialog: Test.count "#delete-dialog" r.doc,
    } == {
      answer: Shown,
      buttons: [],
      dialog: 0,
    }
  )
}
-- @resource end
