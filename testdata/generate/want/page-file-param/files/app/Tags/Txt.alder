module Tags.Txt

page "/tags/{name}" { name: Text }

type Model = { }

load : Params -> Session -> Query Model
load params session = ?load

view : Model -> Session -> File
view model session = File.text { contentType: "text/plain", body: ?body }

test "the file is served" = {
  let r <- Test.fetch (Tags.Txt { name: "name-1" })
  Task.succeed (r.status == 200)
}
