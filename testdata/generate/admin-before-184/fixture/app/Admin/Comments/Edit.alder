-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Comments.Edit

-- @admin begin imports
import Admin.Layout
import Table.Comment
import Table.Post
import Table.User
-- @admin end

-- @admin begin routes
route Edit         = GET  "/admin/comment/{id}/edit"                { id: Comment.CommentId, findPost: Text = "", findAuthor: Text = "" } requires user, role Admin
route Save         = PUT  "/admin/comment/{id}/edit/_/Save"         { id: Comment.CommentId } form CommentForm                            requires user, role Admin
route SearchPost   = POST "/admin/comment/{id}/edit/_/SearchPost"   { id: Comment.CommentId } form FindPost                               requires user, role Admin
route SearchAuthor = POST "/admin/comment/{id}/edit/_/SearchAuthor" { id: Comment.CommentId } form FindAuthor                             requires user, role Admin
-- @admin end

type Model = {
  row: Comment,
  -- @admin begin model
  posts: List Post,
  postsTotal: Int,
  authors: List User,
  authorsTotal: Int,
  -- @admin end
}

Edit.load : Edit.Params -> Session -> Query Model
Edit.load params session = {
  let _ <- Layout.adminOnly session.user
  -- @admin begin load
  let found <- Db.get Comment params.id
  match found {
    Just row -> {
      let findPost = Text.slice 0 200 params.findPost
      let postsTotal <- Db.from Post |> Db.count
      let postsOwn <-
        if postsTotal > 200 then
          Db.from Post
            |> Db.where (Post.id.eq row.post)
            |> Db.all
        else
          Query.succeed []
      let postsFound <-
        Db.from Post
          |> Db.orderBy Post.title.asc
          |> Db.where (
            if postsTotal > 200 then
              Db.and [Post.title.contains findPost, Post.id.ne row.post]
            else
              Db.and []
          )
          |> Db.limit (if postsTotal > 200 then 50 else 200)
          |> Db.all
      let posts = postsOwn ++ postsFound
      let findAuthor = Text.slice 0 200 params.findAuthor
      let authorsTotal <- Db.from User |> Db.count
      let authorsOwn <-
        if authorsTotal > 200 then
          Db.from User
            |> Db.where (User.id.eq row.author)
            |> Db.all
        else
          Query.succeed []
      let authorsFound <-
        Db.from User
          |> Db.orderBy User.email.asc
          |> Db.where (
            if authorsTotal > 200 then
              Db.and [User.email.contains findAuthor, User.id.ne row.author]
            else
              Db.and []
          )
          |> Db.limit (if authorsTotal > 200 then 50 else 200)
          |> Db.all
      let authors = authorsOwn ++ authorsFound
      Query.succeed {
        row: row,
        posts: posts,
        postsTotal: postsTotal,
        authors: authors,
        authorsTotal: authorsTotal,
      }
    },
    Nothing -> Query.notFound,
  }
  -- @admin end
}

-- @admin begin form
form CommentForm = {
  post: Post.PostId,
  author: User.UserId,
  body: Text.NonEmpty,
}
-- @admin end

-- @admin begin search
form FindPost = { q: Text }

-- SearchPost answers the page again at the text.
SearchPost.update : SearchPost.Params -> Session -> Task Response
SearchPost.update params session =
  Task.succeed (
    Response.redirect (Edit { id: params.id, findPost: Text.slice 0 200 params.form.q })
  )

form FindAuthor = { q: Text }

-- SearchAuthor answers the page again at the text.
SearchAuthor.update : SearchAuthor.Params -> Session -> Task Response
SearchAuthor.update params session =
  Task.succeed (
    Response.redirect (Edit { id: params.id, findAuthor: Text.slice 0 200 params.form.q })
  )

-- @admin end

-- Save writes the form over the row (a row deleted since is not found) and goes to its page.
Save.update : Save.Params -> Session -> Task Response
Save.update params session = {
  let _ <- Layout.adminOnly session.user
  let found <- Db.get Comment params.id
  match found {
    Just row -> {
      -- @admin begin update
      let _ <- Db.update Comment row.id (\r -> { r |
        post: params.form.post,
        author: params.form.author,
        body: params.form.body
      })
      Task.succeed (Response.redirect (Admin.Comments.Show.Show { id: row.id }))
      -- @admin end
    },
    Nothing -> Task.notFound,
  }
}

Edit.view : Model -> Session -> Html
Edit.view model session =
  <Layout.Page title="Edit comment">
    <h1>Edit comment</h1>

    <al-card>
      -- @admin begin finder
      {if model.postsTotal > 200 then
        <form submit={SearchPost { id: model.row.id }}>
          <al-input field="q" label="Find post" />
          <al-button type="submit" variant="secondary">Find</al-button>
        </form>
      else
        Html.none}
      {if model.authorsTotal > 200 then
        <form submit={SearchAuthor { id: model.row.id }}>
          <al-input field="q" label="Find author" />
          <al-button type="submit" variant="secondary">Find</al-button>
        </form>
      else
        Html.none}
      -- @admin end
      <form submit={Save { id: model.row.id }}>
        -- @admin begin inputs
        <al-select
          field="post"
          label="Post"
          options={List.map (\r -> { value: r.id, label: r.title }) model.posts}
          value={model.row.post} />
        <al-select
          field="author"
          label="Author"
          options={List.map (\r -> { value: r.id, label: r.email }) model.authors}
          value={model.row.author} />
        <al-textarea field="body" label="Body" value={model.row.body} />
        -- @admin end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Save</al-button>
      </form>
    </al-card>
    <a href={Admin.Comments.Show.Show { id: model.row.id }}>Back</a>
  </Layout.Page>

-- @admin begin tests
test "saving changes every field" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let comment1 <- Db.insert Comment {
    post: post1,
    author: me,
    body: Text.NonEmpty "body-1",
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let page <- Test.get (Edit { id: comment1 })
  let r <- Test.submit (Save { id: comment1 }) {
    post: post2,
    author: user2,
    body: Text.NonEmpty "body-2",
  }
  let after <- Db.get Comment comment1
  Task.succeed (
    {
      answer: r.answer,
      row: Maybe.map (\row -> {
        post: row.post,
        author: row.author,
        body: row.body,
      }) after,
      posts: Test.texts "select[name=post] option" page.doc,
      authors: Test.texts "select[name=author] option" page.doc,
    } == {
      answer: Redirected (Admin.Comments.Show.Show { id: comment1 }),
      row: Just {
        post: post2,
        author: user2,
        body: Text.NonEmpty "body-2",
      },
      posts: ["title-1", "title-2"],
      authors: ["email-1@example.com", "email-2@example.com"],
    }
  )
}

test "a post not offered is refused" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let comment1 <- Db.insert Comment {
    post: post1,
    author: me,
    body: Text.NonEmpty "body-1",
  }
  let post2 <- Db.insert Post {
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
  }
  let page <- Test.get (Edit { id: comment1 })
  let authorId = Maybe.withDefault "" (Test.attr "value" "select[name=author] option" page.doc)
  let r <- Test.submitRaw (Save { id: comment1 }) [
    { name: "post", value: "missing" },
    { name: "author", value: authorId },
    { name: "body", value: "x" },
  ]
  let after <- Db.get Comment comment1
  Task.succeed (
    { answer: r.answer, post: Maybe.map (\row -> row.post) after }
      == {
        answer: FormRejected [{ field: "post", message: "must be one of the options" }],
        post: Just post1,
      }
  )
}

