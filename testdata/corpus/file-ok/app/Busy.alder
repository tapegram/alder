module Busy

route Busy = GET "/busy" { }

type Model = { }

Busy.load : Busy.Params -> Session -> Query Model
Busy.load params session = Query.succeed {}

Busy.view : Model -> Session -> File
Busy.view model session =
  File.text { contentType: "text/plain", body: "busy" }
    |> File.withStatus 503
    |> File.withHeader { name: "Retry-After", value: "20" }

-- A 503 the page answers is its own file, not the maintenance page.
test "busy is a 503 with its own body" = {
  let r <- Test.fetch (Busy {})
  Task.succeed (
    r.status == 503
      && Bytes.toText r.body == Just "busy"
      && List.member { name: "Retry-After", value: "20" } r.headers
  )
}
