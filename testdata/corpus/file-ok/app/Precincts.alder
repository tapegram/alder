module Precincts

import Results

-- An HTML page that links to a file page: the link reloads the document (no Datastar morph).
page "/" { }

type Model = { }

load : Params -> Session -> Query Model
load params session = Query.succeed { }

view : Model -> Session -> Html Msg
view model session = <html><body><a href={Results {}}>results</a></body></html>

test "the precincts page links to the results file" = {
  let r <- Test.get (Precincts {})
  Task.succeed (Test.attr "href" "a" r.doc == Just "/results/allracesbyprecinct.txt")
}
