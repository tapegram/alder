module Turnout

page "/lvt" { }

type Model = { }

load : Params -> Session -> Query Model
load params session = Query.succeed { }

-- A copy of another site's page, byte for byte: File.html adds no doctype, so the page writes it.
view : Model -> Session -> File
view model session = File.html (Html.unsafe "<!doctype html>\n<html><body><p id=\"n\">42</p></body></html>")

test "turnout is byte-exact html" = {
  let r <- Test.fetch (Turnout {})
  Task.succeed (Bytes.toText r.body == Just "<!doctype html>\n<html><body><p id=\"n\">42</p></body></html>")
}
