module Turnout

route Turnout = GET "/lvt" { }

type Model = { }

Turnout.load : Turnout.Params -> Session -> Query Model
Turnout.load params session = Query.succeed {}

-- A copy of another site's page, byte for byte, in checked markup: File.html adds no doctype,
-- so the page writes one before <html>.
Turnout.view : Model -> Session -> File
Turnout.view model session =
  File.html (Html.fragment [
    Html.unsafe "<!doctype html>\n",
    <html><body><p id="n">42</p></body></html>,
  ])

test "turnout is byte-exact html" = {
  let r <- Test.fetch (Turnout {})
  Task.succeed (
    r.contentType == "text/html; charset=utf-8"
      && Bytes.toText r.body == Just "<!doctype html>\n<html><body><p id=\"n\">42</p></body></html>"
  )
}
