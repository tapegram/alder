module Results

route Results = GET "/results/allracesbyprecinct.txt" { }

type Model = { }

Results.load : Results.Params -> Session -> Query Model
Results.load params session = Query.succeed {}

Results.view : Model -> Session -> File
Results.view model session = File.text { contentType: "text/plain", body: "MN;1;Senate\n" }

test "results is text/plain" = {
  let r <- Test.fetch (Results {})
  Task.succeed (
    {
      status: r.status,
      type: r.contentType,
      body: Bytes.toText r.body,
    } == {
      status: 200,
      type: "text/plain",
      body: Just "MN;1;Senate\n",
    }
  )
}
