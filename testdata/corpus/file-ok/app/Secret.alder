module Secret

route Secret = GET "/secret.txt" { } requires user

type Model = { }

Secret.load : Secret.Params -> Session -> Query Model
Secret.load params session = Query.succeed {}

Secret.view : Model -> Session -> File
Secret.view model session = File.text { contentType: "text/plain", body: "secret" }

-- The `requires` redirect is answered raw: Test.fetch does not follow it.
test "fetch while logged out is 303" = {
  let r <- Test.fetch (Secret {})
  Task.succeed (r.status == 303 && List.any (\h -> h.name == "Location") r.headers)
}
