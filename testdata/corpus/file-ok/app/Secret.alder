module Secret

page "/secret.txt" { } requires user

type Model = { }

load : Params -> Session -> Query Model
load params session = Query.succeed { }

view : Model -> Session -> File
view model session = File.text { contentType: "text/plain", body: "secret" }

-- The `requires` redirect is answered raw: Test.fetch does not follow it.
test "fetch while logged out is 303" = {
  let r <- Test.fetch (Secret {})
  Task.succeed (r.status == 303 && List.any (\h -> h.name == "Location") r.headers)
}
