module Things.List

route Browse = GET "/things" { q: Text = "", page: Int = 1 }

type Model = { params: Browse.Params }

Browse.load : Browse.Params -> Session -> Query Model
Browse.load params session = Query.succeed { params: params }

Browse.view : Model -> Session -> Html
Browse.view model session = <main><p>{model.params.q}</p></main>
