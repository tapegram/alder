module Todos.Index

page "/" { }

type Model = { n: Int }

load : Params -> Session -> Query Model
load params session = Query.succeed { n: 0 }

form NewTodo = {
  title: Text,
}

msg Submit form NewTodo
msg Toggle { id: Text }

update : Msg -> Model -> Session -> Task Nav
update msg model session = Task.succeed Rerender

view : Model -> Session -> Html Msg
view model session =
  <form submit={Submit}>
    <Errors form />
    <Input field="title" label="Title" />
    <button click={Toggle { id: "a" }}>Toggle</button>
  </form>

test "a field without a default is still required" = {
  let _ <- Test.login { visits: 1 }
  Task.succeed True
}
