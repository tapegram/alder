module Todos.Index

route Index  = GET  "/"         { }
route Submit = POST "/" { } form NewTodo
route Toggle = PUT "/todos/{id}/done" { id: Text }

type Model = { n: Int }

Index.load : Index.Params -> Session -> Query Model
Index.load params session = Query.succeed { n: 0 }

form NewTodo = { title: Text }

Submit.update : Submit.Params -> Session -> Task Response
Submit.update params session = Task.succeed Response.refresh

Toggle.update : Toggle.Params -> Session -> Task Response
Toggle.update params session = Task.succeed Response.refresh

Index.view : Model -> Session -> Html
Index.view model session =
  <form submit={Submit}>
    <Errors form />
    <Input field="title" label="Title" />
    <button click={Toggle { id: "a" }}>Toggle</button>
  </form>

test "a field without a default is still required" = {
  let _ <- Test.login { visits: 1 }
  Task.succeed True
}
