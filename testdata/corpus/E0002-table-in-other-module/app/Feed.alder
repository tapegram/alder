module Feed

import Post

route Feed = GET "/feed" { }

type Model = { count: Int, last: Maybe Comment }

Feed.load : Feed.Params -> Session -> Query Model
Feed.load params session = {
  let comments <-
    Db.from Comment
      |> Db.where (Comment.post.eq (Post.PostId "a"))
      |> Db.all
  Query.succeed { count: List.length comments, last: Nothing }
}

Feed.view : Model -> Session -> Html
Feed.view model session = <p>{Text.fromInt model.count}</p>
