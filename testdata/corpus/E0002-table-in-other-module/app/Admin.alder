module Admin

import Post
import Post.Comment

route Admin = GET "/admin" { }

type Model = { count: Int }

Admin.load : Admin.Params -> Session -> Query Model
Admin.load params session = {
  let comments <-
    Db.from Post.Comment
      |> Db.where (Post.Comment.body.eq "spam")
      |> Db.all
  Query.succeed { count: List.length comments }
}

Admin.view : Model -> Session -> Html
Admin.view model session = <p>{Text.fromInt model.count}</p>
