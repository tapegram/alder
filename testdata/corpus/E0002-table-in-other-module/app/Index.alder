module Index

import Post

route Index = GET "/" { }

type Model = { comments: List Post.Comment }

Index.load : Index.Params -> Session -> Query Model
Index.load params session = {
  let comments <-
    Db.from Post.Comment
      |> Db.where (Post.Comment.post.eq (Post.PostId "a"))
      |> Db.all
  Query.succeed { comments: comments }
}

Index.view : Model -> Session -> Html
Index.view model session = <p>{Text.fromInt (List.length model.comments)}</p>
