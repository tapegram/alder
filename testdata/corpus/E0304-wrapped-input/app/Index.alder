module Index

route Index  = GET  "/"         { }
route Submit = POST "/" { } form NewPost

type Kind = Note | Task

type Model = { n: Int }

Index.load : Index.Params -> Session -> Query Model
Index.load params session = Query.succeed { n: 1 }

form NewPost = { title: Text.NonEmpty, kind: Kind }

Submit.update : Submit.Params -> Session -> Task Response
Submit.update p session = Task.succeed Response.refresh

Index.view : Model -> Session -> Html
Index.view model session =
  <main>
    <al-input field="title" label="Outside" />
    <form submit={Submit}>
      <al-input field="nope" label="Title" />
      <al-input field="kind" />
      <al-select field="title" />
      <al-checkbox field="title" />
      <al-textarea label="Body" />
      <al-input field="title" form />
      <al-input field="title" value={3} />
      <al-input field="title"><b>x</b></al-input>
    </form>
  </main>
