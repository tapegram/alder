module Todos.Index

page "/" { }

type Model = { n: Int }

load : Params -> Session -> Query Model
load params session = Query.succeed { n: 0 }

form NewTodo = {
  title: Text,
}

msg Submit form NewTodo
msg Rename form NewTodo
msg Toggle { id: Text }

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  Submit p -> if p.form.title == "x" then Task.succeed (Reject "No x, please.") else Task.succeed Rerender,
  Rename p -> Task.succeed Rerender,
  Toggle p -> Task.succeed Rerender,
}

-- Submit can answer Reject, and its form has no <Errors form />: the warning. Rename's form has
-- none either, but Rename never rejects; the third form shows the text.
view : Model -> Session -> Html Msg
view model session =
  <div>
    <form submit={Submit}>
      <Input field="title" label="Title" />
      <Errors field="title" />
    </form>
    <form submit={Rename}>
      <Input field="title" label="Title" />
      <Errors field="title" />
    </form>
    <form submit={Submit}>
      <Errors form />
      <Input field="title" label="Title" />
    </form>
  </div>
