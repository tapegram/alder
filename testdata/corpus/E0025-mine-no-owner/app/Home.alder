module Home

import Todo

route Home = GET "/" { id: Todo.TodoId } requires user

type Model = { todos: List Todo }

Home.load : Home.Params -> Session -> Query Model
Home.load params session = {
  let todos <- Db.mine Todo |> Db.all
  let _ <- Db.getMine Todo params.id
  Query.succeed { todos: todos }
}

Home.view : Model -> Session -> Html
Home.view model session = <p>todos</p>
