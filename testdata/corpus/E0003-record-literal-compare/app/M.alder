module M

type Curve = { median: Float, sigma: Float, perDoubling: Float }

reportTime : Curve -> Float -> Float
reportTime c t = c.median + c.sigma * t + c.perDoubling

same : Curve -> Bool
same c = c == { median: 1, sigma: 2.0, perDoubling: 0.5 }

listed : List Curve -> Bool
listed cs = cs == [{ median: 1.0, sigma: 2.0 }]
