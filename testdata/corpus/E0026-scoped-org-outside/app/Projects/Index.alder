module Projects.Index

import Project

route Index = GET "/projects" { } requires user, org

type Model = { projects: List Project }

Index.load : Index.Params -> Session -> Query Model
Index.load params session = {
  let projects <- recent |> Db.all
  Query.succeed { projects: projects }
}

recent : Select Project
recent = Db.scoped Project |> Db.limit 10

Index.view : Model -> Session -> Html
Index.view model session = <p>x</p>
