module Public

import Project
import Projects.Index

page "/public" { } requires user

type Model = { projects: List Project, n: Int }

load : Params -> Session -> Query Model
load params session = {
  let projects <- Projects.Index.recent |> Db.all
  let n <- Db.scoped Project |> Db.count
  Query.succeed { projects: projects, n: n }
}

view : Model -> Session -> Html Msg
view model session = <p>x</p>
