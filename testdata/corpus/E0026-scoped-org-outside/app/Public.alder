module Public

import Project
import Projects.Index

route Public = GET "/public" { } requires user

type Model = { projects: List Project, n: Int }

Public.load : Public.Params -> Session -> Query Model
Public.load params session = {
  let projects <- Index.recent |> Db.all
  let n <- Db.scoped Project |> Db.count
  Query.succeed { projects: projects, n: n }
}

Public.view : Model -> Session -> Html
Public.view model session = <p>x</p>
