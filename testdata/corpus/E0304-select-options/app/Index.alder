module Index

route Index  = GET  "/"         { }
route Submit = POST "/_/Submit" { } form NewPost

type Kind = Note | Task

type OwnerId = brand Text

type Model = { owners: List { value: OwnerId, label: Text } }

Index.load : Index.Params -> Session -> Query Model
Index.load params session = Query.succeed { owners: [] }

form NewPost = {
  title: Text.NonEmpty,
  kind: Kind,
  count: Int,
  owner: OwnerId,
  reviewer: Maybe OwnerId,
}

Submit.update : Submit.Params -> Session -> Task Response
Submit.update p session = Task.succeed Response.refresh

Picker : { owners: List { value: OwnerId, label: Text } } -> Html
Picker props = <form submit={Submit}><al-select field="owner" options={props.owners} /></form>

Index.view : Model -> Session -> Html
Index.view model session =
  <main>
    <form submit={Submit}>
      <al-select field="owner" label="Owner" options={model.owners} />
      <Select field="reviewer" label="Reviewer" options={model.owners} />
      <al-select field="owner" />
      <al-input field="title" options={model.owners} />
      <al-select field="kind" options={model.owners} />
      <al-select field="count" options={[{ value: 1, label: "one" }]} />
      <al-select field="title" options={[{ value: "a", label: 1 }]} />
      <al-select field="owner" options={[{ value: "a", label: "A" }]} />
      {for owners in [model.owners] ->
        <al-select
          field="owner"
          options={List.map (\o -> { value: o.value, label: o.label }) owners} />}
    </form>
  </main>
