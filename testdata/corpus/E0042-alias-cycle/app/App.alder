module App

error : Error -> Html Never
error err = <h1>Something went wrong</h1>

notFound : Html Never
notFound = <h1>Not found</h1>

theme {
  dark: {
    ring: "var(--primary)",
    primary: "var(--accent)",
    accent: "var(--ring)",
    border: "var(--ring)",
  },
  light: { ring: "var(--primary)", primary: "var(--accent)" },
}
