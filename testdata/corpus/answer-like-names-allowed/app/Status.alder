module Status

-- Failed, Rejected and Missing are ordinary domain words: only the Prelude test type's own
-- constructors (Shown, Rerendered, Redirected, FormRejected, PageMissing, RequestFailed) are reserved.
type Status = Pending | Failed | Rejected | Missing

label : Status -> Text
label s = match s {
  Pending -> "pending",
  Failed -> "failed",
  Rejected -> "rejected",
  Missing -> "missing",
}
