module App

import User
import Org

-- `choose` names a GET route that does not require the key itself.
session { user: Maybe User.UserId, org: Maybe Org.OrgId via Membership, team: Maybe Text }

login = Login

choose org = Orgs.Leave
choose team = Orgs.Team

silo org { Project }

error : Error -> Html Never
error err = <html><body><h1>error</h1></body></html>

notFound : Html Never
notFound = <html><body><h1>not found</h1></body></html>
