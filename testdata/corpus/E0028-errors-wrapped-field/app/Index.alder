module Index

page "/" { }

type Theme = Light | Dark

type Model = { n: Int }

load : Params -> Session -> Query Model
load params session = Query.succeed { n: 1 }

form Prefs = {
  theme: Theme,
  name: Text,
}

msg Save form Prefs

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  Save p -> Task.succeed Rerender,
}

view : Model -> Session -> Html Msg
view model session =
  <form submit={Save}>
    <Errors field="theme" />
    <al-select field="theme" label="Theme" />
    <Input field="name" />
    <Errors field="name" />
  </form>
