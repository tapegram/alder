module Index

route Index = GET  "/"       { }
route Save  = POST "/" { } form Prefs

type Theme = Light | Dark

type Model = { n: Int }

Index.load : Index.Params -> Session -> Query Model
Index.load params session = Query.succeed { n: 1 }

form Prefs = { theme: Theme, name: Text }

Save.update : Save.Params -> Session -> Task Response
Save.update p session = Task.succeed Response.refresh

Index.view : Model -> Session -> Html
Index.view model session =
  <form submit={Save}>
    <Errors field="theme" />
    <al-select field="theme" label="Theme" />
    <Input field="name" />
    <Errors field="name" />
  </form>
