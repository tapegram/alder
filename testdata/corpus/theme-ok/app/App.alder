module App

error : Error -> Html Never
error err = <h1>Something went wrong</h1>

notFound : Html Never
notFound = <h1>Not found</h1>

theme {
  radius: "0.5rem",
  radiusXl: "0",
  widthWide: "90%",
  fontSans: ["Inter", "system-ui", "sans-serif"],
  fontMono: ["Geist Mono", "monospace"],
  shadowSm: "0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1)",
  shadowLg: "none",
  light: {
    primary: "oklch(0.55 0.22 285)",
    primaryForeground: "#ffffff",
    ring: "var(--primary)",
    chart1: "hsl(12 76% 61%)",
    border: "color-mix(in oklab, var(--foreground) 20%, transparent)",
    input: " oklch(0.65 0 0) ",
  },
  dark: {
    primary: "oklch(0.72 0.16 285)",
    primaryForeground: "oklch(0.145 0 0)",
    sidebarRing: "currentColor",
  },
}
