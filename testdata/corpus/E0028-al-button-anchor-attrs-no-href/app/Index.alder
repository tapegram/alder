module Index

route Index = GET  "/"     { }
route Go    = POST "/" { }

type Model = { n: Int }

Index.load : Index.Params -> Session -> Query Model
Index.load params session = Query.succeed { n: 1 }

Go.update : Go.Params -> Session -> Task Response
Go.update p session = Task.succeed Response.refresh

Index.view : Model -> Session -> Html
Index.view model session =
  <main>
    <al-button variant="outline" target="_blank" data-alder-reload="true">Presentational</al-button>
    <al-button click={Go} rel="next">Click</al-button>
    <al-button><a href={Index {}} target="_blank" rel="next">Own</a></al-button>
    <al-dialog id="d" target="_blank">No</al-dialog>
  </main>
