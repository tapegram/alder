module Index

page "/" { }

type Model = { n: Int }

load : Params -> Session -> Query Model
load params session = Query.succeed { n: 1 }

msg Go

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  Go p -> Task.succeed Rerender,
}

view : Model -> Session -> Html Msg
view model session =
  <main>
    <al-button variant="outline" target="_blank" data-alder-reload="true">Presentational</al-button>
    <al-button click={Go} rel="next">Click</al-button>
    <al-button><a href={Index {}} target="_blank" rel="next">Own</a></al-button>
  </main>
