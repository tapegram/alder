module Todos

route Index  = GET   "/"                  { }
route Row    = GET   "/todos/{id}"        { id: Text }
route Toggle = PATCH "/todos/{id}/toggle" { id: Text }
route Rename = POST  "/todos/{id}/rename" { id: Text } form Title

form Title = { title: Text }

Index.load : Index.Params -> Session -> Query Int
Index.load params session = Query.succeed 1

Index.view : Int -> Session -> Html
Index.view n session = <p>{Text.fromInt n}</p>

Row.load : Row.Params -> Session -> Query Text
Row.load params session = Query.succeed params.id

Row.view : Text -> Session -> Html
Row.view id session = <p>{id}</p>

Toggle.update : Toggle.Params -> Session -> Task Response
Toggle.update params session = Task.succeed Response.refresh

Rename.update : Rename.Params -> Session -> Task Response
Rename.update params session = Task.succeed Response.refresh

-- a test step names a route with its parameters too
test "steps with bare routes" = {
  let _ <- Test.get Row
  let _ <- Test.click Toggle
  let r <- Test.submit Rename { title: "x" }
  Task.succeed True
}
