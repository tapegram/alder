module Todos

route Index = GET "/"      { }
route More  = GET "/more"  { after: Int }

-- `every` repeats a `load`; it does not go with `intersect`, or alone
Index.load : Index.Params -> Session -> Query Int
Index.load params session = Query.succeed 1

Index.view : Int -> Session -> Html
Index.view n session =
  <div>
    <div intersect={More { after: n }} every="5s"></div>
    <p every="5s">alone</p>
  </div>

More.load : More.Params -> Session -> Query Int
More.load params session = Query.succeed params.after

More.view : Int -> Session -> Html
More.view n session = <p id="more">{Text.fromInt n}</p>
