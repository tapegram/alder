module Projects

import AuditLog
import Project

route Projects = GET  "/projects"          { } requires user, org
route Create   = POST "/projects/_/Create" { } requires user, org

type Model = { }

Projects.load : Projects.Params -> Session -> Query Model
Projects.load params session = Query.succeed {}

Create.update : Create.Params -> Session -> Task Response
Create.update params session = {
  let _ <- Db.insertScoped Project { name: "p" }
  let _ <- Db.insert AuditLog { text: "created" }
  Task.succeed Response.refresh
}

Projects.view : Model -> Session -> Html
Projects.view model session = <p>x</p>
