module Todos

import Todo

route Index = GET "/todos" { } requires user

type Model = { todos: List Todo }

-- a route module's helper still under W0014 (no clause): its callers see what it needs
recent : Select Todo
recent = Db.mine Todo |> Db.limit 10

Index.load : Index.Params -> Session -> Query Model
Index.load params session = {
  let todos <- recent |> Db.all
  Query.succeed { todos: todos }
}

Index.view : Model -> Session -> Html
Index.view model session = <p>todos</p>
