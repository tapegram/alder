module Profile

import User

route Profile = GET "/users/{id}" { id: User.UserId }

type Model = { name: Text }

Profile.load : Profile.Params -> Session -> Query Model
Profile.load params session = {
  let user <- Db.get User params.id
  Query.succeed { name: user.name }
}

Profile.view : Model -> Session -> Html
Profile.view model session = <h1>{model.name}</h1>
