module Home

import Todo

page "/" { } requires user

capability Counter {
  count : Unit -> Task Int,
}

fake Counter {
  count u = Task.succeed (List.length [Db.mine Todo])
}

type Model = { }

load : Params -> Session -> Query Model
load params session = Query.succeed { }

view : Model -> Session -> Html Msg
view model session = <p>home</p>
