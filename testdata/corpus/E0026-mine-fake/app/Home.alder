module Home

import Todo

route Home = GET "/" { } requires user

capability Counter {
  count : Unit -> Task Int,
}

fake Counter {
  count u = Task.succeed (List.length [Db.mine Todo])
}

type Model = { }

Home.load : Home.Params -> Session -> Query Model
Home.load params session = Query.succeed {}

Home.view : Model -> Session -> Html
Home.view model session = <p>home</p>
