module Todos

route Index  = GET "/"        { }
route Search = GET "/search"  { q: Text = "" }

-- a form's `submit` posts to a write route: a GET route is linked to
Index.load : Index.Params -> Session -> Query Int
Index.load params session = Query.succeed 1

Index.view : Int -> Session -> Html
Index.view n session = <form submit={Search { q: "milk" }}><button>Search</button></form>

Search.load : Search.Params -> Session -> Query Int
Search.load params session = Query.succeed 2

Search.view : Int -> Session -> Html
Search.view n session = <p>{Text.fromInt n}</p>
