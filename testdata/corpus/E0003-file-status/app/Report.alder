module Report

route Report = GET "/report.txt" { }

type Model = { }

Report.load : Report.Params -> Session -> Query Model
Report.load params session = Query.succeed {}

Report.view : Model -> Session -> File
Report.view model session =
  File.text { contentType: "text/plain", body: "hi" }
    |> File.withStatus 42
    |> File.withStatus 503
