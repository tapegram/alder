module Todos

route Index = GET  "/"         { }
route Row   = GET  "/row/{id}" { id: Int }
route Poke  = POST "/poke"     { }
route Prod  = POST "/prod"     { }
route Nudge = POST "/nudge"    { }

Index.load : Index.Params -> Session -> Query Int
Index.load params session = Query.succeed 1

Index.view : Int -> Session -> Html
Index.view n session = <p id="n">{Text.fromInt n}</p>

Row.load : Row.Params -> Session -> Query Int
Row.load params session = Query.succeed params.id

Row.view : Int -> Session -> Html
Row.view n session = <p id={"row-" ++ Text.fromInt n}>{Text.fromInt n}</p>

-- `Response.render` still works for one release, with a warning carrying the rewrite
Poke.post : Poke.Params -> Session -> Task Response
Poke.post params session = Task.succeed (Response.render Index)

Prod.post : Prod.Params -> Session -> Task Response
Prod.post params session = Task.succeed (Response.render (Row { id: 1 }) |> Response.remove "row-2")

Nudge.post : Nudge.Params -> Session -> Task Response
Nudge.post params session = Task.succeed (Row { id: 1 } |> Response.render)
