module Todos

route Index = GET  "/"           { }
route Clear = POST "/todos/clear" { }

Index.load : Index.Params -> Session -> Query Int
Index.load params session = Query.succeed 1

Index.view : Int -> Session -> Html
Index.view n session = <button click={Clear}>Clear</button>

Clear.update : Clear.Params -> Session -> Task Response
Clear.update params session = Task.succeed Response.refresh

-- the old answers: `Nav` and its constructors are gone
again : Task Nav
again = Task.succeed Rerender

home : Nav
home = Redirect (Index {})

refuse : Nav
refuse = Reject "no"
