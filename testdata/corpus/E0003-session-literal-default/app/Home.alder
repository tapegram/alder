module Home

import Theme

route Home = GET "/" { } requires user

type Model = { n: Int }

Home.load : Home.Params -> Session -> Query Model
Home.load params session = Query.succeed { n: 0 }

Home.view : Model -> Session -> Html
Home.view model session = <p>{session.user}</p>

-- the page's narrowed Session: the same rule
test "the view shows the user" = Home.view { n: 0 } { user: "ann" } == <p>ann</p>

-- every field named: fine
test "with the theme" = Home.view { n: 0 } { user: "ann", theme: Light } == <p>ann</p>
