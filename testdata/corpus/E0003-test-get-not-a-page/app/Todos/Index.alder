module Todos.Index

type Filter = All | Active

page "/" { filter: Filter = All }

type Model = { n: Int }

load : Params -> Session -> Query Model
load params session = Query.succeed { n: 0 }

form NewTodo = {
  title: Text,
}

msg Submit form NewTodo
msg Toggle { id: Text }

update : Msg -> Model -> Session -> Task Nav
update msg model session = Task.succeed Rerender

view : Model -> Session -> Html Msg
view model session =
  <form submit={Submit}>
    <Input field="title" label="Title" />
    <Errors field="title" />
    <button click={Toggle { id: "a" }}>Toggle</button>
  </form>

test "get a page held in a variable" = {
  let p = Todos.Index {}
  let r <- Test.get p
  Task.succeed True
}

test "a step as a value" = {
  let r <- Todos.Index {} |> Test.open
  Task.succeed True
}

test "a step with too few arguments" = {
  let r <- Test.submit NewTodo
  Task.succeed True
}

test "login with the wrong shape" = {
  let _ <- Test.login { user: "me" }
  Task.succeed True
}
