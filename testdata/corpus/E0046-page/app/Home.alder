module Home

-- the old syntax: a page module, which `alder fix --routes` turns into `route Home = GET "/" { }`
page "/" { }

type Model = { n: Int }

load : Params -> Session -> Query Model
load params session = Query.succeed { n: 1 }

view : Model -> Session -> Html Msg
view model session = <p>{Text.fromInt model.n}</p>
