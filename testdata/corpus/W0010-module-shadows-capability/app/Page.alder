module Page

import Clarity
import Data.Clarity as DataClarity

route Page = GET "/" { }

type Model = { title: Text, body: Text }

-- `Clarity` here is the module Clarity, so `Clarity.final` is not the capability's entry.
Page.load : Page.Params -> Session -> Query Model
Page.load params session = {
  let body <- Clarity.final "PA"
  Query.succeed { title: Clarity.title, body: body }
}

Page.view : Model -> Session -> Html
Page.view model session = <div>{model.title} {model.body}</div>
