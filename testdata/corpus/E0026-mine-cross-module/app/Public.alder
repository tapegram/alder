module Public

import Todo
import Todos.Index
import Todos.Show

route Public = GET "/public" { }

type Model = { todos: List Todo, more: List Todo }

Public.load : Public.Params -> Session -> Query Model
Public.load params session = {
  let todos <- Index.recent |> Db.all
  let more <- Show.shown
  Query.succeed { todos: todos, more: more }
}

Public.view : Model -> Session -> Html
Public.view model session = <p>public</p>
