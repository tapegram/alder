module Todos.Show

import Todo
import Todos.Index

route Show = GET "/todos" { } requires user

type Model = { todos: List Todo }

-- another `requires user` page module may use Todos.Index's scoped values
shown : Query (List Todo)
shown = Index.recent |> Db.all

Show.load : Show.Params -> Session -> Query Model
Show.load params session = {
  let todos <- shown
  Query.succeed { todos: todos }
}

Show.view : Model -> Session -> Html
Show.view model session = <p>todos</p>
