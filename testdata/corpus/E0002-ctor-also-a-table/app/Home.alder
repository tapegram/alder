module Home

import User
import Member

-- `Member` is both a constructor of `User.Role` and a table: where nothing says which type is
-- expected (an unannotated `let`), or the type is neither (`Text.fromInt`), it is E0002 naming both.
page "/" { }

type Model = { n: Int, member: Bool }

load : Params -> Session -> Query Model
load params session = {
  let who = Member
  Query.succeed { n: Text.length (Text.fromInt Member), member: who == Reader }
}

view : Model -> Session -> Html Msg
view model session = <p>{Text.fromInt model.n}</p>
