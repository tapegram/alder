module Index

route Index  = GET  "/"         { }
route Submit = POST "/_/Submit" { } form NewTodo

type Model = { n: Int }

Index.load : Index.Params -> Session -> Query Model
Index.load params session = Query.succeed { n: 1 }

form NewTodo = { title: Text.NonEmpty }

Submit.update : Submit.Params -> Session -> Task Response
Submit.update p session = Task.succeed Response.refresh

Index.view : Model -> Session -> Html
Index.view model session =
  <form submit={Submit}>
    <Input field="nope" label="Title" />
    <button>Add</button>
  </form>
