module Export

route Csv = GET "/export.csv" { }

Csv.load : Csv.Params -> Session -> Query Int
Csv.load params session = Query.succeed 1

Csv.view : Int -> Session -> File
Csv.view n session = File.text { contentType: "text/csv", body: "a,b" }

test "x" = {
  let r <- Test.open (Csv {})
  Task.succeed True
}
