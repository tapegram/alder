module Checkout

import Payments

route Checkout = GET  "/checkout"       { }
route Pay      = POST "/checkout" { }

type Model = { n: Int }

Checkout.load : Checkout.Params -> Session -> Query Model
Checkout.load params session = Query.succeed { n: 0 }

-- `Payments.install` is a test helper, and `update` runs in production.
Pay.update : Pay.Params -> Session -> Task Response
Pay.update params session = {
  let _ <- Payments.install
  Task.succeed Response.refresh
}

Checkout.view : Model -> Session -> Html
Checkout.view model session = <button click={Pay}>Pay</button>
