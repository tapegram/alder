module Landing

import User

-- `requires` runs before load: a visitor goes to the login page, a user is sent on home.
route Landing = GET "/landing" { } requires user

type Model = { }

Landing.load : Landing.Params -> Session -> Query Model
Landing.load params session = Query.redirect (Home.Home {})

Landing.view : Model -> Session -> Html
Landing.view model session = <html><body><p>never shown</p></body></html>

test "a visitor is sent to log in" = {
  let r <- Test.open (Landing {})
  Task.succeed (r.answer == Redirected (Auth.Login.Login {}))
}

test "a user is sent home" = {
  let me <- Db.insert User { name: "Me" }
  let _ <- Test.login { user: Just me }
  let r <- Test.open (Landing {})
  Task.succeed (r.answer == Redirected (Home.Home {}) && Test.has "#home" r.doc)
}
