module Go

-- A file page whose load redirects: Test.fetch sees the 303.
route Go = GET "/go.txt" { seed: Text = "9" }

type Model = { }

Go.load : Go.Params -> Session -> Query Model
Go.load params session = Query.redirect (Builder.Builder { seed: params.seed, tab: "raw" })

Go.view : Model -> Session -> File
Go.view model session = File.text { contentType: "text/plain", body: "never" }

test "a file page's redirect is a 303" = {
  let r <- Test.fetch (Go { seed: "9" })
  Task.succeed (
    r.status == 303 && List.member { name: "Location", value: "/builder/9?tab=raw" } r.headers
  )
}
