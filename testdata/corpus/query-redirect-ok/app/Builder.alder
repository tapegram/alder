module Builder

-- The target of Start's redirect: a path parameter and a query parameter with a default.
route Builder = GET "/builder/{seed}" { seed: Text, tab: Text = "main" }

type Model = { seed: Text, tab: Text }

Builder.load : Builder.Params -> Session -> Query Model
Builder.load params session = Query.succeed { seed: params.seed, tab: params.tab }

Builder.view : Model -> Session -> Html
Builder.view model session =
  <html><body><h1 id="builder">Builder {model.seed} ({model.tab})</h1></body></html>
