module Home

import Note

route Home = GET  "/"       { }
route Save = POST "/_/Save" { }

type Model = { notes: Int }

Home.load : Home.Params -> Session -> Query Model
Home.load params session = {
  let n <- Db.from Note |> Db.count
  Query.succeed { notes: n }
}

-- A Task that binds Query.redirect fails: its write is undone, and the request is answered
-- with the 303.
saveThenGo : Task Response
saveThenGo = {
  let _ <- Db.insert Note { title: "kept?" }
  let _ <- Query.redirect (Builder.Builder { seed: "5", tab: "main" })
  Task.succeed Response.refresh
}

Save.update : Save.Params -> Session -> Task Response
Save.update p session = saveThenGo

Home.view : Model -> Session -> Html
Home.view model session =
  <html>
    <body>
      <h1 id="home">Home</h1>
      <p id="notes">{Text.fromInt model.notes}</p>
      <button click={Save}>Save</button>
    </body>
  </html>

test "Test.run of a Task that redirects is Err, its write undone" = {
  let r <- Test.run saveThenGo
  let n <- Db.from Note |> Db.count
  Task.succeed (r.value == Err "redirected to /builder/5" && n == 0)
}

test "a message whose update redirects answers the 303" = {
  let _ <- Test.get (Home {})
  let r <- Test.click Save
  let n <- Db.from Note |> Db.count
  Task.succeed (r.answer == Redirected (Builder.Builder { seed: "5", tab: "main" }) && n == 0)
}
