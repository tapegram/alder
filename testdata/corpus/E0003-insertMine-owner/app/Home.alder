module Home

import Todo
import User

route Home = GET  "/"      { } requires user
route Add  = POST "/_/Add" { } requires user

type Model = { }

Home.load : Home.Params -> Session -> Query Model
Home.load params session = Query.succeed {}

Add.update : Add.Params -> Session -> Task Response
Add.update p session = {
  let _ <- Db.insertMine Todo { title: "milk", owner: session.user }
  let _ <- Db.insertMine Todo { title: "eggs", created: Time.epoch }
  let _ <- Db.insertMine Todo (rowFor session.user)
  let _ <- { title: "jam" } |> Db.insertMine Todo
  let _ <- Task.all (List.map (Db.insertMine Todo) [])
  let _ <- Db.insertMine Todo { done: True }
  Task.succeed Response.refresh
}

rowFor : User.UserId -> Insert Todo
rowFor u = { title: "tea", owner: u }

Home.view : Model -> Session -> Html
Home.view model session = <p>home</p>
