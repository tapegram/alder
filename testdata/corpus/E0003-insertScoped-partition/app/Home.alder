module Home

import Org
import Project

route Home = GET  "/"      { }                requires user, org
route Add  = POST "/_/Add" { org: Org.OrgId } requires user, org

type Model = { }

Home.load : Home.Params -> Session -> Query Model
Home.load params session = Query.succeed {}

Add.update : Add.Params -> Session -> Task Response
Add.update p session = {
  let _ <- Db.insertScoped Project { name: "a", org: p.org }
  let row = { name: "b" }
  let _ <- Db.insertScoped Project row
  Task.succeed Response.refresh
}

Home.view : Model -> Session -> Html
Home.view model session = <p>x</p>
