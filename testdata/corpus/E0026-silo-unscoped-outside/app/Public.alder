module Public

import Project
import Projects.Index

route Public = GET "/public" { id: Project.ProjectId } requires user

type Model = { projects: List Project, one: Maybe Project }

Public.load : Public.Params -> Session -> Query Model
Public.load params session = {
  let projects <- Index.all |> Db.all
  let one <- Db.get Project params.id
  Query.succeed { projects: projects, one: one }
}

Public.view : Model -> Session -> Html
Public.view model session = <p>x</p>
