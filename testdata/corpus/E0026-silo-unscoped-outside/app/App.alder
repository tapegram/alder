module App

import Org
import Project
import User
import Wiper

session {
  user: Maybe User.UserId,
  org: Maybe Org.OrgId via Membership,
  role: User.Role = Reader,
}

login = Login.Login

choose org = Orgs.Orgs

silo org { Project }

-- App has no `org` in scope (it is no page), so no arm of its update can write a silo, however
-- the write is spelled: unbound App Tasks only ever write the shared store
route Wipe   = POST "/"   { id: Project.ProjectId }
route Bound  = POST "/bounds"  { id: Project.ProjectId }
route Helped = POST "/helpeds" { id: Project.ProjectId }
route Scoped = POST "/scopeds" { id: Project.ProjectId }

Wipe.update : Wipe.Params -> Session -> Task Response
Wipe.update p session = {
  let _ <- Db.delete Project p.id
  Task.succeed Response.refresh
}

Bound.update : Bound.Params -> Session -> Task Response
Bound.update p session = {
  let del = Db.delete
  let _ <- del Project p.id
  Task.succeed Response.refresh
}

Helped.update : Helped.Params -> Session -> Task Response
Helped.update p session = {
  let _ <- Wiper.wipe p.id
  Task.succeed Response.refresh
}

Scoped.update : Scoped.Params -> Session -> Task Response
Scoped.update p session = {
  let _ <- Db.deleteScoped Project p.id
  Task.succeed Response.refresh
}

error : Error -> Html
error err = <p>error</p>

notFound : Html
notFound = <p>not found</p>
