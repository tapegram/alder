module App

error : Error -> Html Never
error err = <h1>Something went wrong</h1>

notFound : Html Never
notFound = <h1>Not found</h1>

deploy {
  production: Ssh "deploy@box.example.com" { domain: "blog.example.com", path: "/srv/blog", user: "deploy", port: 2222 },
  staging:    Fly "ord" { app: "blog-staging" },
  preview:    Ssh "deploy@box.example.com" { domain: "*.preview.example.com", path: "/srv/blog-preview" },
  long:       Fly "ord" { app: "a-very-long-hyphenated-application-name-for-staging" },
  local:      Script "./scripts/deploy-local.sh",
  cloud: Render "oregon" {
    service:   "blog",
    database:  Turso "my-org" { app: "blog" },
    instances: 2,
    plan:      "starter",
  },
  cloudpreview: Render "oregon" {
    service:  "blog-preview",
    database: Turso "my-org" { app: "blog-preview" },
  },
  image:      "ghcr.io/tavish/blog",
  floor:      0.95,
  checks:     ["./scripts/lint-content", "go vet ./...", "scripts/checks/verify/content/links/internal"],
  requires:   ["SMTP_URL", "STRIPE_KEY"],
  backup:     S3 "s3://blog-backups/production",
  keep:       5,
  proxy:      None,
}
