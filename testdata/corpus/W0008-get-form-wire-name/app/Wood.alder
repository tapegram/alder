module Wood

route Wood = GET "/r/{cfg}/wood/Results" { cfg: Text, electionId: Text = "" as "ElectionId", contestId: Maybe Int, tag: List Text = [] as "Tag" }

type Model = { election: Text }

Wood.load : Wood.Params -> Session -> Query Model
Wood.load params session = Query.succeed { election: params.electionId }

Wood.view : Model -> Session -> Html
Wood.view model session = <html><body><p>{model.election}</p></body></html>
