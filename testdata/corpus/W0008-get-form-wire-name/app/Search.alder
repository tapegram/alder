module Search

-- #63: a GET form to a page whose parameter has a wire name sends its inputs' names as the
-- query keys, so an input named after the field sets nothing.
route Search = GET "/search" { }

type Model = { tags: List Text }

Search.load : Search.Params -> Session -> Query Model
Search.load params session = Query.succeed { tags: ["a"] }

Search.view : Model -> Session -> Html
Search.view model session =
  <html>
    <body>
      <form method="get" action="/r/abc/wood/Results">
        <input name="electionId" />
        <input name="contestId" />
        <input name="ElectionId" />
        {for t in model.tags ->
          <label>{t} <select name="tag"><option value={t}>{t}</option></select></label>}
      </form>
      <form action="/r/abc/wood/Results?x=1"><textarea name="electionId"></textarea></form>
      <form method="GET" action="/r/abc/wood/Results/">
        {if List.isEmpty model.tags then <input name="tag" /> else <span></span>}
      </form>
      <form method="post" action="/r/abc/wood/Results"><input name="electionId" /></form>
      <form method="get" action="/elsewhere"><input name="electionId" /></form>
      <form method="get" action="/r/abc/def/wood/Results"><input name="electionId" /></form>
    </body>
  </html>
