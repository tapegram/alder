module Todos.Index

route Index = GET "/" { }

type Model = { }

Index.load : Index.Params -> Session -> Query Model
Index.load params session = Query.succeed {}

Index.view : Model -> Session -> Html
Index.view model session = <p>hi</p>

test "a 404 written as NotFound" = {
  let r <- Test.open (Index {})
  Task.succeed (r.answer == NotFound)
}
