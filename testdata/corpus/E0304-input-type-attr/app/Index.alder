module Index

route Index  = GET  "/"         { }
route Submit = POST "/_/Submit" { } form NewPost

type Model = { n: Int }

Index.load : Index.Params -> Session -> Query Model
Index.load params session = Query.succeed { n: 1 }

form NewPost = { title: Text.NonEmpty, published: Bool = False }

Submit.update : Submit.Params -> Session -> Task Response
Submit.update p session = Task.succeed Response.refresh

Index.view : Model -> Session -> Html
Index.view model session =
  <form submit={Submit}>
    <Errors form />
    <Input field="title" label="Title" />
    <Input field="published" label="Published" type="checkbox" />
    <button>Add</button>
  </form>
