module Index

route Index = GET "/" { }

type Priority = Low | Normal | High

type Model = { n: Int }

Index.load : Index.Params -> Session -> Query Model
Index.load params session = Query.succeed { n: rank High }

Index.view : Model -> Session -> Html
Index.view model session = <p>{Text.fromInt model.n}</p>

rank p = match p {
  Low -> 0,
  Normal -> 1,
  High -> 2,
}
