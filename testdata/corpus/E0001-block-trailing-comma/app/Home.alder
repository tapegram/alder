module Home

route Home = GET "/" { }
route Add  = POST "/" { }

type Model = { count: Int }

Home.load : Home.Params -> Session -> Query Model
Home.load params session = Query.succeed { count: 0 }

Add.update : Add.Params -> Session -> Task Response
Add.update p session = {
  let n = 1 + 1
  if n > 10 then Task.succeed Response.refresh else Task.succeed Response.refresh,
}

Home.view : Model -> Session -> Html
Home.view model session = <button click={Add}>{Text.fromInt model.count}</button>
