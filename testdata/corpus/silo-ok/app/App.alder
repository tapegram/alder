module App

import User
import Org

-- A silo per org: Project lives in one database per org. Membership and Org are shared.
session { user: Maybe User.UserId, org: Maybe Org.OrgId via Membership }

login = Login

choose org = Orgs

silo org { Project }

error : Error -> Html Never
error err = <html><body><h1>error</h1></body></html>

notFound : Html Never
notFound = <html><body><h1>not found</h1></body></html>
