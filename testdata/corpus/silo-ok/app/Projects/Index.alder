module Projects.Index

import Label
import Membership
import Org
import Project
import User

route Index  = GET  "/projects"          { }                       requires user, org
route Add    = POST "/projects"    { } form NewProject       requires user, org
route Rename = PATCH "/projects/{id}" { id: Project.ProjectId } requires user, org
route Remove = DELETE "/projects/{id}" { id: Project.ProjectId } requires user, org
route Seed   = POST "/projects/seeds"   { }                       requires user, org
route Tag    = POST "/projects/tags"    { }                       requires user, org

type Model = {
  org: Text,
  projects: List Project,
  labels: Int,
}

-- writes Project only: one silo
seed : Text -> Task Unit
seed name = {
  let _ <- Db.insertScoped Project { name: name }
  Task.succeed ()
}

Index.load : Index.Params -> Session -> Query Model
Index.load params session = {
  -- a cross-store read: Org is shared
  let org <- Db.get Org session.org
  let projects <-
    Db.scoped Project
      |> Db.orderBy Project.name.asc
      |> Db.all
  let labels <- Db.scoped Label |> Db.count
  Query.succeed {
    org: Maybe.withDefault "" (Maybe.map (\o -> o.name) org),
    projects: projects,
    labels: labels,
  }
}

form NewProject = { name: Text }

-- reads the shared store (Org) outside the transaction, writes the silo
Add.update : Add.Params -> Session -> Task Response
Add.update p session = {
  let org <- Db.get Org session.org
  let _ <- Db.insertScoped Project {
    name: Maybe.withDefault "" (Maybe.map (\o -> o.name ++ ": ") org) ++ p.form.name,
  }
  Task.succeed Response.refresh
}

Rename.update : Rename.Params -> Session -> Task Response
Rename.update p session = {
  let _ <- Db.updateScoped Project p.id (\x -> { x | name: "renamed" })
  Task.succeed Response.refresh
}

Remove.update : Remove.Params -> Session -> Task Response
Remove.update p session = {
  let _ <- p.id |> Db.deleteScoped Project
  Task.succeed Response.refresh
}

-- a shared write (Label is partitioned but in no silo): an explicit
-- shared arm beside the `_` silo arm has a case of its own in store__Projects__Index
Tag.update : Tag.Params -> Session -> Task Response
Tag.update params session = {
  let _ <- Db.insertScoped Label { name: "new" }
  Task.succeed Response.refresh
}

-- a Task.all within one silo, for Seed: the `_` arm, on the silo
Seed.update : Seed.Params -> Session -> Task Response
Seed.update params session = {
  let _ <- Task.all (List.map seed ["x", "y"])
  Task.succeed Response.refresh
}

Index.view : Model -> Session -> Html
Index.view model session =
  <html>
    <body>
      <h1>{model.org}</h1>
      <p id="labels">{Text.fromInt model.labels}</p>
      <form submit={Add}>
        <Input field="name" label="Name" />
        <Errors form />
        <button>Add</button>
      </form>
      <ul>
        {for p in model.projects ->
          <li>
            <span>{p.name}</span>
            <button click={Rename { id: p.id }}>rename</button>
            <button click={Remove { id: p.id }}>remove</button>
          </li>}
      </ul>
      <button click={Seed}>seed</button>
      <button click={Tag}>tag</button>
    </body>
  </html>

-- two orgs: me is a member of A, them of B; B's project is in B's database
setup : Task {
  me: User.UserId,
  them: User.UserId,
  a: Org.OrgId,
  b: Org.OrgId,
}
setup = {
  let me <- Db.insert User { name: "Me" }
  let them <- Db.insert User { name: "Them" }
  let a <- Db.insert Org { name: "A" }
  let b <- Db.insert Org { name: "B" }
  let _ <- Db.insert Membership { user: me, org: a }
  let _ <- Db.insert Membership { user: them, org: b }
  let _ <- Db.insert Project { name: "theirs", org: b }
  Task.succeed {
    me: me,
    them: them,
    a: a,
    b: b,
  }
}

names : List Project -> List Text
names ps = List.map (\p -> p.name) ps

test "a member sees only their org's projects" = {
  let s <- setup
  let _ <- Test.login { user: Just s.me, org: Just s.a }
  let _ <- Test.get (Index {})
  let _ <- Test.submit Add { name: "mine" }
  let page <- Test.get (Index {})
  Task.succeed (
    { names: names page.model.projects, h1: Test.text "h1" page.doc }
      == { names: ["A: mine"], h1: Just "A" }
  )
}

test "rename and remove act on the org's own projects" = {
  let s <- setup
  let _ <- Test.login { user: Just s.me, org: Just s.a }
  let _ <- Test.get (Index {})
  let _ <- Test.submit Add { name: "p" }
  let page <- Test.get (Index {})
  let ids <- Task.succeed (List.map (\p -> p.id) page.model.projects)
  let renamed <- Task.all (List.map (\id -> Test.click (Rename { id: id })) ids)
  let after <- Test.get (Index {})
  let _ <- Task.all (List.map (\id -> Test.click (Remove { id: id })) ids)
  let gone <- Test.get (Index {})
  Task.succeed (
    { renamed: names after.model.projects, gone: names gone.model.projects }
      == { renamed: ["renamed"], gone: [] }
  )
}

test "another org's project is not found" = {
  let s <- setup
  let _ <- Test.login { user: Just s.them, org: Just s.b }
  let theirs <- Test.get (Index {})
  let _ <- Test.login { user: Just s.me, org: Just s.a }
  let model : Model = {
    org: "A",
    projects: [],
    labels: 0,
  }
  let me : Index.Session = {
    user: s.me,
    org: s.a,
    role: Reader,
  }
  let ids <- Task.succeed (List.map (\p -> p.id) theirs.model.projects)
  let removed <- Task.all (List.map (\id -> Test.run (Remove.update { id: id } me)) ids)
  let renamed <- Task.all (List.map (\id -> Test.run (Rename.update { id: id } me)) ids)
  let _ <- Test.login { user: Just s.them, org: Just s.b }
  let still <- Test.get (Index {})
  Task.succeed (
    {
      removed: List.map (\x -> x.value) removed,
      renamed: List.map (\x -> x.value) renamed,
      still: names still.model.projects,
    } == {
      removed: [Err "not found"],
      renamed: [Err "not found"],
      still: ["theirs"],
    }
  )
}

test "seeding is one Task in one silo" = {
  let s <- setup
  let _ <- Test.login { user: Just s.me, org: Just s.a }
  let _ <- Test.get (Index {})
  let _ <- Test.click Seed
  let page <- Test.get (Index {})
  Task.succeed (names page.model.projects == ["x", "y"])
}

test "labels are scoped by org in the shared store" = {
  let s <- setup
  let _ <- Db.insert Label { name: "theirs", org: s.b }
  let _ <- Test.login { user: Just s.me, org: Just s.a }
  let _ <- Test.get (Index {})
  let r <- Test.click Tag
  Task.succeed (Test.text "#labels" r.doc == Just "1")
}

-- Test.run of an update runs on the store of the message's arm, as the request does: Tag's
-- (shared) beside the `_` arm's (the org's)
test "Test.run of Tag writes the shared store, of Seed the org's" = {
  let s <- setup
  let _ <- Test.login { user: Just s.me, org: Just s.a }
  let model : Model = {
    org: "A",
    projects: [],
    labels: 0,
  }
  let me : Index.Session = {
    user: s.me,
    org: s.a,
    role: Reader,
  }
  let tagged <- Test.run (Tag.update {} me)
  let seeded <- Test.run (Seed.update {} me)
  let page <- Test.get (Index {})
  Task.succeed (
    {
      tag: tagged.value,
      seed: seeded.value,
      labels: page.model.labels,
      projects: names page.model.projects,
    } == {
      tag: Ok Response.refresh,
      seed: Ok Response.refresh,
      labels: 1,
      projects: ["x", "y"],
    }
  )
}

test "without an org the page sends you to pick one" = {
  let s <- setup
  let _ <- Test.login { user: Just s.me, org: Nothing }
  let r <- Test.open (Index {})
  Task.succeed (r.answer == Redirected (Orgs.Orgs {}))
}

test "a visitor is sent to log in" = {
  let r <- Test.open (Index {})
  Task.succeed (r.answer == Redirected (Login.Login {}))
}
