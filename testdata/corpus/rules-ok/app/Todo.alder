module Todo

import User

type TodoId = brand Text

-- `@owner` after `@ref` and its delete rule; Db.insertMine takes every insert field but it.
table Todo {
  id: TodoId @id,
  title: Text,
  done: Bool = False,
  owner: User.UserId @ref User @cascade @owner,
  created: Time @created,
}

test "deleting a user deletes their todos" = {
  let me <- Db.insert User { name: "Me" }
  let _ <- Db.insert Todo { title: "a", owner: me }
  let _ <- Db.delete User me
  let n <- Db.from Todo |> Db.count
  Task.succeed (n == 0)
}
