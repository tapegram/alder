module Todos.Index

import Todo

page "/" { } requires user

type Model = { todos: List Todo, open: Int }

-- A helper value of a `requires user` page module may use the scoped operations.
recent : Select Todo
recent = Db.mine Todo |> Db.orderBy Todo.created.desc |> Db.limit 10

load : Params -> Session -> Query Model
load params session = {
  let todos <- recent |> Db.all
  let open <- Db.mine Todo |> Db.where (Todo.done.eq False) |> Db.count
  Query.succeed { todos: todos, open: open }
}

form NewTodo = {
  title: Text,
}

msg Add form NewTodo
msg Toggle { id: Todo.TodoId }
msg Rename { id: Todo.TodoId }
msg Remove { id: Todo.TodoId }

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  Add p -> {
    let _ <- Db.insertMine Todo { title: p.form.title }
    Task.succeed Rerender
  },
  Toggle p -> {
    let _ <- Db.updateMine Todo p.id (\t -> { t | done: not t.done })
    Task.succeed Rerender
  },
  Rename p -> {
    let t <- Db.getMine Todo p.id
    let _ <- Db.update Todo t.id (\x -> { x | title: x.title ++ "!" })
    Task.succeed Rerender
  },
  Remove p -> {
    let _ <- p.id |> Db.deleteMine Todo
    Task.succeed Rerender
  },
}

view : Model -> Session -> Html Msg
view model session =
  <ul>
    {for t in model.todos -> <li><button click={Toggle { id: t.id }}>{t.title}</button></li>}
  </ul>
