module Todos.Index

import Todo
import User

route Index     = GET  "/"            { }                 requires user
route Add       = POST "/_/Add"       { } form NewTodo    requires user
route Toggle    = POST "/_/Toggle"    { id: Todo.TodoId } requires user
route Rename    = POST "/_/Rename"    { id: Todo.TodoId } requires user
route Remove    = POST "/_/Remove"    { id: Todo.TodoId } requires user
route Duplicate = POST "/_/Duplicate" { id: Todo.TodoId } requires user

type Model = { todos: List Todo, open: Int }

-- A helper value of a `requires user` page module may use the scoped operations; they act for
-- the signed-in user of the running request (or test).
recent : Select Todo
recent =
  Db.mine Todo
    |> Db.orderBy Todo.created.desc
    |> Db.limit 2

Index.load : Index.Params -> Session -> Query Model
Index.load params session = {
  let todos <- recent |> Db.all
  let open <-
    Db.mine Todo
      |> Db.where (Todo.done.eq False)
      |> Db.count
  Query.succeed { todos: todos, open: open }
}

form NewTodo = { title: Text }

Add.update : Add.Params -> Session -> Task Response
Add.update p session = {
  let _ <- Db.insertMine Todo { title: p.form.title }
  Task.succeed Response.refresh
}

Toggle.update : Toggle.Params -> Session -> Task Response
Toggle.update p session = {
  let _ <- Db.updateMine Todo p.id (\t -> { t | done: not t.done })
  Task.succeed Response.refresh
}

Rename.update : Rename.Params -> Session -> Task Response
Rename.update p session = {
  let t <- Db.getMine Todo p.id
  let _ <- Db.update Todo t.id (\x -> { x | title: "renamed" })
  Task.succeed Response.refresh
}

Remove.update : Remove.Params -> Session -> Task Response
Remove.update p session = {
  let _ <- p.id |> Db.deleteMine Todo
  Task.succeed Response.refresh
}

-- a write, then a scoped write: a row that is not mine undoes both
Duplicate.update : Duplicate.Params -> Session -> Task Response
Duplicate.update p session = {
  let _ <- Db.insertMine Todo { title: "copy" }
  let _ <- Db.updateMine Todo p.id (\t -> { t | done: True })
  Task.succeed Response.refresh
}

Index.view : Model -> Session -> Html
Index.view model session =
  <html>
    <body>
      <form submit={Add}>
        <Input field="title" label="Title" />
        <Errors form />
        <button>Add</button>
      </form>
      <p id="open">{Text.fromInt model.open}</p>
      <ul>
        {for t in model.todos ->
          <li>
            <span>{t.title}</span>
            <button click={Toggle { id: t.id }}>toggle</button>
            <button click={Rename { id: t.id }}>rename</button>
            <button click={Remove { id: t.id }}>remove</button>
            <button click={Duplicate { id: t.id }}>duplicate</button>
          </li>}
      </ul>
    </body>
  </html>

titleOf : Maybe Todo -> Text
titleOf found = match found {
  Just t -> t.title,
  Nothing -> "(gone)",
}

-- The user of the scoped operations is the test's session: Test.login sets it.
test "recent lists my two newest todos" = {
  let me <- Db.insert User { name: "Me" }
  let bob <- Db.insert User { name: "Bob" }
  let _ <- Db.insert Todo { title: "a", owner: me }
  let _ <- Db.insert Todo { title: "b", owner: me }
  let _ <- Db.insert Todo { title: "c", owner: me }
  let _ <- Db.insert Todo { title: "bob's", owner: bob }
  let _ <- Test.login { user: Just me }
  let r <- Test.run {
    let ts <- recent |> Db.all
    Task.succeed (List.map (\t -> t.title) ts)
  }
  Task.succeed (r.value == Ok ["c", "b"])
}

-- Without Test.login the test's session has no user: a helper using a scoped operation fails.
test "a scoped helper needs a signed-in user" = {
  let r <- Test.run {
    let ts <- recent |> Db.all
    Task.succeed (List.length ts)
  }
  Task.succeed (
    { value: r.value, trace: r.trace }
      == { value: Err "Db.mine Todo: no signed-in user", trace: ["Db.mine Todo", "Db.all Todo"] }
  )
}

test "the open count is of my open todos" = {
  let me <- Db.insert User { name: "Me" }
  let bob <- Db.insert User { name: "Bob" }
  let _ <- Db.insert Todo { title: "a", owner: me }
  let _ <- Db.insert Todo { title: "b", owner: me }
  let _ <- Db.insert Todo {
    title: "c",
    done: True,
    owner: me,
  }
  let _ <- Db.insert Todo { title: "d", owner: bob }
  let _ <- Test.login { user: Just me }
  let page <- Test.get (Index {})
  Task.succeed (page.model.open == 2)
}

test "a visitor is sent to log in" = {
  let r <- Test.open (Index {})
  Task.succeed (r.answer == Redirected (Login.Login {}))
}

test "adding a todo stores an open todo of mine" = {
  let me <- Db.insert User { name: "Me" }
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Index {})
  let r <- Test.submit Add { title: "Milk" }
  let mine <-
    Db.from Todo
      |> Db.where (Todo.owner.eq me)
      |> Db.all
  Task.succeed (
    { answer: r.answer, todos: List.map (\t -> { title: t.title, done: t.done }) mine }
      == { answer: Refreshed, todos: [{ title: "Milk", done: False }] }
  )
}

-- a write route requires a user as its page does: a visitor is sent to log in, and nothing is written
test "a visitor is sent to log in from every write" = {
  let me <- Db.insert User { name: "Me" }
  let id <- Db.insert Todo { title: "Milk", owner: me }
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Index {})
  let _ <- Test.login { user: Nothing }
  let added <- Test.submit Add { title: "Eggs" }
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Index {})
  let _ <- Test.login { user: Nothing }
  let toggled <- Test.click (Toggle { id: id })
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Index {})
  let _ <- Test.login { user: Nothing }
  let renamed <- Test.click (Rename { id: id })
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Index {})
  let _ <- Test.login { user: Nothing }
  let removed <- Test.click (Remove { id: id })
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Index {})
  let _ <- Test.login { user: Nothing }
  let copied <- Test.click (Duplicate { id: id })
  let todos <- Db.from Todo |> Db.all
  let login = Redirected (Login.Login {})
  Task.succeed (
    [added.answer, toggled.answer, renamed.answer, removed.answer, copied.answer]
      == [login, login, login, login, login]
      && List.map (\t -> { title: t.title, done: t.done }) todos == [{ title: "Milk", done: False }]
  )
}

test "toggling my todo" = {
  let me <- Db.insert User { name: "Me" }
  let id <- Db.insert Todo { title: "Milk", owner: me }
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Index {})
  let r <- Test.click (Toggle { id: id })
  let after <- Db.get Todo id
  Task.succeed (
    { answer: r.answer, done: Maybe.map (\t -> t.done) after }
      == { answer: Refreshed, done: Just True }
  )
}

test "renaming my todo" = {
  let me <- Db.insert User { name: "Me" }
  let id <- Db.insert Todo { title: "Milk", owner: me }
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Index {})
  let r <- Test.click (Rename { id: id })
  let after <- Db.get Todo id
  Task.succeed (
    { answer: r.answer, title: titleOf after } == { answer: Refreshed, title: "renamed" }
  )
}

test "removing my todo" = {
  let me <- Db.insert User { name: "Me" }
  let id <- Db.insert Todo { title: "Milk", owner: me }
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Index {})
  let r <- Test.click (Remove { id: id })
  let after <- Db.get Todo id
  Task.succeed (
    { answer: r.answer, title: titleOf after } == { answer: Refreshed, title: "(gone)" }
  )
}

test "duplicating my todo" = {
  let me <- Db.insert User { name: "Me" }
  let id <- Db.insert Todo { title: "Milk", owner: me }
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Index {})
  let r <- Test.click (Duplicate { id: id })
  let after <- Db.get Todo id
  let n <-
    Db.from Todo
      |> Db.where (Todo.owner.eq me)
      |> Db.count
  Task.succeed (
    {
      answer: r.answer,
      done: Maybe.map (\t -> t.done) after,
      n: n,
    } == {
      answer: Refreshed,
      done: Just True,
      n: 2,
    }
  )
}

-- A stale page: I opened my list, then someone else signed in in this browser and clicks my
-- todo's buttons. Each scoped write answers not found and changes nothing.
test "a stranger's toggle on a stale page is not found" = {
  let me <- Db.insert User { name: "Me" }
  let bob <- Db.insert User { name: "Bob" }
  let id <- Db.insert Todo { title: "Milk", owner: me }
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Index {})
  let _ <- Test.login { user: Just bob }
  let r <- Test.click (Toggle { id: id })
  let after <- Db.get Todo id
  Task.succeed (
    { answer: r.answer, done: Maybe.map (\t -> t.done) after }
      == { answer: PageMissing, done: Just False }
  )
}

test "a stranger's rename on a stale page is not found" = {
  let me <- Db.insert User { name: "Me" }
  let bob <- Db.insert User { name: "Bob" }
  let id <- Db.insert Todo { title: "Milk", owner: me }
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Index {})
  let _ <- Test.login { user: Just bob }
  let r <- Test.click (Rename { id: id })
  let after <- Db.get Todo id
  Task.succeed (
    { answer: r.answer, title: titleOf after } == { answer: PageMissing, title: "Milk" }
  )
}

test "a stranger's remove on a stale page is not found" = {
  let me <- Db.insert User { name: "Me" }
  let bob <- Db.insert User { name: "Bob" }
  let id <- Db.insert Todo { title: "Milk", owner: me }
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Index {})
  let _ <- Test.login { user: Just bob }
  let r <- Test.click (Remove { id: id })
  let after <- Db.get Todo id
  Task.succeed (
    { answer: r.answer, title: titleOf after } == { answer: PageMissing, title: "Milk" }
  )
}

-- the insert before the scoped update is rolled back with it
test "a stranger's duplicate on a stale page is not found and undone" = {
  let me <- Db.insert User { name: "Me" }
  let bob <- Db.insert User { name: "Bob" }
  let id <- Db.insert Todo { title: "Milk", owner: me }
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Index {})
  let _ <- Test.login { user: Just bob }
  let r <- Test.click (Duplicate { id: id })
  let after <- Db.get Todo id
  let n <- Db.from Todo |> Db.count
  Task.succeed (
    {
      answer: r.answer,
      done: Maybe.map (\t -> t.done) after,
      n: n,
    } == {
      answer: PageMissing,
      done: Just False,
      n: 1,
    }
  )
}

-- the same through update: the trace names the scoped steps as written
test "a scoped update of another's row fails the whole task" = {
  let me <- Db.insert User { name: "Me" }
  let bob <- Db.insert User { name: "Bob" }
  let id <- Db.insert Todo { title: "Milk", owner: me }
  let _ <- Test.login { user: Just bob }
  let r <- Test.run (Duplicate.update { id: id } { user: bob, role: Reader })
  let n <- Db.from Todo |> Db.count
  Task.succeed (
    {
      value: r.value,
      trace: r.trace,
      n: n,
    } == {
      value: Err "not found",
      trace: ["Db.insertMine Todo", "Db.updateMine Todo"],
      n: 1,
    }
  )
}

-- Db.updateMine never writes the owner: a function that gives the todo away changes the rest
test "updateMine never gives a todo away" = {
  let me <- Db.insert User { name: "Me" }
  let bob <- Db.insert User { name: "Bob" }
  let id <- Db.insert Todo { title: "Milk", owner: me }
  let _ <- Test.login { user: Just me }
  let r <- Test.run (Db.updateMine Todo id (\t -> { t | title: "given", owner: bob }))
  let after <- Db.get Todo id
  Task.succeed (
    {
      value: r.value,
      owner: Maybe.map (\t -> t.owner) after,
      title: titleOf after,
    } == {
      value: Ok (),
      owner: Just me,
      title: "given",
    }
  )
}
