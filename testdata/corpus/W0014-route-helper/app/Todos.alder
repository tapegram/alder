module Todos

import Table.Tag
import Table.Todo

route Index = GET "/todos" { } requires user, org

type Model = { todos: List Todo, n: Int, both: Int }

-- helpers of a route module that state no need: a warning for one release (W0014), and
-- `alder fmt` adds the clause
recent : Select Todo
recent = Db.mine Todo |> Db.limit 10

-- through a helper of the module
count : Query Int
count = recent |> Db.count

-- two keys: both warnings carry the same fix
both : Query Int
both = {
  let tags <- Db.scoped Tag |> Db.count
  let todos <- Db.mine Todo |> Db.count
  Query.succeed (tags + todos)
}

Index.load : Index.Params -> Session -> Query Model
Index.load params session = {
  let todos <- recent |> Db.all
  let n <- count
  let b <- both
  Query.succeed { todos: todos, n: n, both: b }
}

Index.view : Model -> Session -> Html
Index.view model session = <p>{Text.fromInt model.n}</p>
