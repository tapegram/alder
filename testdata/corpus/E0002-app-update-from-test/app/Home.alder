module Home

page "/" { }

type Model = { }

load : Params -> Session -> Query Model
load params session = Query.succeed { }

view : Model -> Session -> Html Msg
view model session = <button click={App.Flip}>Flip</button>

test "flip rerenders" = {
  let r <- Test.run (App.update (App.Flip {}) { dark: False })
  Task.succeed (r.value == Ok Rerender)
}
