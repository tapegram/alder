module Today

page "/today" { }

type Model = { first: Int, second: Int, today: Date }

-- Two readings of the clock and today's date.
load : Params -> Session -> Query Model
load params session = {
  let first <- Time.now
  let second <- Time.now
  let today <- Date.today
  Query.succeed { first: Time.toMillis first, second: Time.toMillis second, today: today }
}

view : Model -> Session -> File
view model session =
  File.text { contentType: "text/plain", body: Text.fromInt model.first ++ " " ++ Text.fromInt model.second ++ " " ++ Date.toText model.today }

-- 2026-03-04T05:06:07Z
march : Time
march = Time.fromMillis 1772600767000

body : { status: Int, contentType: Text, body: Bytes, headers: List { name: Text, value: Text } } -> Text
body r = Maybe.withDefault "" (Bytes.toText r.body)

test "a set clock stands still" = {
  let _ <- Test.setClock march
  let r <- Test.fetch (Today {})
  Task.succeed (body r == "1772600767000 1772600767000 2026-03-04")
}

test "advancing a day moves today" = {
  let _ <- Test.setClock march
  let before <- Test.fetch (Today {})
  let _ <- Test.advance (24 * 60 * 60 * 1000)
  let after <- Test.fetch (Today {})
  Task.succeed (body before == "1772600767000 1772600767000 2026-03-04" && body after == "1772687167000 1772687167000 2026-03-05")
}

test "a second set moves the clock back" = {
  let _ <- Test.setClock march
  let _ <- Test.advance 5000
  let _ <- Test.setClock (Time.fromMillis 1767225600000)
  let r <- Test.fetch (Today {})
  Task.succeed (body r == "1767225600000 1767225600000 2026-01-01")
}

-- Before any set the clock ticks a second per reading, and an advance keeps the tick.
test "an advance on a ticking clock keeps the tick" = {
  let r <- Test.fetch (Today {})
  let _ <- Test.advance 60000
  let s <- Test.fetch (Today {})
  let ms = \t -> Text.split " " (body t) |> List.head |> Maybe.andThen Text.toInt |> Maybe.withDefault 0
  let second = \t -> Text.split " " (body t) |> List.drop 1 |> List.head |> Maybe.andThen Text.toInt |> Maybe.withDefault 0
  Task.succeed (second r - ms r == 1000 && second s - ms s == 1000 && ms s - ms r >= 61000)
}

test "a negative advance is no advance" = {
  let _ <- Test.setClock march
  let _ <- Test.advance (0 - 5000)
  let r <- Test.fetch (Today {})
  Task.succeed (body r == "1772600767000 1772600767000 2026-03-04")
}

test "the set and the advances are on the trace" = {
  let _ <- Test.setClock march
  let _ <- Test.advance (0 - 5)
  let _ <- Test.advance 6000
  let trace <- Test.trace
  Task.succeed (trace == ["Test.setClock 2026-03-04T05:06:07Z", "Test.advance 0ms", "Test.advance 6000ms"])
}
