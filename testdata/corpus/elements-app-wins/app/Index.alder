module Index

route Index = GET  "/"     { }
route Go    = POST "/" { }

type Model = { n: Int }

Index.load : Index.Params -> Session -> Query Model
Index.load params session = Query.succeed { n: 1 }

Go.update : Go.Params -> Session -> Task Response
Go.update p session = Task.succeed Response.refresh

Index.view : Model -> Session -> Html
Index.view model session =
  <main>
    <al-button tone="x">Ok</al-button>
    <al-button variant="primary">Refused</al-button>
  </main>
