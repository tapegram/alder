module Todos.Index

type Filter = All | Active

route Index  = GET   "/"                  { }
route Submit = POST  "/todos"             { } form NewTodo
route Toggle = PATCH "/todos/{id}/toggle" { id: Text }

form NewTodo = {
  title: Text,
}

Index.load : Index.Params -> Session -> Query Int
Index.load params session = Query.succeed 0

Submit.update : Submit.Params -> Session -> Task Response
Submit.update params session = Task.succeed Response.refresh

Toggle.update : Toggle.Params -> Session -> Task Response
Toggle.update params session = Task.succeed Response.refresh

Index.view : Int -> Session -> Html
Index.view n session =
  <form submit={Submit}>
    <Errors form />
    <Input field="title" label="Title" />
    <button click={Toggle { id: "a" }}>Toggle</button>
  </form>

test "get a route held in a variable" = {
  let p = Index {}
  let r <- Test.get p
  Task.succeed True
}

test "a step as a value" = {
  let r <- Index {} |> Test.open
  Task.succeed True
}

test "a step with too few arguments" = {
  let r <- Test.submit Submit
  Task.succeed True
}

test "login with the wrong shape" = {
  let _ <- Test.login { user: "me" }
  Task.succeed True
}
