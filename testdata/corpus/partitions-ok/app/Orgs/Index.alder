module Orgs.Index

import Membership
import Org

-- `choose org`'s page: it requires the user, not the org, and sets the org.
route Index = GET  "/orgs"        { }                requires user
route Pick  = POST "/orgs" { org: Org.OrgId } requires user

type Model = { mine: List Membership }

Index.load : Index.Params -> Session -> Query Model
Index.load params session = {
  let mine <-
    Db.from Membership
      |> Db.where (Membership.user.eq session.user)
      |> Db.all
  Query.succeed { mine: mine }
}

Pick.update : Pick.Params -> Session -> Task Response
Pick.update p session = {
  let _ <- Session.put (\s -> { s | org: Just p.org })
  Task.succeed (Response.redirect (Projects.Index.Index {}))
}

Index.view : Model -> Session -> Html
Index.view model session =
  <html>
    <body>
      <ul>
        {for m in model.mine -> <li><button click={Pick { org: m.org }}>pick</button></li>}
      </ul>
    </body>
  </html>
