module Index

page "/" { }

type Model = { n: Int }

type PickParams = { z: Int }

load : Params -> Session -> Query Model
load params session = Query.succeed { n: 1 }

msg Pick { n: Int }

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  Pick p -> Task.succeed Rerender,
}

Session : { label: Text } -> Html Msg
Session props = <b>{props.label}</b>

view : Model -> Session -> Html Msg
view model session = <button click={Pick { n: model.n }}>pick</button>
