module Public

import Todo

route Public = GET "/public" { }

type Model = { todos: List Todo }

Public.load : Public.Params -> Session -> Query Model
Public.load params session = {
  let todos <- Db.mine Todo |> Db.all
  Query.succeed { todos: todos }
}

Public.view : Model -> Session -> Html
Public.view model session = <p>public</p>
