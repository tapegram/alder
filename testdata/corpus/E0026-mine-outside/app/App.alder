module App

import Todo
import User

session { user: Maybe User.UserId, role: User.Role = Reader }

login = Login.Login

route Clear = POST "/_/Clear" { id: Todo.TodoId }

Clear.update : Clear.Params -> Session -> Task Response
Clear.update p session = {
  let _ <- Db.deleteMine Todo p.id
  Task.succeed Response.refresh
}

error : Error -> Html
error err = <p>error</p>

notFound : Html
notFound = <p>not found</p>
