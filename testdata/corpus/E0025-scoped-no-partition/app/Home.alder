module Home

import Project
import Todo

route Home = GET "/" { } requires user, org

type Model = { todos: List Todo, n: Int }

Home.load : Home.Params -> Session -> Query Model
Home.load params session = {
  let todos <- Db.scoped Todo |> Db.all
  let n <- Db.mine Project |> Db.count
  Query.succeed { todos: todos, n: n }
}

Home.view : Model -> Session -> Html
Home.view model session = <p>x</p>
