module Profile

route Profile = GET "/profile" { }

type Model = { dark: Bool }

Profile.load : Profile.Params -> Session -> Query Model
Profile.load params session = Query.succeed { dark: False }

Profile.view : Model -> Session -> Html
Profile.view model session = <p>{if model.dark then "dark" else "light"}</p>

label : Bool -> Text
label dark = if dark then "dark" else "light"

test "the light theme is not dark" = label (Light == Dark) == "light"
