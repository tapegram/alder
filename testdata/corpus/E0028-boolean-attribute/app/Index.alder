module Index

page "/" { }

type Model = { n: Int }

load : Params -> Session -> Query Model
load params session = Query.succeed { n: 1 }

msg Go

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  Go p -> Task.succeed Rerender,
}

view : Model -> Session -> Html Msg
view model session =
  <main>
    <al-button disabled="yes">Go</al-button>
    <al-table striped={1}><table></table></al-table>
    <al-badge variant>x</al-badge>
  </main>
