module Todos

import Table.Todo
import Table.User
import Layout

route Index  = GET    "/"                  { filter: Todo.Filter = All } requires user
route Row    = GET    "/todos/{id}"        { id: Todo.TodoId }           requires user
route Toggle = PATCH  "/todos/{id}/toggle" { id: Todo.TodoId }           requires user
route Create = POST   "/todos"             { } form NewTodo              requires user
route Delete = DELETE "/todos/{id}"        { id: Todo.TodoId }           requires user
route Export = GET    "/export.csv"        { }                           requires user
route Move   = POST   "/todos/{id}/move"   { id: Todo.TodoId } form MoveTo requires user

form NewTodo = { title: Text }

form MoveTo = { list: Text }

type TodoList = { filter: Todo.Filter, todos: List Todo }

Index.load : Index.Params -> Session -> Query TodoList
Index.load params session = {
  let todos <- Db.mine Todo |> Db.where (Todo.matches params.filter) |> Db.all
  Query.succeed { filter: params.filter, todos: todos }
}

Index.view : TodoList -> Session -> Html
Index.view model session =
  <Layout.Page title="Todos" theme={session.theme}>
    <nav>
      <a href={Index { filter: All }}>All</a>
      <a href={Index { filter: Done }}>Done</a>
    </nav>
    <ul id="todos">{for t in model.todos -> Row.view t session}</ul>
    <form submit={Create}><Input field="title" /><Errors form /><button>Add</button></form>
  </Layout.Page>

Row.load : Row.Params -> Session -> Query Todo
Row.load params session = Db.getMine Todo params.id

Row.view : Todo -> Session -> Html
Row.view t session =
  <li id={"todo-" ++ t.id}>
    <button click={Toggle { id: t.id }}>{t.title}</button>
    <button click={Row { id: t.id }}>Reload</button>
    <form submit={Move { id: t.id }}>
      <Errors form />
      <Select field="list" options={[{ value: "home", label: "Home" }, { value: t.title, label: "Its own" }]} />
    </form>
  </li>

Toggle.update : Toggle.Params -> Session -> Task Response
Toggle.update params session = {
  let _ <- Db.updateMine Todo params.id (\t -> { t | done: not t.done })
  Task.succeed (Response.render (Row { id: params.id }))
}

Create.update : Create.Params -> Session -> Task Response
Create.update params session =
  if params.form.title == "" then Task.succeed (Response.invalid "Write a title.")
  else {
    let _ <- Db.insertMine Todo { title: params.form.title, due: Nothing }
    Task.succeed (Response.redirect (Index { filter: All }) |> Response.toast "Added")
  }

Delete.update : Delete.Params -> Row.Session -> Task Response
Delete.update params session = {
  let _ <- Db.deleteMine Todo params.id
  Task.succeed (Response.redirect (Index { filter: All }))
}

Export.load : Export.Params -> Export.Session -> Query (List Todo)
Export.load params session = Db.mine Todo |> Db.all

Export.view : List Todo -> Session -> File
Export.view todos session =
  File.text { contentType: "text/csv", body: Text.join "\n" (List.map (\t -> t.title) todos) }

Move.update : Move.Params -> Session -> Task Response
Move.update params session =
  if params.form.list == "" then Task.succeed (Response.invalid "Pick a list.") else Task.succeed Response.refresh

-- The browser steps on routes: Test.get of a GET route holds its model, Test.click of a GET
-- route fetches it, of a write route sends it, Test.submit posts a route's form, Test.refresh
-- reloads the held page; every step's result has the URL held and the last response's code.
test "a row is fetched, toggled, moved and refreshed" = {
  let me <- Db.insert User { email: "me@example.com" }
  let _ <- Test.login { user: Just me }
  let id <- Db.insert Todo { title: "Milk", due: Nothing, owner: me }
  let row <- Test.get (Row { id: id })
  let page <- Test.get (Index { filter: All })
  let fetched <- Test.click (Row { id: id })
  let toggled <- Test.click (Toggle { id: id })
  let moved <- Test.submit (Move { id: id }) { list: "home" }
  let added <- Test.submit Create { title: "Bread" }
  let raw <- Test.submitRaw Create [{ name: "title", value: "" }]
  let again <- Test.refresh
  let csv <- Test.fetch (Export {})
  let shown <- Test.open (Index { filter: Done })
  Task.succeed ({ n: List.length page.model.todos, title: row.model.title, fetched: fetched.status, toggled: toggled.answer, moved: moved.status, added: added.answer, raw: raw.status, url: again.url, again: again.answer, csv: csv.status, shown: shown.url }
    == { n: 1, title: "Milk", fetched: 200, toggled: Rendered (Row { id: id }), moved: 200, added: Redirected (Index { filter: All }), raw: 422, url: "/", again: Refreshed, csv: 200, shown: "/?filter=Done" })
}
