module New

import Todo
import User

route New = GET  "/new/{id}"       { id: Todo.TodoId }
route Add = POST "/new/{id}" { id: Todo.TodoId } form NewTodo

type Model = { id: Todo.TodoId }

New.load : New.Params -> Session -> Query Model
New.load params session = Query.succeed { id: params.id }

form NewTodo = { title: Text.NonEmpty, owner: User.UserId }

Add.update : Add.Params -> Session -> Task Response
Add.update p session = {
  let _ <- Db.insert Todo {
    id: p.id,
    title: p.form.title,
    owner: p.form.owner,
  }
  Task.succeed Response.refresh
}

New.view : Model -> Session -> Html
New.view model session =
  <form submit={Add { id: model.id }}>
    <Input field="title" label="Title" />
    <Input field="owner" label="Owner" />
    <button>Add</button>
  </form>
