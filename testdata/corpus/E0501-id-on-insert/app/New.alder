module New

import Todo
import User

page "/new/{id}" { id: Todo.TodoId }

type Model = { id: Todo.TodoId }

load : Params -> Session -> Query Model
load params session = Query.succeed { id: params.id }

form NewTodo = {
  title: Text.NonEmpty,
  owner: User.UserId,
}

msg Add form NewTodo

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  Add p -> {
    let _ <- Db.insert Todo { id: model.id, title: p.form.title, owner: p.form.owner }
    Task.succeed Rerender
  },
}

view : Model -> Session -> Html Msg
view model session =
  <form submit={Add}>
    <Input field="title" label="Title" />
    <Input field="owner" label="Owner" />
    <button>Add</button>
  </form>
