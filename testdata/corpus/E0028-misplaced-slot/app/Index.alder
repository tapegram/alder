module Index

import Ui

route Index = GET "/" { }

type Model = { open: Bool }

Index.load : Index.Params -> Session -> Query Model
Index.load params session = Query.succeed { open: True }

Index.view : Model -> Session -> Html
Index.view model session =
  <al-card>
    <div><p slot="header">Inside a div</p></div>
    <section>
      {if model.open then <p slot="footer">Through if</p> else <p>Closed</p>}
    </section>
    <h2 slot="header">Direct child: fine</h2>
    <Ui.Card><h2 slot="header">A component's children are not slot-checked</h2></Ui.Card>
  </al-card>
