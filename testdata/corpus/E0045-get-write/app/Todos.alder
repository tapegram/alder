module Todos

route Index  = GET   "/"                  { }
route Toggle = PATCH "/todos/{id}/toggle" { id: Text }

Index.load : Index.Params -> Session -> Query Int
Index.load params session = Query.succeed 1

Index.view : Int -> Session -> Html
Index.view n session = <button click={Toggle { id: "1" }}>Toggle</button>

Toggle.update : Toggle.Params -> Session -> Task Response
Toggle.update params session = Task.succeed Response.refresh

-- Test.get, open and fetch request a GET route; a write route is clicked or submitted
test "get a write route" = {
  let r <- Test.get (Toggle { id: "1" })
  let o <- Test.open (Toggle { id: "1" })
  let f <- Test.fetch (Toggle { id: "1" })
  Task.succeed True
}
