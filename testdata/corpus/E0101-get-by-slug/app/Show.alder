module Show

import Post

page "/posts/{slug}" { slug: Post.Slug }

type Model = { post: Post }

load : Params -> Session -> Query Model
load params session = {
  let found <- Db.get Post params.slug
  match found {
    Just post -> Query.succeed { post: post },
    Nothing -> Query.notFound,
  }
}

view : Model -> Session -> Html Msg
view model session = <h1>{model.post.title}</h1>
