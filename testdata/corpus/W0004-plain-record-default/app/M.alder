module M

-- a declared record type's literal names every field: the default never applies (W0004)
type Options = { loud: Bool = False, name: Text }

-- an anonymous record type's defaults apply to its literals: no warning
describe : { name: Text, loud: Bool = False } -> Text
describe o = o.name

described : Text
described = describe { name: "x" }

quiet : Options
quiet = { loud: False, name: "x" }
