module Show

import Todo

route Show = GET "/todos/{id}" { id: Todo.TodoId }

type Model = { n: Int }

Show.load : Show.Params -> Session -> Query Model
Show.load params session = {
  let _ <- Db.delete Todo params.id
  Query.succeed { n: 0 }
}

Show.view : Model -> Session -> Html
Show.view model session = <p>{Text.fromInt model.n}</p>
