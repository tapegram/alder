module Charges

import Payments

route Charges = GET "/charges" { }

type Model = { count: Int }

-- A page runs in production, where the fake's table does not exist.
Charges.load : Charges.Params -> Session -> Query Model
Charges.load params session = {
  let n <- Db.from Payments.Charge |> Db.count
  Query.succeed { count: n }
}

Charges.view : Model -> Session -> Html
Charges.view model session = <p>{Text.fromInt model.count}</p>
