module Todos

route Index = GET "/"      { }
route Page  = GET "/page"  { n: Int = 1 }

-- the browser sends what the user typed: the route must decode any text
Index.load : Index.Params -> Session -> Query Int
Index.load params session = Query.succeed 1

Index.view : Int -> Session -> Html
Index.view n session = <select name="n" input={Page { n: n }}><option>1</option></select>

Page.load : Page.Params -> Session -> Query Int
Page.load params session = Query.succeed params.n

Page.view : Int -> Session -> Html
Page.view n session = <p id="page">{Text.fromInt n}</p>
