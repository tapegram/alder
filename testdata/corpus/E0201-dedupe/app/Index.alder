module Index

route Index = GET "/" { }

type Model = { count: Int, done: Int }

Index.load : Index.Params -> Session -> Query Model
Index.load params session = {
  let todos <- Db.from Todo |> Db.all
  let done <-
    Db.from Todo
      |> Db.where (Todo.done.eq True)
      |> Db.all
  Query.succeed { count: List.length todos, done: List.length done }
}

Index.view : Model -> Session -> Html
Index.view model session = <p>{Text.fromInt model.count}</p>
