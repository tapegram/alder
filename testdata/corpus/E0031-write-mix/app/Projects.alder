module Projects

import Audit
import AuditLog
import Board
import Org
import Project

route Projects = GET  "/projects"          { } requires user, org, team
route Create   = POST "/projects" { } requires user, org, team
route Helped   = POST "/projects/helper" { } requires user, org, team
route Many     = POST "/projects/batch"   { } requires user, org, team
route Silos    = POST "/projects/silo"  { } requires user, org, team
route Reads    = POST "/projects/reader"  { } requires user, org, team
route Bound    = POST "/projects/bound"  { } requires user, org, team
route Lambda   = POST "/projects/lambda" { } requires user, org, team
route Mapped   = POST "/projects/map" { } requires user, org, team
route Other    = POST "/projects/other"  { } requires user, org, team

type Model = { }

Projects.load : Projects.Params -> Session -> Query Model
Projects.load params session = Query.succeed {}

-- a helper of this module: a shared write
note : Text -> Task Unit
note text = Audit.log text

-- the spec's case: a silo write and a shared write in one Task
Create.post : Create.Params -> Session -> Task Response
Create.post params session = {
  let _ <- Db.insertScoped Project { name: "p" }
  let _ <- Db.insert AuditLog { text: "created p" }
  Task.succeed Response.refresh
}

-- the shared write hides in a helper (of this module, then of another)
Helped.post : Helped.Params -> Session -> Task Response
Helped.post params session = {
  let _ <- Db.insertScoped Project { name: "p" }
  let _ <- note "created p"
  Task.succeed Response.refresh
}

-- and in a Task.all over List.map
Many.post : Many.Params -> Session -> Task Response
Many.post params session = {
  let _ <- Task.all (List.map (\t -> Audit.log t) ["a", "b"])
  let _ <- Db.insertScoped Project { name: "p" }
  Task.succeed Response.refresh
}

-- two silos
Silos.post : Silos.Params -> Session -> Task Response
Silos.post params session = {
  let _ <- Db.insertScoped Project { name: "p" }
  let _ <- Db.insertScoped Board { name: "b" }
  Task.succeed Response.refresh
}

-- reads of the other stores are fine
Reads.post : Reads.Params -> Session -> Task Response
Reads.post params session = {
  let _ <- Db.from AuditLog |> Db.all
  let _ <- Db.scoped Board |> Db.all
  let _ <- Db.get Org session.org
  let _ <- Db.insertScoped Project { name: "p" }
  Task.succeed Response.refresh
}

-- a Db write that is not applied in place is found by its type: bound by a let,
Bound.post : Bound.Params -> Session -> Task Response
Bound.post params session = {
  let ins = Db.insert
  let _ <- ins AuditLog { text: "created p" }
  let _ <- Db.insertScoped Project { name: "p" }
  Task.succeed Response.refresh
}

-- passed to a lambda that applies it,
Lambda.post : Lambda.Params -> Session -> Task Response
Lambda.post params session = {
  let _ <- (\f -> f AuditLog { text: "created p" }) Db.insert
  let _ <- Db.insertScoped Project { name: "p" }
  Task.succeed Response.refresh
}

-- or partially applied and mapped
Mapped.post : Mapped.Params -> Session -> Task Response
Mapped.post params session = {
  let logs <- Db.from AuditLog |> Db.all
  let _ <- Task.all (List.map (Db.delete AuditLog) (List.map (\l -> l.id) logs))
  let _ <- Db.insertScoped Project { name: "p" }
  Task.succeed Response.refresh
}

Other.post : Other.Params -> Session -> Task Response
Other.post params session = {
  let _ <- Db.insert AuditLog { text: "other" }
  let _ <- Db.insertScoped Board { name: "b" }
  Task.succeed Response.refresh
}

Projects.view : Model -> Session -> Html
Projects.view model session = <p>x</p>
