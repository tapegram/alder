module App

import Org
import Team
import User

session {
  user: Maybe User.UserId,
  org: Maybe Org.OrgId via Membership,
  team: Maybe Team.TeamId,
  role: User.Role = Reader,
}

login = Login.Login

choose org = Orgs.Orgs

silo org { Project }

silo team { Board }

error : Error -> Html Never
error err = <p>error</p>

notFound : Html Never
notFound = <p>not found</p>
