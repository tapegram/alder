module App

import Org
import User

session {
  user: Maybe User.UserId,
  org: Maybe Org.OrgId via Membership,
  team: Maybe Org.OrgId,
  region: Text,
  role: User.Role = Reader,
}

login = Login.Login

choose org = Orgs.Orgs

silo org { Project, Note, Project, Nowhere, Board }

silo team { Team, Board }

silo org { Project }

silo region { Note }

silo nothing { Note }

error : Error -> Html
error err = <p>error</p>

notFound : Html
notFound = <p>not found</p>
