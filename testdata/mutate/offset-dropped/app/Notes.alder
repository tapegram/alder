module Notes

import Note

pageOf : Int -> Query (List Note)
pageOf n =
  Db.from Note
    |> Db.orderBy Note.rank.asc
    |> Db.limit 10
    |> Db.offset (n * 10)
    |> Db.all

-- A select extending another: the steps' own lines.
later : Select Note -> Int -> Query (List Note)
later base n =
  base
    |> Db.where (Note.pinned.eq False)
    |> Db.offset n
    |> Db.all
