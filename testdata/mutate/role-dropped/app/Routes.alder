module Routes

-- A route's role clause, as a page's: one mutant drops it; Open has no role clause.
route Show = GET  "/routes"        { } requires user, role Admin
route Save = POST "/routes/_/Save" { } requires user, role Author | Admin
route Open = POST "/routes/_/Open" { } requires user

type Model = { }

Show.load : Show.Params -> Session -> Query Model
Show.load params session = Query.succeed { }

Save.update : Save.Params -> Session -> Task Response
Save.update p session = Task.succeed Response.refresh

Open.update : Open.Params -> Session -> Task Response
Open.update p session = Task.succeed Response.refresh

Show.view : Model -> Session -> Html
Show.view model session = <p>Routes</p>
