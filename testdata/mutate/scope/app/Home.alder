module Home

-- Only `helper` and `load` are mutated: never a test, a fake, a view, a component, a value
-- whose result is Html, or a brand's `where`.

type Small = brand Int where (\n -> n < 10 && True)

capability Clock {
  now : Task Int,
}

fake Clock {
  now = if True then Task.succeed (1 + 1) else Task.notFound
}

helper : Int -> Bool
helper n = n > 1

route Home = GET "/" { }

type Model = { n: Int }

Home.load : Home.Params -> Session -> Query Model
Home.load params session = Query.succeed { n: if helper 2 then 1 else 0 }

Home.view : Model -> Session -> Html
Home.view model session =
  <div>
    {if model.n == 1 && True then "one" else "other"}
    <Badge on={model.n > 0} />
    {row (model.n >= 2)}
  </div>

Badge : { on: Bool } -> Html
Badge props = <span>{if props.on == True then "on" else "off"}</span>

row : Bool -> Html
row b = match b {
  True -> <p>yes</p>,
  False -> <p>no</p>,
}

test "helper" = helper 2 == True && (False || 1 < 2)

test "with the fake" = {
  let _ <- Test.fake Clock
  let n <- Clock.now
  Task.succeed (if n == 2 then True else False)
}
