module Home

route Home   = GET  "/"         { }
route Notify = POST "/_/Notify" { }

type Model = { }

Home.load : Home.Params -> Session -> Query Model
Home.load params session = Query.succeed { }

-- Mutants: each notice dropped, one at a time (and the refresh under them answers invalid).
Notify.update : Notify.Params -> Session -> Task Response
Notify.update p session =
  Task.succeed (
    Response.refresh
      |> Response.toast "Saved"
      |> Response.success "Done"
      |> Response.warning "Careful"
      |> Response.error "Oops"
  )

Home.view : Model -> Session -> Html
Home.view model session = <p>Home</p>
