module Peek

import Item

route Peek   = GET  "/peek/{id}"          { id: Item.ItemId } requires user
route Rename = POST "/peek/{id}/_/Rename" { id: Item.ItemId } requires user

type Model = { item: Item }

-- load reads the item unscoped: anyone's item, so the scoped write's `scope dropped` is a mutant
Peek.load : Peek.Params -> Session -> Query Model
Peek.load params session = {
  let found <- Db.get Item params.id
  match found {
    Just item -> Query.succeed { item: item },
    Nothing -> Query.notFound,
  }
}

Rename.update : Rename.Params -> Session -> Task Response
Rename.update p session = {
  let _ <- Db.updateMine Item p.id (\i -> { i | title: "peeked" })
  Task.succeed Response.refresh
}

Peek.view : Model -> Session -> Html
Peek.view model session = <p>{model.item.title}</p>
