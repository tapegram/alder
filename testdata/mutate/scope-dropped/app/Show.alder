module Show

import Item

route Show   = GET  "/items/{id}"          { id: Item.ItemId } requires user
-- load reads the item with Db.getMine, but a write route does not run load: its scoped write of
-- p.id is not covered by it, so its `scope dropped` is a mutant
route Rename = POST "/items/{id}" { id: Item.ItemId } requires user
route Remove = DELETE "/items/{id}" { id: Item.ItemId } requires user

type Model = { item: Item }

-- a Query: the replacement is Db.get matched, Nothing → Query.notFound
Show.load : Show.Params -> Session -> Query Model
Show.load params session = {
  let item <- Db.getMine Item params.id
  Query.succeed { item: item }
}

Show.view : Model -> Session -> Html
Show.view model session = <p>{model.item.title}</p>

Rename.update : Rename.Params -> Session -> Task Response
Rename.update p session = {
  let _ <- Db.updateMine Item p.id (\i -> { i | title: "renamed" })
  Task.succeed Response.refresh
}

Remove.update : Remove.Params -> Session -> Task Response
Remove.update p session = {
  let _ <- Db.deleteMine Item p.id
  Task.succeed Response.refresh
}
