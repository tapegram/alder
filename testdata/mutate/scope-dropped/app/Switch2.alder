module Switch2

import Item

route Switch2 = GET  "/switch2/{id}"        { id: Item.ItemId } requires user
route Drop    = POST "/switch2/{id}" { id: Item.ItemId } requires user

type Model = { item: Item }

Switch2.load : Switch2.Params -> Session -> Query Model
Switch2.load params session = {
  let item <- Db.getMine Item params.id
  Query.succeed { item: item }
}

-- a helper of Task type may put the session (this one does): its `scope dropped` is a mutant
hop : Task Unit
hop = Session.put (\s -> { s | user: Nothing })

Drop.update : Drop.Params -> Session -> Task Response
Drop.update p session = {
  let _ <- hop
  let _ <- Db.deleteMine Item p.id
  Task.succeed Response.refresh
}

Switch2.view : Model -> Session -> Html
Switch2.view model session = <p>{model.item.title}</p>
