module Switch2

import Item

page "/switch2/{id}" { id: Item.ItemId } requires user

type Model = { item: Item }

load : Params -> Session -> Query Model
load params session = {
  let item <- Db.getMine Item params.id
  Query.succeed { item: item }
}

-- a helper of Task type may put the session (this one does): its `scope dropped` is a mutant
hop : Task Unit
hop = Session.put (\s -> { s | user: Nothing })

msg Drop

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  Drop p -> {
    let _ <- hop
    let _ <- Db.deleteMine Item model.item.id
    Task.succeed Rerender
  },
}

view : Model -> Session -> Html Msg
view model session = <p>{model.item.title}</p>
