module Switch

import Item

route Switch = GET  "/switch/{id}"        { id: Item.ItemId } requires user
route Drop   = POST "/switch/{id}/_/Drop" { id: Item.ItemId } requires user

type Model = { item: Item }

Switch.load : Switch.Params -> Session -> Query Model
Switch.load params session = {
  let item <- Db.getMine Item params.id
  Query.succeed { item: item }
}

-- a Session.put in update: the scoped write after it acts for the session it put, not the user
-- load read the item for, so its `scope dropped` is a mutant
Drop.update : Drop.Params -> Session -> Task Response
Drop.update p session = {
  let _ <- Session.put (\s -> { s | user: Nothing })
  let _ <- Db.deleteMine Item p.id
  Task.succeed Response.refresh
}

Switch.view : Model -> Session -> Html
Switch.view model session = <p>{model.item.title}</p>
