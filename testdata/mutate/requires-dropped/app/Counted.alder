module Counted

-- Refused: `visits` is an Int, which has no placeholder.
route Counted = GET "/counted" { } requires visits

type Model = { visits: Int }

Counted.load : Counted.Params -> Session -> Query Model
Counted.load params session = Query.succeed { visits: session.visits }

Counted.view : Model -> Session -> Html
Counted.view model session = <p>Counted</p>
