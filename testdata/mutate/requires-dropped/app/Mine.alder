module Mine

import User

-- A mutant: the session's user is a brand over Text, so the page can be served with a placeholder.
route Mine = GET "/mine" { } requires user

type Model = { user: User.UserId }

Mine.load : Mine.Params -> Session -> Query Model
Mine.load params session = Query.succeed { user: session.user }

Mine.view : Model -> Session -> Html
Mine.view model session = <p>Mine</p>
