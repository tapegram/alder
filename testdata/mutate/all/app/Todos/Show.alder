module Todos.Show

import Layout
import Todo

route Show   = GET  "/todos/{id}"          { id: Todo.TodoId }               requires user
-- The write routes take the id from their path, as the page does. No `load` runs before them,
-- so each checks again that the session's user owns the todo (owned; book 06, "Authorize in
-- update").
route Save   = POST "/todos/{id}"   { id: Todo.TodoId } form EditTodo requires user
route Delete = DELETE "/todos/{id}" { id: Todo.TodoId }               requires user

type Model = { todo: Todo }

Show.load : Show.Params -> Session -> Query Model
Show.load params session = {
  let found <- Db.get Todo params.id
  match found {
    Just todo ->
      if todo.owner == session.user then Query.succeed { todo: todo } else Query.notFound,
    Nothing -> Query.notFound,
  }
}

form EditTodo = { title: Text.NonEmpty, due: Maybe Date }

owned : Todo.TodoId -> Show.Session -> Task Todo
owned id session = {
  let found <- Db.get Todo id
  match found {
    Just todo -> if todo.owner == session.user then Task.succeed todo else Task.notFound,
    Nothing -> Task.notFound,
  }
}

Save.update : Save.Params -> Session -> Task Response
Save.update p session = {
  let todo <- owned p.id session
  let _ <- Db.update Todo todo.id (\t -> { t | title: p.form.title, due: p.form.due })
  Task.succeed (Response.redirect (Todos.Index.Index {}))
}

Delete.update : Delete.Params -> Session -> Task Response
Delete.update p session = {
  let todo <- owned p.id session
  let _ <- Db.delete Todo todo.id
  Task.succeed (Response.redirect (Todos.Index.Index {}))
}

Show.view : Model -> Session -> Html
Show.view model session =
  <Layout.Page title={model.todo.title}>
    <h1>{model.todo.title}</h1>
    <form submit={Save { id: model.todo.id }}>
      <Input field="title" label="Title" value={model.todo.title} />
      <Errors field="title" />
      <Input field="due" label="Due" value={model.todo.due} />
      <Errors field="due" />
      <button>Save</button>
    </form>
    <button click={Delete { id: model.todo.id }}>Delete</button>
    <a href={Todos.Index.Index {}}>Back</a>
  </Layout.Page>
