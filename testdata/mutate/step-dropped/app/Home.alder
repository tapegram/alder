module Home

import User

route Home   = GET  "/"         { }
route Save   = POST "/_/Save"   { }
route Login  = POST "/_/Login"  { id: User.UserId }

type Model = { }

Home.load : Home.Params -> Session -> Query Model
Home.load params session = Query.succeed { }

-- Mutants: the access check dropped (a Query step in a Task); a Task step too; a step of a List
-- of Unit (a bulk action's writes) becomes `Task.succeed []`. Refused: the insert and the count
-- (their results are neither Unit nor a List of Unit), the step that does nothing, the delete
-- (write replaced makes the same program), the inline check whose guard dropped makes the same
-- program.
Save.update : Save.Params -> Session -> Task Response
Save.update p session = {
  let _ <- User.adminOnly session.user
  let _ <- User.audit "save"
  let id <- Db.insert User.User { name: "U" }
  let _ <- Db.insert User.User { name: "V" }
  let _ <- Task.succeed ()
  let _ <- Db.from User.User |> Db.count
  let _ <- Task.all (List.map (\n -> User.audit n) ["a", "b"])
  let _ <- Db.delete User.User id
  let _ <- if session.user == Nothing then Task.notFound else Task.succeed ()
  Task.succeed Response.refresh
}

-- Refused: session put dropped makes the same program.
Login.update : Login.Params -> Session -> Task Response
Login.update p session = {
  let _ <- Session.put (\s -> { s | user: Just p.id })
  Task.succeed Response.refresh
}

Home.view : Model -> Session -> Html
Home.view model session = <p>Home</p>
