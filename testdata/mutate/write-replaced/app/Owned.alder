module Owned

import Own

route Owned = GET "/owned" { } requires user

type Model = { }

Owned.load : Owned.Params -> Session -> Query Model
Owned.load params session = Query.succeed {}

-- A mutant per scoped write step too (M11).
churnMine : Text -> Task Own.OwnId
churnMine t = {
  let id <- Db.insertMine Own { title: t }
  let _ <- Db.updateMine Own id (\o -> { o | title: "x" })
  let _ <- Db.deleteMine Own id
  Task.succeed id
}

Owned.view : Model -> Session -> Html
Owned.view model session = <p>Owned</p>
