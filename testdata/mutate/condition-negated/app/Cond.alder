module Cond

big : Int -> Bool
big n = n > 3

-- A mutant: the condition is a call.
size : Int -> Text
size n = if big n then "big" else "small"

-- A mutant: `&&` is flipped to `||`, which is not the negation.
both : Bool -> Bool -> Int
both a b = if a && b then 1 else 0

-- A mutant: negating `<` is `>=`, which operator flipped (`<=`) does not make.
small : Int -> Text
small n = if n < 3 then "small" else "big"

-- Skipped: negating `==` is the program operator flipped makes (`!=`).
zero : Int -> Text
zero n = if n == 0 then "none" else "some"

-- Skipped: negating `not e` is the program not dropped makes.
odd : Bool -> Text
odd b = if not b then "no" else "yes"

-- Refused: a literal condition.
fixed : Int
fixed = if True then 1 else 2
