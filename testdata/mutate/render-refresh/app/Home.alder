module Home

route Home = GET  "/"       { }
route Show = POST "/" { }

type Model = { }

Home.load : Home.Params -> Session -> Query Model
Home.load params session = Query.succeed { }

-- A mutant: the update refreshes the page instead of rendering the route.
Show.update : Show.Params -> Session -> Task Response
Show.update p session = Task.succeed (Response.render (Home {}))

Home.view : Model -> Session -> Html
Home.view model session = <p>Home</p>
