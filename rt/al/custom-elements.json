            {
              "name": "variant",
              "type": {
                "text": "\"primary\" | \"secondary\" | \"outline\" | \"ghost\" | \"destructive\""
              },
              "description": "The button's look.",
              "default": "\"primary\""
            },
            {
              "name": "size",
              "type": {
                "text": "\"sm\" | \"md\" | \"lg\""
              },
              "description": "The button's size."
            },
            {
              "name": "disabled",
              "type": {
                "text": "boolean"
              },
              "description": "Shows the button as disabled."
            },
            {
              "name": "type",
              "type": {
                "text": "\"button\" | \"submit\""
              },
              "description": "The kind of the button."
            }
          ],
          "slots": [
            {
              "name": "",
              "description": "The button's label."
            }
          ]
        }
      ]
    },
