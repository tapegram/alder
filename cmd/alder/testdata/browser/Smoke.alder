module Smoke

import Layout

-- The smoke test's page of the interactive elements, written as Appendix C writes them: added
-- to the copy of the blog the browser test serves (browser_test.go), never to the example.
page "/smoke" { }

type Model = { }

load : Params -> Session -> Query Model
load params session = Query.succeed { }

view : Model -> Session -> Html Msg
view model session =
  <Layout.Page title="Smoke">
    <h1>Smoke</h1>
    <al-button variant="outline"><button type="button" id="more-button" commandfor="more" command="toggle-popover">More</button></al-button>
    <al-menu id="more" popover>
      <a href={Posts.Index {}}>Home</a>
      <button type="button">Second</button>
    </al-menu>
    <al-button variant="outline"><button type="button" id="who-button" popovertarget="who">Who can see this?</button></al-button>
    <al-popover id="who" popover placement="bottom">Only people with the link.</al-popover>
    <al-tabs>
      <al-tab name="view" selected>
        <label><input type="radio" name="view" checked /> Details</label>
        <al-panel>The post's fields.</al-panel>
      </al-tab>
      <al-tab name="view">
        <label><input type="radio" name="view" /> Comments</label>
        <al-panel>Its comments.</al-panel>
      </al-tab>
    </al-tabs>
    <al-button variant="ghost"><button type="button" id="save-help" title="Saves a draft">?</button></al-button>
    <al-tooltip for="save-help">Saves a draft</al-tooltip>
    <al-button><button type="button" id="own-button" commandfor="own" command="show-modal">Open</button></al-button>
    <al-dialog size="sm">
      <dialog id="own" closedby="any" aria-labelledby="own-title">
        <h2 slot="header" id="own-title">Your own</h2>
        <p>Written by hand.</p>
        <div slot="actions"><button type="button" commandfor="own" command="close">Close</button></div>
      </dialog>
    </al-dialog>
  </Layout.Page>
