module SmokeFile

-- A file page for the browser smoke test: a link to it must load a document, not morph.
route SmokeFile = GET "/smoke.txt" { }

type Model = { }

SmokeFile.load : SmokeFile.Params -> Session -> Query Model
SmokeFile.load params session = Query.succeed {}

SmokeFile.view : Model -> Session -> File
SmokeFile.view model session = File.text { contentType: "text/plain", body: "smoke file" }
