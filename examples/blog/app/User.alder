module User

type UserId = brand Text

-- A Reader can comment; an Author can also write posts (the Admin pages).
type Role = Reader | Author

table User {
  id: UserId @id,
  email: Text.Email @unique,
  name: Text.NonEmpty,
  passwordHash: Text,
  role: Role = Reader,
  created: Time @created,
}

isAuthor : User -> Bool
isAuthor user = user.role == Author
