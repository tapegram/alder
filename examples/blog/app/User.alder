module User

type UserId = brand Text

-- Anyone, logged in or not, can read and comment. An Author can also write posts: the Admin
-- pages `requires user, role Author`, so they are a 404 for a Reader. The session holds the
-- role the user had when they logged in (App's `session`).
type Role = Reader | Author

table User {
  id: UserId @id,
  email: Text.Email @unique,
  name: Text.NonEmpty,
  passwordHash: Text,
  role: Role = Reader,
  created: Time @created,
}

-- isAuthor is the re-read idiom (book 06, "Rules"): whether the user's row says Author now, not
-- the role the session got at login. The Admin pages call it in their `load`, so an author made a
-- Reader is turned away at once, without waiting for them to log in again.
isAuthor : UserId -> Query Bool
isAuthor id = {
  let me <- Db.get User id
  Query.succeed (Maybe.map (\u -> u.role) me == Just Author)
}
