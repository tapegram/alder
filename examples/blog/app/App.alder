module App

import Layout
import User

-- `role` is the user's role, copied from their row when they log in (Auth.Login): the Write
-- pages' `requires user, role Author` reads it from here, never from the database (book 06,
-- "Rules"). A visitor, and anyone who logs out, is a Reader.
session { user: Maybe User.UserId, role: User.Role = Reader }

login = Auth.Login

msg Logout

update : Msg -> Session -> Task Nav
update msg session = match msg {
  Logout p -> {
    let _ <- Session.put (\s -> { s | user: Nothing, role: Reader })
    Task.succeed (Redirect (Auth.Login {}))
  },
}

error : Error -> Html Never
error err =
  <Layout.Page title="Error">
    <h1>Something went wrong</h1>
    <p>Please try again.</p>
  </Layout.Page>

notFound : Html Never
notFound = <Layout.Page title="Not found"><h1>Not found</h1></Layout.Page>

-- Where `alder deploy` ships the app (book 16). `local` runs a script; nothing here is a secret.
deploy { local: Script "./scripts/deploy-local.sh" }
