-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Comments.Edit

-- @admin begin imports
import Admin.Layout
import Table.Comment
import Table.Post
import Table.User
-- @admin end

-- @admin begin routes
route Edit = GET "/admin/comment/{id}/edit" { id: Comment.CommentId, findPost: Text = "" } requires user, role Admin
route Save = PUT "/admin/comment/{id}"      { id: Comment.CommentId } form CommentForm     requires user, role Admin
-- @admin end

type Model = {
  row: Comment,
  -- @admin begin model
  posts: List Post,
  postsTotal: Int,
  findPost: Text,
  -- @admin end
}

Edit.load : Edit.Params -> Session -> Query Model
Edit.load params session = {
  let _ <- Layout.adminOnly session.user
  -- @admin begin load
  let found <- Db.get Comment params.id
  match found {
    Just row -> {
      let findPost = Text.slice 0 200 params.findPost
      let postsTotal <- Db.from Post |> Db.count
      let postsOwn <-
        if postsTotal > 200 then
          Db.from Post
            |> Db.where (Post.id.eq row.post)
            |> Db.all
        else
          Query.succeed []
      let postsFound <-
        Db.from Post
          |> Db.orderBy Post.slug.asc
          |> Db.where (
            if postsTotal > 200 then
              Db.and [Post.slug.contains findPost, Post.id.ne row.post]
            else
              Db.and []
          )
          |> Db.limit (if postsTotal > 200 then 50 else 200)
          |> Db.all
      let posts = postsOwn ++ postsFound
      Query.succeed {
        row: row,
        posts: posts,
        postsTotal: postsTotal,
        findPost: findPost,
      }
    },
    Nothing -> Query.notFound,
  }
  -- @admin end
}

-- @admin begin form
form CommentForm = {
  post: Post.PostId,
  author: Comment.Name,
  body: Comment.Body,
}
-- @admin end

-- @admin begin search
-- @admin end

-- Save writes the form over the row (a row deleted since is not found) and goes to its page.
Save.update : Save.Params -> Session -> Task Response
Save.update params session = {
  let _ <- Layout.adminOnly session.user
  let found <- Db.get Comment params.id
  match found {
    Just row -> {
      -- @admin begin update
      let _ <- Db.update Comment row.id (\r -> { r |
        post: params.form.post,
        author: params.form.author,
        body: params.form.body
      })
      Task.succeed (Response.redirect (Admin.Comments.Show.Show { id: row.id }))
      -- @admin end
    },
    Nothing -> Task.notFound,
  }
}

Edit.view : Model -> Session -> Html
Edit.view model session =
  <Layout.Page title="Edit comment">
    <h1>Edit comment</h1>

    <al-card>
      -- @admin begin finder
      {if model.postsTotal > 200 then
        <form method="get">
          <al-input>
            <label>Find post <input type="search" name="findPost" value={model.findPost} /></label>
          </al-input>
          <al-button type="submit" variant="secondary">Find</al-button>
        </form>
      else
        Html.none}
      -- @admin end
      <form submit={Save { id: model.row.id }}>
        -- @admin begin inputs
        <al-select
          field="post"
          label="Post"
          options={List.map (\r -> { value: r.id, label: r.slug }) model.posts}
          value={model.row.post} />
        <al-input field="author" label="Author" value={model.row.author} />
        <al-textarea field="body" label="Body" value={model.row.body} />
        -- @admin end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Save</al-button>
      </form>
    </al-card>
    <a href={Admin.Comments.Show.Show { id: model.row.id }}>Back</a>
  </Layout.Page>

-- @admin begin tests
test "saving changes every field" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    slug: Post.Slug "slug-1",
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let comment1 <- Db.insert Comment {
    post: post1,
    author: Comment.Name "author-1",
    body: Comment.Body "body-1",
  }
  let post2 <- Db.insert Post {
    slug: Post.Slug "slug-2",
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let page <- Test.get (Edit { id: comment1 })
  let r <- Test.submit (Save { id: comment1 }) {
    post: post2,
    author: Comment.Name "author-2",
    body: Comment.Body "body-2",
  }
  let after <- Db.get Comment comment1
  Task.succeed (
    {
      answer: r.answer,
      row: Maybe.map (\row -> {
        post: row.post,
        author: row.author,
        body: row.body,
      }) after,
      posts: Test.texts "select[name=post] option" page.doc,
    } == {
      answer: Redirected (Admin.Comments.Show.Show { id: comment1 }),
      row: Just {
        post: post2,
        author: Comment.Name "author-2",
        body: Comment.Body "body-2",
      },
      posts: ["slug-1", "slug-2"],
    }
  )
}

test "a post not offered is refused" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    slug: Post.Slug "slug-1",
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let comment1 <- Db.insert Comment {
    post: post1,
    author: Comment.Name "author-1",
    body: Comment.Body "body-1",
  }
  let post2 <- Db.insert Post {
    slug: Post.Slug "slug-2",
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let page <- Test.get (Edit { id: comment1 })
  let r <- Test.submitRaw (Save { id: comment1 }) [
    { name: "post", value: "missing" },
    { name: "author", value: "x" },
    { name: "body", value: "x" },
  ]
  let after <- Db.get Comment comment1
  Task.succeed (
    { answer: r.answer, post: Maybe.map (\row -> row.post) after }
      == {
        answer: FormRejected [{ field: "post", message: "must be one of the options" }],
        post: Just post1,
      }
  )
}

test "a list of 200 posts is offered whole" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    slug: Post.Slug "slug-1",
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let comment1 <- Db.insert Comment {
    post: post1,
    author: Comment.Name "author-1",
    body: Comment.Body "body-1",
  }
  let post2 <- Db.insert Post {
    slug: Post.Slug "slug-2",
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Post {
        slug: Post.Slug ("slug-" ++ Text.fromInt n),
        title: Text.NonEmpty ("title-" ++ Text.fromInt n),
        body: "body-" ++ Text.fromInt n,
        author: me,
      }) (List.range 3 200)
    )
  let page <- Test.get (Edit { id: comment1 })
  Task.succeed (List.length page.model.posts == 200)
}

test "a long list of posts offers 50, and the search narrows it" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    slug: Post.Slug "slug-1",
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let comment1 <- Db.insert Comment {
    post: post1,
    author: Comment.Name "author-1",
    body: Comment.Body "body-1",
  }
  let post2 <- Db.insert Post {
    slug: Post.Slug "slug-2",
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Post {
        slug: Post.Slug ("slug-" ++ Text.fromInt n),
        title: Text.NonEmpty ("title-" ++ Text.fromInt n),
        body: "body-" ++ Text.fromInt n,
        author: me,
      }) (List.range 3 203)
    )
  let all <- Test.get (Edit { id: comment1 })
  let found <- Test.get (Edit { id: comment1, findPost: "slug-203" })
  Task.succeed (
    {
      shown: List.length all.model.posts,
      total: all.model.postsTotal,
      found: Test.count "select[name=post] option" found.doc <= 3,
      input: Test.attr "value" "input[name=findPost]" found.doc,
    } == {
      shown: 51,
      total: 203,
      found: True,
      input: Just "slug-203",
    }
  )
}

test "the row's own post is offered first when it sorts past the 50" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    slug: Post.Slug "zz-1",
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let comment1 <- Db.insert Comment {
    post: post1,
    author: Comment.Name "author-1",
    body: Comment.Body "body-1",
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Post {
        slug: Post.Slug ("slug-" ++ Text.fromInt n),
        title: Text.NonEmpty ("title-" ++ Text.fromInt n),
        body: "body-" ++ Text.fromInt n,
        author: me,
      }) (List.range 2 202)
    )
  let page <- Test.get (Edit { id: comment1 })
  let r <- Test.submit (Save { id: comment1 }) {
    post: page.model.row.post,
    author: page.model.row.author,
    body: page.model.row.body,
  }
  let after <- Db.get Comment comment1
  Task.succeed (
    {
      answer: r.answer,
      kept: Maybe.map (\row -> row.post) after,
      first: Maybe.map (\o -> o.id) (List.head page.model.posts),
      once: List.length (List.filter (\o -> o.id == post1) page.model.posts),
      shown: List.length page.model.posts,
    } == {
      answer: Redirected (Admin.Comments.Show.Show { id: comment1 }),
      kept: Just post1,
      first: Just post1,
      once: 1,
      shown: 51,
    }
  )
}

test "a visitor cannot save a comment" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    slug: Post.Slug "slug-1",
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let comment1 <- Db.insert Comment {
    post: post1,
    author: Comment.Name "author-1",
    body: Comment.Body "body-1",
  }
  let post2 <- Db.insert Post {
    slug: Post.Slug "slug-2",
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let before <- Db.get Comment comment1
  let _ <- Test.get (Edit { id: comment1 })
  let _ <- Test.login { user: Nothing }
  let r <- Test.submit (Save { id: comment1 }) {
    post: post2,
    author: Comment.Name "author-2",
    body: Comment.Body "body-2",
  }
  let after <- Db.get Comment comment1
  Task.succeed (
    { answer: r.answer, row: after } == { answer: Redirected (Auth.Login.Login {}), row: before }
  )
}

test "a Reader cannot save a comment, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    slug: Post.Slug "slug-1",
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let comment1 <- Db.insert Comment {
    post: post1,
    author: Comment.Name "author-1",
    body: Comment.Body "body-1",
  }
  let post2 <- Db.insert Post {
    slug: Post.Slug "slug-2",
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let before <- Db.get Comment comment1
  let _ <- Test.get (Edit { id: comment1 })
  let _ <- Test.login { user: Just me, role: Reader }
  let r <- Test.submit (Save { id: comment1 }) {
    post: post2,
    author: Comment.Name "author-2",
    body: Comment.Body "body-2",
  }
  let after <- Db.get Comment comment1
  Task.succeed ({ answer: r.answer, row: after } == { answer: PageMissing, row: before })
}

test "a demoted Admin cannot save a comment" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    slug: Post.Slug "slug-1",
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let comment1 <- Db.insert Comment {
    post: post1,
    author: Comment.Name "author-1",
    body: Comment.Body "body-1",
  }
  let post2 <- Db.insert Post {
    slug: Post.Slug "slug-2",
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let before <- Db.get Comment comment1
  let _ <- Test.get (Edit { id: comment1 })
  let _ <- Db.update User me (\u -> { u | role: Reader })
  let r <- Test.submit (Save { id: comment1 }) {
    post: post2,
    author: Comment.Name "author-2",
    body: Comment.Body "body-2",
  }
  let after <- Db.get Comment comment1
  Task.succeed (
    { answer: r.answer, row: after } == { answer: RequestFailed "400 bad request", row: before }
  )
}

test "a missing row is not found" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let r <- Test.open (Edit { id: Comment.CommentId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "a visitor is sent to log in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
  }
  let post1 <- Db.insert Post {
    slug: Post.Slug "slug-1",
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let comment1 <- Db.insert Comment {
    post: post1,
    author: Comment.Name "author-1",
    body: Comment.Body "body-1",
  }
  let r <- Test.open (Edit { id: comment1 })
  Task.succeed (r.answer == Redirected (Auth.Login.Login {}))
}

