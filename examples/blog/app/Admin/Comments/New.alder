-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Comments.New

-- @admin begin imports
import Admin.Layout
import Table.Comment
import Table.Post
import Table.User
-- @admin end

page "/admin/comment/new" { findPost: Text = "" } requires user, role Admin

type Model = {
  -- @admin begin model
  posts: List Post,
  postsTotal: Int,
  -- @admin end
}

load : Params -> Session -> Query Model
load params session = {
  let admin <- Layout.isAdmin session.user
  if admin then {
    -- @admin begin load
    let findPost = Text.slice 0 200 params.findPost
    let postsTotal <- Db.from Post |> Db.count
    let posts <-
      Db.from Post
        |> Db.orderBy Post.slug.asc
        |> Db.where (if postsTotal > 200 then Post.slug.contains findPost else Db.and [])
        |> Db.limit (if postsTotal > 200 then 50 else 200)
        |> Db.all
    Query.succeed { posts: posts, postsTotal: postsTotal }
    -- @admin end
  } else
    Query.notFound
}

-- @admin begin form
form CommentForm = {
  post: Post.PostId,
  author: Comment.Name,
  body: Comment.Body,
}
-- @admin end

-- @admin begin search
form FindPost = { q: Text }

msg SearchPost form FindPost

-- @admin end

msg Create form CommentForm

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  -- @admin begin finds
  SearchPost p ->
    Task.succeed (Redirect (Admin.Comments.New { findPost: Text.slice 0 200 p.form.q })),
  -- @admin end
  Create p -> {
    -- @admin begin insert
    let id <- Db.insert Comment {
      post: p.form.post,
      author: p.form.author,
      body: p.form.body,
    }
    Task.succeed (Redirect (Admin.Comments.Show { id: id }))
    -- @admin end
  },
}

view : Model -> Session -> Html Msg
view model session =
  <Layout.Page title="New comment">
    <h1>New comment</h1>

    <al-card>
      -- @admin begin finder
      {if model.postsTotal > 200 then
        <form submit={SearchPost}>
          <al-input field="q" label="Find post" />
          <al-button type="submit" variant="secondary">Find</al-button>
        </form>
      else
        <span></span>}
      -- @admin end
      <form submit={Create}>
        -- @admin begin inputs
        <al-select
          field="post"
          label="Post"
          options={List.map (\r -> { value: r.id, label: r.slug }) model.posts} />
        <al-input field="author" label="Author" />
        <al-textarea field="body" label="Body" />
        -- @admin end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Create</al-button>
      </form>
    </al-card>
  </Layout.Page>

-- @admin begin tests
test "creating a comment adds it, with the values submitted" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    slug: Post.Slug "slug-1",
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    slug: Post.Slug "slug-2",
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let page <- Test.get (Admin.Comments.New {})
  let r <- Test.submit CommentForm {
    post: post2,
    author: Comment.Name "author-1",
    body: Comment.Body "body-1",
  }
  let rows <- Db.from Comment |> Db.all
  Task.succeed (
    {
      answers: List.map (\row -> Redirected (Admin.Comments.Show { id: row.id })) rows,
      rows: List.map (\row -> {
        post: row.post,
        author: row.author,
        body: row.body,
      }) rows,
      posts: Test.texts "select[name=post] option" page.doc,
    } == {
      answers: [r.answer],
      rows: [
        {
          post: post2,
          author: Comment.Name "author-1",
          body: Comment.Body "body-1",
        },
      ],
      posts: ["slug-1", "slug-2"],
    }
  )
}

test "a post not offered is refused" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    slug: Post.Slug "slug-1",
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    slug: Post.Slug "slug-2",
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let page <- Test.get (Admin.Comments.New {})
  let r <- Test.submitRaw CommentForm [
    { name: "post", value: "missing" },
    { name: "author", value: "x" },
    { name: "body", value: "x" },
  ]
  let rows <- Db.from Comment |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows }
      == {
        answer: FormRejected [{ field: "post", message: "must be one of the options" }],
        rows: 0,
      }
  )
}

test "a list of 200 posts is offered whole" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    slug: Post.Slug "slug-1",
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    slug: Post.Slug "slug-2",
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Post {
        slug: Post.Slug ("slug-" ++ Text.fromInt n),
        title: Text.NonEmpty ("title-" ++ Text.fromInt n),
        body: "body-" ++ Text.fromInt n,
        author: me,
      }) (List.range 3 200)
    )
  let page <- Test.get (Admin.Comments.New {})
  Task.succeed (List.length page.model.posts == 200)
}

test "a long list of posts offers 50, and the search narrows it" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    slug: Post.Slug "slug-1",
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    slug: Post.Slug "slug-2",
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Post {
        slug: Post.Slug ("slug-" ++ Text.fromInt n),
        title: Text.NonEmpty ("title-" ++ Text.fromInt n),
        body: "body-" ++ Text.fromInt n,
        author: me,
      }) (List.range 3 203)
    )
  let all <- Test.get (Admin.Comments.New {})
  let found <- Test.get (Admin.Comments.New { findPost: "slug-203" })
  let r <- Test.submit FindPost { q: "zz" }
  Task.succeed (
    {
      shown: List.length all.model.posts,
      total: all.model.postsTotal,
      found: Test.texts "select[name=post] option" found.doc == ["slug-203"],
      answer: r.answer,
    } == {
      shown: 50,
      total: 203,
      found: True,
      answer: Redirected (Admin.Comments.New { findPost: "zz" }),
    }
  )
}

test "a post outside the narrowed list is refused" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    slug: Post.Slug "slug-1",
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let post2 <- Db.insert Post {
    slug: Post.Slug "slug-2",
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Post {
        slug: Post.Slug ("slug-" ++ Text.fromInt n),
        title: Text.NonEmpty ("title-" ++ Text.fromInt n),
        body: "body-" ++ Text.fromInt n,
        author: me,
      }) (List.range 3 203)
    )
  let all <- Test.get (Admin.Comments.New {})
  let found <- Test.get (Admin.Comments.New { findPost: "slug-203" })
  let r <- Test.submit FindPost { q: "zz" }
  let pick = Maybe.withDefault "" (Test.attr "value" "select[name=post] option" found.doc)
  let page <- Test.get (Admin.Comments.New {})
  let sent <- Test.submitRaw CommentForm [
    { name: "post", value: pick },
    { name: "author", value: "x" },
    { name: "body", value: "x" },
  ]
  let rows <- Db.from Comment |> Db.count
  Task.succeed (
    { answer: sent.answer, rows: rows }
      == {
        answer: FormRejected [{ field: "post", message: "must be one of the options" }],
        rows: 0,
      }
  )
}

test "a visitor is sent to log in" = {
  let r <- Test.open (Admin.Comments.New {})
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Reader gets no page, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Reader }
  let r <- Test.open (Admin.Comments.New {})
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Reader,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let r <- Test.open (Admin.Comments.New {})
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
