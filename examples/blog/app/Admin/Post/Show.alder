-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Post.Show

-- @admin begin imports
import Admin.Layout
import Post
import User
-- @admin end

page "/admin/post/{id}" { id: Post.PostId } requires user, role Admin

type Model = { row: Post, labels: Labels }

load : Params -> Session -> Query Model
load params session = {
  let admin <- Admin.Layout.isAdmin session.user
  if admin then {
    let found <- Db.get Post params.id
    match found {
      Just row -> {
        let labels <- labelsOf [row]
        Query.succeed { row: row, labels: labels }
      },
      Nothing -> Query.notFound,
    }
  } else Query.notFound
}

-- @admin begin labels
-- Labels are the rows the references of the rows shown name: their links show their labels.
type Labels = { authors: List User }

-- labelsOf reads the rows that rows refer to.
labelsOf : List Post -> Query Labels
labelsOf rows = {
  let authors <- Db.from User |> Db.where (User.id.in (List.map (\row -> row.author) rows)) |> Db.all
  Query.succeed { authors: authors }
}

-- authorLabel is the label of the user id names (the id itself if it names none).
authorLabel : Labels -> User.UserId -> Text
authorLabel labels id = match List.find (\r -> r.id == id) labels.authors {
  Just r -> r.email,
  Nothing -> id,
}
-- @admin end

view : Model -> Session -> Html Msg
view model session =
  <Admin.Layout.Page title="Post">
    <h1>Post</h1>

    <al-card>
      <dl>
        -- @admin begin fields
        <dt>Id</dt>
        <dd>{model.row.id}</dd>
        <dt>Slug</dt>
        <dd>{model.row.slug}</dd>
        <dt>Title</dt>
        <dd>{model.row.title}</dd>
        <dt>Body</dt>
        <dd>{model.row.body}</dd>
        <dt>Published</dt>
        <dd>{if model.row.published then <al-badge>Yes</al-badge> else <al-badge variant="secondary">No</al-badge>}</dd>
        <dt>Author</dt>
        <dd><a href={Admin.User.Show { id: model.row.author }}>{authorLabel model.labels model.row.author}</a></dd>
        <dt>Created</dt>
        <dd>{Time.format "Jan 2, 2006" model.row.created}</dd>
        -- @admin end
      </dl>
      <div slot="actions">
        <al-button href={Admin.Post.Edit { id: model.row.id }}>Edit</al-button>
        <al-button variant="destructive"><button type="button" commandfor="delete-dialog" command="show-modal">Delete</button></al-button>
      </div>
    </al-card>
    <al-dialog id="delete-dialog" heading="Delete this post?" dismissible>
      <p>The next page shows what refers to it before anything is deleted.</p>
      <div slot="actions">
        <al-button variant="destructive" href={Admin.Post.Delete { id: model.row.id }}>Review and delete</al-button>
      </div>
    </al-dialog>
    <a href={Admin.Post.Delete { id: model.row.id }}>Delete without the dialog</a>
    <a href={Admin.Post.Index {}}>All posts</a>
  </Admin.Layout.Page>

-- @admin begin tests
test "the page shows the row" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    slug: Post.Slug "slug-1",
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let r <- Test.open (Admin.Post.Show { id: post1 })
  let page <- Test.get (Admin.Post.Show { id: post1 })
  Task.succeed ({
    answer: r.answer,
    slug: List.member "slug-1" (Test.texts "dd" r.doc),
    authors: List.length page.model.labels.authors,
    authorLabel: authorLabel page.model.labels me,
  } == {
    answer: Shown,
    slug: True,
    authors: 1,
    authorLabel: "email-1@example.com",
  })
}

test "a missing row is not found" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let r <- Test.open (Admin.Post.Show { id: Post.PostId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "a visitor is sent to log in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
  }
  let post1 <- Db.insert Post {
    slug: Post.Slug "slug-1",
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let r <- Test.open (Admin.Post.Show { id: post1 })
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Reader gets no page, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Reader }
  let post1 <- Db.insert Post {
    slug: Post.Slug "slug-1",
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let r <- Test.open (Admin.Post.Show { id: post1 })
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Reader,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    slug: Post.Slug "slug-1",
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let r <- Test.open (Admin.Post.Show { id: post1 })
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
