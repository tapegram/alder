-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Posts.New

-- @admin begin imports
import Admin.Layout
import Table.Post
import Table.User
-- @admin end

-- @admin begin routes
route New          = GET  "/admin/post/new"                { findAuthor: Text = "" } requires user, role Admin
route Create       = POST "/admin/post/new/_/Create"       { } form PostForm         requires user, role Admin
route SearchAuthor = POST "/admin/post/new/_/SearchAuthor" { } form FindAuthor       requires user, role Admin
-- @admin end

type Model = {
  -- @admin begin model
  authors: List User,
  authorsTotal: Int,
  -- @admin end
}

New.load : New.Params -> Session -> Query Model
New.load params session = {
  let _ <- Layout.adminOnly session.user
  -- @admin begin load
  let findAuthor = Text.slice 0 200 params.findAuthor
  let authorsTotal <- Db.from User |> Db.count
  let authors <-
    Db.from User
      |> Db.orderBy User.email.asc
      |> Db.where (if authorsTotal > 200 then User.email.contains findAuthor else Db.and [])
      |> Db.limit (if authorsTotal > 200 then 50 else 200)
      |> Db.all
  Query.succeed { authors: authors, authorsTotal: authorsTotal }
  -- @admin end
}

-- @admin begin form
form PostForm = {
  slug: Post.Slug,
  title: Text.NonEmpty,
  body: Text,
  published: Bool,
  author: User.UserId,
}
-- @admin end

-- @admin begin search
form FindAuthor = { q: Text }

-- SearchAuthor answers the page again at the text.
SearchAuthor.update : SearchAuthor.Params -> Session -> Task Response
SearchAuthor.update params session =
  Task.succeed (Response.redirect (New { findAuthor: Text.slice 0 200 params.form.q }))

-- @admin end

-- Create adds the row and goes to its page.
Create.update : Create.Params -> Session -> Task Response
Create.update params session = {
  let _ <- Layout.adminOnly session.user
  -- @admin begin insert
  let slugTaken <-
    Db.from Post
      |> Db.where (Post.slug.eq params.form.slug)
      |> Db.count
  if slugTaken > 0 then
    Task.succeed (Response.invalid "A post with this slug exists.")
  else {
    let id <- Db.insert Post {
      slug: params.form.slug,
      title: params.form.title,
      body: params.form.body,
      published: params.form.published,
      author: params.form.author,
    }
    Task.succeed (Response.redirect (Admin.Posts.Show.Show { id: id }))
  }
  -- @admin end
}

New.view : Model -> Session -> Html
New.view model session =
  <Layout.Page title="New post">
    <h1>New post</h1>

    <al-card>
      -- @admin begin finder
      {if model.authorsTotal > 200 then
        <form submit={SearchAuthor}>
          <al-input field="q" label="Find author" />
          <al-button type="submit" variant="secondary">Find</al-button>
        </form>
      else
        Html.none}
      -- @admin end
      <form submit={Create}>
        -- @admin begin inputs
        <al-input field="slug" label="Slug" />
        <al-input field="title" label="Title" />
        <al-textarea field="body" label="Body" />
        <al-checkbox field="published" label="Published" value={False} />
        <al-select
          field="author"
          label="Author"
          options={List.map (\r -> { value: r.id, label: r.email }) model.authors} />
        -- @admin end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Create</al-button>
      </form>
    </al-card>
  </Layout.Page>

-- @admin begin tests
test "creating a post adds it, with the values submitted" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let _ <- Db.insert Post {
    slug: Post.Slug "slug-1",
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let page <- Test.get (New {})
  let r <- Test.submit Create {
    slug: Post.Slug "slug-2",
    title: Text.NonEmpty "title-2",
    body: "body-2",
    published: True,
    author: user2,
  }
  let rows <-
    Db.from Post
      |> Db.where (Post.slug.eq (Post.Slug "slug-2"))
      |> Db.all
  Task.succeed (
    {
      answers: List.map (\row -> Redirected (Admin.Posts.Show.Show { id: row.id })) rows,
      rows: List.map (\row -> {
        slug: row.slug,
        title: row.title,
        body: row.body,
        published: row.published,
        author: row.author,
      }) rows,
      authors: Test.texts "select[name=author] option" page.doc,
    } == {
      answers: [r.answer],
      rows: [
        {
          slug: Post.Slug "slug-2",
          title: Text.NonEmpty "title-2",
          body: "body-2",
          published: True,
          author: user2,
        },
      ],
      authors: ["email-1@example.com", "email-2@example.com"],
    }
  )
}

test "a post with a slug that exists is refused" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let _ <- Db.insert Post {
    slug: Post.Slug "slug-1",
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let _ <- Test.get (New {})
  let r <- Test.submit Create {
    slug: Post.Slug "slug-1",
    title: Text.NonEmpty "title-2",
    body: "body-2",
    published: True,
    author: user2,
  }
  let rows <- Db.from Post |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows }
      == { answer: FormRejected [{ field: "", message: "A post with this slug exists." }], rows: 1 }
  )
}

test "an author not offered is refused" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let page <- Test.get (New {})
  let r <- Test.submitRaw Create [
    { name: "slug", value: "x" },
    { name: "title", value: "x" },
    { name: "body", value: "x" },
    { name: "published", value: "True" },
    { name: "author", value: "missing" },
  ]
  let rows <- Db.from Post |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows }
      == {
        answer: FormRejected [{ field: "author", message: "must be one of the options" }],
        rows: 0,
      }
  )
}

test "a list of 200 users is offered whole" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert User {
        email: Text.Email ("email-" ++ Text.fromInt n ++ "@example.com"),
        name: Text.NonEmpty ("name-" ++ Text.fromInt n),
        passwordHash: "passwordhash-" ++ Text.fromInt n,
      }) (List.range 3 200)
    )
  let page <- Test.get (New {})
  Task.succeed (List.length page.model.authors == 200)
}

test "a long list of users offers 50, and the search narrows it" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert User {
        email: Text.Email ("email-" ++ Text.fromInt n ++ "@example.com"),
        name: Text.NonEmpty ("name-" ++ Text.fromInt n),
        passwordHash: "passwordhash-" ++ Text.fromInt n,
      }) (List.range 3 203)
    )
  let all <- Test.get (New {})
  let found <- Test.get (New { findAuthor: "email-203@example.com" })
  let r <- Test.submit SearchAuthor { q: "zz" }
  let _ <- Test.login { user: Nothing }
  let visitor <- Test.submit SearchAuthor { q: "zz" }
  let _ <- Test.login { user: Just me, role: Admin }
  let _ <- Test.get (New {})
  let _ <- Test.login { user: Just me, role: Reader }
  let reader <- Test.submitRaw SearchAuthor []
  Task.succeed (
    {
      shown: List.length all.model.authors,
      total: all.model.authorsTotal,
      found: Test.texts "select[name=author] option" found.doc == ["email-203@example.com"],
      answer: r.answer,
      visitor: visitor.answer,
      reader: reader.answer,
    } == {
      shown: 50,
      total: 203,
      found: True,
      answer: Redirected (New { findAuthor: "zz" }),
      visitor: Redirected (Auth.Login.Login {}),
      reader: PageMissing,
    }
  )
}

test "an author outside the narrowed list is refused" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert User {
        email: Text.Email ("email-" ++ Text.fromInt n ++ "@example.com"),
        name: Text.NonEmpty ("name-" ++ Text.fromInt n),
        passwordHash: "passwordhash-" ++ Text.fromInt n,
      }) (List.range 3 203)
    )
  let all <- Test.get (New {})
  let found <- Test.get (New { findAuthor: "email-203@example.com" })
  let r <- Test.submit SearchAuthor { q: "zz" }
  let pick = Maybe.withDefault "" (Test.attr "value" "select[name=author] option" found.doc)
  let page <- Test.get (New {})
  let sent <- Test.submitRaw Create [
    { name: "slug", value: "x" },
    { name: "title", value: "x" },
    { name: "body", value: "x" },
    { name: "published", value: "True" },
    { name: "author", value: pick },
  ]
  let rows <- Db.from Post |> Db.count
  Task.succeed (
    { answer: sent.answer, rows: rows }
      == {
        answer: FormRejected [{ field: "author", message: "must be one of the options" }],
        rows: 0,
      }
  )
}

test "a visitor cannot create a post" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let _ <- Db.insert Post {
    slug: Post.Slug "slug-1",
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let _ <- Test.get (New {})
  let _ <- Test.login { user: Nothing }
  let r <- Test.submit Create {
    slug: Post.Slug "slug-2",
    title: Text.NonEmpty "title-2",
    body: "body-2",
    published: True,
    author: user2,
  }
  let rows <- Db.from Post |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows } == { answer: Redirected (Auth.Login.Login {}), rows: 1 }
  )
}

test "a Reader cannot create a post, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let _ <- Db.insert Post {
    slug: Post.Slug "slug-1",
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let _ <- Test.get (New {})
  let _ <- Test.login { user: Just me, role: Reader }
  let r <- Test.submit Create {
    slug: Post.Slug "slug-2",
    title: Text.NonEmpty "title-2",
    body: "body-2",
    published: True,
    author: user2,
  }
  let rows <- Db.from Post |> Db.count
  Task.succeed ({ answer: r.answer, rows: rows } == { answer: PageMissing, rows: 1 })
}

test "a demoted Admin cannot create a post" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let _ <- Db.insert Post {
    slug: Post.Slug "slug-1",
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let _ <- Test.get (New {})
  let _ <- Db.update User me (\u -> { u | role: Reader })
  let r <- Test.submit Create {
    slug: Post.Slug "slug-2",
    title: Text.NonEmpty "title-2",
    body: "body-2",
    published: True,
    author: user2,
  }
  let rows <- Db.from Post |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows } == { answer: RequestFailed "400 bad request", rows: 1 }
  )
}

test "a visitor is sent to log in" = {
  let r <- Test.open (New {})
  Task.succeed (r.answer == Redirected (Auth.Login.Login {}))
}

test "a Reader gets no page, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Reader }
  let r <- Test.open (New {})
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Reader,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let r <- Test.open (New {})
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
