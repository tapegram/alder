-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Users.Edit

-- @admin begin imports
import Admin.Layout
import Table.User
-- @admin end

page "/admin/user/{id}/edit" { id: User.UserId } requires user, role Admin

type Model = {
  row: User,
  -- @admin begin model
  -- @admin end
}

load : Params -> Session -> Query Model
load params session = {
  let admin <- Layout.isAdmin session.user
  if admin then {
    -- @admin begin load
    let found <- Db.get User params.id
    match found {
      Just row -> { Query.succeed { row: row } },
      Nothing -> Query.notFound,
    }
    -- @admin end
  } else
    Query.notFound
}

-- @admin begin form
form UserForm = {
  email: Text.Email,
  name: Text.NonEmpty,
  role: User.Role,
}
-- @admin end

-- @admin begin search
-- @admin end

msg Save form UserForm

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  -- @admin begin finds
  -- @admin end
  Save p -> {
    -- @admin begin update
    if session.user == model.row.id && p.form.role != model.row.role then
      Task.succeed (Reject "You cannot change your own role.")
    else {
      let emailTaken <-
        Db.from User
          |> Db.where (Db.and [User.email.eq p.form.email, User.id.ne model.row.id])
          |> Db.count
      if emailTaken > 0 then
        Task.succeed (Reject "A user with this email exists.")
      else {
        let _ <- Db.update User model.row.id (\row -> { row |
          email: p.form.email,
          name: p.form.name,
          role: p.form.role
        })
        Task.succeed (Redirect (Admin.Users.Show { id: model.row.id }))
      }
    }
    -- @admin end
  },
}

view : Model -> Session -> Html Msg
view model session =
  <Layout.Page title="Edit user">
    <h1>Edit user</h1>

    <al-card>
      -- @admin begin finder
      -- @admin end
      <form submit={Save}>
        -- @admin begin inputs
        <al-input field="email" label="Email" value={model.row.email} />
        <al-input field="name" label="Name" value={model.row.name} />
        <al-select field="role" label="Role" value={model.row.role} />
        -- @admin end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Save</al-button>
      </form>
    </al-card>
    <a href={Admin.Users.Show { id: model.row.id }}>Back</a>
  </Layout.Page>

-- @admin begin tests
test "saving changes every field" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let page <- Test.get (Admin.Users.Edit { id: user2 })
  let r <- Test.submit UserForm {
    email: Text.Email "email-3@example.com",
    name: Text.NonEmpty "name-3",
    role: Admin,
  }
  let after <- Db.get User user2
  Task.succeed (
    {
      answer: r.answer,
      row: Maybe.map (\row -> {
        email: row.email,
        name: row.name,
        role: row.role,
      }) after,
    } == {
        answer: Redirected (Admin.Users.Show { id: user2 }),
        row: Just {
          email: Text.Email "email-3@example.com",
          name: Text.NonEmpty "name-3",
          role: Admin,
        },
      }
  )
}

test "saving an email another user has is refused" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let _ <- Db.insert User {
    email: Text.Email "email-3@example.com",
    name: Text.NonEmpty "name-3",
    passwordHash: "passwordhash-3",
  }
  let before <- Db.get User user2
  let _ <- Test.get (Admin.Users.Edit { id: user2 })
  let r <- Test.submit UserForm {
    email: Text.Email "email-3@example.com",
    name: Text.NonEmpty "name-4",
    role: Admin,
  }
  let after <- Db.get User user2
  Task.succeed (
    { answer: r.answer, row: after }
      == {
        answer: FormRejected [{ field: "", message: "A user with this email exists." }],
        row: before,
      }
  )
}

test "an Admin cannot change their own role" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let before <- Db.get User me
  let _ <- Test.get (Admin.Users.Edit { id: me })
  let r <- Test.submit UserForm {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    role: Reader,
  }
  let after <- Db.get User me
  Task.succeed (
    { answer: r.answer, row: after }
      == {
        answer: FormRejected [{ field: "", message: "You cannot change your own role." }],
        row: before,
      }
  )
}

test "an Admin saves their own account, the role unchanged" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let _ <- Test.get (Admin.Users.Edit { id: me })
  let r <- Test.submit UserForm {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    role: Admin,
  }
  let after <- Db.get User me
  Task.succeed (
    {
      answer: r.answer,
      row: Maybe.map (\row -> {
        email: row.email,
        name: row.name,
        role: row.role,
      }) after,
    } == {
        answer: Redirected (Admin.Users.Show { id: me }),
        row: Just {
          email: Text.Email "email-2@example.com",
          name: Text.NonEmpty "name-2",
          role: Admin,
        },
      }
  )
}

test "an Admin demotes another Admin" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let admin <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
    role: Admin,
  }
  let _ <- Test.get (Admin.Users.Edit { id: admin })
  let r <- Test.submit UserForm {
    email: Text.Email "email-3@example.com",
    name: Text.NonEmpty "name-3",
    role: Reader,
  }
  let after <- Db.get User admin
  Task.succeed (
    { answer: r.answer, role: Maybe.map (\row -> row.role) after }
      == { answer: Redirected (Admin.Users.Show { id: admin }), role: Just Reader }
  )
}

test "a missing row is not found" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let r <- Test.open (Admin.Users.Edit { id: User.UserId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "a visitor is sent to log in" = {
  let user1 <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
  }
  let r <- Test.open (Admin.Users.Edit { id: user1 })
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Reader gets no page, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Reader }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let r <- Test.open (Admin.Users.Edit { id: user2 })
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Reader,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let r <- Test.open (Admin.Users.Edit { id: user2 })
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
