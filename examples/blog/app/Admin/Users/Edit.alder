-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Users.Edit

-- @admin begin imports
import Admin.Layout
import Table.User
-- @admin end

-- @admin begin routes
route Edit = GET "/admin/user/{id}/edit"        { id: User.UserId }               requires user, role Admin
route Save = PUT "/admin/user/{id}/edit/_/Save" { id: User.UserId } form UserForm requires user, role Admin
-- @admin end

type Model = {
  row: User,
  -- @admin begin model
  -- @admin end
}

Edit.load : Edit.Params -> Session -> Query Model
Edit.load params session = {
  let _ <- Layout.adminOnly session.user
  -- @admin begin load
  let found <- Db.get User params.id
  match found {
    Just row -> { Query.succeed { row: row } },
    Nothing -> Query.notFound,
  }
  -- @admin end
}

-- @admin begin form
form UserForm = {
  email: Text.Email,
  name: Text.NonEmpty,
  role: User.Role,
}
-- @admin end

-- @admin begin search
-- @admin end

-- Save writes the form over the row (a row deleted since is not found) and goes to its page.
Save.update : Save.Params -> Session -> Task Response
Save.update params session = {
  let _ <- Layout.adminOnly session.user
  let found <- Db.get User params.id
  match found {
    Just row -> {
      -- @admin begin update
      if session.user == row.id && params.form.role != row.role then
        Task.succeed (Response.invalid "You cannot change your own role.")
      else {
        let emailTaken <-
          Db.from User
            |> Db.where (Db.and [User.email.eq params.form.email, User.id.ne row.id])
            |> Db.count
        if emailTaken > 0 then
          Task.succeed (Response.invalid "A user with this email exists.")
        else {
          let _ <- Db.update User row.id (\r -> { r |
            email: params.form.email,
            name: params.form.name,
            role: params.form.role
          })
          Task.succeed (Response.redirect (Admin.Users.Show.Show { id: row.id }))
        }
      }
      -- @admin end
    },
    Nothing -> Task.notFound,
  }
}

Edit.view : Model -> Session -> Html
Edit.view model session =
  <Layout.Page title="Edit user">
    <h1>Edit user</h1>

    <al-card>
      -- @admin begin finder
      -- @admin end
      <form submit={Save { id: model.row.id }}>
        -- @admin begin inputs
        <al-input field="email" label="Email" value={model.row.email} />
        <al-input field="name" label="Name" value={model.row.name} />
        <al-select field="role" label="Role" value={model.row.role} />
        -- @admin end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Save</al-button>
      </form>
    </al-card>
    <a href={Admin.Users.Show.Show { id: model.row.id }}>Back</a>
  </Layout.Page>

-- @admin begin tests
test "saving changes every field" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let page <- Test.get (Edit { id: user2 })
  let r <- Test.submit (Save { id: user2 }) {
    email: Text.Email "email-3@example.com",
    name: Text.NonEmpty "name-3",
    role: Admin,
  }
  let after <- Db.get User user2
  Task.succeed (
    {
      answer: r.answer,
      row: Maybe.map (\row -> {
        email: row.email,
        name: row.name,
        role: row.role,
      }) after,
    } == {
      answer: Redirected (Admin.Users.Show.Show { id: user2 }),
      row: Just {
        email: Text.Email "email-3@example.com",
        name: Text.NonEmpty "name-3",
        role: Admin,
      },
    }
  )
}

test "saving an email another user has is refused" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let _ <- Db.insert User {
    email: Text.Email "email-3@example.com",
    name: Text.NonEmpty "name-3",
    passwordHash: "passwordhash-3",
  }
  let before <- Db.get User user2
  let _ <- Test.get (Edit { id: user2 })
  let r <- Test.submit (Save { id: user2 }) {
    email: Text.Email "email-3@example.com",
    name: Text.NonEmpty "name-4",
    role: Admin,
  }
  let after <- Db.get User user2
  Task.succeed (
    { answer: r.answer, row: after }
      == {
        answer: FormRejected [{ field: "", message: "A user with this email exists." }],
        row: before,
      }
  )
}

test "an Admin cannot change their own role" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let before <- Db.get User me
  let _ <- Test.get (Edit { id: me })
  let r <- Test.submit (Save { id: me }) {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    role: Reader,
  }
  let after <- Db.get User me
  Task.succeed (
    { answer: r.answer, row: after }
      == {
        answer: FormRejected [{ field: "", message: "You cannot change your own role." }],
        row: before,
      }
  )
}

test "an Admin saves their own account, the role unchanged" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let _ <- Test.get (Edit { id: me })
  let r <- Test.submit (Save { id: me }) {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    role: Admin,
  }
  let after <- Db.get User me
  Task.succeed (
    {
      answer: r.answer,
      row: Maybe.map (\row -> {
        email: row.email,
        name: row.name,
        role: row.role,
      }) after,
    } == {
      answer: Redirected (Admin.Users.Show.Show { id: me }),
      row: Just {
        email: Text.Email "email-2@example.com",
        name: Text.NonEmpty "name-2",
        role: Admin,
      },
    }
  )
}

test "an Admin demotes another Admin" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let admin <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
    role: Admin,
  }
  let _ <- Test.get (Edit { id: admin })
  let r <- Test.submit (Save { id: admin }) {
    email: Text.Email "email-3@example.com",
    name: Text.NonEmpty "name-3",
    role: Reader,
  }
  let after <- Db.get User admin
  Task.succeed (
    { answer: r.answer, role: Maybe.map (\row -> row.role) after }
      == { answer: Redirected (Admin.Users.Show.Show { id: admin }), role: Just Reader }
  )
}

test "a visitor cannot save a user" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let before <- Db.get User user2
  let _ <- Test.get (Edit { id: user2 })
  let _ <- Test.login { user: Nothing }
  let r <- Test.submit (Save { id: user2 }) {
    email: Text.Email "email-3@example.com",
    name: Text.NonEmpty "name-3",
    role: Admin,
  }
  let after <- Db.get User user2
  Task.succeed (
    { answer: r.answer, row: after } == { answer: Redirected (Auth.Login.Login {}), row: before }
  )
}

test "a Reader cannot save a user, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let before <- Db.get User user2
  let _ <- Test.get (Edit { id: user2 })
  let _ <- Test.login { user: Just me, role: Reader }
  let r <- Test.submit (Save { id: user2 }) {
    email: Text.Email "email-3@example.com",
    name: Text.NonEmpty "name-3",
    role: Admin,
  }
  let after <- Db.get User user2
  Task.succeed ({ answer: r.answer, row: after } == { answer: PageMissing, row: before })
}

test "a demoted Admin cannot save a user" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let before <- Db.get User user2
  let _ <- Test.get (Edit { id: user2 })
  let _ <- Db.update User me (\u -> { u | role: Reader })
  let r <- Test.submit (Save { id: user2 }) {
    email: Text.Email "email-3@example.com",
    name: Text.NonEmpty "name-3",
    role: Admin,
  }
  let after <- Db.get User user2
  Task.succeed ({ answer: r.answer, row: after } == { answer: PageMissing, row: before })
}

test "a missing row is not found" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let r <- Test.open (Edit { id: User.UserId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "a visitor is sent to log in" = {
  let user1 <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
  }
  let r <- Test.open (Edit { id: user1 })
  Task.succeed (r.answer == Redirected (Auth.Login.Login {}))
}

test "a Reader gets no page, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Reader }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let r <- Test.open (Edit { id: user2 })
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Reader,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let r <- Test.open (Edit { id: user2 })
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
