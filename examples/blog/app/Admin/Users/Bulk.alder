-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Users.Bulk

-- @admin begin imports
import Admin.Layout
import Table.Post
import Table.User
-- @admin end

-- @admin begin routes
route Bulk       = GET  "/admin/user/bulk"              { ids: List User.UserId }              requires user, role Admin
route BulkDelete = POST "/admin/user/bulk/_/BulkDelete" { ids: List User.UserId } form Confirm requires user, role Admin
-- @admin end

-- The rows chosen on the list (at most maxRows of them), the ids of those that other rows keep
-- from being deleted, how many ids the page was given, and the ids, which each action takes.
type Model = {
  rows: List User,
  held: List User.UserId,
  chosen: Int,
  ids: List User.UserId,
}

-- maxRows is how many rows one action takes: a page of the list. More are refused.
maxRows : Int
maxRows = 25

-- tooMany says whether the page was given more ids than an action takes.
tooMany : Model -> Bool
tooMany model = model.chosen > maxRows

-- selected is the rows of ids: the page shows them, and each action reads them again.
selected : List User.UserId -> Query Model
selected ids = {
  -- @admin begin load
  let taken = List.take maxRows ids
  let rows <-
    Db.from User
      |> Db.where (User.id.in taken)
      |> Db.all
  let held1 <-
    Db.from Post
      |> Db.where (Post.author.in taken)
      |> Db.all
  Query.succeed {
    rows: rows,
    held: List.concat [List.map (\r -> r.author) held1],
    chosen: List.length ids,
    ids: ids,
  }
  -- @admin end
}

Bulk.load : Bulk.Params -> Session -> Query Model
Bulk.load params session = {
  let _ <- Layout.adminOnly session.user
  selected params.ids
}

-- refused says whether a row is kept from being deleted: rows refer to it with a `@restrict`,
-- or it is the signed-in user's own (me).
refused : Model -> User.UserId -> User -> Bool
refused model me row = List.member row.id model.held || me == row.id

-- @admin begin bulk
-- Each action reads the rows again and answers with the page again and a toast; none takes
-- more than maxRows rows.

-- BulkDelete takes no input: the form is the button, and the place a refusal is shown.
form Confirm = { }

BulkDelete.update : BulkDelete.Params -> Session -> Task Response
BulkDelete.update params session = {
  let _ <- Layout.adminOnly session.user
  let model <- selected params.ids
  if tooMany model then
    Task.succeed (
      Response.invalid ("Choose at most " ++ Text.fromInt maxRows ++ " rows at a time.")
    )
  else {
    let allowed = List.filter (\row -> refused model session.user row == False) model.rows
    let _ <- Task.all (List.map (\row -> Db.delete User row.id) allowed)
    Task.succeed (
      Response.refresh
        |> Response.success (
          "Deleted "
            ++ Text.fromInt (List.length allowed)
            ++ " of "
            ++ Text.fromInt (List.length model.rows)
        )
    )
  }
}
-- @admin end

Bulk.view : Model -> Session -> Html
Bulk.view model session =
  <Layout.Page title="Selected users">
    <h1>{Text.fromInt (List.length model.rows)} selected</h1>

    <al-card>
      {if tooMany model then
        <al-alert id="too-many" variant="warning">
          {"Choose at most " ++ Text.fromInt maxRows ++ " rows at a time."}
        </al-alert>
      else
        Html.none}
      <ul id="selected">
        {for row in model.rows ->
          <li>
            {row.email}
            {if session.user == row.id then
              <small> (kept: your own account)</small>
            else if refused model session.user row then
              <small> (kept: other rows refer to it)</small>
            else
              <span></span>}
          </li>}
      </ul>
      -- @admin begin actions
      <form id="bulk-delete" submit={BulkDelete { ids: model.ids }}>
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button variant="destructive" type="submit">
          Delete the rows that can be deleted
        </al-button>
      </form>
      -- @admin end
    </al-card>
    <a href={Admin.Users.Index.Index {}}>Back to the list</a>
  </Layout.Page>

-- @admin begin tests
test "deleting the chosen rows leaves the ones other rows refer to" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let _ <- Db.insert Post {
    slug: Post.Slug "slug-1",
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: user2,
  }
  let user3 <- Db.insert User {
    email: Text.Email "email-3@example.com",
    name: Text.NonEmpty "name-3",
    passwordHash: "passwordhash-3",
  }
  let user4 <- Db.insert User {
    email: Text.Email "email-4@example.com",
    name: Text.NonEmpty "name-4",
    passwordHash: "passwordhash-4",
  }
  let _ <- Test.get (Bulk { ids: [user2, user3] })
  let r <- Test.submit (BulkDelete { ids: [user2, user3] }) {}
  let gone <- Db.get User user3
  let left <- Db.get User user4
  let kept <- Db.get User user2
  Task.succeed (
    {
      answer: r.answer,
      gone: Maybe.map (\row -> row.id) gone,
      left: Maybe.map (\row -> row.id) left,
      kept: Maybe.map (\row -> row.id) kept,
      listed: Test.count "#selected li small" r.doc,
    } == {
      answer: Refreshed,
      gone: Nothing,
      left: Just user4,
      kept: Just user2,
      listed: 1,
    }
  )
}

test "an Admin's own row is not deleted with the chosen rows" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let page <- Test.get (Bulk { ids: [me] })
  let r <- Test.submit (BulkDelete { ids: [me] }) {}
  let kept <- Db.get User me
  Task.succeed (
    { kept: Maybe.map (\row -> row.id) kept, says: Test.texts "#selected small" page.doc }
      == { kept: Just me, says: ["(kept: your own account)"] }
  )
}

test "25 chosen ids are taken" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let chosen = [user2] ++ List.map (\n -> User.UserId ("none-" ++ Text.fromInt n)) (List.range 1 24)
  let page <- Test.get (Bulk { ids: chosen })
  let r <- Test.submit (BulkDelete { ids: chosen }) {}
  let after <- Db.get User user2
  Task.succeed (
    {
      answer: r.answer,
      kept: Maybe.map (\row -> row.id) after,
      warned: Test.count "#too-many" page.doc,
    } == {
      answer: Refreshed,
      kept: Nothing,
      warned: 0,
    }
  )
}

test "26 chosen ids are refused" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let chosen = [user2] ++ List.map (\n -> User.UserId ("none-" ++ Text.fromInt n)) (List.range 1 25)
  let page <- Test.get (Bulk { ids: chosen })
  let r <- Test.submit (BulkDelete { ids: chosen }) {}
  let after <- Db.get User user2
  Task.succeed (
    {
      answer: r.answer,
      kept: Maybe.map (\row -> row.id) after,
      warned: Test.count "#too-many" page.doc,
    } == {
      answer: FormRejected [{ field: "", message: "Choose at most 25 rows at a time." }],
      kept: Just user2,
      warned: 1,
    }
  )
}

test "a demoted Admin cannot delete the chosen rows" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let _ <- Test.get (Bulk { ids: [user2] })
  let _ <- Db.update User me (\u -> { u | role: Reader })
  let r <- Test.submit (BulkDelete { ids: [user2] }) {}
  let kept <- Db.get User user2
  Task.succeed (
    { answer: r.answer, kept: Maybe.map (\row -> row.id) kept }
      == { answer: PageMissing, kept: Just user2 }
  )
}

test "a visitor is sent to log in" = {
  let user1 <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
  }
  let r <- Test.open (Bulk { ids: [user1] })
  Task.succeed (r.answer == Redirected (Auth.Login.Login {}))
}

test "a Reader gets no page, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Reader }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let r <- Test.open (Bulk { ids: [user2] })
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Reader,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let r <- Test.open (Bulk { ids: [user2] })
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
