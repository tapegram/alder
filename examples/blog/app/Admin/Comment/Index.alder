-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Comment.Index

-- @admin begin imports
import Admin.Layout
import Comment
import Post
import User
-- @admin end

-- @admin begin params
page "/admin/comment" {
  q: Text = "",
  sort: Text = "created",
  dir: Text = "desc",
  page: Int = 1,
} requires user, role Admin
-- @admin end

type Model = {
  rows: List Comment,
  labels: Labels,
  q: Text,
  filters: Filters,
  sort: Text,
  dir: Text,
  page: Int,
  pages: Int,
  count: Int,
}

perPage : Int
perPage = 25

-- @admin begin search
-- search is the rows whose text contains q (every row for "").
search : Text -> Condition Comment
search q = Db.or [Comment.author.contains q, Comment.body.contains q]
-- @admin end

-- A Filter is one of the list's selects: the column it filters, the option chosen ("" for any),
-- and each option's value in the address, its label, and the rows it selects.
type Filter = {
  name: Text,
  label: Text,
  value: Text,
  options: List { value: Text, label: Text, rows: Condition Comment },
}

-- @admin begin filters
-- Filters are the option each filter has chosen in the address ("" for any): a select for each
-- Bool and union column: this table has none.
type Filters = { }

-- chosen is the filters' options in params.
chosen : Params -> Filters
chosen params = { }

-- filters are the list's filters, each with the option f has chosen.
filters : Filters -> List Filter
filters f = []

-- filtered is the rows that the option each filter has chosen selects (every row for "", or for
-- a value that is no option's).
filtered : List Filter -> Condition Comment
filtered fs = Db.and []

-- listAt is this list with the model's search and filters, sorted by sort and dir, at page n.
listAt : Model -> Text -> Text -> Int -> Page
listAt model sort dir n = Admin.Comment.Index { q: model.q, sort: sort, dir: dir, page: n }
-- @admin end

-- @admin begin sorts
-- sorts are the columns the list sorts by, by name.
sorts : List { name: Text, asc: Order Comment, desc: Order Comment }
sorts = [
  { name: "post", asc: Comment.post.asc, desc: Comment.post.desc },
  { name: "author", asc: Comment.author.asc, desc: Comment.author.desc },
  { name: "body", asc: Comment.body.asc, desc: Comment.body.desc },
  { name: "created", asc: Comment.created.asc, desc: Comment.created.desc },
]
-- @admin end

-- order is the ordering sort names, ascending when dir is "asc"; a name that is not a column's
-- sorts newest first.
order : Text -> Text -> Order Comment
order sort dir = match List.find (\s -> s.name == sort) sorts {
  Just s -> if dir == "asc" then s.asc else s.desc,
  Nothing -> Comment.created.desc,
}

-- toggle is the direction a column's header sorts by: the other way round when the list is
-- sorted by that column ascending.
toggle : Model -> Text -> Text
toggle model sort = if model.sort == sort && model.dir == "asc" then "desc" else "asc"

-- load reads how many rows match the search and the filters, and one page of them (the last, for
-- a page past it), in the order asked for. The search text is cut to 200 characters (Text.slice):
-- a text over 10,000 bytes would fail the query (chapter 8, "Search").
load : Params -> Session -> Query Model
load params session = {
  let admin <- Admin.Layout.isAdmin session.user
  if admin then {
    let q = Text.slice 0 200 params.q
    let f = chosen params
    let count <- Db.from Comment |> Db.where (Db.and [search q, filtered (filters f)]) |> Db.count
    let pages = Int.max 1 ((count + perPage - 1) / perPage)
    let page = Int.clamp { min: 1, max: pages } params.page
    let rows <-
      Db.from Comment
        |> Db.where (Db.and [search q, filtered (filters f)])
        |> Db.orderBy (order params.sort params.dir)
        |> Db.limit perPage
        |> Db.offset ((page - 1) * perPage)
        |> Db.all
    let labels <- labelsOf rows
    Query.succeed {
      rows: rows,
      labels: labels,
      q: q,
      filters: f,
      sort: params.sort,
      dir: params.dir,
      page: page,
      pages: pages,
      count: count,
    }
  } else Query.notFound
}

-- @admin begin labels
-- Labels are the rows the references of the rows shown name: their links show their labels.
type Labels = { posts: List Post }

-- labelsOf reads the rows that rows refer to.
labelsOf : List Comment -> Query Labels
labelsOf rows = {
  let posts <- Db.from Post |> Db.where (Post.id.in (List.map (\row -> row.post) rows)) |> Db.all
  Query.succeed { posts: posts }
}

-- postLabel is the label of the post id names (the id itself if it names none).
postLabel : Labels -> Post.PostId -> Text
postLabel labels id = match List.find (\r -> r.id == id) labels.posts {
  Just r -> r.slug,
  Nothing -> id,
}
-- @admin end

view : Model -> Session -> Html Msg
view model session =
  <Admin.Layout.Page title="Comments">
    <h1>Comments</h1>

    <al-stack direction="row" gap="sm">
      <form method="get" action="/admin/comment">
        <input type="search" name="q" value={model.q} aria-label="Search" />
        {for f in filters model.filters ->
          <al-select label={f.label}>
            <label>{f.label}
              <select name={f.name}>
                <option value="" selected={f.value == ""}>any</option>
                {for o in f.options -> <option value={o.value} selected={o.value == f.value}>{o.label}</option>}
              </select>
            </label>
          </al-select>}
        <input type="hidden" name="sort" value={model.sort} />
        <input type="hidden" name="dir" value={model.dir} />
        <al-button type="submit" variant="secondary">Search</al-button>
      </form>
      <al-button href={Admin.Comment.New {}}>New comment</al-button>
    </al-stack>

    <p id="count">{if model.count == 1 then "1 row" else Text.fromInt model.count ++ " rows"}</p>

    <al-table>
      <table>
        <thead>
          <tr>
            -- @admin begin headers
            <th><a href={listAt model "post" (toggle model "post") 1}>Post</a></th>
            <th><a href={listAt model "author" (toggle model "author") 1}>Author</a></th>
            <th><a href={listAt model "body" (toggle model "body") 1}>Body</a></th>
            <th><a href={listAt model "created" (toggle model "created") 1}>Created</a></th>
            -- @admin end
          </tr>
        </thead>
        <tbody>
          {for row in model.rows ->
            <tr>
              -- @admin begin cells
              <td><a href={Admin.Post.Show { id: row.post }}>{postLabel model.labels row.post}</a></td>
              <td><a href={Admin.Comment.Show { id: row.id }}>{row.author}</a></td>
              <td>{row.body}</td>
              <td>{Time.format "Jan 2, 2006" row.created}</td>
              -- @admin end
            </tr>}
        </tbody>
      </table>
    </al-table>

    <al-pagination role="navigation" aria-label="Pages">
      {if model.page > 1 then <a slot="prev" href={listAt model model.sort model.dir (model.page - 1)} rel="prev">Previous</a> else <span slot="prev" aria-disabled="true">Previous</span>}
      <span>Page {Text.fromInt model.page} of {Text.fromInt model.pages}</span>
      {if model.page < model.pages then <a slot="next" href={listAt model model.sort model.dir (model.page + 1)} rel="next">Next</a> else <span slot="next" aria-disabled="true">Next</span>}
    </al-pagination>
  </Admin.Layout.Page>

-- @admin begin tests
test "the list shows every row, newest first, and the labels of the rows they refer to" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    slug: Post.Slug "slug-1",
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let comment1 <- Db.insert Comment {
    post: post1,
    author: Comment.Name "author-1",
    body: Comment.Body "body-1",
  }
  let comment2 <- Db.insert Comment {
    post: post1,
    author: Comment.Name "author-2",
    body: Comment.Body "body-2",
  }
  let post2 <- Db.insert Post {
    slug: Post.Slug "slug-2",
    title: Text.NonEmpty "title-2",
    body: "body-2",
    author: me,
  }
  let page <- Test.get (Admin.Comment.Index {})
  Task.succeed ({
    rows: List.map (\row -> row.id) page.model.rows,
    posts: List.length page.model.labels.posts,
    postLabel: postLabel page.model.labels post1,
  } == {
    rows: [comment2, comment1],
    posts: 1,
    postLabel: "slug-1",
  })
}

test "sorting by author goes both ways" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    slug: Post.Slug "slug-1",
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let comment1 <- Db.insert Comment {
    post: post1,
    author: Comment.Name "author-2",
    body: Comment.Body "body-1",
  }
  let comment2 <- Db.insert Comment {
    post: post1,
    author: Comment.Name "author-1",
    body: Comment.Body "body-2",
  }
  let up <- Test.get (Admin.Comment.Index { sort: "author", dir: "asc" })
  let down <- Test.get (Admin.Comment.Index { sort: "author" })
  Task.succeed ({
    up: List.map (\row -> row.id) up.model.rows,
    down: List.map (\row -> row.id) down.model.rows,
    toggles: [toggle up.model "author", toggle down.model "author", toggle up.model "post"],
  } == {
    up: [comment2, comment1],
    down: [comment1, comment2],
    toggles: ["desc", "asc", "asc"],
  })
}

test "searching finds the rows that contain the text" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    slug: Post.Slug "slug-1",
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let comment1 <- Db.insert Comment {
    post: post1,
    author: Comment.Name "author-1",
    body: Comment.Body "body-1",
  }
  let comment2 <- Db.insert Comment {
    post: post1,
    author: Comment.Name "author-2",
    body: Comment.Body "body-2",
  }
  let page <- Test.get (Admin.Comment.Index { q: "author-2" })
  Task.succeed ({
    rows: List.map (\row -> row.id) page.model.rows,
    count: Test.text "#count" page.doc,
  } == {
    rows: [comment2],
    count: Just "1 row",
  })
}

test "a search text of 20,000 characters is cut to 200" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let long = Text.join "" (List.map (\n -> "z") (List.range 1 20000))
  let page <- Test.get (Admin.Comment.Index { q: long })
  Task.succeed ({
    q: Text.length page.model.q,
    rows: List.length page.model.rows,
  } == {
    q: 200,
    rows: 0,
  })
}

test "the list has 25 rows a page, and a page past the last is the last" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let post1 <- Db.insert Post {
    slug: Post.Slug "slug-1",
    title: Text.NonEmpty "title-1",
    body: "body-1",
    author: me,
  }
  let _ <- Task.all (List.map (\n -> Db.insert Comment {
    post: post1,
    author: Comment.Name ("author-" ++ Text.fromInt n),
    body: Comment.Body ("body-" ++ Text.fromInt n),
  }) (List.range 1 26))
  let first <- Test.get (Admin.Comment.Index {})
  let second <- Test.get (Admin.Comment.Index { page: 2 })
  let past <- Test.get (Admin.Comment.Index { page: 9 })
  Task.succeed ({
    first: List.length first.model.rows,
    second: List.length second.model.rows,
    past: { page: past.model.page, rows: List.length past.model.rows },
    count: Test.text "#count" first.doc,
    pages: Test.texts "al-pagination span" first.doc,
  } == {
    first: 25,
    second: 1,
    past: { page: 2, rows: 1 },
    count: Just "26 rows",
    pages: ["Previous", "Page 1 of 2"],
  })
}

test "a visitor is sent to log in" = {
  let r <- Test.open (Admin.Comment.Index {})
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Reader gets no page, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Reader }
  let r <- Test.open (Admin.Comment.Index {})
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Reader,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let r <- Test.open (Admin.Comment.Index {})
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
