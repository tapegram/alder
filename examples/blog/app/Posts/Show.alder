module Posts.Show

import Layout
import Markdown
import Table.Comment
import Table.Post
import Table.User

route Show       = GET  "/posts/{slug}"              { slug: Post.Slug }
-- AddComment takes the page's slug from its path. No `load` runs before a write route, so its
-- `update` finds the post again: a comment on a draft, or on a slug never used, is a 404.
route AddComment = POST "/posts/{slug}/_/AddComment" { slug: Post.Slug } form NewComment

type Model = {
  post: Post,
  body: Html,
  comments: List Comment,
}

-- load finds the post by its slug. A draft is a 404 for everyone but its author, so a reader
-- cannot tell a draft from a slug that was never used.
Show.load : Show.Params -> Session -> Query Model
Show.load params session = {
  let found <- Post.bySlug params.slug
  match found {
    Just post ->
      if Post.visible session.user post then {
        let body <- Markdown.render post.body
        let comments <-
          Db.from Comment
            |> Db.where (Comment.post.eq post.id)
            |> Db.orderBy Comment.created.asc
            |> Db.all
        Query.succeed {
          post: post,
          body: body,
          comments: comments,
        }
      } else
        Query.notFound,
    Nothing -> Query.notFound,
  }
}

form NewComment = { author: Comment.Name, body: Comment.Body }

AddComment.update : AddComment.Params -> Session -> Task Response
AddComment.update p session = {
  let found <- Post.bySlug p.slug
  match found {
    Just post ->
      if post.published then {
        let _ <- Db.insert Comment {
          post: post.id,
          author: p.form.author,
          body: p.form.body,
        }
        Task.succeed (Response.redirect (Show { slug: post.slug }))
      } else
        Task.notFound,
    Nothing -> Task.notFound,
  }
}

Show.view : Model -> Session -> Html
Show.view model session =
  <Layout.Page title={model.post.title}>
    <article>
      <h1>{model.post.title}</h1>
      {if model.post.published then
        Html.none
      else
        <al-alert heading="Draft">Only you can see this post.</al-alert>}
      <div class="body">{model.body}</div>
    </article>

    <section class="comments">
      <h2>Comments</h2>
      <ul>
        {for c in model.comments ->
          <li>
            <p class="who">{c.author}</p>
            <p>{c.body}</p>
          </li>}
      </ul>
      {if model.post.published then
        <al-card>
          <form submit={AddComment { slug: model.post.slug }}>
            <al-alert variant="destructive"><Errors form /></al-alert>
            <al-input field="author" label="Name" />
            <al-textarea field="body" label="Comment" />
            <al-button type="submit">Comment</al-button>
          </form>
        </al-card>
      else
        Html.none}
    </section>

    <a href={Posts.Index.Index {}}>All posts</a>
  </Layout.Page>

test "a draft is not found for a reader" = {
  let author <- Db.insert User {
    email: Text.Email "author@example.com",
    name: Text.NonEmpty "Author",
    passwordHash: "",
    role: Author,
  }
  let reader <- Db.insert User {
    email: Text.Email "reader@example.com",
    name: Text.NonEmpty "Reader",
    passwordHash: "",
  }
  let _ <- Db.insert Post {
    slug: Post.Slug "draft",
    title: Text.NonEmpty "Draft",
    body: "",
    author: author,
  }
  let asReader <- Test.run {
    let m <- Show.load { slug: Post.Slug "draft" } { user: Just reader, role: Reader }
    Task.succeed m.post.title
  }
  let asNobody <- Test.run {
    let m <- Show.load { slug: Post.Slug "draft" } { user: Nothing, role: Reader }
    Task.succeed m.post.title
  }
  Task.succeed (
    { reader: asReader.value, nobody: asNobody.value }
      == { reader: Err "not found", nobody: Err "not found" }
  )
}

-- The body goes through the real Markdown adapter (adapters/markdown/markdown.go).
test "a draft is shown to its author" = {
  let author <- Db.insert User {
    email: Text.Email "author@example.com",
    name: Text.NonEmpty "Author",
    passwordHash: "",
    role: Author,
  }
  let _ <- Db.insert Post {
    slug: Post.Slug "draft",
    title: Text.NonEmpty "Draft",
    body: "Not *yet*.",
    author: author,
  }
  let m <- Show.load { slug: Post.Slug "draft" } { user: Just author, role: Author }
  Task.succeed (
    { title: m.post.title, body: m.body }
      == { title: Text.NonEmpty "Draft", body: <p>Not <em>yet</em>.</p> }
  )
}

-- The same page with the Markdown capability faked (`fake Markdown` in app/Markdown.alder):
-- the body arrives as plain text, so the test is about where `load` puts it, not about Markdown.
test "a post's body is rendered through the Markdown capability" = {
  let _ <- Test.fake Markdown
  let author <- Db.insert User {
    email: Text.Email "author@example.com",
    name: Text.NonEmpty "Author",
    passwordHash: "",
    role: Author,
  }
  let _ <- Db.insert Post {
    slug: Post.Slug "hello",
    title: Text.NonEmpty "Hello",
    body: "Not *yet*.",
    published: True,
    author: author,
  }
  let m <- Show.load { slug: Post.Slug "hello" } { user: Nothing, role: Reader }
  let steps <- Test.trace
  Task.succeed (
    { body: m.body, rendered: List.member "Markdown.render" steps }
      == { body: Html.text "Not *yet*.", rendered: True }
  )
}

-- A draft's page is a 404 for a reader, so its comment form cannot be posted; `update` refuses
-- a comment on a draft as well, whoever sends it.
test "a comment on a draft is refused" = {
  let author <- Db.insert User {
    email: Text.Email "author@example.com",
    name: Text.NonEmpty "Author",
    passwordHash: "",
    role: Author,
  }
  let _ <- Db.insert Post {
    slug: Post.Slug "draft",
    title: Text.NonEmpty "Draft",
    body: "",
    author: author,
  }
  let r <-
    Test.run (AddComment.update {
      form: { author: Comment.Name "Ann", body: Comment.Body "First!" },
      slug: Post.Slug "draft",
    } { user: Nothing, role: Reader })
  let comments <- Db.from Comment |> Db.count
  Task.succeed ({ value: r.value, comments: comments } == { value: Err "not found", comments: 0 })
}

test "a comment is listed oldest first" = {
  let author <- Db.insert User {
    email: Text.Email "author@example.com",
    name: Text.NonEmpty "Author",
    passwordHash: "",
    role: Author,
  }
  let _ <- Db.insert Post {
    slug: Post.Slug "hello",
    title: Text.NonEmpty "Hello",
    body: "",
    published: True,
    author: author,
  }
  let before <- Show.load { slug: Post.Slug "hello" } { user: Nothing, role: Reader }
  let _ <- AddComment.update {
    form: { author: Comment.Name "Ann", body: Comment.Body "First!" },
    slug: Post.Slug "hello",
  } { user: Nothing, role: Reader }
  let _ <- AddComment.update {
    form: { author: Comment.Name "Bob", body: Comment.Body "Second." },
    slug: Post.Slug "hello",
  } { user: Nothing, role: Reader }
  let after <- Show.load { slug: Post.Slug "hello" } { user: Nothing, role: Reader }
  Task.succeed (
    List.map (\c -> c.body) after.comments == [Comment.Body "First!", Comment.Body "Second."]
  )
}

-- An empty comment, posted as the form's inputs would send it: the form is re-rendered with the
-- error beside the field, and no comment is stored.
test "an empty comment is rejected" = {
  let author <- Db.insert User {
    email: Text.Email "author@example.com",
    name: Text.NonEmpty "Author",
    passwordHash: "",
    role: Author,
  }
  let _ <- Db.insert Post {
    slug: Post.Slug "hello",
    title: Text.NonEmpty "Hello",
    body: "",
    published: True,
    author: author,
  }
  let _ <- Test.get (Show { slug: Post.Slug "hello" })
  let r <- Test.submitRaw (AddComment { slug: Post.Slug "hello" }) [
    { name: "author", value: "Ann" },
    { name: "body", value: "" },
  ]
  let comments <- Db.from Comment |> Db.count
  Task.succeed (
    {
      answer: r.answer,
      author: Test.attr "value" "input[name=author]" r.doc,
      comments: comments,
    } == {
      answer: FormRejected [{ field: "body", message: "is not valid" }],
      author: Just "Ann",
      comments: 0,
    }
  )
}

test "commenting through the form" = {
  let author <- Db.insert User {
    email: Text.Email "author@example.com",
    name: Text.NonEmpty "Author",
    passwordHash: "",
    role: Author,
  }
  let _ <- Db.insert Post {
    slug: Post.Slug "hello",
    title: Text.NonEmpty "Hello",
    body: "",
    published: True,
    author: author,
  }
  let _ <- Test.get (Show { slug: Post.Slug "hello" })
  let r <- Test.submit (AddComment { slug: Post.Slug "hello" }) {
    author: Comment.Name "Ann",
    body: Comment.Body "First!",
  }
  let page <- Test.get (Show { slug: Post.Slug "hello" })
  Task.succeed (
    { answer: r.answer, who: Test.texts ".comments .who" page.doc }
      == { answer: Redirected (Show { slug: Post.Slug "hello" }), who: ["Ann"] }
  )
}
