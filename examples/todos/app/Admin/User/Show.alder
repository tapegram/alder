-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.User.Show

-- @admin begin imports
import Admin.Layout
import User
-- @admin end

page "/admin/user/{id}" { id: User.UserId } requires user, role Admin

type Model = { row: User, labels: Labels }

load : Params -> Session -> Query Model
load params session = {
  let admin <- Admin.Layout.isAdmin session.user
  if admin then {
    let found <- Db.get User params.id
    match found {
      Just row -> {
        let labels <- labelsOf [row]
        Query.succeed { row: row, labels: labels }
      },
      Nothing -> Query.notFound,
    }
  } else Query.notFound
}

-- @admin begin labels
-- Labels are the rows the references of the rows shown name: their links show their labels.
type Labels = { }

labelsOf : List User -> Query Labels
labelsOf rows = Query.succeed { }
-- @admin end

view : Model -> Session -> Html Msg
view model session =
  <Admin.Layout.Page title="User">
    <h1>User</h1>

    <al-card>
      <dl>
        -- @admin begin fields
        <dt>Id</dt>
        <dd>{model.row.id}</dd>
        <dt>Email</dt>
        <dd>{model.row.email}</dd>
        <dt>Name</dt>
        <dd>{model.row.name}</dd>
        <dt>Created</dt>
        <dd>{Time.format "Jan 2, 2006" model.row.created}</dd>
        <dt>Role</dt>
        <dd><al-badge>{match model.row.role { Member -> "Member", Admin -> "Admin" }}</al-badge></dd>
        -- @admin end
      </dl>
      <div slot="actions">
        <al-button href={Admin.User.Edit { id: model.row.id }}>Edit</al-button>
        <al-button variant="destructive"><button type="button" commandfor="delete-dialog" command="show-modal">Delete</button></al-button>
      </div>
    </al-card>
    <al-dialog id="delete-dialog" heading="Delete this user?" dismissible>
      <p>The next page shows what refers to it before anything is deleted.</p>
      <div slot="actions">
        <al-button variant="destructive" href={Admin.User.Delete { id: model.row.id }}>Review and delete</al-button>
      </div>
    </al-dialog>
    <a href={Admin.User.Delete { id: model.row.id }}>Delete without the dialog</a>
    <a href={Admin.User.Index {}}>All users</a>
  </Admin.Layout.Page>

-- @admin begin tests
test "the page shows the row" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let r <- Test.open (Admin.User.Show { id: user2 })
  Task.succeed ({
    answer: r.answer,
    email: List.member "email-2@example.com" (Test.texts "dd" r.doc),
  } == {
    answer: Shown,
    email: True,
  })
}

test "a missing row is not found" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let r <- Test.open (Admin.User.Show { id: User.UserId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "a visitor is sent to log in" = {
  let user1 <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
  }
  let r <- Test.open (Admin.User.Show { id: user1 })
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Member gets no page, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Member }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let r <- Test.open (Admin.User.Show { id: user2 })
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Member,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let r <- Test.open (Admin.User.Show { id: user2 })
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
