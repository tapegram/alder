-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Todos.New

-- @admin begin imports
import Admin.Layout
import Table.Todo
import Table.User
-- @admin end

-- @admin begin routes
route New         = GET  "/admin/todo/new"               { findOwner: Text = "" } requires user, role Admin
route Create      = POST "/admin/todo/new/_/Create"      { } form TodoForm        requires user, role Admin
route SearchOwner = POST "/admin/todo/new/_/SearchOwner" { } form FindOwner       requires user, role Admin
-- @admin end

type Model = {
  -- @admin begin model
  owners: List User,
  ownersTotal: Int,
  -- @admin end
}

New.load : New.Params -> Session -> Query Model
New.load params session = {
  let _ <- Layout.adminOnly session.user
  -- @admin begin load
  let findOwner = Text.slice 0 200 params.findOwner
  let ownersTotal <- Db.from User |> Db.count
  let owners <-
    Db.from User
      |> Db.orderBy User.email.asc
      |> Db.where (if ownersTotal > 200 then User.email.contains findOwner else Db.and [])
      |> Db.limit (if ownersTotal > 200 then 50 else 200)
      |> Db.all
  Query.succeed { owners: owners, ownersTotal: ownersTotal }
  -- @admin end
}

-- @admin begin form
form TodoForm = {
  title: Text.NonEmpty,
  done: Bool,
  due: Maybe Date,
  owner: User.UserId,
}
-- @admin end

-- @admin begin search
form FindOwner = { q: Text }

-- SearchOwner answers the page again at the text.
SearchOwner.update : SearchOwner.Params -> Session -> Task Response
SearchOwner.update params session =
  Task.succeed (Response.redirect (New { findOwner: Text.slice 0 200 params.form.q }))

-- @admin end

-- Create adds the row and goes to its page.
Create.update : Create.Params -> Session -> Task Response
Create.update params session = {
  let _ <- Layout.adminOnly session.user
  -- @admin begin insert
  let id <- Db.insert Todo {
    title: params.form.title,
    done: params.form.done,
    due: params.form.due,
    owner: params.form.owner,
  }
  Task.succeed (Response.redirect (Admin.Todos.Show.Show { id: id }))
  -- @admin end
}

New.view : Model -> Session -> Html
New.view model session =
  <Layout.Page title="New todo">
    <h1>New todo</h1>

    <al-card>
      -- @admin begin finder
      {if model.ownersTotal > 200 then
        <form submit={SearchOwner}>
          <al-input field="q" label="Find owner" />
          <al-button type="submit" variant="secondary">Find</al-button>
        </form>
      else
        Html.none}
      -- @admin end
      <form submit={Create}>
        -- @admin begin inputs
        <al-input field="title" label="Title" />
        <al-checkbox field="done" label="Done" value={False} />
        <al-input field="due" label="Due" />
        <al-select
          field="owner"
          label="Owner"
          options={List.map (\r -> { value: r.id, label: r.email }) model.owners} />
        -- @admin end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Create</al-button>
      </form>
    </al-card>
  </Layout.Page>

-- @admin begin tests
test "creating a todo adds it, with the values submitted" = {
  let today <- Date.today
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let page <- Test.get (New {})
  let r <- Test.submit Create {
    title: Text.NonEmpty "title-1",
    done: True,
    due: Just today,
    owner: user2,
  }
  let rows <- Db.from Todo |> Db.all
  Task.succeed (
    {
      answers: List.map (\row -> Redirected (Admin.Todos.Show.Show { id: row.id })) rows,
      rows: List.map (\row -> {
        title: row.title,
        done: row.done,
        due: row.due,
        owner: row.owner,
      }) rows,
      owners: Test.texts "select[name=owner] option" page.doc,
    } == {
      answers: [r.answer],
      rows: [
        {
          title: Text.NonEmpty "title-1",
          done: True,
          due: Just today,
          owner: user2,
        },
      ],
      owners: ["email-1@example.com", "email-2@example.com"],
    }
  )
}

test "an owner not offered is refused" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let page <- Test.get (New {})
  let r <- Test.submitRaw Create [
    { name: "title", value: "x" },
    { name: "done", value: "True" },
    { name: "due", value: "" },
    { name: "owner", value: "missing" },
  ]
  let rows <- Db.from Todo |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows }
      == {
        answer: FormRejected [{ field: "owner", message: "must be one of the options" }],
        rows: 0,
      }
  )
}

test "a list of 200 users is offered whole" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert User {
        email: Text.Email ("email-" ++ Text.fromInt n ++ "@example.com"),
        name: Text.NonEmpty ("name-" ++ Text.fromInt n),
        passwordHash: "passwordhash-" ++ Text.fromInt n,
      }) (List.range 3 200)
    )
  let page <- Test.get (New {})
  Task.succeed (List.length page.model.owners == 200)
}

test "a long list of users offers 50, and the search narrows it" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert User {
        email: Text.Email ("email-" ++ Text.fromInt n ++ "@example.com"),
        name: Text.NonEmpty ("name-" ++ Text.fromInt n),
        passwordHash: "passwordhash-" ++ Text.fromInt n,
      }) (List.range 3 203)
    )
  let all <- Test.get (New {})
  let found <- Test.get (New { findOwner: "email-203@example.com" })
  let r <- Test.submit SearchOwner { q: "zz" }
  Task.succeed (
    {
      shown: List.length all.model.owners,
      total: all.model.ownersTotal,
      found: Test.texts "select[name=owner] option" found.doc == ["email-203@example.com"],
      answer: r.answer,
    } == {
      shown: 50,
      total: 203,
      found: True,
      answer: Redirected (New { findOwner: "zz" }),
    }
  )
}

test "an owner outside the narrowed list is refused" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert User {
        email: Text.Email ("email-" ++ Text.fromInt n ++ "@example.com"),
        name: Text.NonEmpty ("name-" ++ Text.fromInt n),
        passwordHash: "passwordhash-" ++ Text.fromInt n,
      }) (List.range 3 203)
    )
  let all <- Test.get (New {})
  let found <- Test.get (New { findOwner: "email-203@example.com" })
  let r <- Test.submit SearchOwner { q: "zz" }
  let pick = Maybe.withDefault "" (Test.attr "value" "select[name=owner] option" found.doc)
  let page <- Test.get (New {})
  let sent <- Test.submitRaw Create [
    { name: "title", value: "x" },
    { name: "done", value: "True" },
    { name: "due", value: "" },
    { name: "owner", value: pick },
  ]
  let rows <- Db.from Todo |> Db.count
  Task.succeed (
    { answer: sent.answer, rows: rows }
      == {
        answer: FormRejected [{ field: "owner", message: "must be one of the options" }],
        rows: 0,
      }
  )
}

test "a visitor cannot create a todo" = {
  let today <- Date.today
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let _ <- Test.get (New {})
  let _ <- Test.login { user: Nothing }
  let r <- Test.submit Create {
    title: Text.NonEmpty "title-1",
    done: True,
    due: Just today,
    owner: user2,
  }
  let rows <- Db.from Todo |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows } == { answer: Redirected (Auth.Login.Login {}), rows: 0 }
  )
}

test "a Member cannot create a todo, even one made Admin since logging in" = {
  let today <- Date.today
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let _ <- Test.get (New {})
  let _ <- Test.login { user: Just me, role: Member }
  let r <- Test.submit Create {
    title: Text.NonEmpty "title-1",
    done: True,
    due: Just today,
    owner: user2,
  }
  let rows <- Db.from Todo |> Db.count
  Task.succeed ({ answer: r.answer, rows: rows } == { answer: PageMissing, rows: 0 })
}

test "a demoted Admin cannot create a todo" = {
  let today <- Date.today
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let _ <- Test.get (New {})
  let _ <- Db.update User me (\u -> { u | role: Member })
  let r <- Test.submit Create {
    title: Text.NonEmpty "title-1",
    done: True,
    due: Just today,
    owner: user2,
  }
  let rows <- Db.from Todo |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows } == { answer: RequestFailed "400 bad request", rows: 0 }
  )
}

test "a visitor is sent to log in" = {
  let r <- Test.open (New {})
  Task.succeed (r.answer == Redirected (Auth.Login.Login {}))
}

test "a Member gets no page, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Member }
  let r <- Test.open (New {})
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Member,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let r <- Test.open (New {})
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
