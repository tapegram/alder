-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Todos.Edit

-- @admin begin imports
import Admin.Layout
import Table.Todo
import Table.User
-- @admin end

-- @admin begin routes
route Edit        = GET  "/admin/todo/{id}/edit"               { id: Todo.TodoId, findOwner: Text = "" } requires user, role Admin
route Save        = PUT  "/admin/todo/{id}/edit/_/Save"        { id: Todo.TodoId } form TodoForm         requires user, role Admin
route SearchOwner = POST "/admin/todo/{id}/edit/_/SearchOwner" { id: Todo.TodoId } form FindOwner        requires user, role Admin
-- @admin end

type Model = {
  row: Todo,
  -- @admin begin model
  owners: List User,
  ownersTotal: Int,
  -- @admin end
}

Edit.load : Edit.Params -> Session -> Query Model
Edit.load params session = {
  let _ <- Layout.adminOnly session.user
  -- @admin begin load
  let found <- Db.get Todo params.id
  match found {
    Just row -> {
      let findOwner = Text.slice 0 200 params.findOwner
      let ownersTotal <- Db.from User |> Db.count
      let ownersOwn <-
        if ownersTotal > 200 then
          Db.from User
            |> Db.where (User.id.eq row.owner)
            |> Db.all
        else
          Query.succeed []
      let ownersFound <-
        Db.from User
          |> Db.orderBy User.email.asc
          |> Db.where (
            if ownersTotal > 200 then
              Db.and [User.email.contains findOwner, User.id.ne row.owner]
            else
              Db.and []
          )
          |> Db.limit (if ownersTotal > 200 then 50 else 200)
          |> Db.all
      let owners = ownersOwn ++ ownersFound
      Query.succeed {
        row: row,
        owners: owners,
        ownersTotal: ownersTotal,
      }
    },
    Nothing -> Query.notFound,
  }
  -- @admin end
}

-- @admin begin form
form TodoForm = {
  title: Text.NonEmpty,
  done: Bool,
  due: Maybe Date,
  owner: User.UserId,
}
-- @admin end

-- @admin begin search
form FindOwner = { q: Text }

-- SearchOwner answers the page again at the text.
SearchOwner.update : SearchOwner.Params -> Session -> Task Response
SearchOwner.update params session =
  Task.succeed (
    Response.redirect (Edit { id: params.id, findOwner: Text.slice 0 200 params.form.q })
  )

-- @admin end

-- Save writes the form over the row (a row deleted since is not found) and goes to its page.
Save.update : Save.Params -> Session -> Task Response
Save.update params session = {
  let _ <- Layout.adminOnly session.user
  let found <- Db.get Todo params.id
  match found {
    Just row -> {
      -- @admin begin update
      let _ <- Db.update Todo row.id (\r -> { r |
        title: params.form.title,
        done: params.form.done,
        due: params.form.due,
        owner: params.form.owner
      })
      Task.succeed (Response.redirect (Admin.Todos.Show.Show { id: row.id }))
      -- @admin end
    },
    Nothing -> Task.notFound,
  }
}

Edit.view : Model -> Session -> Html
Edit.view model session =
  <Layout.Page title="Edit todo">
    <h1>Edit todo</h1>

    <al-card>
      -- @admin begin finder
      {if model.ownersTotal > 200 then
        <form submit={SearchOwner { id: model.row.id }}>
          <al-input field="q" label="Find owner" />
          <al-button type="submit" variant="secondary">Find</al-button>
        </form>
      else
        Html.none}
      -- @admin end
      <form submit={Save { id: model.row.id }}>
        -- @admin begin inputs
        <al-input field="title" label="Title" value={model.row.title} />
        <al-checkbox field="done" label="Done" value={model.row.done} />
        <al-input field="due" label="Due" value={model.row.due} />
        <al-select
          field="owner"
          label="Owner"
          options={List.map (\r -> { value: r.id, label: r.email }) model.owners}
          value={model.row.owner} />
        -- @admin end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Save</al-button>
      </form>
    </al-card>
    <a href={Admin.Todos.Show.Show { id: model.row.id }}>Back</a>
  </Layout.Page>

-- @admin begin tests
test "saving changes every field" = {
  let today <- Date.today
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let todo1 <- Db.insert Todo {
    title: Text.NonEmpty "title-1",
    due: Nothing,
    owner: me,
  }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let page <- Test.get (Edit { id: todo1 })
  let r <- Test.submit (Save { id: todo1 }) {
    title: Text.NonEmpty "title-2",
    done: True,
    due: Just today,
    owner: user2,
  }
  let after <- Db.get Todo todo1
  Task.succeed (
    {
      answer: r.answer,
      row: Maybe.map (\row -> {
        title: row.title,
        done: row.done,
        due: row.due,
        owner: row.owner,
      }) after,
      owners: Test.texts "select[name=owner] option" page.doc,
    } == {
      answer: Redirected (Admin.Todos.Show.Show { id: todo1 }),
      row: Just {
        title: Text.NonEmpty "title-2",
        done: True,
        due: Just today,
        owner: user2,
      },
      owners: ["email-1@example.com", "email-2@example.com"],
    }
  )
}

test "an owner not offered is refused" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let todo1 <- Db.insert Todo {
    title: Text.NonEmpty "title-1",
    due: Nothing,
    owner: me,
  }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let page <- Test.get (Edit { id: todo1 })
  let r <- Test.submitRaw (Save { id: todo1 }) [
    { name: "title", value: "x" },
    { name: "done", value: "True" },
    { name: "due", value: "" },
    { name: "owner", value: "missing" },
  ]
  let after <- Db.get Todo todo1
  Task.succeed (
    { answer: r.answer, owner: Maybe.map (\row -> row.owner) after }
      == {
        answer: FormRejected [{ field: "owner", message: "must be one of the options" }],
        owner: Just me,
      }
  )
}

test "a list of 200 users is offered whole" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let todo1 <- Db.insert Todo {
    title: Text.NonEmpty "title-1",
    due: Nothing,
    owner: me,
  }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert User {
        email: Text.Email ("email-" ++ Text.fromInt n ++ "@example.com"),
        name: Text.NonEmpty ("name-" ++ Text.fromInt n),
        passwordHash: "passwordhash-" ++ Text.fromInt n,
      }) (List.range 3 200)
    )
  let page <- Test.get (Edit { id: todo1 })
  Task.succeed (List.length page.model.owners == 200)
}

test "a long list of users offers 50, and the search narrows it" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let todo1 <- Db.insert Todo {
    title: Text.NonEmpty "title-1",
    due: Nothing,
    owner: me,
  }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert User {
        email: Text.Email ("email-" ++ Text.fromInt n ++ "@example.com"),
        name: Text.NonEmpty ("name-" ++ Text.fromInt n),
        passwordHash: "passwordhash-" ++ Text.fromInt n,
      }) (List.range 3 203)
    )
  let all <- Test.get (Edit { id: todo1 })
  let found <- Test.get (Edit { id: todo1, findOwner: "email-203@example.com" })
  let r <- Test.submit (SearchOwner { id: todo1 }) { q: "zz" }
  Task.succeed (
    {
      shown: List.length all.model.owners,
      total: all.model.ownersTotal,
      found: Test.count "select[name=owner] option" found.doc <= 3,
      answer: r.answer,
    } == {
      shown: 51,
      total: 203,
      found: True,
      answer: Redirected (Edit { id: todo1, findOwner: "zz" }),
    }
  )
}

test "the row's own owner is offered first when it sorts past the 50" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let user2 <- Db.insert User {
    email: Text.Email "zz-1@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let todo1 <- Db.insert Todo {
    title: Text.NonEmpty "title-1",
    due: Nothing,
    owner: user2,
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert User {
        email: Text.Email ("email-" ++ Text.fromInt n ++ "@example.com"),
        name: Text.NonEmpty ("name-" ++ Text.fromInt n),
        passwordHash: "passwordhash-" ++ Text.fromInt n,
      }) (List.range 3 203)
    )
  let page <- Test.get (Edit { id: todo1 })
  let r <- Test.submit (Save { id: todo1 }) {
    title: page.model.row.title,
    done: page.model.row.done,
    due: page.model.row.due,
    owner: page.model.row.owner,
  }
  let after <- Db.get Todo todo1
  Task.succeed (
    {
      answer: r.answer,
      kept: Maybe.map (\row -> row.owner) after,
      first: Maybe.map (\o -> o.id) (List.head page.model.owners),
      once: List.length (List.filter (\o -> o.id == user2) page.model.owners),
      shown: List.length page.model.owners,
    } == {
      answer: Redirected (Admin.Todos.Show.Show { id: todo1 }),
      kept: Just user2,
      first: Just user2,
      once: 1,
      shown: 51,
    }
  )
}

test "a demoted Admin cannot save a todo" = {
  let today <- Date.today
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let todo1 <- Db.insert Todo {
    title: Text.NonEmpty "title-1",
    due: Nothing,
    owner: me,
  }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let before <- Db.get Todo todo1
  let _ <- Test.get (Edit { id: todo1 })
  let _ <- Db.update User me (\u -> { u | role: Member })
  let r <- Test.submit (Save { id: todo1 }) {
    title: Text.NonEmpty "title-2",
    done: True,
    due: Just today,
    owner: user2,
  }
  let after <- Db.get Todo todo1
  Task.succeed (
    { answer: r.answer, row: after } == { answer: RequestFailed "400 bad request", row: before }
  )
}

test "a missing row is not found" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let r <- Test.open (Edit { id: Todo.TodoId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "a visitor is sent to log in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
  }
  let todo1 <- Db.insert Todo {
    title: Text.NonEmpty "title-1",
    due: Nothing,
    owner: me,
  }
  let r <- Test.open (Edit { id: todo1 })
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Member gets no page, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Member }
  let todo1 <- Db.insert Todo {
    title: Text.NonEmpty "title-1",
    due: Nothing,
    owner: me,
  }
  let r <- Test.open (Edit { id: todo1 })
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Member,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let todo1 <- Db.insert Todo {
    title: Text.NonEmpty "title-1",
    due: Nothing,
    owner: me,
  }
  let r <- Test.open (Edit { id: todo1 })
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
