-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Todo.Index

-- @admin begin imports
import Admin.Layout
import Todo
import User
-- @admin end

page "/admin/todo" { q: Text = "", sort: Text = "created", dir: Text = "desc", page: Int = 1 } requires user, role Admin

type Model = {
  rows: List Todo,
  labels: Labels,
  q: Text,
  sort: Text,
  dir: Text,
  page: Int,
  pages: Int,
  count: Int,
}

perPage : Int
perPage = 25

-- @admin begin search
-- search is the rows whose text contains q (every row for "").
search : Text -> Condition Todo
search q = Db.or [Todo.title.contains q]
-- @admin end

-- @admin begin sorts
-- sorts are the columns the list sorts by, by name.
sorts : List { name: Text, asc: Order Todo, desc: Order Todo }
sorts = [
  { name: "title", asc: Todo.title.asc, desc: Todo.title.desc },
  { name: "done", asc: Todo.done.asc, desc: Todo.done.desc },
  { name: "due", asc: Todo.due.asc, desc: Todo.due.desc },
  { name: "owner", asc: Todo.owner.asc, desc: Todo.owner.desc },
  { name: "created", asc: Todo.created.asc, desc: Todo.created.desc },
]
-- @admin end

-- order is the ordering sort names, ascending when dir is "asc"; a name that is not a column's
-- sorts newest first.
order : Text -> Text -> Order Todo
order sort dir = match List.find (\s -> s.name == sort) sorts {
  Just s -> if dir == "asc" then s.asc else s.desc,
  Nothing -> Todo.created.desc,
}

-- load reads how many rows match the search, and one page of them (the last, for a page past it),
-- in the order asked for. The search text is cut to 200 characters (Text.slice): a text over
-- 10,000 bytes would fail the query (chapter 8, "Search").
load : Params -> Session -> Query Model
load params session = {
  let admin <- Admin.Layout.isAdmin session.user
  if admin then {
    let q = Text.slice 0 200 params.q
    let count <- Db.from Todo |> Db.where (search q) |> Db.count
    let pages = Int.max 1 ((count + perPage - 1) / perPage)
    let page = Int.clamp { min: 1, max: pages } params.page
    let rows <-
      Db.from Todo
        |> Db.where (search q)
        |> Db.orderBy (order params.sort params.dir)
        |> Db.limit perPage
        |> Db.offset ((page - 1) * perPage)
        |> Db.all
    let labels <- labelsOf rows
    Query.succeed {
      rows: rows,
      labels: labels,
      q: q,
      sort: params.sort,
      dir: params.dir,
      page: page,
      pages: pages,
      count: count,
    }
  } else Query.notFound
}

-- @admin begin labels
-- Labels are the rows the references of the rows shown name: their links show their labels.
type Labels = { owners: List User }

-- labelsOf reads the rows that rows refer to.
labelsOf : List Todo -> Query Labels
labelsOf rows = {
  let owners <- Db.from User |> Db.where (User.id.in (List.map (\row -> row.owner) rows)) |> Db.all
  Query.succeed { owners: owners }
}

-- ownerLabel is the label of the user id names (the id itself if it names none).
ownerLabel : Labels -> User.UserId -> Text
ownerLabel labels id = match List.find (\r -> r.id == id) labels.owners {
  Just r -> r.email,
  Nothing -> id,
}
-- @admin end

view : Model -> Session -> Html Msg
view model session =
  <Admin.Layout.Page title="Todos">
    <h1>Todos</h1>

    <al-stack direction="row" gap="sm">
      <form method="get" action="/admin/todo">
        <input type="search" name="q" value={model.q} aria-label="Search" />
        <input type="hidden" name="sort" value={model.sort} />
        <input type="hidden" name="dir" value={model.dir} />
      </form>
      <al-button href={Admin.Todo.New {}}>New todo</al-button>
    </al-stack>

    <p id="count">{if model.count == 1 then "1 row" else Text.fromInt model.count ++ " rows"}</p>

    <al-table>
      <table>
        <thead>
          <tr>
            -- @admin begin headers
            <th>
              <a href={Admin.Todo.Index {
                q: model.q,
                sort: "title",
                dir: if model.sort == "title" && model.dir == "asc" then "desc" else "asc",
              }}>Title</a>
            </th>
            <th>
              <a href={Admin.Todo.Index {
                q: model.q,
                sort: "done",
                dir: if model.sort == "done" && model.dir == "asc" then "desc" else "asc",
              }}>Done</a>
            </th>
            <th>
              <a href={Admin.Todo.Index {
                q: model.q,
                sort: "due",
                dir: if model.sort == "due" && model.dir == "asc" then "desc" else "asc",
              }}>Due</a>
            </th>
            <th>
              <a href={Admin.Todo.Index {
                q: model.q,
                sort: "owner",
                dir: if model.sort == "owner" && model.dir == "asc" then "desc" else "asc",
              }}>Owner</a>
            </th>
            <th>
              <a href={Admin.Todo.Index {
                q: model.q,
                sort: "created",
                dir: if model.sort == "created" && model.dir == "asc" then "desc" else "asc",
              }}>Created</a>
            </th>
            -- @admin end
          </tr>
        </thead>
        <tbody>
          {for row in model.rows ->
            <tr>
              -- @admin begin cells
              <td><a href={Admin.Todo.Show { id: row.id }}>{row.title}</a></td>
              <td>{if row.done then <al-badge>Yes</al-badge> else <al-badge variant="secondary">No</al-badge>}</td>
              <td>{match row.due { Just v -> Date.format "Jan 2, 2006" v, Nothing -> "" }}</td>
              <td><a href={Admin.User.Show { id: row.owner }}>{ownerLabel model.labels row.owner}</a></td>
              <td>{Time.format "Jan 2, 2006" row.created}</td>
              -- @admin end
            </tr>}
        </tbody>
      </table>
    </al-table>

    <al-pagination role="navigation" aria-label="Pages">
      {if model.page > 1 then <a slot="prev" href={Admin.Todo.Index { q: model.q, sort: model.sort, dir: model.dir, page: model.page - 1 }} rel="prev">Previous</a> else <span slot="prev" aria-disabled="true">Previous</span>}
      <span>Page {Text.fromInt model.page} of {Text.fromInt model.pages}</span>
      {if model.page < model.pages then <a slot="next" href={Admin.Todo.Index { q: model.q, sort: model.sort, dir: model.dir, page: model.page + 1 }} rel="next">Next</a> else <span slot="next" aria-disabled="true">Next</span>}
    </al-pagination>
  </Admin.Layout.Page>

-- @admin begin tests
test "the list shows every row, newest first, and the labels of the rows they refer to" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let todo1 <- Db.insert Todo { title: Text.NonEmpty "title-1", due: Nothing, owner: me }
  let todo2 <- Db.insert Todo { title: Text.NonEmpty "title-2", due: Nothing, owner: me }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let page <- Test.get (Admin.Todo.Index {})
  Task.succeed ({
    rows: List.map (\row -> row.id) page.model.rows,
    owners: List.length page.model.labels.owners,
    ownerLabel: ownerLabel page.model.labels me,
  } == {
    rows: [todo2, todo1],
    owners: 1,
    ownerLabel: "email-1@example.com",
  })
}

test "sorting by title goes both ways" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let todo1 <- Db.insert Todo { title: Text.NonEmpty "title-2", due: Nothing, owner: me }
  let todo2 <- Db.insert Todo { title: Text.NonEmpty "title-1", due: Nothing, owner: me }
  let up <- Test.get (Admin.Todo.Index { sort: "title", dir: "asc" })
  let down <- Test.get (Admin.Todo.Index { sort: "title" })
  Task.succeed ({
    up: List.map (\row -> row.id) up.model.rows,
    down: List.map (\row -> row.id) down.model.rows,
  } == {
    up: [todo2, todo1],
    down: [todo1, todo2],
  })
}

test "searching finds the rows that contain the text" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let todo1 <- Db.insert Todo { title: Text.NonEmpty "title-1", due: Nothing, owner: me }
  let todo2 <- Db.insert Todo { title: Text.NonEmpty "title-2", due: Nothing, owner: me }
  let page <- Test.get (Admin.Todo.Index { q: "title-2" })
  Task.succeed ({
    rows: List.map (\row -> row.id) page.model.rows,
    count: Test.text "#count" page.doc,
  } == {
    rows: [todo2],
    count: Just "1 row",
  })
}

test "a search text of 20,000 characters is cut to 200" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let long = Text.join "" (List.map (\n -> "z") (List.range 1 20000))
  let page <- Test.get (Admin.Todo.Index { q: long })
  Task.succeed ({
    q: Text.length page.model.q,
    rows: List.length page.model.rows,
  } == {
    q: 200,
    rows: 0,
  })
}

test "the list has 25 rows a page, and a page past the last is the last" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let _ <- Task.all (List.map (\n -> Db.insert Todo {
    title: Text.NonEmpty ("title-" ++ Text.fromInt n),
    due: Nothing,
    owner: me,
  }) (List.range 1 26))
  let first <- Test.get (Admin.Todo.Index {})
  let second <- Test.get (Admin.Todo.Index { page: 2 })
  let past <- Test.get (Admin.Todo.Index { page: 9 })
  Task.succeed ({
    first: List.length first.model.rows,
    second: List.length second.model.rows,
    past: { page: past.model.page, rows: List.length past.model.rows },
    count: Test.text "#count" first.doc,
    pages: Test.texts "al-pagination span" first.doc,
  } == {
    first: 25,
    second: 1,
    past: { page: 2, rows: 1 },
    count: Just "26 rows",
    pages: ["Previous", "Page 1 of 2"],
  })
}

test "a visitor is sent to log in" = {
  let r <- Test.open (Admin.Todo.Index {})
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Member gets no page, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Member }
  let r <- Test.open (Admin.Todo.Index {})
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Member,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let r <- Test.open (Admin.Todo.Index {})
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
