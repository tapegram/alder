-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Index

-- @admin begin imports
import Admin.Layout
import Table.Todo
import Table.User
-- @admin end

page "/admin" { } requires user, role Admin

-- A card of the dashboard: a table's count and its newest rows, each linking to its page.
type Card = {
  key: Text,
  title: Text,
  href: Page,
  count: Int,
  rows: List { label: Text, href: Page },
}

type Model = { cards: List Card }

-- recent is how many of a table's newest rows its card lists.
recent : Int
recent = 5

load : Params -> Session -> Query Model
load params session = {
  let admin <- Layout.isAdmin session.user
  if admin then {
    -- @admin begin cards
    let todos <-
      Db.from Todo
        |> Db.orderBy Todo.created.desc
        |> Db.limit recent
        |> Db.all
    let todoCount <- Db.from Todo |> Db.count
    let users <-
      Db.from User
        |> Db.orderBy User.created.desc
        |> Db.limit recent
        |> Db.all
    let userCount <- Db.from User |> Db.count
    Query.succeed {
      cards: [
        {
          key: "todos",
          title: "Todos",
          href: Admin.Todos.Index {},
          count: todoCount,
          rows: List.map (\row -> {
            label: row.title,
            href: Admin.Todos.Show { id: row.id },
          }) todos,
        },
        {
          key: "users",
          title: "Users",
          href: Admin.Users.Index {},
          count: userCount,
          rows: List.map (\row -> {
            label: row.email,
            href: Admin.Users.Show { id: row.id },
          }) users,
        },
      ],
    }
    -- @admin end
  } else
    Query.notFound
}

view : Model -> Session -> Html Msg
view model session =
  <Layout.Page title="Dashboard">
    <h1>Admin</h1>

    <al-stack gap="md">
      {for card in model.cards ->
        <al-card id={card.key}>
          <h2 slot="header">
            <a href={card.href}>{card.title}</a> <al-badge variant="secondary">{Text.fromInt card.count}</al-badge>
          </h2>
          <ul>
            {for row in card.rows -> <li><a href={row.href}>{row.label}</a></li>}
          </ul>
        </al-card>}
    </al-stack>
  </Layout.Page>

-- @admin begin tests
test "the dashboard counts the todos and lists the newest five" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Todo {
        title: Text.NonEmpty ("title-" ++ Text.fromInt n),
        due: Nothing,
        owner: me,
      }) (List.range 1 6)
    )
  let page <- Test.get (Admin.Index {})
  Task.succeed (
    { count: Test.text "#todos al-badge" page.doc, rows: Test.texts "#todos li" page.doc }
      == { count: Just "6", rows: ["title-6", "title-5", "title-4", "title-3", "title-2"] }
  )
}

test "the dashboard counts the users and lists the newest five" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert User {
        email: Text.Email ("email-" ++ Text.fromInt n ++ "@example.com"),
        name: Text.NonEmpty ("name-" ++ Text.fromInt n),
        passwordHash: "passwordhash-" ++ Text.fromInt n,
      }) (List.range 2 7)
    )
  let page <- Test.get (Admin.Index {})
  Task.succeed (
    { count: Test.text "#users al-badge" page.doc, rows: Test.texts "#users li" page.doc }
      == {
        count: Just "7",
        rows: [
          "email-7@example.com",
          "email-6@example.com",
          "email-5@example.com",
          "email-4@example.com",
          "email-3@example.com",
        ],
      }
  )
}

test "a visitor is sent to log in" = {
  let r <- Test.open (Admin.Index {})
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Member gets no page, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login { user: Just me, role: Member }
  let r <- Test.open (Admin.Index {})
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Member,
  }
  let _ <- Test.login { user: Just me, role: Admin }
  let r <- Test.open (Admin.Index {})
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
