module Jobs.Nightly

job Nightly = {} cron "0 3 * * *"

Nightly.run : Nightly.Params -> Task Unit
Nightly.run p = Log.info "nightly ran"

-- 2026-03-04T02:59:00Z, a minute before the nightly tick
beforeThree : Time
beforeThree = Time.fromMillis 1772593140000

-- The first Test.work plays the worker's start: it creates the tick at 03:00 and runs nothing.
-- Three days later the missed ticks run once, not three times. Each run must succeed.
-- Only this job's runs are checked: another job's tick may come due in the same call.
test "the nightly job runs at 03:00 UTC, and once after an outage" = {
  let _ <- Test.setClock beforeThree
  let start <- Test.work
  let _ <- Test.advance 120000
  let first <- Test.work
  let _ <- Test.advance (3 * 86400000)
  let late <- Test.work
  let job = Nightly {}
  let ownStart = List.filter (\r -> r.job == job) start
  let ownFirst = List.filter (\r -> r.job == job) first
  let ownLate = List.filter (\r -> r.job == job) late
  Task.succeed (
    List.isEmpty ownStart
      && List.map (\r -> r.result) ownFirst == [Ok ()]
      && List.map (\r -> r.result) ownLate == [Ok ()]
  )
}
