module Projects.Index

import Layout
import Table.Membership
import Table.Org
import Table.Project
import Table.User

-- The org's projects. `requires user, org`: a visitor is sent to log in, a user without an org
-- to `choose org`'s page; here `session.org` is an Org.OrgId, and `Db.scoped Project` reads the
-- org's own database.
page "/projects" { } requires user, org

type Model = { org: Text, projects: List Project }

-- load re-reads the membership first (Membership.isMember, the re-read idiom): the cookie's org
-- was a member's when it was put, and a member removed since is turned away at once. Then a
-- read of each store in one load: the org's name from the shared database, its projects from
-- its own.
load : Params -> Session -> Query Model
load params session = {
  let member <- Membership.isMember session.user session.org
  if member then {
    let org <- Db.get Org session.org
    let projects <-
      Db.scoped Project
        |> Db.orderBy Project.name.asc
        |> Db.all
    Query.succeed { org: Maybe.withDefault "" (Maybe.map (\o -> o.name) org), projects: projects }
  } else
    Query.notFound
}

form NewProject = { name: Text.NonEmpty }

msg Create form NewProject

msg Remove { id: Project.ProjectId }

-- Each Task writes to the org's database only (E0031 refuses a Task that writes there and to
-- the shared one): Db.insertScoped fills in `org`, Db.deleteScoped finds nothing of another org.
update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  Create p -> {
    let id <- Db.insertScoped Project { name: p.form.name }
    Task.succeed (Redirect (Projects.Show { id: id }))
  },
  Remove p -> {
    let _ <- Db.deleteScoped Project p.id
    Task.succeed Rerender
  },
}

view : Model -> Session -> Html Msg
view model session =
  <Layout.Page title={model.org}>
    <h1>{model.org}</h1>
    <ul id="projects">
      {for p in model.projects ->
        <li>
          <a class="name" href={Projects.Show { id: p.id }}>{p.name}</a>
          <al-button variant="outline" click={Remove { id: p.id }}>Remove</al-button>
        </li>}
    </ul>
    <al-card>
      <h2 slot="header">A new project</h2>
      <form submit={Create}>
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-input field="name" label="Name" />
        <al-button type="submit">Create</al-button>
      </form>
    </al-card>
    <al-button variant="outline" click={App.Leave}>Another org</al-button>
  </Layout.Page>

test "a member sees the org's name and only its projects, by name" = {
  let ann <- Db.insert User {
    email: Text.Email "ann@example.com",
    name: Text.NonEmpty "Ann",
    passwordHash: "",
  }
  let bob <- Db.insert User {
    email: Text.Email "bob@example.com",
    name: Text.NonEmpty "Bob",
    passwordHash: "",
  }
  let cy <- Db.insert User {
    email: Text.Email "cy@example.com",
    name: Text.NonEmpty "Cy",
    passwordHash: "",
  }
  let acme <- Db.insert Org { name: Text.NonEmpty "Acme" }
  let globex <- Db.insert Org { name: Text.NonEmpty "Globex" }
  let _ <- Test.member ann acme
  let _ <- Test.member bob globex
  let _ <- Test.member cy acme
  let _ <- Test.member cy globex
  let rocket <- Db.insert Project { name: Text.NonEmpty "Rocket", org: acme }
  let widget <- Db.insert Project { name: Text.NonEmpty "Widget", org: globex }
  let s = {
    ann: ann,
    bob: bob,
    cy: cy,
    acme: acme,
    globex: globex,
    rocket: rocket,
    widget: widget,
  }
  let _ <- Db.insert Project { name: Text.NonEmpty "Apollo", org: s.acme }
  let _ <- Test.login { user: Just s.ann, org: Just s.acme }
  let page <- Test.get (Projects.Index {})
  Task.succeed (
    { org: Test.text "h1" page.doc, projects: Test.texts "#projects .name" page.doc }
      == { org: Just "Acme", projects: ["Apollo", "Rocket"] }
  )
}

test "a project is created in the org's database, and another org does not see it" = {
  let ann <- Db.insert User {
    email: Text.Email "ann@example.com",
    name: Text.NonEmpty "Ann",
    passwordHash: "",
  }
  let bob <- Db.insert User {
    email: Text.Email "bob@example.com",
    name: Text.NonEmpty "Bob",
    passwordHash: "",
  }
  let cy <- Db.insert User {
    email: Text.Email "cy@example.com",
    name: Text.NonEmpty "Cy",
    passwordHash: "",
  }
  let acme <- Db.insert Org { name: Text.NonEmpty "Acme" }
  let globex <- Db.insert Org { name: Text.NonEmpty "Globex" }
  let _ <- Test.member ann acme
  let _ <- Test.member bob globex
  let _ <- Test.member cy acme
  let _ <- Test.member cy globex
  let rocket <- Db.insert Project { name: Text.NonEmpty "Rocket", org: acme }
  let widget <- Db.insert Project { name: Text.NonEmpty "Widget", org: globex }
  let s = {
    ann: ann,
    bob: bob,
    cy: cy,
    acme: acme,
    globex: globex,
    rocket: rocket,
    widget: widget,
  }
  let _ <- Test.login { user: Just s.cy, org: Just s.acme }
  let _ <- Test.get (Projects.Index {})
  let r <- Test.submit NewProject { name: Text.NonEmpty "Zephyr" }
  let inAcme <-
    Db.scoped Project
      |> Db.where (Project.name.eq (Text.NonEmpty "Zephyr"))
      |> Db.all
  let acme <- Test.get (Projects.Index {})
  let _ <- Test.login { user: Just s.cy, org: Just s.globex }
  let globex <- Test.get (Projects.Index {})
  let inGlobex <-
    Db.scoped Project
      |> Db.where (Project.name.eq (Text.NonEmpty "Zephyr"))
      |> Db.count
  Task.succeed (
    {
      answer: List.map (\p -> Redirected (Projects.Show { id: p.id })) inAcme,
      acme: Test.texts "#projects .name" acme.doc,
      globex: Test.texts "#projects .name" globex.doc,
      inGlobex: inGlobex,
    } == {
        answer: [r.answer],
        acme: ["Rocket", "Zephyr"],
        globex: ["Widget"],
        inGlobex: 0,
      }
  )
}

test "removing a project" = {
  let ann <- Db.insert User {
    email: Text.Email "ann@example.com",
    name: Text.NonEmpty "Ann",
    passwordHash: "",
  }
  let bob <- Db.insert User {
    email: Text.Email "bob@example.com",
    name: Text.NonEmpty "Bob",
    passwordHash: "",
  }
  let cy <- Db.insert User {
    email: Text.Email "cy@example.com",
    name: Text.NonEmpty "Cy",
    passwordHash: "",
  }
  let acme <- Db.insert Org { name: Text.NonEmpty "Acme" }
  let globex <- Db.insert Org { name: Text.NonEmpty "Globex" }
  let _ <- Test.member ann acme
  let _ <- Test.member bob globex
  let _ <- Test.member cy acme
  let _ <- Test.member cy globex
  let rocket <- Db.insert Project { name: Text.NonEmpty "Rocket", org: acme }
  let widget <- Db.insert Project { name: Text.NonEmpty "Widget", org: globex }
  let s = {
    ann: ann,
    bob: bob,
    cy: cy,
    acme: acme,
    globex: globex,
    rocket: rocket,
    widget: widget,
  }
  let _ <- Test.login { user: Just s.ann, org: Just s.acme }
  let _ <- Test.get (Projects.Index {})
  let r <- Test.click (Remove { id: s.rocket })
  Task.succeed (
    { answer: r.answer, projects: Test.texts "#projects .name" r.doc }
      == { answer: Rerendered, projects: [] }
  )
}

-- A request crafted by hand: Ann's page has no button for Globex's project. Db.deleteScoped looks
-- in Acme's database, where there is no such row: not found, and Globex keeps it.
test "another org's project cannot be removed" = {
  let ann <- Db.insert User {
    email: Text.Email "ann@example.com",
    name: Text.NonEmpty "Ann",
    passwordHash: "",
  }
  let bob <- Db.insert User {
    email: Text.Email "bob@example.com",
    name: Text.NonEmpty "Bob",
    passwordHash: "",
  }
  let cy <- Db.insert User {
    email: Text.Email "cy@example.com",
    name: Text.NonEmpty "Cy",
    passwordHash: "",
  }
  let acme <- Db.insert Org { name: Text.NonEmpty "Acme" }
  let globex <- Db.insert Org { name: Text.NonEmpty "Globex" }
  let _ <- Test.member ann acme
  let _ <- Test.member bob globex
  let _ <- Test.member cy acme
  let _ <- Test.member cy globex
  let rocket <- Db.insert Project { name: Text.NonEmpty "Rocket", org: acme }
  let widget <- Db.insert Project { name: Text.NonEmpty "Widget", org: globex }
  let s = {
    ann: ann,
    bob: bob,
    cy: cy,
    acme: acme,
    globex: globex,
    rocket: rocket,
    widget: widget,
  }
  let _ <- Test.login { user: Just s.ann, org: Just s.acme }
  let model <- Test.get (Projects.Index {})
  let r <-
    Test.run (update (Remove { id: s.widget }) model.model {
      user: s.ann,
      org: s.acme,
      role: Member,
    })
  let _ <- Test.login { user: Just s.bob, org: Just s.globex }
  let globex <- Test.get (Projects.Index {})
  Task.succeed (
    { value: r.value, globex: Test.texts "#projects .name" globex.doc }
      == { value: Err "not found", globex: ["Widget"] }
  )
}

-- The re-read idiom: Ann's cookie still says Acme, but her Membership row is gone.
test "a member removed from the org loses access at once" = {
  let ann <- Db.insert User {
    email: Text.Email "ann@example.com",
    name: Text.NonEmpty "Ann",
    passwordHash: "",
  }
  let bob <- Db.insert User {
    email: Text.Email "bob@example.com",
    name: Text.NonEmpty "Bob",
    passwordHash: "",
  }
  let cy <- Db.insert User {
    email: Text.Email "cy@example.com",
    name: Text.NonEmpty "Cy",
    passwordHash: "",
  }
  let acme <- Db.insert Org { name: Text.NonEmpty "Acme" }
  let globex <- Db.insert Org { name: Text.NonEmpty "Globex" }
  let _ <- Test.member ann acme
  let _ <- Test.member bob globex
  let _ <- Test.member cy acme
  let _ <- Test.member cy globex
  let rocket <- Db.insert Project { name: Text.NonEmpty "Rocket", org: acme }
  let widget <- Db.insert Project { name: Text.NonEmpty "Widget", org: globex }
  let s = {
    ann: ann,
    bob: bob,
    cy: cy,
    acme: acme,
    globex: globex,
    rocket: rocket,
    widget: widget,
  }
  let _ <- Test.login { user: Just s.ann, org: Just s.acme }
  let before <- Test.open (Projects.Index {})
  let rows <-
    Db.from Membership
      |> Db.where (Membership.user.eq s.ann)
      |> Db.all
  let _ <- Task.all (List.map (\m -> Db.delete Membership m.id) rows)
  let after <- Test.open (Projects.Index {})
  Task.succeed (
    { before: before.answer, after: after.answer } == { before: Shown, after: PageMissing }
  )
}

test "without an org the page sends you to choose one" = {
  let ann <- Db.insert User {
    email: Text.Email "ann@example.com",
    name: Text.NonEmpty "Ann",
    passwordHash: "",
  }
  let bob <- Db.insert User {
    email: Text.Email "bob@example.com",
    name: Text.NonEmpty "Bob",
    passwordHash: "",
  }
  let cy <- Db.insert User {
    email: Text.Email "cy@example.com",
    name: Text.NonEmpty "Cy",
    passwordHash: "",
  }
  let acme <- Db.insert Org { name: Text.NonEmpty "Acme" }
  let globex <- Db.insert Org { name: Text.NonEmpty "Globex" }
  let _ <- Test.member ann acme
  let _ <- Test.member bob globex
  let _ <- Test.member cy acme
  let _ <- Test.member cy globex
  let rocket <- Db.insert Project { name: Text.NonEmpty "Rocket", org: acme }
  let widget <- Db.insert Project { name: Text.NonEmpty "Widget", org: globex }
  let s = {
    ann: ann,
    bob: bob,
    cy: cy,
    acme: acme,
    globex: globex,
    rocket: rocket,
    widget: widget,
  }
  let _ <- Test.login { user: Just s.ann, org: Nothing }
  let r <- Test.open (Projects.Index {})
  Task.succeed (r.answer == Redirected (Orgs.Index {}))
}

test "another org goes back to the list of orgs" = {
  let ann <- Db.insert User {
    email: Text.Email "ann@example.com",
    name: Text.NonEmpty "Ann",
    passwordHash: "",
  }
  let bob <- Db.insert User {
    email: Text.Email "bob@example.com",
    name: Text.NonEmpty "Bob",
    passwordHash: "",
  }
  let cy <- Db.insert User {
    email: Text.Email "cy@example.com",
    name: Text.NonEmpty "Cy",
    passwordHash: "",
  }
  let acme <- Db.insert Org { name: Text.NonEmpty "Acme" }
  let globex <- Db.insert Org { name: Text.NonEmpty "Globex" }
  let _ <- Test.member ann acme
  let _ <- Test.member bob globex
  let _ <- Test.member cy acme
  let _ <- Test.member cy globex
  let rocket <- Db.insert Project { name: Text.NonEmpty "Rocket", org: acme }
  let widget <- Db.insert Project { name: Text.NonEmpty "Widget", org: globex }
  let s = {
    ann: ann,
    bob: bob,
    cy: cy,
    acme: acme,
    globex: globex,
    rocket: rocket,
    widget: widget,
  }
  let _ <- Test.login { user: Just s.ann, org: Just s.acme }
  let _ <- Test.get (Projects.Index {})
  let r <- Test.click App.Leave
  Task.succeed (
    { answer: r.answer, org: r.session.org } == { answer: Redirected (Orgs.Index {}), org: Nothing }
  )
}

test "a visitor is sent to log in" = {
  let r <- Test.open (Projects.Index {})
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}
