module Projects.Show

import Layout
import Table.Membership
import Table.Org
import Table.Project
import Table.Todo
import Table.User

-- One project of the org and its to-dos. `Db.getScoped Project` answers 404 for an id that is
-- not in the org's database (another org's project included).
route Show   = GET  "/projects/{id}"       { id: Project.ProjectId }              requires user, org
route Add    = POST "/projects/{id}/_/Add" { id: Project.ProjectId } form NewTodo requires user, org
route Toggle = POST "/projects/_/Toggle"   { id: Todo.TodoId }                    requires user, org

type Model = { project: Project, todos: List Todo }

Show.load : Show.Params -> Session -> Query Model
Show.load params session = {
  let member <- Membership.isMember session.user session.org
  if member then {
    let project <- Db.getScoped Project params.id
    let todos <-
      Db.scoped Todo
        |> Db.where (Todo.project.eq project.id)
        |> Db.orderBy Todo.created.asc
        |> Db.all
    Query.succeed { project: project, todos: todos }
  } else
    Query.notFound
}

form NewTodo = { title: Text.NonEmpty }

-- No `load` runs before a write route: each re-reads the membership, and Add the project, which
-- is a 404 when it is not the org's.
Add.update : Add.Params -> Session -> Task Response
Add.update p session = {
  let _ <- Membership.memberOnly session.user session.org
  let project <- Db.getScoped Project p.id
  let _ <- Db.insertScoped Todo { title: p.form.title, project: project.id }
  Task.succeed Response.refresh
}

Toggle.update : Toggle.Params -> Session -> Task Response
Toggle.update p session = {
  let _ <- Membership.memberOnly session.user session.org
  let _ <- Db.updateScoped Todo p.id (\t -> { t | done: not t.done })
  Task.succeed Response.refresh
}

Show.view : Model -> Session -> Html
Show.view model session =
  <Layout.Page title={model.project.name}>
    <h1>{model.project.name}</h1>
    <ul id="todos">
      {for t in model.todos ->
        <li class={if t.done then "done" else "open"}>
          <span class="title">{t.title}</span>
          <al-button variant="outline" click={Toggle { id: t.id }}>
            {if t.done then "Reopen" else "Done"}
          </al-button>
        </li>}
    </ul>
    <al-card>
      <form submit={Add { id: model.project.id }}>
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-input field="title" label="To do" />
        <al-button type="submit">Add</al-button>
      </form>
    </al-card>
    <a href={Projects.Index.Index {}}>All projects</a>
  </Layout.Page>

test "the project's to-dos, oldest first, and adding one" = {
  let ann <- Db.insert User {
    email: Text.Email "ann@example.com",
    name: Text.NonEmpty "Ann",
    passwordHash: "",
  }
  let bob <- Db.insert User {
    email: Text.Email "bob@example.com",
    name: Text.NonEmpty "Bob",
    passwordHash: "",
  }
  let acme <- Db.insert Org { name: Text.NonEmpty "Acme" }
  let globex <- Db.insert Org { name: Text.NonEmpty "Globex" }
  let _ <- Test.member ann acme
  let _ <- Test.member bob globex
  let rocket <- Db.insert Project { name: Text.NonEmpty "Rocket", org: acme }
  let widget <- Db.insert Project { name: Text.NonEmpty "Widget", org: globex }
  let s = {
    ann: ann,
    bob: bob,
    acme: acme,
    globex: globex,
    rocket: rocket,
    widget: widget,
  }
  let other <- Db.insert Project { name: Text.NonEmpty "Apollo", org: s.acme }
  let _ <- Db.insert Todo {
    title: Text.NonEmpty "Fuel",
    project: s.rocket,
    org: s.acme,
  }
  let _ <- Db.insert Todo {
    title: Text.NonEmpty "Elsewhere",
    project: other,
    org: s.acme,
  }
  let _ <- Test.login { user: Just s.ann, org: Just s.acme }
  let page <- Test.get (Show { id: s.rocket })
  let r <- Test.submit (Add { id: s.rocket }) { title: Text.NonEmpty "Launch" }
  Task.succeed (
    {
      name: Test.text "h1" page.doc,
      before: Test.texts "#todos .title" page.doc,
      answer: r.answer,
      after: Test.texts "#todos .title" r.doc,
    } == {
      name: Just "Rocket",
      before: ["Fuel"],
      answer: Refreshed,
      after: ["Fuel", "Launch"],
    }
  )
}

test "Done marks a to-do done, and Reopen opens it again" = {
  let ann <- Db.insert User {
    email: Text.Email "ann@example.com",
    name: Text.NonEmpty "Ann",
    passwordHash: "",
  }
  let bob <- Db.insert User {
    email: Text.Email "bob@example.com",
    name: Text.NonEmpty "Bob",
    passwordHash: "",
  }
  let acme <- Db.insert Org { name: Text.NonEmpty "Acme" }
  let globex <- Db.insert Org { name: Text.NonEmpty "Globex" }
  let _ <- Test.member ann acme
  let _ <- Test.member bob globex
  let rocket <- Db.insert Project { name: Text.NonEmpty "Rocket", org: acme }
  let widget <- Db.insert Project { name: Text.NonEmpty "Widget", org: globex }
  let s = {
    ann: ann,
    bob: bob,
    acme: acme,
    globex: globex,
    rocket: rocket,
    widget: widget,
  }
  let fuel <- Db.insert Todo {
    title: Text.NonEmpty "Fuel",
    project: s.rocket,
    org: s.acme,
  }
  let _ <- Test.login { user: Just s.ann, org: Just s.acme }
  let _ <- Test.get (Show { id: s.rocket })
  let done <- Test.click (Toggle { id: fuel })
  let open <- Test.click (Toggle { id: fuel })
  Task.succeed (
    {
      answers: [done.answer, open.answer],
      done: Test.texts "#todos li.done .title" done.doc,
      open: Test.texts "#todos li.open .title" open.doc,
    }
      == { answers: [Refreshed, Refreshed], done: ["Fuel"], open: ["Fuel"] }
  )
}

-- No `load` runs before Add or Toggle: each begins with Membership.memberOnly, so a member
-- removed while the page is open adds no to-do and toggles none (the refresh after a write
-- would be a 404 too, so the rows tell).
test "a removed member cannot add or toggle a to-do from a page shown before" = {
  let ann <- Db.insert User {
    email: Text.Email "ann@example.com",
    name: Text.NonEmpty "Ann",
    passwordHash: "",
  }
  let acme <- Db.insert Org { name: Text.NonEmpty "Acme" }
  let _ <- Test.member ann acme
  let rocket <- Db.insert Project { name: Text.NonEmpty "Rocket", org: acme }
  let fuel <- Db.insert Todo {
    title: Text.NonEmpty "Fuel",
    project: rocket,
    org: acme,
  }
  let _ <- Test.login { user: Just ann, org: Just acme }
  let _ <- Test.get (Show { id: rocket })
  let rows <-
    Db.from Membership
      |> Db.where (Membership.user.eq ann)
      |> Db.all
  let _ <- Task.all (List.map (\m -> Db.delete Membership m.id) rows)
  let added <- Test.submit (Add { id: rocket }) { title: Text.NonEmpty "Launch" }
  let _ <- Test.member ann acme
  let _ <- Test.get (Show { id: rocket })
  let again <-
    Db.from Membership
      |> Db.where (Membership.user.eq ann)
      |> Db.all
  let _ <- Task.all (List.map (\m -> Db.delete Membership m.id) again)
  let toggled <- Test.click (Toggle { id: fuel })
  let todos <- Db.from Todo |> Db.all
  Task.succeed (
    {
      added: added.answer,
      toggled: toggled.answer,
      todos: List.map (\t -> { title: t.title, done: t.done }) todos,
    } == {
      added: PageMissing,
      toggled: PageMissing,
      todos: [{ title: Text.NonEmpty "Fuel", done: False }],
    }
  )
}

test "another org's project is not found" = {
  let ann <- Db.insert User {
    email: Text.Email "ann@example.com",
    name: Text.NonEmpty "Ann",
    passwordHash: "",
  }
  let bob <- Db.insert User {
    email: Text.Email "bob@example.com",
    name: Text.NonEmpty "Bob",
    passwordHash: "",
  }
  let acme <- Db.insert Org { name: Text.NonEmpty "Acme" }
  let globex <- Db.insert Org { name: Text.NonEmpty "Globex" }
  let _ <- Test.member ann acme
  let _ <- Test.member bob globex
  let rocket <- Db.insert Project { name: Text.NonEmpty "Rocket", org: acme }
  let widget <- Db.insert Project { name: Text.NonEmpty "Widget", org: globex }
  let s = {
    ann: ann,
    bob: bob,
    acme: acme,
    globex: globex,
    rocket: rocket,
    widget: widget,
  }
  let _ <- Test.login { user: Just s.ann, org: Just s.acme }
  let r <- Test.open (Show { id: s.widget })
  Task.succeed (r.answer == PageMissing)
}

test "a member removed from the org loses access at once" = {
  let ann <- Db.insert User {
    email: Text.Email "ann@example.com",
    name: Text.NonEmpty "Ann",
    passwordHash: "",
  }
  let bob <- Db.insert User {
    email: Text.Email "bob@example.com",
    name: Text.NonEmpty "Bob",
    passwordHash: "",
  }
  let acme <- Db.insert Org { name: Text.NonEmpty "Acme" }
  let globex <- Db.insert Org { name: Text.NonEmpty "Globex" }
  let _ <- Test.member ann acme
  let _ <- Test.member bob globex
  let rocket <- Db.insert Project { name: Text.NonEmpty "Rocket", org: acme }
  let widget <- Db.insert Project { name: Text.NonEmpty "Widget", org: globex }
  let s = {
    ann: ann,
    bob: bob,
    acme: acme,
    globex: globex,
    rocket: rocket,
    widget: widget,
  }
  let _ <- Test.login { user: Just s.ann, org: Just s.acme }
  let rows <-
    Db.from Membership
      |> Db.where (Membership.user.eq s.ann)
      |> Db.all
  let _ <- Task.all (List.map (\m -> Db.delete Membership m.id) rows)
  let r <- Test.open (Show { id: s.rocket })
  Task.succeed (r.answer == PageMissing)
}

test "deleting a project deletes its to-dos, in the org's database" = {
  let ann <- Db.insert User {
    email: Text.Email "ann@example.com",
    name: Text.NonEmpty "Ann",
    passwordHash: "",
  }
  let bob <- Db.insert User {
    email: Text.Email "bob@example.com",
    name: Text.NonEmpty "Bob",
    passwordHash: "",
  }
  let acme <- Db.insert Org { name: Text.NonEmpty "Acme" }
  let globex <- Db.insert Org { name: Text.NonEmpty "Globex" }
  let _ <- Test.member ann acme
  let _ <- Test.member bob globex
  let rocket <- Db.insert Project { name: Text.NonEmpty "Rocket", org: acme }
  let widget <- Db.insert Project { name: Text.NonEmpty "Widget", org: globex }
  let s = {
    ann: ann,
    bob: bob,
    acme: acme,
    globex: globex,
    rocket: rocket,
    widget: widget,
  }
  let _ <- Db.insert Todo {
    title: Text.NonEmpty "Fuel",
    project: s.rocket,
    org: s.acme,
  }
  let _ <- Test.login { user: Just s.ann, org: Just s.acme }
  let _ <- Db.delete Project s.rocket
  let left <- Db.scoped Todo |> Db.count
  Task.succeed (left == 0)
}

test "a visitor is sent to log in" = {
  let ann <- Db.insert User {
    email: Text.Email "ann@example.com",
    name: Text.NonEmpty "Ann",
    passwordHash: "",
  }
  let bob <- Db.insert User {
    email: Text.Email "bob@example.com",
    name: Text.NonEmpty "Bob",
    passwordHash: "",
  }
  let acme <- Db.insert Org { name: Text.NonEmpty "Acme" }
  let globex <- Db.insert Org { name: Text.NonEmpty "Globex" }
  let _ <- Test.member ann acme
  let _ <- Test.member bob globex
  let rocket <- Db.insert Project { name: Text.NonEmpty "Rocket", org: acme }
  let widget <- Db.insert Project { name: Text.NonEmpty "Widget", org: globex }
  let s = {
    ann: ann,
    bob: bob,
    acme: acme,
    globex: globex,
    rocket: rocket,
    widget: widget,
  }
  let r <- Test.open (Show { id: s.rocket })
  Task.succeed (r.answer == Redirected (Auth.Login.Login {}))
}
