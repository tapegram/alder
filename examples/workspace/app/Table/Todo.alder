module Table.Todo

import Table.Org
import Table.Project

type TodoId = brand Text

-- A project's to-do, in the same silo: its `@ref Project` is a reference inside one database,
-- so `@cascade` deletes a project's to-dos with it.
table Todo {
  id: TodoId @id,
  title: Text.NonEmpty,
  done: Bool = False,
  project: Project.ProjectId @ref Project @cascade,
  org: Org.OrgId @ref Org @partition org,
  created: Time @created,
}

-- inProject is the project's to-dos, oldest first, in the session's org.
inProject : Project.ProjectId -> Query (List Todo) requires org
inProject id =
  Db.scoped Todo
    |> Db.where (Todo.project.eq id)
    |> Db.orderBy Todo.created.asc
    |> Db.all
