-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Todos.Edit

-- @admin begin imports
import Admin.Layout
import Table.Org
import Table.Project
import Table.Todo
import Table.User
-- @admin end

-- @admin begin routes
route Edit          = GET  "/admin/orgs/{org}/todo/{id}/edit"                 { org: Org.OrgId, id: Todo.TodoId, findProject: Text = "" } requires user, role Admin, silo org
route Save          = PUT  "/admin/orgs/{org}/todo/{id}/edit/_/Save"          { org: Org.OrgId, id: Todo.TodoId } form TodoForm           requires user, role Admin, silo org
route SearchProject = POST "/admin/orgs/{org}/todo/{id}/edit/_/SearchProject" { org: Org.OrgId, id: Todo.TodoId } form FindProject        requires user, role Admin, silo org
-- @admin end

type Model = {
  row: Todo,
  -- @admin begin model
  projects: List Project,
  projectsTotal: Int,
  -- @admin end
}

Edit.load : Edit.Params -> Session -> Query Model
Edit.load params session = {
  let _ <- Layout.adminOnly session.user
  -- @admin begin load
  let found <- Db.get Todo params.id
  match found {
    Just row -> {
      let findProject = Text.slice 0 200 params.findProject
      let projectsTotal <- Db.from Project |> Db.count
      let projectsOwn <-
        if projectsTotal > 200 then
          Db.from Project
            |> Db.where (Project.id.eq row.project)
            |> Db.all
        else
          Query.succeed []
      let projectsFound <-
        Db.from Project
          |> Db.orderBy Project.name.asc
          |> Db.where (
            if projectsTotal > 200 then
              Db.and [Project.name.contains findProject, Project.id.ne row.project]
            else
              Db.and []
          )
          |> Db.limit (if projectsTotal > 200 then 50 else 200)
          |> Db.all
      let projects = projectsOwn ++ projectsFound
      Query.succeed {
        row: row,
        projects: projects,
        projectsTotal: projectsTotal,
      }
    },
    Nothing -> Query.notFound,
  }
  -- @admin end
}

-- @admin begin form
form TodoForm = {
  title: Text.NonEmpty,
  done: Bool,
  project: Project.ProjectId,
}
-- @admin end

-- @admin begin search
form FindProject = { q: Text }

-- SearchProject answers the page again at the text.
SearchProject.update : SearchProject.Params -> Session -> Task Response
SearchProject.update params session =
  Task.succeed (
    Response.redirect (Edit {
      org: session.org,
      id: params.id,
      findProject: Text.slice 0 200 params.form.q,
    })
  )

-- @admin end

-- Save writes the form over the row (a row deleted since is not found) and goes to its page.
Save.update : Save.Params -> Session -> Task Response
Save.update params session = {
  let _ <- Layout.adminOnly session.user
  let found <- Db.get Todo params.id
  match found {
    Just row -> {
      -- @admin begin update
      let _ <- Db.update Todo row.id (\r -> { r |
        title: params.form.title,
        done: params.form.done,
        project: params.form.project
      })
      Task.succeed (Response.redirect (Admin.Todos.Show.Show { org: session.org, id: row.id }))
      -- @admin end
    },
    Nothing -> Task.notFound,
  }
}

Edit.view : Model -> Session -> Html
Edit.view model session =
  <Layout.Page title="Edit todo">
    <h1>Edit todo</h1>

    <al-card>
      -- @admin begin finder
      {if model.projectsTotal > 200 then
        <form submit={SearchProject { org: session.org, id: model.row.id }}>
          <al-input field="q" label="Find project" />
          <al-button type="submit" variant="secondary">Find</al-button>
        </form>
      else
        Html.none}
      -- @admin end
      <form submit={Save { org: session.org, id: model.row.id }}>
        -- @admin begin inputs
        <al-input field="title" label="Title" value={model.row.title} />
        <al-checkbox field="done" label="Done" value={model.row.done} />
        <al-select
          field="project"
          label="Project"
          options={List.map (\r -> { value: r.id, label: r.name }) model.projects}
          value={model.row.project} />
        -- @admin end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Save</al-button>
      </form>
    </al-card>
    <a href={Admin.Todos.Show.Show { org: session.org, id: model.row.id }}>Back</a>
  </Layout.Page>

-- @admin begin tests
test "saving changes every field" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let todo1 <- Db.insert Todo {
    title: Text.NonEmpty "title-1",
    project: project1,
    org: org,
  }
  let project2 <- Db.insert Project { name: Text.NonEmpty "name-2", org: org }
  let page <- Test.get (Edit { org: org, id: todo1 })
  let r <- Test.submit (Save { org: org, id: todo1 }) {
    title: Text.NonEmpty "title-2",
    done: True,
    project: project2,
  }
  let after <- Db.get Todo todo1
  Task.succeed (
    {
      answer: r.answer,
      row: Maybe.map (\row -> {
        title: row.title,
        done: row.done,
        project: row.project,
      }) after,
      projects: Test.texts "select[name=project] option" page.doc,
    } == {
      answer: Redirected (Admin.Todos.Show.Show { org: org, id: todo1 }),
      row: Just {
        title: Text.NonEmpty "title-2",
        done: True,
        project: project2,
      },
      projects: ["name-1", "name-2"],
    }
  )
}

test "a project not offered is refused" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let todo1 <- Db.insert Todo {
    title: Text.NonEmpty "title-1",
    project: project1,
    org: org,
  }
  let project2 <- Db.insert Project { name: Text.NonEmpty "name-2", org: org }
  let page <- Test.get (Edit { org: org, id: todo1 })
  let r <- Test.submitRaw (Save { org: org, id: todo1 }) [
    { name: "title", value: "x" },
    { name: "done", value: "True" },
    { name: "project", value: "missing" },
  ]
  let after <- Db.get Todo todo1
  Task.succeed (
    { answer: r.answer, project: Maybe.map (\row -> row.project) after }
      == {
        answer: FormRejected [{ field: "project", message: "must be one of the options" }],
        project: Just project1,
      }
  )
}

test "a list of 200 projects is offered whole" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let todo1 <- Db.insert Todo {
    title: Text.NonEmpty "title-1",
    project: project1,
    org: org,
  }
  let project2 <- Db.insert Project { name: Text.NonEmpty "name-2", org: org }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Project {
        name: Text.NonEmpty ("name-" ++ Text.fromInt n),
        org: org,
      }) (List.range 3 200)
    )
  let page <- Test.get (Edit { org: org, id: todo1 })
  Task.succeed (List.length page.model.projects == 200)
}

test "a long list of projects offers 50, and the search narrows it" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let todo1 <- Db.insert Todo {
    title: Text.NonEmpty "title-1",
    project: project1,
    org: org,
  }
  let project2 <- Db.insert Project { name: Text.NonEmpty "name-2", org: org }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Project {
        name: Text.NonEmpty ("name-" ++ Text.fromInt n),
        org: org,
      }) (List.range 3 203)
    )
  let all <- Test.get (Edit { org: org, id: todo1 })
  let found <-
    Test.get (Edit {
      org: org,
      id: todo1,
      findProject: "name-203",
    })
  let r <- Test.submit (SearchProject { org: org, id: todo1 }) { q: "zz" }
  let _ <- Test.login { user: Nothing, org: Nothing }
  let visitor <- Test.submit (SearchProject { org: org, id: todo1 }) { q: "zz" }
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let _ <- Test.get (Edit { org: org, id: todo1 })
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Member,
  }
  let reader <- Test.submitRaw (SearchProject { org: org, id: todo1 }) []
  Task.succeed (
    {
      shown: List.length all.model.projects,
      total: all.model.projectsTotal,
      found: Test.count "select[name=project] option" found.doc <= 3,
      answer: r.answer,
      visitor: visitor.answer,
      reader: reader.answer,
    } == {
      shown: 51,
      total: 203,
      found: True,
      answer: Redirected (Edit {
        org: org,
        id: todo1,
        findProject: "zz",
      }),
      visitor: Redirected (Auth.Login.Login {}),
      reader: PageMissing,
    }
  )
}

test "the row's own project is offered first when it sorts past the 50" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "zz-1", org: org }
  let todo1 <- Db.insert Todo {
    title: Text.NonEmpty "title-1",
    project: project1,
    org: org,
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Project {
        name: Text.NonEmpty ("name-" ++ Text.fromInt n),
        org: org,
      }) (List.range 2 202)
    )
  let page <- Test.get (Edit { org: org, id: todo1 })
  let r <- Test.submit (Save { org: org, id: todo1 }) {
    title: page.model.row.title,
    done: page.model.row.done,
    project: page.model.row.project,
  }
  let after <- Db.get Todo todo1
  Task.succeed (
    {
      answer: r.answer,
      kept: Maybe.map (\row -> row.project) after,
      first: Maybe.map (\o -> o.id) (List.head page.model.projects),
      once: List.length (List.filter (\o -> o.id == project1) page.model.projects),
      shown: List.length page.model.projects,
    } == {
      answer: Redirected (Admin.Todos.Show.Show { org: org, id: todo1 }),
      kept: Just project1,
      first: Just project1,
      once: 1,
      shown: 51,
    }
  )
}

test "a visitor cannot save a todo" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let todo1 <- Db.insert Todo {
    title: Text.NonEmpty "title-1",
    project: project1,
    org: org,
  }
  let project2 <- Db.insert Project { name: Text.NonEmpty "name-2", org: org }
  let before <- Db.get Todo todo1
  let _ <- Test.get (Edit { org: org, id: todo1 })
  let _ <- Test.login { user: Nothing, org: Nothing }
  let r <- Test.submit (Save { org: org, id: todo1 }) {
    title: Text.NonEmpty "title-2",
    done: True,
    project: project2,
  }
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let after <- Db.get Todo todo1
  Task.succeed (
    { answer: r.answer, row: after } == { answer: Redirected (Auth.Login.Login {}), row: before }
  )
}

test "a Member cannot save a todo, even one made Admin since logging in" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let todo1 <- Db.insert Todo {
    title: Text.NonEmpty "title-1",
    project: project1,
    org: org,
  }
  let project2 <- Db.insert Project { name: Text.NonEmpty "name-2", org: org }
  let before <- Db.get Todo todo1
  let _ <- Test.get (Edit { org: org, id: todo1 })
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Member,
  }
  let r <- Test.submit (Save { org: org, id: todo1 }) {
    title: Text.NonEmpty "title-2",
    done: True,
    project: project2,
  }
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let after <- Db.get Todo todo1
  Task.succeed ({ answer: r.answer, row: after } == { answer: PageMissing, row: before })
}

test "a demoted Admin cannot save a todo" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let todo1 <- Db.insert Todo {
    title: Text.NonEmpty "title-1",
    project: project1,
    org: org,
  }
  let project2 <- Db.insert Project { name: Text.NonEmpty "name-2", org: org }
  let before <- Db.get Todo todo1
  let _ <- Test.get (Edit { org: org, id: todo1 })
  let _ <- Db.update User me (\u -> { u | role: Member })
  let r <- Test.submit (Save { org: org, id: todo1 }) {
    title: Text.NonEmpty "title-2",
    done: True,
    project: project2,
  }
  let after <- Db.get Todo todo1
  Task.succeed (
    { answer: r.answer, row: after } == { answer: RequestFailed "400 bad request", row: before }
  )
}

test "a missing row is not found" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let r <- Test.open (Edit { org: org, id: Todo.TodoId "missing" })
  Task.succeed (r.answer == PageMissing)
}

