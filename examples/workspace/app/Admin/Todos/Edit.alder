-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Todos.Edit

-- @admin begin imports
import Admin.Layout
import Table.Org
import Table.Project
import Table.Todo
import Table.User
-- @admin end

page "/admin/orgs/{org}/todo/{id}/edit" {
  org: Org.OrgId,
  id: Todo.TodoId,
  findProject: Text = "",
} requires user, role Admin, silo org

type Model = {
  row: Todo,
  -- @admin begin model
  projects: List Project,
  projectsTotal: Int,
  -- @admin end
}

load : Params -> Session -> Query Model
load params session = {
  let admin <- Layout.isAdmin session.user
  if admin then {
    -- @admin begin load
    let found <- Db.get Todo params.id
    match found {
      Just row -> {
        let findProject = Text.slice 0 200 params.findProject
        let projectsTotal <- Db.from Project |> Db.count
        let projectsOwn <-
          if projectsTotal > 200 then
            Db.from Project
              |> Db.where (Project.id.eq row.project)
              |> Db.all
          else
            Query.succeed []
        let projectsFound <-
          Db.from Project
            |> Db.orderBy Project.name.asc
            |> Db.where (
              if projectsTotal > 200 then
                Db.and [Project.name.contains findProject, Project.id.ne row.project]
              else
                Db.and []
            )
            |> Db.limit (if projectsTotal > 200 then 50 else 200)
            |> Db.all
        let projects = projectsOwn ++ projectsFound
        Query.succeed {
          row: row,
          projects: projects,
          projectsTotal: projectsTotal,
        }
      },
      Nothing -> Query.notFound,
    }
    -- @admin end
  } else
    Query.notFound
}

-- @admin begin form
form TodoForm = {
  title: Text.NonEmpty,
  done: Bool,
  project: Project.ProjectId,
}
-- @admin end

-- @admin begin search
form FindProject = { q: Text }

msg SearchProject form FindProject

-- @admin end

msg Save form TodoForm

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  -- @admin begin finds
  SearchProject p ->
    Task.succeed (
      Redirect (Admin.Todos.Edit {
        org: session.org,
        id: model.row.id,
        findProject: Text.slice 0 200 p.form.q,
      })
    ),
  -- @admin end
  Save p -> {
    -- @admin begin update
    let _ <- Db.update Todo model.row.id (\row -> { row |
      title: p.form.title,
      done: p.form.done,
      project: p.form.project
    })
    Task.succeed (Redirect (Admin.Todos.Show { org: session.org, id: model.row.id }))
    -- @admin end
  },
}

view : Model -> Session -> Html Msg
view model session =
  <Layout.Page title="Edit todo">
    <h1>Edit todo</h1>

    <al-card>
      -- @admin begin finder
      {if model.projectsTotal > 200 then
        <form submit={SearchProject}>
          <al-input field="q" label="Find project" />
          <al-button type="submit" variant="secondary">Find</al-button>
        </form>
      else
        <span></span>}
      -- @admin end
      <form submit={Save}>
        -- @admin begin inputs
        <al-input field="title" label="Title" value={model.row.title} />
        <al-checkbox field="done" label="Done" value={model.row.done} />
        <al-select
          field="project"
          label="Project"
          options={List.map (\r -> { value: r.id, label: r.name }) model.projects}
          value={model.row.project} />
        -- @admin end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Save</al-button>
      </form>
    </al-card>
    <a href={Admin.Todos.Show { org: session.org, id: model.row.id }}>Back</a>
  </Layout.Page>

-- @admin begin tests
test "saving changes every field" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let todo1 <- Db.insert Todo {
    title: Text.NonEmpty "title-1",
    project: project1,
    org: org,
  }
  let project2 <- Db.insert Project { name: Text.NonEmpty "name-2", org: org }
  let page <- Test.get (Admin.Todos.Edit { org: org, id: todo1 })
  let r <- Test.submit TodoForm {
    title: Text.NonEmpty "title-2",
    done: True,
    project: project2,
  }
  let after <- Db.get Todo todo1
  Task.succeed (
    {
      answer: r.answer,
      row: Maybe.map (\row -> {
        title: row.title,
        done: row.done,
        project: row.project,
      }) after,
      projects: Test.texts "select[name=project] option" page.doc,
    } == {
      answer: Redirected (Admin.Todos.Show { org: org, id: todo1 }),
      row: Just {
        title: Text.NonEmpty "title-2",
        done: True,
        project: project2,
      },
      projects: ["name-1", "name-2"],
    }
  )
}

test "a project not offered is refused" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let todo1 <- Db.insert Todo {
    title: Text.NonEmpty "title-1",
    project: project1,
    org: org,
  }
  let project2 <- Db.insert Project { name: Text.NonEmpty "name-2", org: org }
  let page <- Test.get (Admin.Todos.Edit { org: org, id: todo1 })
  let r <- Test.submitRaw TodoForm [
    { name: "title", value: "x" },
    { name: "done", value: "True" },
    { name: "project", value: "missing" },
  ]
  let after <- Db.get Todo todo1
  Task.succeed (
    { answer: r.answer, project: Maybe.map (\row -> row.project) after }
      == {
        answer: FormRejected [{ field: "project", message: "must be one of the options" }],
        project: Just project1,
      }
  )
}

test "a list of 200 projects is offered whole" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let todo1 <- Db.insert Todo {
    title: Text.NonEmpty "title-1",
    project: project1,
    org: org,
  }
  let project2 <- Db.insert Project { name: Text.NonEmpty "name-2", org: org }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Project {
        name: Text.NonEmpty ("name-" ++ Text.fromInt n),
        org: org,
      }) (List.range 3 200)
    )
  let page <- Test.get (Admin.Todos.Edit { org: org, id: todo1 })
  Task.succeed (List.length page.model.projects == 200)
}

test "a long list of projects offers 50, and the search narrows it" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let todo1 <- Db.insert Todo {
    title: Text.NonEmpty "title-1",
    project: project1,
    org: org,
  }
  let project2 <- Db.insert Project { name: Text.NonEmpty "name-2", org: org }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Project {
        name: Text.NonEmpty ("name-" ++ Text.fromInt n),
        org: org,
      }) (List.range 3 203)
    )
  let all <- Test.get (Admin.Todos.Edit { org: org, id: todo1 })
  let found <-
    Test.get (Admin.Todos.Edit {
      org: org,
      id: todo1,
      findProject: "name-203",
    })
  let r <- Test.submit FindProject { q: "zz" }
  Task.succeed (
    {
      shown: List.length all.model.projects,
      total: all.model.projectsTotal,
      found: Test.count "select[name=project] option" found.doc <= 3,
      answer: r.answer,
    } == {
      shown: 51,
      total: 203,
      found: True,
      answer: Redirected (Admin.Todos.Edit {
        org: org,
        id: todo1,
        findProject: "zz",
      }),
    }
  )
}

test "the row's own project is offered first when it sorts past the 50" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "zz-1", org: org }
  let todo1 <- Db.insert Todo {
    title: Text.NonEmpty "title-1",
    project: project1,
    org: org,
  }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Project {
        name: Text.NonEmpty ("name-" ++ Text.fromInt n),
        org: org,
      }) (List.range 2 202)
    )
  let page <- Test.get (Admin.Todos.Edit { org: org, id: todo1 })
  let r <- Test.submit TodoForm {
    title: page.model.row.title,
    done: page.model.row.done,
    project: page.model.row.project,
  }
  let after <- Db.get Todo todo1
  Task.succeed (
    {
      answer: r.answer,
      kept: Maybe.map (\row -> row.project) after,
      first: Maybe.map (\o -> o.id) (List.head page.model.projects),
      once: List.length (List.filter (\o -> o.id == project1) page.model.projects),
      shown: List.length page.model.projects,
    } == {
      answer: Redirected (Admin.Todos.Show { org: org, id: todo1 }),
      kept: Just project1,
      first: Just project1,
      once: 1,
      shown: 51,
    }
  )
}

test "a missing row is not found" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let r <- Test.open (Admin.Todos.Edit { org: org, id: Todo.TodoId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "a visitor is sent to log in" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let todo1 <- Db.insert Todo {
    title: Text.NonEmpty "title-1",
    project: project1,
    org: org,
  }
  let r <- Test.open (Admin.Todos.Edit { org: org, id: todo1 })
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Member gets no page, even one made Admin since logging in" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Member,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let todo1 <- Db.insert Todo {
    title: Text.NonEmpty "title-1",
    project: project1,
    org: org,
  }
  let r <- Test.open (Admin.Todos.Edit { org: org, id: todo1 })
  Task.succeed (r.answer == PageMissing)
}

