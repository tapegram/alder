-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Todos.New

-- @admin begin imports
import Admin.Layout
import Table.Org
import Table.Project
import Table.Todo
import Table.User
-- @admin end

-- @admin begin routes
route New           = GET  "/admin/orgs/{org}/todo/new"                 { org: Org.OrgId, findProject: Text = "" } requires user, role Admin, silo org
route Create        = POST "/admin/orgs/{org}/todo/new/_/Create"        { org: Org.OrgId } form TodoForm           requires user, role Admin, silo org
route SearchProject = POST "/admin/orgs/{org}/todo/new/_/SearchProject" { org: Org.OrgId } form FindProject        requires user, role Admin, silo org
-- @admin end

type Model = {
  -- @admin begin model
  projects: List Project,
  projectsTotal: Int,
  -- @admin end
}

New.load : New.Params -> Session -> Query Model
New.load params session = {
  let _ <- Layout.adminOnly session.user
  -- @admin begin load
  let findProject = Text.slice 0 200 params.findProject
  let projectsTotal <- Db.from Project |> Db.count
  let projects <-
    Db.from Project
      |> Db.orderBy Project.name.asc
      |> Db.where (if projectsTotal > 200 then Project.name.contains findProject else Db.and [])
      |> Db.limit (if projectsTotal > 200 then 50 else 200)
      |> Db.all
  Query.succeed { projects: projects, projectsTotal: projectsTotal }
  -- @admin end
}

-- @admin begin form
form TodoForm = {
  title: Text.NonEmpty,
  done: Bool,
  project: Project.ProjectId,
}
-- @admin end

-- @admin begin search
form FindProject = { q: Text }

-- SearchProject answers the page again at the text.
SearchProject.update : SearchProject.Params -> Session -> Task Response
SearchProject.update params session =
  Task.succeed (
    Response.redirect (New { org: session.org, findProject: Text.slice 0 200 params.form.q })
  )

-- @admin end

-- Create adds the row and goes to its page.
Create.update : Create.Params -> Session -> Task Response
Create.update params session = {
  let _ <- Layout.adminOnly session.user
  -- @admin begin insert
  let id <- Db.insert Todo {
    title: params.form.title,
    done: params.form.done,
    project: params.form.project,
    org: session.org,
  }
  Task.succeed (Response.redirect (Admin.Todos.Show.Show { org: session.org, id: id }))
  -- @admin end
}

New.view : Model -> Session -> Html
New.view model session =
  <Layout.Page title="New todo">
    <h1>New todo</h1>

    <al-card>
      -- @admin begin finder
      {if model.projectsTotal > 200 then
        <form submit={SearchProject { org: session.org }}>
          <al-input field="q" label="Find project" />
          <al-button type="submit" variant="secondary">Find</al-button>
        </form>
      else
        Html.none}
      -- @admin end
      <form submit={Create { org: session.org }}>
        -- @admin begin inputs
        <al-input field="title" label="Title" />
        <al-checkbox field="done" label="Done" value={False} />
        <al-select
          field="project"
          label="Project"
          options={List.map (\r -> { value: r.id, label: r.name }) model.projects} />
        -- @admin end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Create</al-button>
      </form>
    </al-card>
  </Layout.Page>

-- @admin begin tests
test "creating a todo adds it, with the values submitted" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let project2 <- Db.insert Project { name: Text.NonEmpty "name-2", org: org }
  let page <- Test.get (New { org: org })
  let r <- Test.submit (Create { org: org }) {
    title: Text.NonEmpty "title-1",
    done: True,
    project: project2,
  }
  let rows <- Db.from Todo |> Db.all
  Task.succeed (
    {
      answers: List.map (\row -> Redirected (Admin.Todos.Show.Show { org: org, id: row.id })) rows,
      rows: List.map (\row -> {
        title: row.title,
        done: row.done,
        project: row.project,
      }) rows,
      projects: Test.texts "select[name=project] option" page.doc,
    } == {
      answers: [r.answer],
      rows: [
        {
          title: Text.NonEmpty "title-1",
          done: True,
          project: project2,
        },
      ],
      projects: ["name-1", "name-2"],
    }
  )
}

test "a project not offered is refused" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let project2 <- Db.insert Project { name: Text.NonEmpty "name-2", org: org }
  let page <- Test.get (New { org: org })
  let r <- Test.submitRaw (Create { org: org }) [
    { name: "title", value: "x" },
    { name: "done", value: "True" },
    { name: "project", value: "missing" },
  ]
  let rows <- Db.from Todo |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows }
      == {
        answer: FormRejected [{ field: "project", message: "must be one of the options" }],
        rows: 0,
      }
  )
}

test "a list of 200 projects is offered whole" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let project2 <- Db.insert Project { name: Text.NonEmpty "name-2", org: org }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Project {
        name: Text.NonEmpty ("name-" ++ Text.fromInt n),
        org: org,
      }) (List.range 3 200)
    )
  let page <- Test.get (New { org: org })
  Task.succeed (List.length page.model.projects == 200)
}

test "a long list of projects offers 50, and the search narrows it" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let project2 <- Db.insert Project { name: Text.NonEmpty "name-2", org: org }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Project {
        name: Text.NonEmpty ("name-" ++ Text.fromInt n),
        org: org,
      }) (List.range 3 203)
    )
  let all <- Test.get (New { org: org })
  let found <- Test.get (New { org: org, findProject: "name-203" })
  let r <- Test.submit (SearchProject { org: org }) { q: "zz" }
  Task.succeed (
    {
      shown: List.length all.model.projects,
      total: all.model.projectsTotal,
      found: Test.texts "select[name=project] option" found.doc == ["name-203"],
      answer: r.answer,
    } == {
      shown: 50,
      total: 203,
      found: True,
      answer: Redirected (New { org: org, findProject: "zz" }),
    }
  )
}

test "a project outside the narrowed list is refused" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let project2 <- Db.insert Project { name: Text.NonEmpty "name-2", org: org }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Project {
        name: Text.NonEmpty ("name-" ++ Text.fromInt n),
        org: org,
      }) (List.range 3 203)
    )
  let all <- Test.get (New { org: org })
  let found <- Test.get (New { org: org, findProject: "name-203" })
  let r <- Test.submit (SearchProject { org: org }) { q: "zz" }
  let pick = Maybe.withDefault "" (Test.attr "value" "select[name=project] option" found.doc)
  let page <- Test.get (New { org: org })
  let sent <- Test.submitRaw (Create { org: org }) [
    { name: "title", value: "x" },
    { name: "done", value: "True" },
    { name: "project", value: pick },
  ]
  let rows <- Db.from Todo |> Db.count
  Task.succeed (
    { answer: sent.answer, rows: rows }
      == {
        answer: FormRejected [{ field: "project", message: "must be one of the options" }],
        rows: 0,
      }
  )
}

test "a visitor is sent to log in" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let r <- Test.open (New { org: org })
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Member gets no page, even one made Admin since logging in" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Member,
  }
  let r <- Test.open (New { org: org })
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Member,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let r <- Test.open (New { org: org })
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
