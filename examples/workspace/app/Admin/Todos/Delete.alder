-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Todos.Delete

-- @admin begin imports
import Admin.Layout
import Table.Org
import Table.Project
import Table.Todo
import Table.User
-- @admin end

-- @admin begin routes
route Delete  = GET    "/admin/orgs/{org}/todo/{id}/delete"           { org: Org.OrgId, id: Todo.TodoId }              requires user, role Admin, silo org
route Destroy = DELETE "/admin/orgs/{org}/todo/{id}/delete/_/Destroy" { org: Org.OrgId, id: Todo.TodoId } form Confirm requires user, role Admin, silo org
-- @admin end

-- The row, and how many rows of each table refer to it.
type Model = {
  row: Todo,
  -- @admin begin model
  -- @admin end
}

-- counted is the row id names (none is not found) and how many rows of each table refer to it:
-- the page shows them, and Destroy counts them again before it deletes.
counted : Todo.TodoId -> Query Model
counted id = {
  -- @admin begin load
  let found <- Db.get Todo id
  match found {
    Just row -> Query.succeed { row: row },
    Nothing -> Query.notFound,
  }
  -- @admin end
}

Delete.load : Delete.Params -> Session -> Query Model
Delete.load params session = {
  let _ <- Layout.adminOnly session.user
  counted params.id
}

-- @admin begin blockers
-- blockers counts the rows that keep this one from being deleted, which the database would
-- refuse the delete for: the `@restrict` references to it, or to a row deleted with it.
blockers : Model -> Int
blockers model = 0
-- @admin end

-- Destroy takes no input: the form is the button, and the place a refusal is shown.
form Confirm = { }

-- Destroy deletes the row, unless rows refer to it that keep it (counted again, as the page
-- counted them): the database would refuse the delete with an error, and the page says why
-- instead. The Show page's dialog posts it too.
Destroy.update : Destroy.Params -> Session -> Task Response
Destroy.update params session = {
  let _ <- Layout.adminOnly session.user
  let model <- counted params.id
  -- @admin begin remove
  let _ <- Db.delete Todo params.id
  Task.succeed (
    Response.redirect (Admin.Todos.Index.Index { org: session.org }) |> Response.success "Deleted"
  )
  -- @admin end
}

Delete.view : Model -> Session -> Html
Delete.view model session =
  <Layout.Page title="Delete todo">
    <h1>Delete this todo?</h1>

    <al-card>
      -- @admin begin row
      <p>{model.row.title}</p>
      -- @admin end
      <dl>
        -- @admin begin counts
        -- @admin end
      </dl>
      <form id="delete" submit={Destroy { org: session.org, id: model.row.id }}>
        <al-alert variant="destructive"><Errors form /></al-alert>
        {if blockers model > 0 then
          <p>It cannot be deleted while other rows refer to it.</p>
        else
          <al-button variant="destructive" type="submit">Delete</al-button>}
      </form>
    </al-card>
    <a href={Admin.Todos.Show.Show { org: session.org, id: model.row.id }}>Back</a>
  </Layout.Page>

-- @admin begin tests
test "deleting a todo nothing refers to" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let todo1 <- Db.insert Todo {
    title: Text.NonEmpty "title-1",
    project: project1,
    org: org,
  }
  let page <- Test.get (Delete { org: org, id: todo1 })
  let r <- Test.submit (Destroy { org: org, id: todo1 }) {}
  let gone <- Db.get Todo todo1
  Task.succeed (
    {
      button: Test.count "#delete al-button" page.doc,
      answer: r.answer,
      gone: Maybe.map (\row -> row.id) gone,
    } == {
      button: 1,
      answer: Redirected (Admin.Todos.Index.Index { org: org }),
      gone: Nothing,
    }
  )
}

test "a missing row is not found" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let r <- Test.open (Delete { org: org, id: Todo.TodoId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "a visitor is sent to log in" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let todo1 <- Db.insert Todo {
    title: Text.NonEmpty "title-1",
    project: project1,
    org: org,
  }
  let r <- Test.open (Delete { org: org, id: todo1 })
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Member gets no page, even one made Admin since logging in" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Member,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let todo1 <- Db.insert Todo {
    title: Text.NonEmpty "title-1",
    project: project1,
    org: org,
  }
  let r <- Test.open (Delete { org: org, id: todo1 })
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Member,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let todo1 <- Db.insert Todo {
    title: Text.NonEmpty "title-1",
    project: project1,
    org: org,
  }
  let r <- Test.open (Delete { org: org, id: todo1 })
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
