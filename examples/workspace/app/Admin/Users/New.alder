-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Users.New

-- @admin begin imports
import Admin.Layout
import Table.User
-- @admin end

page "/admin/user/new" { } requires user, role Admin

type Model = {
  -- @admin begin model
  -- @admin end
}

load : Params -> Session -> Query Model
load params session = {
  let admin <- Layout.isAdmin session.user
  if admin then {
    -- @admin begin load
    Query.succeed {}
    -- @admin end
  } else
    Query.notFound
}

-- @admin begin form
form UserForm = {
  email: Text.Email,
  name: Text.NonEmpty,
  role: User.Role,
}
-- @admin end

-- @admin begin search
-- @admin end

msg Create form UserForm

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  -- @admin begin finds
  -- @admin end
  Create p -> {
    -- @admin begin insert
    -- the admin never shows or writes a secret (passwordHash): a row starts without one
    let emailTaken <-
      Db.from User
        |> Db.where (User.email.eq p.form.email)
        |> Db.count
    if emailTaken > 0 then
      Task.succeed (Reject "A user with this email exists.")
    else {
      let id <- Db.insert User {
        email: p.form.email,
        name: p.form.name,
        role: p.form.role,
        passwordHash: "",
      }
      Task.succeed (Redirect (Admin.Users.Show { id: id }))
    }
    -- @admin end
  },
}

view : Model -> Session -> Html Msg
view model session =
  <Layout.Page title="New user">
    <h1>New user</h1>

    <al-card>
      -- @admin begin finder
      -- @admin end
      <form submit={Create}>
        -- @admin begin inputs
        <al-input field="email" label="Email" />
        <al-input field="name" label="Name" />
        <al-select field="role" label="Role" value={Member} />
        -- @admin end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Create</al-button>
      </form>
    </al-card>
  </Layout.Page>

-- @admin begin tests
test "creating a user adds it, with the values submitted" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let page <- Test.get (Admin.Users.New {})
  let r <- Test.submit UserForm {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    role: Admin,
  }
  let rows <-
    Db.from User
      |> Db.where (User.email.eq (Text.Email "email-2@example.com"))
      |> Db.all
  Task.succeed (
    {
      answers: List.map (\row -> Redirected (Admin.Users.Show { id: row.id })) rows,
      rows: List.map (\row -> {
        email: row.email,
        name: row.name,
        role: row.role,
        passwordHash: row.passwordHash,
      }) rows,
    } == {
        answers: [r.answer],
        rows: [
          {
            email: Text.Email "email-2@example.com",
            name: Text.NonEmpty "name-2",
            role: Admin,
            passwordHash: "",
          },
        ],
      }
  )
}

test "a user with an email that exists is refused" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let _ <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let _ <- Test.get (Admin.Users.New {})
  let r <- Test.submit UserForm {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-3",
    role: Admin,
  }
  let rows <- Db.from User |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows }
      == {
        answer: FormRejected [{ field: "", message: "A user with this email exists." }],
        rows: 2,
      }
  )
}

test "a visitor is sent to log in" = {
  let r <- Test.open (Admin.Users.New {})
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Member gets no page, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Member,
  }
  let r <- Test.open (Admin.Users.New {})
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Member,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let r <- Test.open (Admin.Users.New {})
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
