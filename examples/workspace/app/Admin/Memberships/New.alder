test "a visitor cannot create a membership" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let org2 <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let _ <- Test.get (New {})
  let _ <- Test.login { user: Nothing, org: Nothing }
  let r <- Test.submit Create { user: user2, org: org2 }
  let rows <- Db.from Membership |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows } == { answer: Redirected (Auth.Login.Login {}), rows: 0 }
  )
}

test "a Member cannot create a membership, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let org2 <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let _ <- Test.get (New {})
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Member,
  }
  let r <- Test.submit Create { user: user2, org: org2 }
  let rows <- Db.from Membership |> Db.count
  Task.succeed ({ answer: r.answer, rows: rows } == { answer: PageMissing, rows: 0 })
}

test "a demoted Admin cannot create a membership" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let org2 <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let _ <- Test.get (New {})
  let _ <- Db.update User me (\u -> { u | role: Member })
  let r <- Test.submit Create { user: user2, org: org2 }
  let rows <- Db.from Membership |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows } == { answer: RequestFailed "400 bad request", rows: 0 }
  )
}

test "a visitor is sent to log in" = {
  let r <- Test.open (New {})
  Task.succeed (r.answer == Redirected (Auth.Login.Login {}))
}

test "a Member gets no page, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Member,
  }
  let r <- Test.open (New {})
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Member,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let r <- Test.open (New {})
  Task.succeed (r.answer == PageMissing)
}
