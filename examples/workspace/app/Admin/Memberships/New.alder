-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Memberships.New

-- @admin begin imports
import Admin.Layout
import Table.Membership
import Table.Org
import Table.User
-- @admin end

-- @admin begin routes
route New    = GET  "/admin/membership/new" { findUser: Text = "", findOrg: Text = "" } requires user, role Admin
route Create = POST "/admin/membership"     { } form MembershipForm                     requires user, role Admin
-- @admin end

type Model = {
  -- @admin begin model
  users: List User,
  usersTotal: Int,
  findUser: Text,
  orgs: List Org,
  orgsTotal: Int,
  findOrg: Text,
  -- @admin end
}

New.load : New.Params -> Session -> Query Model
New.load params session = {
  let _ <- Layout.adminOnly session.user
  -- @admin begin load
  let findUser = Text.slice 0 200 params.findUser
  let usersTotal <- Db.from User |> Db.count
  let users <-
    Db.from User
      |> Db.orderBy User.email.asc
      |> Db.where (if usersTotal > 200 then User.email.contains findUser else Db.and [])
      |> Db.limit (if usersTotal > 200 then 50 else 200)
      |> Db.all
  let findOrg = Text.slice 0 200 params.findOrg
  let orgsTotal <- Db.from Org |> Db.count
  let orgs <-
    Db.from Org
      |> Db.orderBy Org.name.asc
      |> Db.where (if orgsTotal > 200 then Org.name.contains findOrg else Db.and [])
      |> Db.limit (if orgsTotal > 200 then 50 else 200)
      |> Db.all
  Query.succeed {
    users: users,
    usersTotal: usersTotal,
    findUser: findUser,
    orgs: orgs,
    orgsTotal: orgsTotal,
    findOrg: findOrg,
  }
  -- @admin end
}

-- @admin begin form
form MembershipForm = { user: User.UserId, org: Org.OrgId }
-- @admin end

-- @admin begin search
-- @admin end

-- Create adds the row and goes to its page.
Create.update : Create.Params -> Session -> Task Response
Create.update params session = {
  let _ <- Layout.adminOnly session.user
  -- @admin begin insert
  let id <- Db.insert Membership { user: params.form.user, org: params.form.org }
  Task.succeed (Response.redirect (Admin.Memberships.Show.Show { id: id }))
  -- @admin end
}

New.view : Model -> Session -> Html
New.view model session =
  <Layout.Page title="New membership">
    <h1>New membership</h1>

    <al-card>
      -- @admin begin finder
      {if model.usersTotal > 200 then
        <form method="get">
          <al-input>
            <label>Find user <input type="search" name="findUser" value={model.findUser} /></label>
          </al-input>
          <al-button type="submit" variant="secondary">Find</al-button>
        </form>
      else
        Html.none}
      {if model.orgsTotal > 200 then
        <form method="get">
          <al-input>
            <label>Find org <input type="search" name="findOrg" value={model.findOrg} /></label>
          </al-input>
          <al-button type="submit" variant="secondary">Find</al-button>
        </form>
      else
        Html.none}
      -- @admin end
      <form submit={Create}>
        -- @admin begin inputs
        <al-select
          field="user"
          label="User"
          options={List.map (\r -> { value: r.id, label: r.email }) model.users} />
        <al-select
          field="org"
          label="Org"
          options={List.map (\r -> { value: r.id, label: r.name }) model.orgs} />
        -- @admin end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Create</al-button>
      </form>
    </al-card>
  </Layout.Page>

-- @admin begin tests
test "creating a membership adds it, with the values submitted" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let org2 <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let page <- Test.get (New {})
  let r <- Test.submit Create { user: user2, org: org2 }
  let rows <- Db.from Membership |> Db.all
  Task.succeed (
    {
      answers: List.map (\row -> Redirected (Admin.Memberships.Show.Show { id: row.id })) rows,
      rows: List.map (\row -> { user: row.user, org: row.org }) rows,
      users: Test.texts "select[name=user] option" page.doc,
      orgs: Test.texts "select[name=org] option" page.doc,
    } == {
      answers: [r.answer],
      rows: [{ user: user2, org: org2 }],
      users: ["email-1@example.com", "email-2@example.com"],
      orgs: ["name-1", "name-2"],
    }
  )
}

test "a user not offered is refused" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let org2 <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let page <- Test.get (New {})
  let orgId = Maybe.withDefault "" (Test.attr "value" "select[name=org] option" page.doc)
  let r <- Test.submitRaw Create [{ name: "user", value: "missing" }, { name: "org", value: orgId }]
  let rows <- Db.from Membership |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows }
      == {
        answer: FormRejected [{ field: "user", message: "must be one of the options" }],
        rows: 0,
      }
  )
}

