-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Activities.Bulk

-- @admin begin imports
import Admin.Layout
import Table.Activity
import Table.Org
import Table.User
-- @admin end

-- @admin begin routes
route Bulk       = GET  "/admin/activity/bulk"              { ids: List Activity.ActivityId }              requires user, role Admin
route BulkDelete = POST "/admin/activity/bulk/_/BulkDelete" { ids: List Activity.ActivityId } form Confirm requires user, role Admin
-- @admin end

-- The rows chosen on the list (at most maxRows of them), the ids of those that other rows keep
-- from being deleted, how many ids the page was given, and the ids, which each action takes.
type Model = {
  rows: List Activity,
  held: List Activity.ActivityId,
  chosen: Int,
  ids: List Activity.ActivityId,
}

-- maxRows is how many rows one action takes: a page of the list. More are refused.
maxRows : Int
maxRows = 25

-- tooMany says whether the page was given more ids than an action takes.
tooMany : Model -> Bool
tooMany model = model.chosen > maxRows

-- selected is the rows of ids: the page shows them, and each action reads them again.
selected : List Activity.ActivityId -> Query Model
selected ids = {
  -- @admin begin load
  let taken = List.take maxRows ids
  let rows <-
    Db.from Activity
      |> Db.where (Activity.id.in taken)
      |> Db.all
  Query.succeed {
    rows: rows,
    held: [],
    chosen: List.length ids,
    ids: ids,
  }
  -- @admin end
}

Bulk.load : Bulk.Params -> Session -> Query Model
Bulk.load params session = {
  let _ <- Layout.adminOnly session.user
  selected params.ids
}

-- refused says whether a row is kept from being deleted: rows refer to it with a `@restrict`.
refused : Model -> Activity -> Bool
refused model row = List.member row.id model.held

-- @admin begin bulk
-- Each action reads the rows again and answers with the page again and a toast; none takes
-- more than maxRows rows.

-- BulkDelete takes no input: the form is the button, and the place a refusal is shown.
form Confirm = { }

BulkDelete.update : BulkDelete.Params -> Session -> Task Response
BulkDelete.update params session = {
  let _ <- Layout.adminOnly session.user
  let model <- selected params.ids
  if tooMany model then
    Task.succeed (
      Response.invalid ("Choose at most " ++ Text.fromInt maxRows ++ " rows at a time.")
    )
  else {
    let allowed = List.filter (\row -> refused model row == False) model.rows
    let _ <- Task.all (List.map (\row -> Db.delete Activity row.id) allowed)
    Task.succeed (
      Response.refresh
        |> Response.success (
          "Deleted "
            ++ Text.fromInt (List.length allowed)
            ++ " of "
            ++ Text.fromInt (List.length model.rows)
        )
    )
  }
}
-- @admin end

Bulk.view : Model -> Session -> Html
Bulk.view model session =
  <Layout.Page title="Selected activities">
    <h1>{Text.fromInt (List.length model.rows)} selected</h1>

    <al-card>
      {if tooMany model then
        <al-alert id="too-many" variant="warning">
          {"Choose at most " ++ Text.fromInt maxRows ++ " rows at a time."}
        </al-alert>
      else
        Html.none}
      <ul id="selected">
        {for row in model.rows ->
          <li>
            {row.text}
            {if refused model row then
              <small> (kept: other rows refer to it)</small>
            else
              <span></span>}
          </li>}
      </ul>
      -- @admin begin actions
      <form id="bulk-delete" submit={BulkDelete { ids: model.ids }}>
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button variant="destructive" type="submit">
          Delete the rows that can be deleted
        </al-button>
      </form>
      -- @admin end
    </al-card>
    <a href={Admin.Activities.Index.Index {}}>Back to the list</a>
  </Layout.Page>

-- @admin begin tests
test "deleting the chosen rows" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let activity1 <- Db.insert Activity { text: "text-1", org: org1 }
  let activity2 <- Db.insert Activity { text: "text-2", org: org1 }
  let _ <- Test.get (Bulk { ids: [activity1] })
  let r <- Test.submit (BulkDelete { ids: [activity1] }) {}
  let gone <- Db.get Activity activity1
  let left <- Db.get Activity activity2
  Task.succeed (
    {
      answer: r.answer,
      gone: Maybe.map (\row -> row.id) gone,
      left: Maybe.map (\row -> row.id) left,
    } == {
      answer: Refreshed,
      gone: Nothing,
      left: Just activity2,
    }
  )
}

test "25 chosen ids are taken" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let activity1 <- Db.insert Activity { text: "text-1", org: org1 }
  let chosen =
    [activity1]
      ++ List.map (\n -> Activity.ActivityId ("none-" ++ Text.fromInt n)) (List.range 1 24)
  let page <- Test.get (Bulk { ids: chosen })
  let r <- Test.submit (BulkDelete { ids: chosen }) {}
  let after <- Db.get Activity activity1
  Task.succeed (
    {
      answer: r.answer,
      kept: Maybe.map (\row -> row.id) after,
      warned: Test.count "#too-many" page.doc,
    } == {
      answer: Refreshed,
      kept: Nothing,
      warned: 0,
    }
  )
}

test "26 chosen ids are refused" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let activity1 <- Db.insert Activity { text: "text-1", org: org1 }
  let chosen =
    [activity1]
      ++ List.map (\n -> Activity.ActivityId ("none-" ++ Text.fromInt n)) (List.range 1 25)
  let page <- Test.get (Bulk { ids: chosen })
  let r <- Test.submit (BulkDelete { ids: chosen }) {}
  let after <- Db.get Activity activity1
  Task.succeed (
    {
      answer: r.answer,
      kept: Maybe.map (\row -> row.id) after,
      warned: Test.count "#too-many" page.doc,
    } == {
      answer: FormRejected [{ field: "", message: "Choose at most 25 rows at a time." }],
      kept: Just activity1,
      warned: 1,
    }
  )
}

test "a demoted Admin cannot delete the chosen rows" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let activity1 <- Db.insert Activity { text: "text-1", org: org1 }
  let _ <- Test.get (Bulk { ids: [activity1] })
  let _ <- Db.update User me (\u -> { u | role: Member })
  let r <- Test.submit (BulkDelete { ids: [activity1] }) {}
  let kept <- Db.get Activity activity1
  Task.succeed (
    { answer: r.answer, kept: Maybe.map (\row -> row.id) kept }
      == { answer: PageMissing, kept: Just activity1 }
  )
}

test "a visitor is sent to log in" = {
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let activity1 <- Db.insert Activity { text: "text-1", org: org1 }
  let r <- Test.open (Bulk { ids: [activity1] })
  Task.succeed (r.answer == Redirected (Auth.Login.Login {}))
}

test "a Member gets no page, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Member,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let activity1 <- Db.insert Activity { text: "text-1", org: org1 }
  let r <- Test.open (Bulk { ids: [activity1] })
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Member,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let activity1 <- Db.insert Activity { text: "text-1", org: org1 }
  let r <- Test.open (Bulk { ids: [activity1] })
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
