-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Activities.New

-- @admin begin imports
import Admin.Layout
import Table.Activity
import Table.Org
import Table.User
-- @admin end

-- @admin begin routes
route New       = GET  "/admin/activity/new"             { findOrg: Text = "" } requires user, role Admin
route Create    = POST "/admin/activity/new/_/Create"    { } form ActivityForm  requires user, role Admin
route SearchOrg = POST "/admin/activity/new/_/SearchOrg" { } form FindOrg       requires user, role Admin
-- @admin end

type Model = {
  -- @admin begin model
  orgs: List Org,
  orgsTotal: Int,
  -- @admin end
}

New.load : New.Params -> Session -> Query Model
New.load params session = {
  let _ <- Layout.adminOnly session.user
  -- @admin begin load
  let findOrg = Text.slice 0 200 params.findOrg
  let orgsTotal <- Db.from Org |> Db.count
  let orgs <-
    Db.from Org
      |> Db.orderBy Org.name.asc
      |> Db.where (if orgsTotal > 200 then Org.name.contains findOrg else Db.and [])
      |> Db.limit (if orgsTotal > 200 then 50 else 200)
      |> Db.all
  Query.succeed { orgs: orgs, orgsTotal: orgsTotal }
  -- @admin end
}

-- @admin begin form
form ActivityForm = { text: Text, org: Org.OrgId }
-- @admin end

-- @admin begin search
form FindOrg = { q: Text }

-- SearchOrg answers the page again at the text.
SearchOrg.update : SearchOrg.Params -> Session -> Task Response
SearchOrg.update params session =
  Task.succeed (Response.redirect (New { findOrg: Text.slice 0 200 params.form.q }))

-- @admin end

-- Create adds the row and goes to its page.
Create.update : Create.Params -> Session -> Task Response
Create.update params session = {
  let _ <- Layout.adminOnly session.user
  -- @admin begin insert
  let id <- Db.insert Activity { text: params.form.text, org: params.form.org }
  Task.succeed (Response.redirect (Admin.Activities.Show.Show { id: id }))
  -- @admin end
}

New.view : Model -> Session -> Html
New.view model session =
  <Layout.Page title="New activity">
    <h1>New activity</h1>

    <al-card>
      -- @admin begin finder
      {if model.orgsTotal > 200 then
        <form submit={SearchOrg}>
          <al-input field="q" label="Find org" />
          <al-button type="submit" variant="secondary">Find</al-button>
        </form>
      else
        Html.none}
      -- @admin end
      <form submit={Create}>
        -- @admin begin inputs
        <al-input field="text" label="Text" />
        <al-select
          field="org"
          label="Org"
          options={List.map (\r -> { value: r.id, label: r.name }) model.orgs} />
        -- @admin end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Create</al-button>
      </form>
    </al-card>
  </Layout.Page>

-- @admin begin tests
test "creating an activity adds it, with the values submitted" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let org2 <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let page <- Test.get (New {})
  let r <- Test.submit Create { text: "text-1", org: org2 }
  let rows <- Db.from Activity |> Db.all
  Task.succeed (
    {
      answers: List.map (\row -> Redirected (Admin.Activities.Show.Show { id: row.id })) rows,
      rows: List.map (\row -> { text: row.text, org: row.org }) rows,
      orgs: Test.texts "select[name=org] option" page.doc,
    } == {
      answers: [r.answer],
      rows: [{ text: "text-1", org: org2 }],
      orgs: ["name-1", "name-2"],
    }
  )
}

test "an org not offered is refused" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let org2 <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let page <- Test.get (New {})
  let r <- Test.submitRaw Create [{ name: "text", value: "x" }, { name: "org", value: "missing" }]
  let rows <- Db.from Activity |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows }
      == { answer: FormRejected [{ field: "org", message: "must be one of the options" }], rows: 0 }
  )
}

test "a list of 200 orgs is offered whole" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let org2 <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Org { name: Text.NonEmpty ("name-" ++ Text.fromInt n) }) (
        List.range 3 200
      )
    )
  let page <- Test.get (New {})
  Task.succeed (List.length page.model.orgs == 200)
}

test "a long list of orgs offers 50, and the search narrows it" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let org2 <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Org { name: Text.NonEmpty ("name-" ++ Text.fromInt n) }) (
        List.range 3 203
      )
    )
  let all <- Test.get (New {})
  let found <- Test.get (New { findOrg: "name-203" })
  let r <- Test.submit SearchOrg { q: "zz" }
  Task.succeed (
    {
      shown: List.length all.model.orgs,
      total: all.model.orgsTotal,
      found: Test.texts "select[name=org] option" found.doc == ["name-203"],
      answer: r.answer,
    } == {
      shown: 50,
      total: 203,
      found: True,
      answer: Redirected (New { findOrg: "zz" }),
    }
  )
}

test "an org outside the narrowed list is refused" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let org2 <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Org { name: Text.NonEmpty ("name-" ++ Text.fromInt n) }) (
        List.range 3 203
      )
    )
  let all <- Test.get (New {})
  let found <- Test.get (New { findOrg: "name-203" })
  let r <- Test.submit SearchOrg { q: "zz" }
  let pick = Maybe.withDefault "" (Test.attr "value" "select[name=org] option" found.doc)
  let page <- Test.get (New {})
  let sent <- Test.submitRaw Create [{ name: "text", value: "x" }, { name: "org", value: pick }]
  let rows <- Db.from Activity |> Db.count
  Task.succeed (
    { answer: sent.answer, rows: rows }
      == { answer: FormRejected [{ field: "org", message: "must be one of the options" }], rows: 0 }
  )
}

test "a visitor cannot create an activity" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let org2 <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let _ <- Test.get (New {})
  let _ <- Test.login { user: Nothing, org: Nothing }
  let r <- Test.submit Create { text: "text-1", org: org2 }
  let rows <- Db.from Activity |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows } == { answer: Redirected (Auth.Login.Login {}), rows: 0 }
  )
}

test "a Member cannot create an activity, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let org2 <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let _ <- Test.get (New {})
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Member,
  }
  let r <- Test.submit Create { text: "text-1", org: org2 }
  let rows <- Db.from Activity |> Db.count
  Task.succeed ({ answer: r.answer, rows: rows } == { answer: PageMissing, rows: 0 })
}

test "a demoted Admin cannot create an activity" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let org2 <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let _ <- Test.get (New {})
  let _ <- Db.update User me (\u -> { u | role: Member })
  let r <- Test.submit Create { text: "text-1", org: org2 }
  let rows <- Db.from Activity |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows } == { answer: RequestFailed "400 bad request", rows: 0 }
  )
}

test "a visitor is sent to log in" = {
  let r <- Test.open (New {})
  Task.succeed (r.answer == Redirected (Auth.Login.Login {}))
}

test "a Member gets no page, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Member,
  }
  let r <- Test.open (New {})
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Member,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let r <- Test.open (New {})
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
