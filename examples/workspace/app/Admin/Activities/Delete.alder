-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Activities.Delete

-- @admin begin imports
import Admin.Layout
import Table.Activity
import Table.Org
import Table.User
-- @admin end

-- @admin begin routes
route Delete  = GET    "/admin/activity/{id}/delete"           { id: Activity.ActivityId }              requires user, role Admin
route Destroy = DELETE "/admin/activity/{id}/delete/_/Destroy" { id: Activity.ActivityId } form Confirm requires user, role Admin
-- @admin end

-- The row, and how many rows of each table refer to it.
type Model = {
  row: Activity,
  -- @admin begin model
  -- @admin end
}

-- counted is the row id names (none is not found) and how many rows of each table refer to it:
-- the page shows them, and Destroy counts them again before it deletes.
counted : Activity.ActivityId -> Query Model
counted id = {
  -- @admin begin load
  let found <- Db.get Activity id
  match found {
    Just row -> Query.succeed { row: row },
    Nothing -> Query.notFound,
  }
  -- @admin end
}

Delete.load : Delete.Params -> Session -> Query Model
Delete.load params session = {
  let _ <- Layout.adminOnly session.user
  counted params.id
}

-- @admin begin blockers
-- blockers counts the rows that keep this one from being deleted, which the database would
-- refuse the delete for: the `@restrict` references to it, or to a row deleted with it.
blockers : Model -> Int
blockers model = 0
-- @admin end

-- Destroy takes no input: the form is the button, and the place a refusal is shown.
form Confirm = { }

-- Destroy deletes the row, unless rows refer to it that keep it (counted again, as the page
-- counted them): the database would refuse the delete with an error, and the page says why
-- instead. The Show page's dialog posts it too.
Destroy.update : Destroy.Params -> Session -> Task Response
Destroy.update params session = {
  let _ <- Layout.adminOnly session.user
  let model <- counted params.id
  -- @admin begin remove
  let _ <- Db.delete Activity params.id
  Task.succeed (Response.redirect (Admin.Activities.Index.Index {}) |> Response.success "Deleted")
  -- @admin end
}

Delete.view : Model -> Session -> Html
Delete.view model session =
  <Layout.Page title="Delete activity">
    <h1>Delete this activity?</h1>

    <al-card>
      -- @admin begin row
      <p>{model.row.text}</p>
      -- @admin end
      <dl>
        -- @admin begin counts
        -- @admin end
      </dl>
      <form id="delete" submit={Destroy { id: model.row.id }}>
        <al-alert variant="destructive"><Errors form /></al-alert>
        {if blockers model > 0 then
          <p>It cannot be deleted while other rows refer to it.</p>
        else
          <al-button variant="destructive" type="submit">Delete</al-button>}
      </form>
    </al-card>
    <a href={Admin.Activities.Show.Show { id: model.row.id }}>Back</a>
  </Layout.Page>

-- @admin begin tests
test "deleting an activity nothing refers to" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let activity1 <- Db.insert Activity { text: "text-1", org: org1 }
  let page <- Test.get (Delete { id: activity1 })
  let r <- Test.submit (Destroy { id: activity1 }) {}
  let gone <- Db.get Activity activity1
  Task.succeed (
    {
      button: Test.count "#delete al-button" page.doc,
      answer: r.answer,
      notices: r.notices,
      gone: Maybe.map (\row -> row.id) gone,
    } == {
      button: 1,
      answer: Redirected (Admin.Activities.Index.Index {}),
      notices: ["Deleted"],
      gone: Nothing,
    }
  )
}

test "a visitor cannot delete an activity" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let activity1 <- Db.insert Activity { text: "text-1", org: org1 }
  let _ <- Test.get (Delete { id: activity1 })
  let _ <- Test.login { user: Nothing, org: Nothing }
  let r <- Test.submit (Destroy { id: activity1 }) {}
  let kept <- Db.get Activity activity1
  Task.succeed (
    { answer: r.answer, kept: Maybe.map (\row -> row.id) kept }
      == { answer: Redirected (Auth.Login.Login {}), kept: Just activity1 }
  )
}

test "a Member cannot delete an activity, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let activity1 <- Db.insert Activity { text: "text-1", org: org1 }
  let _ <- Test.get (Delete { id: activity1 })
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Member,
  }
  let r <- Test.submit (Destroy { id: activity1 }) {}
  let kept <- Db.get Activity activity1
  Task.succeed (
    { answer: r.answer, kept: Maybe.map (\row -> row.id) kept }
      == { answer: PageMissing, kept: Just activity1 }
  )
}

test "a demoted Admin cannot delete an activity" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let activity1 <- Db.insert Activity { text: "text-1", org: org1 }
  let _ <- Test.get (Delete { id: activity1 })
  let _ <- Db.update User me (\u -> { u | role: Member })
  let r <- Test.submit (Destroy { id: activity1 }) {}
  let kept <- Db.get Activity activity1
  Task.succeed (
    { answer: r.answer, kept: Maybe.map (\row -> row.id) kept }
      == { answer: PageMissing, kept: Just activity1 }
  )
}

test "a missing row is not found" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let r <- Test.open (Delete { id: Activity.ActivityId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "a visitor is sent to log in" = {
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let activity1 <- Db.insert Activity { text: "text-1", org: org1 }
  let r <- Test.open (Delete { id: activity1 })
  Task.succeed (r.answer == Redirected (Auth.Login.Login {}))
}

test "a Member gets no page, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Member,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let activity1 <- Db.insert Activity { text: "text-1", org: org1 }
  let r <- Test.open (Delete { id: activity1 })
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Member,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let activity1 <- Db.insert Activity { text: "text-1", org: org1 }
  let r <- Test.open (Delete { id: activity1 })
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
