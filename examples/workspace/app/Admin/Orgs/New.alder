-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Orgs.New

-- @admin begin imports
import Admin.Layout
import Table.Org
import Table.User
-- @admin end

-- @admin begin routes
route New    = GET  "/admin/org/new"          { }              requires user, role Admin
route Create = POST "/admin/org/new/_/Create" { } form OrgForm requires user, role Admin
-- @admin end

type Model = {
  -- @admin begin model
  -- @admin end
}

New.load : New.Params -> Session -> Query Model
New.load params session = {
  let _ <- Layout.adminOnly session.user
  -- @admin begin load
  Query.succeed {}
  -- @admin end
}

-- @admin begin form
form OrgForm = { name: Text.NonEmpty }
-- @admin end

-- @admin begin search
-- @admin end

-- Create adds the row and goes to its page.
Create.update : Create.Params -> Session -> Task Response
Create.update params session = {
  let _ <- Layout.adminOnly session.user
  -- @admin begin insert
  let id <- Db.insert Org { name: params.form.name }
  Task.succeed (Response.redirect (Admin.Orgs.Show.Show { id: id }))
  -- @admin end
}

New.view : Model -> Session -> Html
New.view model session =
  <Layout.Page title="New org">
    <h1>New org</h1>

    <al-card>
      -- @admin begin finder
      -- @admin end
      <form submit={Create}>
        -- @admin begin inputs
        <al-input field="name" label="Name" />
        -- @admin end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Create</al-button>
      </form>
    </al-card>
  </Layout.Page>

-- @admin begin tests
test "creating an org adds it, with the values submitted" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let page <- Test.get (New {})
  let r <- Test.submit Create { name: Text.NonEmpty "name-1" }
  let rows <- Db.from Org |> Db.all
  Task.succeed (
    {
      answers: List.map (\row -> Redirected (Admin.Orgs.Show.Show { id: row.id })) rows,
      rows: List.map (\row -> { name: row.name }) rows,
    }
      == { answers: [r.answer], rows: [{ name: Text.NonEmpty "name-1" }] }
  )
}

test "a visitor is sent to log in" = {
  let r <- Test.open (New {})
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Member gets no page, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Member,
  }
  let r <- Test.open (New {})
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Member,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let r <- Test.open (New {})
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
