-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Orgs.Index

-- @admin begin imports
import Admin.Layout
import Org
import User
-- @admin end

page "/admin/orgs" { } requires user, role Admin

-- The orgs: projects and todos live in a database per org (`silo org`), so they are
-- listed one org at a time, from its dashboard.
type Model = { rows: List Org }

load : Params -> Session -> Query Model
load params session = {
  let admin <- Admin.Layout.isAdmin session.user
  if admin then {
    -- @admin begin load
    let rows <-
      Db.from Org
        |> Db.orderBy Org.name.asc
        |> Db.all
    Query.succeed { rows: rows }
    -- @admin end
  } else
    Query.notFound
}

view : Model -> Session -> Html Msg
view model session =
  <Admin.Layout.Page title="Choose an org">
    <h1>Choose an org</h1>

    <p>Projects and todos live in a database per org: choose one.</p>
    <ul id="orgs">
      {for row in model.rows -> <li><a href={Admin.Orgs.Show { org: row.id }}>{row.name}</a></li>}
    </ul>
  </Admin.Layout.Page>

-- @admin begin tests
test "the picker lists every org, by name, each opening its dashboard" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let org2 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let page <- Test.get (Admin.Orgs.Index {})
  Task.succeed (
    { rows: List.map (\row -> row.id) page.model.rows, first: Test.text "#orgs li" page.doc }
      == { rows: [org2, org1], first: Just "name-1" }
  )
}

test "a visitor is sent to log in" = {
  let r <- Test.open (Admin.Orgs.Index {})
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Member gets no page, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Member,
  }
  let r <- Test.open (Admin.Orgs.Index {})
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Member,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let r <- Test.open (Admin.Orgs.Index {})
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
