-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Orgs.Show

-- @admin begin imports
import Admin.Layout
import Table.Activity
import Table.Membership
import Table.Org
import Table.User
-- @admin end

-- @admin begin routes
route Show = GET "/admin/org/{id}" { id: Org.OrgId } requires user, role Admin
-- @admin end

-- The row, the labels of the rows it refers to, and (for the delete dialog) how many rows of
-- each table refer to it.
type Model = {
  row: Org,
  labels: Labels,
  -- @admin begin model
  activities: Int,
  memberships: Int,
  -- @admin end
}

Show.load : Show.Params -> Session -> Query Model
Show.load params session = {
  let _ <- Layout.adminOnly session.user
  -- @admin begin load
  let found <- Db.get Org params.id
  let activities <-
    Db.from Activity
      |> Db.where (Activity.org.eq params.id)
      |> Db.count
  let memberships <-
    Db.from Membership
      |> Db.where (Membership.org.eq params.id)
      |> Db.count
  match found {
    Just row -> {
      let labels <- labelsOf [row]
      Query.succeed {
        row: row,
        labels: labels,
        activities: activities,
        memberships: memberships,
      }
    },
    Nothing -> Query.notFound,
  }
  -- @admin end
}

-- @admin begin labels
-- Labels are the rows the references of the rows shown name: their links show their labels.
type Labels = { }

labelsOf : List Org -> Query Labels
labelsOf rows = Query.succeed {}
-- @admin end

-- @admin begin blockers
-- blockers counts the rows that keep this one from being deleted, which the database would
-- refuse the delete for: the `@restrict` references to it, or to a row deleted with it.
blockers : Model -> Int
blockers model = 0
-- @admin end

Show.view : Model -> Session -> Html
Show.view model session =
  <Layout.Page title="Org">
    <h1>Org</h1>

    <al-card>
      <dl id="fields">
        -- @admin begin fields
        <dt>Id</dt>
        <dd>{model.row.id}</dd>
        <dt>Name</dt>
        <dd>{model.row.name}</dd>
        <dt>Created</dt>
        <dd>{Time.format "Jan 2, 2006" model.row.created}</dd>
        -- @admin end
      </dl>
      <div slot="actions">
        <al-button href={Admin.Orgs.Edit.Edit { id: model.row.id }}>Edit</al-button>
        <al-button variant="destructive">
          <button type="button" commandfor="delete-dialog" command="show-modal">Delete</button>
        </al-button>
      </div>
    </al-card>
    <al-dialog id="delete-dialog" heading="Delete this org?" dismissible>
      <dl>
        -- @admin begin counts
        <dt>Activities deleted with it</dt>
        <dd id="activities">{Text.fromInt model.activities}</dd>
        <dt>Memberships deleted with it</dt>
        <dd id="memberships">{Text.fromInt model.memberships}</dd>
        -- @admin end
      </dl>
      <form id="delete" submit={Admin.Orgs.Delete.Destroy { id: model.row.id }}>
        <al-alert variant="destructive"><Errors form /></al-alert>
        {if blockers model > 0 then
          <p>It cannot be deleted while other rows refer to it.</p>
        else
          <al-button variant="destructive" type="submit">Delete</al-button>}
      </form>
      <div slot="actions">
        <a href={Admin.Orgs.Delete.Delete { id: model.row.id }}>See the details</a>
      </div>
    </al-dialog>
    <a href={Admin.Orgs.Index.Index {}}>All orgs</a>
  </Layout.Page>

-- @admin begin tests
test "the page shows the row" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let r <- Test.open (Show { id: org1 })
  Task.succeed (
    { answer: r.answer, name: List.member "name-1" (Test.texts "#fields dd" r.doc) }
      == { answer: Shown, name: True }
  )
}

test "deleting an org nothing refers to" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let org2 <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let _ <- Db.insert Activity { text: "text-1", org: org2 }
  let _ <- Db.insert Membership { user: me, org: org2 }
  let page <- Test.get (Show { id: org1 })
  let r <- Test.submit (Admin.Orgs.Delete.Destroy { id: org1 }) {}
  let gone <- Db.get Org org1
  let kept <- Db.get Org org2
  Task.succeed (
    {
      button: Test.count "#delete al-button" page.doc,
      answer: r.answer,
      gone: Maybe.map (\row -> row.id) gone,
      kept: Maybe.map (\row -> row.id) kept,
    } == {
      button: 1,
      answer: Redirected (Admin.Orgs.Index.Index {}),
      gone: Nothing,
      kept: Just org2,
    }
  )
}

test "the page counts the rows that go with it" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Db.insert Activity { text: "text-1", org: org1 }
  let _ <- Db.insert Membership { user: me, org: org1 }
  let org2 <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let _ <- Db.insert Activity { text: "text-2", org: org2 }
  let _ <- Db.insert Membership { user: me, org: org2 }
  let page <- Test.get (Show { id: org1 })
  Task.succeed (
    { activities: Test.text "#activities" page.doc, memberships: Test.text "#memberships" page.doc }
      == { activities: Just "1", memberships: Just "1" }
  )
}

test "a missing row is not found" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let r <- Test.open (Show { id: Org.OrgId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "a visitor is sent to log in" = {
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let r <- Test.open (Show { id: org1 })
  Task.succeed (r.answer == Redirected (Auth.Login.Login {}))
}

test "a Member gets no page, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Member,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let r <- Test.open (Show { id: org1 })
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Member,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let r <- Test.open (Show { id: org1 })
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
