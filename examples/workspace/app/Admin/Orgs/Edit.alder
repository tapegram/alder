-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Orgs.Edit

-- @admin begin imports
import Admin.Layout
import Table.Org
import Table.User
-- @admin end

-- @admin begin routes
route Edit = GET "/admin/org/{id}/edit"        { id: Org.OrgId }              requires user, role Admin
route Save = PUT "/admin/org/{id}/edit/_/Save" { id: Org.OrgId } form OrgForm requires user, role Admin
-- @admin end

type Model = {
  row: Org,
  -- @admin begin model
  -- @admin end
}

Edit.load : Edit.Params -> Session -> Query Model
Edit.load params session = {
  let _ <- Layout.adminOnly session.user
  -- @admin begin load
  let found <- Db.get Org params.id
  match found {
    Just row -> { Query.succeed { row: row } },
    Nothing -> Query.notFound,
  }
  -- @admin end
}

-- @admin begin form
form OrgForm = { name: Text.NonEmpty }
-- @admin end

-- @admin begin search
-- @admin end

-- Save writes the form over the row (a row deleted since is not found) and goes to its page.
Save.update : Save.Params -> Session -> Task Response
Save.update params session = {
  let _ <- Layout.adminOnly session.user
  let found <- Db.get Org params.id
  match found {
    Just row -> {
      -- @admin begin update
      let _ <- Db.update Org row.id (\r -> { r | name: params.form.name })
      Task.succeed (Response.redirect (Admin.Orgs.Show.Show { id: row.id }))
      -- @admin end
    },
    Nothing -> Task.notFound,
  }
}

Edit.view : Model -> Session -> Html
Edit.view model session =
  <Layout.Page title="Edit org">
    <h1>Edit org</h1>

    <al-card>
      -- @admin begin finder
      -- @admin end
      <form submit={Save { id: model.row.id }}>
        -- @admin begin inputs
        <al-input field="name" label="Name" value={model.row.name} />
        -- @admin end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Save</al-button>
      </form>
    </al-card>
    <a href={Admin.Orgs.Show.Show { id: model.row.id }}>Back</a>
  </Layout.Page>

-- @admin begin tests
test "saving changes every field" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let page <- Test.get (Edit { id: org1 })
  let r <- Test.submit (Save { id: org1 }) { name: Text.NonEmpty "name-2" }
  let after <- Db.get Org org1
  Task.succeed (
    { answer: r.answer, row: Maybe.map (\row -> { name: row.name }) after }
      == {
        answer: Redirected (Admin.Orgs.Show.Show { id: org1 }),
        row: Just { name: Text.NonEmpty "name-2" },
      }
  )
}

test "a missing row is not found" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let r <- Test.open (Edit { id: Org.OrgId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "a visitor is sent to log in" = {
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let r <- Test.open (Edit { id: org1 })
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Member gets no page, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Member,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let r <- Test.open (Edit { id: org1 })
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Member,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let r <- Test.open (Edit { id: org1 })
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
