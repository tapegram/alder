-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Projects.New

-- @admin begin imports
import Admin.Layout
import Org
import Project
import User
-- @admin end

page "/admin/orgs/{org}/project/new" { org: Org.OrgId } requires user, role Admin, silo org

type Model = {
  -- @admin begin model
  -- @admin end
}

load : Params -> Session -> Query Model
load params session = {
  let admin <- Layout.isAdmin session.user
  if admin then {
    -- @admin begin load
    Query.succeed {}
    -- @admin end
  } else
    Query.notFound
}

-- @admin begin form
form ProjectForm = { name: Text.NonEmpty }
-- @admin end

-- @admin begin search
-- @admin end

msg Create form ProjectForm

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  -- @admin begin finds
  -- @admin end
  Create p -> {
    -- @admin begin insert
    let id <- Db.insert Project { name: p.form.name, org: session.org }
    Task.succeed (Redirect (Admin.Projects.Show { org: session.org, id: id }))
    -- @admin end
  },
}

view : Model -> Session -> Html Msg
view model session =
  <Layout.Page title="New project">
    <h1>New project</h1>

    <al-card>
      -- @admin begin finder
      -- @admin end
      <form submit={Create}>
        -- @admin begin inputs
        <al-input field="name" label="Name" />
        -- @admin end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Create</al-button>
      </form>
    </al-card>
  </Layout.Page>

-- @admin begin tests
test "creating a project adds it, with the values submitted" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let page <- Test.get (Admin.Projects.New { org: org })
  let r <- Test.submit ProjectForm { name: Text.NonEmpty "name-1" }
  let rows <- Db.from Project |> Db.all
  Task.succeed (
    {
      answers: List.map (\row -> Redirected (Admin.Projects.Show { org: org, id: row.id })) rows,
      rows: List.map (\row -> { name: row.name }) rows,
    }
      == { answers: [r.answer], rows: [{ name: Text.NonEmpty "name-1" }] }
  )
}

test "a visitor is sent to log in" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let r <- Test.open (Admin.Projects.New { org: org })
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Member gets no page, even one made Admin since logging in" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Member,
  }
  let r <- Test.open (Admin.Projects.New { org: org })
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Member,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let r <- Test.open (Admin.Projects.New { org: org })
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
