-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Projects.New

-- @admin begin imports
import Admin.Layout
import Table.Org
import Table.Project
import Table.User
-- @admin end

-- @admin begin routes
route New    = GET  "/admin/orgs/{org}/project/new"          { org: Org.OrgId }                  requires user, role Admin, silo org
route Create = POST "/admin/orgs/{org}/project/new/_/Create" { org: Org.OrgId } form ProjectForm requires user, role Admin, silo org
-- @admin end

type Model = {
  -- @admin begin model
  -- @admin end
}

New.load : New.Params -> Session -> Query Model
New.load params session = {
  let _ <- Layout.adminOnly session.user
  -- @admin begin load
  Query.succeed {}
  -- @admin end
}

-- @admin begin form
form ProjectForm = { name: Text.NonEmpty }
-- @admin end

-- @admin begin search
-- @admin end

-- Create adds the row and goes to its page.
Create.update : Create.Params -> Session -> Task Response
Create.update params session = {
  let _ <- Layout.adminOnly session.user
  -- @admin begin insert
  let id <- Db.insert Project { name: params.form.name, org: session.org }
  Task.succeed (Response.redirect (Admin.Projects.Show.Show { org: session.org, id: id }))
  -- @admin end
}

New.view : Model -> Session -> Html
New.view model session =
  <Layout.Page title="New project">
    <h1>New project</h1>

    <al-card>
      -- @admin begin finder
      -- @admin end
      <form submit={Create { org: session.org }}>
        -- @admin begin inputs
        <al-input field="name" label="Name" />
        -- @admin end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Create</al-button>
      </form>
    </al-card>
  </Layout.Page>

-- @admin begin tests
test "creating a project adds it, with the values submitted" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let page <- Test.get (New { org: org })
  let r <- Test.submit (Create { org: org }) { name: Text.NonEmpty "name-1" }
  let rows <- Db.from Project |> Db.all
  Task.succeed (
    {
      answers: List.map (\row ->
        Redirected (Admin.Projects.Show.Show { org: org, id: row.id })
      ) rows,
      rows: List.map (\row -> { name: row.name }) rows,
    }
      == { answers: [r.answer], rows: [{ name: Text.NonEmpty "name-1" }] }
  )
}

test "a visitor cannot create a project" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let _ <- Test.get (New { org: org })
  let _ <- Test.login { user: Nothing, org: Nothing }
  let r <- Test.submit (Create { org: org }) { name: Text.NonEmpty "name-1" }
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let rows <- Db.from Project |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows } == { answer: Redirected (Auth.Login.Login {}), rows: 0 }
  )
}

test "a Member cannot create a project, even one made Admin since logging in" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let _ <- Test.get (New { org: org })
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Member,
  }
  let r <- Test.submit (Create { org: org }) { name: Text.NonEmpty "name-1" }
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let rows <- Db.from Project |> Db.count
  Task.succeed ({ answer: r.answer, rows: rows } == { answer: PageMissing, rows: 0 })
}

test "a demoted Admin cannot create a project" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let _ <- Test.get (New { org: org })
  let _ <- Db.update User me (\u -> { u | role: Member })
  let r <- Test.submit (Create { org: org }) { name: Text.NonEmpty "name-1" }
  let rows <- Db.from Project |> Db.count
  Task.succeed ({ answer: r.answer, rows: rows } == { answer: PageMissing, rows: 0 })
}

test "a visitor is sent to log in" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let r <- Test.open (New { org: org })
  Task.succeed (r.answer == Redirected (Auth.Login.Login {}))
}

test "a Member gets no page, even one made Admin since logging in" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Member,
  }
  let r <- Test.open (New { org: org })
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Member,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let r <- Test.open (New { org: org })
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
