-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Projects.Edit

-- @admin begin imports
import Admin.Layout
import Table.Org
import Table.Project
import Table.User
-- @admin end

-- @admin begin routes
route Edit = GET "/admin/orgs/{org}/project/{id}/edit"        { org: Org.OrgId, id: Project.ProjectId }                  requires user, role Admin, silo org
route Save = PUT "/admin/orgs/{org}/project/{id}/edit/_/Save" { org: Org.OrgId, id: Project.ProjectId } form ProjectForm requires user, role Admin, silo org
-- @admin end

type Model = {
  row: Project,
  -- @admin begin model
  -- @admin end
}

Edit.load : Edit.Params -> Session -> Query Model
Edit.load params session = {
  let _ <- Layout.adminOnly session.user
  -- @admin begin load
  let found <- Db.get Project params.id
  match found {
    Just row -> { Query.succeed { row: row } },
    Nothing -> Query.notFound,
  }
  -- @admin end
}

-- @admin begin form
form ProjectForm = { name: Text.NonEmpty }
-- @admin end

-- @admin begin search
-- @admin end

-- Save writes the form over the row (a row deleted since is not found) and goes to its page.
Save.update : Save.Params -> Session -> Task Response
Save.update params session = {
  let _ <- Layout.adminOnly session.user
  let found <- Db.get Project params.id
  match found {
    Just row -> {
      -- @admin begin update
      let _ <- Db.update Project row.id (\r -> { r | name: params.form.name })
      Task.succeed (Response.redirect (Admin.Projects.Show.Show { org: session.org, id: row.id }))
      -- @admin end
    },
    Nothing -> Task.notFound,
  }
}

Edit.view : Model -> Session -> Html
Edit.view model session =
  <Layout.Page title="Edit project">
    <h1>Edit project</h1>

    <al-card>
      -- @admin begin finder
      -- @admin end
      <form submit={Save { org: session.org, id: model.row.id }}>
        -- @admin begin inputs
        <al-input field="name" label="Name" value={model.row.name} />
        -- @admin end
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">Save</al-button>
      </form>
    </al-card>
    <a href={Admin.Projects.Show.Show { org: session.org, id: model.row.id }}>Back</a>
  </Layout.Page>

-- @admin begin tests
test "saving changes every field" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let page <- Test.get (Edit { org: org, id: project1 })
  let r <- Test.submit (Save { org: org, id: project1 }) { name: Text.NonEmpty "name-2" }
  let after <- Db.get Project project1
  Task.succeed (
    { answer: r.answer, row: Maybe.map (\row -> { name: row.name }) after }
      == {
        answer: Redirected (Admin.Projects.Show.Show { org: org, id: project1 }),
        row: Just { name: Text.NonEmpty "name-2" },
      }
  )
}

test "a visitor cannot save a project" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let before <- Db.get Project project1
  let _ <- Test.get (Edit { org: org, id: project1 })
  let _ <- Test.login { user: Nothing, org: Nothing }
  let r <- Test.submit (Save { org: org, id: project1 }) { name: Text.NonEmpty "name-2" }
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let after <- Db.get Project project1
  Task.succeed (
    { answer: r.answer, row: after } == { answer: Redirected (Auth.Login.Login {}), row: before }
  )
}

test "a Member cannot save a project, even one made Admin since logging in" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let before <- Db.get Project project1
  let _ <- Test.get (Edit { org: org, id: project1 })
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Member,
  }
  let r <- Test.submit (Save { org: org, id: project1 }) { name: Text.NonEmpty "name-2" }
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let after <- Db.get Project project1
  Task.succeed ({ answer: r.answer, row: after } == { answer: PageMissing, row: before })
}

test "a demoted Admin cannot save a project" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let before <- Db.get Project project1
  let _ <- Test.get (Edit { org: org, id: project1 })
  let _ <- Db.update User me (\u -> { u | role: Member })
  let r <- Test.submit (Save { org: org, id: project1 }) { name: Text.NonEmpty "name-2" }
  let after <- Db.get Project project1
  Task.succeed ({ answer: r.answer, row: after } == { answer: PageMissing, row: before })
}

test "a missing row is not found" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let r <- Test.open (Edit { org: org, id: Project.ProjectId "missing" })
  Task.succeed (r.answer == PageMissing)
}

test "a visitor is sent to log in" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let r <- Test.open (Edit { org: org, id: project1 })
  Task.succeed (r.answer == Redirected (Auth.Login.Login {}))
}

test "a Member gets no page, even one made Admin since logging in" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Member,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let r <- Test.open (Edit { org: org, id: project1 })
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Member,
  }
  let _ <- Test.member me org
  let _ <- Test.login {
    user: Just me,
    org: Just org,
    role: Admin,
  }
  let project1 <- Db.insert Project { name: Text.NonEmpty "name-1", org: org }
  let r <- Test.open (Edit { org: org, id: project1 })
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
