  let _ <-
    Task.all (
      List.map (\n -> Db.insert Org { name: Text.NonEmpty ("name-" ++ Text.fromInt n) }) (
        List.range 1 6
      )
    )
  let page <- Test.get (Admin.Index {})
  Task.succeed (
    { count: Test.text "#silo-org al-badge" page.doc, rows: Test.texts "#silo-org li" page.doc }
      == { count: Just "6", rows: ["name-6", "name-5", "name-4", "name-3", "name-2"] }
