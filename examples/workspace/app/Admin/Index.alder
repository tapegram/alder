-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Index

-- @admin begin imports
import Activity
import Admin.Layout
import Membership
import Org
import User
-- @admin end

page "/admin" { } requires user, role Admin

-- A card of the dashboard: a table's count and its newest rows, each linking to its page.
type Card = {
  key: Text,
  title: Text,
  href: Page,
  count: Int,
  rows: List { label: Text, href: Page },
}

type Model = { cards: List Card }

-- recent is how many of a table's newest rows its card lists.
recent : Int
recent = 5

load : Params -> Session -> Query Model
load params session = {
  let admin <- Admin.Layout.isAdmin session.user
  if admin then {
    -- @admin begin cards
    let activities <-
      Db.from Activity
        |> Db.orderBy Activity.created.desc
        |> Db.limit recent
        |> Db.all
    let activityCount <- Db.from Activity |> Db.count
    let memberships <-
      Db.from Membership
        |> Db.orderBy Membership.created.desc
        |> Db.limit recent
        |> Db.all
    let membershipCount <- Db.from Membership |> Db.count
    let orgs <-
      Db.from Org
        |> Db.orderBy Org.created.desc
        |> Db.limit recent
        |> Db.all
    let orgCount <- Db.from Org |> Db.count
    let users <-
      Db.from User
        |> Db.orderBy User.created.desc
        |> Db.limit recent
        |> Db.all
    let userCount <- Db.from User |> Db.count
    Query.succeed {
      cards: [
        {
          key: "activities",
          title: "Activities",
          href: Admin.Activity.Index {},
          count: activityCount,
          rows: List.map (\row -> {
            label: row.text,
            href: Admin.Activity.Show { id: row.id },
          }) activities,
        },
        {
          key: "memberships",
          title: "Memberships",
          href: Admin.Membership.Index {},
          count: membershipCount,
          rows: List.map (\row -> {
            label: row.id,
            href: Admin.Membership.Show { id: row.id },
          }) memberships,
        },
        {
          key: "orgs",
          title: "Orgs",
          href: Admin.Org.Index {},
          count: orgCount,
          rows: List.map (\row -> { label: row.name, href: Admin.Org.Show { id: row.id } }) orgs,
        },
        {
          key: "users",
          title: "Users",
          href: Admin.User.Index {},
          count: userCount,
          rows: List.map (\row -> { label: row.email, href: Admin.User.Show { id: row.id } }) users,
        },
        {
          key: "silo-org",
          title: "Projects and todos, by org",
          href: Admin.Orgs.Index {},
          count: orgCount,
          rows: List.map (\row -> { label: row.name, href: Admin.Orgs.Show { org: row.id } }) orgs,
        },
      ],
    }
    -- @admin end
  } else
    Query.notFound
}

view : Model -> Session -> Html Msg
view model session =
  <Admin.Layout.Page title="Dashboard">
    <h1>Admin</h1>

    <al-stack gap="md">
      {for card in model.cards ->
        <al-card id={card.key}>
          <h2 slot="header">
            <a href={card.href}>{card.title}</a> <al-badge variant="secondary">{Text.fromInt card.count}</al-badge>
          </h2>
          <ul>
            {for row in card.rows -> <li><a href={row.href}>{row.label}</a></li>}
          </ul>
        </al-card>}
    </al-stack>
  </Admin.Layout.Page>

-- @admin begin tests
test "the dashboard counts the activities and lists the newest five" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <-
    Task.all (
      List.map (\n -> Db.insert Activity { text: "text-" ++ Text.fromInt n, org: org1 }) (
        List.range 1 6
      )
    )
  let page <- Test.get (Admin.Index {})
  Task.succeed (
    { count: Test.text "#activities al-badge" page.doc, rows: Test.texts "#activities li" page.doc }
      == { count: Just "6", rows: ["text-6", "text-5", "text-4", "text-3", "text-2"] }
  )
}

test "the dashboard counts the memberships and lists the newest five" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Task.all (List.map (\n -> Db.insert Membership { user: me, org: org1 }) (List.range 1 6))
  let page <- Test.get (Admin.Index {})
  let newest <-
    Db.from Membership
      |> Db.orderBy Membership.created.desc
      |> Db.limit 5
      |> Db.all
  Task.succeed (
    {
      count: Test.text "#memberships al-badge" page.doc,
      rows: List.map (\card -> List.map (\row -> row.href) card.rows) (
        List.filter (\card -> card.key == "memberships") page.model.cards
      ),
    }
      == { count: Just "6", rows: [List.map (\row -> Admin.Membership.Show { id: row.id }) newest] }
  )
}

