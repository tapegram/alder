-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Membership.Bulk

-- @admin begin imports
import Admin.Layout
import Membership
import Org
import User
-- @admin end

page "/admin/membership/bulk" { ids: List Membership.MembershipId } requires user, role Admin

-- The rows chosen on the list (at most maxRows of them), the ids of those that other rows keep
-- from being deleted, and how many ids the page was given.
type Model = {
  rows: List Membership,
  held: List Membership.MembershipId,
  chosen: Int,
}

-- maxRows is how many rows one action takes: a page of the list. More are refused.
maxRows : Int
maxRows = 25

load : Params -> Session -> Query Model
load params session = {
  let admin <- Layout.isAdmin session.user
  if admin then {
    -- @admin begin load
    let ids = List.take maxRows params.ids
    let rows <-
      Db.from Membership
        |> Db.where (Membership.id.in ids)
        |> Db.all
    Query.succeed {
      rows: rows,
      held: [],
      chosen: List.length params.ids,
    }
    -- @admin end
  } else
    Query.notFound
}

-- refused says whether a row is kept from being deleted: rows refer to it with a `@restrict`.
refused : Model -> Session -> Membership -> Bool
refused model session row = List.member row.id model.held

-- @admin begin bulk
form Confirm = { }

msg BulkDelete form Confirm

-- Each action reads the rows again (load runs before every message) and answers with a notice;
-- none takes more than maxRows rows.
update : Msg -> Model -> Session -> Task Nav
update msg model session =
  if model.chosen > maxRows then
    Task.succeed (Reject ("Choose at most " ++ Text.fromInt maxRows ++ " rows at a time."))
  else
    match msg {
      BulkDelete p -> {
        let allowed = List.filter (\row -> refused model session row == False) model.rows
        let _ <- Task.all (List.map (\row -> Db.delete Membership row.id) allowed)
        Task.succeed (
          Notice.with ("Deleted " ++ Text.fromInt (List.length allowed) ++ " of " ++ Text.fromInt (List.length model.rows)) (
            Redirect (Admin.Membership.Index {})
          )
        )
      },
    }
-- @admin end

view : Model -> Session -> Html Msg
view model session =
  <Layout.Page title="Selected memberships">
    <h1>{Text.fromInt (List.length model.rows)} selected</h1>

    <al-card>
      {if model.chosen > maxRows then
        <al-alert id="too-many" variant="warning">
          {"Choose at most " ++ Text.fromInt maxRows ++ " rows at a time."}
        </al-alert>
      else
        <span></span>}
      <ul id="selected">
        {for row in model.rows ->
          <li>
            {row.id}
            {if refused model session row then
              <small> (kept: other rows refer to it)</small>
            else
              <span></span>}
          </li>}
      </ul>
      -- @admin begin actions
      <form id="bulk-delete" submit={BulkDelete}>
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button variant="destructive" type="submit">
          Delete the rows that can be deleted
        </al-button>
      </form>
      -- @admin end
    </al-card>
    <a href={Admin.Membership.Index {}}>Back to the list</a>
  </Layout.Page>

-- @admin begin tests
test "deleting the chosen rows" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let membership1 <- Db.insert Membership { user: me, org: org1 }
  let membership2 <- Db.insert Membership { user: me, org: org1 }
  let _ <- Test.get (Admin.Membership.Bulk { ids: [membership1] })
  let r <- Test.submit Confirm {}
  let gone <- Db.get Membership membership1
  let left <- Db.get Membership membership2
  Task.succeed (
    {
      answer: r.answer,
      gone: Maybe.map (\row -> row.id) gone,
      left: Maybe.map (\row -> row.id) left,
    } == {
        answer: Redirected (Admin.Membership.Index {}),
        gone: Nothing,
        left: Just membership2,
      }
  )
}

test "25 chosen ids are taken" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let membership1 <- Db.insert Membership { user: me, org: org1 }
  let page <-
    Test.get (Admin.Membership.Bulk {
      ids: [membership1]
        ++ List.map (\n -> Membership.MembershipId ("none-" ++ Text.fromInt n)) (List.range 1 24),
    })
  let r <- Test.submit Confirm {}
  let after <- Db.get Membership membership1
  Task.succeed (
    {
      answer: r.answer,
      kept: Maybe.map (\row -> row.id) after,
      warned: Test.count "#too-many" page.doc,
    } == {
        answer: Redirected (Admin.Membership.Index {}),
        kept: Nothing,
        warned: 0,
      }
  )
}

test "26 chosen ids are refused" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let membership1 <- Db.insert Membership { user: me, org: org1 }
  let page <-
    Test.get (Admin.Membership.Bulk {
      ids: [membership1]
        ++ List.map (\n -> Membership.MembershipId ("none-" ++ Text.fromInt n)) (List.range 1 25),
    })
  let r <- Test.submit Confirm {}
  let after <- Db.get Membership membership1
  Task.succeed (
    {
      answer: r.answer,
      kept: Maybe.map (\row -> row.id) after,
      warned: Test.count "#too-many" page.doc,
    } == {
        answer: FormRejected [{ field: "", message: "Choose at most 25 rows at a time." }],
        kept: Just membership1,
        warned: 1,
      }
  )
}

test "a visitor is sent to log in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let membership1 <- Db.insert Membership { user: me, org: org1 }
  let r <- Test.open (Admin.Membership.Bulk { ids: [membership1] })
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Member gets no page, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Member,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let membership1 <- Db.insert Membership { user: me, org: org1 }
  let r <- Test.open (Admin.Membership.Bulk { ids: [membership1] })
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Member,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let membership1 <- Db.insert Membership { user: me, org: org1 }
  let r <- Test.open (Admin.Membership.Bulk { ids: [membership1] })
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
