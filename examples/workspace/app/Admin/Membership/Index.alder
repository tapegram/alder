-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Membership.Index

-- @admin begin imports
import Admin.Layout
import Membership
import Org
import User
-- @admin end

-- @admin begin params
page "/admin/membership" {
  q: Text = "",
  sort: Text = "created",
  dir: Text = "desc",
  page: Int = 1,
} requires user, role Admin
-- @admin end

type Model = {
  rows: List Membership,
  labels: Labels,
  q: Text,
  filters: Filters,
  sort: Text,
  dir: Text,
  page: Int,
  pages: Int,
  count: Int,
}

perPage : Int
perPage = 25

-- @admin begin search
-- search is every row: the table has no text to search.
search : Text -> Condition Membership
search q = Db.and []
-- @admin end

-- A Filter is one of the list's selects: the column it filters, the option chosen ("" for any),
-- and each option's value in the address, its label, and the rows it selects.
type Filter = {
  name: Text,
  label: Text,
  value: Text,
  options: List {
    value: Text,
    label: Text,
    rows: Condition Membership,
  },
}

-- @admin begin filters
-- Filters are the option each filter has chosen in the address ("" for any): a select for each
-- Bool and union column: this table has none.
type Filters = { }

-- chosen is the filters' options in params.
chosen : Params -> Filters
chosen params = {}

-- filters are the list's filters, each with the option f has chosen.
filters : Filters -> List Filter
filters f = []

-- filtered is the rows that the option each filter has chosen selects (every row for "", or for
-- a value that is no option's).
filtered : List Filter -> Condition Membership
filtered fs = Db.and []

-- listAt is this list with the model's search and filters, sorted by sort and dir, at page n.
listAt : Model -> Text -> Text -> Int -> Page
listAt model sort dir n = Admin.Membership.Index {
  q: model.q,
  sort: sort,
  dir: dir,
  page: n,
}
-- @admin end

-- @admin begin sorts
-- sorts are the columns the list sorts by, by name.
sorts : List {
  name: Text,
  asc: Order Membership,
  desc: Order Membership,
}
sorts = [
  {
    name: "user",
    asc: Membership.user.asc,
    desc: Membership.user.desc,
  },
  {
    name: "org",
    asc: Membership.org.asc,
    desc: Membership.org.desc,
  },
  {
    name: "created",
    asc: Membership.created.asc,
    desc: Membership.created.desc,
  },
]
-- @admin end

-- order is the ordering sort names, ascending when dir is "asc"; a name that is not a column's
-- sorts newest first.
order : Text -> Text -> Order Membership
order sort dir = match List.find (\s -> s.name == sort) sorts {
  Just s -> if dir == "asc" then s.asc else s.desc,
  Nothing -> Membership.created.desc,
}

-- toggle is the direction a column's header sorts by: the other way round when the list is
-- sorted by that column ascending.
toggle : Model -> Text -> Text
toggle model sort = if model.sort == sort && model.dir == "asc" then "desc" else "asc"

-- load reads how many rows match the search and the filters, and one page of them (the last, for
-- a page past it), in the order asked for. The search text is cut to 200 characters (Text.slice):
-- a text over 10,000 bytes would fail the query (chapter 8, "Search").
load : Params -> Session -> Query Model
load params session = {
  let admin <- Layout.isAdmin session.user
  if admin then {
    let q = Text.slice 0 200 params.q
    let f = chosen params
    let count <-
      Db.from Membership
        |> Db.where (Db.and [search q, filtered (filters f)])
        |> Db.count
    let pages = Int.max 1 ((count + perPage - 1) / perPage)
    let page = Int.clamp { min: 1, max: pages } params.page
    let rows <-
      Db.from Membership
        |> Db.where (Db.and [search q, filtered (filters f)])
        |> Db.orderBy (order params.sort params.dir)
        |> Db.limit perPage
        |> Db.offset ((page - 1) * perPage)
        |> Db.all
    let labels <- labelsOf rows
    Query.succeed {
      rows: rows,
      labels: labels,
      q: q,
      filters: f,
      sort: params.sort,
      dir: params.dir,
      page: page,
      pages: pages,
      count: count,
    }
  } else
    Query.notFound
}

-- @admin begin labels
-- Labels are the rows the references of the rows shown name: their links show their labels.
type Labels = { users: List User, orgs: List Org }

-- labelsOf reads the rows that rows refer to.
labelsOf : List Membership -> Query Labels
labelsOf rows = {
  let users <-
    Db.from User
      |> Db.where (User.id.in (List.map (\row -> row.user) rows))
      |> Db.all
  let orgs <-
    Db.from Org
      |> Db.where (Org.id.in (List.map (\row -> row.org) rows))
      |> Db.all
  Query.succeed { users: users, orgs: orgs }
}

-- userLabel is the label of the user id names (the id itself if it names none).
userLabel : Labels -> User.UserId -> Text
userLabel labels id = match List.find (\r -> r.id == id) labels.users {
  Just r -> r.email,
  Nothing -> id,
}

-- orgLabel is the label of the org id names (the id itself if it names none).
orgLabel : Labels -> Org.OrgId -> Text
orgLabel labels id = match List.find (\r -> r.id == id) labels.orgs {
  Just r -> r.name,
  Nothing -> id,
}
-- @admin end

view : Model -> Session -> Html Msg
view model session =
  <Layout.Page title="Memberships">
    <h1>Memberships</h1>

    <al-stack direction="row" gap="sm">
      <form method="get" action="/admin/membership">
        <input type="search" name="q" value={model.q} aria-label="Search" />
        {for f in filters model.filters ->
          <al-select label={f.label}>
            <label>
              {f.label}
              <select name={f.name}>
                <option value="" selected={f.value == ""}>any</option>
                {for o in f.options ->
                  <option value={o.value} selected={o.value == f.value}>{o.label}</option>}
              </select>
            </label>
          </al-select>}
        <input type="hidden" name="sort" value={model.sort} />
        <input type="hidden" name="dir" value={model.dir} />
        <al-button type="submit" variant="secondary">Search</al-button>
      </form>
      <al-button href={Admin.Membership.New {}}>New membership</al-button>
    </al-stack>

    <p id="count">{if model.count == 1 then "1 row" else Text.fromInt model.count ++ " rows"}</p>

    <al-table>
      <table>
        <thead>
          <tr>
            -- @admin begin headers
            <th><span class="sr-only">Choose</span></th>
            <th><a href={listAt model "id" (toggle model "id") 1}>Id</a></th>
            <th><a href={listAt model "user" (toggle model "user") 1}>User</a></th>
            <th><a href={listAt model "org" (toggle model "org") 1}>Org</a></th>
            <th><a href={listAt model "created" (toggle model "created") 1}>Created</a></th>
            -- @admin end
          </tr>
        </thead>
        <tbody>
          {for row in model.rows ->
            <tr>
              -- @admin begin cells
              <td>
                <input
                  type="checkbox"
                  name="ids"
                  form="bulk"
                  value={row.id}
                  aria-label={"Choose " ++ row.id} />
              </td>
              <td><a href={Admin.Membership.Show { id: row.id }}>{row.id}</a></td>
              <td>
                <a href={Admin.User.Show { id: row.user }}>{userLabel model.labels row.user}</a>
              </td>
              <td><a href={Admin.Org.Show { id: row.org }}>{orgLabel model.labels row.org}</a></td>
              <td>{Time.format "Jan 2, 2006" row.created}</td>
              -- @admin end
            </tr>}
        </tbody>
      </table>
    </al-table>

    <al-stack direction="row" gap="sm">
      <form id="bulk" method="get" action="/admin/membership/bulk">
        <al-button type="submit" variant="secondary">Act on the chosen rows</al-button>
      </form>
      <form id="bulk-page" method="get" action="/admin/membership/bulk">
        {for row in model.rows -> <input type="hidden" name="ids" value={row.id} />}
        <al-button type="submit" variant="secondary">Act on all rows on this page</al-button>
      </form>
    </al-stack>

    <al-pagination role="navigation" aria-label="Pages">
      {if model.page > 1 then
        <a slot="prev" href={listAt model model.sort model.dir (model.page - 1)} rel="prev">
          Previous
        </a>
      else
        <span slot="prev" aria-disabled="true">Previous</span>}
      <span>Page {Text.fromInt model.page} of {Text.fromInt model.pages}</span>
      {if model.page < model.pages then
        <a slot="next" href={listAt model model.sort model.dir (model.page + 1)} rel="next">Next</a>
      else
        <span slot="next" aria-disabled="true">Next</span>}
    </al-pagination>
  </Layout.Page>

-- @admin begin tests
test "the list shows every row, newest first, and the labels of the rows they refer to" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let membership1 <- Db.insert Membership { user: me, org: org1 }
  let membership2 <- Db.insert Membership { user: me, org: org1 }
  let user2 <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let org2 <- Db.insert Org { name: Text.NonEmpty "name-2" }
  let page <- Test.get (Admin.Membership.Index {})
  Task.succeed (
    {
      rows: List.map (\row -> row.id) page.model.rows,
      users: List.length page.model.labels.users,
      userLabel: userLabel page.model.labels me,
      orgs: List.length page.model.labels.orgs,
      orgLabel: orgLabel page.model.labels org1,
    } == {
        rows: [membership2, membership1],
        users: 1,
        userLabel: "email-1@example.com",
        orgs: 1,
        orgLabel: "name-1",
      }
  )
}

test "a search text of 20,000 characters is cut to 200" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let long = Text.join "" (List.map (\n -> "z") (List.range 1 20000))
  let page <- Test.get (Admin.Membership.Index { q: long })
  Task.succeed (
    { q: Text.length page.model.q, rows: List.length page.model.rows } == { q: 200, rows: 0 }
  )
}

test "the list has 25 rows a page, and a page past the last is the last" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let org1 <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <-
    Task.all (List.map (\n -> Db.insert Membership { user: me, org: org1 }) (List.range 1 26))
  let first <- Test.get (Admin.Membership.Index {})
  let second <- Test.get (Admin.Membership.Index { page: 2 })
  let past <- Test.get (Admin.Membership.Index { page: 9 })
  Task.succeed (
    {
      first: List.length first.model.rows,
      second: List.length second.model.rows,
      past: { page: past.model.page, rows: List.length past.model.rows },
      count: Test.text "#count" first.doc,
      pages: Test.texts "al-pagination span" first.doc,
    } == {
        first: 25,
        second: 1,
        past: { page: 2, rows: 1 },
        count: Just "26 rows",
        pages: ["Previous", "Page 1 of 2"],
      }
  )
}

test "a visitor is sent to log in" = {
  let r <- Test.open (Admin.Membership.Index {})
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a Member gets no page, even one made Admin since logging in" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Admin,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Member,
  }
  let r <- Test.open (Admin.Membership.Index {})
  Task.succeed (r.answer == PageMissing)
}

test "a demoted Admin is refused at once" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
    role: Member,
  }
  let _ <- Test.login {
    user: Just me,
    org: Nothing,
    role: Admin,
  }
  let r <- Test.open (Admin.Membership.Index {})
  Task.succeed (r.answer == PageMissing)
}
-- @admin end
