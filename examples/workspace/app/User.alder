module User

type UserId = brand Text

-- A Member works in the orgs they belong to. An Admin also manages every table through the
-- generated admin (app/Admin/, `requires user, role Admin`; book 15), the siloed ones an org at
-- a time, member or not.
type Role = Member | Admin

table User {
  id: UserId @id,
  email: Text.Email @unique,
  name: Text.NonEmpty,
  passwordHash: Text,
  role: Role = Member,
  created: Time @created,
}
