module Books.Index

import Layout
import Table.Book
import Table.Loan

route Index = GET  "/"                 { }
route Lend  = POST "/books/{id}/loans" { id: Book.BookId }

type Model = { books: List Book }

Index.load : Index.Params -> Session -> Query Model
Index.load params session = {
  let books <-
    Db.from Book
      |> Db.orderBy Book.title.asc
      |> Db.all
  Query.succeed { books: books }
}

Lend.update : Lend.Params -> Session -> Task Response
Lend.update p session = {
  let _ <- Db.insert Loan { book: p.id }
  Task.succeed (Response.redirect (Books.Show.Show { id: p.id }))
}

Index.view : Model -> Session -> Html
Index.view model session =
  <Layout.Page title="Shelf">
    <h1>Shelf</h1>
    <ul id="books">
      {for book in model.books ->
        <li>
          <a href={Books.Show.Show { id: book.id }}>{book.title}</a>
          {" by " ++ book.author}
          <al-button variant="ghost" size="sm" click={Lend { id: book.id }}>Lend</al-button>
        </li>}
    </ul>
  </Layout.Page>

test "the shelf lists its books by title" = {
  let page <- Test.get (Index {})
  Task.succeed (
    Test.texts "li a" page.doc
      == ["Bleak House", "Middlemarch", "Moby-Dick", "Persuasion", "The Leopard"]
  )
}

test "lending a book records a loan and opens the book" = {
  let _ <- Test.get (Index {})
  let r <- Test.click (Lend { id: Book.BookId "3" })
  let loans <-
    Db.from Loan
      |> Db.where (Loan.book.eq (Book.BookId "3"))
      |> Db.count
  Task.succeed (
    { answer: r.answer, loans: loans }
      == { answer: Redirected (Books.Show.Show { id: Book.BookId "3" }), loans: 1 }
  )
}
