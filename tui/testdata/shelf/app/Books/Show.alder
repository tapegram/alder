module Books.Show

import Layout
import Table.Book
import Table.Loan

route Show = GET "/books/{id}" { id: Book.BookId }

type Model = { book: Book, shelf: List { book: Book, lent: Bool } }

-- load looks up each book's loan on its own, one query per book under a Query.all: an N+1 on
-- purpose. alder-tui's live test opens this page to see the dev panel report it.
Show.load : Show.Params -> Session -> Query Model
Show.load params session = {
  let found <- Db.get Book params.id
  let books <-
    Db.from Book
      |> Db.orderBy Book.title.asc
      |> Db.all
  let loans <-
    Query.all (
      List.map (\b ->
        Db.from Loan
          |> Db.where (Loan.book.eq b.id)
          |> Db.first
      ) books
    )
  match found {
    Just book -> Query.succeed {
      book: book,
      shelf: List.map2 (\b l -> { book: b, lent: Maybe.isJust l }) books loans,
    },
    Nothing -> Query.notFound,
  }
}

Show.view : Model -> Session -> Html
Show.view model session =
  <Layout.Page title={model.book.title}>
    <h1>{model.book.title}</h1>
    <p id="author">{model.book.author}</p>
    <h2>On the shelf</h2>
    <ul id="shelf">
      {for s in model.shelf ->
        <li class={if s.lent then "lent" else ""}>
          <a href={Show { id: s.book.id }}>{s.book.title}</a>
          {if s.lent then " (lent)" else ""}
        </li>}
    </ul>
    <a href={Books.Index.Index {}}>Back</a>
  </Layout.Page>

test "the page shows the book and marks the lent ones" = {
  let _ <- Db.insert Loan { book: Book.BookId "2" }
  let r <- Test.open (Show { id: Book.BookId "1" })
  Task.succeed (
    {
      answer: r.answer,
      author: Test.text "#author" r.doc,
      lent: Test.texts "li.lent a" r.doc,
    } == {
      answer: Shown,
      author: Just "George Eliot",
      lent: ["Bleak House"],
    }
  )
}

test "a missing book is not found" = {
  let r <- Test.open (Show { id: Book.BookId "missing" })
  Task.succeed (r.answer == PageMissing)
}
