module Layout

import Theme

-- Shell is every page's frame: a header with the two app-wide controls (each a small form that
-- posts an App message), then the page's heading and content.
Shell : { heading: Text, theme: Theme.Theme, children: List (Html a) } -> Html a
Shell props =
  <html>
    <head>
      <meta charset="utf-8" />
      <title>{props.heading}</title>
    </head>
    <body class={if Theme.isDark props.theme then "page dark" else "page"}>
      <header>
        <Controls theme={props.theme} />
      </header>
      <h1>{props.heading}</h1>
      <div class="content">{props.children}</div>
    </body>
  </html>

Controls : { theme: Theme.Theme } -> Html a
Controls props =
  <div class="controls">
    <form submit={App.SwitchTheme}>
      <button id="theme">{if Theme.isDark props.theme then "Switch to light" else "Switch to dark"}</button>
    </form>
    <form submit={App.Logout}>
      <button>Log out</button>
    </form>
  </div>
