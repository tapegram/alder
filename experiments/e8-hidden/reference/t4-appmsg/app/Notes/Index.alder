module Notes.Index

import Note
import User
import Theme
import Layout

page "/" { } requires user

type Model = { notes: List Note }

load : Params -> Session -> Query Model
load params session = {
  let notes <-
    Db.from Note
      |> Db.where (Note.owner.eq session.user)
      |> Db.orderBy Note.created.desc
      |> Db.all
  Query.succeed { notes: notes }
}

form NewNote = {
  title: Text.NonEmpty,
  body: Text,
}

msg Add form NewNote

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  Add p -> {
    let _ <- Db.insert Note { title: p.form.title, body: p.form.body, owner: session.user }
    Task.succeed (Redirect (Notes.Index {}))
  },
}

view : Model -> Session -> Html Msg
view model session =
  <Layout.Page title="Notes" theme={session.theme}>
    <h1>Notes</h1>

    <form submit={Add}>
      <Errors form />
      <Input field="title" label="Title" />
      <Errors field="title" />
      <Textarea field="body" label="Body" />
      <Errors field="body" />
      <button>Add note</button>
    </form>

    <ul id="notes">
      {for note in model.notes ->
        <li><a class="title" href={Notes.Show { id: note.id }}>{note.title}</a></li>}
    </ul>
  </Layout.Page>

test "the theme flips through the page's button" = {
  let me <- Db.insert User { email: Text.Email "me@example.com", name: Text.NonEmpty "Me", passwordHash: "" }
  let _ <- Test.login { user: Just me }
  let before <- Test.get (Notes.Index {})
  let once <- Test.click App.SwitchTheme
  let twice <- Test.click App.SwitchTheme
  Task.succeed ({ before: Test.has "body.dark" before.doc, once: once.session.theme, dark: Test.has "body.dark" once.doc, twice: twice.session.theme, light: Test.has "body.dark" twice.doc } == { before: False, once: Dark, dark: True, twice: Light, light: False })
}

test "adding a note" = {
  let me <- Db.insert User { email: Text.Email "me@example.com", name: Text.NonEmpty "Me", passwordHash: "" }
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Notes.Index {})
  let r <- Test.submit NewNote { title: Text.NonEmpty "Milk", body: "" }
  Task.succeed ({ answer: r.answer, titles: Test.texts "#notes .title" r.doc } == { answer: Redirected (Notes.Index {}), titles: ["Milk"] })
}
