module User

type UserId = brand Text

type Role = Staff | Manager

table User {
  id: UserId @id,
  email: Text.Email @unique,
  name: Text.NonEmpty,
  passwordHash: Text,
  role: Role = Staff,
  created: Time @created,
}

-- isManager is whether the user with that id exists and is a Manager.
isManager : UserId -> Query Bool
isManager id = {
  let found <- Db.get User id
  Query.succeed (match found {
    Just u -> u.role == Manager,
    Nothing -> False,
  })
}
