module Notes.Show

import Note
import User
import Layout

page "/notes/{id}" { id: Note.NoteId } requires user

type Model = { note: Note }

-- Another user's note is a 404, the same answer as an id that was never used.
load : Params -> Session -> Query Model
load params session = {
  let found <- Note.owned params.id session.user
  match found {
    Just note -> Query.succeed { note: note },
    Nothing -> Query.notFound,
  }
}

view : Model -> Session -> Html Msg
view model session =
  <Layout.Page title={model.note.title}>
    <h1 id="title">{model.note.title}</h1>
    <p id="body">{model.note.body}</p>
    <a href={Notes.Index {}}>All notes</a>
    <button click={App.Logout}>Log out</button>
  </Layout.Page>

test "another user's note is not found" = {
  let me <- Db.insert User { email: Text.Email "me@example.com", name: Text.NonEmpty "Me", passwordHash: "" }
  let other <- Db.insert User { email: Text.Email "other@example.com", name: Text.NonEmpty "Other", passwordHash: "" }
  let id <- Db.insert Note { title: Text.NonEmpty "Mine", body: "", owner: me }
  let _ <- Test.login { user: Just other }
  let r <- Test.open (Notes.Show { id: id })
  Task.succeed (r.answer == PageMissing)
}
