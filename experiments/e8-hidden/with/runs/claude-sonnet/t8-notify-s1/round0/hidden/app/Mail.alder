module Mail

type SentId = brand Text

capability Mailer {
  send : { to: Text.Email, subject: Text, body: Text } -> Task Unit,
}

fake Mailer {
  table Sent {
    id: SentId @id,
    to: Text.Email,
    subject: Text,
    body: Text,
  }

  send args = {
    let _ <- Db.insert Sent { to: args.to, subject: args.subject, body: args.body }
    Task.succeed ()
  }
}
