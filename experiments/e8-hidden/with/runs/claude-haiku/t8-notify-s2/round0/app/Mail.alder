module Mail

type SentId = brand Text

-- Sending email is outside the language: a capability implemented in Go (adapters/mail/).
capability Mailer {
  send : { to: Text.Email, subject: Text, body: Text } -> Task Unit,
}

-- In a test, `Test.fake Mailer` puts this in the adapter's place: each email is kept as a row
-- of its own table, so a test can read what was sent.
fake Mailer {
  table Sent {
    id: SentId @id,
    to: Text.Email,
    subject: Text,
    body: Text,
  }

  send args = {
    let _ <- Db.insert Sent { to: args.to, subject: args.subject, body: args.body }
    Task.succeed ()
  }
}
