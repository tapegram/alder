module Profile

import Todo
import User
import Layout

page "/profile" { } requires user

type Model = {
  user: User,
  todoStats: { total: Int, done: Int },
}

load : Params -> Session -> Query Model
load params session = {
  let user <- Db.get User session.user
  let todos <- Db.from Todo |> Db.where (Todo.owner.eq session.user) |> Db.all
  let total = List.length todos
  let done = List.length (List.filter (\t -> t.done) todos)
  Query.succeed { user: user, todoStats: { total: total, done: done } }
}

form UpdateName = {
  name: Text.NonEmpty,
}

msg Save form UpdateName

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  Save p -> {
    let _ <- Db.update User session.user (\u -> { u | name: p.form.name })
    Task.succeed Rerender
  },
}

view : Model -> Session -> Html Msg
view model session =
  <Layout.Page title="Profile" theme={session.theme}>
    <h1>Profile</h1>
    <p>Name: {model.user.name}</p>
    <p>Email: {model.user.email}</p>
    <p>Todos: {Text.fromInt model.todoStats.total} ({Text.fromInt model.todoStats.done} done)</p>
    <form submit={Save}>
      <Input field="name" label="Name" />
      <Errors field="name" />
      <button>Update</button>
    </form>
  </Layout.Page>
