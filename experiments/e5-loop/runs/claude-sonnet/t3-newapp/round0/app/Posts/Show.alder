module Posts.Show

import Post
import Comment
import Layout

page "/posts/{slug}" { slug: Post.Slug }

type Model = { post: Post, comments: List Comment }

load : Params -> Session -> Query Model
load params session = {
  let found <- Db.from Post |> Db.where (Post.slug.eq params.slug) |> Db.first
  match found {
    Just post ->
      if post.published || session.user == Just post.author then {
        let comments <-
          Db.from Comment
            |> Db.where (Comment.post.eq post.id)
            |> Db.orderBy Comment.created.asc
            |> Db.all
        Query.succeed { post: post, comments: comments }
      } else Query.notFound,
    Nothing -> Query.notFound,
  }
}

form NewComment = {
  author: Text.NonEmpty,
  body: Text.NonEmpty,
}

msg Submit { post: Post.PostId } form NewComment

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  Submit p -> {
    let _ <- Db.insert Comment { post: p.post, author: p.form.author, body: p.form.body }
    Task.succeed (Redirect (Posts.Show { slug: model.post.slug }))
  },
}

view : Model -> Session -> Html Msg
view model session =
  <Layout.Page title={model.post.title}>
    <article>
      <h1>{model.post.title}</h1>
      {if model.post.published then Html.none else <p class="draft">Draft</p>}
      <p class="date">{Time.format "Jan 2, 2006" model.post.created}</p>
      <div>{model.post.body}</div>
    </article>

    <section id="comments">
      <h2>Comments</h2>
      {if List.isEmpty model.comments then <p>No comments yet.</p> else <ul>
        {for c in model.comments ->
          <li>
            <strong>{c.author}</strong>
            <span class="date">{Time.format "Jan 2, 2006" c.created}</span>
            <p>{c.body}</p>
          </li>}
      </ul>}
    </section>

    <form submit={Submit { post: model.post.id }}>
      <Errors form />
      <Input field="author" label="Your name" />
      <Errors field="author" />
      <Textarea field="body" label="Comment" />
      <Errors field="body" />
      <button>Add comment</button>
    </form>

    <a href={Home {}}>Back</a>
  </Layout.Page>
