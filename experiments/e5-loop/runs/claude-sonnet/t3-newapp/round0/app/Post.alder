module Post

import User

type PostId = brand Text

type Slug = brand Text where Text.matches "^[a-z0-9-]+$"

table Post {
  id: PostId @id,
  title: Text.NonEmpty,
  slug: Slug @unique,
  body: Text.NonEmpty,
  published: Bool = False,
  author: User.UserId @ref User,
  created: Time @created,
}

status : Post -> Text
status post = if post.published then "Published" else "Draft"

test "status of a draft" =
  status { id: PostId "a", title: Text.NonEmpty "t", slug: Slug "t", body: Text.NonEmpty "b", published: False, author: User.UserId "u", created: Time.epoch } == "Draft"
