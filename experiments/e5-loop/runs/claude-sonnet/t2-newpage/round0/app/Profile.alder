module Profile

import User
import Todo
import Layout

page "/profile" { } requires user

type Model = {
  user: User,
  todos: List Todo,
}

load : Params -> Session -> Query Model
load params session = {
  let found <- Db.get User session.user
  let todos <-
    Db.from Todo
      |> Db.where (Todo.owner.eq session.user)
      |> Db.all
  match found {
    Just user -> Query.succeed { user: user, todos: todos },
    Nothing -> Query.notFound,
  }
}

form NewName = {
  name: Text.NonEmpty,
}

msg Save form NewName

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  Save p -> {
    let _ <- Db.update User session.user (\u -> { u | name: p.form.name })
    Task.succeed Rerender
  },
}

doneCount : List Todo -> Int
doneCount todos = todos |> List.filter (\t -> t.done) |> List.length

view : Model -> Session -> Html Msg
view model session =
  <Layout.Page title="Profile" theme={session.theme}>
    <h1>Profile</h1>

    <p id="identity">
      <span>{model.user.name}</span>
      <span>{model.user.email}</span>
    </p>

    <p id="counts">{Text.fromInt (List.length model.todos)} todos, {Text.fromInt (doneCount model.todos)} done</p>

    <form submit={Save}>
      <Errors form />
      <Input field="name" label="Name" value={model.user.name} />
      <Errors field="name" />
      <button>Save</button>
    </form>

    -- Logout is an app-level msg (App.Logout), not a Login-page msg, and any page may send it.
    <button click={App.Logout}>Log out</button>
    <a href={Todos.Index {}}>Back</a>
  </Layout.Page>
