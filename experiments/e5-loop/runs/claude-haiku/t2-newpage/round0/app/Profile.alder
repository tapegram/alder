module Profile

import User
import Todo
import Layout

page "/profile" { } requires user

type Model = {
  user: User,
  total: Int,
  completed: Int,
}

load : Params -> Session -> Query Model
load params session = {
  let found <- Db.get User session.user
  let total <- Db.from Todo |> Db.where (Todo.owner.eq session.user) |> Db.count
  let completed <- Db.from Todo |> Db.where (Todo.owner.eq session.user) |> Db.where (Todo.done.eq True) |> Db.count
  match found {
    Just user -> Query.succeed { user: user, total: total, completed: completed },
    Nothing -> Query.notFound,
  }
}

form EditName = {
  name: Text.NonEmpty,
}

msg SaveName form EditName

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  SaveName p -> {
    let _ <- Db.update User session.user (\u -> { u | name: p.form.name })
    Task.succeed Rerender
  },
}

view : Model -> Session -> Html Msg
view model session =
  <Layout.Page title="Profile" theme={session.theme}>
    <h1>Profile</h1>

    <dl>
      <dt>Name</dt>
      <dd id="name">{model.user.name}</dd>
      <dt>Email</dt>
      <dd id="email">{model.user.email}</dd>
    </dl>

    <p id="counts">{Text.fromInt model.total} todos, {Text.fromInt model.completed} done</p>

    <form submit={SaveName}>
      <Input field="name" label="Name" value={model.user.name} />
      <Errors field="name" />
      <button>Save name</button>
    </form>

    <button click={App.Logout}>Log out</button>
    <a href={Todos.Index {}}>Back</a>
  </Layout.Page>
