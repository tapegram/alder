module Note

import User

type NoteId = brand Text

table Note {
  id: NoteId @id,
  title: Text.NonEmpty,
  body: Text,
  owner: User.UserId @ref User,
  created: Time @created,
}

test "note has id, title, body, owner, created" =
  let n = { id: NoteId "a", title: Text.NonEmpty "x", body: "y", owner: User.UserId "u", created: Time.epoch }
  in n.id == NoteId "a"
