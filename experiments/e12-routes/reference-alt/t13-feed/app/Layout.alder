module Layout

-- The design system's centred column; the feed's own rules in /static/app.css.
Page : { title: Text, children: List Html } -> Html
Page props =
  <html>
    <head>
      <meta charset="utf-8" />
      <title>{props.title}</title>
      <link rel="stylesheet" href={Url.external "/static/al/al.css"} />
      <link rel="stylesheet" href={Url.external "/static/app.css"} />
    </head>
    <body>
      <al-page width="narrow">
        <main>
          <al-stack gap="lg">{props.children}</al-stack>
        </main>
      </al-page>
    </body>
  </html>
