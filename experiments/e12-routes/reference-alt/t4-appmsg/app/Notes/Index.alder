module Notes.Index

import Note
import User
import Layout

route Index  = GET  "/"      { }              requires user
route Add    = POST "/notes" { } form NewNote requires user

type Model = { notes: List Note }

Index.load : Index.Params -> Session -> Query Model
Index.load params session = {
  let notes <- Db.from Note |> Db.where (Note.owner.eq session.user) |> Db.orderBy Note.created.desc |> Db.all
  Query.succeed { notes: notes }
}

form NewNote = {
  title: Text.NonEmpty,
  body: Text,
}

Add.update : Add.Params -> Session -> Task Response
Add.update p session = {
  let _ <- Db.insert Note { title: p.form.title, body: p.form.body, owner: session.user }
  Task.succeed (Response.redirect (Index {}))
}

Index.view : Model -> Session -> Html
Index.view model session =
  <Layout.Shell heading="My notes" theme={session.theme}>
    <ul id="notes">
      {for note in model.notes -> <Row note={note} />}
    </ul>
    <section class="new">
      <h2>New note</h2>
      <form submit={Add}>
        <Errors form />
        <Input field="title" label="Title" />
        <Errors field="title" />
        <Textarea field="body" label="Text" />
        <button>Save</button>
      </form>
    </section>
  </Layout.Shell>

Row : { note: Note } -> Html
Row props =
  <li>
    <h3><a class="title" href={Notes.Show.Show { id: props.note.id }}>{props.note.title}</a></h3>
    <small>{Time.format "Jan 2" props.note.created}</small>
  </li>

test "a new note is listed" = {
  let me <- Db.insert User { email: Text.Email "me@example.com", name: Text.NonEmpty "Me", passwordHash: "" }
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Index {})
  let r <- Test.submit (Add {}) { title: Text.NonEmpty "Milk", body: "" }
  Task.succeed (Test.texts "#notes .title" r.doc == ["Milk"] && r.answer == Redirected (Index {}))
}

test "my notes, the newest on top, and nobody else's" = {
  let me <- Db.insert User { email: Text.Email "me@example.com", name: Text.NonEmpty "Me", passwordHash: "" }
  let you <- Db.insert User { email: Text.Email "you@example.com", name: Text.NonEmpty "You", passwordHash: "" }
  let _ <- Db.insert Note { title: Text.NonEmpty "Old", body: "", owner: me }
  let _ <- Db.insert Note { title: Text.NonEmpty "Yours", body: "", owner: you }
  let _ <- Db.insert Note { title: Text.NonEmpty "New", body: "", owner: me }
  let _ <- Test.login { user: Just me }
  let r <- Test.get (Index {})
  Task.succeed (Test.texts "#notes .title" r.doc == ["New", "Old"])
}

test "no user, no list and no new note" = {
  let me <- Db.insert User { email: Text.Email "me@example.com", name: Text.NonEmpty "Me", passwordHash: "" }
  let visit <- Test.open (Index {})
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Index {})
  let _ <- Test.login { user: Nothing }
  let post <- Test.submit (Add {}) { title: Text.NonEmpty "Milk", body: "" }
  let n <- Db.from Note |> Db.count
  Task.succeed (visit.answer == Redirected (Auth.Login.Login {}) && post.answer == Redirected (Auth.Login.Login {}) && n == 0)
}
