module Note

import User

type NoteId = brand Text

table Note {
  id: NoteId @id,
  title: Text.NonEmpty,
  body: Text,
  owner: User.UserId @ref User,
  created: Time @created,
}

-- mine is the query for a user's notes; every page and message starts from it, so a stranger's
-- note is never in reach.
mine : User.UserId -> Select Note
mine user = Db.from Note |> Db.where (Note.owner.eq user)

test "deleting a user who has notes is refused" = {
  let me <- Db.insert User { email: Text.Email "me@example.com", name: Text.NonEmpty "Me", passwordHash: "" }
  let _ <- Db.insert Note { title: Text.NonEmpty "Mine", body: "", owner: me }
  let r <- Test.run (Db.delete User me)
  let notes <- Db.from Note |> Db.count
  Task.succeed ({ ok: Result.toMaybe r.value == Nothing, notes: notes } == { ok: True, notes: 1 })
}
