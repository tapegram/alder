module Products.Index

import User
import Product
import Access
import Layout

route Index  = GET  "/products"             { }                       requires user
route Add    = POST "/products"             { } form NewProduct       requires user
route Toggle = POST "/products/{id}/toggle" { id: Product.ProductId } requires user

type Model = { products: List Product }

Index.load : Index.Params -> Session -> Query Model
Index.load params session = {
  let r <- Access.role session.user
  match r {
    Manager -> {
      let products <- Db.from Product |> Db.orderBy Product.name.asc |> Db.all
      Query.succeed { products: products }
    },
    Staff -> Query.notFound,
  }
}

form NewProduct = {
  name: Text.NonEmpty,
  price: Int.NonNegative,
}

-- The writes see what the page would: the products, for a Manager; a Staff user's post is a 404.
Add.update : Add.Params -> Session -> Task Response
Add.update p session = {
  let _ <- Index.load {} session
  let _ <- Db.insert Product { name: p.form.name, price: p.form.price, active: True }
  Task.succeed (Response.redirect (Index {}))
}

Toggle.update : Toggle.Params -> Session -> Task Response
Toggle.update p session = {
  let model <- Index.load {} session
  match List.find (\x -> x.id == p.id) model.products {
    Just product -> {
      let _ <- Db.update Product product.id (\x -> { x | active: not product.active })
      Task.succeed (Response.redirect (Index {}))
    },
    Nothing -> Task.notFound,
  }
}

Index.view : Model -> Session -> Html
Index.view model session =
  <Layout.Shell heading="Products">
    <table id="products">
      <tr><th>Name</th><th>Price (cents)</th><th>Active</th><th></th></tr>
      {for p in model.products ->
        <tr>
          <td class="name">{p.name}</td>
          <td>{Text.fromInt p.price}</td>
          <td>{if p.active then "yes" else "no"}</td>
          <td><form submit={Toggle { id: p.id }}><button>Toggle</button></form></td>
        </tr>}
    </table>
    <h2>Add a product</h2>
    <form submit={Add}>
      <Errors form />
      <Input field="name" label="Name" />
      <Errors field="name" />
      <Input field="price" label="Price in cents" />
      <Errors field="price" />
      <button>Add</button>
    </form>
  </Layout.Shell>

test "products: login, Managers only, sorted, added active, toggled one at a time" = {
  let staff <- Db.insert User { email: Text.Email "staff@example.com", name: Text.NonEmpty "Staff", passwordHash: "" }
  let boss <- Db.insert User { email: Text.Email "boss@example.com", name: Text.NonEmpty "Boss", passwordHash: "", role: Manager }
  let visitor <- Test.open (Index {})
  let pen <- Db.insert Product { name: Text.NonEmpty "Pen", price: Int.NonNegative 150 }
  let _ <- Test.login { user: Just staff }
  let asStaff <- Test.open (Index {})
  let _ <- Test.login { user: Just boss }
  let _ <- Test.get (Index {})
  let added <- Test.submit (Add {}) { name: Text.NonEmpty "Ink", price: Int.NonNegative 400 }
  let toggled <- Test.click (Toggle { id: pen })
  let all <- Db.from Product |> Db.orderBy Product.name.asc |> Db.all
  Task.succeed ({ visitor: visitor.answer, staff: asStaff.answer, added: added.answer, names: Test.texts "#products .name" added.doc, toggled: toggled.answer, active: List.map (\p -> p.active) all } == { visitor: Redirected (Auth.Login.Login {}), staff: PageMissing, added: Redirected (Index {}), names: ["Ink", "Pen"], toggled: Redirected (Index {}), active: [True, False] })
}

test "a Staff user's add or toggle, or one from a page whose session ended, changes nothing" = {
  let staff <- Db.insert User { email: Text.Email "staff@example.com", name: Text.NonEmpty "Staff", passwordHash: "" }
  let boss <- Db.insert User { email: Text.Email "boss@example.com", name: Text.NonEmpty "Boss", passwordHash: "", role: Manager }
  let pen <- Db.insert Product { name: Text.NonEmpty "Pen", price: Int.NonNegative 150 }
  let add <- Test.run (Add.update { form: { name: Text.NonEmpty "Ink", price: Int.NonNegative 400 } } { user: staff })
  let toggle <- Test.run (Toggle.update { id: pen } { user: staff })
  let _ <- Test.login { user: Just boss }
  let _ <- Test.get (Index {})
  let _ <- Test.login { user: Nothing }
  let heldAdd <- Test.submit (Add {}) { name: Text.NonEmpty "Ink", price: Int.NonNegative 400 }
  let _ <- Test.login { user: Just boss }
  let _ <- Test.get (Index {})
  let _ <- Test.login { user: Nothing }
  let heldToggle <- Test.click (Toggle { id: pen })
  let all <- Db.from Product |> Db.all
  Task.succeed ({ add: add.value, toggle: toggle.value, heldAdd: heldAdd.answer, heldToggle: heldToggle.answer, active: List.map (\p -> p.active) all } == { add: Err "not found", toggle: Err "not found", heldAdd: Redirected (Auth.Login.Login {}), heldToggle: Redirected (Auth.Login.Login {}), active: [True] })
}
