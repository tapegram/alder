module Profile

import Layout
import Table.Todo
import Table.User

route Profile = GET "/profile"      { }               requires user
route Rename  = PUT "/profile/name" { } form NameForm requires user

type Model = {
  name: Text.NonEmpty,
  email: Text.Email,
  total: Int,
  done: Int,
}

-- The user's own row, and counts of their own todos only (`Db.mine`, book 06, "Rules").
Profile.load : Profile.Params -> Session -> Query Model
Profile.load params session = {
  let me <- Db.get User session.user
  let total <- Db.mine Todo |> Db.count
  let done <-
    Db.mine Todo
      |> Db.where (Todo.done.eq True)
      |> Db.count
  match me {
    Just u -> Query.succeed {
      name: u.name,
      email: u.email,
      total: total,
      done: done,
    },
    Nothing -> Query.notFound,
  }
}

-- `Text.NonEmpty`: an empty (or blank) name does not decode, so `update` never runs for it.
form NameForm = { name: Text.NonEmpty }

-- The row changed is always the session's own user: the route takes no id from the request.
Rename.update : Rename.Params -> Session -> Task Response
Rename.update p session = {
  let _ <- Db.update User session.user (\u -> { u | name: p.form.name })
  Task.succeed (Response.redirect (Profile {}) |> Response.success "Name saved")
}

Profile.view : Model -> Session -> Html
Profile.view model session =
  <Layout.Page title="Profile">
    <h1>Profile</h1>

    <al-card>
      <dl>
        <dt>Name</dt>
        <dd id="name">{model.name}</dd>
        <dt>Email</dt>
        <dd id="email">{model.email}</dd>
        <dt>Todos</dt>
        <dd id="total">{Text.fromInt model.total}</dd>
        <dt>Done</dt>
        <dd id="done">{Text.fromInt model.done}</dd>
      </dl>
    </al-card>

    <al-card>
      <form submit={Rename}>
        <al-input field="name" label="Name" value={model.name} />
        <al-button type="submit">Save</al-button>
      </form>
    </al-card>

    <a href={Todos.Index.Index {}}>Back to the list</a>

    -- The app-level route `App.Logout`, sent from this page as from any other.
    <al-button variant="outline" click={App.Logout}>Log out</al-button>
  </Layout.Page>

test "the profile counts only the user's todos" = {
  let me <- Db.insert User {
    email: Text.Email "me@example.com",
    name: Text.NonEmpty "Me",
    passwordHash: "",
  }
  let other <- Db.insert User {
    email: Text.Email "other@example.com",
    name: Text.NonEmpty "Other",
    passwordHash: "",
  }
  let _ <- Db.insert Todo {
    title: Text.NonEmpty "Milk",
    due: Nothing,
    owner: me,
  }
  let _ <- Db.insert Todo {
    title: Text.NonEmpty "Bread",
    done: True,
    due: Nothing,
    owner: me,
  }
  let _ <- Db.insert Todo {
    title: Text.NonEmpty "Eggs",
    due: Nothing,
    owner: me,
  }
  let _ <- Db.insert Todo {
    title: Text.NonEmpty "Tea",
    done: True,
    due: Nothing,
    owner: other,
  }
  let _ <- Db.insert Todo {
    title: Text.NonEmpty "Jam",
    due: Nothing,
    owner: other,
  }
  let _ <- Test.login { user: Just me }
  let page <- Test.get (Profile {})
  Task.succeed (
    {
      total: page.model.total,
      done: page.model.done,
      shownTotal: Test.text "#total" page.doc,
      shownDone: Test.text "#done" page.doc,
      name: Test.text "#name" page.doc,
      email: Test.text "#email" page.doc,
    } == {
      total: 3,
      done: 1,
      shownTotal: Just "3",
      shownDone: Just "1",
      name: Just "Me",
      email: Just "me@example.com",
    }
  )
}

test "renaming changes the user's name" = {
  let me <- Db.insert User {
    email: Text.Email "me@example.com",
    name: Text.NonEmpty "Me",
    passwordHash: "",
  }
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Profile {})
  let r <- Test.submit Rename { name: Text.NonEmpty "New Me" }
  let after <- Db.get User me
  Task.succeed (
    { answer: r.answer, name: Maybe.map (\u -> u.name) after }
      == { answer: Redirected (Profile {}), name: Just (Text.NonEmpty "New Me") }
  )
}

test "renaming to an empty name is refused" = {
  let me <- Db.insert User {
    email: Text.Email "me@example.com",
    name: Text.NonEmpty "Me",
    passwordHash: "",
  }
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Profile {})
  let r <- Test.submitRaw Rename [{ name: "name", value: "" }]
  let after <- Db.get User me
  let rejected = match r.answer {
    FormRejected errors -> True,
    _ -> False,
  }
  Task.succeed (
    {
      rejected: rejected,
      status: r.status,
      name: Maybe.map (\u -> u.name) after,
    } == {
      rejected: True,
      status: 422,
      name: Just (Text.NonEmpty "Me"),
    }
  )
}

test "a visitor is sent to log in from the profile" = {
  let r <- Test.open (Profile {})
  Task.succeed (r.answer == Redirected (Auth.Login.Login {}))
}

test "logging out from the profile" = {
  let me <- Db.insert User {
    email: Text.Email "me@example.com",
    name: Text.NonEmpty "Me",
    passwordHash: "",
  }
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Profile {})
  let out <- Test.click App.Logout
  Task.succeed (
    { answer: out.answer, user: out.session.user }
      == { answer: Redirected (Auth.Login.Login {}), user: Nothing }
  )
}
