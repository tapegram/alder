module Board

import Layout
import Table.Ticket

route Board  = GET "/board"                     { }
route Recent = GET "/board/recent"              { }
route Open   = GET "/board/open"                { }
route Close  = PUT "/board/tickets/{id}/closed" { id: Ticket.TicketId }

type Model = { tickets: List Ticket }

-- The board shows at once: only the pending tickets are read here. The five newest and the
-- badge are filled in after the page shows, by `Recent` and `Open`.
Board.load : Board.Params -> Session -> Query Model
Board.load params session = {
  let tickets <-
    Db.from Ticket
      |> Db.where (Ticket.status.eq Pending)
      |> Db.orderBy Ticket.created.desc
      |> Db.all
  Query.succeed { tickets: tickets }
}

Board.view : Model -> Session -> Html
Board.view model session =
  <Layout.Page title="Board">
    <h1>Board</h1>
    <p>Pending: <span id="open" load={Open {}} every="10s">…</span></p>
    <h2>Newest</h2>
    <section id="recent" load={Recent {}}>Loading…</section>
    <h2>Pending</h2>
    <ul id="pending">
      {for t in model.tickets ->
        <li id={"ticket-" ++ t.id}>
          <span class="title">{t.title}</span>
          <button click={Close { id: t.id }}>Close</button>
        </li>}
    </ul>
  </Layout.Page>

Recent.load : Recent.Params -> Session -> Query (List Ticket)
Recent.load params session =
  Db.from Ticket
    |> Db.orderBy Ticket.created.desc
    |> Db.limit 5
    |> Db.all

Recent.view : List Ticket -> Session -> Html
Recent.view tickets session =
  <section id="recent">
    <ul>{for t in tickets -> <li>{t.title}</li>}</ul>
  </section>

Open.load : Open.Params -> Session -> Query Int
Open.load params session =
  Db.from Ticket
    |> Db.where (Ticket.status.eq Pending)
    |> Db.count

-- The badge renders its own `load` and `every` again: the timer keeps running.
Open.view : Int -> Session -> Html
Open.view n session = <span id="open" load={Open {}} every="10s">{Text.fromInt n}</span>

Close.update : Close.Params -> Session -> Task Response
Close.update p session = {
  let _ <- Db.update Ticket p.id (\t -> { t | status: Closed })
  Task.succeed Response.refresh
}

test "the badge counts the pending tickets, after an add and after a close" = {
  let _ <- Db.insert Ticket { title: Text.NonEmpty "Printer jam" }
  let first <- Db.insert Ticket { title: Text.NonEmpty "Lost password" }
  let _ <- Db.insert Ticket { title: Text.NonEmpty "Old", status: Closed }
  let _ <- Test.get (Board {})
  let before <- Test.load (Open {})
  let _ <- Db.insert Ticket { title: Text.NonEmpty "No coffee" }
  let added <- Test.load (Open {})
  let _ <- Test.click (Close { id: first })
  let closed <- Test.load (Open {})
  Task.succeed (
    {
      before: Test.text "#open" before.doc,
      added: Test.text "#open" added.doc,
      closed: Test.text "#open" closed.doc,
    } == {
      before: Just "2",
      added: Just "3",
      closed: Just "2",
    }
  )
}

test "recent lists the five newest of six, newest first" = {
  let _ <- Db.insert Ticket { title: Text.NonEmpty "One" }
  let _ <- Db.insert Ticket { title: Text.NonEmpty "Two" }
  let _ <- Db.insert Ticket { title: Text.NonEmpty "Three" }
  let _ <- Db.insert Ticket { title: Text.NonEmpty "Four", status: Closed }
  let _ <- Db.insert Ticket { title: Text.NonEmpty "Five" }
  let _ <- Db.insert Ticket { title: Text.NonEmpty "Six" }
  let _ <- Test.get (Board {})
  let r <- Test.load (Recent {})
  Task.succeed (Test.texts "#recent li" r.doc == ["Six", "Five", "Four", "Three", "Two"])
}

test "recent shows no item when there are no tickets" = {
  let _ <- Test.get (Board {})
  let r <- Test.load (Recent {})
  Task.succeed (Test.count "#recent li" r.doc == 0)
}

test "closing a ticket through its button refreshes the board and closes it" = {
  let id <- Db.insert Ticket { title: Text.NonEmpty "Printer jam" }
  let _ <- Db.insert Ticket { title: Text.NonEmpty "Lost password" }
  let _ <- Test.get (Board {})
  let r <- Test.click (Close { id: id })
  let after <- Db.get Ticket id
  Task.succeed (
    {
      answer: r.answer,
      status: Maybe.map (\t -> t.status) after,
      pending: Test.texts "#pending .title" r.doc,
    } == {
      answer: Refreshed,
      status: Just Closed,
      pending: ["Lost password"],
    }
  )
}
