module Pantry.Index

import Layout
import Table.Item

route Index  = GET    "/pantry"             { }
route Row    = GET    "/pantry/items/{id}"  { id: Item.ItemId }
route Rename = PUT    "/pantry/items/{id}"  { id: Item.ItemId } form NewName
route Bump   = PATCH  "/pantry/items/{id}"  { id: Item.ItemId }
route Remove = DELETE "/pantry/items/{id}"  { id: Item.ItemId }

form NewName = { name: Text.NonEmpty }

Index.load : Index.Params -> Session -> Query (List Item)
Index.load params session =
  Db.from Item
    |> Db.orderBy Item.name.asc
    |> Db.all

Index.view : List Item -> Session -> Html
Index.view items session =
  <Layout.Page title="Pantry">
    <h1>Pantry</h1>
    <ul id="items">{for item in items -> Row.view item session}</ul>
  </Layout.Page>

Row.load : Row.Params -> Session -> Query Item
Row.load params session = {
  let found <- Db.get Item params.id
  match found {
    Just item -> Query.succeed item,
    Nothing -> Query.notFound,
  }
}

Row.view : Item -> Session -> Html
Row.view item session =
  <li id={"item-" ++ item.id}>
    <span class="name">{item.name}</span>
    <span class="quantity">{Text.fromInt item.quantity}</span>
    <form submit={Rename { id: item.id }}>
      <Errors form />
      <al-input field="name" label="New name" value={item.name} />
      <al-button type="submit">Rename</al-button>
    </form>
    <al-button variant="secondary" size="sm" click={Bump { id: item.id }}>Add one</al-button>
    <al-button variant="destructive" size="sm" click={Remove { id: item.id }}>Remove</al-button>
  </li>

Rename.update : Rename.Params -> Session -> Task Response
Rename.update p session = {
  let others <-
    Db.from Item
      |> Db.where (Item.name.eq p.form.name)
      |> Db.where (Item.id.ne p.id)
      |> Db.count
  if others > 0 then
    Task.succeed (Response.invalid "name already taken")
  else {
    let _ <- Db.update Item p.id (\i -> { i | name: p.form.name })
    Task.succeed (Response.redirect (Index {}))
  }
}

Bump.update : Bump.Params -> Session -> Task Response
Bump.update p session = {
  let _ <- Db.update Item p.id (\i -> { i | quantity: i.quantity + 1 })
  Task.succeed (Response.render (Row { id: p.id }))
}

Remove.update : Remove.Params -> Session -> Task Response
Remove.update p session = {
  let _ <- Db.delete Item p.id
  Task.succeed (Response.refresh |> Response.toast "Removed")
}

test "renaming to another item's name is refused" = {
  let a <- Db.insert Item { name: Text.NonEmpty "Rice", quantity: 2 }
  let _ <- Db.insert Item { name: Text.NonEmpty "Flour", quantity: 1 }
  let _ <- Test.get (Index {})
  let r <- Test.submit (Rename { id: a }) { name: Text.NonEmpty "Flour" }
  let after <- Db.get Item a
  Task.succeed (
    { answer: r.answer, name: Maybe.map (\i -> i.name) after }
      == {
        answer: FormRejected [{ field: "", message: "name already taken" }],
        name: Just (Text.NonEmpty "Rice"),
      }
  )
}

test "renaming to a free name is stored" = {
  let a <- Db.insert Item { name: Text.NonEmpty "Rice", quantity: 2 }
  let _ <- Test.get (Index {})
  let r <- Test.submit (Rename { id: a }) { name: Text.NonEmpty "Brown rice" }
  let after <- Db.get Item a
  Task.succeed (
    { answer: r.answer, name: Maybe.map (\i -> i.name) after }
      == { answer: Redirected (Index {}), name: Just (Text.NonEmpty "Brown rice") }
  )
}

test "renaming an item to its own name is allowed" = {
  let a <- Db.insert Item { name: Text.NonEmpty "Rice", quantity: 2 }
  let _ <- Test.get (Index {})
  let r <- Test.submit (Rename { id: a }) { name: Text.NonEmpty "Rice" }
  Task.succeed (r.answer == Redirected (Index {}))
}

test "adding one renders the item's row" = {
  let a <- Db.insert Item { name: Text.NonEmpty "Rice", quantity: 3 }
  let _ <- Test.get (Index {})
  let r <- Test.click (Bump { id: a })
  Task.succeed (
    { answer: r.answer, quantity: Test.text ".quantity" r.doc }
      == { answer: Rendered (Row { id: a }), quantity: Just "4" }
  )
}

test "removing an item drops it and shows the toast" = {
  let a <- Db.insert Item { name: Text.NonEmpty "Rice", quantity: 3 }
  let _ <- Test.get (Index {})
  let r <- Test.click (Remove { id: a })
  let after <- Db.get Item a
  Task.succeed (
    {
      answer: r.answer,
      rows: Test.count "#items > li" r.doc,
      notices: r.notices,
      item: Maybe.map (\i -> i.name) after,
    } == {
      answer: Refreshed,
      rows: 0,
      notices: ["Removed"],
      item: Nothing,
    }
  )
}
