module Profile

import Layout
import Table.Todo
import Table.User

route Show   = GET "/profile" { }                requires user
route Rename = PUT "/profile" { } form NewName   requires user

type Model = { user: User, total: Int, done: Int }

Show.load : Show.Params -> Session -> Query Model
Show.load params session = {
  let found <- Db.get User session.user
  let total <- Db.mine Todo |> Db.count
  let done <-
    Db.mine Todo
      |> Db.where (Todo.done.eq True)
      |> Db.count
  match found {
    Just u -> Query.succeed { user: u, total: total, done: done },
    Nothing -> Query.notFound,
  }
}

form NewName = { name: Text.NonEmpty }

-- The id is the session's user, never a request parameter, so only one's own name can change.
Rename.update : Rename.Params -> Session -> Task Response
Rename.update p session = {
  let _ <- Db.update User session.user (\u -> { u | name: p.form.name })
  Task.succeed (Response.redirect (Show {}) |> Response.success "Name changed")
}

Show.view : Model -> Session -> Html
Show.view model session =
  <Layout.Page title="Profile">
    <h1>Profile</h1>

    <al-card>
      <dl id="details">
        <dt>Name</dt>
        <dd id="user-name">{model.user.name}</dd>
        <dt>Email</dt>
        <dd id="user-email">{model.user.email}</dd>
        <dt>Todos</dt>
        <dd id="todo-total">{Text.fromInt model.total}</dd>
        <dt>Done</dt>
        <dd id="todo-done">{Text.fromInt model.done}</dd>
      </dl>
    </al-card>

    <al-card>
      <form submit={Rename}>
        <al-input field="name" label="Name" value={model.user.name} />
        <al-button type="submit">Change name</al-button>
      </form>
    </al-card>

    <a href={Todos.Index.Index {}}>Back to the todos</a>

    <al-button variant="outline" click={App.Logout}>Log out</al-button>
  </Layout.Page>

test "the profile counts only the user's own todos" = {
  let me <- Db.insert User {
    email: Text.Email "me@example.com",
    name: Text.NonEmpty "Me",
    passwordHash: "",
  }
  let other <- Db.insert User {
    email: Text.Email "other@example.com",
    name: Text.NonEmpty "Other",
    passwordHash: "",
  }
  let _ <- Db.insert Todo {
    title: Text.NonEmpty "Milk",
    done: True,
    due: Nothing,
    owner: me,
  }
  let _ <- Db.insert Todo {
    title: Text.NonEmpty "Bread",
    due: Nothing,
    owner: me,
  }
  let _ <- Db.insert Todo {
    title: Text.NonEmpty "Eggs",
    done: True,
    due: Nothing,
    owner: other,
  }
  let _ <- Test.login { user: Just me }
  let page <- Test.get (Show {})
  Task.succeed (
    {
      total: page.model.total,
      done: page.model.done,
      name: Test.text "#user-name" page.doc,
      email: Test.text "#user-email" page.doc,
      shown: Test.text "#todo-total" page.doc,
    } == {
      total: 2,
      done: 1,
      name: Just "Me",
      email: Just "me@example.com",
      shown: Just "2",
    }
  )
}

test "renaming changes the user's name" = {
  let me <- Db.insert User {
    email: Text.Email "me@example.com",
    name: Text.NonEmpty "Me",
    passwordHash: "",
  }
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Show {})
  let r <- Test.submit (Rename {}) { name: Text.NonEmpty "Newname" }
  let after <- Db.get User me
  Task.succeed (
    { answer: r.answer, name: Maybe.map (\u -> u.name) after }
      == { answer: Redirected (Show {}), name: Just (Text.NonEmpty "Newname") }
  )
}

test "renaming to an empty name is refused" = {
  let me <- Db.insert User {
    email: Text.Email "me@example.com",
    name: Text.NonEmpty "Me",
    passwordHash: "",
  }
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Show {})
  let r <- Test.submitRaw (Rename {}) [{ name: "name", value: "" }]
  let after <- Db.get User me
  Task.succeed (
    { answer: r.answer, name: Maybe.map (\u -> u.name) after }
      == {
        answer: FormRejected [{ field: "name", message: "must not be empty" }],
        name: Just (Text.NonEmpty "Me"),
      }
  )
}

test "a visitor is sent to log in from the profile" = {
  let r <- Test.open (Show {})
  Task.succeed (r.answer == Redirected (Auth.Login.Login {}))
}
