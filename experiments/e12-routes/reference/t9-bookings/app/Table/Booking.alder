module Table.Booking

import Table.Room
import Table.User

type BookingId = brand Text

table Booking {
  id: BookingId @id,
  room: Room.RoomId @ref Room,
  owner: User.UserId @ref User,
  from: Date,
  to: Date,
}

holds : Date -> Booking -> Bool
holds = \d b -> b.from <= d && d < b.to

overlaps : Date -> Date -> Booking -> Bool
overlaps = \from to b -> from < b.to && b.from < to

nextFree : Date -> List Booking -> Date
nextFree = \today bookings -> {
  let candidates = [today] ++ List.map (\b -> b.to) bookings
  let free = List.filter (\c -> c >= today && not (List.any (holds c) bookings)) candidates
  List.head (List.sortBy (\c -> Date.diffDays today c) free) ?? today
}

test "a Booking keeps its room from being deleted" = {
  let today <- Date.today
  let target <- Db.insert Room { name: Text.NonEmpty "name-1" }
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
  }
  let _ <- Db.insert Booking {
    room: target,
    owner: me,
    from: today,
    to: today,
  }
  let r <- Test.run (Db.delete Room target)
  let left <- Db.from Booking |> Db.count
  Task.succeed ({ deleted: Result.toMaybe r.value, left: left } == { deleted: Nothing, left: 1 })
}

test "a Booking keeps its owner from being deleted" = {
  let today <- Date.today
  let target <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
  }
  let room1 <- Db.insert Room { name: Text.NonEmpty "name-1" }
  let _ <- Db.insert Booking {
    room: room1,
    owner: target,
    from: today,
    to: today,
  }
  let r <- Test.run (Db.delete User target)
  let left <- Db.from Booking |> Db.count
  Task.succeed ({ deleted: Result.toMaybe r.value, left: left } == { deleted: Nothing, left: 1 })
}

test "the next free date after back-to-back bookings" = {
  let today <- Date.today
  let free = nextFree today [
    {
      id: BookingId "a",
      room: Room.RoomId "r",
      owner: User.UserId "u",
      from: today,
      to: Date.addDays 2 today,
    },
    {
      id: BookingId "b",
      room: Room.RoomId "r",
      owner: User.UserId "u",
      from: Date.addDays 2 today,
      to: Date.addDays 5 today,
    },
    {
      id: BookingId "c",
      room: Room.RoomId "r",
      owner: User.UserId "u",
      from: Date.addDays 6 today,
      to: Date.addDays 8 today,
    },
    {
      id: BookingId "d",
      room: Room.RoomId "r",
      owner: User.UserId "u",
      from: Date.addDays (-9) today,
      to: Date.addDays (-4) today,
    },
  ]
  let later = nextFree today [
    {
      id: BookingId "e",
      room: Room.RoomId "r",
      owner: User.UserId "u",
      from: Date.addDays 3 today,
      to: Date.addDays 4 today,
    },
  ]
  Task.succeed ({ free: free, later: later } == { free: Date.addDays 5 today, later: today })
}
