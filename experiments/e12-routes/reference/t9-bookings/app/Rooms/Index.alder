module Rooms.Index

import Layout
import Table.Booking
import Table.Room
import Table.User

route Index = GET "/rooms" { } requires user

type Model = {
  today: Date,
  rooms: List Room,
  bookings: List Booking,
}

Index.load : Index.Params -> Session -> Query Model
Index.load params session = {
  let today <- Date.today
  let rooms <-
    Db.from Room
      |> Db.orderBy Room.name.asc
      |> Db.all
  let bookings <- Db.from Booking |> Db.all
  Query.succeed {
    today: today,
    rooms: rooms,
    bookings: bookings,
  }
}

Index.view : Model -> Session -> Html
Index.view model session =
  <Layout.Page title="Rooms">
    <h1>Rooms</h1>
    <ul id="rooms">
      {for r in model.rooms ->
        <li>
          <a class="name" href={Rooms.Show.Show { id: r.id }}>{r.name}</a>
          {" "}
          <span class="free">
            {Date.toText (
              Booking.nextFree model.today (List.filter (\b -> b.room == r.id) model.bookings)
            )}
          </span>
        </li>}
    </ul>
    <a href={Bookings.Index.Index {}}>My bookings</a>
    <al-button variant="outline" click={App.Logout}>Log out</al-button>
  </Layout.Page>

test "a visitor is sent to log in" = {
  let r <- Test.open (Index {})
  Task.succeed (r.answer == Redirected (Auth.Login.Login {}))
}

test "rooms are listed by name with their next free date" = {
  let today <- Date.today
  let me <- Db.insert User {
    email: Text.Email "me@example.com",
    name: Text.NonEmpty "Me",
    passwordHash: "",
  }
  let red <- Db.insert Room { name: Text.NonEmpty "Red" }
  let blue <- Db.insert Room { name: Text.NonEmpty "Blue" }
  let _ <- Db.insert Room { name: Text.NonEmpty "Green" }
  let _ <- Db.insert Booking {
    room: blue,
    owner: me,
    from: today,
    to: Date.addDays 2 today,
  }
  let _ <- Db.insert Booking {
    room: blue,
    owner: me,
    from: Date.addDays 2 today,
    to: Date.addDays 4 today,
  }
  let _ <- Db.insert Booking {
    room: red,
    owner: me,
    from: Date.addDays 1 today,
    to: Date.addDays 3 today,
  }
  let _ <- Test.login { user: Just me }
  let page <- Test.get (Index {})
  Task.succeed (
    { names: Test.texts "#rooms li .name" page.doc, free: Test.texts "#rooms li .free" page.doc }
      == {
        names: ["Blue", "Green", "Red"],
        free: [Date.toText (Date.addDays 4 today), Date.toText today, Date.toText today],
      }
  )
}
