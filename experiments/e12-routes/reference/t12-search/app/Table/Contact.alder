module Table.Contact

import Table.User

type ContactId = brand Text

-- A contact belongs to the user who added it (`owner`, the table's `@owner`): the pages read it
-- with `Db.mine Contact`, so another user's contacts never reach them.
table Contact {
  id: ContactId @id,
  name: Text.NonEmpty,
  email: Text.Email,
  owner: User.UserId @ref User @owner,
}

-- `owner` is `@ref User` with the default rule, `@restrict`: a user who still has contacts cannot
-- be deleted, and the contacts stay.
test "a user with contacts cannot be deleted" = {
  let me <- Db.insert User { email: Text.Email "me@example.com", name: Text.NonEmpty "Me", passwordHash: "" }
  let id <- Db.insert Contact { name: Text.NonEmpty "Ann", email: Text.Email "ann@example.com", owner: me }
  let r <- Test.run (Db.delete User me)
  let after <- Db.get Contact id
  Task.succeed ({ deleted: Result.toMaybe r.value, contact: Maybe.map (\c -> c.name) after } == { deleted: Nothing, contact: Just (Text.NonEmpty "Ann") })
}
