module Projects.Index

import Layout
import Table.Membership
import Table.Org
import Table.Project
import Table.User

route Index  = GET  "/projects" { }                 requires user, org
route Create = POST "/projects" { } form NewProject requires user, org

type Model = { org: Text, projects: List Project }

Index.load : Index.Params -> Session -> Query Model
Index.load params session = {
  let member <- Membership.isMember session.user session.org
  if member then {
    let org <- Db.get Org session.org
    let projects <-
      Db.scoped Project
        |> Db.orderBy Project.name.asc
        |> Db.all
    Query.succeed { org: Maybe.withDefault "" (Maybe.map (\o -> o.name) org), projects: projects }
  } else
    Query.notFound
}

Index.view : Model -> Session -> Html
Index.view model session =
  <Layout.Page title={model.org}>
    <h1 id="org">{model.org}</h1>
    <ul id="projects">
      {for p in model.projects ->
        <li><a class="name" href={Projects.Show.Show { id: p.id }}>{p.name}</a></li>}
    </ul>
    <a href={Orgs.Index.Index {}}>Orgs</a>

    <al-card>
      <h2 slot="header">New project</h2>
      <form submit={Create}>
        <al-input field="name" label="Name" />
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">New project</al-button>
      </form>
    </al-card>
  </Layout.Page>

form NewProject = { name: Text.NonEmpty }

Create.update : Create.Params -> Session -> Task Response
Create.update params session = {
  let member <- Membership.isMember session.user session.org
  if member then {
    let id <- Db.insertScoped Project { name: params.form.name }
    Task.succeed (Response.redirect (Projects.Show.Show { id: id }))
  } else
    Task.notFound
}

test "a visitor is sent to log in" = {
  let r <- Test.open (Index {})
  Task.succeed (r.answer == Redirected (Auth.Login.Login {}))
}

test "without an org the page sends you to choose one" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
  }
  let _ <- Test.login { user: Just me, org: Nothing }
  let r <- Test.open (Index {})
  Task.succeed (r.answer == Redirected (Orgs.Index.Index {}))
}

test "submitting NewProject adds a row" = {
  let bob <- Db.insert User {
    email: Text.Email "bob@example.com",
    name: Text.NonEmpty "Bob",
    passwordHash: "",
  }
  let acme <- Db.insert Org { name: Text.NonEmpty "Acme" }
  let globex <- Db.insert Org { name: Text.NonEmpty "Globex" }
  let _ <- Test.member bob acme
  let _ <- Test.member bob globex
  let _ <- Db.insert Project { name: Text.NonEmpty "Widget", org: globex }
  let _ <- Test.login { user: Just bob, org: Just acme }
  let _ <- Test.get (Index {})
  let r <- Test.submit Create { name: Text.NonEmpty "Zephyr" }
  let made <- Db.scoped Project |> Db.all
  let mine <- Test.get (Index {})
  let _ <- Test.login { user: Just bob, org: Just globex }
  let theirs <- Test.get (Index {})
  Task.succeed (
    {
      answers: List.map (\x -> Redirected (Projects.Show.Show { id: x.id })) made,
      org: Test.text "#org" mine.doc,
      acme: Test.texts "#projects .name" mine.doc,
      globex: Test.texts "#projects .name" theirs.doc,
    } == {
      answers: [r.answer],
      org: Just "Acme",
      acme: ["Zephyr"],
      globex: ["Widget"],
    }
  )
}

test "NewProject refuses an empty name" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
  }
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org }
  let _ <- Test.get (Index {})
  let r <- Test.submitRaw Create [{ name: "name", value: "" }]
  let rows <- Db.from Org |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows }
      == { answer: FormRejected [{ field: "name", message: "must not be empty" }], rows: 1 }
  )
}

test "a visitor cannot submit NewProject" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
  }
  let org <- Db.insert Org { name: Text.NonEmpty "name-1" }
  let _ <- Test.member me org
  let _ <- Test.login { user: Just me, org: Just org }
  let _ <- Test.get (Index {})
  let _ <- Test.login { user: Nothing, org: Nothing }
  let r <- Test.submit Create { name: Text.NonEmpty "name-1" }
  let rows <- Db.from Org |> Db.count
  Task.succeed (
    { answer: r.answer, rows: rows } == { answer: Redirected (Auth.Login.Login {}), rows: 1 }
  )
}

test "a member sees only the projects of their org, by name" = {
  let ann <- Db.insert User {
    email: Text.Email "ann@example.com",
    name: Text.NonEmpty "Ann",
    passwordHash: "",
  }
  let acme <- Db.insert Org { name: Text.NonEmpty "Acme" }
  let globex <- Db.insert Org { name: Text.NonEmpty "Globex" }
  let _ <- Test.member ann acme
  let _ <- Db.insert Project { name: Text.NonEmpty "Rocket", org: acme }
  let _ <- Db.insert Project { name: Text.NonEmpty "Apollo", org: acme }
  let _ <- Db.insert Project { name: Text.NonEmpty "Widget", org: globex }
  let _ <- Test.login { user: Just ann, org: Just acme }
  let page <- Test.get (Index {})
  Task.succeed (Test.texts "#projects .name" page.doc == ["Apollo", "Rocket"])
}

test "a member removed from the org loses access at once" = {
  let ann <- Db.insert User {
    email: Text.Email "ann@example.com",
    name: Text.NonEmpty "Ann",
    passwordHash: "",
  }
  let acme <- Db.insert Org { name: Text.NonEmpty "Acme" }
  let row <- Db.insert Membership { user: ann, org: acme }
  let _ <- Test.login { user: Just ann, org: Just acme }
  let before <- Test.open (Index {})
  let _ <- Db.delete Membership row
  let after <- Test.open (Index {})
  let create <-
    Test.run (Create.update { form: { name: Text.NonEmpty "Late" } } { user: ann, org: acme })
  let made <- Db.scoped Project |> Db.count
  Task.succeed (
    {
      before: before.answer,
      after: after.answer,
      made: made,
    } == {
      before: Shown,
      after: PageMissing,
      made: 0,
    }
  )
}
