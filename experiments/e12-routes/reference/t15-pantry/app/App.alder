module App

import Layout

-- The pantry has no users: the server keeps nothing for a visitor.
session { }

error : Error -> Html
error err =
  <Layout.Page title="Error">
    <h1>Something went wrong</h1>
    <p>Please try again.</p>
  </Layout.Page>

notFound : Html
notFound =
  <Layout.Page title="Not found">
    <h1>Not found</h1>
  </Layout.Page>
