module Pantry.Index

import Table.Item
import Layout

route Index  = GET    "/pantry"                 { }
route Row    = GET    "/pantry/items/{id}"      { id: Item.ItemId }
route Rename = POST   "/pantry/items/{id}/name" { id: Item.ItemId } form NewName
route Bump   = PATCH  "/pantry/items/{id}"      { id: Item.ItemId }
route Remove = DELETE "/pantry/items/{id}"      { id: Item.ItemId }

form NewName = {
  name: Text.NonEmpty,
}

Index.load : Index.Params -> Session -> Query (List Item)
Index.load params session = Db.from Item |> Db.orderBy Item.name.asc |> Db.all

Index.view : List Item -> Session -> Html
Index.view items session =
  <Layout.Page title="Pantry">
    <h1>Pantry</h1>
    <ul id="items">{for item in items -> Row.view item session}</ul>
  </Layout.Page>

Row.load : Row.Params -> Session -> Query Item
Row.load params session = {
  let found <- Db.get Item params.id
  match found {
    Just item -> Query.succeed item,
    Nothing -> Query.notFound,
  }
}

-- One item: its name and quantity, a button to add one, a button to remove it, and a form to
-- rename it. `Bump` answers with this view alone.
Row.view : Item -> Session -> Html
Row.view item session =
  <li id={"item-" ++ item.id}>
    <span class="name">{item.name}</span>
    <span class="quantity">{Text.fromInt item.quantity}</span>
    <button click={Bump { id: item.id }}>+1</button>
    <button click={Remove { id: item.id }}>Remove</button>
    <form submit={Rename { id: item.id }}>
      <Errors form />
      <Input field="name" label="New name" />
      <Errors field="name" />
      <button>Rename</button>
    </form>
  </li>

-- Another item already has the name: refused, nothing stored. The item's own name is not taken.
Rename.update : Rename.Params -> Session -> Task Response
Rename.update p session = {
  let taken <- Db.from Item |> Db.where (Item.name.eq p.form.name) |> Db.where (Item.id.ne p.id) |> Db.count
  if taken > 0 then
    Task.succeed (Response.invalid "name already taken")
  else {
    let _ <- Db.update Item p.id (\i -> { i | name: p.form.name })
    Task.succeed (Response.redirect (Index {}))
  }
}

Bump.update : Bump.Params -> Session -> Task Response
Bump.update p session = {
  let _ <- Db.update Item p.id (\i -> { i | quantity: i.quantity + 1 })
  Task.succeed (Response.render (Row { id: p.id }))
}

Remove.update : Remove.Params -> Session -> Task Response
Remove.update p session = {
  let _ <- Db.delete Item p.id
  Task.succeed (Response.refresh |> Response.toast "Removed")
}

test "the pantry lists every item by name, with its quantity" = {
  let _ <- Db.insert Item { name: Text.NonEmpty "Rice", quantity: 2 }
  let _ <- Db.insert Item { name: Text.NonEmpty "Beans", quantity: 5 }
  let _ <- Db.insert Item { name: Text.NonEmpty "Oats", quantity: 0 }
  let r <- Test.get (Index {})
  Task.succeed ({ names: Test.texts "#items .name" r.doc, quantities: Test.texts "#items .quantity" r.doc, rows: Test.count "#items > li" r.doc } == { names: ["Beans", "Oats", "Rice"], quantities: ["5", "0", "2"], rows: 3 })
}

test "an empty pantry lists nothing" = {
  let r <- Test.get (Index {})
  Task.succeed (Test.count "#items > li" r.doc == 0)
}

test "a row is one item's li" = {
  let rice <- Db.insert Item { name: Text.NonEmpty "Rice", quantity: 2 }
  let r <- Test.get (Row { id: rice })
  Task.succeed (r.doc == Test.doc (Row.view { id: rice, name: Text.NonEmpty "Rice", quantity: 2 } {}))
}

test "a missing row is not found" = {
  let rice <- Db.insert Item { name: Text.NonEmpty "Rice", quantity: 2 }
  let _ <- Db.delete Item rice
  let r <- Test.open (Row { id: rice })
  Task.succeed (r.answer == PageMissing)
}

test "renaming to a taken name is refused and stores nothing" = {
  let rice <- Db.insert Item { name: Text.NonEmpty "Rice", quantity: 2 }
  let beans <- Db.insert Item { name: Text.NonEmpty "Beans", quantity: 5 }
  let _ <- Test.get (Index {})
  let r <- Test.submit (Rename { id: beans }) { name: Text.NonEmpty "Rice" }
  let stored <- Db.get Item beans
  Task.succeed ({ answer: r.answer, status: r.status, stored: Maybe.map (\i -> i.name) stored, names: Test.texts "#items .name" r.doc } == { answer: FormRejected [{ field: "", message: "name already taken" }], status: 422, stored: Just (Text.NonEmpty "Beans"), names: ["Beans", "Rice"] })
}

test "renaming to a free name stores it and goes back to the pantry" = {
  let rice <- Db.insert Item { name: Text.NonEmpty "Rice", quantity: 2 }
  let _ <- Db.insert Item { name: Text.NonEmpty "Beans", quantity: 5 }
  let _ <- Test.get (Index {})
  let r <- Test.submit (Rename { id: rice }) { name: Text.NonEmpty "Arborio" }
  let stored <- Db.get Item rice
  Task.succeed ({ answer: r.answer, stored: stored, names: Test.texts "#items .name" r.doc } == { answer: Redirected (Index {}), stored: Just { id: rice, name: Text.NonEmpty "Arborio", quantity: 2 }, names: ["Arborio", "Beans"] })
}

test "an item may keep its own name" = {
  let rice <- Db.insert Item { name: Text.NonEmpty "Rice", quantity: 2 }
  let _ <- Test.get (Index {})
  let r <- Test.submit (Rename { id: rice }) { name: Text.NonEmpty "Rice" }
  Task.succeed (r.answer == Redirected (Index {}))
}

test "an empty name is refused" = {
  let rice <- Db.insert Item { name: Text.NonEmpty "Rice", quantity: 2 }
  let _ <- Test.get (Index {})
  let r <- Test.submitRaw (Rename { id: rice }) [{ name: "name", value: "" }]
  let stored <- Db.get Item rice
  let rejected = match r.answer {
    FormRejected errors -> List.any (\e -> e.field == "name") errors,
    _ -> False,
  }
  Task.succeed ({ rejected: rejected, stored: Maybe.map (\i -> i.name) stored } == { rejected: True, stored: Just (Text.NonEmpty "Rice") })
}

test "bump adds one to that item only and renders its row" = {
  let rice <- Db.insert Item { name: Text.NonEmpty "Rice", quantity: 2 }
  let beans <- Db.insert Item { name: Text.NonEmpty "Beans", quantity: 5 }
  let _ <- Test.get (Index {})
  let _ <- Test.click (Bump { id: rice })
  let r <- Test.click (Bump { id: rice })
  let after <- Db.from Item |> Db.orderBy Item.name.asc |> Db.all
  Task.succeed ({ answer: r.answer, quantities: Test.texts "#items .quantity" r.doc, stored: List.map (\i -> i.quantity) after } == { answer: Rendered (Row { id: rice }), quantities: ["5", "4"], stored: [5, 4] })
}

test "remove deletes that item only, refreshes and says so" = {
  let rice <- Db.insert Item { name: Text.NonEmpty "Rice", quantity: 2 }
  let _ <- Db.insert Item { name: Text.NonEmpty "Beans", quantity: 5 }
  let _ <- Test.get (Index {})
  let r <- Test.click (Remove { id: rice })
  let left <- Db.from Item |> Db.all
  Task.succeed ({ answer: r.answer, notices: r.notices, names: Test.texts "#items .name" r.doc, left: List.map (\i -> i.name) left } == { answer: Refreshed, notices: ["Removed"], names: ["Beans"], left: [Text.NonEmpty "Beans"] })
}
