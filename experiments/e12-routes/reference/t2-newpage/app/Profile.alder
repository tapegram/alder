module Profile

import Layout
import Table.Todo
import Table.User

route Show   = GET   "/profile" { }             requires user
route Rename = PATCH "/profile" { } form NewName requires user

type Model = { name: Text.NonEmpty, email: Text.Email, todos: Int, done: Int }

Show.load : Show.Params -> Session -> Query Model
Show.load params session = {
  let found <- Db.get User session.user
  let todos <- Db.mine Todo |> Db.count
  let done <- Db.mine Todo |> Db.where (Todo.done.eq True) |> Db.count
  match found {
    Just u -> Query.succeed { name: u.name, email: u.email, todos: todos, done: done },
    Nothing -> Query.notFound,
  }
}

form NewName = { name: Text.NonEmpty }

Rename.update : Rename.Params -> Session -> Task Response
Rename.update p session = {
  let _ <- Db.update User session.user (\u -> { u | name: p.form.name })
  Task.succeed (Response.redirect (Show {}))
}

Show.view : Model -> Session -> Html
Show.view model session =
  <Layout.Page title="Profile">
    <h1>Profile</h1>
    <al-card>
      <p id="name">{model.name}</p>
      <p id="email">{model.email}</p>
      <p id="counts">{Text.fromInt model.todos} todos, {Text.fromInt model.done} done</p>
    </al-card>
    <al-card>
      <form submit={Rename}>
        <Errors form />
        <al-input field="name" label="Name" value={model.name} />
        <al-button type="submit">Rename</al-button>
      </form>
    </al-card>
    <al-button variant="ghost" href={Todos.Index.Index {}}>Back to the list</al-button>
    <al-button variant="outline" click={App.Logout}>Log out</al-button>
  </Layout.Page>

test "load counts only the user's todos" = {
  let me <- Db.insert User {
    email: Text.Email "me@example.com",
    name: Text.NonEmpty "Me",
    passwordHash: "",
  }
  let other <- Db.insert User {
    email: Text.Email "other@example.com",
    name: Text.NonEmpty "Other",
    passwordHash: "",
  }
  let milk <- Db.insert Todo { title: Text.NonEmpty "Milk", due: Nothing, owner: me }
  let _ <- Db.insert Todo { title: Text.NonEmpty "Bread", due: Nothing, owner: me }
  let _ <- Db.insert Todo { title: Text.NonEmpty "Eggs", due: Nothing, owner: other }
  let _ <- Db.insert Todo { title: Text.NonEmpty "Jam", due: Nothing, owner: other }
  let _ <- Db.update Todo milk (\t -> { t | done: True })
  let _ <- Test.login { user: Just me }
  let page <- Test.get (Show {})
  Task.succeed (
    {
      model: page.model,
      counts: Test.text "#counts" page.doc,
    } == {
      model: {
        name: Text.NonEmpty "Me",
        email: Text.Email "me@example.com",
        todos: 2,
        done: 1,
      },
      counts: Just "2 todos, 1 done",
    }
  )
}

test "renaming to an empty name is refused" = {
  let me <- Db.insert User {
    email: Text.Email "me@example.com",
    name: Text.NonEmpty "Me",
    passwordHash: "",
  }
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Show {})
  let r <- Test.submitRaw (Rename {}) [{ name: "name", value: "" }]
  let after <- Db.get User me
  Task.succeed (
    { answer: r.answer, status: r.status, name: Maybe.map (\u -> u.name) after }
      == {
        answer: FormRejected [{ field: "name", message: "must not be empty" }],
        status: 422,
        name: Just (Text.NonEmpty "Me"),
      }
  )
}

test "renaming changes the name" = {
  let me <- Db.insert User {
    email: Text.Email "me@example.com",
    name: Text.NonEmpty "Me",
    passwordHash: "",
  }
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Show {})
  let r <- Test.submit (Rename {}) { name: Text.NonEmpty "Ada" }
  let page <- Test.get (Show {})
  Task.succeed (
    { answer: r.answer, name: Test.text "#name" page.doc }
      == { answer: Redirected (Show {}), name: Just "Ada" }
  )
}

test "a visitor is sent to log in, and the button logs out" = {
  let me <- Db.insert User {
    email: Text.Email "me@example.com",
    name: Text.NonEmpty "Me",
    passwordHash: "",
  }
  let visitor <- Test.open (Show {})
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Show {})
  let out <- Test.click App.Logout
  Task.succeed (
    { visitor: visitor.answer, out: out.answer, user: out.session.user }
      == {
        visitor: Redirected (Auth.Login.Login {}),
        out: Redirected (Auth.Login.Login {}),
        user: Nothing,
      }
  )
}
