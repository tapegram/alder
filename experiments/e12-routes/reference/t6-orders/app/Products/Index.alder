module Products.Index

import User
import Product
import Layout

route Index  = GET   "/products"      { }                    requires user
route Add    = POST  "/products"      { } form NewProduct    requires user
route Toggle = PATCH "/products/{id}" { id: Product.ProductId } requires user

type Model = { products: List Product }

-- Only a Manager may see the products; a Staff user gets the 404 of a page that does not exist.
Index.load : Index.Params -> Session -> Query Model
Index.load params session = {
  let manager <- User.isManager session.user
  if manager then {
    let products <- Db.from Product |> Db.orderBy Product.name.asc |> Db.all
    Query.succeed { products: products }
  } else Query.notFound
}

form NewProduct = {
  name: Text.NonEmpty,
  price: Int.NonNegative,
}

-- No `load` runs before a write route: each one checks the role again, so a Staff user's post
-- is the same 404 as the page.
managerOnly : User.UserId -> Task Unit
managerOnly user = {
  let manager <- User.isManager user
  if manager then Task.succeed () else Task.notFound
}

Add.update : Add.Params -> Session -> Task Response
Add.update p session = {
  let _ <- managerOnly session.user
  let _ <- Db.insert Product { name: p.form.name, price: p.form.price }
  Task.succeed (Response.redirect (Index {}))
}

Toggle.update : Toggle.Params -> Session -> Task Response
Toggle.update p session = {
  let _ <- managerOnly session.user
  let found <- Db.get Product p.id
  match found {
    Just product -> {
      let _ <- Db.update Product product.id (\x -> { x | active: not x.active })
      Task.succeed (Response.redirect (Index {}))
    },
    Nothing -> Task.notFound,
  }
}

Index.view : Model -> Session -> Html
Index.view model session =
  <Layout.Page title="Products">
    <h1>Products</h1>
    <ul id="products">
      {for product in model.products ->
        <li class={if product.active then "active" else "inactive"}>
          <span class="name">{product.name}</span>
          <span class="price">{Text.fromInt product.price}</span>
          <button click={Toggle { id: product.id }}>{if product.active then "Deactivate" else "Activate"}</button>
        </li>}
    </ul>
    <form submit={Add}>
      <Errors form />
      <Input field="name" label="Name" />
      <Errors field="name" />
      <Input field="price" label="Price (cents)" />
      <Errors field="price" />
      <button>Add product</button>
    </form>
    <a href={Orders.Index.Index {}}>Orders</a>
  </Layout.Page>

test "a Staff user does not get the products page" = {
  let staff <- Db.insert User { email: Text.Email "staff@example.com", name: Text.NonEmpty "Staff", passwordHash: "" }
  let _ <- Test.login { user: Just staff }
  let r <- Test.open (Index {})
  Task.succeed (r.answer == PageMissing)
}

test "a visitor is sent to log in from the products" = {
  let r <- Test.open (Index {})
  Task.succeed (r.answer == Redirected (Auth.Login.Login {}))
}

test "a Manager adds a product, sees them by name, and toggles one off and on" = {
  let boss <- Db.insert User { email: Text.Email "boss@example.com", name: Text.NonEmpty "Boss", passwordHash: "", role: Manager }
  let _ <- Db.insert Product { name: Text.NonEmpty "Pen", price: Int.NonNegative 150 }
  let _ <- Test.login { user: Just boss }
  let _ <- Test.get (Index {})
  let added <- Test.submit (Add {}) { name: Text.NonEmpty "Ink", price: Int.NonNegative 400 }
  let found <- Db.from Product |> Db.where (Product.name.eq (Text.NonEmpty "Ink")) |> Db.first
  let ink <- match found {
    Just x -> Task.succeed x,
    Nothing -> Task.fail "no Ink",
  }
  let off <- Test.click (Toggle { id: ink.id })
  let afterOff <- Db.get Product ink.id
  let _ <- Test.click (Toggle { id: ink.id })
  let afterOn <- Db.get Product ink.id
  Task.succeed ({ added: added.answer, names: Test.texts "#products .name" added.doc, price: ink.price, off: off.answer, afterOff: Maybe.map (\p -> p.active) afterOff, afterOn: Maybe.map (\p -> p.active) afterOn } == { added: Redirected (Index {}), names: ["Ink", "Pen"], price: Int.NonNegative 400, off: Redirected (Index {}), afterOff: Just False, afterOn: Just True })
}

-- A Staff user cannot see the page, but anyone can post to a write route: the Staff user's
-- Add and Toggle are not found and change nothing.
test "a Staff user cannot add or toggle a product" = {
  let staff <- Db.insert User { email: Text.Email "staff@example.com", name: Text.NonEmpty "Staff", passwordHash: "" }
  let pen <- Db.insert Product { name: Text.NonEmpty "Pen", price: Int.NonNegative 150 }
  let add <- Test.run (Add.update { form: { name: Text.NonEmpty "Ink", price: Int.NonNegative 400 } } { user: staff })
  let toggle <- Test.run (Toggle.update { id: pen } { user: staff })
  let all <- Db.from Product |> Db.all
  Task.succeed ({ add: add.value, toggle: toggle.value, products: List.map (\p -> { name: p.name, active: p.active }) all } == { add: Err "not found", toggle: Err "not found", products: [{ name: Text.NonEmpty "Pen", active: True }] })
}

-- The products page is still open when the session loses its user: Add and Toggle are sent to
-- log in and change nothing.
test "adding or toggling after logging out is sent to log in" = {
  let boss <- Db.insert User { email: Text.Email "boss@example.com", name: Text.NonEmpty "Boss", passwordHash: "", role: Manager }
  let pen <- Db.insert Product { name: Text.NonEmpty "Pen", price: Int.NonNegative 150 }
  let _ <- Test.login { user: Just boss }
  let _ <- Test.get (Index {})
  let _ <- Test.login { user: Nothing }
  let added <- Test.submit (Add {}) { name: Text.NonEmpty "Ink", price: Int.NonNegative 400 }
  let _ <- Test.login { user: Just boss }
  let _ <- Test.get (Index {})
  let _ <- Test.login { user: Nothing }
  let toggled <- Test.click (Toggle { id: pen })
  let all <- Db.from Product |> Db.all
  Task.succeed ({ added: added.answer, toggled: toggled.answer, products: List.map (\p -> { name: p.name, active: p.active }) all } == { added: Redirected (Auth.Login.Login {}), toggled: Redirected (Auth.Login.Login {}), products: [{ name: Text.NonEmpty "Pen", active: True }] })
}
