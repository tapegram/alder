module Table.Member

import Table.Team
import Table.User

type MemberId = brand Text

table Member {
  id: MemberId @id,
  team: Team.TeamId @ref Team,
  user: User.UserId @ref User,
}

row : Team.TeamId -> User.UserId -> Query (Maybe Member)
row = \team user ->
  Db.from Member
    |> Db.where (Member.team.eq team)
    |> Db.where (Member.user.eq user)
    |> Db.first

test "a Member keeps its team from being deleted" = {
  let me <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
  }
  let target <- Db.insert Team { name: Text.NonEmpty "name-1", owner: me }
  let _ <- Db.insert Member { team: target, user: me }
  let r <- Test.run (Db.delete Team target)
  let left <- Db.from Member |> Db.count
  Task.succeed ({ deleted: Result.toMaybe r.value, left: left } == { deleted: Nothing, left: 1 })
}

test "a Member keeps its user from being deleted" = {
  let target <- Db.insert User {
    email: Text.Email "email-1@example.com",
    name: Text.NonEmpty "name-1",
    passwordHash: "passwordhash-1",
  }
  let me <- Db.insert User {
    email: Text.Email "email-2@example.com",
    name: Text.NonEmpty "name-2",
    passwordHash: "passwordhash-2",
  }
  let team1 <- Db.insert Team { name: Text.NonEmpty "name-1", owner: me }
  let _ <- Db.insert Member { team: team1, user: target }
  let r <- Test.run (Db.delete User target)
  let left <- Db.from Member |> Db.count
  Task.succeed ({ deleted: Result.toMaybe r.value, left: left } == { deleted: Nothing, left: 1 })
}

test "row is the row of the user in that team" = {
  let ann <- Db.insert User {
    email: Text.Email "ann@example.com",
    name: Text.NonEmpty "Ann",
    passwordHash: "",
  }
  let bob <- Db.insert User {
    email: Text.Email "bob@example.com",
    name: Text.NonEmpty "Bob",
    passwordHash: "",
  }
  let red <- Db.insert Team { name: Text.NonEmpty "Red", owner: ann }
  let blue <- Db.insert Team { name: Text.NonEmpty "Blue", owner: ann }
  let _ <- Db.insert Member { team: blue, user: bob }
  let _ <- Db.insert Member { team: red, user: ann }
  let want <- Db.insert Member { team: red, user: bob }
  let found <- row red bob
  Task.succeed (Maybe.map (\m -> m.id) found == Just want)
}
