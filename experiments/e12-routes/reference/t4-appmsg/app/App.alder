module App

import User
import Theme
import Layout

session { user: Maybe User.UserId, theme: Theme.Theme = Light }

login = Auth.Login.Login

-- Both routes act on the session, the visitor's sign-in and theme: `/session` is the sign-in,
-- `/session/theme` the theme in it.
route Logout      = DELETE "/session"       { }
route SwitchTheme = PUT    "/session/theme" { }

Logout.update : Logout.Params -> Session -> Task Response
Logout.update p session = {
  let _ <- Session.put (\s -> { s | user: Nothing })
  Task.succeed (Response.redirect (Auth.Login.Login {}))
}

-- `refresh` goes back to the page the button was on, loaded with the new session.
SwitchTheme.update : SwitchTheme.Params -> Session -> Task Response
SwitchTheme.update p session = {
  let _ <- Session.put (\s -> { s | theme: Theme.flip s.theme })
  Task.succeed Response.refresh
}

error : Error -> Html
error err =
  <Layout.Page title="Error" theme={Light}>
    <h1>Something went wrong</h1>
    <p>Please try again.</p>
  </Layout.Page>

notFound : Html
notFound =
  <Layout.Page title="Not found" theme={Light}>
    <h1>Not found</h1>
  </Layout.Page>

-- Logging out from a page that `requires user` would end at the login page after a refresh
-- too; the session's user tells the two apart.
test "Logout clears the user and goes to log in" = {
  let me <- Db.insert User { email: Text.Email "me@example.com", name: Text.NonEmpty "Me", passwordHash: "" }
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Auth.Login.Login {})
  let r <- Test.click Logout
  Task.succeed ({ answer: r.answer, user: r.session.user } == { answer: Redirected (Auth.Login.Login {}), user: Nothing })
}
