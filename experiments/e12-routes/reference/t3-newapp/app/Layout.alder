module Layout

Page : { title: Text, children: List Html } -> Html
Page props =
  <html>
    <head>
      <meta charset="utf-8" />
      <title>{props.title}</title>
      <link rel="stylesheet" href={Url.external "/static/app.css"} />
    </head>
    <body>
      <header><a href={Posts.Index.Index {}}>Blog</a></header>
      <main>{props.children}</main>
    </body>
  </html>
