module Layout

Page : { title: Text, children: List (Html a) } -> Html a
Page props =
  <html>
    <head>
      <meta charset="utf-8" />
      <title>{props.title}</title>
    </head>
    <body>
      <header>
        <a href={Url.external "/"}>My blog</a>
      </header>
      <main>{props.children}</main>
    </body>
  </html>
