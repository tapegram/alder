module Profile

import Todo
import Layout
import User

page "/profile" { } requires user

type Model = {
  me: User,
  total: Int,
  done: Int,
}

load : Params -> Session -> Query Model
load params session = {
  let found <- Db.get User session.user
  let total <- Db.mine Todo |> Db.count
  let done <- Db.mine Todo |> Db.where (Todo.done.eq True) |> Db.count
  match found {
    Just u -> Query.succeed { me: u, total: total, done: done },
    Nothing -> Query.notFound,
  }
}

form NewName = {
  name: Text.NonEmpty,
}

msg Save form NewName

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  Save p -> {
    let _ <- Db.update User model.me.id (\u -> { u | name: p.form.name })
    Task.succeed (Redirect (Profile {}))
  },
}

view : Model -> Session -> Html Msg
view model session =
  <Layout.Page title="Profile">
    <h1>Profile</h1>

    <al-card>
      <p>Name: <span id="name">{model.me.name}</span></p>
      <p>Email: <span id="email">{model.me.email}</span></p>
      <p><span id="total">{Text.fromInt model.total}</span> todos, <span id="done">{Text.fromInt model.done}</span> done</p>
    </al-card>

    <al-card>
      <form submit={Save}>
        <al-input field="name" label="Name" value={model.me.name} />
        <al-button type="submit">Change name</al-button>
      </form>
    </al-card>

    <al-button variant="ghost" href={Todos.Index {}}>Back</al-button>
    <al-button variant="outline" click={App.Logout}>Log out</al-button>
  </Layout.Page>

test "load counts only the user's todos" = {
  let me <- Db.insert User { email: Text.Email "me@example.com", name: Text.NonEmpty "Me", passwordHash: "" }
  let other <- Db.insert User { email: Text.Email "other@example.com", name: Text.NonEmpty "Other", passwordHash: "" }
  let _ <- Db.insert Todo { title: Text.NonEmpty "Milk", done: True, due: Nothing, owner: me }
  let _ <- Db.insert Todo { title: Text.NonEmpty "Bread", done: False, due: Nothing, owner: me }
  let _ <- Db.insert Todo { title: Text.NonEmpty "Eggs", done: True, due: Nothing, owner: other }
  let _ <- Db.insert Todo { title: Text.NonEmpty "Tea", done: False, due: Nothing, owner: other }
  let _ <- Db.insert Todo { title: Text.NonEmpty "Jam", done: False, due: Nothing, owner: other }
  let _ <- Test.login { user: Just me }
  let page <- Test.get (Profile {})
  Task.succeed ({ total: page.model.total, done: page.model.done, shownTotal: Test.text "#total" page.doc, shownDone: Test.text "#done" page.doc } == { total: 2, done: 1, shownTotal: Just "2", shownDone: Just "1" })
}

test "the page shows the name and email" = {
  let me <- Db.insert User { email: Text.Email "me@example.com", name: Text.NonEmpty "Me", passwordHash: "" }
  let _ <- Test.login { user: Just me }
  let page <- Test.get (Profile {})
  Task.succeed ({ name: Test.text "#name" page.doc, email: Test.text "#email" page.doc } == { name: Just "Me", email: Just "me@example.com" })
}

test "renaming changes the name" = {
  let me <- Db.insert User { email: Text.Email "me@example.com", name: Text.NonEmpty "Me", passwordHash: "" }
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Profile {})
  let r <- Test.submit NewName { name: Text.NonEmpty "Ann" }
  let after <- Db.get User me
  Task.succeed ({ answer: r.answer, name: Maybe.map (\u -> u.name) after } == { answer: Redirected (Profile {}), name: Just (Text.NonEmpty "Ann") })
}

test "renaming to an empty name is refused" = {
  let me <- Db.insert User { email: Text.Email "me@example.com", name: Text.NonEmpty "Me", passwordHash: "" }
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Profile {})
  let r <- Test.submitRaw NewName [{ name: "name", value: "" }]
  let after <- Db.get User me
  Task.succeed ({ answer: r.answer, name: Maybe.map (\u -> u.name) after } == { answer: FormRejected [{ field: "name", message: "must not be empty" }], name: Just (Text.NonEmpty "Me") })
}

test "a visitor is sent to log in from the profile" = {
  let r <- Test.open (Profile {})
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}
