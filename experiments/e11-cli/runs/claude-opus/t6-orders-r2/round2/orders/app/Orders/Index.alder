module Orders.Index

import Layout
import Line
import Order
import Product
import User

page "/" { } requires user

type Model = { orders: List Order.Order, lines: List Line.Line, products: List Product.Product }

load : Params -> Session -> Query Model
load params session = {
  let orders <- Db.from Order |> Db.where (Order.owner.eq session.user) |> Db.orderBy Order.created.desc |> Db.all
  let lines <- Db.from Line |> Db.where (Line.order.in (List.map (\o -> o.id) orders)) |> Db.all
  let products <- Db.from Product |> Db.all
  Query.succeed { orders: orders, lines: lines, products: products }
}

msg Create

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  Create p -> {
    let id <- Db.insert Order { owner: session.user }
    Task.succeed (Redirect (Orders.Show { id: id }))
  },
}

view : Model -> Session -> Html Msg
view model session =
  <Layout.Page title="Orders">
    <h1>Orders</h1>
    <button click={Create}>New order</button>
    <ul id="orders">
      {for o in model.orders ->
        <li>
          <a href={Orders.Show { id: o.id }}>Order</a>
          <span class="status">{Order.statusLabel o.status}</span>
          <span class="total">{Text.fromInt (Line.total model.products (List.filter (\l -> l.order == o.id) model.lines))}</span>
        </li>}
    </ul>
    <button click={App.Logout}>Log out</button>
  </Layout.Page>

test "a visitor is sent to log in" = {
  let r <- Test.open (Orders.Index {})
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "pressing Create" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1", passwordHash: "passwordhash-1" }
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Orders.Index {})
  let r <- Test.click Create
  let made <- Db.from Order |> Db.first
  let want = match made {
    Just o -> Just (Redirected (Orders.Show { id: o.id })),
    Nothing -> Nothing,
  }
  let after <- Test.get (Orders.Index {})
  Task.succeed ({ answer: Just r.answer, status: Test.text "#status" r.doc, listed: Test.texts "#orders .status" after.doc } == { answer: want, status: Just "Open", listed: ["Open"] })
}
