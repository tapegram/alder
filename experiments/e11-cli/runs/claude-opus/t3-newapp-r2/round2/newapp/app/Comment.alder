module Comment

import Post
import User

type CommentId = brand Text

table Comment {
  id: CommentId @id,
  post: Post.PostId @ref Post @cascade,
  author: Text.NonEmpty,
  body: Text.NonEmpty,
  created: Time @created,
}

test "deleting its post deletes a Comment" = {
  let user1 <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1", passwordHash: "passwordhash-1" }
  let target <- Db.insert Post { title: Text.NonEmpty "title-1", slug: Post.Slug "slug-1", body: "body-1", author: user1 }
  let _ <- Db.insert Comment { post: target, author: Text.NonEmpty "author-1", body: Text.NonEmpty "body-1" }
  let _ <- Db.delete Post target
  let left <- Db.from Comment |> Db.count
  Task.succeed (left == 0)
}
