module Notes.Index

import Layout
import Note
import User

page "/" { page: Int = 1 } requires user

type Model = { rows: List Note, page: Int, pages: Int }

perPage : Int
perPage = 20

-- lastPage bounds `page`, so `(page - 1) * perPage` cannot overflow.
lastPage : Int
lastPage = 1000000

-- load reads one page of the rows, newest first, and how many pages there are.
load : Params -> Session -> Query Model
load params session = {
  let page = Int.clamp { min: 1, max: lastPage } params.page
  let rows <-
    Db.mine Note
      |> Db.orderBy Note.created.desc
      |> Db.limit perPage
      |> Db.offset ((page - 1) * perPage)
      |> Db.all
  let count <- Db.mine Note |> Db.count
  Query.succeed { rows: rows, page: page, pages: Int.max 1 ((count + perPage - 1) / perPage) }
}

form NewNote = {
  title: Text.NonEmpty,
  body: Text,
}

msg Add form NewNote

msg Delete { id: Note.NoteId }

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  Add p -> {
    let _ <- Db.insertMine Note { title: p.form.title, body: p.form.body }
    Task.succeed (Redirect (Notes.Index {}))
  },
  Delete p -> ?delete,
}

view : Model -> Session -> Html Msg
view model session =
  <Layout.Page title="Notes">
    <h1>Notes</h1>

    <al-table>
      <table>
        <thead>
          <tr><th>Title</th><th>Body</th><th>Owner</th><th>Created</th></tr>
        </thead>
        <tbody>
          {for row in model.rows ->
            <tr>
              <td>{row.title}</td>
              <td>{row.body}</td>
              <td>{row.owner}</td>
              <td>{Time.format "Jan 2, 2006" row.created}</td>
            </tr>}
        </tbody>
      </table>
    </al-table>

    <al-pagination role="navigation" aria-label="Pages">
      {if model.page > 1 then <a slot="prev" href={Notes.Index { page: model.page - 1 }} rel="prev">Previous</a> else <span slot="prev" aria-disabled="true">Previous</span>}
      <span>Page {Text.fromInt model.page} of {Text.fromInt model.pages}</span>
      {if model.page < model.pages then <a slot="next" href={Notes.Index { page: model.page + 1 }} rel="next">Next</a> else <span slot="next" aria-disabled="true">Next</span>}
    </al-pagination>

    <al-card>
      <h2 slot="header">New note</h2>
      <form submit={Add}>
        <al-input field="title" label="Title" />
        <al-textarea field="body" label="Body" />
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">New note</al-button>
      </form>
    </al-card>

    <al-button click={Delete { id: ?deleteId }}>Delete</al-button>
  </Layout.Page>

test "the list shows my rows, newest first" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1", passwordHash: "passwordhash-1" }
  let _ <- Test.login { user: Just me }
  let note1 <- Db.insert Note { title: Text.NonEmpty "title-1", body: "body-1", owner: me }
  let note2 <- Db.insert Note { title: Text.NonEmpty "title-2", body: "body-2", owner: me }
  let other <- Db.insert User { email: Text.Email "email-2@example.com", name: Text.NonEmpty "name-2", passwordHash: "passwordhash-2" }
  let note3 <- Db.insert Note { title: Text.NonEmpty "title-3", body: "body-3", owner: other }
  let page <- Test.get (Notes.Index {})
  Task.succeed (List.map (\row -> row.id) page.model.rows == [note2, note1])
}

test "the list has 20 rows a page" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1", passwordHash: "passwordhash-1" }
  let _ <- Test.login { user: Just me }
  let _ <- Task.all (List.map (\n -> Db.insert Note { title: Text.NonEmpty ("title-" ++ Text.fromInt n), body: "body-" ++ Text.fromInt n, owner: me }) (List.range 1 21))
  let other <- Db.insert User { email: Text.Email "email-2@example.com", name: Text.NonEmpty "name-2", passwordHash: "passwordhash-2" }
  let _ <- Task.all (List.map (\n -> Db.insert Note { title: Text.NonEmpty ("title-" ++ Text.fromInt n), body: "body-" ++ Text.fromInt n, owner: other }) (List.range 22 41))
  let first <- Test.get (Notes.Index {})
  let second <- Test.get (Notes.Index { page: 2 })
  Task.succeed ({ first: List.length first.model.rows, second: List.length second.model.rows, pages: Test.texts "al-pagination span" first.doc } == { first: 20, second: 1, pages: ["Previous", "Page 1 of 2"] })
}

test "a visitor is sent to log in" = {
  let r <- Test.open (Notes.Index {})
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "submitting NewNote adds a row" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1", passwordHash: "passwordhash-1" }
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Notes.Index {})
  let r <- Test.submit NewNote { title: Text.NonEmpty "title-1", body: "body-1" }
  let rows <- Db.from Note |> Db.all
  Task.succeed ({ answer: r.answer, rows: List.map (\row -> { title: row.title, body: row.body }) rows } == { answer: Redirected (Notes.Index {}), rows: [{ title: Text.NonEmpty "title-1", body: "body-1" }] })
}

test "NewNote refuses an empty title" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1", passwordHash: "passwordhash-1" }
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Notes.Index {})
  let r <- Test.submitRaw NewNote [{ name: "title", value: "" }, { name: "body", value: "x" }]
  let rows <- Db.from Note |> Db.count
  Task.succeed ({ answer: r.answer, rows: rows } == { answer: FormRejected [{ field: "title", message: "must not be empty" }], rows: 0 })
}

-- Fill ?expected with what pressing Delete must do, so that a test fails when the arm
-- does something else: its answer (`r.answer`: Rerendered, Redirected …) and what it
-- changed (`after`, the row read again), as `{ answer: r.answer, … } == { answer: Rerendered, … }`.
test "pressing Delete" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1", passwordHash: "passwordhash-1" }
  let _ <- Test.login { user: Just me }
  let note1 <- Db.insert Note { title: Text.NonEmpty "title-1", body: "body-1", owner: me }
  let _ <- Test.get (Notes.Index {})
  let r <- Test.click (Delete { id: note1 })
  let after <- Db.get Note note1
  Task.succeed ?expected
}
