module Teams.Index

import Layout
import Member
import Team
import User

page "/teams" { page: Int = 1 } requires user

type Model = { rows: List Team, page: Int, pages: Int }

perPage : Int
perPage = 20

-- lastPage bounds `page`, so `(page - 1) * perPage` cannot overflow.
lastPage : Int
lastPage = 1000000

-- load reads one page of the rows, newest first, and how many pages there are.
load : Params -> Session -> Query Model
load params session = {
  let rows <- Member.teamsFor session.user
  Query.succeed { rows: rows |> List.sortByText (\t -> t.name), page: 1, pages: 1 }
}

form NewTeam = {
  name: Text.NonEmpty,
}

msg Create form NewTeam

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  Create p -> {
    let team <- Team.make session.user p.form.name
    Task.succeed (Redirect (Teams.Show { id: team }))
  },
}

view : Model -> Session -> Html Msg
view model session =
  <Layout.Page title="Teams">
    <h1>Teams</h1>
    <ul id="teams">
      {for team in model.rows ->
        <li><a class="name" href={Teams.Show { id: team.id }}>{team.name}</a></li>}
    </ul>
    <al-card>
      <form submit={Create}>
        <al-input field="name" label="Team name" />
        <al-button type="submit">Create team</al-button>
      </form>
    </al-card>
    <al-button variant="outline" click={App.Logout}>Log out</al-button>
  </Layout.Page>

test "the list shows the rows, newest first" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1", passwordHash: "passwordhash-1" }
  let _ <- Team.make me (Text.NonEmpty "Second")
  let _ <- Team.make me (Text.NonEmpty "First")
  let _ <- Test.login { user: Just me }
  let page <- Test.get (Teams.Index {})
  Task.succeed (Test.texts "#teams .name" page.doc == ["First", "Second"])
}

test "the list has 20 rows a page" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1", passwordHash: "passwordhash-1" }
  let _ <- Test.login { user: Just me }
  let _ <- Task.all (List.map (\n -> Db.insert Team { name: Text.NonEmpty ("name-" ++ Text.fromInt n), owner: me }) (List.range 1 21))
  let first <- Test.get (Teams.Index {})
  let second <- Test.get (Teams.Index { page: 2 })
  Task.succeed ({ first: List.length first.model.rows, second: List.length second.model.rows, pages: Test.texts "al-pagination span" first.doc } == { first: 20, second: 1, pages: ["Previous", "Page 1 of 2"] })
}

test "a visitor is sent to log in" = {
  let r <- Test.open (Teams.Index {})
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "submitting NewTeam" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1", passwordHash: "passwordhash-1" }
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Teams.Index {})
  let r <- Test.submit NewTeam { name: Text.NonEmpty "Red" }
  let page <- Test.get (Teams.Index {})
  let redirected = match r.answer {
    Redirected p -> True,
    _ -> False,
  }
  Task.succeed (redirected && Test.texts "#teams .name" page.doc == ["Red"])
}

test "NewTeam refuses an empty name" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1", passwordHash: "passwordhash-1" }
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Teams.Index {})
  let r <- Test.submitRaw NewTeam [{ name: "name", value: "" }]
  let rejected = match r.answer {
    FormRejected errs -> List.length errs > 0,
    _ -> False,
  }
  Task.succeed rejected
}
