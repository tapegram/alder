module User

type UserId = brand Text

table User {
  id: UserId @id,
  email: Text.Email @unique,
  name: Text.NonEmpty,
  passwordHash: Text,
  created: Time @created,
}

add : Text.Email -> Text.NonEmpty -> Task UserId
add = \email name -> Db.insert User { email: email, name: name, passwordHash: "" }
