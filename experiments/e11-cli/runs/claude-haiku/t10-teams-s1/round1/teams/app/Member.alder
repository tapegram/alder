module Member

import Team
import User

type MemberId = brand Text

table Member {
  id: MemberId @id,
  team: Team.TeamId @ref Team,
  user: User.UserId @ref User,
}

canSee : Team.TeamId -> User.UserId -> Query Bool
canSee = \team user -> {
  let found <- Db.get Team team
  let n <- Db.from Member |> Db.where (Member.team.eq team) |> Db.where (Member.user.eq user) |> Db.count
  Query.succeed (Maybe.withDefault False (Maybe.map (\t -> t.owner == user) found) || n > 0)
}

test "a Member keeps its team from being deleted" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1", passwordHash: "passwordhash-1" }
  let target <- Db.insert Team { name: Text.NonEmpty "name-1", owner: me }
  let _ <- Db.insert Member { team: target, user: me }
  let r <- Test.run (Db.delete Team target)
  let left <- Db.from Member |> Db.count
  Task.succeed ({ deleted: Result.toMaybe r.value, left: left } == { deleted: Nothing, left: 1 })
}

test "a Member keeps its user from being deleted" = {
  let target <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1", passwordHash: "passwordhash-1" }
  let me <- Db.insert User { email: Text.Email "email-2@example.com", name: Text.NonEmpty "name-2", passwordHash: "passwordhash-2" }
  let team1 <- Db.insert Team { name: Text.NonEmpty "name-1", owner: me }
  let _ <- Db.insert Member { team: team1, user: target }
  let r <- Test.run (Db.delete User target)
  let left <- Db.from Member |> Db.count
  Task.succeed ({ deleted: Result.toMaybe r.value, left: left } == { deleted: Nothing, left: 1 })
}
