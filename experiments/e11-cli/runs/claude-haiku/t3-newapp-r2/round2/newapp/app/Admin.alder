module Admin

import Layout
import Post
import User

page "/admin" { page: Int = 1 } requires user

type Model = { rows: List Post, page: Int, pages: Int }

perPage : Int
perPage = 20

-- lastPage bounds `page`, so `(page - 1) * perPage` cannot overflow.
lastPage : Int
lastPage = 1000000

-- load reads one page of the rows, newest first, and how many pages there are.
load : Params -> Session -> Query Model
load params session = {
  let page = Int.clamp { min: 1, max: lastPage } params.page
  let rows <-
    Db.from Post
      |> Db.orderBy Post.created.desc
      |> Db.limit perPage
      |> Db.offset ((page - 1) * perPage)
      |> Db.all
  let count <- Db.from Post |> Db.count
  Query.succeed { rows: rows, page: page, pages: Int.max 1 ((count + perPage - 1) / perPage) }
}

view : Model -> Session -> Html Msg
view model session =
  <Layout.Page title="Admin">
    <h1>Admin</h1>

    <al-table>
      <table>
        <thead>
          <tr><th>Slug</th><th>Title</th><th>Body</th><th>Published</th><th>Author</th><th>Created</th><th>Updated</th></tr>
        </thead>
        <tbody>
          {for row in model.rows ->
            <tr>
              <td>{row.slug}</td>
              <td>{row.title}</td>
              <td>{row.body}</td>
              <td>{if row.published then <al-badge>Yes</al-badge> else <al-badge variant="secondary">No</al-badge>}</td>
              <td>{row.author}</td>
              <td>{Time.format "Jan 2, 2006" row.created}</td>
              <td>{Time.format "Jan 2, 2006" row.updated}</td>
            </tr>}
        </tbody>
      </table>
    </al-table>

    <al-pagination role="navigation" aria-label="Pages">
      {if model.page > 1 then <a slot="prev" href={Admin { page: model.page - 1 }} rel="prev">Previous</a> else <span slot="prev" aria-disabled="true">Previous</span>}
      <span>Page {Text.fromInt model.page} of {Text.fromInt model.pages}</span>
      {if model.page < model.pages then <a slot="next" href={Admin { page: model.page + 1 }} rel="next">Next</a> else <span slot="next" aria-disabled="true">Next</span>}
    </al-pagination>
  </Layout.Page>

test "the list shows the rows, newest first" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1", passwordHash: "passwordhash-1" }
  let _ <- Test.login { user: Just me }
  let post1 <- Db.insert Post { slug: Post.Slug "slug-1", title: Text.NonEmpty "title-1", body: "body-1", author: me }
  let post2 <- Db.insert Post { slug: Post.Slug "slug-2", title: Text.NonEmpty "title-2", body: "body-2", author: me }
  let page <- Test.get (Admin {})
  Task.succeed (List.map (\row -> row.id) page.model.rows == [post2, post1])
}

test "the list has 20 rows a page" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1", passwordHash: "passwordhash-1" }
  let _ <- Test.login { user: Just me }
  let _ <- Task.all (List.map (\n -> Db.insert Post { slug: Post.Slug ("slug-" ++ Text.fromInt n), title: Text.NonEmpty ("title-" ++ Text.fromInt n), body: "body-" ++ Text.fromInt n, author: me }) (List.range 1 21))
  let first <- Test.get (Admin {})
  let second <- Test.get (Admin { page: 2 })
  Task.succeed ({ first: List.length first.model.rows, second: List.length second.model.rows, pages: Test.texts "al-pagination span" first.doc } == { first: 20, second: 1, pages: ["Previous", "Page 1 of 2"] })
}

test "a visitor is sent to log in" = {
  let r <- Test.open (Admin {})
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}
