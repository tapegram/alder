module Invites.Index

import Invite
import Layout
import Member
import Team
import User

page "/invites" { } requires user

type Model = { items: List { id: Invite.InviteId, team: Text } }

load : Params -> Session -> Query Model
load params session = {
  let me <- Db.get User session.user
  match me {
    Nothing -> Query.succeed { items: [] },
    Just u -> {
      let invs <- Db.from Invite |> Db.where (Invite.email.eq u.email) |> Db.where (Invite.status.eq Pending) |> Db.all
      let teams <- Db.from Team |> Db.where (Team.id.in (List.map (\i -> i.team) invs)) |> Db.all
      Query.succeed { items: List.filterMap (\i -> Maybe.map (\t -> { id: i.id, team: t.name }) (List.find (\t -> t.id == i.team) teams)) invs }
    },
  }
}

msg Accept { id: Invite.InviteId }

msg Decline { id: Invite.InviteId }

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  Accept p -> {
    let me <- Db.get User session.user
    match me {
      Nothing -> Task.notFound,
      Just u -> {
        let found <- Db.get Invite p.id
        match found {
          Nothing -> Task.notFound,
          Just i ->
            if i.email != u.email || i.status != Pending then Task.notFound else {
              let existing <- Db.from Member |> Db.where (Member.team.eq i.team) |> Db.where (Member.user.eq session.user) |> Db.count
              let t <- Db.get Team i.team
              let isOwner = Maybe.map (\x -> x.owner == session.user) t == Just True
              let _ <- Db.update Invite i.id (\x -> { x | status: Accepted })
              let _ <- if existing == 0 && not isOwner then Task.map (\x -> ()) (Db.insert Member { team: i.team, user: session.user }) else Task.succeed ()
              Task.succeed (Redirect (Teams.Show { id: i.team }))
            },
        }
      },
    }
  },
  Decline p -> {
    let me <- Db.get User session.user
    match me {
      Nothing -> Task.notFound,
      Just u -> {
        let found <- Db.get Invite p.id
        match found {
          Nothing -> Task.notFound,
          Just i ->
            if i.email != u.email || i.status != Pending then Task.notFound else {
              let _ <- Db.update Invite i.id (\x -> { x | status: Declined })
              Task.succeed (Redirect (Invites.Index {}))
            },
        }
      },
    }
  },
}

view : Model -> Session -> Html Msg
view model session =
  <Layout.Page title="Invites">
    <h1>Invites</h1>
    {viewBody model session}
  </Layout.Page>

viewBody : Model -> Session -> Html Msg
viewBody = \model session ->
  <ul id="invites">
    {for i in model.items ->
      <li>
        <span class="team">{i.team}</span>
        <al-button click={Accept { id: i.id }}>Accept</al-button>
        <al-button variant="outline" click={Decline { id: i.id }}>Decline</al-button>
      </li>}
  </ul>

test "a visitor is sent to log in" = {
  let r <- Test.open (Invites.Index {})
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "pressing Accept" = {
  let ann <- Db.insert User { email: Text.Email "ann@example.com", name: Text.NonEmpty "Ann", passwordHash: "" }
  let bob <- Db.insert User { email: Text.Email "bob@example.com", name: Text.NonEmpty "Bob", passwordHash: "" }
  let team <- Db.insert Team { name: Text.NonEmpty "Red", owner: ann }
  let inv <- Db.insert Invite { team: team, email: Text.Email "bob@example.com" }
  let _ <- Test.login { user: Just bob }
  let _ <- Test.get (Invites.Index {})
  let r <- Test.click (Accept { id: inv })
  let teams <- Test.get (Teams.Index {})
  let show <- Test.open (Teams.Show { id: team })
  Task.succeed ({ answer: r.answer, teams: List.length teams.model.teams, show: show.answer } == { answer: Redirected (Teams.Show { id: team }), teams: 1, show: Shown })
}

test "pressing Decline" = {
  let ann <- Db.insert User { email: Text.Email "ann@example.com", name: Text.NonEmpty "Ann", passwordHash: "" }
  let bob <- Db.insert User { email: Text.Email "bob@example.com", name: Text.NonEmpty "Bob", passwordHash: "" }
  let team <- Db.insert Team { name: Text.NonEmpty "Red", owner: ann }
  let inv <- Db.insert Invite { team: team, email: Text.Email "bob@example.com" }
  let _ <- Test.login { user: Just bob }
  let _ <- Test.get (Invites.Index {})
  let r <- Test.click (Decline { id: inv })
  let teams <- Test.get (Teams.Index {})
  let show <- Test.open (Teams.Show { id: team })
  let again <- Test.get (Invites.Index {})
  Task.succeed ({ answer: r.answer, teams: List.length teams.model.teams, show: show.answer, left: List.length again.model.items } == { answer: Redirected (Invites.Index {}), teams: 0, show: PageMissing, left: 0 })
}
