module Teams.Index

import Layout
import Member
import Team
import User

page "/teams" { } requires user

type Model = { teams: List Team }

load : Params -> Session -> Query Model
load params session = {
  let owned <- Db.from Team |> Db.where (Team.owner.eq session.user) |> Db.all
  let mems <- Db.from Member |> Db.where (Member.user.eq session.user) |> Db.all
  let joined <- Db.from Team |> Db.where (Team.id.in (List.map (\m -> m.team) mems)) |> Db.all
  Query.succeed { teams: List.sortByText (\t -> t.name) (owned ++ joined) }
}

form NewTeam = {
  name: Text.NonEmpty,
}

msg Create form NewTeam

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  Create p -> {
    let id <- Db.insert Team { name: p.form.name, owner: session.user }
    Task.succeed (Redirect (Teams.Show { id: id }))
  },
}

view : Model -> Session -> Html Msg
view model session =
  <Layout.Page title="Teams">
    <h1>Teams</h1>
    {viewBody model session}

    <al-card>
      <h2 slot="header">New team</h2>
      <form submit={Create}>
        <al-input field="name" label="Name" />
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button type="submit">New team</al-button>
      </form>
    </al-card>
  </Layout.Page>

viewBody : Model -> Session -> Html Msg
viewBody = \model session ->
  <ul id="teams">
    {for t in model.teams -> <li><a class="name" href={Teams.Show { id: t.id }}>{t.name}</a></li>}
  </ul>

test "a visitor is sent to log in" = {
  let r <- Test.open (Teams.Index {})
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "submitting NewTeam" = {
  let me <- Db.insert User { email: Text.Email "ann@example.com", name: Text.NonEmpty "Ann", passwordHash: "" }
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Teams.Index {})
  let r <- Test.submit NewTeam { name: Text.NonEmpty "Red" }
  let t <- Db.from Team |> Db.first
  match t {
    Just x -> Task.succeed ({ answer: r.answer, owner: x.owner } == { answer: Redirected (Teams.Show { id: x.id }), owner: me }),
    Nothing -> Task.succeed False,
  }
}

test "NewTeam refuses an empty name" = {
  let me <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1", passwordHash: "passwordhash-1" }
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Teams.Index {})
  let r <- Test.submitRaw NewTeam [{ name: "name", value: "" }]
  Task.succeed (r.answer == FormRejected [{ field: "name", message: "must not be empty" }])
}
