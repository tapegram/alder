module Note

import User

type NoteId = brand Text

table Note {
  id: NoteId @id,
  title: Text.NonEmpty,
  body: Text,
  owner: User.UserId @ref User @owner,
  created: Time @created,
  updated: Time @updated,
}

test "a Note keeps its owner from being deleted" = {
  let target <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1", passwordHash: Text.Secret "passwordhash-1" }
  let _ <- Db.insert Note { title: Text.NonEmpty "title-1", body: "body-1", owner: target }
  let r <- Test.run (Db.delete User target)
  let left <- Db.from Note |> Db.count
  Task.succeed ({ deleted: Result.toMaybe r.value, left: left } == { deleted: Nothing, left: 1 })
}
