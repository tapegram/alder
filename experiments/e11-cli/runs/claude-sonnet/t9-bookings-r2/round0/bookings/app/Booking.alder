module Booking

import Room
import User

type BookingId = brand Text

table Booking {
  id: BookingId @id,
  room: Room.RoomId @ref Room,
  owner: User.UserId @ref User,
  from: Date,
  to: Date,
}

overlaps : Date -> Date -> Booking -> Bool
overlaps = \from to b -> from < b.to && b.from < to

canCancel : Date -> Date -> Bool
canCancel = \today from -> today < from

nextFree : Date -> Room.RoomId -> List Booking -> Date
nextFree = \today room bookings -> bookings
  |> List.filter (\b -> b.room == room)
  |> List.sortByText (\b -> Date.toText b.from)
  |> List.foldl (\b d -> if b.from <= d && d < b.to then b.to else d) today

test "a Booking keeps its room from being deleted" = {
  let today <- Date.today
  let target <- Db.insert Room { name: Text.NonEmpty "name-1" }
  let user1 <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1", passwordHash: "passwordhash-1" }
  let _ <- Db.insert Booking { room: target, owner: user1, from: today, to: today }
  let r <- Test.run (Db.delete Room target)
  let left <- Db.from Booking |> Db.count
  Task.succeed ({ deleted: Result.toMaybe r.value, left: left } == { deleted: Nothing, left: 1 })
}

test "a Booking keeps its owner from being deleted" = {
  let today <- Date.today
  let target <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1", passwordHash: "passwordhash-1" }
  let room1 <- Db.insert Room { name: Text.NonEmpty "name-1" }
  let _ <- Db.insert Booking { room: room1, owner: target, from: today, to: today }
  let r <- Test.run (Db.delete User target)
  let left <- Db.from Booking |> Db.count
  Task.succeed ({ deleted: Result.toMaybe r.value, left: left } == { deleted: Nothing, left: 1 })
}
