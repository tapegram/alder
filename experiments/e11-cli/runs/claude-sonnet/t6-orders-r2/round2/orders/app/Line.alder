module Line

import Order
import Product
import User

type LineId = brand Text

table Line {
  id: LineId @id,
  order: Order.OrderId @ref Order @cascade,
  product: Product.ProductId @ref Product,
  quantity: Int.Positive,
}

priceOf : List Product -> Line -> Int
priceOf = \prods l -> Maybe.withDefault 0 (Maybe.map (\p -> l.quantity * p.price) (List.find (\p -> p.id == l.product) prods))

total : Order.OrderId -> Query Int
total = \id -> {
  let lines <- Db.from Line |> Db.where (Line.order.eq id) |> Db.all
  let prods <- Db.from Product |> Db.all
  Query.succeed (List.sum (List.map (priceOf prods) lines))
}

test "deleting its order deletes a Line" = {
  let user1 <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1", passwordHash: "passwordhash-1" }
  let target <- Db.insert Order { owner: user1 }
  let product1 <- Db.insert Product { name: Text.NonEmpty "name-1", price: Int.NonNegative 1 }
  let _ <- Db.insert Line { order: target, product: product1, quantity: Int.Positive 1 }
  let _ <- Db.delete Order target
  let left <- Db.from Line |> Db.count
  Task.succeed (left == 0)
}

test "a Line keeps its product from being deleted" = {
  let target <- Db.insert Product { name: Text.NonEmpty "name-1", price: Int.NonNegative 1 }
  let user1 <- Db.insert User { email: Text.Email "email-1@example.com", name: Text.NonEmpty "name-1", passwordHash: "passwordhash-1" }
  let order1 <- Db.insert Order { owner: user1 }
  let _ <- Db.insert Line { order: order1, product: target, quantity: Int.Positive 1 }
  let r <- Test.run (Db.delete Product target)
  let left <- Db.from Line |> Db.count
  Task.succeed ({ deleted: Result.toMaybe r.value, left: left } == { deleted: Nothing, left: 1 })
}
