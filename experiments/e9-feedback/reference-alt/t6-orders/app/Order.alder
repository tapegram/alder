module Order

import User

type OrderId = brand Text

type Status = Open | Paid | Cancelled

table Order {
  id: OrderId @id,
  owner: User.UserId @ref User,
  status: Status = Open,
  created: Time @created,
}

test "a user who has orders stays" = {
  let me <- Db.insert User { email: Text.Email "me@example.com", name: Text.NonEmpty "Me", passwordHash: "" }
  let _ <- Db.insert Order { owner: me }
  let r <- Test.run (Db.delete User me)
  let orders <- Db.from Order |> Db.count
  Task.succeed ({ refused: Result.toMaybe r.value == Nothing, orders: orders } == { refused: True, orders: 1 })
}
