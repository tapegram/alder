module App

import User
import Layout

session { user: Maybe User.UserId }

login = Auth.Login

msg Logout

update : Msg -> Session -> Task Nav
update msg session = match msg {
  Logout p -> {
    let _ <- Session.put (\s -> { s | user: Nothing })
    Task.succeed (Redirect (Auth.Login {}))
  },
}

error : Error -> Html Never
error err = <Layout.Shell heading="Something went wrong"><p>Please try again.</p></Layout.Shell>

notFound : Html Never
notFound = <Layout.Shell heading="Not found"><p>There is nothing here.</p></Layout.Shell>

test "Logout empties the session and redirects to the login page" = {
  let r <- Test.run (update Logout { user: Just (User.UserId "u") })
  Task.succeed ({ value: r.value, trace: r.trace } == { value: Ok (Redirect (Auth.Login {})), trace: ["Session.put"] })
}
