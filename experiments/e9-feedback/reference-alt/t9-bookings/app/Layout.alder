module Layout

Shell : { heading: Text, children: List (Html a) } -> Html a
Shell props =
  <html>
    <head>
      <meta charset="utf-8" />
      <title>{props.heading}</title>
    </head>
    <body>
      <header><h1>{props.heading}</h1></header>
      <div class="content">{props.children}</div>
    </body>
  </html>
