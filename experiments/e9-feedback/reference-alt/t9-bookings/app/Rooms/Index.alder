module Rooms.Index

import User
import Room
import Booking
import Layout

page "/rooms" { } requires user

type Model = { today: Date, rooms: List Room, bookings: List Booking }

-- One read of every booking; each room's next free date is worked out in the view's helper.
load : Params -> Session -> Query Model
load params session = {
  let today <- Date.today
  let rooms <- Db.from Room |> Db.orderBy Room.name.asc |> Db.all
  let bookings <- Db.from Booking |> Db.all
  Query.succeed { today: today, rooms: rooms, bookings: bookings }
}

freeFrom : Model -> Room -> Date
freeFrom model room = Booking.firstFree model.today (List.filter (\b -> b.room == room.id) model.bookings)

view : Model -> Session -> Html Msg
view model session =
  <Layout.Shell heading="Rooms">
    <nav><a href={Bookings.Index {}}>My bookings</a> <form submit={App.Logout}><button>Log out</button></form></nav>
    <ol id="rooms">
      {for room in model.rooms ->
        <li>
          <div class="card">
            <h2><a href={Rooms.Show { id: room.id }}><span class="name">{room.name}</span></a></h2>
            <p>Next free day: <time class="free">{Date.toText (freeFrom model room)}</time></p>
          </div>
        </li>}
    </ol>
  </Layout.Shell>

test "rooms by name with their free days, for logged-in users only" = {
  let me <- Db.insert User { email: Text.Email "me@example.com", name: Text.NonEmpty "Me", passwordHash: "" }
  let visitor <- Test.open (Rooms.Index {})
  let today <- Date.today
  let red <- Db.insert Room { name: Text.NonEmpty "Red" }
  let blue <- Db.insert Room { name: Text.NonEmpty "Blue" }
  let _ <- Db.insert Booking { room: blue, owner: me, from: today, to: Date.addDays 3 today }
  let _ <- Test.login { user: Just me }
  let page <- Test.get (Rooms.Index {})
  Task.succeed ({ visitor: visitor.answer, names: Test.texts "#rooms .name" page.doc, free: Test.texts "#rooms .free" page.doc } == { visitor: Redirected (Auth.Login {}), names: ["Blue", "Red"], free: ["2026-01-04", "2026-01-01"] })
}
