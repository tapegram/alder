module Post

import User

type PostId = brand Text
type Slug = brand Text where (\s -> isSlug s)

table Post {
  id: PostId @id,
  slug: Slug @unique,
  title: Text.NonEmpty,
  body: Text,
  author: User.UserId @ref User,
  created: Time @created,
  published: Bool = False,
}

bySlug : Slug -> Query (Maybe Post)
bySlug slug = Db.from Post |> Db.where (Post.slug.eq slug) |> Db.first

-- isSlug is the rule a Slug keeps: lowercase letters, digits and hyphens, at least one.
isSlug : Text -> Bool
isSlug s = Text.matches "^[a-z0-9-]+$" s

test "a slug is lowercase letters, digits and hyphens" =
  List.map isSlug ["hello-world", "post-2", "Hello", "a b", "", "x/y"] == [True, True, False, False, False, False]

test "bySlug finds the post with that slug" = {
  let author <- Db.insert User { email: Text.Email "author@example.com", name: Text.NonEmpty "Author", passwordHash: "" }
  let _ <- Db.insert Post { slug: Slug "a-post", title: Text.NonEmpty "A", body: "", author: author }
  let _ <- Db.insert Post { slug: Slug "b-post", title: Text.NonEmpty "B", body: "", author: author }
  let found <- bySlug (Slug "b-post")
  Task.succeed (Maybe.map (\p -> p.slug) found == Just (Slug "b-post"))
}

-- An author who still has posts cannot be deleted: Post.author is `@ref User` with the default
-- rule, `@restrict`, so the delete is refused and the post stays.
test "an author with posts cannot be deleted" = {
  let author <- Db.insert User { email: Text.Email "author@example.com", name: Text.NonEmpty "Author", passwordHash: "" }
  let _ <- Db.insert Post { slug: Slug "hello", title: Text.NonEmpty "Hello", body: "", author: author }
  let r <- Test.run (Db.delete User author)
  let posts <- Db.from Post |> Db.count
  Task.succeed ({ refused: Result.toMaybe r.value == Nothing, posts: posts } == { refused: True, posts: 1 })
}
