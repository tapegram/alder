module Team

import User

type TeamId = brand Text

table Team {
  id: TeamId @id,
  name: Text.NonEmpty,
  owner: User.UserId @ref User,
}

-- `owner` is `@ref User` with the default rule, `@restrict`: a user who still owns a team cannot
-- be deleted, and the team stays.
test "a user who owns a team cannot be deleted" = {
  let me <- Db.insert User { email: Text.Email "me@example.com", name: Text.NonEmpty "Me", passwordHash: "" }
  let id <- Db.insert Team { name: Text.NonEmpty "Rockets", owner: me }
  let r <- Test.run (Db.delete User me)
  let after <- Db.get Team id
  Task.succeed ({ deleted: Result.toMaybe r.value, team: Maybe.map (\t -> t.name) after } == { deleted: Nothing, team: Just (Text.NonEmpty "Rockets") })
}
