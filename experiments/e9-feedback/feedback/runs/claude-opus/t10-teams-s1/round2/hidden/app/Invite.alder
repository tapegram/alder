module Invite

import Team
import User

type InviteId = brand Text

type Status = Pending | Accepted | Declined

table Invite {
  id: InviteId @id,
  team: Team.TeamId @ref Team,
  email: Text.Email,
  status: Status = Pending,
}

-- `team` is `@ref Team` with the default rule, `@restrict`: a team that still has invites cannot
-- be deleted, and the invites stay.
test "a team with an invite cannot be deleted" = {
  let owner <- Db.insert User { email: Text.Email "olive@example.com", name: Text.NonEmpty "Olive", passwordHash: "" }
  let team <- Db.insert Team { name: Text.NonEmpty "Rockets", owner: owner }
  let invite <- Db.insert Invite { team: team, email: Text.Email "ann@example.com" }
  let r <- Test.run (Db.delete Team team)
  let after <- Db.get Invite invite
  Task.succeed ({ deleted: Result.toMaybe r.value, status: Maybe.map (\i -> i.status) after } == { deleted: Nothing, status: Just Pending })
}
