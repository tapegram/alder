module Invite

import Team
import User

type InviteId = brand Text

type Status = Pending | Accepted | Declined

table Invite {
  id: InviteId @id,
  team: Team.TeamId @ref Team,
  email: Text.Email,
  status: Status = Pending,
}

-- `team` is `@ref Team` with the default rule, `@restrict`: a team with invites cannot be deleted.
test "a team with an invite cannot be deleted" = {
  let owner <- Db.insert User { email: Text.Email "owner@example.com", name: Text.NonEmpty "Owner", passwordHash: "" }
  let team <- Db.insert Team { name: Text.NonEmpty "Alpha", owner: owner }
  let _ <- Db.insert Invite { team: team, email: Text.Email "x@example.com" }
  let r <- Test.run (Db.delete Team team)
  let n <- Db.from Invite |> Db.count
  Task.succeed ({ deleted: Result.toMaybe r.value, invites: n } == { deleted: Nothing, invites: 1 })
}
