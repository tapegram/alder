module User

type UserId = brand Text

type Role = Staff | Manager

table User {
  id: UserId @id,
  email: Text.Email @unique,
  name: Text.NonEmpty,
  passwordHash: Text,
  role: Role = Staff,
  created: Time @created,
}

isManager : Maybe User -> Bool
isManager found = match found {
  Just user -> user.role == Manager,
  Nothing -> False,
}

test "only a Manager is a manager" = {
  let staff = isManager (Just { id: UserId "a", email: Text.Email "a@example.com", name: Text.NonEmpty "A", passwordHash: "", role: Staff, created: Time.epoch })
  let manager = isManager (Just { id: UserId "b", email: Text.Email "b@example.com", name: Text.NonEmpty "B", passwordHash: "", role: Manager, created: Time.epoch })
  let nobody = isManager Nothing
  Task.succeed ({ staff: staff, manager: manager, nobody: nobody } == { staff: False, manager: True, nobody: False })
}
