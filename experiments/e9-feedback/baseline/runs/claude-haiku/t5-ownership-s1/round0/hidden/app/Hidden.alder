module Hidden

-- E8 hidden acceptance tests for T5 (shared notes, each user's own). They use only the names
-- the task's Names block fixes; the model never sees them.

import User
import Note

test "a visitor is sent to log in" = {
  let r <- Test.open (Notes.Index {})
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "the list shows only the logged-in user's notes" = {
  let me <- Db.insert User { email: Text.Email "me@example.com", name: Text.NonEmpty "Me", passwordHash: "" }
  let other <- Db.insert User { email: Text.Email "other@example.com", name: Text.NonEmpty "Other", passwordHash: "" }
  let _ <- Db.insert Note { title: Text.NonEmpty "Mine", body: "mine", owner: me }
  let _ <- Db.insert Note { title: Text.NonEmpty "Theirs", body: "theirs", owner: other }
  let _ <- Test.login { user: Just me }
  let page <- Test.open (Notes.Index {})
  Task.succeed ({ answer: page.answer, items: Test.count "#notes li" page.doc, titles: Test.texts "#notes .title" page.doc } == { answer: Shown, items: 1, titles: ["Mine"] })
}

test "a note added through the form is the user's" = {
  let me <- Db.insert User { email: Text.Email "me@example.com", name: Text.NonEmpty "Me", passwordHash: "" }
  let other <- Db.insert User { email: Text.Email "other@example.com", name: Text.NonEmpty "Other", passwordHash: "" }
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Notes.Index {})
  let added <- Test.submit Notes.Index.NewNote { title: Text.NonEmpty "Milk", body: "Two litres." }
  let mine <- Db.from Note |> Db.where (Note.owner.eq me) |> Db.count
  let _ <- Test.login { user: Just other }
  let theirs <- Test.open (Notes.Index {})
  Task.succeed ({ answer: added.answer, titles: Test.texts "#notes .title" added.doc, mine: mine, theirs: Test.count "#notes li" theirs.doc } == { answer: Redirected (Notes.Index {}), titles: ["Milk"], mine: 1, theirs: 0 })
}

test "the owner opens their note" = {
  let me <- Db.insert User { email: Text.Email "me@example.com", name: Text.NonEmpty "Me", passwordHash: "" }
  let id <- Db.insert Note { title: Text.NonEmpty "Milk", body: "Two litres.", owner: me }
  let _ <- Test.login { user: Just me }
  let r <- Test.open (Notes.Show { id: id })
  Task.succeed ({ answer: r.answer, title: Test.text "#title" r.doc, body: Test.text "#body" r.doc } == { answer: Shown, title: Just "Milk", body: Just "Two litres." })
}

test "another user's note is missing on its page" = {
  let me <- Db.insert User { email: Text.Email "me@example.com", name: Text.NonEmpty "Me", passwordHash: "" }
  let other <- Db.insert User { email: Text.Email "other@example.com", name: Text.NonEmpty "Other", passwordHash: "" }
  let id <- Db.insert Note { title: Text.NonEmpty "Mine", body: "", owner: me }
  let _ <- Test.login { user: Just other }
  let r <- Test.open (Notes.Show { id: id })
  Task.succeed (r.answer == PageMissing)
}

test "the owner deletes a note from the list" = {
  let me <- Db.insert User { email: Text.Email "me@example.com", name: Text.NonEmpty "Me", passwordHash: "" }
  let keep <- Db.insert Note { title: Text.NonEmpty "Keep", body: "", owner: me }
  let gone <- Db.insert Note { title: Text.NonEmpty "Gone", body: "", owner: me }
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Notes.Index {})
  let r <- Test.click (Notes.Index.Delete { id: gone })
  let left <- Db.from Note |> Db.count
  Task.succeed ({ answer: r.answer, titles: Test.texts "#notes .title" r.doc, left: left } == { answer: Redirected (Notes.Index {}), titles: ["Keep"], left: 1 })
}

-- A forged Delete: the owner's page is held (with its Delete buttons), then the cookie becomes a
-- stranger's, so the click posts the owner's id as the stranger. `update` must refuse it.
test "a stranger's Delete, posted from a page the owner held, is missing" = {
  let me <- Db.insert User { email: Text.Email "me@example.com", name: Text.NonEmpty "Me", passwordHash: "" }
  let other <- Db.insert User { email: Text.Email "other@example.com", name: Text.NonEmpty "Other", passwordHash: "" }
  let id <- Db.insert Note { title: Text.NonEmpty "Mine", body: "", owner: me }
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Notes.Index {})
  let _ <- Test.login { user: Just other }
  let r <- Test.click (Notes.Index.Delete { id: id })
  let left <- Db.from Note |> Db.count
  Task.succeed ({ answer: r.answer, left: left } == { answer: PageMissing, left: 1 })
}

test "a Delete of a note deleted meanwhile is missing" = {
  let me <- Db.insert User { email: Text.Email "me@example.com", name: Text.NonEmpty "Me", passwordHash: "" }
  let id <- Db.insert Note { title: Text.NonEmpty "Mine", body: "", owner: me }
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Notes.Index {})
  let _ <- Db.delete Note id
  let r <- Test.click (Notes.Index.Delete { id: id })
  Task.succeed (r.answer == PageMissing)
}
