module Bookings.Index

import User
import Room
import Booking
import Layout

page "/bookings" { } requires user

type Row = { booking: Booking, room: Text }

type Model = { rows: List Row }

load : Params -> Session -> Query Model
load params session = {
  let mine <- Db.from Booking |> Db.where (Booking.owner.eq session.user) |> Db.orderBy Booking.from.asc |> Db.all
  let rows <- Query.all (List.map row mine)
  Query.succeed { rows: rows }
}

row : Booking -> Query Row
row b = {
  let room <- Db.get Room b.room
  Query.succeed { booking: b, room: Maybe.withDefault "" (Maybe.map (\r -> r.name) room) }
}

view : Model -> Session -> Html Msg
view model session =
  <Layout.Page title="My bookings">
    <h1>My bookings</h1>
    <ul id="mine">
      {for r in model.rows ->
        <li>
          <a href={Bookings.Show { id: r.booking.id }}><span class="room">{r.room}</span>, from <span class="from">{Date.toText r.booking.from}</span></a>
        </li>}
    </ul>
    <a href={Rooms.Index {}}>Rooms</a>
  </Layout.Page>

test "the list shows only the user's bookings, by date" = {
  let me <- Db.insert User { email: Text.Email "me@example.com", name: Text.NonEmpty "Me", passwordHash: "" }
  let other <- Db.insert User { email: Text.Email "other@example.com", name: Text.NonEmpty "Other", passwordHash: "" }
  let blue <- Db.insert Room { name: Text.NonEmpty "Blue" }
  let green <- Db.insert Room { name: Text.NonEmpty "Green" }
  let today <- Date.today
  let _ <- Db.insert Booking { room: green, owner: me, from: Date.addDays 4 today, to: Date.addDays 5 today }
  let _ <- Db.insert Booking { room: blue, owner: other, from: Date.addDays 2 today, to: Date.addDays 3 today }
  let _ <- Db.insert Booking { room: blue, owner: me, from: Date.addDays 1 today, to: Date.addDays 2 today }
  let _ <- Test.login { user: Just me }
  let page <- Test.get (Bookings.Index {})
  Task.succeed ({ rooms: Test.texts "#mine .room" page.doc, from: Test.texts "#mine .from" page.doc } == { rooms: ["Blue", "Green"], from: ["2026-01-02", "2026-01-05"] })
}
