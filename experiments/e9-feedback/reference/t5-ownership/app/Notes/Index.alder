module Notes.Index

import Note
import User
import Layout

page "/" { } requires user

type Model = { notes: List Note }

load : Params -> Session -> Query Model
load params session = {
  let notes <-
    Db.from Note
      |> Db.where (Note.owner.eq session.user)
      |> Db.orderBy Note.created.desc
      |> Db.all
  Query.succeed { notes: notes }
}

form NewNote = {
  title: Text.NonEmpty,
  body: Text,
}

msg Add form NewNote
msg Delete { id: Note.NoteId }

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  Add p -> {
    let _ <- Db.insert Note { title: p.form.title, body: p.form.body, owner: session.user }
    Task.succeed (Redirect (Notes.Index {}))
  },
  -- The id comes from the request: anyone can post Delete with another user's id, so update
  -- checks the owner again; a stranger's note and a missing one are both a 404.
  Delete p -> {
    let found <- Note.owned p.id session.user
    match found {
      Just note -> {
        let _ <- Db.delete Note note.id
        Task.succeed (Redirect (Notes.Index {}))
      },
      Nothing -> Task.notFound,
    }
  },
}

view : Model -> Session -> Html Msg
view model session =
  <Layout.Page title="Notes">
    <h1>Notes</h1>

    <form submit={Add}>
      <Errors form />
      <Input field="title" label="Title" />
      <Errors field="title" />
      <Textarea field="body" label="Body" />
      <Errors field="body" />
      <button>Add note</button>
    </form>

    <ul id="notes">
      {for note in model.notes ->
        <li>
          <a class="title" href={Notes.Show { id: note.id }}>{note.title}</a>
          <button click={Delete { id: note.id }}>Delete</button>
        </li>}
    </ul>

    <button click={App.Logout}>Log out</button>
  </Layout.Page>

test "deleting another user's note is not found" = {
  let me <- Db.insert User { email: Text.Email "me@example.com", name: Text.NonEmpty "Me", passwordHash: "" }
  let other <- Db.insert User { email: Text.Email "other@example.com", name: Text.NonEmpty "Other", passwordHash: "" }
  let theirs <- Db.insert Note { title: Text.NonEmpty "Theirs", body: "", owner: other }
  let model <- load {} { user: me }
  let r <- Test.run (update (Delete { id: theirs }) model { user: me })
  let left <- Db.from Note |> Db.count
  Task.succeed ({ value: r.value, left: left } == { value: Err "not found", left: 1 })
}

test "deleting a missing note is not found" = {
  let me <- Db.insert User { email: Text.Email "me@example.com", name: Text.NonEmpty "Me", passwordHash: "" }
  let model <- load {} { user: me }
  let r <- Test.run (update (Delete { id: Note.NoteId "missing" }) model { user: me })
  Task.succeed (r.value == Err "not found")
}

test "the owner deletes a note through the page" = {
  let me <- Db.insert User { email: Text.Email "me@example.com", name: Text.NonEmpty "Me", passwordHash: "" }
  let id <- Db.insert Note { title: Text.NonEmpty "Milk", body: "", owner: me }
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Notes.Index {})
  let r <- Test.click (Delete { id: id })
  let left <- Db.from Note |> Db.count
  Task.succeed ({ answer: r.answer, items: Test.count "#notes li" r.doc, left: left } == { answer: Redirected (Notes.Index {}), items: 0, left: 0 })
}

test "the list shows only the user's notes" = {
  let me <- Db.insert User { email: Text.Email "me@example.com", name: Text.NonEmpty "Me", passwordHash: "" }
  let other <- Db.insert User { email: Text.Email "other@example.com", name: Text.NonEmpty "Other", passwordHash: "" }
  let _ <- Db.insert Note { title: Text.NonEmpty "Mine", body: "", owner: me }
  let _ <- Db.insert Note { title: Text.NonEmpty "Theirs", body: "", owner: other }
  let _ <- Test.login { user: Just me }
  let page <- Test.get (Notes.Index {})
  Task.succeed (Test.texts "#notes .title" page.doc == ["Mine"])
}

test "a visitor is sent to log in" = {
  let r <- Test.open (Notes.Index {})
  Task.succeed (r.answer == Redirected (Auth.Login {}))
}

test "a note added through the form is listed, newest first" = {
  let me <- Db.insert User { email: Text.Email "me@example.com", name: Text.NonEmpty "Me", passwordHash: "" }
  let _ <- Db.insert Note { title: Text.NonEmpty "Old", body: "", owner: me }
  let _ <- Test.login { user: Just me }
  let _ <- Test.get (Notes.Index {})
  let r <- Test.submit NewNote { title: Text.NonEmpty "New", body: "Text" }
  Task.succeed ({ answer: r.answer, titles: Test.texts "#notes .title" r.doc } == { answer: Redirected (Notes.Index {}), titles: ["New", "Old"] })
}
