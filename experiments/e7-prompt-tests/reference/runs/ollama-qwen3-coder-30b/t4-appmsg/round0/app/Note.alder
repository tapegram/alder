module Note

import User

type NoteId = brand Text

table Note {
  id: NoteId @id,
  title: Text.NonEmpty,
  body: Text = "",
  owner: User.UserId @ref User,
  created: Time @created,
}

test "note can be created with empty body" =
  let note = { id: NoteId "a", title: Text.NonEmpty "Title", body: "", owner: User.UserId "u", created: Time.epoch }
  note.body == ""
