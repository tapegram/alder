module Blog.Show

import Post
import Layout
import Theme

page "/posts/{slug}" { slug: Post.Slug } requires user

type Model = { post: Post, comments: List Post.Comment }

load : Params -> Session -> Query Model
load params session = {
  let found <- Db.get Post params.slug
  match found {
    Just post -> if post.owner == session.user || post.published then {
      let comments <- Db.from Post.Comment |> Db.where (Post.Comment.post.eq params.slug) |> Db.orderBy Post.Comment.created.desc |> Db.all
      Query.succeed { post: post, comments: comments }
    } else Query.notFound,
    Nothing -> Query.notFound,
  }
}

form NewComment = {
  author: Text.NonEmpty,
  body: Text.NonEmpty,
}

msg Submit form NewComment

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  Submit p -> {
    let _ <- Db.insert Post.Comment { author: p.form.author, body: p.form.body, post: model.post.slug }
    Task.succeed Rerender
  },
}

view : Model -> Session -> Html Msg
view model session =
  <Layout.Page title={model.post.title} theme={session.theme}>
    <h1>{model.post.title}</h1>
    <p>Published: {model.post.published}</p>
    <p>{model.post.body}</p>
    <h2>Comments</h2>
    <ul>
      {for comment in model.comments ->
        <li><strong>{comment.author}</strong>: {comment.body}</li>}
    </ul>
    <form submit={Submit}>
      <Input field="author" label="Your name" />
      <Errors field="author" />
      <Textarea field="body" label="Comment" />
      <Errors field="body" />
      <button>Post comment</button>
    </form>
  </Layout.Page>
