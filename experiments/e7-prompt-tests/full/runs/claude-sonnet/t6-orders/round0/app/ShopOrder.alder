module ShopOrder

import User

type OrderId = brand Text

type Status = Open | Paid | Cancelled

table ShopOrder {
  id: OrderId @id,
  owner: User.UserId @ref User,
  status: Status = Open,
  created: Time @created,
}

statusLabel : Status -> Text
statusLabel status = match status {
  Open -> "Open",
  Paid -> "Paid",
  Cancelled -> "Cancelled",
}
