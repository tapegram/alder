module Bad

undocumented : Int -> Int
-- lowercase fragment
fragment : Int -> Int
-- No example here.
noExample : Int -> Int
-- A false example.
--
--     1 + 1 == 3
wrong : Int -> Int
-- An ill-typed example, on two lines.
--
--     1 +
--         "a" == 2
illTyped : Int -> Int
-- A book line that names no heading.
--
--     1 + 1 == 2
--
-- Book: chapter 9, "No such heading"
badBook : Int -> Int
