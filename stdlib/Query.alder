module Query

succeed : a -> Query a
map : (a -> b) -> Query a -> Query b
-- wait ms milliseconds (0..60000); in tests the clock moves instead
delay : Int -> Query Unit
all : List (Query a) -> Query (List a)
notFound : Query a
-- stop: answer 303 to a page (the same page with other parameters, another page, Url.external)
redirect : Page -> Query a
