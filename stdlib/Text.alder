module Text

type NonEmpty = brand Text where True
type Email = brand Text where True
type Url = brand Text where True
type Secret = brand Text where True

-- an accumulator for a large Text: each add is O(1) and shares nothing; build copies once
type Builder

length : Text -> Int
isEmpty : Text -> Bool
trim : Text -> Text
toUpper : Text -> Text
toLower : Text -> Text
contains : Text -> Text -> Bool
startsWith : Text -> Text -> Bool
endsWith : Text -> Text -> Bool
replace : Text -> Text -> Text -> Text
split : Text -> Text -> List Text
join : Text -> List Text -> Text
slice : Int -> Int -> Text -> Text
matches : Text -> Text -> Bool
fromInt : Int -> Text
fromFloat : Float -> Text
toInt : Text -> Maybe Int
toFloat : Text -> Maybe Float
-- the text's UTF-8 bytes
toBytes : Text -> Bytes
padLeft : Int -> Text -> Text -> Text
padRight : Int -> Text -> Text -> Text
-- the first n code points
left : Int -> Text -> Text
-- the last n code points
right : Int -> Text -> Text
dropLeft : Int -> Text -> Text
dropRight : Int -> Text -> Text
repeat : Int -> Text -> Text
reverse : Text -> Text
trimLeft : Text -> Text
trimRight : Text -> Text
concat : List Text -> Text
lines : Text -> List Text
words : Text -> List Text
-- Text.indexes needle haystack: every code-point offset, overlaps included
indexes : Text -> Text -> List Int
toCodePoints : Text -> List Int
fromCodePoints : List Int -> Text
-- FNV-1a 64 of the UTF-8 bytes, top bit cleared: stable across versions and platforms, never
-- negative, not cryptographic (seeds, buckets, cache keys)
hash : Text -> Int
-- the empty Text.Builder
builder : Builder
-- Text.add piece b: b with piece after everything added so far
add : Text -> Builder -> Builder
-- the Text of everything added, in order
build : Builder -> Text
