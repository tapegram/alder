module Prelude

type Int
type Float
type Text
type Unit
type Date
type Time
type Never
type Error
type Page
-- a page's answer when its view returns File: a status, a content type, headers and a body, written as given
type File
-- a sequence of bytes, such as the body of a File
type Bytes
type List a
type Dict k v
type Html a
type Query a
type Task a
type Form f
type Table t
type Id t
type Insert t
type Select t
type Condition t
type Order t
type Column t a

type Bool = True | False
type Maybe a = Just a | Nothing
type Result e a = Ok a | Err e
type Nav = Rerender | Redirect Page | Reject Text

-- Test types: they exist only inside a `test` (the browser steps of module Test).
type Doc
type Answer = Shown
            | Rerendered
            | Redirected Page
            | FormRejected (List { field: Text, message: Text })
            | PageMissing
            | RequestFailed Text

not : Bool -> Bool
