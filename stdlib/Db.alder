module Db

get : Table t -> Id t -> Query (Maybe t)
from : Table t -> Select t
where : Condition t -> Select t -> Select t
orderBy : Order t -> Select t -> Select t
limit : Int -> Select t -> Select t
offset : Int -> Select t -> Select t
all : Select t -> Query (List t)
first : Select t -> Query (Maybe t)
count : Select t -> Query Int
and : List (Condition t) -> Condition t
or : List (Condition t) -> Condition t
not : Condition t -> Condition t
insert : Table t -> Insert t -> Task (Id t)
update : Table t -> Id t -> (t -> t) -> Task Unit
delete : Table t -> Id t -> Task Unit
-- Scoped operations: a table with an `@owner` column, in a page module whose page `requires user`

-- `Db.from t` keeping the session user's rows (`owner = session.user`)
mine : Table t -> Select t
-- the row when it exists and is the session user's; otherwise Query.notFound
getMine : Table t -> Id t -> Query t
-- one UPDATE with `id = ? AND owner = ?`; no row changed is Task.notFound
updateMine : Table t -> Id t -> (t -> t) -> Task Unit
-- one DELETE with `id = ? AND owner = ?`; no row deleted is Task.notFound
deleteMine : Table t -> Id t -> Task Unit
-- the row is `Insert t` without the owner column, written as a record literal in the call; the owner is the session's user
insertMine : Table t -> Insert t -> Task (Id t)
-- The generic scoped operations (M15): a table with a `@partition k` column (`@owner` is
-- `@partition user`), where the session's `k` is narrowed (a page that `requires k`)

-- `Db.from t` keeping the rows of the session's partition (`col = session.k`)
scoped : Table t -> Select t
-- the row when it exists and is in the session's partition; otherwise Query.notFound
getScoped : Table t -> Id t -> Query t
-- one UPDATE with `id = ? AND col = ?`, never writing the partition column; no row changed is Task.notFound
updateScoped : Table t -> Id t -> (t -> t) -> Task Unit
-- one DELETE with `id = ? AND col = ?`; no row deleted is Task.notFound
deleteScoped : Table t -> Id t -> Task Unit
-- the row is `Insert t` without the partition column, written as a record literal in the call; the column is the session's key
insertScoped : Table t -> Insert t -> Task (Id t)
