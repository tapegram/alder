# Written by alder deploy init (book chapter 16): blog as one Docker web service.
# Commit it, then in Render: New > Blueprint, and connect this repository.
services:
  - type: web
    name: blog
    runtime: docker
    plan: starter # a persistent disk needs a paid plan
    branch: main
    dockerfilePath: ./Dockerfile
    healthCheckPath: /_alder/health
    autoDeployTrigger: commit
    envVars:
      - key: ALDER_ADDR
        value: ":10000"
      - key: PORT
        value: "10000"
      - key: ALDER_SECRET
        generateValue: true
      - key: ALDER_PUBLIC_URL
        value: https://blog.onrender.com # change if Render gave the service another name
      - key: ALDER_DB
        value: /data/app.db
      - key: TZ
        value: UTC
    # SQLite lives on this disk. A disk means one instance and a short pause on each deploy
    # (chapter 16, "Why no disk mode").
    disk:
      name: data
      mountPath: /data
      sizeGB: 1
