module Shop

import Notice

-- Helpers of a write's answer, in a module that is neither a page nor App (#160, 7.3).
after : Nav -> Nav
after nav = nav

refuse : Text -> Task Nav
refuse why = Task.succeed (Reject why)

again : Task Nav
again = Task.succeed (Rerender |> Notice.warning "Again")

home : Task Nav
home = Task.succeed (Notice.with "Back" (Redirect (Url.external "https://example.com")))

-- Html a stays: a component of both worlds (plan call 2)
Box : { children: List (Html a) } -> Html a
Box props = <div>{props.children}</div>
