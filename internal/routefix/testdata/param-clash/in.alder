module Projects.Show

import Table.Project
import Table.Todo

page "/projects/{id}" { id: Project.ProjectId } requires user

type Model = { project: Project }

load : Params -> Session -> Query Model
load params session = {
  let project <- Db.getMine Project params.id
  Query.succeed { project: project }
}

-- the payload's `id` is a todo's, the path's `id` the project's: the route would carry the
-- todo's id where the project's was
msg Toggle { id: Todo.TodoId }

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  Toggle p -> {
    let _ <- Db.update Todo p.id (\t -> { t | done: not t.done })
    Task.succeed Rerender
  },
}

view : Model -> Session -> Html Msg
view model session = <main>{model.project.name}</main>
