module Feed.Index

page "/feed" { }

type Model = { }

load : Params -> Session -> Query Model
load params session = Query.succeed {}

-- a message named like the module's last segment: the route `Index` would take its name
msg Index

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  Index _ -> Task.succeed Rerender,
}

view : Model -> Session -> Html Msg
view model session = <main><button click={Index}>Index</button></main>
