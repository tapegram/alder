module Feed.Index

route Feed  = GET  "/feed"         { }
-- a message named like the module's last segment: the route `Index` would take its name
route Index = POST "/feed/_/Index" { }

type Model = { }

Feed.load : Feed.Params -> Session -> Query Model
Feed.load params session = Query.succeed {}

-- this route does not run Feed.load first: repeat here any access check it makes (#160)
Index.update : Index.Params -> Session -> Task Response
Index.update params session = Task.succeed Response.refresh

Feed.view : Model -> Session -> Html
Feed.view model session = <main><button click={Index}>Index</button></main>
