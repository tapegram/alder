module Shelves.Show

import Table.Book
import Table.Shelf

page "/shelves/{id}" { id: Shelf.ShelfId } requires user

type Model = { shelf: Shelf }

-- only the shelf's owner may open it: anyone else's is a 404
load : Params -> Session -> Query Model
load params session = {
  let shelf <- Db.getMine Shelf params.id
  Query.succeed { shelf: shelf }
}

-- the arm does not read the model: before routes, `load` above still ran first and checked
-- that the shelf was the user's
msg Wipe { book: Book.BookId }

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  Wipe p -> {
    let _ <- Db.delete Book p.book
    Task.succeed Rerender
  },
}

view : Model -> Session -> Html Msg
view model session = <main><h1>{model.shelf.name}</h1></main>
