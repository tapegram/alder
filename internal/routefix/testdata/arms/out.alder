module Shop.Cart

route Cart  = GET  "/cart"         { coupon: Text = "" }
route Add   = POST "/cart/_/Add"   { n: Int }
route Empty = POST "/cart/_/Empty" { }
route Apply = POST "/cart/_/Apply" { code: Text }

type Model = { items: Int, coupon: Text }

Cart.load : Cart.Params -> Session -> Query Model
Cart.load params session = Query.succeed { items: 2, coupon: params.coupon }

-- the coupon the page was opened with
coupon : Cart.Params -> Text
coupon params = params.coupon

Add.update : Add.Params -> Session -> Task Response
Add.update params session = match params {
  { n: n } ->
    Task.succeed (
      Response.redirect (Cart {}) |> Response.toast (if n > 1 then "Added some" else "Added one")
    ),
} -- one or more

Empty.update : Empty.Params -> Session -> Task Response
Empty.update params session = Task.succeed (Response.refresh |> Response.error "Emptied")

-- the page's model is gone: render, refresh or query (#160)
Apply.update : Apply.Params -> Session -> Task Response
Apply.update p session =
  if p.code == ?model then
    Task.succeed (Response.invalid "Already applied")
  else
    Task.succeed (Response.redirect (Cart { coupon: p.code }))

Cart.view : Model -> Session -> Html
Cart.view model session =
  <main>
    <p>{Text.fromInt model.items} items</p>
    <button click={Add { n: 1 }}>Add</button>
    <button click={Empty}>Empty</button>
    <button click={Apply { code: "SAVE" }}>Apply</button>
  </main>
