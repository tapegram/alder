module Shop.Cart

page "/cart" { coupon: Text = "" }

type Model = { items: Int, coupon: Text }

load : Params -> Session -> Query Model
load params session = Query.succeed { items: 2, coupon: params.coupon }

-- the coupon the page was opened with
coupon : Params -> Text
coupon params = params.coupon

msg Add { n: Int }

msg Empty

msg Apply { code: Text }

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  Add { n: n } -> Task.succeed (Notice.with (if n > 1 then "Added some" else "Added one") (Redirect (Shop.Cart {}))), -- one or more
  Empty _ -> Task.succeed (Rerender |> Notice.error "Emptied"),
  Apply p ->
    if p.code == model.coupon then
      Task.succeed (Reject "Already applied")
    else
      Task.succeed (Redirect (Shop.Cart { coupon: p.code })),
}

view : Model -> Session -> Html Msg
view model session =
  <main>
    <p>{Text.fromInt model.items} items</p>
    <button click={Add { n: 1 }}>Add</button>
    <button click={Empty}>Empty</button>
    <button click={Apply { code: "SAVE" }}>Apply</button>
  </main>
