module Home

route Home = GET "/" { }

type Model = { }

Home.load : Home.Params -> Session -> Query Model
Home.load params session = Query.succeed {}

Home.view : Model -> Session -> Html
Home.view model session =
  <main>
    <a href={Home {}}>Home</a>
    <a href={Export.Export {}}>CSV</a>
    <a href={Reports.Weekly.Weekly { week: 1 }}>Weekly</a>
  </main>
