module Home

page "/" { }

type Model = { }

load : Params -> Session -> Query Model
load params session = Query.succeed {}

view : Model -> Session -> Html Msg
view model session =
  <main>
    <a href={Home {}}>Home</a>
    <a href={Export {}}>CSV</a>
    <a href={Reports.Weekly { week: 1 }}>Weekly</a>
  </main>
