-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Posts.Bulk

-- @admin begin imports
import Admin.Layout
import Table.Post
import Table.User
-- @admin end

page "/admin/post/bulk" { ids: List Post.PostId } requires user, role Admin

-- The rows chosen on the list (at most maxRows of them), the ids of those that other rows keep
-- from being deleted, and how many ids the page was given.
type Model = {
  rows: List Post,
  held: List Post.PostId,
  chosen: Int,
}

-- maxRows is how many rows one action takes: a page of the list. More are refused.
maxRows : Int
maxRows = 25

load : Params -> Session -> Query Model
load params session = {
  let admin <- Layout.isAdmin session.user
  if admin then {
    -- @admin begin load
    let ids = List.take maxRows params.ids
    let rows <-
      Db.from Post
        |> Db.where (Post.id.in ids)
        |> Db.all
    Query.succeed {
      rows: rows,
      held: [],
      chosen: List.length params.ids,
    }
    -- @admin end
  } else
    Query.notFound
}

-- refused says whether a row is kept from being deleted: rows refer to it with a `@restrict`.
refused : Model -> Session -> Post -> Bool
refused model session row = List.member row.id model.held

-- @admin begin bulk
form Confirm = { }

msg BulkDelete form Confirm

form SetPublished = { value: Bool }

msg BulkSetPublished form SetPublished

-- Each action reads the rows again (load runs before every message) and answers with a notice;
-- none takes more than maxRows rows.
update : Msg -> Model -> Session -> Task Nav
update msg model session =
  -- too many first
  if model.chosen > maxRows then
    Task.succeed (Reject ("Choose at most " ++ Text.fromInt maxRows ++ " rows at a time."))
  else
    -- which action
    match msg {
      -- delete what can be
      BulkDelete p -> {
        let allowed = List.filter (\row -> refused model session row == False) model.rows
        let _ <- Task.all (List.map (\row -> Db.delete Post row.id) allowed)
        Task.succeed (
          Notice.success ("Deleted " ++ Text.fromInt (List.length allowed) ++ " of " ++ Text.fromInt (List.length model.rows)) (
            Redirect (Admin.Posts.Index {})
          )
        )
      },
      BulkSetPublished p -> {
        let _ <-
          Task.all (
            List.map (\row -> Db.update Post row.id (\r -> { r |
              published: p.form.value
            })) model.rows
          )
        Task.succeed (
          Notice.success ("Updated " ++ Text.fromInt (List.length model.rows)) (
            Redirect (Admin.Posts.Index {})
          )
        )
      },
    }
-- @admin end

view : Model -> Session -> Html Msg
view model session =
  <Layout.Page title="Selected posts">
    <h1>{Text.fromInt (List.length model.rows)} selected</h1>

    <al-card>
      {if model.chosen > maxRows then
        <al-alert id="too-many" variant="warning">
          {"Choose at most " ++ Text.fromInt maxRows ++ " rows at a time."}
        </al-alert>
      else
        Html.none}
      <ul id="selected">
        {for row in model.rows ->
          <li>
            {row.slug}
            {if refused model session row then
              <small> (kept: other rows refer to it)</small>
            else
              <span></span>}
          </li>}
      </ul>
      -- @admin begin actions
      <form id="bulk-delete" submit={BulkDelete}>
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-button variant="destructive" type="submit">
          Delete the rows that can be deleted
        </al-button>
      </form>
      <form id="set-published" submit={BulkSetPublished}>
        <al-alert variant="destructive"><Errors form /></al-alert>
        <al-checkbox field="value" label="Published" />
        <al-button type="submit">Set published</al-button>
      </form>
      -- @admin end
    </al-card>
    <a href={Admin.Posts.Index {}}>Back to the list</a>
  </Layout.Page>

