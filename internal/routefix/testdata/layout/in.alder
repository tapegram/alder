module Notes.Index

page "/notes" { }

type Model = { notes: List Text }

load : Params -> Session -> Query Model
load params session = Query.succeed { notes: ["a", "b"] }

msg Clear

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  Clear _ -> done,
}

-- a helper that answers like an arm
done : Task Nav
done = Task.succeed Rerender

-- a page's own layout, written for any message type
Shell : { title: Text, children: List (Html a) } -> Html a
Shell props = <main><h1>{props.title}</h1>{props.children}</main>

note : Text -> Html a
note t = <li>{t}</li>

view : Model -> Session -> Html Msg
view model session =
  <Shell title="Notes">
    <ul>{for n in model.notes -> note n}</ul>
    <button click={Clear}>Clear</button>
  </Shell>
