module Notes.Edit

page "/notes/{id}/edit" { id: Int }

type Model = { id: Int }

load : Params -> Session -> Query Model
load params session = Query.succeed { id: params.id }

form EditNote = { title: Text }

msg Save form EditNote

msg Archive { why: Text }

msg Ping

update : Msg -> Model -> Session -> Task Nav
update msg m session = match msg {
  Save p ->
    if p.form.title == "" then
      Task.succeed (Reject "A note needs a title")
    else
      Task.succeed (Notice.success "Saved" (Redirect (Notes.Edit { id: 1 }))),
  Archive p -> Task.succeed (Notice.with ("Archived: " ++ p.why) Rerender),
  Ping p -> Task.succeed (Rerender |> Notice.warning "Pong"),
}

view : Model -> Session -> Html Msg
view model session =
  <main>
    <form submit={Save}><Errors form /><button>Save</button></form>
    <button click={Archive { why: "old" }}>Archive</button>
    <button click={Ping}>Ping</button>
  </main>
