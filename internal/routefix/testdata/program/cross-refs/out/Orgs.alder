module Orgs

import Layout

route Orgs = GET "/orgs" { } requires user

type Model = { }

Orgs.load : Orgs.Params -> Session -> Query Model
Orgs.load params session = Query.succeed {}

Orgs.view : Model -> Session -> Html
Orgs.view model session =
  <Layout.Page title="Orgs"><a href={Todos.Index.Index {}}>Back</a></Layout.Page>
