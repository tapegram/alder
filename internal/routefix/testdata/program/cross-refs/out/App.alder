module App

import Layout

session { user: Maybe Text, org: Maybe Text }

-- Where a visitor logs in, and where a request without an org goes.
login = Auth.Login.Login

choose org = Orgs.Orgs

error : Error -> Html Never
error err = <Layout.Page title="Error"><h1>Something went wrong</h1></Layout.Page>

notFound : Html Never
notFound = <Layout.Page title="Not found"><h1>Not found</h1></Layout.Page>

test "a visitor is sent to log in" = {
  let r <- Test.open (Todos.Index.Index {})
  Task.succeed (r.answer == Redirected (Auth.Login.Login {}))
}
