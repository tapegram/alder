module Todos.Show

import Layout

page "/todos/{id}" { id: Text } requires user

type Model = { id: Text }

load : Params -> Session -> Query Model
load params session = Query.succeed { id: params.id }

msg Delete

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  Delete -> Task.succeed (Redirect (Todos.Index {})),
}

view : Model -> Session -> Html Msg
view model session =
  <Layout.Page title={model.id}><button click={Delete}>Delete</button></Layout.Page>

-- `Session` outside the page's own declarations was the page's session: now the route's.
mine : Model -> Session -> Bool
mine model session = session.user == Just model.id

test "a todo is mine" = {
  let s : Session = { user: Just "1", org: Nothing }
  Task.succeed (mine { id: "1" } s)
}
