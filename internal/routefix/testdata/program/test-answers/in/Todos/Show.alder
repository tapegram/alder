module Todos.Show

import Table.Todo

page "/todos/{id}" { id: Todo.TodoId }

type Model = { todo: Todo }

load : Params -> Session -> Query Model
load params session = {
  let todo <- Db.getMine Todo params.id
  Query.succeed { todo: todo }
}

form EditTodo = { title: Text }

msg Save form EditTodo

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  Save p -> Task.succeed Rerender,
}

view : Model -> Session -> Html Msg
view model session = <form submit={Save}><Input field="title" /></form>

test "saving a todo" = {
  let id <- Db.insert Todo { title: "Milk", done: False }
  let _ <- Test.get (Todos.Show { id: id })
  let r <- Test.submit EditTodo { title: "Bread" }
  Task.succeed (r.answer == Rerendered)
}
