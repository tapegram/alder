module Todos.Show

import Table.Todo

page "/todos/{id}" { id: Todo.TodoId }

type Model = { todo: Todo }

load : Params -> Session -> Query Model
load params session = {
  let todo <- Db.getMine Todo params.id
  Query.succeed { todo: todo }
}

msg Delete

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  Delete -> {
    let _ <- Db.deleteMine Todo model.todo.id
    Task.succeed (Redirect (Todos.Index {}))
  },
}

view : Model -> Session -> Html Msg
view model session = <button click={Delete}>Delete {model.todo.title}</button>

-- The route of `Delete` now takes the page's `id`: the test must pass it.
test "Delete goes to the list" = {
  let id <- Db.insert Todo { title: "Milk", done: False }
  let r <-
    Test.run (update Delete {
      todo: {
        id: id,
        title: "Milk",
        done: False,
      },
    } { user: Nothing })
  Task.succeed (r.value == Ok (Redirect (Todos.Index {})))
}
