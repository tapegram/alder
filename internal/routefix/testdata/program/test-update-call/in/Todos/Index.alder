module Todos.Index

import Table.Todo

page "/" { }

type Model = { todos: List Todo }

load : Params -> Session -> Query Model
load params session = {
  let todos <- Db.mine Todo |> Db.all
  Query.succeed { todos: todos }
}

msg Toggle { id: Todo.TodoId }

msg Clear

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  Toggle p -> {
    let _ <- Db.updateMine Todo p.id (\t -> { t | done: not t.done })
    Task.succeed Rerender
  },
  Clear -> Task.succeed (Redirect (Todos.Index {})),
}

view : Model -> Session -> Html Msg
view model session =
  <ul>
    {for t in model.todos -> <li><button click={Toggle { id: t.id }}>{t.title}</button></li>}
    <button click={Clear}>Clear</button>
  </ul>

-- `update` called directly: the message, the model, the session.
test "Toggle answers a refresh" = {
  let id <- Db.insert Todo { title: "Milk", done: False }
  let r <- Test.run (update (Toggle { id: id }) { todos: [] } { user: Nothing })
  Task.succeed (r.value == Ok Rerender)
}

test "Clear goes to the list" = {
  let r <- Test.run (update Clear { todos: [] } { user: Nothing })
  Task.succeed (r.value == Ok (Redirect (Todos.Index {})))
}
