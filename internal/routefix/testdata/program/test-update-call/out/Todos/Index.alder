module Todos.Index

import Table.Todo

route Index  = GET  "/"         { }
route Toggle = POST "/_/Toggle" { id: Todo.TodoId }
route Clear  = POST "/_/Clear"  { }

type Model = { todos: List Todo }

Index.load : Index.Params -> Session -> Query Model
Index.load params session = {
  let todos <- Db.mine Todo |> Db.all
  Query.succeed { todos: todos }
}

-- this route does not run Index.load first: repeat here any access check it makes (#160)
Toggle.update : Toggle.Params -> Session -> Task Response
Toggle.update p session = {
  let _ <- Db.updateMine Todo p.id (\t -> { t | done: not t.done })
  Task.succeed Response.refresh
}

-- this route does not run Index.load first: repeat here any access check it makes (#160)
Clear.update : Clear.Params -> Session -> Task Response
Clear.update params session = Task.succeed (Response.redirect (Index {}))

Index.view : Model -> Session -> Html
Index.view model session =
  <ul>
    {for t in model.todos -> <li><button click={Toggle { id: t.id }}>{t.title}</button></li>}
    <button click={Clear}>Clear</button>
  </ul>

-- `update` called directly: the message, the model, the session.
test "Toggle answers a refresh" = {
  let id <- Db.insert Todo { title: "Milk", done: False }
  let r <- Test.run (Toggle.update { id: id } { user: Nothing })
  Task.succeed (r.value == Ok Response.refresh)
}

test "Clear goes to the list" = {
  let r <- Test.run (Clear.update {} { user: Nothing })
  Task.succeed (r.value == Ok (Response.redirect (Index {})))
}
