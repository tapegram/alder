module Todos.Show

import Table.Todo

route Show   = GET  "/todos/{id}"          { id: Todo.TodoId }
route Delete = POST "/todos/{id}/_/Delete" { id: Todo.TodoId }

type Model = { todo: Todo }

Show.load : Show.Params -> Session -> Query Model
Show.load params session = {
  let todo <- Db.getMine Todo params.id
  Query.succeed { todo: todo }
}

-- the page's model is gone: render, refresh or query (#160)
Delete.update : Delete.Params -> Session -> Task Response
Delete.update params session = {
  let _ <- Db.deleteMine Todo ?model
  Task.succeed (Response.redirect (Todos.Index.Index {}))
}

Show.view : Model -> Session -> Html
Show.view model session = <button click={Delete { id: ?id }}>Delete {model.todo.title}</button>

-- The route of `Delete` now takes the page's `id`: the test must pass it.
test "Delete goes to the list" = {
  let id <- Db.insert Todo { title: "Milk", done: False }
  let r <- Test.run (Delete.update { id: ?id } { user: Nothing })
  Task.succeed (r.value == Ok (Response.redirect (Todos.Index.Index {})))
}
