module Shelves.Index

import Table.Shelf

page "/shelves" { } requires user

type Model = { shelves: List Shelf }

load : Params -> Session -> Query Model
load params session = {
  let shelves <- Db.mine Shelf |> Db.all
  Query.succeed { shelves: shelves }
}

view : Model -> Session -> Html Msg
view model session = <main><a href={Admin.Shelves.Index {}}>Admin</a></main>
