module Shelves.Index

import Table.Shelf

route Index = GET "/shelves" { } requires user

type Model = { shelves: List Shelf }

Index.load : Index.Params -> Session -> Query Model
Index.load params session = {
  let shelves <- Db.mine Shelf |> Db.all
  Query.succeed { shelves: shelves }
}

Index.view : Model -> Session -> Html
Index.view model session = <main><a href={Admin.Shelves.Index {}}>Admin</a></main>
