-- generated by `alder new admin`; regions between
-- `-- @admin begin <name>` / `-- @admin end` are rewritten by `alder regen admin`
module Admin.Shelves.Index

-- @admin begin imports
import Table.Shelf
-- @admin end

page "/admin/shelves" { } requires user, role Admin

type Model = { shelves: List Shelf }

load : Params -> Session -> Query Model
load params session = {
  let shelves <- Db.from Shelf |> Db.all
  Query.succeed { shelves: shelves }
}

-- @admin begin remove
msg Remove { shelf: Shelf.ShelfId }
-- @admin end

update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  Remove p -> {
    let _ <- Db.delete Shelf p.shelf
    Task.succeed Rerender
  },
}

view : Model -> Session -> Html Msg
view model session = <main><a href={Shelves.Index {}}>Shelves</a></main>
