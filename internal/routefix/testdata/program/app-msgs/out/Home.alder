module Home

route Home = GET "/" { }

type Model = { }

Home.load : Home.Params -> Session -> Query Model
Home.load params session = Query.succeed {}

Home.view : Model -> Session -> Html
Home.view model session =
  <main>
    <button click={App.Logout}>Log out</button>
    <form submit={App.Send}><Input field="text" /></form>
  </main>

test "logging out from the page" = {
  let _ <- Test.login { user: Just "me" }
  let _ <- Test.get (Home {})
  let r <- Test.click App.Logout
  Task.succeed (r.answer == Redirected (Home {}))
}
