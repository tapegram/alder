[[- template "header" .]]
[[if .Example]]
-- example: a page keeps state in its parameters (or the session, or a table), never in Model
-- between requests: `load` rebuilds Model on every request. Delete every part marked
-- `example` when you have seen how they fit together, and the `count` parameter in the
-- `page` line above; what is left is the plain page.

-- example: delete the field `count: Int`, leaving `type Model = { }`.
type Model = { count: Int }

-- example: in `load`, delete `count: params.count`, leaving `Query.succeed { }`.
load : Params -> Session -> Query Model
load params session = Query.succeed { count: params.count }

-- example: a message carries a record; the view sends it from `click`.
msg Bump { by: Int }

-- example: delete `update` whole; a plain page has none.
update : Msg -> Model -> Session -> Task Nav
update msg model session = match msg {
  -- `update` answers with a Nav: Redirect to the same page with the new count
  -- (Rerender would run `load` again with the old parameters), or Reject with an error.
  Bump p -> Task.succeed (Redirect ([[.Module]] { count: model.count + p.by })),
}

-- example: in `view`, delete the `<p id="count">` and `<al-button>` lines: they show the
-- state and send a message from a button.
view : Model -> Session -> Html Msg
view model session =
  [[.Open]]
    <h1>[[.Title]]</h1>
    <p id="count">Count: {Text.fromInt model.count}</p>
    <al-button click={Bump { by: 1 }}>Bump</al-button>
  [[.Close]]
[[else]]
type Model = { }

load : Params -> Session -> Query Model
load params session = [[if .LoadHole]]?load[[else]]Query.succeed { }[[end]]

view : Model -> Session -> Html Msg
view model session =
  [[.Open]]
    <h1>[[.Title]]</h1>
  [[.Close]]
[[end]]
[[- template "tests" .]]
