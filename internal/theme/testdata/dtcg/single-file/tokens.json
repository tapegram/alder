{
  "$description": "A single tokens file with light and dark groups.",
  "radius": {
    "$type": "dimension",
    "corners": {
      "radius": { "$value": { "value": 0.5, "unit": "rem" } }
    }
  },
  "Light": {
    "color": {
      "$type": "color",
      "background": { "$value": "#ffffff" },
      "foreground": { "$value": "#111111", "$description": "Text." }
    }
  },
  "brand": { "$value": "#336699" },
  "dark": {
    "color": {
      "$type": "color",
      "background": { "$value": "#111111" },
      "foreground": { "$value": "#ffffff", "$extensions": { "com.example": { "x": 1 } } }
    }
  },
  "$extensions": { "com.example": { "ignored": true } }
}
