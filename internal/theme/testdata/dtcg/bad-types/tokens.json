{
  "radius": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.5, 0, 0] } },
  "misc": {
    "radius-sm": { "$value": { "value": 0.25, "unit": "rem" } }
  },
  "color": {
    "$type": "color",
    "primary": { "$value": { "colorSpace": "oklch", "components": [0.5, 0.2, 260] } },
    "ring": { "$value": "{color.nope}" }
  },
  "typography": {
    "$type": "typography",
    "body": { "$value": { "fontFamily": "{font.sans}", "fontSize": { "value": 1, "unit": "rem" } } }
  },
  "motion": {
    "$type": "duration",
    "fast": { "$value": { "value": 150, "unit": "ms" } }
  }
}
