{
  "color": {
    "$type": "color",
    "brand": { "$value": { "colorSpace": "oklch", "components": [0.5, 0.2, 260] } },
    "primary": { "$value": "{color.brand}" },
    "ring": { "$value": "{color.primary}" },
    "primaryForeground": { "$value": { "colorSpace": "oklch", "components": [0.98, 0, 0] } },
    "sidebar-primary-foreground": { "$value": "{color.primaryForeground}" }
  },
  "untyped": {
    "accent": { "$value": "{color.primary}" }
  },
  "radius": {
    "$type": "dimension",
    "radius": { "$value": { "value": 0.5, "unit": "rem" } },
    "radius-sm": { "$value": "{radius.radius}" },
    "radius-md": { "$value": "{radius.radius-sm}" }
  }
}
